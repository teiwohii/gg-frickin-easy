								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local Tool = require(script.Parent.Tool)

local AdjustTool = Tool.extend()

AdjustTool.id = "Adjust"
AdjustTool.title = "Adjust Properties"
AdjustTool.keywords = "multiply divide add subtract shift math bulk change every property"
AdjustTool.operations = { "Multiply", "Divide", "Add", "Subtract" }
AdjustTool.minimumDivisor = 1e-6

AdjustTool.kinds = {
	number = true,
	NumberRange = true,
	NumberSequence = true,
	Vector3 = true,
	Vector2 = true,
}

AdjustTool.excluded = {
	Position = true,
	Orientation = true,
	ZIndex = true,
}

AdjustTool.messages = {
	noProperty = "Pick a property first. The list shows what the selection has.",
	nothing = "Nothing in the selection has %s.",
	done = "%s changed on %d object%s.",
	divideByZero = "Dividing by zero is not possible. Change the amount.",
}

function AdjustTool.new(context)
	local self = setmetatable({}, AdjustTool)

	Tool.init(self, context, {
		Property = "",
		Operation = "Multiply",
		Amount = 2,
	})

	self.access = context.access

	return self
end

function AdjustTool:isAdjustable(name: string, value): boolean
	return AdjustTool.kinds[typeof(value)] == true and not AdjustTool.excluded[name]
end

function AdjustTool:getPropertyOptions()
	local options = {}
	local seen = {}

	for _, instance in self:getAffected() do
		for _, name in self.access:getPropertyNames(instance) do
			if not seen[name] then
				local success, value = self.access:read(instance, name)

				if success and self:isAdjustable(name, value) then
					seen[name] = true
					table.insert(options, { value = name, label = self.access:getLabel(name) })
				end
			end
		end
	end

	table.sort(options, function(a, b)
		return a.label < b.label
	end)

	return options
end

function AdjustTool:getFields()
	local property = self:field("Property", "Property", "choice", { placeholder = "Choose", tip = "Every property of this name in the selection is changed, on any kind of object." })

	property.getOptions = function()
		return self:getPropertyOptions()
	end

	return {
		property,
		self:choice("Operation", "Operation", AdjustTool.operations),
		self:field("Amount", "Amount", "number", { range = { min = 0, max = 4 }, tip = "Ranges, curves and vectors are changed as a whole, so a curve keeps its shape." }),
		self:action("Apply", "Adjust Selection", function()
			self:apply()
		end, nil, true),
	}
end

function AdjustTool:compute(number: number, operation: string, amount: number): number
	if operation == "Multiply" then
		return number * amount
	elseif operation == "Divide" then
		return number / amount
	elseif operation == "Add" then
		return number + amount
	end

	return number - amount
end

function AdjustTool:adjustSequence(sequence: NumberSequence, operation: string, amount: number): NumberSequence
	local keypoints = {}
	local scales = operation == "Multiply" or operation == "Divide"

	for _, keypoint in sequence.Keypoints do
		local envelope = keypoint.Envelope

		if scales then
			envelope = math.abs(self:compute(envelope, operation, amount))
		end

		table.insert(keypoints, NumberSequenceKeypoint.new(keypoint.Time, self:compute(keypoint.Value, operation, amount), envelope))
	end

	return NumberSequence.new(keypoints)
end

function AdjustTool:adjust(value, operation: string, amount: number)
	local kind = typeof(value)

	if kind == "number" then
		return self:compute(value, operation, amount)
	elseif kind == "NumberRange" then
		local first = self:compute(value.Min, operation, amount)
		local second = self:compute(value.Max, operation, amount)

		return NumberRange.new(math.min(first, second), math.max(first, second))
	elseif kind == "NumberSequence" then
		return self:adjustSequence(value, operation, amount)
	elseif kind == "Vector3" then
		return Vector3.new(self:compute(value.X, operation, amount), self:compute(value.Y, operation, amount), self:compute(value.Z, operation, amount))
	elseif kind == "Vector2" then
		return Vector2.new(self:compute(value.X, operation, amount), self:compute(value.Y, operation, amount))
	end

	return nil
end

function AdjustTool:apply()
	local roots = self:requireRoots(false)

	if not roots then
		return
	end

	local params = self.params
	local name = params.Property
	local messages = AdjustTool.messages

	if name == "" then
		self.context.notify(messages.noProperty)
		return
	end

	if params.Operation == "Divide" and math.abs(params.Amount) < AdjustTool.minimumDivisor then
		self.context.notify(messages.divideByZero)
		return
	end

	local label = self.access:getLabel(name)
	local changed = 0

	self:run("Adjust " .. label, function()
		for _, instance in self:getAffected() do
			if table.find(self.access:getPropertyNames(instance), name) then
				local success, value = self.access:read(instance, name)

				if success and self:isAdjustable(name, value) then
					local adjusted = nil

					pcall(function()
						adjusted = self:adjust(value, params.Operation, params.Amount)
					end)

					if adjusted ~= nil and self.access:write(instance, name, adjusted) then
						changed += 1
					end
				end
			end
		end
	end)

	if changed == 0 then
		self.context.notify(string.format(messages.nothing, label))
	else
		self.context.notify(string.format(messages.done, label, changed, if changed == 1 then "" else "s"))
	end
end

return AdjustTool
]]></ProtectedString>
								<string name="ScriptGuid">{A3DF65E8-2A09-40AB-916B-16368A1B447A}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<string name="Name">AdjustTool</string>
								<BinaryString name="SerializedOverrides"></BinaryString>
								<int64 name="SourceAssetId">-1</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX80381927804E4692BDAD3034C6F34CA8">
							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local colorOps = require(script.Parent.Parent.colorOps)
local Tool = require(script.Parent.Tool)

local SwapColorTool = Tool.extend()

SwapColorTool.id = "SwapColor"
SwapColorTool.title = "Swap Colours"
SwapColorTool.keywords = "colour color replace swap palette find change"
SwapColorTool.maximumListed = 24
SwapColorTool.menuWidth = 170

SwapColorTool.messages = {
	noColors = "The selection has no colours to list.",
	noMatch = "That colour is not used in the selection. Use Colours In Selection to pick one that is.",
	done = "Colour swapped in %d place%s.",
}

function SwapColorTool.new(context)
	local self = setmetatable({}, SwapColorTool)

	Tool.init(self, context, {
		From = Color3.fromRGB(255, 255, 255),
		To = Color3.fromRGB(120, 200, 255),
		Tolerance = 2,
	})

	return self
end

function SwapColorTool:getFields()
	return {
		self:field("From", "Find", "color", { tip = "The colour to look for, in parts, particles, beams, trails, lights and decals." }),
		self:action("Pick", "Colours In Selection", function(anchor)
			self:openPalette(anchor)
		end, "List every colour the selection uses, most used first. Click one to find it."),
		self:field("To", "Replace With", "color"),
		self:field("Tolerance", "Tolerance %", "number", { minimum = 0, maximum = 100, clamp = true, range = { min = 0, max = 30 }, tip = "How close a colour must be to count as a match. 0 only swaps the exact colour." }),
		self:action("Apply", "Swap In Selection", function()
			self:apply()
		end, nil, true),
	}
end

function SwapColorTool:collect()
	local entries = {}
	local byHex = {}

	for _, instance in self:getAffected() do
		colorOps.visit(instance, function(color: Color3)
			local hex = color:ToHex()
			local entry = byHex[hex]

			if not entry then
				entry = { color = Color3.fromHex(hex), hex = hex, count = 0 }
				byHex[hex] = entry
				table.insert(entries, entry)
			end

			entry.count += 1
		end)
	end

	table.sort(entries, function(a, b)
		if a.count ~= b.count then
			return a.count > b.count
		end

		return a.hex < b.hex
	end)

	return entries
end

function SwapColorTool:openPalette(anchor: GuiObject?)
	if not self:requireRoots(false) then
		return
	end

	local entries = self:collect()

	if #entries == 0 then
		self.context.notify(SwapColorTool.messages.noColors)
		return
	end

	local items = {}

	for index, entry in entries do
		if index > SwapColorTool.maximumListed then
			break
		end

		table.insert(items, {
			text = string.format("#%s  (%d)", string.upper(entry.hex), entry.count),
			color = entry.color,
			callback = function()
				self.params.From = entry.color
				self.context.refreshTools()
			end,
		})
	end

	self.context.menu:toggle({ anchor = anchor, items = items, width = SwapColorTool.menuWidth, search = false })
end

function SwapColorTool:apply()
	local roots = self:requireRoots(false)

	if not roots then
		return
	end

	local params = self.params
	local tolerance = math.clamp(params.Tolerance, 0, 100) / 100
	local swapped = 0

	local transform = function(color: Color3): Color3
		if colorOps.getDistance(color, params.From) <= tolerance + 1e-4 then
			swapped += 1

			return params.To
		end

		return color
	end

	self:run("Swap Colours", function()
		for _, instance in self:getAffected() do
			colorOps.apply(instance, transform)
		end
	end)

	if swapped == 0 then
		self.context.notify(SwapColorTool.messages.noMatch)
	else
		self.context.notify(string.format(SwapColorTool.messages.done, swapped, if swapped == 1 then "" else "s"))
	end
end

return SwapColorTool
]]></ProtectedString>
								<string name="ScriptGuid">{ED801C1B-1C9C-4ECA-81CD-59609090B5AC}</string>
