						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local inputModule = require("userInputService")
local runService = game:GetService("RunService")
local guiService = game:GetService("GuiService")
local parallax = {}
local targets = {}
local heartbeat, changed, focus

local function visible(layer)
	if not layer.Parent then
		return false
	end
	local current = layer
	while current do
		if current:IsA("GuiObject") and not current.Visible then
			return false
		end
		if current:IsA("ScreenGui") or current:IsA("PluginGui") then
			return current.Enabled
		end
		current = current.Parent
	end
	return false
end

local function aim(viewport)
	local size = viewport.AbsoluteSize
	if
		size.X <= 0
		or size.Y <= 0
		or not inputModule.isWindowFocused()
		or not inputModule.isGuiPointCompatible(viewport)
	then
		return Vector2.zero
	end
	local point = inputModule:GetMouseLocation()
	local screen = viewport:FindFirstAncestorWhichIsA("ScreenGui")
	if screen and not screen.IgnoreGuiInset then
		point -= guiService:GetGuiInset()
	end
	local relative = point - viewport.AbsolutePosition
	return Vector2.new(
		math.clamp(relative.X / size.X * 2 - 1, -1, 1),
		math.clamp(relative.Y / size.Y * 2 - 1, -1, 1)
	) * -0.035
end

local function stop()
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
end

function parallax.step(dt)
	local moving = false
	for layer, state in targets do
		if visible(layer) then
			local target = aim(state.viewport)
			local alpha = state.smoothness == 0 and 1
				or 1 - math.exp(-math.max(0, dt) / (0.01 + 0.49 * (state.smoothness / 100) ^ 2))
			local offset = state.offset:Lerp(target, alpha)
			if (offset - target).Magnitude < 0.00001 then
				offset = target
			else
				moving = true
			end
			if offset ~= state.offset then
				state.offset = offset
				layer.Position = UDim2.fromScale(0.5 + offset.X, 0.5 + offset.Y)
			end
		end
	end
	if not moving then
		stop()
	end
end

local function wake()
	if heartbeat then
		return
	end
	for layer in targets do
		if visible(layer) then
			heartbeat = runService.RenderStepped:Connect(parallax.step)
			return
		end
	end
end

local function unbind(layer)
	local state = targets[layer]
	if not state then
		return
	end
	targets[layer] = nil
	for _, connection in state.connections do
		connection:Disconnect()
	end
	for _, connection in state.ancestors do
		connection:Disconnect()
	end
	if not next(targets) then
		stop()
		if changed then
			changed:Disconnect()
			changed = nil
		end
		if focus then
			focus:Disconnect()
			focus = nil
		end
	end
end

function parallax.bind(layer, viewport, layout)
	if not layout.parallax then
		unbind(layer)
		layer.AnchorPoint = Vector2.new(0.5, 0.5)
		layer.Position = UDim2.fromScale(0.5, 0.5)
		layer.Size = UDim2.fromScale(1, 1)
		return
	end

	local state = targets[layer]
	if not state then
		state = { viewport = viewport, offset = Vector2.zero, connections = {}, ancestors = {} }
		targets[layer] = state
		local function ancestry()
			for _, connection in state.ancestors do
				connection:Disconnect()
			end
			table.clear(state.ancestors)
			local current = layer
			while current do
				local property = current:IsA("GuiObject") and "Visible"
					or (current:IsA("ScreenGui") or current:IsA("PluginGui")) and "Enabled"
				if property then
					table.insert(
						state.ancestors,
						current:GetPropertyChangedSignal(property):Connect(wake)
					)
				end
				current = current.Parent
			end
			wake()
		end
		table.insert(
			state.connections,
			layer.Destroying:Connect(function()
				unbind(layer)
			end)
		)
		table.insert(state.connections, layer.AncestryChanged:Connect(ancestry))
		for _, property in { "AbsolutePosition", "AbsoluteSize" } do
			table.insert(
				state.connections,
				viewport:GetPropertyChangedSignal(property):Connect(wake)
			)
		end
		ancestry()
	end
	state.smoothness = layout.smoothness
	layer.AnchorPoint = Vector2.new(0.5, 0.5)
	layer.Size = UDim2.fromScale(1.08, 1.08)
	layer.Position = UDim2.fromScale(0.5 + state.offset.X, 0.5 + state.offset.Y)
	if not changed then
		changed = inputModule.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				wake()
			end
		end)
		focus = inputModule.WindowFocusReleased:Connect(wake)
	end
	wake()
end

function parallax.destroy()
	for layer in targets do
		unbind(layer)
	end
end

return parallax
]]></ProtectedString>
