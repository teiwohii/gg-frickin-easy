						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">poseMirror</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX8A7E3796BE804DA9BEBBDD47D8C6BD68">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local inputModule = require("userInputService")
local expand = {}
local gesture
inputModule.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		gesture = nil
	end
end)
inputModule.WindowFocusReleased:Connect(function()
	gesture = nil
end)
local function apply(item)
	if
		not gesture
		or gesture.rig ~= item.rigModule
		or gesture.visited[item]
		or not item.moreButton.Active
		or not item.uiElement.Visible
	then
		return
	end
	gesture.visited[item] = true
	if item.openedState ~= gesture.open then
		item:setOpenState(gesture.open)
	end
end
function expand.begin(item)
	if not item.moreButton.Active or inputModule:GetFocusedTextBox() then
		return
	end
	gesture = { rig = item.rigModule, open = not item.openedState, visited = {} }
	apply(item)
end
function expand.enter(item)
	if not inputModule:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		gesture = nil
		return
	end
	apply(item)
end
function expand.collapse(rig)
	if not rig or rig._rebuilding then
		return
	end
	gesture = nil
	rig._rebuilding = true
	local ok, err = pcall(function()
		for _, item in rig._organizationItems or rig._orderedItems do
			if item:hasExpandableChildren() then
				item:setOpenState(false, true)
			end
		end
	end)
	rig._rebuilding = false
	rig:RefreshSelectionFilter()
	if not ok then
		error(err, 0)
	end
end
return expand
]]></ProtectedString>
