						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local data = require("projectData")
local ui = require("ui")
local tool = require("tool")
local notification = require("notification")
local marketplace = game:GetService("MarketplaceService")
local selectionService = game:GetService("Selection")
local import = {}
local busy = false
local prompt

function import.assetId(value)
	local text = tostring(value or ""):match("^%s*(.-)%s*$")
	local id = tonumber(text)
		or tonumber(text:match("rbxassetid://(%d+)"))
		or tonumber(text:match("/catalog/(%d+)"))
		or tonumber(text:match("/library/(%d+)"))
		or tonumber(text:match("/store/asset/(%d+)"))
		or tonumber(text:match("/animations/(%d+)"))
		or tonumber(text:match("[?&]id=(%d+)"))
	assert(id and id > 0 and id % 1 == 0 and id < 2 ^ 53, "Enter a valid Roblox asset ID or link.")
	return id
end

function import.sortSequences(animations)
	local insertion = {}
	for i, animation in animations do
		insertion[animation] = i
	end

	local function modified(animation)
		local value = animation:GetAttribute("EclipseAnimationModified")
		return typeof(value) == "number" and value == value and value < math.huge and value or 0
	end

	table.sort(animations, function(a, b)
		local am, bm = modified(a), modified(b)
		return am > bm or am == bm and insertion[a] > insertion[b]
	end)
	return animations
end

function import.selectedSequences(selected)
	local result, seen, visited = {}, {}, {}
	local slice = os.clock()

	local function visit(object)
		if visited[object] then
			return
		end

		visited[object] = true
		if os.clock() - slice >= 0.012 then
			task.wait()
			slice = os.clock()
		end

		if object:IsA("KeyframeSequence") then
			if not seen[object] then
				seen[object] = true
				table.insert(result, object)
			end

			return
		end

		for _, child in object:GetChildren() do
			visit(child)
		end

		if object:IsA("ObjectValue") and object.Name == "AnimSaves" and object.Value then
			visit(object.Value)
		end
	end

	for _, object in selected or selectionService:Get() do
		visit(object)
	end

	import.sortSequences(result)
	return result
end

function import.load(id, emote)
	id = import.assetId(id)
	local sequence
	local failures = {}
	local pending, seen = {id}, {[id] = true}
	local curveFound = false
	local function editable(value)
		return typeof(value) == "Instance" and value:IsA("KeyframeSequence") and #value:GetKeyframes() > 0
	end
	local function inspect(value)
		if editable(value) then
			sequence = value
			sequence.Parent = nil
		elseif value:IsA("Animation") then
			local valid, target = pcall(import.assetId, value.AnimationId)
			if valid and not seen[target] and #pending < 16 then
				seen[target] = true
				table.insert(pending, target)
			end
		elseif value:IsA("CurveAnimation") then
			curveFound = true
		end
	end
	local cursor = 1
	while not sequence and cursor <= #pending do
		local candidate = pending[cursor]
		cursor += 1
		local inserted, container = pcall(function()
			return game:GetService("InsertService"):LoadAsset(candidate)
		end)
		if inserted and typeof(container) == "Instance" then
			inspect(container)
			if not sequence then
				for _, object in container:GetDescendants() do
					inspect(object)
					if sequence then break end
				end
			end
			if container ~= sequence then container:Destroy() end
		elseif not inserted then
			table.insert(failures, tostring(container))
		end
		if not sequence and not (emote and cursor <= #pending and candidate == id) then
			for _, name in {"AnimationClipProvider", "KeyframeSequenceProvider"} do
				local fetched, result = pcall(function()
					local service = game:GetService(name)
					if name == "AnimationClipProvider" then return service:GetAnimationClipAsync("rbxassetid://" .. candidate) end
					return service:GetKeyframeSequenceAsync("rbxassetid://" .. candidate)
				end)
				if fetched and typeof(result) == "Instance" then
					inspect(result)
					if result ~= sequence then result:Destroy() end
				elseif not fetched then
					table.insert(failures, tostring(result))
				end
				if sequence then break end
			end
		end
	end
	if not sequence then
		for _, issue in failures do warn("[Eclipse] Animation import: " .. issue) end
		error(curveFound
			and "This asset contains curve animation data, but Roblox did not return an editable KeyframeSequence. The animation has not been changed."
			or "Roblox did not return an editable animation. Check the asset ID and animation access, or insert its KeyframeSequence in Studio and import it from Explorer.", 0)
	end
	local found, info = pcall(marketplace.GetProductInfoAsync, marketplace, id)
	sequence.Name = found and type(info) == "table" and type(info.Name) == "string" and info.Name or sequence.Name
	return sequence
end

function import.store(rig, sequence)
	assert(rig and rig.Parent, "The selected rig was removed while importing.")
	assert(sequence and sequence:IsA("KeyframeSequence"), "No keyframe sequence was returned.")
	local saves = data.ensureAnimSaves(rig)
	local target = saves:IsA("ObjectValue") and saves.Value or saves
	assert(target, "This rig's animation folder is unavailable.")
	sequence.Name = data.getUniqueExportName(saves, sequence.Name)

	sequence:SetAttribute("EclipseAnimationModified", DateTime.now().UnixTimestampMillis)
	sequence.Parent = target
	return sequence
end

function import.run(rig, kind, id, done)
	if busy then
		return
	end

	if not rig or not rig.Parent then
		notification.show("Import animation", "Select a rig first.")
		return
	end

	busy = true
	task.spawn(function()
		local sequence
		local ok, err = pcall(function()
			local plugin = assert(data.getPlugin(), "Eclipse is not ready.")
			if kind == "Roblox" then
				local asset = plugin:PromptForExistingAssetIdAsync("Animation")
				if not asset or asset <= 0 then
					return
				end

				sequence = import.load(asset, false)
			elseif kind == "FBX" then
				local humanoid = rig:FindFirstChildOfClass("Humanoid")
				sequence = plugin:ImportFbxAnimationAsync(
					rig,
					humanoid ~= nil and humanoid.RigType == Enum.HumanoidRigType.R15
				)
				if not sequence then
					return
				end
			else
				sequence = import.load(id, true)
			end

			import.store(rig, sequence)
		end)
		busy = false
		if not ok then
			if sequence then
				sequence:Destroy()
			end

			notification.show("Couldn't import animation", (tostring(err):gsub("^.-:%d+: ", "")))
		elseif sequence then
			notification.show(
				"Animation imported",
				sequence.Name .. " is in this rig's animation list."
			)
			if done then
				done(sequence)
			end
		end
	end)
end

function import.open(rig, kind, done)
	if kind ~= "Avatar Shop" then
		import.run(rig, kind, nil, done)
		return
	end

	if not rig then
		notification.show("Import animation", "Select a rig first.")
		return
	end

	if prompt then
		prompt:close(true)
	end

	local window = tool.new(
		{ ScreenGui = ui.EclipseGUI, Plugin = data.getPlugin() },
		"EclipseEmoteImport",
		"AVATAR SHOP",
		Vector2.new(360, 134),
		false,

		function()
			prompt = nil
		end,
		{ AllowMainMenu = true }
	)
	prompt = window
	tool.label(
		window.frame,
		"Label",
		"Emote ID or Avatar Shop link",
		UDim2.fromOffset(12, 38),
		UDim2.fromOffset(336, 18)
	)
	local field =
		tool.field(window.frame, "Emote", "", UDim2.fromOffset(12, 60), UDim2.fromOffset(336, 26))

	local function submit()
		local ok, id = pcall(import.assetId, field.Text)
		if not ok then
			field.PlaceholderText = "Enter an emote ID or link"
			field.Text = ""
			return
		end

		window:close()
		import.run(rig, kind, id, done)
	end

	tool.button(
		window.frame,
		"Import",
		"IMPORT",
		UDim2.fromOffset(236, 98),
		UDim2.fromOffset(112, 26),
		submit
	)
	field.FocusLost:Connect(function(enter)
		if enter then
			submit()
		end
	end)
end

function import.isR15(rig)
	if not rig or not rig:IsA("Model") then
		return false
	end
	local lower, upper = false, false
	for _, object in require("rigTraversal").rigDescendants(rig) do
		if object:IsA("BasePart") or object:IsA("Bone") then
			lower = lower or object.Name == "LowerTorso"
			upper = upper or object.Name == "UpperTorso"
		end
	end
	return lower and upper
end

function import.r15Rigs(state)
	local result = {}
	for _, rig in state.getAllRigs() do
		if import.isR15(rig) then
			table.insert(result, rig)
		end
	end
	return result
end

function import.validateRig(rig, sequence)
	if not rig or not sequence or not sequence:IsA("KeyframeSequence") then
		return
	end
	if sequence:FindFirstChild("EclipseKeyframeData") then
		return
	end
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R6 then
		return
	end
	for _, name in { "Torso", "Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg" } do
		local part = rig:FindFirstChild(name)
		if not part or not part:IsA("BasePart") then
			return
		end
	end
	if import.isR15(rig) then
		return
	end
	for _, frame in sequence:GetKeyframes() do
		for _, pose in frame:GetDescendants() do
			if pose:IsA("Pose") and pose.Name == "UpperTorso"
				and pose.Parent:IsA("Pose") and pose.Parent.Name == "LowerTorso" then
				error("This animation uses an R15 rig. Import it onto an R15 rig, then use Convert R15 to R6. Existing keys are unchanged.", 0)
			end
		end
	end
end

function import.nativeSequence(sequence)
	if not sequence or not sequence:IsA("KeyframeSequence") then
		return nil
	end
	local copy = Instance.new("KeyframeSequence")
	copy.Name, copy.Loop, copy.Priority = sequence.Name, sequence.Loop, sequence.Priority
	local function clean(parent)
		for name in parent:GetAttributes() do
			parent:SetAttribute(name, nil)
		end
		for _, object in parent:GetChildren() do
			if object:IsA("PoseBase") and not object:GetAttribute("EclipseR6Control") then
				clean(object)
			elseif object:IsA("Folder") and object.Name == "FaceControls" and parent:IsA("Pose") then
				clean(object)
			elseif object:IsA("KeyframeMarker") then
				for name in object:GetAttributes() do
					object:SetAttribute(name, nil)
				end
			else
				object:Destroy()
			end
		end
	end
	for _, key in sequence:GetKeyframes() do
		local cloned = key:Clone()
		clean(cloned)
		cloned.Parent = copy
	end
	return copy
end

function import.nativeR15(sequence)
	local lower, upper = false, false
	for _, pose in sequence:GetDescendants() do
		if pose:IsA("Pose") then
			lower = lower or pose.Name == "LowerTorso"
			upper = upper or pose.Name == "UpperTorso"
		end
	end
	if not lower or not upper then
		return nil
	end
	local copy = Instance.new("KeyframeSequence")
	copy.Name, copy.Loop, copy.Priority = sequence.Name, sequence.Loop, sequence.Priority
	for _, key in sequence:GetKeyframes() do
		local cloned = key:Clone()
		for _, object in cloned:GetDescendants() do
			if object:IsA("Pose") and object:GetAttribute("EclipseR6Control") then
				object:Destroy()
			else
				for name in object:GetAttributes() do
					object:SetAttribute(name, nil)
				end
			end
		end
		cloned.Parent = copy
	end
	return copy
end

function import.convertR15Sequence(sequence, sourceRig, targetRig, defaults, rootMotion)
	assert(import.isR15(sourceRig), "Choose an R15 rig.")
	local r15Retarget = require("r15Retarget")
	local joints = r15Retarget.sourceJoints(require("parenting").collectMotors(sourceRig), defaults)
	return r15Retarget.convert(sequence, joints, targetRig, {
		rootPart = sourceRig:FindFirstChild("HumanoidRootPart", true),
		rootMotion = rootMotion,
		sourceScale = require("poseSpace").getRigScale(sourceRig),
	})
end

local function rigMotion(rig, timeline)
	local properties = require("properties")
	if not rig:IsA("Model") or properties.inheritedTransform(rig) then
		return nil
	end
	local raw = timeline:GetState()
	local track
	for _, motor in properties.list(rig, false, true) do
		if
			motor.PropertyId == "CFrame"
			and not motor:GetAttribute("EclipseDisabled")
			and next(raw.Keyframes[motor] or {})
		then
			track = motor
		end
	end
	if not track then
		return nil
	end
	local targetModule = require("target")
	local function pivotAt(time)
		local bucket = raw.Keyframes[track]
		local value = targetModule.hasChild(bucket)
				and targetModule.childWorld(time, bucket, function(key)
					return properties.decode(track, key.C0, key.PropertyValue)
				end)
			or properties.evaluate(track, bucket, time)
		return typeof(value) == "CFrame" and value or nil
	end
	local root = rig:FindFirstChild("HumanoidRootPart", true)
	local offset = root and rig:GetPivot():ToObjectSpace(root.CFrame) or CFrame.identity
	local start = pivotAt(timeline:GetPoseTime(0))
	if not start then
		return nil
	end
	return function(time)
		local value = pivotAt(timeline:GetPoseTime(time))
		return value and offset:Inverse() * start:ToObjectSpace(value) * offset or CFrame.identity
	end,
		start * offset
end

function import.convertR15(rig)
	local stateModule = require("state")
	assert(table.find(import.r15Rigs(stateModule), rig), "Choose an R15 rig in this file.")
	assert(not require("blenderEdit").blocked(), "Finish the current edit before converting.")
	assert(
		not stateModule.LiveSession or not stateModule.LiveSession.isJoined(),
		"Leave Live before converting a rig."
	)
	local timeline, project = stateModule.Timeline, stateModule.currentRig
	local copy, baked, converted
	local ok, issue = xpcall(function()
		local description = Instance.new("HumanoidDescription")
		local human = rig:FindFirstChildOfClass("Humanoid")
		if human then
			local success, applied = pcall(human.GetAppliedDescription, human)
			if success then
				description:Destroy()
				description = applied
			end
		end
		local created, model = pcall(
			game:GetService("Players").CreateHumanoidModelFromDescriptionAsync,
			game:GetService("Players"),
			description,
			Enum.HumanoidRigType.R6
		)
		description:Destroy()
		assert(created, "Roblox could not create the R6 copy: " .. tostring(model))
		copy = model
		assert(
			stateModule.currentRig == project
				and stateModule.Timeline == timeline
				and table.find(stateModule.getAllRigs(), rig),
			"The open project changed; retry conversion."
		)
		local baseName, suffix = rig.Name .. " R6", 1
		copy.Name = baseName
		while workspace:FindFirstChild(copy.Name) do
			suffix += 1
			copy.Name = baseName .. " (" .. suffix .. ")"
		end
		for _, object in copy:GetDescendants() do
			if object:IsA("BaseScript") then
				object:Destroy()
			elseif object:IsA("BasePart") then
				object.Anchored = true
			end
		end
		baked = require("export").bakeAnimation(rig, false)
		local moved, motion, start = pcall(rigMotion, rig, timeline)
		local placement
		converted, placement = import.convertR15Sequence(
			baked,
			rig,
			copy,
			timeline:GetState().DefaultPose,
			moved and motion or nil
		)
		local sourceRoot, targetRoot =
			rig:FindFirstChild("HumanoidRootPart", true), copy:FindFirstChild("HumanoidRootPart")
		if sourceRoot and targetRoot then
			local base = (moved and start or sourceRoot.CFrame)
				* CFrame.new(5, placement.ground15 - placement.ground6, 0)
			copy:PivotTo(base * targetRoot.CFrame:ToObjectSpace(copy:GetPivot()))
		else
			copy:PivotTo(rig:GetPivot() * CFrame.new(5, 0, 0))
		end
		copy.Parent = workspace
		import.store(copy, converted)
		copy:SetAttribute("EclipseConvertedFrom", rig.Name)
	end, debug.traceback)
	if baked then
		baked:Destroy()
	end
	if not ok then
		if copy then
			copy:Destroy()
		end
		error(issue, 0)
	end
	return copy
end

function import.selectedR15(state, selection, includeTimeline)
	local rigs = import.r15Rigs(state)
	if #rigs == 1 then
		return rigs[1]
	end
	local found = {}
	local function add(object)
		if typeof(object) ~= "Instance" then
			return
		end
		for _, rig in rigs do
			if object == rig or object:IsDescendantOf(rig) then
				found[rig] = true
			end
		end
		while object do
			local source = object:FindFirstChild("EclipseSourceRig")
			if source and source:IsA("ObjectValue") and table.find(rigs, source.Value) then
				found[source.Value] = true
			end
			object = object.Parent
		end
	end
	for _, object in selection do
		add(object)
	end
	if #selection == 0 and includeTimeline then
		for item in state.Rig and state.Rig._selectedItems or {} do
			add(item.linkedRigInstance)
			add(item.grandpa and item.grandpa.linkedRigInstance)
		end
		if not next(found) and state.Axis then
			add(state.Axis:GetSelectedBone())
		end
	end
	local rig
	for candidate in found do
		if rig then
			return nil
		end
		rig = candidate
	end
	return rig
end

function import.openR15Converter()
	if busy then
		return
	end
	local stateModule = require("state")
	local rig = import.selectedR15(stateModule, selectionService:Get(), true)
	if not rig then
		notification.show(
			"SELECT AN R15 RIG",
			"Select an R15 rig in this file. Custom rigs need standard R15 part or bone names, including LowerTorso and UpperTorso."
		)
		return
	end
	busy = true
	task.spawn(function()
		local ok, result = pcall(import.convertR15, rig)
		busy = false
		notification.show(
			ok and "R6 COPY CREATED" or "CONVERSION NEEDS ATTENTION",
			ok
					and "The animation is saved in the R6 copy's AnimSaves. Exit the R15 file, then select the R6 copy to preview it. R6 has no elbows or knees."
				or tostring(result)
		)
	end)
end

return import
]]></ProtectedString>
						<string name="ScriptGuid">{FB338233-D7E4-4AB3-8958-84C8DE4BEB6A}</string>
