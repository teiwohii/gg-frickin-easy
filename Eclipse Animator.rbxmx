						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local FlipbookQuad = require(script.Parent.FlipbookQuad)
local FlipbookStrips = require(script.Parent.FlipbookStrips)

local ParticleSnapshot = {}
ParticleSnapshot.__index = ParticleSnapshot

ParticleSnapshot.instanceName = "_ArcParticleSnapshot"
ParticleSnapshot.buckets = 64
ParticleSnapshot.maxPerEmitter = 600
ParticleSnapshot.maxTotal = 3000
ParticleSnapshot.maxContinuous = 400
ParticleSnapshot.timeEpsilon = 1e-4
ParticleSnapshot.ln2 = math.log(2)
ParticleSnapshot.clockStep = 1 / 60
ParticleSnapshot.minimumScale = 0.02
ParticleSnapshot.prebuildLimit = 600
ParticleSnapshot.minimumFrameTime = 1 / 240
ParticleSnapshot.maximumFrameTime = 1 / 20
ParticleSnapshot.frameTimeBlend = 0.1
ParticleSnapshot.horizon = 1e6
ParticleSnapshot.staticProperties = {
	"Texture",
	"LightEmission",
	"LightInfluence",
	"Brightness",
	"Orientation",
	"ZOffset",
	"FlipbookLayout",
	"FlipbookSizeX",
	"FlipbookSizeY",
	"FlipbookBlendFrames",
	"FlipbookMode",
	"FlipbookFramerate",
	"FlipbookStartRandom",
	"Acceleration",
	"Drag",
	"WindAffectsDrag",
}
ParticleSnapshot.directions = {
	[Enum.NormalId.Top] = Vector3.new(0, 1, 0),
	[Enum.NormalId.Bottom] = Vector3.new(0, -1, 0),
	[Enum.NormalId.Right] = Vector3.new(1, 0, 0),
	[Enum.NormalId.Left] = Vector3.new(-1, 0, 0),
	[Enum.NormalId.Back] = Vector3.new(0, 0, 1),
	[Enum.NormalId.Front] = Vector3.new(0, 0, -1),
}

function ParticleSnapshot.recover()
	for _, child in workspace.Terrain:GetChildren() do
		if child.Name == ParticleSnapshot.instanceName then
			child:Destroy()
		end
	end
end

function ParticleSnapshot.new()
	local self = setmetatable({}, ParticleSnapshot)

	self.pools = {}
	self.sampler = nil
	self.restorer = nil
	self.timeScale = 0
	self.activeQuads = {}
	self.facingConnection = nil
	self.strips = FlipbookStrips.new()
	self.prebuildPending = true
	self.frameTime = ParticleSnapshot.clockStep
	self.scaleSampler = nil
	self.factors = {}

	return self
end

function ParticleSnapshot:setScaleSampler(sampler)
	self.scaleSampler = sampler
end

function ParticleSnapshot:getScaleSource(emitter: ParticleEmitter)
	if not self.scaleSampler then
		return nil
	end

	return self.scaleSampler(emitter)
end

function ParticleSnapshot:getScaleAt(source, time: number): number
	if typeof(source) == "function" then
		return math.clamp(source(time) or 1, 0, 1)
	end

	if typeof(source) == "number" then
		return math.clamp(source, 0, 1)
	end

	return 1
end

function ParticleSnapshot:buildClock(emitter: ParticleEmitter, target: number, maxLife: number)
	local source = self:getScaleSource(emitter)

	if typeof(source) ~= "function" then
		local scale = if source == nil then 1 else math.max(self:getScaleAt(source, target), ParticleSnapshot.minimumScale)

		return {
			window = maxLife / scale,
			factor = self:getScaleAt(source, target),
			age = function(spawn: number): number
				return math.max(target - spawn, 0) * scale
			end,
		}
	end

	local step = ParticleSnapshot.clockStep
	local totals = { [0] = 0 }
	local count = 0

	while totals[count] < maxLife and count * step < target do
		local to = target - count * step
		local from = math.max(to - step, 0)

		totals[count + 1] = totals[count] + self:getScaleAt(source, (from + to) / 2) * (to - from)
		count += 1
	end

	return {
		window = count * step,
		factor = self:getScaleAt(source, target),
		age = function(spawn: number): number
			local position = math.clamp((target - spawn) / step, 0, count)
			local index = math.min(math.floor(position), math.max(count - 1, 0))
			local low = totals[index] or 0
			local high = totals[index + 1] or low

			return low + (high - low) * (position - index)
		end,
	}
end

function ParticleSnapshot:getFactor(emitter: ParticleEmitter): number
	return self.factors[emitter] or 1
end

function ParticleSnapshot:refreshFactors(target: number): boolean
	if not self.scaleSampler then
		return false
	end

	local changed = false

	for emitter, pool in self.pools do
		if emitter.Parent and pool.used > 0 then
			local factor = self:getScaleAt(self:getScaleSource(emitter), target)

			if math.abs(factor - self:getFactor(emitter)) > 1e-4 then
				self.factors[emitter] = factor
				changed = true
			end
		end
	end

	return changed
end

function ParticleSnapshot:setSampler(sampler: ((ParticleEmitter, number) -> ())?)
	self.sampler = sampler
end

function ParticleSnapshot:setRestorer(restorer: (() -> ())?)
	self.restorer = restorer
end

function ParticleSnapshot.hash(text: string): number
	local value = 5381

	for index = 1, #text do
		value = (value * 33 + string.byte(text, index)) % 2147483647
	end

	return value
end

function ParticleSnapshot.evaluateNumber(sequence: NumberSequence, time: number): (number, number)
	local keypoints = sequence.Keypoints

	for index = 1, #keypoints - 1 do
		local current = keypoints[index]
		local following = keypoints[index + 1]

		if time >= current.Time and time <= following.Time then
			local span = following.Time - current.Time
			local alpha = if span > 0 then (time - current.Time) / span else 0

			return current.Value + (following.Value - current.Value) * alpha, current.Envelope + (following.Envelope - current.Envelope) * alpha
		end
	end

	local last = keypoints[#keypoints]

	return last.Value, last.Envelope
end

function ParticleSnapshot.evaluateColor(sequence: ColorSequence, time: number): Color3
	local keypoints = sequence.Keypoints

	for index = 1, #keypoints - 1 do
		local current = keypoints[index]
		local following = keypoints[index + 1]

		if time >= current.Time and time <= following.Time then
			local span = following.Time - current.Time
			local alpha = if span > 0 then (time - current.Time) / span else 0

			return current.Value:Lerp(following.Value, alpha)
		end
	end

	return keypoints[#keypoints].Value
end

function ParticleSnapshot.remapNumber(sequence: NumberSequence, start: number): NumberSequence
	if start <= 0 then
		return sequence
	end

	local span = math.max(1 - start, 1e-3)
	local firstValue, firstEnvelope = ParticleSnapshot.evaluateNumber(sequence, start)
	local lastValue, lastEnvelope = ParticleSnapshot.evaluateNumber(sequence, 1)
	local keypoints = { NumberSequenceKeypoint.new(0, firstValue, firstEnvelope) }

	for _, keypoint in sequence.Keypoints do
		if keypoint.Time > start + 1e-4 and keypoint.Time < 1 - 1e-4 then
			table.insert(keypoints, NumberSequenceKeypoint.new((keypoint.Time - start) / span, keypoint.Value, keypoint.Envelope))
		end
	end

	table.insert(keypoints, NumberSequenceKeypoint.new(1, lastValue, lastEnvelope))

	local success, remapped = pcall(NumberSequence.new, keypoints)

	return if success then remapped else sequence
end

function ParticleSnapshot.remapColor(sequence: ColorSequence, start: number): ColorSequence
	if start <= 0 then
		return sequence
	end

	local span = math.max(1 - start, 1e-3)
	local keypoints = { ColorSequenceKeypoint.new(0, ParticleSnapshot.evaluateColor(sequence, start)) }

	for _, keypoint in sequence.Keypoints do
		if keypoint.Time > start + 1e-4 and keypoint.Time < 1 - 1e-4 then
			table.insert(keypoints, ColorSequenceKeypoint.new((keypoint.Time - start) / span, keypoint.Value))
		end
	end

	table.insert(keypoints, ColorSequenceKeypoint.new(1, ParticleSnapshot.evaluateColor(sequence, 1)))

	local success, remapped = pcall(ColorSequence.new, keypoints)

	return if success then remapped else sequence
end

function ParticleSnapshot.orthonormal(direction: Vector3): (Vector3, Vector3)
	local reference = if math.abs(direction.Y) < 0.99 then Vector3.yAxis else Vector3.xAxis
	local right = reference:Cross(direction)

	if right.Magnitude < 1e-6 then
		right = Vector3.zAxis:Cross(direction)
	end

	right = right.Unit

	return right, direction:Cross(right).Unit
end

function ParticleSnapshot.randomRange(random: Random, range: NumberRange): number
	if range.Max <= range.Min then
		return range.Min
	end

	return random:NextNumber(range.Min, range.Max)
end

function ParticleSnapshot:getSpawnFrame(emitter: ParticleEmitter)
	local parent = emitter.Parent

	if parent and parent:IsA("Attachment") then
		return parent.WorldCFrame, nil, parent
	end

	if parent and parent:IsA("BasePart") then
		return parent.CFrame, parent.Size, parent
	end

	return nil, nil, nil
end

function ParticleSnapshot:readSpawnState(emitter: ParticleEmitter)
	local cframe, size, parent = self:getSpawnFrame(emitter)

	if not cframe then
		return nil
	end

	return {
		cframe = cframe,
		size = size,
		parent = parent,
		lifetime = emitter.Lifetime,
		speed = emitter.Speed,
		spread = emitter.SpreadAngle,
		rotation = emitter.Rotation,
		rotSpeed = emitter.RotSpeed,
		acceleration = emitter.Acceleration,
		drag = emitter.Drag,
		direction = ParticleSnapshot.directions[emitter.EmissionDirection] or Vector3.yAxis,
		shape = emitter.Shape,
		shapeStyle = emitter.ShapeStyle,
		shapeInOut = emitter.ShapeInOut,
		shapePartial = math.clamp(emitter.ShapePartial, 0, 1),
		locked = emitter.LockedToPart,
	}
end

function ParticleSnapshot:getShapeSample(spawn, random: Random): (Vector3, Vector3)
	local cframe = spawn.cframe
	local axis = spawn.direction

	if not spawn.size then
		return cframe.Position, cframe:VectorToWorldSpace(axis)
	end

	local half = spawn.size / 2
	local surface = spawn.shapeStyle == Enum.ParticleEmitterShapeStyle.Surface
	local offset = Vector3.zero
	local direction = axis

	local partial = spawn.shapePartial or 1

	if spawn.shape == Enum.ParticleEmitterShape.Sphere then
		local right, up = ParticleSnapshot.orthonormal(axis)
		local cosine = random:NextNumber(math.cos(math.pi * partial), 1)
		local sine = math.sqrt(math.max(1 - cosine * cosine, 0))
		local angle = random:NextNumber(0, math.pi * 2)
		local unit = axis * cosine + (right * math.cos(angle) + up * math.sin(angle)) * sine
		local radius = if surface then 1 else random:NextNumber() ^ (1 / 3)

		offset = unit * half * radius
		direction = unit
	elseif spawn.shape == Enum.ParticleEmitterShape.Cylinder then
		local angle = random:NextNumber(0, math.pi * 2)
		local radius = if surface then 1 else math.sqrt(random:NextNumber())
		local right, up = ParticleSnapshot.orthonormal(axis)
		local radial = right * math.cos(angle) + up * math.sin(angle)
		local length = random:NextNumber(-1, 1)
		local taper = 1 + (partial - 1) * (length + 1) / 2

		offset = (radial * radius * taper + axis * length) * half
		direction = radial
	elseif spawn.shape == Enum.ParticleEmitterShape.Disc then
		local angle = random:NextNumber(0, math.pi * 2)
		local inner = partial * partial
		local radius = if surface then 1 else math.sqrt(inner + (1 - inner) * random:NextNumber())
		local right, up = ParticleSnapshot.orthonormal(axis)

		offset = (right * math.cos(angle) + up * math.sin(angle)) * radius * half
	else
		offset = Vector3.new(random:NextNumber(-1, 1), random:NextNumber(-1, 1), random:NextNumber(-1, 1)) * half

		if surface then
			local component = random:NextInteger(1, 3)
			local sign = if random:NextNumber() < 0.5 then -1 else 1

			offset = Vector3.new(
				if component == 1 then half.X * sign else offset.X,
				if component == 2 then half.Y * sign else offset.Y,
				if component == 3 then half.Z * sign else offset.Z
			)
		end
	end

	if spawn.shapeInOut == Enum.ParticleEmitterShapeInOut.Inward then
		direction = -direction
	elseif spawn.shapeInOut == Enum.ParticleEmitterShapeInOut.InAndOut and random:NextNumber() < 0.5 then
		direction = -direction
	end

	return cframe:PointToWorldSpace(offset), cframe:VectorToWorldSpace(direction)
end

function ParticleSnapshot:applySpread(direction: Vector3, spread: Vector2, random: Random): Vector3
	if spread.X == 0 and spread.Y == 0 then
		return direction
	end

	local right, forward = ParticleSnapshot.orthonormal(direction)
	local basis = CFrame.fromMatrix(Vector3.zero, right, direction, -forward)
	local rotated = basis * CFrame.Angles(math.rad(random:NextNumber(-spread.X, spread.X)), 0, math.rad(random:NextNumber(-spread.Y, spread.Y)))

	return rotated.UpVector
end

function ParticleSnapshot:integrate(position: Vector3, velocity: Vector3, acceleration: Vector3, drag: number, age: number): (Vector3, Vector3)
	if drag <= 0 then
		return position + velocity * age + acceleration * (0.5 * age * age), velocity + acceleration * age
	end

	local k = drag * ParticleSnapshot.ln2
	local terminal = acceleration / k
	local decay = math.exp(-k * age)

	return position + terminal * age + (velocity - terminal) * ((1 - decay) / k), terminal + (velocity - terminal) * decay
end

function ParticleSnapshot:collectTimes(track, target: number, inclusive: boolean, window: number)
	local emitter = track.emitter
	local times = {}

	local function include(time: number, seed: number)
		local age = target - time

		if age < -ParticleSnapshot.timeEpsilon or age > window then
			return
		end

		if not inclusive and age <= ParticleSnapshot.timeEpsilon then
			return
		end

		table.insert(times, { time = time, seed = seed })
	end

	for eventIndex, event in track.events do
		local count = math.max(0, math.round(event.count))
		local startSeed = math.floor(event.start * 1000) * 7919 + eventIndex * 104729

		local first = 1
		local last = count

		if event.duration > 0 and count > 0 then
			local spacing = event.duration / count
			local margin = ParticleSnapshot.timeEpsilon

			first = math.max(1, math.floor((target - window - margin - event.start) / spacing))
			last = math.min(count, math.ceil((target + margin - event.start) / spacing))
		end

		for index = first, last do
			local time = if event.duration > 0 then event.start + event.duration * index / count else event.start

			include(time, startSeed + index * 131)
		end
	end

	if emitter.Enabled and emitter.Rate > 0 then
		local rate = emitter.Rate
		local first = math.max(1, math.ceil(math.max(0, target - window) * rate))
		local last = math.floor(target * rate)

		first = math.max(first, last - ParticleSnapshot.maxContinuous + 1)

		for index = first, last do
			include(index / rate, 900001 + index * 257)
		end
	end

	table.sort(times, function(a, b)
		return a.time < b.time
	end)

	return times
end

function ParticleSnapshot:drawParticle(spawn, random: Random)
	local life = ParticleSnapshot.randomRange(random, spawn.lifetime)
	local origin, direction = self:getShapeSample(spawn, random)
	local speed = ParticleSnapshot.randomRange(random, spawn.speed)

	direction = self:applySpread(direction, spawn.spread, random)

	local rotation = ParticleSnapshot.randomRange(random, spawn.rotation)
	local rotSpeed = ParticleSnapshot.randomRange(random, spawn.rotSpeed)

	return life, origin, direction, speed, rotation, rotSpeed
end

function ParticleSnapshot:setFrameTime(deltaTime: number)
	local clamped = math.clamp(deltaTime, ParticleSnapshot.minimumFrameTime, ParticleSnapshot.maximumFrameTime)

	self.frameTime += (clamped - self.frameTime) * ParticleSnapshot.frameTimeBlend
end

function ParticleSnapshot:getSpawnLag(factor: number): number
	if self.timeScale > 0 then
		return 0
	end

	return self.frameTime * factor
end

function ParticleSnapshot:requestPrebuild()
	self.prebuildPending = true
end

function ParticleSnapshot:consumeReady(): boolean
	return self.strips:consumeReady()
end

function ParticleSnapshot:prebuild(tracks)
	for _, track in tracks do
		local emitter = track.emitter

		if emitter.Parent and FlipbookStrips.supports(emitter) then
			local entries = self:collectTimes(track, ParticleSnapshot.horizon, true, ParticleSnapshot.horizon * 2)
			local baseSeed = ParticleSnapshot.hash(emitter:GetFullName())
			local sampledTime = nil
			local spawn = nil

			for index = 1, math.min(#entries, ParticleSnapshot.prebuildLimit) do
				local entry = entries[index]

				if not sampledTime or math.abs(entry.time - sampledTime) > ParticleSnapshot.timeEpsilon then
					sampledTime = entry.time

					if self.sampler then
						self.sampler(emitter, entry.time)
					end

					spawn = self:readSpawnState(emitter)
				end

				if spawn then
					local identity = baseSeed + entry.seed
					local life, _, _, _, rotation, rotSpeed = self:drawParticle(spawn, Random.new(identity))

					if life > 0 and not self.strips:request(emitter, identity, life, rotation, rotSpeed, true) then
						return
					end
				end
			end
		end
	end
end

function ParticleSnapshot:getLook(pool, source: ParticleEmitter, particle, cframe: CFrame)
	local progress = particle.progress
	local size, sizeEnvelope = ParticleSnapshot.evaluateNumber(source.Size, progress)
	local transparency, transparencyEnvelope = ParticleSnapshot.evaluateNumber(source.Transparency, progress)
	local squash, squashEnvelope = ParticleSnapshot.evaluateNumber(source.Squash, progress)

	return {
		cframe = cframe,
		progress = progress,
		statics = pool.signature,
		size = FlipbookStrips.constant(size, sizeEnvelope),
		transparency = FlipbookStrips.constant(transparency, transparencyEnvelope),
		squash = FlipbookStrips.constant(squash, squashEnvelope),
		color = ColorSequence.new(ParticleSnapshot.evaluateColor(source.Color, progress)),
	}
end

function ParticleSnapshot:simulate(track, target: number, inclusive: boolean, budget: number)
	local emitter = track.emitter
	local maxLife = math.max(emitter.Lifetime.Max, 0)
	local clock = self:buildClock(emitter, target, maxLife)
	local times = self:collectTimes(track, target, inclusive, clock.window)
	local particles = {}

	self.factors[emitter] = clock.factor

	if #times == 0 then
		return particles
	end

	local baseSeed = ParticleSnapshot.hash(emitter:GetFullName())
	local sampledTime = nil
	local spawn = nil
	local limit = math.min(ParticleSnapshot.maxPerEmitter, budget)
	local lag = self:getSpawnLag(clock.factor)

	for index = #times, 1, -1 do
		if #particles >= limit then
			break
		end

		local entry = times[index]

		if not sampledTime or math.abs(entry.time - sampledTime) > ParticleSnapshot.timeEpsilon then
			sampledTime = entry.time

			if self.sampler then
				self.sampler(emitter, entry.time)
			end

			spawn = self:readSpawnState(emitter)
		end

		if spawn then
			local identity = baseSeed + entry.seed
			local life, origin, direction, speed, rotation, rotSpeed = self:drawParticle(spawn, Random.new(identity))
			local age = clock.age(entry.time) - lag

			if life > 0 and age >= 0 and age < life then
				local position, velocity = self:integrate(origin, direction * speed, spawn.acceleration, spawn.drag, age)

				table.insert(particles, {
					identity = identity,
					position = position,
					velocity = velocity,
					initialRotation = rotation,
					fallback = direction,
					rotation = rotation + rotSpeed * age,
					rotSpeed = rotSpeed,
					remaining = life - age,
					progress = age / life,
					age = age,
					life = life,
					flipbookSeed = baseSeed + entry.seed + 15485863,
					locked = if spawn.locked and spawn.parent then { parent = spawn.parent, cframe = spawn.cframe } else nil,
				})
			end
		end
	end

	return particles
end

function ParticleSnapshot:getPool(emitter: ParticleEmitter)
	local pool = self.pools[emitter]

	if not pool then
		pool = { pairs = {}, used = 0, sequences = {}, signature = nil }
		self.pools[emitter] = pool
	end

	return pool
end

function ParticleSnapshot:getSignature(emitter: ParticleEmitter): string
	local parts = {}

	for _, name in ParticleSnapshot.staticProperties do
		table.insert(parts, tostring((emitter :: any)[name]))
	end

	return table.concat(parts, "|")
end

function ParticleSnapshot:copyStatics(source: ParticleEmitter, target: ParticleEmitter)
	for _, name in ParticleSnapshot.staticProperties do
		pcall(function()
			(target :: any)[name] = (source :: any)[name]
		end)
	end
end

function ParticleSnapshot:createPair(source: ParticleEmitter)
	local attachment = Instance.new("Attachment")
	attachment.Name = ParticleSnapshot.instanceName
	attachment.Archivable = false

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = ParticleSnapshot.instanceName
	emitter.Archivable = false
	emitter.Enabled = false
	emitter.Rate = 0
	emitter.SpreadAngle = Vector2.zero
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.LockedToPart = false
	emitter.VelocityInheritance = 0
	emitter.TimeScale = self.timeScale
	self:copyStatics(source, emitter)
	emitter.Parent = attachment
	attachment.Parent = workspace.Terrain

	return { attachment = attachment, emitter = emitter, bucket = nil, signature = nil }
end

function ParticleSnapshot:getSequences(pool, source: ParticleEmitter, bucket: number)
	local cached = pool.sequences[bucket]

	if cached then
		return cached
	end

	local start = (bucket + 0.5) / ParticleSnapshot.buckets

	if bucket == 0 then
		start = 0
	end

	cached = {
		Size = ParticleSnapshot.remapNumber(source.Size, start),
		Transparency = ParticleSnapshot.remapNumber(source.Transparency, start),
		Squash = ParticleSnapshot.remapNumber(source.Squash, start),
		Color = ParticleSnapshot.remapColor(source.Color, start),
	}

	pool.sequences[bucket] = cached

	return cached
end

function ParticleSnapshot:renderParticle(pool, source: ParticleEmitter, pair, particle)
	local emitter = pair.emitter
	local velocity = particle.velocity
	local speed = velocity.Magnitude
	local direction = if speed > 1e-4 then velocity / speed else particle.fallback
	local position = particle.position

	if particle.locked and particle.locked.parent.Parent then
		local current = self:getSpawnFrame(source)

		if current then
			local relative = particle.locked.cframe:ToObjectSpace(CFrame.new(position))
			position = (current * relative).Position
			direction = current:VectorToWorldSpace(particle.locked.cframe:VectorToObjectSpace(direction))
		end
	end

	local right, up = ParticleSnapshot.orthonormal(direction)
	local bucket = math.clamp(math.floor(particle.progress * ParticleSnapshot.buckets), 0, ParticleSnapshot.buckets - 1)

	if self.timeScale <= 0 and FlipbookStrips.supports(source) then
		local strip = self.strips:request(source, particle.identity, particle.life, particle.initialRotation, particle.rotSpeed)

		if self.strips:show(strip, self:getLook(pool, source, particle, CFrame.fromMatrix(position, right, direction))) then
			pair.pending = false
			self:hideQuad(pair)
			emitter:Clear()

			return
		end
	end

	if pair.signature ~= pool.signature then
		self:copyStatics(source, emitter)
		pair.signature = pool.signature
	end

	if pair.bucket ~= bucket or pair.generation ~= pool.generation then
		local sequences = self:getSequences(pool, source, bucket)

		emitter.Size = sequences.Size
		emitter.Transparency = sequences.Transparency
		emitter.Squash = sequences.Squash
		emitter.Color = sequences.Color
		pair.bucket = bucket
		pair.generation = pool.generation
	end

	pair.attachment.WorldCFrame = CFrame.fromMatrix(position, right, direction)
	emitter.Speed = NumberRange.new(speed)
	emitter.Lifetime = NumberRange.new(math.max(particle.remaining, 1e-3))
	emitter.Rotation = NumberRange.new(particle.rotation)
	emitter.RotSpeed = NumberRange.new(particle.rotSpeed)
	emitter.TimeScale = math.clamp(self.timeScale * self:getFactor(source), 0, 1)
	emitter:Clear()

	if self.timeScale <= 0 and FlipbookQuad.supports(source) then
		pair.pending = true
		self:showQuad(pair, source, particle, position)
	else
		pair.pending = false
		self:hideQuad(pair)
		emitter:Emit(1)
	end
end


function ParticleSnapshot:getSquashedSize(size: number, squash: number): (number, number)
	if squash > 0 then
		return size / (1 + squash), size * (1 + squash)
	elseif squash < 0 then
		return size * (1 - squash), size / (1 - squash)
	end

	return size, size
end

function ParticleSnapshot:showQuad(pair, source: ParticleEmitter, particle, position: Vector3)
	local quad = pair.quad

	if not quad then
		quad = FlipbookQuad.new(ParticleSnapshot.instanceName)
		pair.quad = quad
	end

	local progress = particle.progress
	local size = ParticleSnapshot.evaluateNumber(source.Size, progress)
	local width, height = self:getSquashedSize(size, ParticleSnapshot.evaluateNumber(source.Squash, progress))
	local gridX, gridY = FlipbookQuad.getGridDimensions(source)

	quad:show({
		texture = source.Texture,
		gridX = gridX,
		gridY = gridY,
		frame = FlipbookQuad.getFrameIndex(source, particle.age, particle.life, particle.flipbookSeed),
		color = ParticleSnapshot.evaluateColor(source.Color, progress),
		transparency = math.clamp(ParticleSnapshot.evaluateNumber(source.Transparency, progress), 0, 1),
		brightness = source.Brightness,
		lightInfluence = source.LightInfluence,
		width = width,
		height = height,
		position = position,
		rotation = particle.rotation,
		zOffset = source.ZOffset,
		worldUp = source.Orientation == Enum.ParticleOrientation.FacingCameraWorldUp,
	})

	self.activeQuads[quad] = true
	self:bindFacing()
end

function ParticleSnapshot:hideQuad(pair)
	local quad = pair.quad

	if quad then
		quad:hide()
		self.activeQuads[quad] = nil
	end
end

function ParticleSnapshot:bindFacing()
	if self.facingConnection then
		return
	end

	self.facingConnection = runService.Heartbeat:Connect(function()
		local camera = workspace.CurrentCamera

		if next(self.activeQuads) == nil then
			self:unbindFacing()
			return
		end

		for quad in self.activeQuads do
			quad:face(camera)
		end
	end)
end

function ParticleSnapshot:unbindFacing()
	if self.facingConnection then
		self.facingConnection:Disconnect()
		self.facingConnection = nil
	end
end

function ParticleSnapshot:releasePool(pool, from: number)
	for index = from, #pool.pairs do
		local pair = pool.pairs[index]

		if pair.emitter.Parent then
			pair.emitter:Clear()
		end

		pair.pending = false
		self:hideQuad(pair)
	end
end

function ParticleSnapshot:build(tracks, target: number, inclusive: boolean, timeScale: number)
	self.timeScale = timeScale
	self.strips:beginFrame()

	if timeScale <= 0 and self.prebuildPending then
		self.prebuildPending = false
		self.strips:prune()
		self:prebuild(tracks)
	end

	local results = {}
	local budget = ParticleSnapshot.maxTotal

	for _, track in tracks do
		local emitter = track.emitter

		if emitter.Parent and budget > 0 then
			local particles = self:simulate(track, target, inclusive, budget)

			budget -= #particles
			results[emitter] = particles
		end
	end

	if self.restorer then
		self.restorer()
	end

	for emitter, pool in self.pools do
		if not results[emitter] then
			self:releasePool(pool, 1)
			pool.used = 0
		end
	end

	for emitter, particles in results do
		local pool = self:getPool(emitter)
		local signature = self:getSignature(emitter)
		local sequenceKey = tostring(emitter.Size) .. tostring(emitter.Transparency) .. tostring(emitter.Squash) .. tostring(emitter.Color)

		pool.signature = signature

		if pool.sequenceKey ~= sequenceKey then
			pool.sequenceKey = sequenceKey
			pool.sequences = {}
			pool.generation = (pool.generation or 0) + 1
		end

		for index, particle in particles do
			local pair = pool.pairs[index]

			if not pair or not pair.attachment.Parent or not pair.emitter.Parent then
				if pair then
					pair.attachment:Destroy()

					if pair.quad then
						self.activeQuads[pair.quad] = nil
						pair.quad:destroy()
					end
				end

				pair = self:createPair(emitter)
				pool.pairs[index] = pair
			end

			self:renderParticle(pool, emitter, pair, particle)
		end

		self:releasePool(pool, #particles + 1)
		pool.used = #particles
	end

	if timeScale <= 0 then
		self.strips:endFrame()
	else
		self.strips:hideAll()
	end
end

function ParticleSnapshot:setTimeScale(timeScale: number, force: boolean?)
	if self.timeScale == timeScale and not force then
		return
	end

	self.timeScale = timeScale

	if timeScale > 0 then
		self.strips:hideAll()
	end

	for emitter, pool in self.pools do
		for index = 1, pool.used do
			local pair = pool.pairs[index]

			if pair and pair.emitter.Parent then
				pair.emitter.TimeScale = math.clamp(timeScale * self:getFactor(emitter), 0, 1)

				if pair.pending and timeScale > 0 then
					pair.pending = false
					self:hideQuad(pair)
					pair.emitter:Emit(1)
				end
			end
		end
	end
end

function ParticleSnapshot:clear()
	for _, pool in self.pools do
		self:releasePool(pool, 1)
		pool.used = 0
	end
end

function ParticleSnapshot:destroy()
	self:reset()
	self.strips:destroy()
end

function ParticleSnapshot:reset()
	self:unbindFacing()
	self.strips:hideAll()

	for _, pool in self.pools do
		for _, pair in pool.pairs do
			pair.attachment:Destroy()

			if pair.quad then
				pair.quad:destroy()
			end
		end
	end

	table.clear(self.pools)
	table.clear(self.activeQuads)
end

return ParticleSnapshot
]]></ProtectedString>
