						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">afterimageGeometry</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC5263C7474AB4D6A93635D6884798821">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!native
-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local configModule = require("afterimageConfig")
local binding = require("afterimageBinding")
local geometry = require("afterimageGeometry")
local afterimages = {}
local refs, root, connections, entries = nil, nil, {}, {}
local generation, otherHighlights, preparing = 0, {}, false
local failed = {}
local sampling = false
local ensureWorld
local warnedVisible = false

local function notify(message)
	require("notification").show("AFTERIMAGE", message, 6)
end

local function discard(entry)
	for _, connection in entry.connections or {} do
		connection:Disconnect()
	end
	for _, slot in entry.slots do
		slot.model:Destroy()
	end
	for _, pose in entry.poses do
		geometry.destroyPose(pose)
	end
	geometry.destroyPlan(entry.plan)
end

function afterimages.clear()
	generation += 1
	for _, entry in entries do
		discard(entry)
	end
	table.clear(entries)
	table.clear(failed)
	warnedVisible = false
end

local function hide()
	for _, entry in entries do
		for _, slot in entry.slots do
			if slot.model.Parent then
				slot.model.Parent = nil
			end
		end
	end
end

local function stamp(model, target, config)
	local result = { target, refs.State.Timeline:GetState().FPS }
	for _, key in
		{ "StartFrame", "Amount", "MaxVisible", "IntervalFrames", "HoldFrames", "FadeFrames" }
	do
		table.insert(result, config[key])
	end
	return result
end

local function same(a, b)
	if not a or #a ~= #b then
		return false
	end
	for index, value in a do
		if value ~= b[index] then
			return false
		end
	end
	return true
end

local function models()
	local result = {}
	for _, model in refs.State.getAllRigs() do
		if binding.is(model) then
			table.insert(result, model)
		end
	end
	table.sort(result, function(a, b)
		return tostring(a:GetAttribute("EclipseTrackId"))
			< tostring(b:GetAttribute("EclipseTrackId"))
	end)
	return result
end

local function build(model, isCurrent, epoch)
	local target = binding.target(model)
	assert(target, "Afterimage has no rig/bone parent; move its track to the intended rig or bone")
	local config = configModule.read(model)
	local owner = binding.owner(target, refs.State.getAllRigs())
	assert(owner, "Afterimage source is missing from this animation")
	local expected = stamp(model, target, config)
	if entries[model] and same(entries[model].stamp, expected) then
		return true
	end
	if entries[model] then
		discard(entries[model])
		entries[model] = nil
	end
	local entry = {
		plan = geometry.plan(owner, target),
		poses = {},
		slots = {},
		stamp = expected,
		connections = {},
	}
	local function current()
		return generation == epoch
			and refs ~= nil
			and not refs.State.LoadingProject
			and (not isCurrent or isCurrent())
			and binding.target(model) == target
	end
	local yieldedAt = os.clock()
	local function checkpoint()
		if os.clock() - yieldedAt >= 0.004 then
			task.wait()
			yieldedAt = os.clock()
		end
	end
	local ok, issue = xpcall(function()
		for index = 1, config.Amount do
			if not current() then
				return
			end
			sampling = true
			local captured, pose = pcall(
				require("afterimageSampler").capture,
				refs.State,
				entry.plan,
				configModule.birth(config, index),
				true
			)
			sampling = false
			assert(captured, pose)
			entry.poses[index] = pose
			if pose.moving then
				geometry.finishPose(pose)
			end
			 
			checkpoint()
		end
		local capacity = math.min(
			config.Amount,
			config.MaxVisible,
			math.ceil((config.HoldFrames + config.FadeFrames) / config.IntervalFrames)
		)
		for _ = 1, capacity do
			if not current() then
				return
			end
			local slot = geometry.slot(entry.plan)
			slot.highlight:SetAttribute("EclipseAfterimageHighlight", true)
			table.insert(entry.slots, slot)
			checkpoint()
		end
	end, debug.traceback)
	sampling = false
	if not ok or not current() then
		discard(entry)
		if not ok then
			error(issue, 0)
		end
		return false
	end
	 
	local function topologyChanged()
		if not sampling then
			afterimages.clear()
		end
	end
	table.insert(entry.connections, owner.DescendantAdded:Connect(topologyChanged))
	table.insert(entry.connections, owner.DescendantRemoving:Connect(topologyChanged))
	entries[model] = entry
	return true
end

function afterimages.prepare(isCurrent)
	if not refs then
		return true
	end
	if refs.State.LoadingProject then
		return false
	end
	if #models() == 0 then
		return true
	end
	ensureWorld()
	if preparing then
		while preparing do
			if not refs or refs.State.LoadingProject or isCurrent and not isCurrent() then
				return false
			end
			task.wait()
		end
	end
	if not refs or refs.State.LoadingProject then
		return false
	end
	preparing = true
	hide()
	local epoch = generation
	local completed = true
	local currentModel
	local ok, issue = xpcall(function()
		for _, model in models() do
			currentModel = model
			if failed[model] then
				continue
			end
			local built, result = xpcall(function()
				return build(model, isCurrent, epoch)
			end, debug.traceback)
			if not built then
				failed[model] = tostring(result)
				notify("Could not prepare " .. model.Name .. ". " .. tostring(result))
				warn("[Eclipse Afterimage] " .. tostring(result))
			elseif not result then
				completed = false
				return
			end
		end
	end, debug.traceback)
	preparing = false
	if not ok then
		if currentModel then
			failed[currentModel] = tostring(issue)
		end
		notify(tostring(issue))
		warn("[Eclipse Afterimage] " .. tostring(issue))
		return false
	end
	return completed
end

function afterimages.step(present, active, frame)
	if not refs then
		return
	end
	for model, entry in entries do
		if not present[model] then
			discard(entry)
			entries[model] = nil
		end
	end
	if not active or preparing or refs.State.LoadingProject then
		hide()
		return
	end
	local rows, budget = {}, 255
	for highlight in otherHighlights do
		if highlight:IsDescendantOf(game) then
			budget -= 1
		else
			otherHighlights[highlight] = nil
		end
	end
	budget = math.max(0, budget)
	for _, model in models() do
		if failed[model] then
			continue
		end
		local config = configModule.read(model)
		local target = binding.target(model)
		local entry = entries[model]
		if not entry or not same(entry.stamp, stamp(model, target, config)) then
			 
			if entry then
				discard(entry)
				entries[model] = nil
			end
			if not afterimages.pending then
				afterimages.pending = true
				task.defer(function()
					afterimages.prepare()
					afterimages.pending = false
				end)
			end
			continue
		end
		local visible = configModule.visible(config, frame, entry.poses, nil, #entry.slots)
		local enabled = present[model]
			and require("organization").isEnabled(model)
			and config.Enabled
		table.insert(rows, {
			entry = entry,
			config = config,
			wanted = enabled and #visible or 0,
			grant = 0,
		})
	end
	 
	local requested = 0
	for _, row in rows do
		requested += row.wanted
	end
	if requested > 20 and not warnedVisible then
		warnedVisible = true
		notify(
			"More than 20 afterimages at once may cause lag. Reduce Max Visible to lower the cost."
		)
	end
	while budget > 0 do
		local allocated = false
		for _, row in rows do
			if row.grant < row.wanted and budget > 0 then
				row.grant += 1
				budget -= 1
				allocated = true
			end
		end
		if not allocated then
			break
		end
	end
	 
	for _, row in rows do
		local limit = row.grant
		if row.grant > 0 and row.grant == row.wanted then
			limit = nil
		end
		row.visible = configModule.visible(row.config, frame, row.entry.poses, limit, #row.entry.slots)
		local used = {}
		for _, emission in row.visible do
			used[emission.slot] = true
		end
		for index, slot in row.entry.slots do
			if not used[index] then
				slot.model.Parent = nil
			end
		end
	end
	for _, row in rows do
		for _, emission in row.visible do
			local slot = row.entry.slots[emission.slot]
			if slot.birth ~= emission.index then
				geometry.apply(slot, row.entry.poses[emission.index], emission.index)
			end
			local color, opacity =
				configModule.color(row.config, emission.index, emission.birth, frame - emission.birth)
			geometry.paint(slot, row.config, emission.alpha * (opacity or 1), color)
			if slot.model.Parent ~= root then
				slot.model.Parent = root
			end
		end
	end
end

function afterimages.build(value)
	local config = configModule.normalize(value.settings or {})
	local model = Instance.new("Model")
	model.Name = value.name or "Afterimage"
	model:SetAttribute("EclipseEffectObject", 1)
	model:SetAttribute("EffectKind", "Afterimage")
	model:SetAttribute("EclipseTrackId", game:GetService("HttpService"):GenerateGUID(false))
	for key, setting in config do
		model:SetAttribute("Effect" .. key, setting)
	end
	binding.save(model, value.target, refs.State.getAllRigs())
	return model
end

function afterimages.validate(value)
	local settings = configModule.normalize(value.settings or {})
	assert(binding.validTarget(value.target), "Select a rig or bone")
	return {
		kind = "Afterimage",
		name = value.name or "Afterimage",
		target = value.target,
		settings = settings,
		start = settings.StartFrame,
		duration = (settings.Amount - 1) * settings.IntervalFrames
			+ settings.HoldFrames
			+ settings.FadeFrames,
	}
end

function afterimages.edit(target)
	return require("afterimageEditor").open(refs, target)
end

function afterimages.destroy()
	afterimages.clear()
	for _, connection in connections do
		if type(connection) == "function" then
			connection()
		else
			connection:Disconnect()
		end
	end
	table.clear(connections)
	table.clear(otherHighlights)
	if root then
		root:Destroy()
		root = nil
	end
	refs = nil
end

ensureWorld = function()
	if root then
		return
	end
	root = Instance.new("Folder")
	root.Name = "_EclipseAfterimages"
	root.Archivable = false
	root:SetAttribute("EclipseGeneratedVisual", true)
	require("recovery").mark(root)
	root.Parent = workspace
	local function added(object)
		if object:IsA("Highlight") and not object:GetAttribute("EclipseAfterimageHighlight") then
			otherHighlights[object] = true
		end
	end
	for _, object in game:GetDescendants() do
		added(object)
	end
	table.insert(connections, game.DescendantAdded:Connect(added))
	table.insert(
		connections,
		game.DescendantRemoving:Connect(function(object)
			otherHighlights[object] = nil
		end)
	)
end

function afterimages.init(options)
	afterimages.destroy()
	refs = options
	table.insert(connections, require("history").subscribe(afterimages.clear))
end

return afterimages
]]></ProtectedString>
