						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

return function(frames, time)
	local count = #frames
	if count == 0 then
		return nil, nil
	end
	if time <= frames[1].Time then
		return frames[1], frames[1]
	end
	local low, high = 1, count
	while low < high do
		local middle = math.ceil((low + high) / 2)
		if frames[middle].Time <= time then
			low = middle
		else
			high = middle - 1
		end
	end
	local left = frames[low]
	return left, (left.Time == time or low == count) and left or frames[low + 1]
end
]]></ProtectedString>
