					<Item class="ModuleScript" referent="RBX5CDF0F97D14B4DDEBAA80FC6F23CBF49">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local InstanceFactory = {}
InstanceFactory.__index = InstanceFactory

function InstanceFactory.new()
	local self = setmetatable({}, InstanceFactory)

	self.created = {}

	return self
end

function InstanceFactory:create(className: string, properties: { [string]: any }): Instance
	local instance = Instance.new(className)
	local parent = properties.Parent

	for property, value in properties do
		if property ~= "Parent" then
			instance[property] = value
		end
	end

	instance.Parent = parent
	table.insert(self.created, instance)

	return instance
end

function InstanceFactory:clear()
	for index = #self.created, 1, -1 do
		self.created[index]:Destroy()
	end

	table.clear(self.created)
end

return InstanceFactory
]]></ProtectedString>
							<string name="ScriptGuid">{EA504302-D936-40E6-98E6-047A30CA4635}</string>
