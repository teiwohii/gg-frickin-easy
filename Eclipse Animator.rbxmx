						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local config = require("afterimageConfig")
local tool = require("tool")
local editor = {}
local window

function editor.open(refs, explicitTarget)
	if window then
		window:close(true)
	end
	local binding = require("afterimageBinding")
	local target = explicitTarget or binding.selected(refs.State)
	if not target or not (binding.is(target) or binding.validTarget(target)) then
		require("notification").show(
			"AFTERIMAGE",
			"Select a rig or bone before adding an afterimage.",
			5
		)
		return false
	end
	local editing = binding.is(target) and target or nil
	local values = editing and config.read(editing) or table.clone(config.defaults)
	if not editing then
		local timeline = refs.State.Timeline:GetState()
		values.StartFrame = math.floor(timeline.CurrentTime * timeline.FPS + 0.5)
	end
	local swatches = {}
	window = tool.new(
		refs,
		"EclipseAfterimage",
		"AFTERIMAGE",
		Vector2.new(400, 320),
		false,
		function()
			for _, swatch in swatches do
				if require("picker").isOpen(swatch) then
					require("picker").close(true)
				end
			end
			window = nil
		end,
		{ Scrollable = true, FitToViewport = true, Resizable = false }
	)
	local current = window
	local frame, parent = current.frame, current.content
	local scroll = parent.Parent
	scroll.AnchorPoint = Vector2.zero
	scroll.Position = UDim2.fromOffset(8, 66)
	scroll.Size = UDim2.new(1, -16, 1, -110)
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.CanvasSize = UDim2.new()
	parent.AnchorPoint = Vector2.zero
	parent.Position = UDim2.new()
	parent.Size = UDim2.new(1, -8, 0, 0)

	local pages, fields, rows, labels = {}, {}, {}, {}
	local selected = "Timing"
	local mode = values.Rainbow and "Rainbow" or values.Gradient and "Gradient" or "Solid"
	local refresh, paintRamp
	local function row(pageName, id, title, options)
		local page = pages[pageName]
		local container = tool.make("Frame", page, id .. "Row", {
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundTransparency = 1,
		})
		tool.label(container, "Label", title, UDim2.fromOffset(4, 0), UDim2.new(0.54, -4, 1, 0))
		local value = values[id]
		local position, size = UDim2.new(0.54, 0, 0, 3), UDim2.new(0.46, -4, 0, 28)
		if type(value) == "boolean" then
			local button, label =
				tool.button(container, id, value and "On" or "Off", position, size)
			button.Activated:Connect(function()
				values[id] = not values[id]
				label.Text = values[id] and "On" or "Off"
			end)
		elseif typeof(value) == "Color3" then
			local swatch = tool.make("TextButton", container, id .. "Swatch", {
				Text = "",
				Position = position,
				Size = size,
				BackgroundColor3 = value,
				BorderSizePixel = 0,
			})
			swatches[id] = swatch
			swatch.Activated:Connect(function()
				require("picker").open(refs, swatch, { stops = { values[id] } }, function(result)
					values[id] = result.stops[1]
					swatch.BackgroundColor3 = values[id]
				end, {
					solid = true,
					commitOnDone = true,
					alive = function()
						return window == current
					end,
				})
			end)
		else
			fields[id] = tool.field(container, id, value, position, size, options)
		end
		rows[#rows + 1] = { page = pageName, id = id, object = container }
		labels[id] = title
	end
	for _, name in { "Timing", "Appearance", "Advanced" } do
		pages[name] = tool.make(
			"Frame",
			parent,
			name,
			{ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }
		)
	end
	local countOptions = { step = 1, min = 1, max = 255 }
	row("Timing", "StartFrame", "Start frame", { step = 1, min = 0 })
	row("Timing", "Amount", "Total copies", countOptions)
	row("Timing", "MaxVisible", "Visible at once", countOptions)
	row("Timing", "IntervalFrames", "Spacing (frames)", { step = 1, min = 1 })
	row("Timing", "HoldFrames", "Hold (frames)", { step = 1, min = 0 })
	row("Timing", "FadeFrames", "Fade (frames)", { step = 1, min = 0 })

	local appearance = pages.Appearance
	local modeRow = tool.make(
		"Frame",
		appearance,
		"ColorModeRow",
		{ Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 }
	)
	tool.label(modeRow, "Label", "Color mode", UDim2.fromOffset(4, 0), UDim2.new(0.54, -4, 1, 0))
	local modeButton, modeLabel = tool.button(
		modeRow,
		"ColorMode",
		mode,
		UDim2.new(0.54, 0, 0, 3),
		UDim2.new(0.46, -4, 0, 28)
	)
	modeButton.Activated:Connect(function()
		local choices = { "Solid", "Gradient", "Rainbow" }
		mode = choices[table.find(choices, mode) % #choices + 1]
		values.Rainbow, values.Gradient = mode == "Rainbow", mode == "Gradient"
		modeLabel.Text = mode
		if mode == "Solid" or (mode == "Gradient" and #config.stops(values) < 2) then
			values.ColorRamp = ""
		end
		if paintRamp then
			paintRamp()
		end
		refresh()
	end)
	local ramp = tool.make("TextButton", appearance, "ColorRamp", {
		Text = "",
		Position = UDim2.fromOffset(4, 37),
		Size = UDim2.new(1, -8, 0, 28),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		AutoButtonColor = false,
	})
	local rampGradient = tool.make("UIGradient", ramp, "Gradient", {})
	swatches.ColorRamp = ramp
	paintRamp = function()
		local colors, alphas = {}, {}
		local stops = config.stops(values)
		for _, stop in stops do
			table.insert(colors, ColorSequenceKeypoint.new(stop.at, stop.color))
			table.insert(alphas, NumberSequenceKeypoint.new(stop.at, 1 - stop.alpha))
		end
		if colors[1].Time > 0 then
			table.insert(colors, 1, ColorSequenceKeypoint.new(0, colors[1].Value))
			table.insert(alphas, 1, NumberSequenceKeypoint.new(0, alphas[1].Value))
		end
		if colors[#colors].Time < 1 then
			table.insert(colors, ColorSequenceKeypoint.new(1, colors[#colors].Value))
			table.insert(alphas, NumberSequenceKeypoint.new(1, alphas[#alphas].Value))
		end
		rampGradient.Color = ColorSequence.new(colors)
		rampGradient.Transparency = NumberSequence.new(alphas)
	end
	ramp.Activated:Connect(function()
		local value = { stops = {}, positions = {}, alphas = {} }
		for _, stop in config.stops(values) do
			table.insert(value.stops, stop.color)
			table.insert(value.positions, stop.at)
			table.insert(value.alphas, stop.alpha)
		end
		require("picker").open(refs, ramp, value, function(result)
			local saved = {}
			for i, color in result.stops do
				table.insert(
					saved,
					{ at = result.positions[i], alpha = result.alphas[i], color = {
						color.R,
						color.G,
						color.B,
					} }
				)
			end
			values.ColorRamp = game:GetService("HttpService"):JSONEncode(saved)
			values.Color = result.stops[1]
			values.Color2 = result.stops[#result.stops]
			values.Gradient = #result.stops > 1
			values.Rainbow = false
			mode = values.Gradient and "Gradient" or "Solid"
			modeLabel.Text = mode
			paintRamp()
			refresh()
		end, {
			drawing = true,
			temporal = true,
			commitOnDone = true,
			alive = function()
				return window == current
			end,
		})
	end)
	paintRamp()
	row("Appearance", "RainbowPeriodFrames", "Rainbow cycle (frames)", { step = 1, min = 1 })
	row("Appearance", "Opacity", "Body opacity", { step = 0.05, min = 0, max = 1 })
	row("Appearance", "FillOpacity", "Glow opacity", { step = 0.05, min = 0, max = 1 })
	row("Appearance", "OutlineOpacity", "Outline opacity", { step = 0.05, min = 0, max = 1 })
	row("Appearance", "OutlineColor", "Outline color")
	row("Advanced", "TintBody", "Tint copied surfaces")
	row("Advanced", "AlwaysOnTop", "Show through objects")
	row("Advanced", "GradientOverLifetime", "Gradient over lifetime")
	row("Advanced", "LegacyRainbow", "Classic rainbow")
	row("Advanced", "RainbowSaturation", "Rainbow saturation", { step = 0.05, min = 0, max = 1 })
	row("Advanced", "RainbowValue", "Rainbow brightness", { step = 0.05, min = 0, max = 1 })

	local tabs = {}
	local tabBar = tool.make("Frame", frame, "Tabs", {
		Position = UDim2.fromOffset(8, 32),
		Size = UDim2.new(1, -16, 0, 30),
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(15, 12, 19),
	})
	tabBar:SetAttribute("ThemeBg", "Pnl")
	tabBar:SetAttribute("EclipseTabBar", true)
	tool.make("UICorner", tabBar, "Corner", { CornerRadius = UDim.new(0, 5) })
	local outline = tool.make("UIStroke", tabBar, "Outline", { Transparency = 0.35, Thickness = 1 })
	outline:SetAttribute("ThemeStrk", "Strk")
	refresh = function()
		for name, page in pages do
			page.Visible = name == selected
		end
		local heights = { Timing = 0, Appearance = 68, Advanced = 0 }
		for _, entry in rows do
			local id = entry.id
			local visible = not (
				id == "GradientOverLifetime" and mode ~= "Gradient"
				or (
						id == "RainbowPeriodFrames"
						or id == "LegacyRainbow"
						or id == "RainbowSaturation"
						or id == "RainbowValue"
					)
					and mode ~= "Rainbow"
			)
			entry.object.Visible = visible
			if visible then
				entry.object.Position = UDim2.fromOffset(0, heights[entry.page])
				heights[entry.page] += 34
			end
		end
		local height = heights[selected] + 4
		parent.Size = UDim2.new(1, -8, 0, height)
		scroll.CanvasSize = UDim2.fromOffset(0, height)
		scroll.CanvasPosition = Vector2.zero
		for name, button in tabs do
			button:SetAttribute("ThemeBgTransparency", name == selected and 0 or 1)
			button.BackgroundTransparency = name == selected and 0 or 1
			button.TextLabel:SetAttribute("ThemeTxtTransparency", name == selected and 0 or 0.35)
			button.TextLabel.TextTransparency = name == selected and 0 or 0.35
		end
		current:setSize(Vector2.new(400, height + 110))
	end
	for index, name in { "Timing", "Appearance", "Advanced" } do
		local button = tool.button(
			tabBar,
			name .. "Tab",
			name,
			UDim2.new((index - 1) / 3, 2, 0, 2),
			UDim2.new(1 / 3, -4, 0, 26),
			function()
				selected = name
				refresh()
			end
		)
		tabs[name] = button
	end
	tool.button(
		frame,
		"Create",
		editing and "Apply" or "Add afterimage",
		UDim2.new(0, 12, 1, -36),
		UDim2.new(1, -24, 0, 28),
		function()
			local ok, issue = pcall(function()
				for id, field in fields do
					local parsed = typeof(config.defaults[id]) == "Color3"
							and Color3.fromHex(field.Text:gsub("#", ""))
						or tonumber(field.Text)
					assert(parsed ~= nil and config.valid(id, parsed), "Check " .. labels[id])
					values[id] = parsed
				end
				local normalized = config.normalize(values)
				local notice = config.warning(normalized)
				if notice then
					require("notification").show("AFTERIMAGE", notice, 5)
				end
				if editing then
					local before = config.read(editing)
					local function apply(settings)
						for id, value in settings do
							editing:SetAttribute("Effect" .. id, value)
						end
						require("afterimages").clear()
						refs.State.currentProjectSaved = false
					end
					apply(normalized)
					require("history").record(function()
						apply(before)
					end, function()
						apply(normalized)
					end, "Edit afterimage")
				else
					require("effects").create({
						kind = "Afterimage",
						target = target,
						settings = normalized,
					})
				end
				current:close()
			end)
			if not ok then
				require("notification").show("AFTERIMAGE", tostring(issue):gsub("^.-:%d+: ", ""), 5)
			end
		end
	)
	refresh()
	require("theme").applyTree(frame)
end

return editor
]]></ProtectedString>
