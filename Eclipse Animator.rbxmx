							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local configuration = require(script.Parent.Parent.Utility.configuration)

local MeshParticles = {}
MeshParticles.__index = MeshParticles

MeshParticles.prefix = "MeshParticle_"
MeshParticles.enabled = "MeshParticle_Enabled"
MeshParticles.historyName = "Edit Mesh Particle"
MeshParticles.keywords = "mesh particle emit vfx"
MeshParticles.emitText = "Emit"

MeshParticles.choices = {
	EmissionDirection = { "Top", "Bottom", "Front", "Back", "Left", "Right" },
	Orientation = { "None", "FacingCamera", "FacingCameraWorldUp", "VelocityParallel", "VelocityPerpendicular" },
	Shape = { "Point", "Box", "Sphere", "Cylinder", "Disc" },
	ShapeInOut = { "Outward", "Inward", "InAndOut" },
	ShapeStyle = { "Volume", "Surface" },
}

MeshParticles.tips = {
	Enabled = "Include this mesh when the effect is emitted.",
	EmitDelay = "Seconds to wait after the emit before the mesh plays.",
	Size = "Size over the lifetime. 1 is the mesh's own size.",
	Squash = "Above 0 makes the mesh taller and thinner, below 0 shorter and wider.",
	Orientation = "None keeps the mesh's own rotation. The others turn it toward the camera or along its movement.",
	Rotation = "Starting spin in degrees, around the mesh's up axis, or around the view when facing the camera.",
	RotSpeed = "Spin speed in degrees per second.",
	Shape = "Where the mesh starts. Point is its own position, the others pick a random spot inside the mesh's size.",
	ShapePartial = "For Sphere it limits the cap, for Cylinder and Disc it hollows out the middle.",
	Color = "Color over the lifetime. Also tints decals and textures on the mesh.",
	Transparency = "Transparency over the lifetime. Also fades decals and textures on the mesh.",
}

MeshParticles.sections = {
	{ title = "Particle Appearance", key = "Appearance", fields = { "Color", "Size", "Transparency", "Squash", "Orientation", "ZOffset" }, top = true },
	{ title = "Particle Emission", key = "Emission", fields = { "Enabled", "EmitDelay", "Lifetime", "Speed", "SpreadAngle", "EmissionDirection" }, emit = true },
	{ title = "Particle Motion", key = "Motion", fields = { "Acceleration", "Drag", "Rotation", "RotSpeed", "LockedToPart", "TimeScale", "WindAffectsDrag" } },
	{ title = "Particle Shape", key = "Shape", fields = { "Shape", "ShapeInOut", "ShapeStyle", "ShapePartial" }, collapsed = true },
}

MeshParticles.kinds = {
	Enabled = { kind = "toggle", default = true },
	Lifetime = { kind = "range", default = NumberRange.new(1), options = { minimum = 0.01 } },
	Speed = { kind = "range", default = NumberRange.new(0) },
	SpreadAngle = { kind = "vector2", default = Vector2.zero },
	EmissionDirection = { kind = "choice", default = "Top" },
	EmitDelay = { kind = "number", default = 0, options = { minimum = 0, range = { min = 0, max = 3 } } },
	Color = { kind = "gradient" },
	Size = { kind = "sequence", default = NumberSequence.new(1), options = { graphMaximum = 4 } },
	Transparency = { kind = "sequence", options = { graphMaximum = 1 } },
	Squash = { kind = "sequence", default = NumberSequence.new(0), options = { graphMaximum = 3, signed = true } },
	Orientation = { kind = "choice", default = "None" },
	ZOffset = { kind = "number", default = 0, options = { range = { min = -10, max = 10 } } },
	Acceleration = { kind = "vector3", default = Vector3.zero },
	Drag = { kind = "number", default = 0, options = { minimum = 0, range = { min = 0, max = 10 } } },
	Rotation = { kind = "range", default = NumberRange.new(0) },
	RotSpeed = { kind = "range", default = NumberRange.new(0) },
	LockedToPart = { kind = "toggle", default = false },
	TimeScale = { kind = "number", default = 1, options = { minimum = 0, maximum = 1, clamp = true, range = { min = 0, max = 1 } } },
	WindAffectsDrag = { kind = "toggle", default = false },
	Shape = { kind = "choice", default = "Point" },
	ShapeInOut = { kind = "choice", default = "Outward" },
	ShapeStyle = { kind = "choice", default = "Volume" },
	ShapePartial = { kind = "number", default = 1, options = { minimum = 0, maximum = 1, clamp = true, range = { min = 0, max = 1 } } },
}

function MeshParticles.isMesh(instance: Instance): boolean
	return instance:IsA("BasePart")
		and (instance:IsA("MeshPart") or instance:FindFirstChildOfClass("SpecialMesh") ~= nil)
end

function MeshParticles.new(context)
	local self = setmetatable({}, MeshParticles)

	self.context = context
	self.history = context.history
	self.editing = false
	self.previewHandler = nil

	return self
end

function MeshParticles:handles(instance: Instance): boolean
	return MeshParticles.isMesh(instance) and not self.context.asset:isBase(instance)
end

function MeshParticles:getSignature(instance: Instance): string
	return if MeshParticles.isMesh(instance) then "meshparticle" else ""
end

function MeshParticles:finishEdit()
	if self.editing then
		self.editing = false
		self.history:finish()
	end
end

function MeshParticles:set(targets: { Instance }, attribute: string, value, final: boolean)
	if not self.editing then
		self.editing = true
		self.history:begin(MeshParticles.historyName)
	end

	for _, target in targets do
		if target.Parent then
			target:SetAttribute(attribute, value)

			if target:GetAttribute(MeshParticles.enabled) == nil then
				target:SetAttribute(MeshParticles.enabled, true)
			end
		end
	end

	if final then
		self:finishEdit()
	end
end

function MeshParticles:label(name: string): string
	local access = self.context.access
	local ok, label = pcall(function()
		return access:getLabel(name)
	end)

	return if ok and type(label) == "string" and label ~= "" then label else name
end

function MeshParticles:tip(name: string): string?
	local schema = configuration.Create and configuration.Create.Schema
	local tips = schema and schema.tips

	return MeshParticles.tips[name] or (tips and tips[name])
end

function MeshParticles:defaultFor(name: string, first: BasePart)
	if name == "Color" then
		return ColorSequence.new(first.Color)
	elseif name == "Transparency" then
		return NumberSequence.new(math.clamp(first.Transparency, 0, 1))
	end

	return MeshParticles.kinds[name].default
end

function MeshParticles:field(targets: { Instance }, name: string)
	local first = targets[1]
	local spec = MeshParticles.kinds[name]
	local attribute = MeshParticles.prefix .. name
	local default = self:defaultFor(name, first)

	local function read()
		local value = first:GetAttribute(attribute)

		return if typeof(value) == typeof(default) then value else default
	end

	local descriptor = {
		id = "MeshParticle." .. name,
		label = self:label(name),
		kind = spec.kind,
		keywords = MeshParticles.keywords .. " " .. name,
		tip = self:tip(name),
		value = read(),
		read = read,
		onChange = function(value, final, component)
			if value == nil then
				return
			end

			if component then
				value = self.context.access:withComponent(read(), component, value[component])
			end

			self:set(targets, attribute, value, final ~= false)
		end,
	}

	for key, value in spec.options or {} do
		descriptor[key] = value
	end

	local choices = MeshParticles.choices[name]

	if choices then
		local list = {}

		for _, choice in choices do
			table.insert(list, { value = choice, label = choice })
		end

		descriptor.options = list
	end

	return descriptor
end

function MeshParticles:preview(targets: { Instance })
	if self.previewHandler then
		self.previewHandler(targets)
	end
end

function MeshParticles:getSections(targets: { Instance })
	local first = targets[1]

	if not first then
		return {}
	end

	for _, target in targets do
		if not self:handles(target) then
			return {}
		end
	end

	local result = {}

	for _, section in MeshParticles.sections do
		local fields = {}

		for _, name in section.fields do
			table.insert(fields, self:field(targets, name))
		end

		local entry = {
			title = section.title,
			key = "MeshParticle." .. section.key,
			after = not section.top,
			collapsed = section.collapsed,
			fields = fields,
		}

		if section.emit then
			entry.action = {
				text = MeshParticles.emitText,
				tip = "Emit this mesh now.",
				callback = function()
					self:preview(targets)
				end,
			}
		end

		table.insert(result, entry)
	end

	return result
end

function MeshParticles:stop()
	self:finishEdit()
end

function MeshParticles:destroy()
	self:stop()
end

return MeshParticles
]]></ProtectedString>
