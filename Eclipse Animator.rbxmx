							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = require(script.Parent.ShapeKit)

local pillarBeam = {}

pillarBeam.id = "PillarBeam"
pillarBeam.title = "Pillar Beam"
pillarBeam.root = "Model"
pillarBeam.minimumSides = 3
pillarBeam.maximumSides = 64
pillarBeam.bottomName = "Bottom"
pillarBeam.topName = "Top"
pillarBeam.holderSize = Vector3.new(1, 1, 1)

pillarBeam.params = ShapeKit.join({
	{ name = "Height", kind = "number", default = 12, min = 0.1, max = 2000, tip = "How tall the cylinder is, from its bottom ring to its top ring." },
	{ name = "Sides", kind = "number", default = 20, min = 3, max = 64, integer = true, tip = "How many beams make up the wall. More sides make it rounder." },
	{ name = "Fill", label = "Wall Fill", kind = "number", default = 1, min = 0.05, max = 1.5, tip = "1 closes the wall into a full cylinder. Lower values leave gaps so the beams stand apart like pillars." },
	{ name = "Bend", kind = "number", default = 0, min = 0, max = 1, tip = "Curves the wall between the bottom and the top when they are not lined up. 0 keeps it straight." },
	{ name = "BottomRadius", label = "Bottom Radius", kind = "number", default = 4, min = 0, max = 500, tip = "Size of the cylinder at the bottom." },
	{ name = "BottomOffset", label = "Bottom Position", kind = "vector3", default = Vector3.zero, tip = "Moves the bottom ring on its own, in studs." },
	{ name = "BottomRotation", label = "Bottom Rotation", kind = "vector3", default = Vector3.zero, tip = "Turns and tilts the bottom ring on its own, in degrees." },
	{ name = "BottomFade", label = "Bottom Fade", kind = "number", default = 0, min = 0, max = 1, tip = "1 fades the wall out completely at the bottom." },
	{ name = "TopRadius", label = "Top Radius", kind = "number", default = 4, min = 0, max = 500, tip = "Size of the cylinder at the top." },
	{ name = "TopOffset", label = "Top Position", kind = "vector3", default = Vector3.zero, tip = "Moves the top ring on its own, in studs." },
	{ name = "TopRotation", label = "Top Rotation", kind = "vector3", default = Vector3.zero, tip = "Turns and tilts the top ring on its own, in degrees." },
	{ name = "TopFade", label = "Top Fade", kind = "number", default = 0, min = 0, max = 1, tip = "1 fades the wall out completely at the top." },
}, ShapeKit.beamParams())

function pillarBeam.getSectionCFrame(height: number, offset: any, rotation: any): CFrame
	local move = if typeof(offset) == "Vector3" then offset else Vector3.zero
	local turn = if typeof(rotation) == "Vector3" then rotation else Vector3.zero

	return CFrame.new(0, height, 0) * CFrame.new(move) * CFrame.fromOrientation(math.rad(turn.X), math.rad(turn.Y), math.rad(turn.Z))
end

function pillarBeam.createHolder(kit, name: string, cframe: CFrame): Part
	local holder = Instance.new("Part")

	holder.Name = name
	holder.Size = pillarBeam.holderSize
	holder.Transparency = 1
	holder.Anchored = true
	holder.Massless = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.CastShadow = false
	holder.CFrame = kit.pivot * cframe
	holder.Parent = kit.root
	kit.count += 1

	return holder
end

function pillarBeam.createPoint(kit, parent: Instance, index: number, radial: Vector3, radius: number): Attachment
	local point = Instance.new("Attachment")

	point.Name = "Point" .. index
	point.CFrame = kit:orient(radial * radius, Vector3.yAxis, Vector3.yAxis:Cross(radial))
	point.Parent = parent

	return point
end

function pillarBeam.getPanelWidth(radius: number, sides: number, fill: number): number
	return 2 * radius * math.tan(math.pi / sides) * fill
end

function pillarBeam.build(kit, params)
	local sides = math.clamp(math.round(tonumber(params.Sides) or tonumber(params.Beams) or 20), pillarBeam.minimumSides, pillarBeam.maximumSides)
	local height = math.max(tonumber(params.Height) or 12, 0.01)
	local fill = math.clamp(tonumber(params.Fill) or 1, 0.05, 1.5)
	local handle = height * math.clamp(tonumber(params.Bend) or 0, 0, 1)
	local base = math.clamp(tonumber(params.Transparency) or 0, 0, 1)
	local bottomFade = math.clamp(tonumber(params.BottomFade) or 0, 0, 1)
	local topFade = math.clamp(tonumber(params.TopFade) or 0, 0, 1)
	local bottomRadius = math.max(tonumber(params.BottomRadius) or 4, 0)
	local topRadius = math.max(tonumber(params.TopRadius) or 4, 0)
	local properties = kit:getBeamProperties()
	local bottom = pillarBeam.createHolder(kit, pillarBeam.bottomName, pillarBeam.getSectionCFrame(0, params.BottomOffset, params.BottomRotation))
	local top = pillarBeam.createHolder(kit, pillarBeam.topName, pillarBeam.getSectionCFrame(height, params.TopOffset, params.TopRotation))

	for index = 1, sides do
		local angle = (index - 1) / sides * math.pi * 2
		local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local lower = pillarBeam.createPoint(kit, bottom, index, radial, bottomRadius)
		local upper = pillarBeam.createPoint(kit, top, index, radial, topRadius)
		local beam = Instance.new("Beam")

		beam.Name = "Beam" .. index

		for name, value in properties do
			(beam :: any)[name] = value
		end

		beam.Transparency = NumberSequence.new(base + (1 - base) * bottomFade, base + (1 - base) * topFade)
		beam.Width0 = pillarBeam.getPanelWidth(bottomRadius, sides, fill)
		beam.Width1 = pillarBeam.getPanelWidth(topRadius, sides, fill)
		beam.CurveSize0 = handle
		beam.CurveSize1 = handle
		beam.Attachment0 = lower
		beam.Attachment1 = upper
		beam.Parent = bottom
		kit.count += 1
	end
end

return pillarBeam
]]></ProtectedString>
