				<Item class="ModuleScript" referent="RBX4AF9152708824CD3B6F5036457DA2EDB">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local binding = require("smearBinding")
local geometry = require("smearGeometry")
local smears = {}
local refs, root, unsubscribe
local entries, busy = {}, false

local function isSmear(model)
	return model:GetAttribute("EclipseEffectObject") == 1 and model:GetAttribute("EffectKind") == "Smear Frames"
end

function smears.clear()
	for _, entry in entries do geometry.destroy(entry.slot) end
	table.clear(entries)
end

function smears.destroy()
	smears.clear()
	require("smearEditor").close()
	if unsubscribe then unsubscribe(); unsubscribe = nil end
	if root then root:Destroy(); root = nil end
	refs = nil
end

function smears.init(options)
	smears.destroy()
	refs = options
	unsubscribe = require("history").subscribe(smears.clear)
end

function smears.validate(value)
	assert(binding.valid(value.target), "Select a bone or part in the timeline")
	assert(binding.owner(value.target, refs.State.getAllRigs()), "The selected bone is not in this animation")
	local range = value.range or {whole = true, start = 0, finish = 0}
	assert(type(range.whole) == "boolean" and type(range.start) == "number" and type(range.finish) == "number"
		and range.start >= 0 and range.start % 1 == 0 and range.finish >= range.start and range.finish % 1 == 0 and range.finish <= 1000000, "Invalid smear frame range")
	return {kind = "Smear Frames", name = value.target.Name .. " Smear", target = value.target, start = range.whole and 0 or range.start, duration = range.whole and 0 or range.finish - range.start + 1, range = range, settings = require("smearConfig").normalize(value.settings or {})}
end

function smears.build(value)
	local model = Instance.new("Model")
	model.Name = value.name
	model:SetAttribute("EclipseEffectObject", 1)
	model:SetAttribute("EffectKind", "Smear Frames")
	model:SetAttribute("EffectEnabled", true)
	model:SetAttribute("EclipseTrackId", game:GetService("HttpService"):GenerateGUID(false))
	for id, v in require("smearConfig").normalize(value.settings or {}) do model:SetAttribute("Smear" .. id, v) end
	binding.save(model, value.target, refs.State.getAllRigs())
	return model
end

function smears.add()
 return smears.edit()
end

function smears.edit(model, frame)
 return require("smearEditor").open(refs, model, frame)
end

function smears.remove(model)
 local state = refs.State
 local raw = state.Timeline:GetState()
 assert(not raw.Exporting and not raw.Playing, "Pause playback before deleting smears")
 assert(binding.is(model) and table.find(state.getAllRigs(), model), "This smear is no longer in the animation")
 if refs.Finalize then refs.Finalize() end
 local ok = refs.RemoveRig(model)
 assert(ok, "Could not remove this smear")
 smears.clear()
 refs.RefreshStructure()
 require("effects").refresh()
end

function smears.range(model)
 local raw = refs.State.Timeline:GetState()
 local result = {whole = true, start = 0, finish = math.max(0, math.round(require("rawState").Config.Length * raw.FPS))}
 for _, motor in require("properties").list(model) do
  if motor.PropertyId ~= "Enabled" then continue end
  local frames = {}
  for frame in raw.Keyframes[motor] or {} do table.insert(frames, frame) end
  table.sort(frames)
  if #frames == 1 and frames[1] == 0 and raw.Keyframes[motor][0].PropertyValue == true then return result end
  result.whole, result.custom = false, true
  local started = false
  for _, frame in frames do
   local key = raw.Keyframes[motor][frame]
   if key.PropertyValue == true and not started then result.start = frame; started = true
   elseif key.PropertyValue == false and started then result.finish = math.max(result.start, frame - 1); break end
  end
 end
 return result
end

function smears.update(model, values, range)
 local state, properties = refs.State, require("properties")
 local timeline = state.Timeline
 local raw = timeline:GetState()
 assert(not raw.Exporting and not raw.Playing, "Pause playback before editing smears")
 assert(binding.is(model) and table.find(state.getAllRigs(), model), "This smear is no longer in the animation")
 values = require("smearConfig").normalize(values)
 if refs.Finalize then refs.Finalize() end
 local motor
 for _, m in properties.list(model) do if m.PropertyId == "Enabled" then motor = m; break end end
 assert(motor, "Smear enabled track is missing")
 local beforeValues = require("smearConfig").read(model)
 local before = timeline:_snapshotMotorBucket(motor)
 local after
 if range then
  smears.validate({target = binding.resolve(model, state.getAllRigs()), range = range})
  require("effects").seed(model, {kind = "Smear Frames", range = range})
  after = timeline:_snapshotMotorBucket(motor)
  timeline:_restoreMotorBucket(motor, before)
 end
 local function apply(settings, bucket)
  if not model.Parent then return end
  for id, value in settings do model:SetAttribute("Smear" .. id, value) end
  if bucket then timeline:_restoreMotorBucket(motor, bucket) end
  properties.apply(model, raw, raw.CurrentTime)
  smears.clear()
  state.currentProjectSaved = false
  refs.RefreshStructure()
  require("effects").step()
 end
 apply(values, after)
 require("history").record(function() apply(beforeValues, range and before or nil) end, function() apply(values, after) end, "Edit smear frames")
end

local function entryFor(model)
	local target, owner = binding.resolve(model, refs.State.getAllRigs())
	if not target then return nil end
	local fps = refs.State.Timeline:GetState().FPS
	local settings = require("smearConfig").read(model)
	local entry = entries[model]
	local changed = false
	if entry then for id, value in settings do if entry.settings[id] ~= value then changed = true; break end end end
	if entry and (entry.target ~= target or entry.fps ~= fps or changed) then
		geometry.destroy(entry.slot)
		entries[model], entry = nil, nil
	end
	if not entry then
		if not root then
			root = Instance.new("Folder")
			root.Name, root.Archivable = "_EclipseSmearFrames", false
			root:SetAttribute("EclipseGeneratedVisual", true)
			require("recovery").mark(root)
			root.Parent = refs.EffectsWorldParent or workspace
		end
		entry = {target = target, owner = owner, settings = settings, fps = fps, poses = {}, count = 0, slot = geometry.new(root)}
		entries[model] = entry
	end
	return entry
end

local function sample(entry, frame, model)
	if not entry.poses[frame] then
		if entry.count >= 600 then table.clear(entry.poses); entry.count = 0 end
		entry.poses[frame] = require("smearSampler").capture(refs.State, entry.target, entry.owner, frame, entry.settings, model)
		entry.count += 1
	end
	return entry.poses[frame]
end

function smears.step(present, active, frame)
	if busy or not refs then return end
	busy = true
	local ok, issue = xpcall(function()
		frame = math.max(0, math.floor(frame + 1e-5))
		for model, entry in entries do
			if not present[model] or not model.Parent then
				geometry.destroy(entry.slot); entries[model] = nil
			elseif not active or model:GetAttribute("EffectEnabled") == false
				or not require("organization").isEnabled(model) then
				geometry.hide(entry.slot); entry.rendered = nil
			end
		end
		if not active then return end
		for model in present do
			if not isSmear(model) or model:GetAttribute("EffectEnabled") == false
				or not require("organization").isEnabled(model) then continue end
			local entry = entryFor(model)
			if not entry or entry.failed then
				if entries[model] then geometry.hide(entries[model].slot) end
				continue
			end
			local sampled, pose = pcall(sample, entry, frame, model)
			if not sampled then
				entry.failed = true
				warn("Eclipse smear frames: " .. tostring(pose))
				continue
			end
			if entry.rendered ~= pose then
				geometry.render(entry.slot, geometry.triangles(pose.Poses, pose.Size, pose.Width, pose.Strength, pose.Style), pose.Color, pose.Opacity * (pose.Visibility or 1), pose.Ramp)
				entry.rendered = pose
			end
		end
	end, debug.traceback)
	busy = false
	if not ok then error(issue, 0) end
end

return smears
]]></ProtectedString>
						<string name="ScriptGuid">{B3176D0A-73AA-41D3-81DA-F40053C58A2A}</string>
