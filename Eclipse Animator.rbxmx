						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local screenCovers = {}

screenCovers.list = {
	{ id = "Solid", label = "Normal" },
	{
		id = "AngularWind",
		label = "Angular Wind",
		image = "rbxassetid://98072637567251",
		columns = 4,
		rows = 4,
		frames = 16,
	},
	{
		id = "DiagonalWind",
		label = "Diagonal Wind",
		image = "rbxassetid://87565297765138",
		columns = 4,
		rows = 4,
		frames = 16,
	},
}

function screenCovers.get(id)
	for _, cover in screenCovers.list do
		if cover.id == id then
			return cover
		end
	end

	return screenCovers.list[1]
end

function screenCovers.validate(id)
	id = id or "Solid"
	for _, cover in screenCovers.list do
		if cover.id == id then
			return id
		end
	end

	error("Choose a screen cover", 0)
end

function screenCovers.isSprite(id)
	return screenCovers.get(id).image ~= nil
end

function screenCovers.apply(model, id)
	local cover = screenCovers.get(id)
	model:SetAttribute("EffectCover", cover.id)
	model:SetAttribute("EffectCoverSequence", nil)
	model:SetAttribute("EffectCoverImage", cover.image)
	model:SetAttribute("EffectCoverColumns", cover.columns)
	model:SetAttribute("EffectCoverRows", cover.rows)
	model:SetAttribute("EffectCoverFrames", cover.frames)
end

function screenCovers.frameIndex(progress, count)
	return math.clamp(math.floor(math.clamp(progress or 0, 0, 1) * count), 0, count - 1)
end

function screenCovers.place(sprite, columns, rows, index)
	sprite.AnchorPoint = Vector2.new(0.5, 0.5)
	sprite.Size = UDim2.fromScale(columns, rows)
	sprite.Position = UDim2.fromScale(columns / 2 - index % columns, rows / 2 - math.floor(index / columns))
end

local Thumbnail = {}
Thumbnail.__index = Thumbnail

function screenCovers.thumbnail(parent, cover, position, size)
	local self = setmetatable({}, Thumbnail)
	self.cover = cover
	self.frame = Instance.new("Frame")
	self.frame.Name = "CoverPreview"
	self.frame.AnchorPoint = Vector2.new(0.5, 0.5)
	self.frame.Position = position
	self.frame.Size = size
	self.frame.BackgroundColor3 = Color3.fromRGB(18, 16, 24)
	self.frame.BorderSizePixel = 0
	self.frame.ClipsDescendants = true
	self.frame.Active = false
	self.frame.Parent = parent
	if cover.image then
		self.sprite = Instance.new("ImageLabel")
		self.sprite.Name = "Sprite"
		self.sprite.BackgroundTransparency = 1
		self.sprite.Image = cover.image
		self.sprite.Active = false
		self.sprite.Parent = self.frame
		screenCovers.place(self.sprite, cover.columns, cover.rows, 0)
	else
		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.AnchorPoint = Vector2.new(0.5, 0.5)
		fill.Position = UDim2.fromScale(0.5, 0.5)
		fill.Size = UDim2.new(1, -10, 1, -10)
		fill.BackgroundColor3 = Color3.new()
		fill.BorderSizePixel = 0
		fill.Parent = self.frame
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(90, 84, 104)
		stroke.Parent = fill
	end

	return self
end

function Thumbnail:step(clock)
	if not self.sprite or not self.frame.Parent then
		return
	end

	local count = self.cover.frames
	local index = math.floor(clock * 24) % (count + 8)
	screenCovers.place(self.sprite, self.cover.columns, self.cover.rows, math.min(index, count - 1))
	self.sprite.ImageTransparency = index >= count and 1 or 0
end

return screenCovers
]]></ProtectedString>
