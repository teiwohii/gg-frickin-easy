							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local selection = game:GetService("Selection")

local SelectionModel = {}
SelectionModel.__index = SelectionModel

function SelectionModel.new()
	local self = setmetatable({}, SelectionModel)

	self.handlers = {}
	self.connection = nil
	self.pending = false
	self.pick = nil
	self.last = {}
	self.active = false

	return self
end

function SelectionModel:start()
	if self.active then
		return
	end

	self.active = true
	self.last = selection:Get()

	self.connection = selection.SelectionChanged:Connect(function()
		self:schedule()
	end)
end

function SelectionModel:stop()
	self.active = false
	self:cancelPick()

	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
end

function SelectionModel:schedule()
	if self.pending then
		return
	end

	self.pending = true

	task.defer(function()
		self.pending = false

		if self.active then
			self:flush()
		end
	end)
end

function SelectionModel:flush()
	local current = selection:Get()

	if self.pick then
		local pick = self.pick

		if self:isSame(current, pick.previous) then
			return
		end

		for _, instance in current do
			if pick.accepts(instance) then
				self.pick = nil
				selection:Set(pick.previous)
				self.last = pick.previous
				pick.callback(instance)
				self:notify()
				return
			end
		end

		if #current > 0 then
			selection:Set(pick.previous)

			if pick.rejected then
				pick.rejected(current[1])
			end
		end

		return
	end

	self.last = current
	self:notify()
end

function SelectionModel:isSame(first: { Instance }, second: { Instance }): boolean
	if #first ~= #second then
		return false
	end

	for _, instance in first do
		if not table.find(second, instance) then
			return false
		end
	end

	return true
end

function SelectionModel:notify()
	for _, handler in self.handlers do
		local success, problem = pcall(handler, self.last)

		if not success then
			warn(problem)
		end
	end
end

function SelectionModel:addChangedHandler(handler: ({ Instance }) -> ())
	table.insert(self.handlers, handler)
end

function SelectionModel:get(): { Instance }
	return selection:Get()
end

function SelectionModel:getFirst(): Instance?
	return selection:Get()[1]
end

function SelectionModel:set(instances: { Instance })
	local alive = {}

	for _, instance in instances do
		if instance.Parent then
			table.insert(alive, instance)
		end
	end

	selection:Set(alive)
end

function SelectionModel:isSelected(instance: Instance): boolean
	return table.find(selection:Get(), instance) ~= nil
end

function SelectionModel:toggle(instance: Instance)
	local current = selection:Get()
	local index = table.find(current, instance)

	if index then
		table.remove(current, index)
	else
		table.insert(current, instance)
	end

	selection:Set(current)
end

function SelectionModel:getLookup(): { [Instance]: boolean }
	local lookup = {}

	for _, instance in selection:Get() do
		lookup[instance] = true
	end

	return lookup
end

function SelectionModel:getRoots(): { Instance }
	local lookup = self:getLookup()
	local roots = {}

	for _, instance in selection:Get() do
		local parent = instance.Parent
		local covered = false

		while parent do
			if lookup[parent] then
				covered = true
				break
			end

			parent = parent.Parent
		end

		if not covered then
			table.insert(roots, instance)
		end
	end

	return roots
end

function SelectionModel:isPicking(): boolean
	return self.pick ~= nil
end

function SelectionModel:beginPick(accepts: (Instance) -> boolean, callback: (Instance) -> (), rejected: ((Instance) -> ())?, cancelled: (() -> ())?)
	self:cancelPick()

	self.pick = {
		accepts = accepts,
		callback = callback,
		rejected = rejected,
		cancelled = cancelled,
		previous = selection:Get(),
	}
end

function SelectionModel:cancelPick()
	local pick = self.pick

	if not pick then
		return
	end

	self.pick = nil

	if pick.cancelled then
		pick.cancelled()
	end
end

function SelectionModel:destroy()
	self:stop()
	table.clear(self.handlers)
end

return SelectionModel
]]></ProtectedString>
