						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local boltStrike = require(script.Parent.Parent.Animation.boltStrike)
local StrikeClock = require(script.Parent.Parent.Animation.StrikeClock)

local LightningStrikes = {}
LightningStrikes.__index = LightningStrikes

LightningStrikes.sectionTitle = "Strike"
LightningStrikes.generatorId = "Lightning"
LightningStrikes.restDelay = 0.3
LightningStrikes.keywords = "lightning strike emit"

LightningStrikes.tips = {
	enabled = "Let Emit and emit keyframes make this bolt strike. Turn it off to keep the bolt always visible and animate its transparency yourself.",
	duration = "How long one strike lasts, in seconds.",
	travel = "Share of the strike the bolt takes to shoot from its start to its tip. 0 makes the whole bolt appear at once.",
	flickers = "How many times the bolt dims and comes back before it fades.",
	fade = "Share of the strike spent fading out at the end.",
	reshape = "Let the bolt move through new random shapes while it strikes.",
	shapeTime = "Seconds the bolt takes to move from one shape to the next. Lower is more frantic.",
	smooth = "1 glides from shape to shape the whole time. Lower holds each shape longer before moving, and 0 snaps straight to the next one.",
	amount = "How far each new shape strays from the bolt's own shape. 0 keeps it still, 1 is a completely new shape.",
	play = "Strike once now.",
}

LightningStrikes.messages = {
	note = "Press Emit to strike. In the animator, add an emit keyframe on the bolt: it stays hidden until the keyframe, then strikes.",
	off = "Turn this on to make the bolt strike when you press Emit.",
	detached = "Shape changes need a Lightning shape that still has its generator.",
}

function LightningStrikes.new(context)
	local self = setmetatable({}, LightningStrikes)

	self.context = context
	self.history = context.history
	self.clock = StrikeClock.new()
	self.events = {}
	self.started = 0
	self.token = 0
	self.editing = false

	self.clock:setTargetProvider(function()
		return os.clock() - self.started
	end)

	self.clock:setEventsProvider(function()
		return self.events
	end)

	return self
end

function LightningStrikes:isLightning(instance: Instance): boolean
	local generators = self.context.generators

	if not generators or not boltStrike.isCandidate(instance) then
		return false
	end

	return (generators:read(instance)) == LightningStrikes.generatorId
end

function LightningStrikes:handles(instance: Instance): boolean
	return boltStrike.read(instance) ~= nil or self:isLightning(instance)
end

function LightningStrikes:hidesProperty(instance: Instance, name: string): boolean
	return boltStrike.owns(instance, name)
end

function LightningStrikes:getSignature(instance: Instance): string
	local config = if boltStrike.isCandidate(instance) then boltStrike.read(instance) else nil

	if not config then
		return ""
	end

	if not config.enabled then
		return "still"
	end

	return if config.reshape then "strike:shape" else "strike"
end

function LightningStrikes:finishEdit()
	if self.editing then
		self.editing = false
		self.history:finish()
	end
end

function LightningStrikes:initialize(target: Instance)
	if boltStrike.isCandidate(target) and not boltStrike.read(target) then
		boltStrike.write(target, boltStrike.defaults)
	end
end

function LightningStrikes:change(targets: { Instance }, mutate, final: boolean)
	self:stopPlayback()

	if not self.editing then
		self.editing = true
		self.history:begin("Edit Strike")
	end

	for _, target in targets do
		if target.Parent and self:handles(target) then
			local copy = boltStrike.copy(boltStrike.read(target))

			boltStrike.applyRest(target)
			mutate(copy)
			boltStrike.write(target, copy)
			boltStrike.applyRest(target)
		end
	end

	if final then
		self:finishEdit()
	end
end

function LightningStrikes:collectHosts(roots: { Instance }): { Instance }
	local hosts = {}
	local seen = {}

	local function include(instance: Instance)
		if not seen[instance] and boltStrike.isPlayable(instance) then
			seen[instance] = true
			table.insert(hosts, instance)
		end
	end

	for _, root in roots do
		include(root)

		local parent = root.Parent

		if parent then
			include(parent)
		end

		for _, descendant in root:GetDescendants() do
			if descendant:IsA("Model") then
				include(descendant)
			end
		end
	end

	return hosts
end

function LightningStrikes:isPlaying(): boolean
	return self.clock:isRunning()
end

function LightningStrikes:stopPlayback()
	self.token += 1

	if self.clock:isRunning() then
		self.clock:stop()
	end

	table.clear(self.events)
end

function LightningStrikes:play(hosts: { Instance }): number
	self:stopPlayback()

	local finish = 0

	for _, host in hosts do
		local config = if host.Parent then boltStrike.read(host) else nil

		if config and config.enabled then
			table.insert(self.events, { host = host, start = 0, count = 1, stretch = 0 })
			finish = math.max(finish, boltStrike.getTotalLength(config, 1, 0))
		end
	end

	local count = #self.events

	if count == 0 then
		return 0
	end

	local token = self.token

	self.started = os.clock()
	self.clock:start()

	task.delay(finish + LightningStrikes.restDelay, function()
		if token == self.token then
			self:stopPlayback()
		end
	end)

	return count
end

function LightningStrikes:createValueField(targets: { Instance }, options)
	local first = targets[1]
	local field = table.clone(options)

	local function current()
		return boltStrike.read(first) or boltStrike.normalize(nil)
	end

	field.id = "Strike." .. options.name
	field.keywords = LightningStrikes.keywords
	field.value = options.get(current())

	field.read = function()
		return if first.Parent then options.get(current()) else nil
	end

	field.onChange = function(value, final)
		if value == nil then
			return
		end

		self:change(targets, function(config)
			options.set(config, value)
		end, final)
	end

	return field
end

function LightningStrikes:createNumberField(targets: { Instance }, name: string, label: string, key: string, minimum: number, maximum: number, scrubMaximum: number, integer: boolean?)
	return self:createValueField(targets, {
		name = name,
		label = label,
		kind = "number",
		tip = LightningStrikes.tips[key],
		minimum = minimum,
		maximum = maximum,
		clamp = true,
		integer = integer,
		range = { min = minimum, max = scrubMaximum },
		get = function(config)
			return config[key]
		end,
		set = function(config, value)
			config[key] = value
		end,
	})
end

function LightningStrikes:createToggleField(targets: { Instance }, name: string, label: string, key: string)
	local field = self:createValueField(targets, {
		name = name,
		label = label,
		kind = "toggle",
		tip = LightningStrikes.tips[key],
		get = function(config)
			return config[key]
		end,
		set = function(config, value)
			config[key] = value
		end,
	})

	field.onChange = function(value)
		if value ~= nil then
			self:change(targets, function(config)
				config[key] = value
			end, true)
		end
	end

	return field
end

function LightningStrikes:addShapeFields(targets: { Instance }, fields)
	local first = targets[1]
	local config = boltStrike.read(first)

	table.insert(fields, self:createToggleField(targets, "Reshape", "Change Shape", "reshape"))

	if not config or not config.reshape then
		return
	end

	if not boltStrike.getGeometry(first) then
		table.insert(fields, { id = "Strike.DetachedNote", kind = "note", keywords = LightningStrikes.keywords, text = LightningStrikes.messages.detached })
		return
	end

	table.insert(fields, self:createNumberField(targets, "ShapeTime", "Shape Time", "shapeTime", boltStrike.minimumShapeTime, boltStrike.maximumShapeTime, 1))
	table.insert(fields, self:createNumberField(targets, "Smooth", "Smoothness", "smooth", 0, 1, 1))
	table.insert(fields, self:createNumberField(targets, "Amount", "Shape Strength", "amount", 0, boltStrike.maximumAmount, 2))
end

function LightningStrikes:isEnabled(target: Instance): boolean
	local config = boltStrike.read(target)

	return config ~= nil and config.enabled
end

function LightningStrikes:getSections(targets: { Instance })
	local first = targets[1]

	if not first then
		return {}
	end

	for _, target in targets do
		if not self:handles(target) then
			return {}
		end
	end

	local enabled = self:isEnabled(first)
	local fields = {
		{
			id = "Strike.Enabled",
			label = "Strike On Emit",
			kind = "toggle",
			keywords = LightningStrikes.keywords,
			tip = LightningStrikes.tips.enabled,
			value = enabled,
			read = function()
				return if first.Parent then self:isEnabled(first) else nil
			end,
			onChange = function(value)
				if value ~= nil then
					self:change(targets, function(config)
						config.enabled = value
					end, true)
				end
			end,
		},
	}

	if not enabled then
		table.insert(fields, { id = "Strike.OffNote", kind = "note", keywords = LightningStrikes.keywords, text = LightningStrikes.messages.off })

		return {
			{ title = LightningStrikes.sectionTitle, key = "Strike.Off", after = true, fields = fields },
		}
	end

	table.insert(fields, self:createNumberField(targets, "Duration", "Duration", "duration", boltStrike.minimumDuration, boltStrike.maximumDuration, 1))
	table.insert(fields, self:createNumberField(targets, "Travel", "Travel", "travel", 0, 1, 1))
	table.insert(fields, self:createNumberField(targets, "Flickers", "Flickers", "flickers", 0, boltStrike.maximumFlickers, 6, true))
	table.insert(fields, self:createNumberField(targets, "Fade", "Fade Out", "fade", 0, 1, 1))
	self:addShapeFields(targets, fields)
	table.insert(fields, { id = "Strike.Note", kind = "note", keywords = LightningStrikes.keywords, text = LightningStrikes.messages.note })

	return {
		{
			title = LightningStrikes.sectionTitle,
			key = "Strike",
			after = true,
			action = {
				text = "Strike",
				tip = LightningStrikes.tips.play,
				callback = function()
					self:play(targets)
				end,
			},
			fields = fields,
		},
	}
end

function LightningStrikes:stop()
	self:finishEdit()
	self:stopPlayback()
end

function LightningStrikes:destroy()
	self:stop()
end

return LightningStrikes
]]></ProtectedString>
