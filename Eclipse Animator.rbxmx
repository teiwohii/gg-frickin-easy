					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local shake = {}

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function validVector(value)
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end

function shake.offset(seed, phase, displacement, angles)
	assert(finite(seed) and finite(phase), "Shake sampling needs a finite seed and phase.")
	assert(validVector(displacement) and validVector(angles), "Shake axes must be finite vectors.")
	local function axis(index)
		return math.noise(phase, seed * 0.017 + index * 17.1, index * 0.73) * 2
	end
	local shift = Vector3.new(axis(1), axis(2), axis(3)) * displacement
	local turn = Vector3.new(axis(4), axis(5), axis(6)) * angles
	return CFrame.new(shift) * CFrame.Angles(turn.X, turn.Y, turn.Z)
end

function shake.pulse(time, duration, seed, rate, displacement, angles)
	assert(finite(time) and finite(duration) and duration > 0, "A shake pulse needs a positive duration and finite sample time.")
	assert(finite(rate) and rate >= 0, "Shake rate must be nonnegative.")
	if time < 0 or time >= duration then return CFrame.identity, time >= duration end
	local progress = time / duration
	local gain = math.sin(math.pi * progress) ^ 2
	return shake.offset(seed, time * rate, displacement * gain, angles * gain), false
end

return shake
]]></ProtectedString>
