							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local soundCue = require(script.Parent.Parent.Animation.soundCue)
local SoundClock = require(script.Parent.Parent.Animation.SoundClock)
local SoundHost = require(script.Parent.Parent.Utility.SoundHost)

local SoundPreview = {}
SoundPreview.__index = SoundPreview

SoundPreview.delayAttribute = "EmitDelay"
SoundPreview.lengthAttribute = "EmitDuration"
SoundPreview.pollInterval = 0.2

SoundPreview.messages = {
	noId = "Give the sound a Sound ID first.",
	unavailable = "Sounds can only be heard while Arc is running as a plugin.",
}

function SoundPreview.new(context)
	local self = setmetatable({}, SoundPreview)

	self.context = context
	self.clock = SoundClock.new()
	self.events = {}
	self.started = 0
	self.token = 0

	self.clock:setTargetProvider(function()
		return os.clock() - self.started
	end)

	self.clock:setEventsProvider(function()
		return self.events
	end)

	self.clock:setPlayer(SoundHost.createPlayer())

	return self
end

function SoundPreview:readNumber(sound: Instance, name: string): number
	local value = sound:GetAttribute(name)

	return if typeof(value) == "number" then math.max(value, 0) else 0
end

function SoundPreview:collectHosts(roots: { Instance }): { Instance }
	return soundCue.collect(roots)
end

function SoundPreview:isPlaying(): boolean
	return self.clock:isRunning()
end

function SoundPreview:isSounding(sound: Instance): boolean
	return self.clock:isRunning() and self.clock:isSounding(sound)
end

function SoundPreview:stopPlayback()
	self.token += 1

	if self.clock:isRunning() then
		self.clock:stop()
	end

	table.clear(self.events)
end

function SoundPreview:isFinished(): boolean
	local elapsed = os.clock() - self.started
	local host = SoundHost.get()

	for _, event in self.events do
		if elapsed < event.start + SoundPreview.pollInterval or host:isPlaying(event.host) then
			return false
		end
	end

	return true
end

function SoundPreview:watch(token: number)
	task.spawn(function()
		while token == self.token and self.clock:isRunning() do
			task.wait(SoundPreview.pollInterval)

			if token == self.token and self:isFinished() then
				self:stopPlayback()
			end
		end
	end)
end

function SoundPreview:play(hosts: { Instance }): number
	self:stopPlayback()

	for _, host in hosts do
		if soundCue.isPlayable(host) and (host :: Sound).SoundId ~= "" then
			table.insert(self.events, {
				host = host,
				start = self:readNumber(host, SoundPreview.delayAttribute),
				stretch = self:readNumber(host, SoundPreview.lengthAttribute),
			})
		end
	end

	local count = #self.events

	if count == 0 then
		return 0
	end

	self.started = os.clock()
	self.clock:start()
	self:watch(self.token)

	return count
end

function SoundPreview:toggle(hosts: { Instance }): number
	for _, host in hosts do
		if self:isSounding(host) then
			self:stopPlayback()
			return 0
		end
	end

	local count = self:play(hosts)

	if count == 0 then
		self.context.notify(SoundPreview.messages.noId)
	elseif not SoundHost.get():canPlay() then
		self.context.notify(SoundPreview.messages.unavailable)
	end

	return count
end

function SoundPreview:stop()
	self:stopPlayback()
end

function SoundPreview:destroy()
	self:stop()
end

return SoundPreview
]]></ProtectedString>
