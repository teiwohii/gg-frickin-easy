local require = require(script:FindFirstAncestor("container").requireModule)

local solver = require("limbSolver")
local r6TorsoSolver = {}

function r6TorsoSolver.solve(base, height, spine, upper)
	local direction = upper.Position - spine.Position

	local reference = upper.Rotation
	local rotation = direction.Magnitude > 1e-6
			and solver.rotationBetween(reference.UpVector, direction)
		or CFrame.identity
	return CFrame.new(spine.Position) * rotation * reference * CFrame.new(0, height * 0.5, 0)
end

function r6TorsoSolver.controlFrame(base, height, spine, upper, kind)
	local torso = r6TorsoSolver.solve(base, height, spine, upper)
	if kind == "spine" then
		return torso
	end

	return torso * CFrame.new(0, height * 0.5 - 0.15, 0)
end

function r6TorsoSolver.edit(base, height, spine, upper, kind, value)
	local display = r6TorsoSolver.controlFrame(base, height, spine, upper, kind)
	local delta = value * display:Inverse()
	local _, angle = delta:ToAxisAngle()
	if math.abs(angle) > 1e-5 then
		return delta * spine, delta * upper
	end

	local direction = kind == "spine" and upper.Position - value.Position
		or value.Position - spine.Position
	local up = display.UpVector
	local minimum = math.max(height * 0.25, 1e-4)
	direction += up * math.max(0, minimum - direction:Dot(up))
	local aim = direction.Unit
	if kind == "spine" then
		return spine.Rotation + value.Position - aim * height * 0.5,
			upper.Rotation + value.Position + direction
	end

	return spine, upper.Rotation + spine.Position + direction + aim * 0.15
end

return r6TorsoSolver
