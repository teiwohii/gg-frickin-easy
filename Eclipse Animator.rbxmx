					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local motion = {}

function motion.buckets(raw, motor)
	local buckets, seen = {}, {}
	local function add(bucket)
		if bucket and not seen[bucket] then
			seen[bucket] = true
			table.insert(buckets, bucket)
		end
	end
	local layers = require("layers")
	if layers.has(raw) then
		for _, layer in layers.ensure(raw).layers do
			add(layer.keys[motor])
		end
	else
		add(raw.Keyframes[motor])
	end
	for _, clip in require("simulationCache").list(raw) do
		add(clip.tracks[motor])
	end
	return buckets
end

function motion.rebase(key, from, to, timeline)
	local parented = key.Parented
	key.Parented = true  
	require("poseSpace").rebaseKey(key, from, to, timeline, 1)
	key.Parented = parented
	local delta = to * from:Inverse()
	for _, name in { "PropertyValue", "WorldCFrame", "IKBaseWorld", "IKRigWorld" } do
		if typeof(key[name]) == "CFrame" then
			key[name] = delta * key[name]
		end
	end
	if typeof(key.MasterWorld) == "CFrame" then
		key.MasterWorld = delta * key.MasterWorld * delta:Inverse()
	end
end

function motion.prepare(motor, from, to, timeline)
	if motor.PropertyId ~= "CFrame" then
		return nil
	end
	local raw = timeline:GetState()
	local before, after = {}, {}
	for _, bucket in motion.buckets(raw, motor) do
		before[bucket] = require("layers").clone(bucket)
		local copy = require("layers").clone(bucket)
		for _, key in copy do
			local target = to
			if key.CamTargetParent and typeof(key.CamTargetAnchor) == "CFrame" then
				local anchor = key.CamTargetAnchor
				local current = require("target").linkWorld(
					key.CamTargetParent,
					raw.CurrentTime,
					anchor
				) or anchor
				local delta = anchor
					* current:Inverse()
					* to
					* from:Inverse()
					* current
					* anchor:Inverse()
				target = delta * from
			end
			motion.rebase(key, from, target, timeline)
		end
		after[bucket] = copy
	end
	return { before = before, after = after }
end

function motion.apply(snapshot)
	if not snapshot then
		return
	end
	for bucket, keys in snapshot do
		for _, key in bucket do
			if key.Button then
				key.Button:Destroy()
			end
		end
		table.clear(bucket)
		for frame, key in require("layers").clone(keys) do
			bucket[frame] = key
		end
		require("graphCurves").invalidate(bucket)
		require("simulationCache").invalidate(bucket)
	end
	require("poseCache").invalidate()
end

return motion
]]></ProtectedString>
