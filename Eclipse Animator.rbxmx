						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local PremiumGate = {}
PremiumGate.__index = PremiumGate

PremiumGate.shared = nil
PremiumGate.title = "Premium"
PremiumGate.suffix = "  (Premium)"
PremiumGate.messages = {
	locked = "%s is a Premium feature. Open Premium on the start screen to see how to get it.",
	checking = "Arc is still checking your Premium status. Try %s again in a moment.",
}

function PremiumGate.new(service, options)
	local self = setmetatable({}, PremiumGate)

	options = options or {}
	self.service = service
	self.notifier = options.notifier
	self.opener = options.opener
	self.names = {}

	if service then
		for _, feature in service:getFeatures() do
			if typeof(feature) == "table" and typeof(feature.id) == "string" then
				self.names[feature.id] = feature.title
			end
		end
	end

	return self
end

function PremiumGate.install(service, options)
	PremiumGate.shared = PremiumGate.new(service, options)

	return PremiumGate.shared
end

function PremiumGate.uninstall()
	PremiumGate.shared = nil
end

function PremiumGate.get()
	return PremiumGate.shared or PremiumGate.new(nil)
end

function PremiumGate:isOwned(): boolean
	return self.service ~= nil and self.service:isOwned()
end

function PremiumGate:isUnlocked(id: string): boolean
	return self.service ~= nil and self.service:hasFeature(id)
end

function PremiumGate:getName(id: string): string
	return self.names[id] or id
end

function PremiumGate:label(id: string, text: string): string
	return if self:isUnlocked(id) then text else text .. PremiumGate.suffix
end

function PremiumGate:onChanged(listener: () -> ()): () -> ()
	if not self.service then
		return function() end
	end

	return self.service:onChanged(function()
		listener()
	end)
end

function PremiumGate:notify(text: string)
	if self.notifier then
		self.notifier:notify(PremiumGate.title, text)
	end
end

function PremiumGate:describe(id: string): (string, boolean)
	local name = self:getName(id)
	local service = self.service

	if service and (service:isChecking() or not service:hasChecked()) then
		service:refresh(false)

		if service:isChecking() then
			return string.format(PremiumGate.messages.checking, name), true
		end
	end

	return string.format(PremiumGate.messages.locked, name), false
end

function PremiumGate:request(id: string): boolean
	if self:isUnlocked(id) then
		return true
	end

	local text, checking = self:describe(id)

	self:notify(text)

	if checking then
		return false
	end

	if self.opener then
		self.opener()
	end

	return false
end

return PremiumGate
]]></ProtectedString>
