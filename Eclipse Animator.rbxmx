					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local state = require("state")
local runtime = require("armatureRuntime")
local layers = require("layers")
local mirror = {}
local enabled = false
local pairs = {}

function mirror.isEnabled()
	return enabled
end
function mirror.toggle()
	require("project").finalizeCurrentManipulation()
	enabled = not enabled
	return enabled
end

 
 
mirror.flipName = require("mirrorNames").flip

local function editable(motor, timeline)
	return motor
		and motor.Parent
		and motor.Part1
		and motor.Part0
		and not motor:GetAttribute("EclipseDisabled")
		and not layers.active(timeline:GetState(), motor).locked
end

function mirror.begin(snapshots, capture)
	table.clear(pairs)
	local all = table.clone(snapshots or {})
	local timeline = state.Timeline
	if not enabled or not timeline then
		return all
	end
	local present, used = {}, {}
	for _, info in all do
		present[info.motor] = true
	end
	for _, info in snapshots or {} do
		local source, rig = info.motor, info.rig or state.currentRig
		if not rig or used[source] or not editable(source, timeline) then
			continue
		end
		local target = timeline:FindPoseMirror(source, rig, mirror.flipName)
		if target == source or used[target] or not editable(target, timeline) then
			continue
		end
		local before = capture(target, rig)
		used[source], used[target] = true, true
		table.insert(
			pairs,
			{
				source = source,
				target = target,
				rig = rig,
				before = before,
				start = source.C0,
				changed = false,
			}
		)
		if not present[target] then
			present[target] = true
			table.insert(all, before)
		end
	end
	return all
end

function mirror.append(list)
	local present = {}
	for _, info in list do
		present[info.motor] = true
	end
	for _, pair in pairs do
		if not present[pair.target] then
			present[pair.target] = true
			table.insert(
				list,
				{ motor = pair.target, part = pair.target.Part1, startC0 = pair.before.startC0 }
			)
		end
	end
end

function mirror.apply()
	local timeline = state.Timeline
	if not timeline or #pairs == 0 then
		return
	end
	local evaluate = {}
	for _, pair in pairs do
		local source, target = pair.source, pair.target
		if not editable(source, timeline) or not editable(target, timeline) then
			continue
		end
		pair.changed = pair.changed or source.C0 ~= pair.start
		if not pair.changed then
			continue
		end
		local value = timeline:MirrorPoseValue(source.C0, source, target, pair.rig)
		if typeof(target) == "table" and target.IsEclipseArmatureControl then
			value = runtime.constrainC0(target, value)
			evaluate[pair.rig] = true
		end
		target.C0 = value
		if state.lastCFrames then
			state.lastCFrames[target] = target.C0
		end
	end
	for rig in evaluate do
		runtime.evaluate(rig)
	end
end

function mirror.finish()
	table.clear(pairs)
end
return mirror
]]></ProtectedString>
