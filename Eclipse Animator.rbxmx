						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">smearFrames</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXAECF0B860E1B4FAFBDCAF918AC19714D">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local config = {}
config.styles = {"Classic", "Crescent", "Slashes", "Brush"}
config.defaults = {Style = "Classic", Path = "Motion", PathStart = 0, PathEnd = 1, Strength = 1, Width = 1, Opacity = 1, MatchColor = true, Color = Color3.new(1, 1, 1), Color2 = Color3.new(1, 1, 1), Gradient = false, ColorRamp = ""}
config.ICON = "rbxthumb://type=Asset&id=91197928456248&w=150&h=150"
function config.normalize(value)
 local result = {}
 for id, fallback in config.defaults do
  local v = value[id]
  if v == nil then v = fallback end
  if type(fallback) == "number" then
   local endpoint = id == "PathStart" or id == "PathEnd"
   local minimum = (endpoint or id == "Opacity") and 0 or 0.1
   local maximum = endpoint and 1000000 or id == "Opacity" and 1 or id == "Strength" and 3 or 2
   assert(type(v) == "number" and v == v and v >= minimum and v <= maximum, "Check " .. id:lower())
   if endpoint then assert(v % 1 == 0, "Use whole frames for the path") end
  else assert(typeof(v) == typeof(fallback), "Check " .. id:lower()) end
  if id == "Path" then assert(v == "Motion" or v == "Connect", "Choose a smear path") end
  if id == "Style" then assert(table.find(config.styles, v), "Choose a smear style") end
  if id == "ColorRamp" then assert(require("afterimageConfig").valid("ColorRamp", v), "Check gradient stops") end
  result[id] = v
 end
 if result.Path == "Connect" then assert(result.PathEnd > result.PathStart, "End frame must be after start frame") end
 return result
end
function config.read(model)
 local value = {}
 for id in config.defaults do value[id] = model:GetAttribute("Smear" .. id) end
return config.normalize(value)
end
function config.stops(value)
 if value.MatchColor then return nil end
 local stops = require("afterimageConfig").stops(value)
 if value.Gradient then
  if #stops == 1 then stops[1].at = 0; table.insert(stops, {at = 1, color = value.Color2, alpha = stops[1].alpha}) end
  return stops
 end
 if value.ColorRamp == "" or value.ColorRamp == nil then return nil end
 return {{at = 0, color = value.Color, alpha = stops[1].alpha}}
end
return config

]]></ProtectedString>
						<string name="ScriptGuid">{33F504A0-A117-4077-AF41-A3AFF04DC29D}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">smearConfig</string>
