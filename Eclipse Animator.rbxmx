						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local ids = {
	105914001465406, 93873328324377, 105836860666958, 119772270565249, 127879659059780,
	99117211515854, 137112487675266, 114613529321873, 100107897730633, 125302880945108,
	91773580271724, 115625288023188, 101889832189041, 114104360293698, 140225697719515,
	124619457727421, 102453327949927, 77267380307867, 134891461189789, 114066859431053,
	87223639052005, 90280037642163, 119316684021126, 87896254111021, 131706273082747,
	123343919478382, 103549894253056, 135231103291701, 121567760718879, 87713847198724,
	98880578115330, 116731681425741, 112197967113156, 91104248063287, 72351602079833,
	121321201156782, 79721252039123, 90430312994753, 80156645088475, 137666402102535,
	110972892869472, 75449844440764, 89673592376352, 83919106707006, 73847113846530,
	88506084775718, 109998224894620, 78853831030168, 86609535341971, 107960879920878,
