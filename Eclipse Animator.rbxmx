						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)
local HideManager = require(script.Parent.Parent.VFX.HideManager)
local Asset = require(script.Parent.Asset)
local Builder = require(script.Parent.Builder)
local CameraTools = require(script.Parent.CameraTools)
local ColorPopup = require(script.Parent.ColorPopup)
local CurveEditor = require(script.Parent.CurveEditor)
local FlipbookViewer = require(script.Parent.FlipbookViewer)
local Generators = require(script.Parent.Procedural.Generators)
local GradientEditor = require(script.Parent.GradientEditor)
local Hierarchy = require(script.Parent.Hierarchy)
local History = require(script.Parent.History)
local IconProvider = require(script.Parent.IconProvider)
local Inspector = require(script.Parent.Inspector)
local Library = require(script.Parent.Library)
local LightningStrikes = require(script.Parent.LightningStrikes)
local SoundPreview = require(script.Parent.SoundPreview)
local Menu = require(script.Parent.Menu)
local MeshBrowser = require(script.Parent.MeshBrowser)
local MeshCatalog = require(script.Parent.MeshCatalog)
local MeshDrawer = require(script.Parent.MeshDrawer)
local MeshFlipbookInserter = require(script.Parent.MeshFlipbookInserter)
local MeshInserter = require(script.Parent.MeshInserter)
local MeshFlipbooks = require(script.Parent.MeshFlipbooks)
local Palette = require(script.Parent.Palette)
local PresetCatalog = require(script.Parent.PresetCatalog)
local ParticlePaths = require(script.Parent.ParticlePaths)
local Preview = require(script.Parent.Preview)
local PropertyAccess = require(script.Parent.PropertyAccess)
local ScreenEffects = require(script.Parent.ScreenEffects)
local MeshParticles = require(script.Parent.MeshParticles)
local SelectionModel = require(script.Parent.SelectionModel)
local Settings = require(script.Parent.Settings)
local SpecBuilder = require(script.Parent.SpecBuilder)
local TextureBrowser = require(script.Parent.TextureBrowser)
local TextureCatalog = require(script.Parent.TextureCatalog)
local TextureDrawer = require(script.Parent.TextureDrawer)
local TextureInserter = require(script.Parent.TextureInserter)
local TextureMarks = require(script.Parent.TextureMarks)
local TexturePlayer = require(script.Parent.TexturePlayer)
local Toolbox = require(script.Parent.Toolbox)
local Window = require(script.Parent.Window)
local UndoScope = require(script.Parent.Parent.Utility.UndoScope)
local EditorHelpers = require(script.Parent.Parent.VFX.EditorHelpers)

local userInputService = require(script.Parent.Parent.Utility.inputHub)
local selection = game:GetService("Selection")

local CreateSuite = {}
CreateSuite.__index = CreateSuite

CreateSuite.title = "Create"
CreateSuite.texturesTab = "Textures"
CreateSuite.particleTemplates = "Particles"
CreateSuite.meshTemplates = "Meshes"
CreateSuite.meshesTab = "Meshes"
CreateSuite.meshAssets = "Meshes"
CreateSuite.emitModuleName = "ArcEmit"
CreateSuite.emitModuleSources = "Animation"

CreateSuite.tips = {
	emit = "Emit the selected emitters once, using their Burst settings.",
	flipbook = "Open a preview of the flipbook frames.",
	paths = "Draw where the particles of the emitters in scope will travel. The lines follow Speed, Spread Angle, Acceleration, Drag and Lifetime as you change them.",
	attach = "Create the two attachments this needs and connect them.",
	trail = "Swing the part around for a moment so the trail draws.",
	sound = "Play the selected sounds now. Click again to stop.",
}

CreateSuite.messages = {
	noAsset = "Open or start an asset first. Use New Asset in the hierarchy panel.",
	emptyAsset = "This asset is empty. Add some VFX before animating it.",
	helpersHidden = "The Origin label and particle paths are hidden. Press Ctrl+H to show them again.",
	helpersShown = "Editor helpers are showing again.",
	nothingToFrame = "There is nothing to frame yet.",
	emitModuleAdded = "Added ArcEmit to Workspace. Move it somewhere both your scripts can reach, like ReplicatedStorage, then require it and call ArcEmit.emitOnce(effect) or ArcEmit.emitAt(effect, cframe).",
	emitModuleExists = "ArcEmit is already in Workspace, so it was selected instead.",
	emitModuleMissing = "The emit module is missing from Arc's assets. Reinstall Arc to get it back.",
}

function CreateSuite.new(options)
	local self = setmetatable({}, CreateSuite)

	local interface = options.interface

	self.plugin = options.plugin
	self.interface = interface
	self.button = options.button
	self.session = options.session
	self.launcher = options.launcher
	self.factory = options.factory
	self.assets = options.assets
	self.modules = script.Parent.Parent
	self.gui = interface.gui
	self.frame = interface.create
	self.shown = false
	self.shownHandler = nil
	self.returnProject = nil
	self.connections = {}
	self.drawers = {}

	self.settings = Settings.new(options.plugin)
	self.history = History.new()
	self.undoScope = UndoScope.new()
	self.helpers = EditorHelpers.new()
	self.icons = IconProvider.new()
	self.selection = SelectionModel.new()
	self.access = PropertyAccess.new(self.history)
	self.asset = Asset.new(self.factory, self.history)
	self.hideManager = HideManager.new()
	self.camera = CameraTools.new()
	self.window = Window.new(self.frame)

	local templates = self.window.templates

	self.menu = Menu.new(self.frame.Dropdown, self.frame, templates, self.icons)

	self.colors = ColorPopup.new(self.gui, function(frame)
		interface.themeManager:decorate(frame)
	end)

	self.curves = CurveEditor.new(self.frame.Curve, self.frame, templates, self.drawers)
	self.gradients = GradientEditor.new(self.frame.Gradient, self.frame, templates, self.drawers, self.colors)
	self.flipbook = FlipbookViewer.new(self.frame.Flipbook, self.frame, templates, self.drawers)
	self.specs = SpecBuilder.new(self.access)

	self.context = {
		suite = self,
		access = self.access,
		history = self.history,
		selection = self.selection,
		asset = self.asset,
		settings = self.settings,
		icons = self.icons,
		menu = self.menu,
		colors = self.colors,
		curves = self.curves,
		gradients = self.gradients,
		hover = interface.hover,
		hideManager = self.hideManager,
		camera = self.camera,
		drawers = self.drawers,
		templates = templates,
		root = self.frame,
		specs = self.specs,
		plugin = options.plugin,
		hierarchyChanged = function()
			self.hierarchy:restyle()
		end,
		structureChanged = function()
			self.preview:scheduleStatus()
		end,
		refreshTools = function()
			self.toolbox:refresh()
		end,
		rebuildTools = function()
			self.toolbox:sync()
		end,
		notify = function(text: string)
			self:notify(text)
		end,
		confirm = function(options)
			interface.alertPrompt:open(options)
		end,
		getScale = function(): number
			return self.window:getScale()
		end,
		newAsset = function()
			self:newAsset()
		end,
		openSelected = function()
			self:openSelected()
		end,
		openProject = function(project: Instance)
			self:openProject(project)
		end,
		frameSelection = function(viewName: string?)
			self:frameSelection(viewName)
		end,
	}

	self.access:setFailedHandler(self.context.notify)
	self.generators = Generators.new(self.context)
	self.context.generators = self.generators
	self.flipbooks = MeshFlipbooks.new(self.context)
	self.context.flipbooks = self.flipbooks
	self.screens = ScreenEffects.new(self.context)
	self.meshParticles = MeshParticles.new(self.context)
	self.strikes = LightningStrikes.new(self.context)
	self.context.strikes = self.strikes
	self.sounds = SoundPreview.new(self.context)
	self.context.sounds = self.sounds
	self.paths = ParticlePaths.new(self.context)
	self.context.paths = self.paths
	self.builder = Builder.new(self.context)
	self.preview = Preview.new(self.frame.Preview.Content, self.context)

	self.paths:setEmitterProvider(function()
		return self.preview:collect("ParticleEmitter")
	end)
	self.hierarchy = Hierarchy.new(self.frame.Hierarchy, templates, self.context)
	self.inspector = Inspector.new(self.window:getPage("Inspect"), templates, self.context)
	self.palette = Palette.new(self.window:getPage("Add"), templates, self.context, self.builder)
	self.toolbox = Toolbox.new(self.window:getPage("Tools"), templates, self.context)
	self.library = Library.new(self.window:getPage("Library"), templates, self.context, self.builder)
	self.library:setCatalog(PresetCatalog.new(options.assets))

	self:createTextures(options.templates)
	self:createMeshes(options.assets)
	self:registerActions()

	self.window:setScale(self.settings:get("scale"))
	self:bind()

	if interface.dock then
		interface.dock:bindButton(self.frame.Tab.Content:FindFirstChild("Dock"))
	end

	return self
end

function CreateSuite:createTextures(templates: Instance?)
	local particles = if templates then templates:FindFirstChild(CreateSuite.particleTemplates) else nil
	local meshes = if templates then templates:FindFirstChild(CreateSuite.meshTemplates) else nil

	self.textureCatalog = TextureCatalog.new()
	self.textureMarks = TextureMarks.new(self.plugin)
	self.texturePlayer = TexturePlayer.new()
	self.textureInserter = TextureInserter.new(self.context, self.builder, particles, self.textureMarks)
	self.meshInserter = MeshFlipbookInserter.new(self.context, self.builder, meshes, self.textureMarks)
	self.texturePlayer:setLifetime(self.textureInserter:getFlipbookLifetime())

	local parts = {
		catalog = self.textureCatalog,
		marks = self.textureMarks,
		inserters = {
			[TextureCatalog.staticKind] = self.textureInserter,
			[TextureCatalog.flipbookKind] = self.textureInserter,
			[TextureCatalog.meshKind] = self.meshInserter,
		},
		player = self.texturePlayer,
	}

	self.textureDrawer = TextureDrawer.new(self.frame.Texture, self.frame, self.drawers, parts)
	parts.drawer = self.textureDrawer
	self.textures = TextureBrowser.new(self.window:getPage(CreateSuite.texturesTab), self.window.templates, self.context, parts)

	self.window:addTabHandler(function(name)
		self.textures:onTabChanged(name)
	end)
end

function CreateSuite:createMeshes(assets: Instance?)
	local root = if assets then assets:FindFirstChild(CreateSuite.meshAssets) else nil

	self.meshCatalog = MeshCatalog.new(root)
	self.meshAssetInserter = MeshInserter.new(self.context, self.builder)

	local parts = {
		catalog = self.meshCatalog,
		inserter = self.meshAssetInserter,
	}

	self.meshDrawer = MeshDrawer.new(self.frame.Mesh, self.frame, self.drawers, parts)
	parts.drawer = self.meshDrawer
	self.meshes = MeshBrowser.new(self.window:getPage(CreateSuite.meshesTab), self.window.templates, self.context, parts)

	self.window:addTabHandler(function(name)
		self.meshes:onTabChanged(name)
	end)
end

function CreateSuite:showTab(name: string)
	if self:isBlocked() then
		return
	end

	if self:isShown() then
		self.window:setTab(name)
		return
	end

	if self.session:isActive() then
		self.session:requestExit(function()
			self:show()
			self.window:setTab(name)
		end)

		return
	end

	self:show()
	self.window:setTab(name)
end

function CreateSuite:showTextures()
	self:showTab(CreateSuite.texturesTab)
end

function CreateSuite:showMeshes()
	self:showTab(CreateSuite.meshesTab)
end

function CreateSuite:findFirst(targets: { Instance }, className: string): Instance?
	for _, target in targets do
		if target:IsA(className) then
			return target
		end
	end

	return nil
end

function CreateSuite:registerActions()
	local tips = CreateSuite.tips

	self.inspector:addSectionProvider(self.generators)
	self.inspector:addSectionProvider(self.flipbooks)
	self.inspector:addSectionProvider(self.screens)
	self.inspector:addSectionProvider(self.meshParticles)
	self.inspector:addSectionProvider(self.strikes)

	self.inspector:setAction("emit", {
		text = "Emit",
		tip = tips.emit,
		callback = function(targets)
			self.preview:emitInstances(targets)
		end,
	})

	self.inspector:setAction("paths", {
		text = "Paths",
		tip = tips.paths,
		callback = function()
			self.paths:toggle()
		end,
	})

	self.inspector:setAction("flipbook", {
		text = "Preview",
		tip = tips.flipbook,
		callback = function(targets)
			local emitter = self:findFirst(targets, "ParticleEmitter")

			if emitter then
				self.flipbook:toggle({ owner = emitter, emitter = emitter })
			end
		end,
	})

	self.inspector:setAction("attach", {
		text = "New Points",
		tip = tips.attach,
		callback = function(targets)
			for _, target in targets do
				self.builder:attachPair(target)
			end
		end,
	})

	self.inspector:setAction("trail", {
		text = "Preview",
		tip = tips.trail,
		callback = function(targets)
			local trail = self:findFirst(targets, "Trail")

			if trail then
				self.preview:previewTrail(trail)
			end
		end,
	})

	self.inspector:setAction("sound", {
		text = "Play",
		tip = tips.sound,
		callback = function(targets)
			self.sounds:toggle(targets)
		end,
	})

	local showInspector = function()
		if self.settings:get("autoInspect") then
			self.window:setTab("Inspect")
		end
	end

	self.builder:setCreatedHandler(showInspector)
	self.library:setInsertedHandler(showInspector)
end

function CreateSuite:connect(signal: RBXScriptSignal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function CreateSuite:bind()
	local window = self.window

	if self.button then
		self:connect(self.button.Click, function()
			self:toggle()
		end)
	end

	self:connect(window.exitButton.Activated, function()
		self.interface:close()
	end)

	self:connect(window.animateButton.Activated, function()
		self:animate()
	end)

	self:connect(window.assetButton.Activated, function()
		self:openAssetMenu()
	end)

	self:connect(window.settingsButton.Activated, function()
		self:openSettingsMenu()
	end)

	if window.emitModuleButton then
		self:connect(window.emitModuleButton.Activated, function()
			self:insertEmitModule()
		end)
	end

	self.selection:addChangedHandler(function(instances)
		self:onSelectionChanged(instances)
	end)

	self.asset:addChangedHandler(function(project)
		self:onAssetChanged(project)
	end)

	self.settings:addChangedHandler(function(name, value)
		if name == "scale" then
			self.window:setScale(value)
		end
	end)

	self.interface:setCreateHiddenHandler(function()
		self:onHidden()
	end)

	self.interface:onClose(function()
		self:onClosed()
	end)

	self.session:addExitHandler(function(project)
		self:onSessionExit(project)
	end)

	self.helpers:addListener(function(hidden)
		self.paths:setHidden(hidden)
	end)

	self:connect(userInputService.InputBegan, function(input)
		if EditorHelpers.isToggleInput(input) and self:isShown() and not self.session:isActive() and not self:isBlocked() then
			self:toggleHelpers()
		end
	end)
end

function CreateSuite:toggleHelpers()
	local hidden = self.helpers:toggle()

	self:notify(if hidden then CreateSuite.messages.helpersHidden else CreateSuite.messages.helpersShown)
end

function CreateSuite:notify(text: string)
	self.interface.notifier:notify(CreateSuite.title, text)
end

function CreateSuite:refreshButton()
	if not self.button then
		return
	end

	pcall(function()
		self.button:SetActive(self:isShown())
	end)
end

function CreateSuite:isShown(): boolean
	return self.shown and self.interface:isEnabled()
end

function CreateSuite:isBlocked(): boolean
	local interface = self.interface

	return interface.alertPrompt:isOpen() or interface.namingPrompt:isOpen() or interface.relativePrompt:isOpen()
end

function CreateSuite:toggle()
	if self:isBlocked() then
		self:refreshButton()
		return
	end

	if self:isShown() then
		self.interface:close()
		self:refreshButton()
		return
	end

	if self.session:isActive() then
		self.session:requestExit(function()
			self:show()
		end)

		self:refreshButton()
		return
	end

	self:show()
end

function CreateSuite:show()
	if self:isShown() then
		return
	end

	self.returnProject = nil
	self.interface:setEnabled(true)
	self.interface:showCreate()
	self.shown = true
	self:startSystems()
	self:refreshButton()

	if self.shownHandler then
		self.shownHandler()
	end
end

function CreateSuite:setShownHandler(handler: (() -> ())?)
	self.shownHandler = handler
end

function CreateSuite:hide()
	if not self.shown then
		return
	end

	self.interface:hideCreate()
end

function CreateSuite:onHidden()
	if not self.shown then
		return
	end

	self.shown = false
	self:stopSystems()
	self:refreshButton()
end

function CreateSuite:onClosed()
	if self.shown then
		self.interface:hideCreate()
	end

	if not self.session:isActive() then
		self.interface:showPrimary()
	end

	self:refreshButton()
end

function CreateSuite:onSessionExit(project: Instance)
	if self.returnProject ~= project then
		return
	end

	self.returnProject = nil

	task.defer(function()
		if self.interface:isEnabled() and not self.session:isActive() and not self:isBlocked() then
			self:show()
		end
	end)
end

function CreateSuite:startSystems()
	if self.asset:isOpen() and not self.asset:getEffects() then
		self.asset:close()
	end

	self.selection:start()
	self.hierarchy:start()
	self.inspector:start()
	self.toolbox:start()
	self.library:start()
	self.preview:start()
	self.paths:start()
	self.textures:start()
	self.meshes:start()
	self.undoScope:switch(self.asset:getProject())
	self.helpers:setEffects(self.asset:getEffects())
end

function CreateSuite:closePopups()
	self.menu:close()
	self.colors:close()

	for _, drawer in self.drawers do
		if drawer:isOpen() then
			drawer:close()
		end
	end
end

function CreateSuite:stopSystems()
	self:closePopups()
	self.window:endRename()
	self.window:endDrag()
	self.preview:stop()
	self.paths:stop()
	self.flipbooks:stop()
	self.screens:stop()
	self.meshParticles:stop()
	self.strikes:stop()
	self.sounds:stop()
	self.library:stop()
	self.generators:finishEdit()
	self.textures:stop()
	self.meshes:stop()
	self.inspector:stop()
	self.toolbox:stop()
	self.hierarchy:stop()
	self.selection:stop()
	self.hideManager:showAll()
	self.history:destroy()
	self.undoScope:switch(nil)
	self.helpers:release()
end

function CreateSuite:onSelectionChanged(instances: { Instance })
	self.screens:stopPreview()
	self.hierarchy:onSelectionChanged(instances)
	self.inspector:setSelection(instances)
	self.toolbox:sync()
	self.textures:onSelectionChanged()
	self.meshes:onSelectionChanged()
	self.preview:scheduleStatus()
end

function CreateSuite:onAssetChanged(project: Instance?)
	self.undoScope:switch(project, self.history:isRecording())
	self.helpers:setEffects(self.asset:getEffects())
	self.hideManager:showAll()
	self.window:setAssetName(if project then project.Name else nil)
	self.hierarchy:onAssetChanged()
	self.preview:scheduleStatus()
end

function CreateSuite:newAsset()
	local project = self.asset:create()

	if project then
		self.selection:set({})
		self.window:setTab("Add")
	end
end

function CreateSuite:openSelected()
	local success, message = self.asset:openFromSelection(self.selection:get())

	if not success and message then
		self:notify(message)
	end
end

function CreateSuite:openProject(project: Instance)
	local success, message = self.asset:open(project)

	if not success and message then
		self:notify(message)
	end
end

function CreateSuite:ensureAsset(): boolean
	if self.asset:isOpen() then
		return true
	end

	return self.asset:create() ~= nil
end

function CreateSuite:frameSelection(viewName: string?)
	local instances = self.selection:get()

	if #instances == 0 then
		local effects = self.asset:getEffects()

		instances = if effects then { effects } else {}
	end

	if not self.camera:frame(instances, viewName) then
		self:notify(CreateSuite.messages.nothingToFrame)
	end
end

function CreateSuite:openAssetMenu()
	if self.window:isRenaming() then
		return
	end

	local current = self.asset:getProject()
	local items = {
		{
			text = "New Asset",
			callback = function()
				self:newAsset()
			end,
		},
		{
			text = "Open Selected",
			callback = function()
				self:openSelected()
			end,
		},
	}

	if current then
		table.insert(items, {
			text = "Rename",
			callback = function()
				self.window:beginRename(current.Name, function(name)
					self.asset:rename(name)
				end)
			end,
		})

		table.insert(items, {
			text = "Select In Explorer",
			callback = function()
				self.selection:set({ current })
			end,
		})

		table.insert(items, {
			text = "Close Asset",
			callback = function()
				self.asset:close()
			end,
		})
	end

	local projects = self.asset:listProjects()

	if #projects > 0 then
		table.insert(items, { separator = true })

		for _, project in projects do
			table.insert(items, {
				text = project.Name,
				icon = "project",
				checked = project == current,
				callback = function()
					self:openProject(project)
				end,
			})
		end
	end

	self.menu:toggle({ anchor = self.window.assetButton, items = items, search = false })
end

function CreateSuite:insertEmitModule()
	if self:isBlocked() then
		return
	end

	local messages = CreateSuite.messages
	local template = if self.assets then self.assets:FindFirstChild(CreateSuite.emitModuleName) else nil

	if not template or not template:IsA("ModuleScript") then
		self:notify(messages.emitModuleMissing)
		return
	end

	local existing = workspace:FindFirstChild(CreateSuite.emitModuleName)

	if existing and existing:IsA("ModuleScript") then
		selection:Set({ existing })
		self:notify(messages.emitModuleExists)
		return
	end

	local sources = self.modules:FindFirstChild(CreateSuite.emitModuleSources)

	local module = self.history:run("Add Emit Module", function()
		local copy = template:Clone()

		for _, child in copy:GetChildren() do
			local source = if sources then sources:FindFirstChild(child.Name) else nil

			if child:IsA("ModuleScript") and source and source:IsA("ModuleScript") then
				child.Source = source.Source
			end
		end

		copy.Parent = workspace

		return copy
	end)

	if module then
		selection:Set({ module })
		self:notify(messages.emitModuleAdded)
	end
end

function CreateSuite:openSettingsMenu()
	local items = {
		{ text = "Interface Size", disabled = true },
	}

	for _, scale in configuration.Create.scales do
		table.insert(items, {
			text = string.format("%d%%", math.round(scale * 100)),
			checked = math.abs(self.settings:get("scale") - scale) < 0.001,
			callback = function()
				self.settings:set("scale", scale)
			end,
		})
	end

	table.insert(items, { separator = true })

	table.insert(items, {
		text = "Snap To Increments",
		checked = self.settings:get("snap"),
		callback = function()
			self.settings:set("snap", not self.settings:get("snap"))
		end,
	})

	table.insert(items, {
		text = "Show Inspect After Adding",
		checked = self.settings:get("autoInspect"),
		callback = function()
			self.settings:set("autoInspect", not self.settings:get("autoInspect"))
		end,
	})

	self.menu:toggle({ anchor = self.window.settingsButton, items = items, width = 190, search = false })
end

function CreateSuite:animate()
	if self:isBlocked() then
		return
	end

	local project = self.asset:getProject()
	local effects = self.asset:getEffects()

	if not project or not effects then
		self:notify(CreateSuite.messages.noAsset)
		return
	end

	if not self.factory:hasEffectsContent(effects) then
		self:notify(CreateSuite.messages.emptyAsset)
		return
	end

	self.selection:set({})
	self:hide()
	self.returnProject = project

	local relative = self.launcher:getStoredRelative(project)

	if relative then
		self.launcher:launch(project, relative)
		return
	end

	self.launcher:requestRelative({
		validate = function(instance)
			return self.launcher:isValidRelative(instance, { project })
		end,
		onApply = function(chosen)
			self.launcher:launch(project, chosen)
		end,
		onBack = function()
			self.returnProject = nil
			self:show()
		end,
	})
end

function CreateSuite:destroy()
	if self.shown then
		self.shown = false
		self:stopSystems()
	end

	self.interface:setCreateHiddenHandler(nil)

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	self.meshes:destroy()
	self.meshDrawer:destroy()
	self.textures:destroy()
	self.textureDrawer:destroy()
	self.texturePlayer:destroy()
	self.textureMarks:destroy()
	self.library:destroy()
	self.toolbox:destroy()
	self.palette:destroy()
	self.preview:destroy()
	self.paths:destroy()
	self.flipbooks:destroy()
	self.screens:destroy()
	self.meshParticles:destroy()
	self.strikes:destroy()
	self.sounds:destroy()
	self.generators:destroy()
	self.inspector:destroy()
	self.hierarchy:destroy()
	self.flipbook:destroy()
	self.curves:destroy()
	self.gradients:destroy()
	self.colors:destroy()
	self.menu:destroy()
	self.window:destroy()
	self.asset:destroy()
	self.selection:destroy()
	self.settings:destroy()
	self.hideManager:destroy()
	self.history:destroy()
end

return CreateSuite
