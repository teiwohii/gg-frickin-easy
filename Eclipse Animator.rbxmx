							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local boltStrike = require(script.Parent.boltStrike)

local StrikeClock = {}
StrikeClock.__index = StrikeClock

function StrikeClock.new()
	local self = setmetatable({}, StrikeClock)

	self.targetProvider = nil
	self.eventsProvider = nil
	self.tracks = {}
	self.dirty = true
	self.lastTarget = nil
	self.connection = nil

	return self
end

function StrikeClock:setTargetProvider(provider: () -> number)
	self.targetProvider = provider
end

function StrikeClock:setEventsProvider(provider: () -> { any })
	self.eventsProvider = provider
end

function StrikeClock:invalidate()
	self.dirty = true
end

function StrikeClock:isRunning(): boolean
	return self.connection ~= nil
end

function StrikeClock:start()
	self:stop()
	self.dirty = true

	self.connection = runService.Heartbeat:Connect(function()
		self:update()
	end)
end

function StrikeClock:rebuild()
	local previous = self.tracks
	local tracks = {}

	for _, event in if self.eventsProvider then self.eventsProvider() else {} do
		local host = event.host

		if typeof(host) == "Instance" and host.Parent and boltStrike.has(host) then
			local track = tracks[host]

			if not track then
				track = {}
				tracks[host] = track
			end

			table.insert(track, {
				start = event.start,
				count = event.count,
				stretch = event.stretch,
			})
		end
	end

	for _, track in tracks do
		table.sort(track, function(a, b)
			return a.start < b.start
		end)
	end

	for host in previous do
		if not tracks[host] and host.Parent then
			boltStrike.applyRest(host)
		end
	end

	self.tracks = tracks
	self.lastTarget = nil
end

function StrikeClock:getActive(track, target: number)
	for index = #track, 1, -1 do
		if track[index].start <= target then
			return track[index]
		end
	end

	return nil
end

function StrikeClock:update()
	local target = if self.targetProvider then self.targetProvider() else 0

	if self.dirty then
		self.dirty = false
		self:rebuild()
	end

	if self.lastTarget == target then
		return
	end

	self.lastTarget = target

	for host, track in self.tracks do
		local config = if host.Parent then boltStrike.read(host) else nil

		if config then
			local active = self:getActive(track, target)

			if active then
				boltStrike.apply(host, config, target - active.start, active.count, active.stretch)
			else
				boltStrike.apply(host, config, nil)
			end
		end
	end
end

function StrikeClock:getEndTime(): number
	local finish = 0

	for host, track in self.tracks do
		local config = if host.Parent then boltStrike.read(host) else nil

		if config then
			for _, event in track do
				finish = math.max(finish, event.start + boltStrike.getTotalLength(config, event.count, event.stretch))
			end
		end
	end

	return finish
end

function StrikeClock:clear()
	for host in self.tracks do
		if host.Parent then
			boltStrike.applyRest(host)
		end
	end

	table.clear(self.tracks)
	self.lastTarget = nil
	self.dirty = true
end

function StrikeClock:stop()
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end

	self:clear()
end

return StrikeClock
]]></ProtectedString>
