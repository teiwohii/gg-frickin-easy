							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local codec = require("codec")
local catalog = script.Parent.Parent.effectCatalog
local parts = { "return function(require)\nreturn {\n" }

for _, group in
	{
		catalog.singleColors,
		catalog.lightingEffects,
		catalog.dualColors,
		catalog.miscEffects,
	}
do
	for _, record in require(group) do
		 
		table.insert(parts, codec.encode(record, nil, 1, true) .. ",\n")
	end
end

table.insert(parts, "}\nend\n")
return table.concat(parts)
]]></ProtectedString>
							<string name="ScriptGuid">{86EA9784-909D-45BA-ADEA-DC50FCDBD611}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">exportEffectAssets</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
