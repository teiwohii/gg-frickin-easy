					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro



local require = require(script:FindFirstAncestor("container").requireModule)



local http = game:GetService("HttpService")

local paths = {}

local preview = require("rigPreview")



function paths.of(object, root, localOnly)

	if not localOnly then

		object, root = preview.original(object), preview.original(root)

	end



	local path = {}

	while object and object ~= root do

		local parent = object.Parent

		if not parent then

			return nil

		end



		local index = 0

		for _, child in parent:GetChildren() do

			if child.Name == object.Name and child.ClassName == object.ClassName then

				index += 1

			end



			if child == object then

				break

			end

		end



		local name = object.Name

		local step = { name, object.ClassName, index }

		if not utf8.len(name) then

			local bytes = name:gsub(".", function(byte)

				return string.format("%02X", string.byte(byte))

			end)

			step[1], step[4], step[5] = "Name bytes " .. bytes, false, bytes

		end

		table.insert(path, 1, step)

		object = parent

	end



	return object == root and http:JSONEncode(path) or nil

end



function paths.resolve(root, path)

	local object = root

	for _, step in http:JSONDecode(path) do

		local name = step[1]

		if type(step[5]) == "string" then

			local bytes = step[5]

			if #bytes % 2 ~= 0 or bytes:find("[^%x]") then

				return nil

			end

			name = bytes:gsub("..", function(byte)

				return string.char(tonumber(byte, 16))

			end)

		end

		local count, found = 0, nil

		for _, child in object:GetChildren() do

			if child.Name == name and child.ClassName == step[2] then

				count += 1

				if count == step[3] then

					found = child

					break

				end

			end

		end



		if not found and step[2] == "Bone" then

			found = require("r6Controls").findNamed(object, name, step[3])

		end



		if not found then

			return nil

		end



		object = found

	end



	return preview.localOf(object)

end



function paths.motor(motor, rig, liveIdentity)

	if typeof(motor) == "table" and motor.IsEclipseProperty then

		return "property:" .. motor.PropertyId

	end



	if typeof(motor) == "table" and motor.IsEclipseMasterControl then

		return "master"

	end



	if liveIdentity and typeof(motor) == "table" and motor.IsEclipseR6Control then

		local owner = paths.motor(motor.Owner, rig)

		return owner and "r6:" .. motor:GetAttribute("EclipseR6Control") .. ":" .. owner

	end



	local part = motor.Part1

	local id = part and part:GetAttribute("EclipseArmatureBoneId")

	if id then

		return "armature:" .. id

	end



	if part then

		local path = paths.of(part, rig)

			or typeof(motor) == "table"

				and motor.IsEclipseR6Control

				and paths.of(part, rig, true)

		if path then

			return path

		end



		local linked = require("trackOrganizationStorage").bindingPath(rig, part)

		if linked then

			return "joint:" .. http:JSONEncode(linked)

		end

	end



	return nil

end



function paths.identity(path)

	if type(path) ~= "string" then

		return path

	end

	local linked = path:sub(1, 6) == "joint:"

	if not linked and path:sub(1, 1) ~= "[" then

		return path

	end

	local ok, steps = pcall(http.JSONDecode, http, linked and path:sub(7) or path)

	if not ok or type(steps) ~= "table" then

		return path

	end

	local normalized = {}

	for _, step in ipairs(steps) do

		if type(step) ~= "table" then

			return path

		end

		if linked then

			if step.link then

				table.insert(normalized, { "link", step.link })

			else

				table.insert(normalized, { "child", step.name, step.class, step.index })

			end

		else

			table.insert(normalized, { step[1], step[2], step[3] })

		end

	end

	return (linked and "joint:" or "") .. http:JSONEncode(normalized)

end



function paths.excluded(object, root)

	while object and object ~= root do

		if

			object:IsA("LuaSourceContainer")

			or object:IsA("KeyframeSequence")

			or object.Name == "AnimSaves"

			or object:GetAttribute("EclipsePartRigRoot")

			or object:GetAttribute("EclipseGeneratedVisual")

			or object:GetAttribute("EclipseArmatureSkinningHelper")

		then

			return true

		end



		object = object.Parent

	end



	return false

end



return paths

]]></ProtectedString>
