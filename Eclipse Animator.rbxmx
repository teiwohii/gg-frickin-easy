					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local tree = require("rigTraversal")
local paths = require("paths")
local accessoryRig = {}

function accessoryRig.supports(model)
	if not model or not model:IsA("Model") then
		return false
	end

	if model:FindFirstChildOfClass("Humanoid") then
		return true
	end

	for _, object in tree.descendants(model) do
		if
			object:IsA("Motor6D") and not object:GetAttribute("EclipsePartRigJoint")
			or object:IsA("Bone")
			or object:IsA("AnimationConstraint")
		then
			return true
		end
	end

	return false
end

local function source(motor)
	local ref = motor:FindFirstChild("EclipseAccessoryPart")
	return ref and ref:IsA("ObjectValue") and ref.Value
end

function accessoryRig.catalog(model)
	assert(typeof(model) == "Instance" and model:IsA("Model"), "Select a rig or model first")
	local objects = tree.descendants(model)
	local body, existing, links, blocked = {}, {}, {}, {}

	local function link(part, joint)
		if part and part:IsDescendantOf(model) then
			links[part] = links[part] or {}
			table.insert(links[part], joint)
		end
	end

	for _, object in objects do
		if object:IsA("Motor6D") and object:GetAttribute("EclipseAccessoryControl") then
			local part = source(object)
			if part and part:IsDescendantOf(model) then
				existing[part] = object
			end

			if object.Part1 then
				body[object.Part1] = true
			end
		elseif object:IsA("Motor6D") then
			if object.Part0 then
				body[object.Part0] = true
			end

			if object.Part1 then
				body[object.Part1] = true
			end
		elseif object:IsA("AnimationConstraint") then
			for _, attachment in { object.Attachment0, object.Attachment1 } do
				if attachment and attachment.Parent:IsA("BasePart") then
					body[attachment.Parent] = true
				end
			end
		elseif object:IsA("Bone") then
			local part = object:FindFirstAncestorWhichIsA("BasePart")
			if part then
				body[part] = true
			end
		end

		if
			(object:IsA("JointInstance") or object:IsA("WeldConstraint"))
			and not object:GetAttribute("EclipseAccessoryLink")
			and not object:GetAttribute("EclipseAccessoryControl")
		then
			link(object.Part0, object)
			link(object.Part1, object)
		elseif object:IsA("Constraint") and not object:IsA("WeldConstraint") then
			for _, attachment in { object.Attachment0, object.Attachment1 } do
				local part = attachment and attachment:FindFirstAncestorWhichIsA("BasePart")
				if part then
					blocked[part] = true
				end
			end
		end
	end

	local root = model.PrimaryPart
	if not root or not body[root] then
		local incoming = {}
		for _, object in objects do
			if object:IsA("Motor6D") and object.Part1 then
				incoming[object.Part1] = true
			end
		end

		root = nil
		for _, object in objects do
			if body[object] and object:IsA("BasePart") and not incoming[object] then
				root = object
				break
			end
		end
	end

	local parts, plans, reasons = {}, {}, {}
	for _, part in objects do
		if not part:IsA("BasePart") or body[part] or paths.excluded(part, model) then
			continue
		end

		local accessory = part:FindFirstAncestorOfClass("Accessory")
			or part:FindFirstAncestorOfClass("Hat")
		if accessory and accessory:FindFirstChild("Handle") ~= part and not existing[part] then
			continue
		end

		table.insert(parts, part)
		if existing[part] then
			continue
		end

		if part:FindFirstChildWhichIsA("WrapLayer", true) then
			reasons[part] = "Layered clothing"
		elseif part:FindFirstChildWhichIsA("Bone", true) then
			reasons[part] = "Use its bone tracks"
		elseif blocked[part] then
			reasons[part] = "Constrained part"
		else
			local candidates = {}
			local unsafe = false
			for _, joint in links[part] or {} do
				if not joint.Enabled then
					continue
				end

				local other = joint.Part0 == part and joint.Part1 or joint.Part0

				if
					accessory
					and other
					and other:IsDescendantOf(accessory)
					and (
						joint:IsA("Weld")
						or joint:IsA("WeldConstraint")
						or joint:IsA("ManualWeld")
					)
				then
					continue
				end

				if
					other
					and body[other]
					and other:IsDescendantOf(model)
					and (
						joint:IsA("Weld")
						or joint:IsA("WeldConstraint")
						or joint:IsA("ManualWeld")
					)
				then
					table.insert(candidates, { joint = joint, parent = other })
				else
					unsafe = true
				end
			end

			if unsafe or #candidates > 1 then
				reasons[part] = "Multiple or unsupported joints"
			elseif #candidates == 1 then
				plans[part] = candidates[1]
			elseif accessory then
				reasons[part] = "Attach this accessory to the rig first"
			elseif root then
				plans[part] = { parent = root }
			else
				reasons[part] = "No rig root"
			end
		end
	end

	table.sort(parts, function(a, b)
		return paths.of(a, model) < paths.of(b, model)
	end)
	return parts, existing, plans, reasons
end

function accessoryRig.create(model, selected)
	local parts, existing, plans, reasons = accessoryRig.catalog(model)
	local chosen = {}
	for part, enabled in selected do
		if enabled then
			assert(table.find(parts, part), "A selected part was removed")
			assert(not reasons[part], part.Name .. ": " .. tostring(reasons[part]))
			if not existing[part] then
				table.insert(chosen, part)
			end
		end
	end

	assert(#chosen > 0, "Choose an accessory or part that is not already on the timeline")
	table.sort(chosen, function(a, b)
		return paths.of(a, model) < paths.of(b, model)
	end)
	local names = {}
	for _, object in tree.descendants(model) do
		if object:IsA("BasePart") then
			names[object.Name] = true
		end
	end

	local entries, joints, owned = {}, {}, {}
	for _, part in chosen do
		local plan = plans[part]
		assert(plan and plan.parent and plan.parent.Parent, "The attachment was removed")
		local accessory = part:FindFirstAncestorOfClass("Accessory")
			or part:FindFirstAncestorOfClass("Hat")
		local name = accessory and accessory.Name or part.Name
		local base = name
		local index = 1
		while names[name] do
			index += 1
			name = base .. " (" .. index .. ")"
		end

		names[name] = true

		local control = Instance.new("Part")
		control.Name = name
		control.Size = part.Size
		control.CFrame = part.CFrame
		control.Transparency = 1
		control.CanCollide = false
		control.CanTouch = false
		control.CanQuery = false
		control.CastShadow = false
		control.Massless = true
		control:SetAttribute("EclipseAccessoryControlPart", true)
		local motor = Instance.new("Motor6D")
		motor.Name = name
		motor.Part0 = plan.parent
		motor.Part1 = control
		local original = plan.joint
		if original and original:IsA("JointInstance") then
			if original.Part0 == part then
				motor.C0 = original.C1
				motor.C1 = original.C0
			else
				motor.C0 = original.C0
				motor.C1 = original.C1
			end
		else
			motor.C0 = plan.parent.CFrame:ToObjectSpace(part.CFrame)
		end

		motor:SetAttribute("EclipseAccessoryControl", true)
		motor:SetAttribute("EclipseAnimatorDefaultC0", motor.C0)
		local ref = Instance.new("ObjectValue")
		ref.Name = "EclipseAccessoryPart"
		ref.Value = part
		ref.Parent = motor
		local weld = Instance.new("Weld")
		weld.Name = "EclipseAccessoryLink"
		weld.Part0 = control
		weld.Part1 = part
		weld:SetAttribute("EclipseAccessoryLink", true)
		weld.Parent = control
		motor.Parent = control
		table.insert(entries, {
			part = part,
			control = control,
			motor = motor,
			original = original,
			enabled = original and original.Enabled,
			stamp = original and original:GetAttribute("EclipseAccessorySource"),
			frame = part.CFrame,
		})
		table.insert(joints, motor)
		owned[control] = true
		owned[motor] = true
	end

	local transaction = { model = model, joints = joints, owned = owned, parts = chosen }

	function transaction.apply(enabled)
		for _, entry in entries do
			if enabled then
				if entry.original then
					entry.original:SetAttribute("EclipseAccessorySource", true)
					entry.original.Enabled = false
				end

				entry.control.Parent = model
			else
				entry.control.Parent = nil
				if entry.original and entry.original.Parent then
					entry.original.Enabled = entry.enabled
					entry.original:SetAttribute("EclipseAccessorySource", entry.stamp)
				end
			end

			entry.control.CFrame = entry.frame
			if entry.part.Parent then
				entry.part.CFrame = entry.frame
			end
		end
	end

	transaction.apply(true)
	return transaction
end

return accessoryRig
]]></ProtectedString>
						<string name="ScriptGuid">{0FC5ED95-32AC-426F-8924-7A6CEE5478E2}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">accessories</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX584CE49AFB574E89AC83018587176C92">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro



local require = require(script:FindFirstAncestor("container").requireModule)



local auto = {}

local sides = { "left", "right" }



local function limbName(motor)

	local name = (motor.Part1.Name:lower():gsub("[^%a]", ""))

	for _, side in sides do

		if #name > #side and name:sub(1, #side) == side then

			return side, name:sub(#side + 1)

		end

	end



	for _, side in sides do

		local first, last = name:find(side, 1, true)

		if first and #name > #side then

			return side, name:sub(1, first - 1) .. name:sub(last + 1)

		end

	end



	return nil, name

end



function auto.limbKind(owner)

	local _, name = limbName(owner)

	return (

		name:find("foot", 1, true)

		or name:find("ankle", 1, true)

		or name:find("boot", 1, true)

		or name:find("pant", 1, true)

		or name:find("leg", 1, true)

	)

			and "Leg"

		or "Arm"

end



function auto.limbEndpoint(selected, motors)

	if not auto.isJoint(selected) then

		return selected

	end

	local side, name = limbName(selected)

	if not side then

		return selected

	end

	local kind = auto.limbKind(selected)

	local stem = kind == "Leg" and (name:find("pant", 1, true) and "pant" or "leg") or "arm"

	if kind == "Leg" and name:find("boot", 1, true) then

		stem = "pant"

	end

	local upper, lower

	for _, motor in motors do

		if auto.isJoint(motor) then

			local otherSide, otherName = limbName(motor)

			if otherSide == side then

				if otherName == "upper" .. stem then

					upper = upper == nil and motor or false

				end

				if otherName == "lower" .. stem then

					lower = lower == nil and motor or false

				end

			end

		end

	end

	if not upper or not lower or lower.Part0 ~= upper.Part1 then

		return selected

	end

	local endpoint

	for _, motor in motors do

		if auto.isJoint(motor) and motor.Part0 == lower.Part1 then

			local otherSide, otherName = limbName(motor)

			if

				otherSide == side

				and (

					otherName == "foot"

					or otherName == "ankle"

					or otherName == "bootmain"

					or kind == "Arm" and otherName == "hand"

				)

			then

				if endpoint then

					return selected

				end

				endpoint = motor

			end

		end

	end

	if not endpoint then

		return (selected == upper or selected == lower) and lower or selected

	end

	if selected == upper or selected == lower or selected == endpoint then

		return endpoint

	end

	if kind == "Leg" and name:sub(1, 4) == "boot" then

		return endpoint

	end

	return selected

end



function auto.jointCount(owner)

	local joints = owner:GetAttribute("EclipseAutoIKJoints")

	if type(joints) == "number" and joints >= 1 and joints < math.huge and joints <= #auto.attributeNames(owner) then

		return math.floor(joints)

	end



	return 3

end



function auto.attributeNames(...)

	local names = { "EclipseAutoIK", "EclipseAutoIKJoints" }

	local seen = {}

	for _, owner in { ... } do

		for name in owner:GetAttributes() do

			if name:match("^EclipseAutoIKRest%d+$") and not seen[name] then

				seen[name] = true

				table.insert(names, name)

			end

		end

	end



	return names

end



function auto.rest(owner)

	local result = {}

	local count = auto.jointCount(owner)

	for i = 1, count do

		local cf = owner:GetAttribute("EclipseAutoIKRest" .. i)

		if typeof(cf) ~= "CFrame" then

			return {}

		end



		result[i] = cf

	end



	return result

end



function auto.restoreRest(owner, values)

	values = type(values) == "table" and values or {}

	local count = 0

	while values[count + 1] ~= nil do

		count += 1

	end



	for i = 1, count do

		local cf = values[i]

		assert(typeof(cf) == "CFrame", "Invalid custom IK calibration")

		for _, v in { cf:GetComponents() } do

			assert(v == v and math.abs(v) < 1e9, "Invalid custom IK calibration")

		end

	end



	for _, name in auto.attributeNames(owner) do

		if name:match("^EclipseAutoIKRest%d+$") then

			owner:SetAttribute(name, nil)

		end

	end

	for i = 1, count do

		owner:SetAttribute("EclipseAutoIKRest" .. i, values[i])

	end



	owner:SetAttribute("EclipseAutoIKJoints", if count > 0 and count ~= 3 then count else nil)

end



function auto.isJoint(motor)

	return typeof(motor) == "Instance"

			and motor:IsA("Motor6D")

			and motor.Part0 ~= nil

			and motor.Part1 ~= nil

		or typeof(motor) == "table"

			and rawget(motor, "_bone") ~= nil

			and motor.Parent ~= nil

			and not require("armatureRuntime").isDriven(motor.Bone)

end



function auto.index(motors)

	local parents = {}

	for _, motor in motors do

		if auto.isJoint(motor) then

			if parents[motor.Part1] ~= nil then

				parents[motor.Part1] = false

			else

				parents[motor.Part1] = motor

			end

		end

	end



	return parents

end



local function parentOf(motor)

	return typeof(motor) == "table" and motor.RealPart0 or motor.Part0

end



local branches = setmetatable({}, { __mode = "k" })



local function isBranch(part, motors, parents)

	local limbs = branches[parents]

	if not limbs then

		limbs = {}

		for _, motor in motors do

			local parent = auto.isJoint(motor) and parentOf(motor)

			if parent then

				limbs[parent] = (limbs[parent] or 0) + 1

			end

		end



		branches[parents] = limbs

	end



	return (limbs[part] or 0) > 1

end



function auto.depth(endpoint, parents)

	local count, current, seen = 1, endpoint, { [endpoint] = true }

	while true do

		local parent = parents[parentOf(current)]

		if not parent or seen[parent] then

			break

		end



		seen[parent] = true

		count += 1

		current = parent

	end



	return count

end



function auto.chain(rig, endpoint, motors, parents, count)

	if not auto.isJoint(endpoint) then

		return nil, "Select a Motor6D joint or a bone at the end of a limb"

	end



	parents = parents or auto.index(motors)



	local registered = endpoint:GetAttribute("EclipseAutoIK") == true

	local joints = endpoint:GetAttribute("EclipseAutoIKJoints")

	local wanted = count

	if wanted == nil and registered and type(joints) == "number" and joints ~= 3 then

		wanted = joints

	end



	local lower = parents[parentOf(endpoint)]

	local upper = lower and parents[parentOf(lower)]

	if lower == endpoint then

		lower, upper = nil, nil

	end



	local side, name = limbName(endpoint)

	local parentSide, parentName

	if lower then

		parentSide, parentName = limbName(lower)

	end

	local paired = side and side == parentSide and name:sub(1, 5) == "lower"

		and parentName == "upper" .. name:sub(6)

	local three = upper and upper ~= lower and upper ~= endpoint

	local upperSide, upperName

	if upper then

		upperSide, upperName = limbName(upper)

	end

	local namedThree = three

		and side

		and side == parentSide

		and side == upperSide

		and parentName:sub(1, 5) == "lower"

		and upperName == "upper" .. parentName:sub(6)

		and (name == "foot" or name == "ankle" or name == "bootmain" or name == "hand")

	local members

	if type(wanted) == "number" then

		wanted = math.floor(wanted)

		if wanted ~= wanted or wanted < 1 or wanted > #motors then

			return nil, "Choose a connected chain within this rig"

		end



		members = { endpoint }

		for _ = 2, wanted do

			local parent = parents[parentOf(members[1])]

			if not parent or table.find(members, parent) then

				return nil,

					"The selected end joint needs " .. (wanted - 1) .. " connected parent joints"

			end



			table.insert(members, 1, parent)

		end

	elseif joints == 2 then

		members = lower and { lower, endpoint }

	elseif not registered and lower and paired then

		members = { lower, endpoint }

	elseif three and registered or namedThree then

		members = { upper, lower, endpoint }

	elseif not registered then

		members = { endpoint }

		local seen = { [endpoint] = true }

		while true do

			local parent = parents[parentOf(members[1])]

			if not parent or seen[parent] or isBranch(parent.Part1, motors, parents) then

				break

			end

			seen[parent] = true

			table.insert(members, 1, parent)

		end

	end



	if not members then

		return nil, "The selected end joint needs a connected parent joint"

	end



	local boneChain = typeof(endpoint) == "table"

	for _, motor in members do

		if (typeof(motor) == "table") ~= boneChain then

			return nil, "Choose joints of the same type"

		end



		if

			not motor.Part1:IsDescendantOf(rig)

			or (typeof(motor) == "Instance" and not motor:IsDescendantOf(rig))

		then

			return nil, "All joints must belong to the selected rig"

		end

	end



	for i = 2, #members do

		local rest = registered and endpoint:GetAttribute("EclipseAutoIKRest" .. i)

		if typeof(rest) ~= "CFrame" then

			rest = require("rawState").Timeline.DefaultPose[members[i]] or members[i].C0

		end

		if (rest.Position - members[i - 1].C1.Position).Magnitude < 0.0001 then

			return nil, "The chain has a zero-length segment"

		end

	end



	return members

end



function auto.canSetup(rig, motor)

	if not rig or not auto.isJoint(motor) then

		return false

	end

	local entry = require("limbIk").getRig(rig)

	if not entry or entry.members[motor] or auto.limbEndpoint(motor, entry.motors) ~= motor then

		return false

	end

	entry.autoIKParents = entry.autoIKParents or auto.index(entry.motors)

	local chain = auto.chain(rig, motor, entry.motors, entry.autoIKParents)

	if not chain then

		return false

	end

	for _, member in chain do

		if entry.members[member] then

			return false

		end

	end

	return true

end



function auto.setup(selectedMotor, selectedRig, count)

	local state = require("state")

	local timeline = state.Timeline

	if

		not timeline

		or require("blenderEdit").blocked()

		or timeline:IsExportLocked()

		or state.PhysicsSimulating

	then

		return

	end



	local motor, rig = selectedMotor, selectedRig

	if not motor then

		motor, rig = require("ikPanel").selection()

	end



	local notice = require("notification")

	if not motor or not rig then

		notice.show("AUTO IK", "Select the end joint of the limb in the timeline")

		return

	end



	if state.getAllRigs and not table.find(state.getAllRigs(), rig) then

		notice.show("AUTO IK", "This rig is no longer in the active animation.", 4)

		return

	end



	local ik = require("limbIk")

	local entry = ik.getRig(rig)

	motor = auto.limbEndpoint(motor, entry.motors)

	if entry.owners[motor] then

		notice.show("AUTO IK", "This joint already has IK controls. Use its FK / IK toggle.")

		return

	end



	local chain, message = auto.chain(rig, motor, entry.motors, nil, count)

	if not chain then

		notice.show("AUTO IK", message)

		return

	end



	for _, member in chain do

		if entry.members[member] then

			notice.show("AUTO IK", "This chain overlaps another IK limb")

			return

		end

	end



	local previous = motor:GetAttribute("EclipseAutoIK")

	local previousJoints = motor:GetAttribute("EclipseAutoIKJoints")

	local controls = require("r6Controls")

	local created = {}

	local previousRest, setupRest = {}, {}

	local restCount = math.max(#chain, auto.jointCount(motor))

	for i = 1, restCount do

		previousRest[i] = motor:GetAttribute("EclipseAutoIKRest" .. i)

		setupRest[i] = chain[i] and (state.Timeline:GetState().DefaultPose[chain[i]] or chain[i].C0)

	end



	local function refresh()

		ik.invalidate(rig)

		require("project").refreshTimelineAfterStructureChange()

		state.currentProjectSaved = false

	end



	local function apply()

		motor:SetAttribute("EclipseAutoIK", true)

		motor:SetAttribute("EclipseAutoIKJoints", if #chain == 3 then nil else #chain)

		for i = 1, restCount do

			motor:SetAttribute("EclipseAutoIKRest" .. i, setupRest[i])

		end



		ik.invalidate(rig)

		for _, child in created do

			if

				child.Parent == nil

				and not controls.find(motor, child:GetAttribute("EclipseR6Control"))

			then

				child.Parent = motor.Part1

			end

		end



		local found = assert(ik.chain(rig, motor), "Custom IK chain could not be registered")

		local before = {}

		for _, child in motor.Part1:GetChildren() do

			before[child] = true

		end



		local ok, why = pcall(ik.prepare, found)

		for _, child in motor.Part1:GetChildren() do

			if not before[child] and controls.isControl(child) then

				table.insert(created, child)

			end

		end



		assert(ok, why)

		refresh()

	end



	local function undo()

		motor:SetAttribute("EclipseAutoIK", previous)

		motor:SetAttribute("EclipseAutoIKJoints", previousJoints)

		for i = 1, restCount do

			motor:SetAttribute("EclipseAutoIKRest" .. i, previousRest[i])

		end



		for _, child in created do

			child.Parent = nil

		end



		refresh()

	end



	local ok, why = pcall(apply)

	if not ok then

		undo()

		notice.show("AUTO IK", tostring(why))

		return

	end



	require("history").record(undo, apply, "Set up custom IK")

	return motor, rig

end



function auto.candidates(rig, motors, entry, counts)

	local result, parents = {}, auto.index(motors)

	for _, motor in motors do

		local registered = entry.owners[motor]

		local chain

		if registered then

			if registered.kind ~= "Torso" then

				chain = registered.motors

			end

		elseif

			auto.isJoint(motor)

			and (

				motor:GetAttribute("EclipseAutoIK") == true

				or auto.limbEndpoint(motor, motors) == motor

			)

		then

			local wanted = counts and counts[motor]

			chain = wanted and auto.chain(rig, motor, motors, parents, wanted)

				or auto.chain(rig, motor, motors, parents)

		end



		if chain then

			local overlap = false

			for _, member in chain do

				if entry.members[member] and entry.members[member] ~= entry.owners[motor] then

					overlap = true

				end

			end



			if not overlap then

				local names = {}

				for _, member in chain do

					table.insert(names, member.Part1.Name)

				end



				local path = motor:GetFullName()

				local prefix = rig:GetFullName() .. "."

				if path:sub(1, #prefix) == prefix then

					path = path:sub(#prefix + 1)

				end



				table.insert(result, {

					motor = motor,

					chain = chain,

					configured = registered ~= nil,

					limit = if registered then #chain else auto.depth(motor, parents),

					name = motor.Part1.Name,

					path = path,

					search = (path .. " " .. table.concat(names, " ")):lower(),

				})

			end

		end

	end



	table.sort(result, function(a, b)

		if a.name == b.name then

			return a.path < b.path

		end



		return a.name:lower() < b.name:lower()

	end)

	return result

end



function auto.pick(candidates, selected)

	local exact, related = {}, {}



	local function matches(motor, object)

		return object == motor

			or object == motor.Part1

			or typeof(motor) == "table" and object == motor.Bone

	end



	for _, item in candidates do

		for _, object in selected do

			if matches(item.motor, object) then

				exact[item.motor] = item

			end



			for _, member in item.chain do

				if matches(member, object) then

					related[item.motor] = item

				end

			end

		end

	end



	local pool = next(exact) and exact or related

	local choice, count = nil, 0

	for _, item in pool do

		choice = item

		count += 1

	end



	return count == 1 and choice or nil, count

end



local refs, host

local connections = {}



function auto.close()

	if host then

		local old = host

		host = nil

		old:close(true)

	end

end



function auto.destroy()

	auto.close()

	for _, c in connections do

		c:Disconnect()

	end



	table.clear(connections)

end



function auto.open()

	if host or not refs or not refs.Active() then

		return

	end



	local state = refs.State

	local timeline = state.Timeline

	local rig = require("selectedRig").resolve(state)

	local notice = require("notification")

	if not rig or not timeline then

		notice.show("AUTO IK", "Add a rig first.", 4)

		return

	end



	local tool = require("tool")

	local ik = require("limbIk")

	local session

	session = tool.new(

		refs,

		"EclipseAutoIK",

		"AUTO IK . " .. rig.Name,

		Vector2.new(360, 320),

		false,



		function()

			if host == session then

				host = nil

			end

		end,

		{ Resizable = true, FitToViewport = true, MinimumSize = Vector2.new(360, 220) }

	)

	host = session

	local frame = session.frame

	local guide = tool.label(

		frame,

		"Guide",

		"Choose a limb",

		UDim2.fromOffset(14, 34),

		UDim2.new(1, -114, 0, 22)

	)

	guide.TextSize = 14

	local search =

		tool.field(frame, "Search", "", UDim2.fromOffset(14, 62), UDim2.new(1, -28, 0, 28))

	search.PlaceholderText = "Find a limb..."

	local list = tool.make("ScrollingFrame", frame, "Endpoints", {

		ClipsDescendants = true,

		Position = UDim2.fromOffset(14, 62),

		Size = UDim2.new(1, -28, 1, -114),

		BackgroundTransparency = 1,

		BorderSizePixel = 0,

		ScrollBarThickness = 4,

		CanvasSize = UDim2.new(),

	})

	local selected, candidates, rows = nil, {}, {}

	local counts = setmetatable({}, { __mode = "k" })

	local createButton, createLabel

	local fewerButton, moreButton, jointsLabel

	local refresh, draw, choose

	local lastMotor, lastRig, lastObjects = nil, nil, {}



	local function alive()

		return host == session

			and not session.closed

			and state.Timeline == timeline

			and refs.Active()

			and table.find(state.getAllRigs(), rig) ~= nil

	end



	local function show()

		local item

		for _, v in candidates do

			if v.motor == selected then

				item = v

				break

			end

		end



		if item then

			for _, member in item.chain do

				if

					not auto.isJoint(member)

					or not (

						member.Part1:IsDescendantOf(rig)

						or typeof(member) == "Instance" and member:IsDescendantOf(rig)

					)

				then

					selected = nil

					item = nil

					break

				end

			end

		end



		for motor, row in rows do

			row.outline.Enabled = motor == selected

			row.label:SetAttribute("AutoIKSelected", motor == selected)

		end



		local configured = item and ik.chain(rig, selected)

		local enabled = configured and ik.isEnabled(selected, timeline:GetState().CurrentTime or 0)

		local ready = item ~= nil

			and not enabled

			and not state.PhysicsSimulating

			and not timeline:IsExportLocked()

			and not require("blenderEdit").blocked()

		createButton.Active = ready

		createButton:SetAttribute("Ready", ready)

		local editable = item ~= nil and not item.configured and ready

		local joints = item and #item.chain or 0

		jointsLabel.Text = item and (joints .. " JOINTS") or "JOINTS"

		fewerButton.Active = editable and joints > 1

		moreButton.Active = editable and joints < (item.limit or joints)

		fewerButton:SetAttribute("Ready", fewerButton.Active)

		moreButton:SetAttribute("Ready", moreButton.Active)

		createLabel.Text = not item and "SELECT A LIMB"

			or enabled and "IK ENABLED"

			or configured and "ENABLE IK"

			or "CREATE IK"

	end



	draw = function()

		if not alive() then

			return

		end



		for _, child in list:GetChildren() do

			child:Destroy()

		end



		table.clear(rows)

		local query = search.Text:lower():match("^%s*(.-)%s*$")

		local visible, names = {}, {}

		for _, item in candidates do

			names[item.name] = (names[item.name] or 0) + 1

			if query == "" or item.search:find(query, 1, true) then

				table.insert(visible, item)

			end

		end



		local selectedVisible = false

		for _, item in visible do

			if item.motor == selected then

				selectedVisible = true

			end

		end



		if not selectedVisible then

			selected = nil

		end



		for i, item in visible do

			local title = names[item.name] > 1 and item.path or item.name

			local button, text = tool.button(

				list,

				"Endpoint" .. i,

				title,

				UDim2.fromOffset(0, (i - 1) * 32),

				UDim2.new(1, -6, 0, 28),



				function()

					if not alive() then

						return

					end



					selected = item.motor

					show()

				end

			)

			text.Position = UDim2.fromOffset(8, 0)

			text.Size = UDim2.new(1, -16, 1, 0)

			text.TextXAlignment = Enum.TextXAlignment.Left

			text.TextWrapped = false

			text.TextTruncate = Enum.TextTruncate.AtEnd

			local outline = tool.make(

				"UIStroke",

				button,

				"Selection",

				{ Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }

			)

			outline:SetAttribute("ThemeStrk", "Strk")

			rows[item.motor] = { label = text, outline = outline }

		end



		search.Parent.Visible = #candidates > 6

		local top = #candidates > 6 and 98 or 62

		list.Position = UDim2.fromOffset(14, top)

		list.Size = UDim2.new(1, -28, 1, -top - 54)

		list.CanvasSize = UDim2.fromOffset(0, #visible * 32)

		createButton.Position = UDim2.new(0, 14, 1, -44)

		createButton.Size = UDim2.new(1, -148, 0, 30)

		fewerButton.Position = UDim2.new(1, -128, 1, -44)

		jointsLabel.Position = UDim2.new(1, -100, 1, -44)

		moreButton.Position = UDim2.new(1, -40, 1, -44)

		createButton.Visible = #visible > 0

		fewerButton.Visible, jointsLabel.Visible, moreButton.Visible =

			#visible > 0, #visible > 0, #visible > 0

		if #visible == 0 then

			tool.label(

				list,

				"Empty",

				#candidates == 0 and "No supported limbs in this rig." or "No matching limbs.",

				UDim2.fromOffset(4, 2),

				UDim2.new(1, -10, 0, 28)

			)

		end



		show()

		require("theme").applyTree(frame)

	end



	local function selection()

		local motor, owner = require("ikPanel").selection()

		return motor, owner, game:GetService("Selection"):Get()

	end



	choose = function(motor, owner, objects, preferTimeline)

		lastMotor, lastRig, lastObjects = motor, owner, table.clone(objects)

		local picked

		if preferTimeline then

			picked = auto.pick(candidates, owner == rig and motor and { motor } or {})

		else

			local count

			picked, count = auto.pick(candidates, objects)

			if count == 0 then

				picked = auto.pick(candidates, owner == rig and motor and { motor } or {})

			end

		end



		selected = picked and picked.motor or nil

		search.Text = ""

		draw()

		if selected then

			for i, item in candidates do

				if item.motor == selected then

					list.CanvasPosition = Vector2.new(0, math.max(0, (i - 2) * 32))

					break

				end

			end

		end

	end



	refresh = function()

		if not alive() then

			auto.close()

			return

		end



		local motors = require("parenting").collectMotors(rig)

		candidates = auto.candidates(rig, motors, ik.getRig(rig), counts)

		if #candidates <= 6 then

			search.Text = ""

		end



		local found = false

		for _, v in candidates do

			if v.motor == selected then

				found = true

			end

		end



		if not found then

			selected = nil

		end



		draw()

	end



	tool.button(

		frame,

		"Refresh",

		"REFRESH",

		UDim2.new(1, -96, 0, 34),

		UDim2.fromOffset(82, 22),

		refresh

	)

	createButton, createLabel = tool.button(

		frame,

		"Create",

		"SELECT A LIMB",

		UDim2.fromOffset(14, 104),

		UDim2.fromOffset(332, 30),



		function()

			if not alive() then

				auto.close()

				return

			end



			if

				not selected

				or state.PhysicsSimulating

				or timeline:IsExportLocked()

				or require("blenderEdit").blocked()

			then

				return

			end



			local previous

			for _, v in candidates do

				if v.motor == selected then

					previous = v

					break

				end

			end



			local owner = selected

			refresh()

			local current

			for _, v in candidates do

				if v.motor == owner then

					current = v

					break

				end

			end



			local same = current and previous and #current.chain == #previous.chain

			if same then

				for i, member in previous.chain do

					if current.chain[i] ~= member then

						same = false

						break

					end

				end

			end



			if not same then

				selected = nil

				show()

				notice.show("AUTO IK", "The rig changed. Select the limb again.", 3)

				return

			end



			if not ik.chain(rig, owner) then

				local created = auto.setup(owner, rig, #current.chain)

				if not created then

					return

				end

			end



			if not ik.isEnabled(owner, timeline:GetState().CurrentTime or 0) then

				timeline:SwitchIKAtCurrentTime(owner, rig)

			end



			refresh()

		end

	)

	createButton:SetAttribute("Primary", true)

	createButton.Size = UDim2.fromOffset(212, 30)



	local function step(delta)

		if not alive() or not selected then

			return

		end



		local item

		for _, v in candidates do

			if v.motor == selected then

				item = v

				break

			end

		end



		if not item or item.configured or ik.chain(rig, selected) then

			return

		end



		local wanted = #item.chain + delta

		if wanted < 1 or wanted > (item.limit or #item.chain) then

			return

		end



		local entry = ik.getRig(rig)

		local chain, message = auto.chain(rig, selected, entry.motors, nil, wanted)

		if not chain then

			notice.show("AUTO IK", message or "This chain can't use that many joints.", 3)

			return

		end



		for _, member in chain do

			if entry.members[member] then

				notice.show("AUTO IK", "A longer chain would overlap another IK limb.", 3)

				return

			end

		end



		counts[selected] = wanted

		refresh()

	end



	fewerButton = tool.button(

		frame,

		"FewerJoints",

		"-",

		UDim2.fromOffset(232, 104),

		UDim2.fromOffset(26, 30),

		function()

			step(-1)

		end

	)

	jointsLabel =

		tool.label(frame, "Joints", "JOINTS", UDim2.fromOffset(260, 104), UDim2.fromOffset(58, 30))

	jointsLabel.TextXAlignment = Enum.TextXAlignment.Center

	jointsLabel.TextWrapped = false

	jointsLabel.TextSize = 11

	moreButton = tool.button(

		frame,

		"MoreJoints",

		"+",

		UDim2.fromOffset(320, 104),

		UDim2.fromOffset(26, 30),

		function()

			step(1)

		end

	)

	table.insert(session.connections, search:GetPropertyChangedSignal("Text"):Connect(draw))

	local elapsed = 0

	table.insert(

		session.connections,

		game:GetService("RunService").Heartbeat:Connect(function(dt)

			elapsed += dt

			if elapsed < 0.2 then

				return

			end



			elapsed = 0

			if not alive() then

				auto.close()

				return

			end



			local motor, owner, objects = selection()

			local changed = #objects ~= #lastObjects

			if not changed then

				for i, object in objects do

					if object ~= lastObjects[i] then

						changed = true

						break

					end

				end

			end



			if changed or motor ~= lastMotor or owner ~= lastRig then

				choose(motor, owner, objects, not changed)

			else

				show()

			end

		end)

	)

	refresh()

	local motor, owner, objects = selection()

	choose(motor, owner, objects, false)

end



function auto.toggle()

	if host then

		auto.close()

	else

		auto.open()

	end

end



function auto.init(options)

	auto.destroy()

	refs = options

	table.insert(

		connections,

		options.ScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()

			if not options.ScreenGui.Enabled then

				auto.close()

			end

		end)

	)

	table.insert(connections, options.ScreenGui.Destroying:Connect(auto.destroy))

	table.insert(connections, options.Plugin.Unloading:Connect(auto.destroy))

end



return auto

]]></ProtectedString>
