						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local Drawer = require(script.Parent.Drawer)
local MeshView = require(script.Parent.MeshView)
local Slider = require(script.Parent.Slider)

local MeshDrawer = Drawer.extend()

MeshDrawer.title = "Mesh"
MeshDrawer.rotateSpeed = math.rad(0.5)
MeshDrawer.wheelStep = 1.15
MeshDrawer.noIdText = "No mesh id"

function MeshDrawer.new(frame: Frame, root: GuiObject, group: { any }, parts)
	local self = setmetatable({}, MeshDrawer)

	Drawer.init(self, frame, root, group, frame.Header.CloseMesh)

	self.catalog = parts.catalog
	self.inserter = parts.inserter
	self.view = MeshView.new(frame.Preview.View)
	self.orbitButton = frame.Preview.OrbitMesh
	self.slider = Slider.new(frame.ZoomTrack)
	self.resetButton = frame.ResetMeshView
	self.titleLabel = frame.Header.Title
	self.nameLabel = frame.MeshName
	self.infoLabel = frame.Info
	self.idBox = frame.MeshId
	self.targetLabel = frame.Target
	self.insertButton = frame.Actions.InsertMesh
	self.entry = nil
	self.rotating = false
	self.lastPoint = Vector2.zero
	self.actions = {}

	self:bind()
	self:syncSlider()

	return self
end

function MeshDrawer:isPressInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

function MeshDrawer:isMoveInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

function MeshDrawer:bind()
	self:connect(self.orbitButton.InputBegan, function(input)
		if self:isPressInput(input) then
			self:beginRotate(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)

	self:connect(self.orbitButton.InputChanged, function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			self:zoomBy(input.Position.Z)
		end
	end)

	self:connect(userInputService.InputChanged, function(input)
		if self.rotating and self:isMoveInput(input) then
			self:rotateTo(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)

	self:connect(userInputService.InputEnded, function(input)
		if self:isPressInput(input) then
			self:endRotate()
		end
	end)

	self.slider:setChangedHandler(function(value)
		self.view:setZoomAlpha(value)
	end)

	self:connect(self.resetButton.Activated, function()
		self:resetView()
	end)

	self:connect(self.insertButton.Activated, function()
		self:run("insert")
	end)

	self:connect(self.idBox.Focused, function()
		self.idBox.SelectionStart = 1
		self.idBox.CursorPosition = #self.idBox.Text + 1
	end)
end

function MeshDrawer:setActions(actions)
	self.actions = actions
end

function MeshDrawer:run(name: string)
	local action = self.actions[name]

	if action and self.entry then
		action(self.entry)
	end
end

function MeshDrawer:getEntry()
	return self.entry
end

function MeshDrawer:getView()
	return self.view
end

function MeshDrawer:getSlider()
	return self.slider
end

function MeshDrawer:isRotating(): boolean
	return self.rotating
end

function MeshDrawer:syncSlider()
	self.slider:setValue(self.view:getZoomAlpha(), true)
end

function MeshDrawer:beginRotate(point: Vector2)
	self.rotating = true
	self.lastPoint = point
end

function MeshDrawer:rotateTo(point: Vector2)
	local delta = point - self.lastPoint
	local speed = MeshDrawer.rotateSpeed

	self.lastPoint = point
	self.view:rotate(-delta.X * speed, delta.Y * speed)
end

function MeshDrawer:endRotate()
	self.rotating = false
end

function MeshDrawer:zoomBy(steps: number)
	self.view:setZoom(self.view:getZoom() * MeshDrawer.wheelStep ^ steps)
	self:syncSlider()
end

function MeshDrawer:resetView()
	self.view:reset()
	self:syncSlider()
end

function MeshDrawer:refreshDetails()
	local entry = self.entry

	if not entry then
		return
	end

	self.titleLabel.Text = MeshDrawer.title
	self.nameLabel.Text = entry.name
	self.infoLabel.Text = self.catalog:describe(entry)
	self.idBox.Text = if entry.meshId ~= "" then entry.meshId else MeshDrawer.noIdText
end

function MeshDrawer:refresh()
	if not self.entry or not self:isOpen() then
		return
	end

	self.targetLabel.Text = self.inserter:getTargetText()
end

function MeshDrawer:open(entry)
	local changed = self.entry ~= entry

	self.entry = entry
	self:show(entry.key)
	self.view:setSource(entry.source)

	if changed then
		self:resetView()
	end

	self:refreshDetails()
	self:refresh()
end

function MeshDrawer:close()
	self.rotating = false
	self.slider:stop()
	self.view:setSource(nil)
	self:hide()
end

function MeshDrawer:destroy()
	self.actions = {}
	Drawer.destroy(self)
	self.slider:destroy()
	self.view:destroy()
	self.entry = nil
end

return MeshDrawer
]]></ProtectedString>
							<string name="ScriptGuid">{128A7745-3B87-4373-952F-CEAB3945744D}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">MeshDrawer</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX5007DE194A8A4306A8671C8CAF2DD253">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)
local MeshView = require(script.Parent.MeshView)

local MeshBrowser = {}
MeshBrowser.__index = MeshBrowser

MeshBrowser.tabName = "Meshes"
MeshBrowser.columns = 4
MeshBrowser.cellWidth = 82
MeshBrowser.cellHeight = 97
MeshBrowser.thumbHeight = 82
MeshBrowser.gap = 4
MeshBrowser.overscanRows = 1
MeshBrowser.fallbackRows = 4
MeshBrowser.maximumLabel = 15
MeshBrowser.ellipsis = "..."
MeshBrowser.allGroups = "All Groups"
MeshBrowser.menuWidth = 160
MeshBrowser.groupMenuHeight = 320
MeshBrowser.tipText = "%s  (%s)"
MeshBrowser.insertText = "Insert"
MeshBrowser.searchText = "Search %d meshes"
MeshBrowser.spinSpeed = math.rad(70)

MeshBrowser.emptyTexts = {
	none = "No meshes match.",
	missing = "No mesh assets were found in the plugin.",
}

function MeshBrowser.new(page: Frame, templates: Instance, context, parts)
	local self = setmetatable({}, MeshBrowser)

	self.page = page
	self.search = page.Search
	self.countLabel = page.Count
	self.groupButton = page.MeshGroup
	self.grid = page.Grid
	self.empty = page.Empty
	self.cellTemplate = templates.MeshCell
	self.context = context
	self.catalog = parts.catalog
	self.inserter = parts.inserter
	self.drawer = parts.drawer
	self.cells = {}
	self.results = {}
	self.connections = {}
	self.group = nil
	self.query = ""
	self.selectedKey = nil
	self.hovered = nil
	self.spin = nil
	self.lastKey = nil
	self.lastClickTime = 0
	self.shown = false
	self.tabActive = false

	self.search.PlaceholderText = string.format(MeshBrowser.searchText, self.catalog:getCount())

	self:bind()
	self:refresh()

	return self
end

function MeshBrowser:connect(signal: RBXScriptSignal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function MeshBrowser:bind()
	self:connect(self.search:GetPropertyChangedSignal("Text"), function()
		local query = string.gsub(self.search.Text, "^%s*(.-)%s*$", "%1")

		if query ~= self.query then
			self.query = query
			self:refresh()
		end
	end)

	self:connect(self.groupButton.Activated, function()
		self:openGroupMenu()
	end)

	self:connect(self.grid:GetPropertyChangedSignal("CanvasPosition"), function()
		self:layout()
	end)

	self:connect(self.grid:GetPropertyChangedSignal("AbsoluteWindowSize"), function()
		self:layout()
	end)

	self.drawer:setActions({
		insert = function(entry)
			self:insert(entry)
		end,
	})
end

function MeshBrowser:getResults()
	return self.results
end

function MeshBrowser:getSelected()
	return if self.selectedKey then self.catalog:get(self.selectedKey) else nil
end

function MeshBrowser:setGroup(group: string?)
	if self.group == group then
		return
	end

	self.group = group
	self:refresh()
end

function MeshBrowser:setQuery(query: string)
	self.search.Text = query
end

function MeshBrowser:openGroupMenu()
	local items = {
		{
			text = MeshBrowser.allGroups,
			checked = self.group == nil,
			callback = function()
				self:setGroup(nil)
			end,
		},
		{ separator = true },
	}

	for _, group in self.catalog:getGroups() do
		table.insert(items, {
			text = group,
			checked = self.group == group,
			callback = function()
				self:setGroup(group)
			end,
		})
	end

	self.context.menu:toggle({
		anchor = self.groupButton,
		items = items,
		width = MeshBrowser.menuWidth,
		maximumHeight = MeshBrowser.groupMenuHeight,
		search = false,
	})
end

function MeshBrowser:openContextMenu(entry)
	self.context.menu:open({
		position = userInputService:GetMouseLocation(),
		width = MeshBrowser.menuWidth,
		search = false,
		items = {
			{
				text = MeshBrowser.insertText,
				callback = function()
					self:insert(entry)
				end,
			},
			{ separator = true },
			{
				text = "Show " .. entry.group,
				callback = function()
					self:setGroup(entry.group)
				end,
			},
		},
	})
end

function MeshBrowser:getEmptyText(): string
	local texts = MeshBrowser.emptyTexts

	return if self.catalog:getCount() == 0 then texts.missing else texts.none
end

function MeshBrowser:refresh()
	self.results = self.catalog:filter({
		group = self.group,
		tokens = self.catalog:tokenize(self.query),
	})

	local rows = math.ceil(#self.results / self:getColumns())
	local height = math.max(0, rows * (self:getCellWidth() + 15 + MeshBrowser.gap) - MeshBrowser.gap)

	self.groupButton.Label.Text = self.group or MeshBrowser.allGroups
	self.countLabel.Text = tostring(#self.results)
	self.empty.Text = self:getEmptyText()
	self.empty.Visible = #self.results == 0
	self.grid.CanvasSize = UDim2.fromOffset(0, height)
	self.grid.CanvasPosition = Vector2.zero
	self:layout()
end

function MeshBrowser:getLabel(entry): string
	local limit = MeshBrowser.maximumLabel

	if #entry.name <= limit then
		return entry.name
	end

	if entry.number <= 0 then
		local start = string.gsub(string.sub(entry.name, 1, limit - 1), "%s+$", "")

		return start .. MeshBrowser.ellipsis
	end

	local suffix = " " .. entry.number
	local head = string.gsub(string.sub(entry.base, 1, math.max(1, limit - #suffix - 1)), "%s+$", "")

	return head .. MeshBrowser.ellipsis .. suffix
end

function MeshBrowser:createCell()
	local button = self.cellTemplate:Clone()
	local cell = {
		button = button,
		view = MeshView.new(button.Thumb.View),
		entry = nil,
		connections = {},
	}

	button.Visible = false
	button.Parent = self.grid

	table.insert(cell.connections, button.Activated:Connect(function()
		self:onActivated(cell)
	end))

	table.insert(cell.connections, button.MouseButton2Click:Connect(function()
		if cell.entry then
			self:select(cell.entry, false)
			self:openContextMenu(cell.entry)
		end
	end))

	table.insert(cell.connections, button.MouseEnter:Connect(function()
		self:setHovered(cell)
	end))

	table.insert(cell.connections, button.MouseLeave:Connect(function()
		if self.hovered == cell then
			self:setHovered(nil)
		end
	end))

	table.insert(self.cells, cell)

	return cell
end

function MeshBrowser:getCellWidth(): number
	local columns = self:getColumns()
	return math.max(1, (self.grid.AbsoluteWindowSize.X / math.max(self.context.getScale(), 0.001) - MeshBrowser.gap * (columns - 1)) / columns)
end

function MeshBrowser:getColumns(): number
	local width = self.grid.AbsoluteWindowSize.X / math.max(self.context.getScale(), 0.001)
	return math.clamp(math.floor((width + MeshBrowser.gap) / (MeshBrowser.cellWidth + MeshBrowser.gap)), 1, MeshBrowser.columns)
end

function MeshBrowser:getVisibleRows(): number
	local scale = self.context.getScale()
	local view = self.grid.AbsoluteWindowSize.Y / scale

	if view <= 0 then
		return MeshBrowser.fallbackRows
	end

	return math.ceil(view / (self:getCellWidth() + 15 + MeshBrowser.gap)) + MeshBrowser.overscanRows
end

function MeshBrowser:ensureCells(count: number)
	while #self.cells < count do
		self:createCell()
	end
end

function MeshBrowser:styleCell(cell)
	local entry = cell.entry
	local button = cell.button

	if not entry then
		return
	end

	button.SelectedOutline.Visible = entry.key == self.selectedKey
	button.HoverOutline.Visible = self.hovered == cell and entry.key ~= self.selectedKey
end

function MeshBrowser:isActive(): boolean
	return self.shown and self.tabActive
end

function MeshBrowser:assign(cell, entry, index: number)
	local button = cell.button
	local columns = self:getColumns()
	local width = self:getCellWidth()
	button.Size = UDim2.fromOffset(width, width + 15)
	for _, name in { "Thumb", "HoverOutline", "SelectedOutline" } do
		local thumb = button:FindFirstChild(name)
		if thumb then thumb.Size = UDim2.fromOffset(width, width) end
	end
	button.Label.Position = UDim2.fromOffset(0, width + 1)
	local column = (index - 1) % columns
	local row = math.floor((index - 1) / columns)

	button.Position = UDim2.fromOffset(
		column * (width + MeshBrowser.gap),
		row * (self:getCellWidth() + 15 + MeshBrowser.gap)
	)

	if cell.entry ~= entry then
		cell.entry = entry
		cell.view:setSource(entry.source)
		cell.view:reset()
		button.Label.Text = self:getLabel(entry)

		if self.hovered == cell then
			self:showHover(cell)
		end
	end

	self:styleCell(cell)
	button.Visible = true
end

function MeshBrowser:release(cell)
	if not cell.button.Visible and not cell.entry then
		return
	end

	if self.hovered == cell then
		self:setHovered(nil)
	end

	cell.button.Visible = false
	cell.entry = nil
	cell.view:setSource(nil)
end

function MeshBrowser:releaseAll()
	for _, cell in self.cells do
		self:release(cell)
	end
end

function MeshBrowser:layout()
	if not self:isActive() then
		self:releaseAll()
		return
	end

	local columns = self:getColumns()
	local stride = self:getCellWidth() + 15 + MeshBrowser.gap
	local height = math.max(0, math.ceil(#self.results / columns) * stride - MeshBrowser.gap)
	local canvas = UDim2.fromOffset(0, height)
	if self.grid.CanvasSize ~= canvas then
		self.grid.CanvasSize = canvas
	end
	local scale = self.context.getScale()
	local visibleRows = self:getVisibleRows()
	local scroll = self.grid.CanvasPosition.Y / scale
	local firstRow = math.max(0, math.floor(scroll / stride))
	local first = firstRow * columns + 1
	local last = math.min(#self.results, (firstRow + visibleRows) * columns)

	self:ensureCells(visibleRows * columns)

	local pool = #self.cells
	local used = {}

	for index = first, last do
		local cell = self.cells[(index - 1) % pool + 1]

		used[cell] = true
		self:assign(cell, self.results[index], index)
	end

	for _, cell in self.cells do
		if not used[cell] then
			self:release(cell)
		end
	end
end

function MeshBrowser:restyle()
	for _, cell in self.cells do
		self:styleCell(cell)
	end
end

function MeshBrowser:showHover(cell)
	local entry = cell.entry
	local hover = self.context.hover

	if entry and hover then
		hover:showText(cell.button, string.format(MeshBrowser.tipText, entry.name, entry.location))
	end
end

function MeshBrowser:isSpinning(): boolean
	return self.spin ~= nil
end

function MeshBrowser:updateSpin()
	local needed = self.hovered ~= nil

	if needed and not self.spin then
		self.spin = runService.Heartbeat:Connect(function(delta)
			local cell = self.hovered

			if cell and cell.entry then
				cell.view:rotate(MeshBrowser.spinSpeed * delta, 0)
			end
		end)
	elseif not needed and self.spin then
		self.spin:Disconnect()
		self.spin = nil
	end
end

function MeshBrowser:setHovered(cell)
	local previous = self.hovered
	local hover = self.context.hover

	if previous == cell then
		return
	end

	self.hovered = cell

	if previous then
		previous.view:reset()
		self:styleCell(previous)

		if hover and hover.current == previous.button then
			hover:hide()
		end
	end

	if cell then
		self:showHover(cell)
		self:styleCell(cell)
	end

	self:updateSpin()
end

function MeshBrowser:select(entry, openDrawer: boolean?)
	self.selectedKey = entry.key
	self:restyle()

	if openDrawer ~= false or self.drawer:isOpen() then
		self.drawer:open(entry)
	end
end

function MeshBrowser:onActivated(cell)
	local entry = cell.entry

	if not entry then
		return
	end

	local now = os.clock()
	local isDouble = self.lastKey == entry.key and now - self.lastClickTime <= configuration.Create.doubleClickTime

	self.lastKey = entry.key
	self.lastClickTime = if isDouble then 0 else now
	self:select(entry)

	if isDouble then
		self:insert(entry)
	end
end

function MeshBrowser:insert(entry): { Instance }
	return self.inserter:insert(entry)
end

function MeshBrowser:onSelectionChanged()
	self.drawer:refresh()
end

function MeshBrowser:onTabChanged(name: string)
	self.tabActive = name == MeshBrowser.tabName

	if not self.tabActive then
		self:setHovered(nil)
		self.drawer:close()
	end

	self:layout()
end

function MeshBrowser:start()
	self.shown = true
	self:layout()
end

function MeshBrowser:stop()
	self.shown = false
	self:setHovered(nil)
	self:layout()
end

function MeshBrowser:destroy()
	self:stop()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)

	for _, cell in self.cells do
		for _, connection in cell.connections do
			connection:Disconnect()
		end

		cell.view:destroy()
		cell.button:Destroy()
	end

	table.clear(self.cells)
	table.clear(self.results)
end

return MeshBrowser
]]></ProtectedString>
