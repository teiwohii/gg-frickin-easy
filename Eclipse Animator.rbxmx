					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local tree = require("rigTraversal")
local nestedParts = {}

function nestedParts.attach(rig)
	if typeof(rig) ~= "Instance" or not rig:IsA("Model") then
		return 0
	end
	local objects = tree.rigDescendants(rig)
	local parents, parts, incoming, blocked = {}, {}, {}, {}
	for _, object in objects do
		if object:IsA("BasePart") then
			parents[object] = object
			table.insert(parts, object)
		end
	end
	local function root(part)
		local value = parents[part]
		if not value then
			return nil
		end
		while parents[value] ~= value do
			value = parents[value]
		end
		while parents[part] ~= value do
			local nextPart = parents[part]
			parents[part] = value
			part = nextPart
		end
		return value
	end
	local seen = {}
	local function joint(object)
		if seen[object] then
			return
		end
		seen[object] = true
		local a, b
		if object:IsA("NoCollisionConstraint") then
			return
		end
		if object:IsA("JointInstance") or object:IsA("WeldConstraint") then
			a, b = object.Part0, object.Part1
		elseif object:IsA("Constraint") then
			local aa, ab = object.Attachment0, object.Attachment1
			a = aa and aa:FindFirstAncestorWhichIsA("BasePart")
			b = ab and ab:FindFirstAncestorWhichIsA("BasePart")
		else
			return
		end
		local ra, rb = root(a), root(b)
		if ra and rb then
			parents[rb] = ra
			if object:IsA("Motor6D") or object:IsA("AnimationConstraint") then
				incoming[b] = true
			end
		else
			if ra then
				blocked[a] = true
			end
			if rb then
				blocked[b] = true
			end
		end
	end
	for _, object in objects do
		joint(object)
	end
	for _, part in parts do
		for _, object in require("rigTraversal").joints(part) do
			joint(object)
		end
	end
	local groups = {}
	for _, part in parts do
		local id = root(part)
		groups[id] = groups[id] or {}
		table.insert(groups[id], part)
	end
	local created = 0
	for id, members in groups do
		local owner, candidate, depth
		local eligible = true
		for _, part in members do
			if blocked[part] or part:GetAttribute("EclipseArmatureSkinningHelper") then
				eligible = false
				break
			end
			local ancestor, distance = part.Parent, 0
			while ancestor and ancestor ~= rig do
				distance += 1
				if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
					eligible = false
					break
				end
				if ancestor:IsA("BasePart") and root(ancestor) ~= id then
					break
				end
				ancestor = ancestor.Parent
			end
			if not eligible or not ancestor or ancestor == rig or not parents[ancestor] then
				eligible = false
				break
			end
			if owner and owner ~= ancestor then
				eligible = false
				break
			end
			owner = ancestor
			if not incoming[part] and (not depth or distance < depth) then
				candidate, depth = part, distance
			end
		end
		if eligible and owner and candidate then
			local weld = Instance.new("Weld")
			weld.Name = "EclipseNestedPartWeld"
			weld.Part0, weld.Part1 = owner, candidate
			weld.C0 = owner.CFrame:ToObjectSpace(candidate.CFrame)
			weld:SetAttribute("EclipseNestedPartWeld", true)
			weld.Parent = candidate
			created += 1
		end
	end
	return created
end

return nestedParts
]]></ProtectedString>
