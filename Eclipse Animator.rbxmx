						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local MeshScrub = {}
MeshScrub.__index = MeshScrub

function MeshScrub.new()
	return setmetatable({
		rests = {},
		active = false,
	}, MeshScrub)
end

function MeshScrub:meshParticle()
	local ok, emit = pcall(require, "eclipseEmit")
	return ok and emit and emit.MeshParticle or nil
end

function MeshScrub:update(entries)
	local meshParticle = self:meshParticle()

	if not meshParticle then
		return
	end

	local wanted = {}

	for _, entry in entries do
		local source = entry.source

		if source.Parent and meshParticle.isMeshParticle(source) then
			local rest = self.rests[source]
			local settings = meshParticle.settings(source)
			local alive = meshParticle.alive(source, entry.elapsed, settings, rest and rest.size or source.Size)

			for _, spawn in alive do
				local current = wanted[source]

				if not current or spawn.age < current.spawn.age then
					wanted[source] = { settings = settings, spawn = spawn }
				end
			end
		end
	end

	for source in table.clone(self.rests) do
		if not wanted[source] then
			self.rests[source] = nil
			meshParticle.release(source, self)
		end
	end

	local camera = workspace.CurrentCamera

	for source, data in wanted do
		local rest = self.rests[source]

		if not rest then
			rest = meshParticle.acquire(source, self)
			self.rests[source] = rest
		end

		meshParticle.adopt(source, rest)
		meshParticle.applyTo(
			source,
			rest,
			meshParticle.state(data.settings, data.spawn.variant, data.spawn.age, rest.cframe, rest.cframe, rest.size, camera)
		)
	end

	self.active = next(self.rests) ~= nil
end

function MeshScrub:refresh() end

function MeshScrub:clear()
	self:update({})
end

function MeshScrub:destroy()
	self:clear()
end

return MeshScrub
]]></ProtectedString>
