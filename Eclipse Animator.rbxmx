							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local colorOps = require(script.Parent.Parent.colorOps)
local sequenceTools = require(script.Parent.Parent.sequenceTools)
local spatial = require(script.Parent.Parent.spatial)
local Tool = require(script.Parent.Tool)

local RandomizeTool = Tool.extend()

RandomizeTool.id = "Randomize"
RandomizeTool.title = "Randomize"
RandomizeTool.keywords = "random variation jitter seed scatter"
RandomizeTool.maximumSeed = 9999

function RandomizeTool.new(context)
	local self = setmetatable({}, RandomizeTool)

	Tool.init(self, context, {
		Position = Vector3.zero,
		Rotation = Vector3.zero,
		Scale = 0,
		Hue = 0,
		Brightness = 0,
		Transparency = 0,
		Emission = 0,
		Delay = 0,
		Seed = 1,
	})

	return self
end

function RandomizeTool:getFields()
	local share = { minimum = 0, maximum = 1, clamp = true, range = { min = 0, max = 1 } }

	local function shared(tip: string)
		local options = table.clone(share)

		options.tip = tip

		return options
	end

	return {
		self:field("Position", "Position", "vector3", { tip = "Each object moves by up to this many studs either way on each axis." }),
		self:field("Rotation", "Rotation", "vector3", { tip = "Each object turns by up to this many degrees either way on each axis." }),
		self:field("Scale", "Scale", "number", shared("0.2 makes each object up to 20% bigger or smaller.")),
		self:field("Hue", "Hue", "number", shared("How far the colour can drift. 1 is the whole colour wheel.")),
		self:field("Brightness", "Brightness", "number", shared("How much lighter or darker the colour can get.")),
		self:field("Transparency", "Transparency", "number", shared("How much more or less see-through each object can get.")),
		self:field("Emission", "Emission", "number", shared("Varies emitter rate, speed, lifetime and emit count. 0.3 is up to 30% either way.")),
		self:field("Delay", "Emit Delay", "number", { minimum = 0, range = { min = 0, max = 2 }, tip = "Gives each emitter a random emit delay up to this many seconds." }),
		self:field("Seed", "Seed", "number", { integer = true, minimum = 1, range = { min = 1, max = 100 }, tip = "The same seed always gives the same result." }),
		self:action("Apply", "Randomize Selection", function()
			self:apply()
		end, nil, true),
		self:action("Reseed", "New Seed", function()
			self.params.Seed = Random.new():NextInteger(1, RandomizeTool.maximumSeed)
			self.context.refreshTools()
		end),
	}
end

function RandomizeTool:jitter(random: Random, amount: number): number
	return if amount > 0 then random:NextNumber(-amount, amount) else 0
end

function RandomizeTool:jitterVector(random: Random, amount: Vector3): Vector3
	return Vector3.new(self:jitter(random, amount.X), self:jitter(random, amount.Y), self:jitter(random, amount.Z))
end

function RandomizeTool:shiftSequence(sequence: NumberSequence, delta: number): NumberSequence
	local points = sequenceTools.toPoints(sequence)

	for _, point in points do
		point.value = math.clamp(point.value + delta, 0, 1)
	end

	return sequenceTools.fromPoints(points)
end

function RandomizeTool:scaleRange(range: NumberRange, factor: number): NumberRange
	return NumberRange.new(range.Min * factor, range.Max * factor)
end

function RandomizeTool:applySpatial(root: Instance, random: Random)
	local params = self.params
	local pivot = spatial.getPivot(root)

	if not pivot then
		return
	end

	local move = self:jitterVector(random, params.Position)
	local turn = self:jitterVector(random, params.Rotation)
	local target = (pivot * CFrame.fromOrientation(math.rad(turn.X), math.rad(turn.Y), math.rad(turn.Z))) + move

	spatial.setPivot(root, target)
	spatial.scale(root, 1 + self:jitter(random, params.Scale), target.Position)
end

function RandomizeTool:applyLook(instance: Instance, random: Random)
	local params = self.params

	if params.Hue > 0 or params.Brightness > 0 then
		local hue = self:jitter(random, params.Hue * 0.5)
		local value = self:jitter(random, params.Brightness)

		colorOps.apply(instance, function(color)
			return colorOps.shift(color, hue, value)
		end)
	end

	if params.Transparency > 0 then
		local delta = self:jitter(random, params.Transparency)

		if instance:IsA("BasePart") then
			if instance.Transparency < 1 then
				instance.Transparency = math.clamp(instance.Transparency + delta, 0, 1)
			end
		elseif instance:IsA("Decal") then
			instance.Transparency = math.clamp(instance.Transparency + delta, 0, 1)
		elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") then
			local target = instance :: any

			target.Transparency = self:shiftSequence(target.Transparency, delta)
		end
	end

	if not instance:IsA("ParticleEmitter") then
		return
	end

	if params.Emission > 0 then
		instance.Rate *= 1 + self:jitter(random, params.Emission)
		instance.Speed = self:scaleRange(instance.Speed, 1 + self:jitter(random, params.Emission))
		instance.Lifetime = self:scaleRange(instance.Lifetime, 1 + self:jitter(random, params.Emission))

		local count = instance:GetAttribute("EmitCount")

		if typeof(count) == "number" then
			instance:SetAttribute("EmitCount", math.max(math.round(count * (1 + self:jitter(random, params.Emission))), 1))
		end
	end

	if params.Delay > 0 then
		instance:SetAttribute("EmitDelay", math.round(random:NextNumber(0, params.Delay) * 1000) / 1000)
	end
end

function RandomizeTool:apply()
	local roots = self:requireRoots(false)

	if not roots then
		return
	end

	local random = Random.new(math.floor(self.params.Seed))

	self:run("Randomize", function()
		for _, root in spatial.filter(roots) do
			self:applySpatial(root, random)
		end

		for _, instance in self:getAffected() do
			self:applyLook(instance, random)
		end
	end)
end

return RandomizeTool
]]></ProtectedString>
								<string name="ScriptGuid">{B38C4416-2AD8-4FEC-8F32-F61E20B69625}</string>
