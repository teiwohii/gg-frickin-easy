							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local partPhysics = require(script.Parent.Parent.Utility.partPhysics)
local PresetLibraryKind = require(script.Parent.PresetLibraryKind)

local PresetCatalog = {}
PresetCatalog.__index = PresetCatalog

PresetCatalog.folderName = "Presets"
PresetCatalog.idPrefix = "builtin/"
PresetCatalog.effectClasses = { "ParticleEmitter", "Beam", "Trail", "Light", "Sound" }

function PresetCatalog.new(assets: Instance?)
	local self = setmetatable({}, PresetCatalog)

	self.folder = if assets then assets:FindFirstChild(PresetCatalog.folderName) else nil
	self.items = nil

	return self
end

function PresetCatalog:formatName(name: string): string
	local spaced = string.gsub(name, "(%l)(%u)", "%1 %2")

	return spaced
end

function PresetCatalog:getSources(preset: Instance): { Instance }
	if preset:IsA("Folder") then
		return preset:GetChildren()
	end

	return { preset }
end

function PresetCatalog:countEffects(preset: Instance): number
	local count = 0

	for _, descendant in preset:GetDescendants() do
		for _, className in PresetCatalog.effectClasses do
			if descendant:IsA(className) then
				count += 1
				break
			end
		end
	end

	return math.max(count, 1)
end

function PresetCatalog:sorted(children: { Instance }): { Instance }
	table.sort(children, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	return children
end

function PresetCatalog:getItems()
	if self.items then
		return self.items
	end

	local items = {}

	if self.folder then
		for _, category in self:sorted(self.folder:GetChildren()) do
			if category:IsA("Folder") then
				for _, preset in self:sorted(category:GetChildren()) do
					local sources = self:getSources(preset)

					if #sources > 0 then
						table.insert(items, {
							id = PresetCatalog.idPrefix .. category.Name .. "/" .. preset.Name,
							name = self:formatName(preset.Name),
							kind = PresetLibraryKind.id,
							category = self:formatName(category.Name),
							icon = sources[1].ClassName,
							count = self:countEffects(preset),
							builtIn = true,
							source = preset,
						})
					end
				end
			end
		end
	end

	self.items = items

	return items
end

function PresetCatalog:getCategories(): { string }
	local categories = {}

	for _, item in self:getItems() do
		if not table.find(categories, item.category) then
			table.insert(categories, item.category)
		end
	end

	return categories
end

function PresetCatalog:build(item, placement: CFrame): { Instance }
	local roots = {}
	local origin = nil

	for _, source in self:getSources(item.source) do
		local clone = source:Clone()

		partPhysics.applyAll(clone)

		if clone:IsA("PVInstance") then
			local pivot = clone:GetPivot()

			origin = origin or pivot
			clone:PivotTo(placement * origin:ToObjectSpace(pivot))
		end

		table.insert(roots, clone)
	end

	return roots
end

return PresetCatalog
]]></ProtectedString>
