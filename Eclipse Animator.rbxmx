							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local Drawer = require(script.Parent.Drawer)
local flipbookTiming = require(script.Parent.flipbookTiming)

local FlipbookViewer = Drawer.extend()

FlipbookViewer.watched = { "Texture", "FlipbookLayout", "FlipbookFramerate", "FlipbookMode", "Lifetime", "Name" }
FlipbookViewer.rateText = "%d fps"
FlipbookViewer.stillText = "still frames"
FlipbookViewer.playText = "Play"
FlipbookViewer.pauseText = "Pause"
FlipbookViewer.noLayoutText = "Layout: None"

function FlipbookViewer.new(frame: Frame, root: GuiObject, templates: Instance, group: { any })
	local self = setmetatable({}, FlipbookViewer)

	Drawer.init(self, frame, root, group, frame.Header.CloseFlipbook)

	self.templates = templates
	self.sheet = frame.Sheet
	self.cell = frame.Cell
	self.info = frame.Info
	self.playButton = frame.Controls.PlayFlipbook
	self.hint = frame.Controls.Hint
	self.lines = {}
	self.emitter = nil
	self.grid = 1
	self.frameIndex = 0
	self.direction = 1
	self.playing = true
	self.elapsed = 0
	self.heartbeat = nil
	self.emitterConnections = {}

	self:bind()

	return self
end

function FlipbookViewer:bind()
	local controls = self.frame.Controls

	self:connect(self.playButton.Activated, function()
		self:setPlaying(not self.playing)
	end)

	self:connect(controls.StepBack.Activated, function()
		self:setPlaying(false)
		self:step(-1)
	end)

	self:connect(controls.StepForward.Activated, function()
		self:setPlaying(false)
		self:step(1)
	end)
end

function FlipbookViewer:getFrameCount(): number
	return self.grid * self.grid
end

function FlipbookViewer:getEmitterRate(): number
	return if self.emitter then flipbookTiming.getEmitterRate(self.emitter) else 0
end

function FlipbookViewer:getRate(): number
	return flipbookTiming.getPreviewRate(self:getEmitterRate())
end

function FlipbookViewer:getRateText(): string
	local rate = self:getEmitterRate()

	if rate <= 0 then
		return FlipbookViewer.stillText
	end

	return string.format(FlipbookViewer.rateText, math.max(1, math.round(rate)))
end

function FlipbookViewer:setPlaying(playing: boolean)
	self.playing = playing
	self.playButton.Label.Text = if playing then FlipbookViewer.pauseText else FlipbookViewer.playText
	self:updateHeartbeat()
end

function FlipbookViewer:updateHeartbeat()
	local needed = self:isOpen() and self.playing and self:getFrameCount() > 1

	if needed and not self.heartbeat then
		self.elapsed = 0

		self.heartbeat = runService.Heartbeat:Connect(function(delta)
			self:advance(delta)
		end)
	elseif not needed and self.heartbeat then
		self.heartbeat:Disconnect()
		self.heartbeat = nil
	end
end

function FlipbookViewer:advance(delta: number)
	local emitter = self.emitter

	if not emitter or not emitter.Parent then
		self:close()
		return
	end

	self.elapsed += delta

	local interval = 1 / self:getRate()

	if self.elapsed < interval then
		return
	end

	local steps = math.min(math.floor(self.elapsed / interval), self:getFrameCount())

	self.elapsed %= interval
	self:step(steps)
end

function FlipbookViewer:step(amount: number)
	local count = self:getFrameCount()
	local emitter = self.emitter

	if count <= 1 or not emitter then
		self.frameIndex = 0
		self:render()
		return
	end

	local mode = emitter.FlipbookMode

	if mode == Enum.ParticleFlipbookMode.Random and self.playing then
		self.frameIndex = math.random(0, count - 1)
	elseif mode == Enum.ParticleFlipbookMode.PingPong and self.playing then
		for _ = 1, math.abs(amount) do
			local nextIndex = self.frameIndex + self.direction

			if nextIndex >= count or nextIndex < 0 then
				self.direction = -self.direction
				nextIndex = self.frameIndex + self.direction
			end

			self.frameIndex = math.clamp(nextIndex, 0, count - 1)
		end
	else
		self.frameIndex = (self.frameIndex + amount) % count
	end

	self:render()
end

function FlipbookViewer:buildLines()
	for _, line in self.lines do
		line:Destroy()
	end

	table.clear(self.lines)

	for index = 1, self.grid - 1 do
		local horizontal = self.templates.GridLine:Clone()

		horizontal.Position = UDim2.fromScale(0, index / self.grid)
		horizontal.Size = UDim2.new(1, 0, 0, 1)
		horizontal.Parent = self.sheet.Lines
		table.insert(self.lines, horizontal)

		local vertical = self.templates.GridLine:Clone()

		vertical.Position = UDim2.fromScale(index / self.grid, 0)
		vertical.Size = UDim2.new(0, 1, 1, 0)
		vertical.Parent = self.sheet.Lines
		table.insert(self.lines, vertical)
	end
end

function FlipbookViewer:render()
	local emitter = self.emitter

	if not emitter then
		return
	end

	local grid = self.grid
	local count = self:getFrameCount()
	local index = math.clamp(self.frameIndex, 0, count - 1)
	local column = index % grid
	local row = math.floor(index / grid)
	local cellImage = self.cell.Image

	self.sheet.Image.Image = emitter.Texture
	self.sheet.Cursor.Visible = grid > 1
	self.sheet.Cursor.Position = UDim2.fromScale(column / grid, row / grid)
	self.sheet.Cursor.Size = UDim2.fromScale(1 / grid, 1 / grid)
	cellImage.Image = emitter.Texture
	cellImage.Size = UDim2.fromScale(grid, grid)
	cellImage.Position = UDim2.fromScale(-column, -row)

	if grid > 1 then
		self.info.Text = string.format("Frame %d / %d   %s", index + 1, count, self:getRateText())
		self.hint.Text = emitter.FlipbookMode.Name
	else
		self.info.Text = "Single image"
		self.hint.Text = FlipbookViewer.noLayoutText
	end
end

function FlipbookViewer:refresh()
	local emitter = self.emitter

	if not emitter then
		return
	end

	local grid = flipbookTiming.getGrid(emitter.FlipbookLayout)

	if grid ~= self.grid then
		self.grid = grid
		self.frameIndex = 0
		self.direction = 1
		self:buildLines()
	end

	self.frame.Header.Title.Text = "Flipbook: " .. emitter.Name
	self:render()
	self:updateHeartbeat()
end

function FlipbookViewer:unwatch()
	for _, connection in self.emitterConnections do
		connection:Disconnect()
	end

	table.clear(self.emitterConnections)
end

function FlipbookViewer:open(options)
	local emitter = options.emitter

	self:unwatch()
	self:show(options.owner)

	self.emitter = emitter
	self.grid = 0
	self.playing = true
	self.playButton.Label.Text = FlipbookViewer.pauseText

	for _, name in FlipbookViewer.watched do
		table.insert(self.emitterConnections, emitter:GetPropertyChangedSignal(name):Connect(function()
			self:refresh()
		end))
	end

	self:refresh()
end

function FlipbookViewer:toggle(options)
	if self:isOpen() and self.owner == options.owner then
		self:close()
		return
	end

	self:open(options)
end

function FlipbookViewer:close()
	self:unwatch()
	self.emitter = nil
	self:hide()
	self:updateHeartbeat()
end

function FlipbookViewer:destroy()
	for _, line in self.lines do
		line:Destroy()
	end

	table.clear(self.lines)
	Drawer.destroy(self)
end

return FlipbookViewer
]]></ProtectedString>
							<string name="ScriptGuid">{2050BD8A-20B4-4129-BCB3-30C04607F325}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">FlipbookViewer</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX2B2E38E657714F0A96D3D96E7DAE0C53">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local meshFlipbook = require(script.Parent.Parent.Animation.meshFlipbook)
local FlipbookClock = require(script.Parent.Parent.Animation.FlipbookClock)
local FlipbookImporter = require(script.Parent.FlipbookImporter)

local MeshFlipbooks = {}
MeshFlipbooks.__index = MeshFlipbooks

MeshFlipbooks.sectionTitle = "Mesh Flipbook"
MeshFlipbooks.playbackTitle = "Flipbook Playback"
MeshFlipbooks.previewLoops = 3
MeshFlipbooks.customLayout = "Custom"
MeshFlipbooks.forgeFramesAttribute = "FlipbookTextures"
MeshFlipbooks.forgeDurationAttribute = "Flipbook_Change_Duration"
MeshFlipbooks.forgeIdSize = 8

MeshFlipbooks.layouts = {
	{ label = "1 x 1", columns = 1, rows = 1 },
	{ label = "2 x 2", columns = 2, rows = 2 },
	{ label = "4 x 4", columns = 4, rows = 4 },
	{ label = "8 x 8", columns = 8, rows = 8 },
}

MeshFlipbooks.sourceOptions = {
	{ value = "Sheet", label = "Sprite Sheet" },
	{ value = "Frames", label = "Image Frames" },
}

MeshFlipbooks.loopOptions = {
	{ value = "Once", label = "Once" },
	{ value = "Loop", label = "Loop" },
	{ value = "PingPong", label = "Ping Pong" },
}

MeshFlipbooks.idleOptions = {
	{ value = "Hide", label = "Hidden" },
	{ value = "First", label = "First Frame" },
	{ value = "Last", label = "Last Frame" },
}

MeshFlipbooks.tips = {
	source = "Sprite Sheet plays one image that holds every frame in a grid. Image Frames swaps between separate images, one per frame.",
	image = "The sprite sheet. Every frame sits in a grid, read left to right, top to bottom.",
	layout = "How many columns and rows the sheet has.",
	count = "How many cells of the sheet are real frames. Lower it when the last cells are empty.",
	ids = "The image id of every frame, in order. Paste a list in any format, ids are picked out of it.",
	siblings = "Use the other decals on this part as the frames, in the order of the numbers in their names, and remove them.",
	forge = "Use the frames VFX Forge stored on this decal.",
	fps = "Frames shown per second.",
	loop = "Once plays through and stops. Loop starts over. Ping Pong plays forward, then back.",
	idle = "What the decal shows on the timeline while the flipbook is not playing.",
	reverse = "Play the frames from last to first.",
	frame = "Drag to look through the frames. This only changes what you see right now.",
	play = "Play the flipbook in the viewport.",
	remove = "Turn this back into a normal decal.",
	sheet = "Set this decal up to play a sprite sheet.",
	frames = "Set this decal up to swap between separate images.",
	import = "Pick image files from your computer. After you confirm, they are uploaded to your Roblox account and used as the frames, in file name order.",
}

MeshFlipbooks.messages = {
	setup = "Play an image sequence on this decal. Use a sprite sheet on mesh parts and plain parts, or separate images anywhere.",
	specialMesh = "Sprite sheets do not show on a Special Mesh. Switch Source to Image Frames, or put the decal on a Mesh Part.",
	noSiblings = "There are no other image decals on this part to use as frames.",
	noFrames = "This flipbook has no frames yet.",
	animate = "In the Animator, select this decal and press Emit to play it on the timeline.",
}

function MeshFlipbooks.new(context)
	local self = setmetatable({}, MeshFlipbooks)

	self.context = context
	self.history = context.history
	self.clock = FlipbookClock.new()
	self.events = {}
	self.started = 0
	self.token = 0
	self.editing = false
	self.previewFrames = setmetatable({}, { __mode = "k" })
	self.importer = FlipbookImporter.new(context)

	self.clock:setTargetProvider(function()
		return os.clock() - self.started
	end)

	self.clock:setEventsProvider(function()
		return self.events
	end)

	return self
end

function MeshFlipbooks:handles(instance: Instance): boolean
	return meshFlipbook.isHost(instance)
end

function MeshFlipbooks:hidesProperty(instance: Instance, name: string): boolean
	return meshFlipbook.owns(instance, name)
end

function MeshFlipbooks:getSignature(instance: Instance): string
	local config = meshFlipbook.read(instance)

	if not config then
		return ""
	end

	return config.source .. ":" .. #config.ids .. ":" .. (config.ids[1] or "")
end

function MeshFlipbooks:getConfigured(targets: { Instance }): { Instance }
	local configured = {}

	for _, target in targets do
		if target.Parent and meshFlipbook.has(target) then
			table.insert(configured, target)
		end
	end

	return configured
end

function MeshFlipbooks:finishEdit()
	if self.editing then
		self.editing = false
		self.history:finish()
	end
end

function MeshFlipbooks:change(targets: { Instance }, mutate, final: boolean)
	self:stopPlayback()

	if not self.editing then
		self.editing = true
		self.history:begin("Edit Mesh Flipbook")
	end

	for _, target in self:getConfigured(targets) do
		local copy = meshFlipbook.copy(meshFlipbook.read(target))

		mutate(copy, target)
		meshFlipbook.write(target, copy)
		self.previewFrames[target] = nil
		meshFlipbook.applyRest(target)
	end

	if final then
		self:finishEdit()
	end
end

function MeshFlipbooks:initialize(target: Instance, overrides)
	local decal = target :: Decal
	local data = table.clone(overrides or {})

	if data.image == nil then
		data.image = decal.Texture
	end

	if data.source == "Frames" and data.ids == nil then
		data.ids = { meshFlipbook.toId(decal.Texture) }
	end

	meshFlipbook.write(target, data)
	meshFlipbook.applyRest(target)
end

function MeshFlipbooks:setUp(targets: { Instance }, source: string)
	self.history:run("Set Up Mesh Flipbook", function()
		for _, target in targets do
			if target.Parent and meshFlipbook.isHost(target) and not meshFlipbook.has(target) then
				self:initialize(target, { source = source })
			end
		end
	end)
end

function MeshFlipbooks:remove(targets: { Instance })
	self:stopPlayback()

	self.history:run("Remove Mesh Flipbook", function()
		for _, target in self:getConfigured(targets) do
			local decal = target :: Decal
			local config = meshFlipbook.read(target)
			local texture = meshFlipbook.getFrameState(config, meshFlipbook.getPosterIndex(config))

			meshFlipbook.clear(target)
			decal.UVScale = Vector2.one
			decal.UVOffset = Vector2.zero

			if texture ~= "" then
				decal.Texture = texture
			end
		end
	end)
end

function MeshFlipbooks:getOrder(name: string): number
	return tonumber(string.match(name, "%d+")) or math.huge
end

function MeshFlipbooks:findSiblingFrames(target: Instance): { Decal }
	local frames = {}
	local parent = target.Parent

	local function include(candidate: Instance)
		if candidate ~= target and candidate:IsA("Decal") and not meshFlipbook.has(candidate) and meshFlipbook.toId(candidate.Texture) then
			table.insert(frames, candidate)
		end
	end

	for _, child in target:GetChildren() do
		include(child)
	end

	if #frames == 0 and parent then
		for _, child in parent:GetChildren() do
			include(child)
		end
	end

	table.sort(frames, function(a, b)
		local first = self:getOrder(a.Name)
		local second = self:getOrder(b.Name)

		if first ~= second then
			return first < second
		end

		return a.Name < b.Name
	end)

	return frames
end

function MeshFlipbooks:collectSiblings(target: Instance)
	local frames = self:findSiblingFrames(target)

	if #frames == 0 then
		self.context.notify(MeshFlipbooks.messages.noSiblings)
		return
	end

	self:stopPlayback()

	self.history:run("Collect Flipbook Frames", function()
		local ids = {}

		for _, frame in frames do
			table.insert(ids, meshFlipbook.toId(frame.Texture))
			frame.Parent = nil
		end

		local copy = meshFlipbook.copy(meshFlipbook.read(target) or meshFlipbook.normalize(nil))

		copy.source = "Frames"
		copy.ids = ids
		meshFlipbook.write(target, copy)
		meshFlipbook.applyRest(target)
	end)
end

function MeshFlipbooks:readForgeIds(target: Instance): { string }
	local data = target:GetAttribute(MeshFlipbooks.forgeFramesAttribute)

	if typeof(data) ~= "string" then
		return {}
	end

	local success, ids = pcall(function()
		local stored = buffer.fromstring(data)
		local size = MeshFlipbooks.forgeIdSize
		local list = {}

		for index = 0, buffer.len(stored) // size - 1 do
			local id = meshFlipbook.toId(buffer.readf64(stored, index * size))

			if id then
				table.insert(list, id)
			end
		end

		return list
	end)

	return if success then ids else {}
end

function MeshFlipbooks:useForgeFrames(targets: { Instance })
	self:stopPlayback()

	self.history:run("Use Forge Frames", function()
		for _, target in targets do
			local ids = if target.Parent then self:readForgeIds(target) else {}

			if #ids > 0 then
				local copy = meshFlipbook.copy(meshFlipbook.read(target) or meshFlipbook.normalize(nil))
				local duration = target:GetAttribute(MeshFlipbooks.forgeDurationAttribute)

				copy.source = "Frames"
				copy.ids = ids

				if typeof(duration) == "number" and duration > 0 then
					copy.fps = #ids / duration
				end

				meshFlipbook.write(target, copy)
				meshFlipbook.applyRest(target)
			end
		end
	end)
end

function MeshFlipbooks:setFrames(targets: { Instance }, ids: { string }, name: string, fresh: any?)
	self:stopPlayback()

	self.history:run(name, function()
		for _, target in targets do
			if target.Parent and meshFlipbook.isHost(target) then
				local copy = meshFlipbook.copy(meshFlipbook.read(target) or meshFlipbook.normalize(fresh))

				copy.source = "Frames"
				copy.ids = table.clone(ids)
				meshFlipbook.write(target, copy)
				self.previewFrames[target] = nil
				meshFlipbook.applyRest(target)
			end
		end
	end)
end

function MeshFlipbooks:importImages(targets: { Instance })
	local first = targets[1]

	if not first then
		return
	end

	self.importer:import(first.Name, function(ids)
		self:setFrames(targets, ids, "Import Flipbook Frames")
	end)
end

function MeshFlipbooks:collectHosts(roots: { Instance }): { Instance }
	local hosts = {}
	local seen = {}

	local function include(instance: Instance)
		if not seen[instance] and meshFlipbook.has(instance) then
			seen[instance] = true
			table.insert(hosts, instance)
		end
	end

	for _, root in roots do
		include(root)

		for _, descendant in root:GetDescendants() do
			include(descendant)
		end
	end

	return hosts
end

function MeshFlipbooks:isPlaying(): boolean
	return self.clock:isRunning()
end

function MeshFlipbooks:stopPlayback()
	self.token += 1

	if self.clock:isRunning() then
		self.clock:stop()
	end

	table.clear(self.events)
end

function MeshFlipbooks:play(hosts: { Instance }): number
	self:stopPlayback()

	local finish = 0

	for _, host in hosts do
		local config = if host.Parent then meshFlipbook.read(host) else nil

		if config and meshFlipbook.getFrameCount(config) > 0 then
			local plays = if config.loop == "Once" then 1 else MeshFlipbooks.previewLoops

			table.insert(self.events, { host = host, start = 0, plays = plays, stretch = 0 })
			self.previewFrames[host] = nil
			finish = math.max(finish, meshFlipbook.getTotalLength(config, plays, 0) or 0)
		end
	end

	local count = #self.events

	if count == 0 then
		return 0
	end

	local token = self.token

	self.started = os.clock()
	self.clock:start()

	task.delay(finish, function()
		if token == self.token then
			self:stopPlayback()
		end
	end)

	return count
end

function MeshFlipbooks:playTargets(targets: { Instance })
	if self:play(self:getConfigured(targets)) == 0 then
		self.context.notify(MeshFlipbooks.messages.noFrames)
	end
end

function MeshFlipbooks:showFrame(targets: { Instance }, frame: number)
	self:stopPlayback()

	for _, target in self:getConfigured(targets) do
		local config = meshFlipbook.read(target)
		local count = meshFlipbook.getFrameCount(config)

		if count > 0 then
			local index = math.clamp(math.round(frame), 1, count)

			self.previewFrames[target] = index
			meshFlipbook.apply(target, config, index)
		end
	end
end

function MeshFlipbooks:getLayoutLabel(config): string
	for _, layout in MeshFlipbooks.layouts do
		if layout.columns == config.columns and layout.rows == config.rows then
			return layout.label
		end
	end

	return MeshFlipbooks.customLayout
end

function MeshFlipbooks:getLayoutOptions()
	local options = {}

	for _, layout in MeshFlipbooks.layouts do
		table.insert(options, { value = layout.label, label = layout.label })
	end

	table.insert(options, { value = MeshFlipbooks.customLayout, label = MeshFlipbooks.customLayout })

	return options
end

function MeshFlipbooks:setGrid(config, columns: number, rows: number)
	local full = config.count >= config.columns * config.rows

	config.columns = columns
	config.rows = rows

	if full then
		config.count = columns * rows
	end
end

function MeshFlipbooks:usesSpecialMesh(target: Instance): boolean
	local parent = target.Parent

	return parent ~= nil and parent:FindFirstChildWhichIsA("DataModelMesh") ~= nil
end

function MeshFlipbooks:createValueField(targets: { Instance }, options)
	local first = targets[1]
	local field = table.clone(options)

	field.id = "Flipbook." .. options.name
	field.keywords = "flipbook"
	field.value = options.get(meshFlipbook.read(first))

	field.read = function()
		local config = meshFlipbook.read(first)

		return if config then options.get(config) else nil
	end

	field.onChange = function(value, final)
		if value == nil then
			return
		end

		self:change(targets, function(config)
			options.set(config, value)
		end, final)
	end

	return field
end

function MeshFlipbooks:createAction(name: string, label: string, tip: string, callback, accent: boolean?)
	return {
		id = "Flipbook." .. name,
		label = label,
		kind = "action",
		keywords = "flipbook",
		tip = tip,
		accent = accent,
		onAction = callback,
	}
end

function MeshFlipbooks:createNote(name: string, text: string)
	return { id = "Flipbook." .. name, kind = "note", keywords = "flipbook", text = text }
end

function MeshFlipbooks:hasForgeFrames(targets: { Instance }): boolean
	for _, target in targets do
		if #self:readForgeIds(target) > 0 then
			return true
		end
	end

	return false
end

function MeshFlipbooks:buildSetupFields(targets: { Instance })
	local tips = MeshFlipbooks.tips

	local fields = {
		self:createNote("SetupNote", MeshFlipbooks.messages.setup),
		self:createAction("SetupSheet", "Use Sprite Sheet", tips.sheet, function()
			self:setUp(targets, "Sheet")
		end),
		self:createAction("SetupFrames", "Use Image Frames", tips.frames, function()
			self:setUp(targets, "Frames")
		end),
		self:createAction("SetupImport", "Import Image Files", tips.import, function()
			self:importImages(targets)
		end),
	}

	if self:hasForgeFrames(targets) then
		table.insert(fields, self:createAction("SetupForge", "Use Forge Frames", tips.forge, function()
			self:useForgeFrames(targets)
		end, true))
	end

	return fields
end

function MeshFlipbooks:buildSheetFields(targets: { Instance }, fields)
	local tips = MeshFlipbooks.tips
	local maximum = meshFlipbook.maximumGrid

	table.insert(fields, self:createValueField(targets, {
		name = "Image",
		label = "Sheet Image",
		kind = "asset",
		tip = tips.image,
		get = function(config)
			return config.image
		end,
		set = function(config, value)
			config.image = value
		end,
	}))

	table.insert(fields, self:createValueField(targets, {
		name = "Layout",
		label = "Layout",
		kind = "choice",
		tip = tips.layout,
		options = self:getLayoutOptions(),
		get = function(config)
			return self:getLayoutLabel(config)
		end,
		set = function(config, value)
			for _, layout in MeshFlipbooks.layouts do
				if layout.label == value then
					self:setGrid(config, layout.columns, layout.rows)
				end
			end
		end,
	}))

	table.insert(fields, self:createValueField(targets, {
		name = "Columns",
		label = "Columns",
		kind = "number",
		tip = tips.layout,
		integer = true,
		minimum = 1,
		maximum = maximum,
		clamp = true,
		get = function(config)
			return config.columns
		end,
		set = function(config, value)
			self:setGrid(config, value, config.rows)
		end,
	}))

	table.insert(fields, self:createValueField(targets, {
		name = "Rows",
		label = "Rows",
		kind = "number",
		tip = tips.layout,
		integer = true,
		minimum = 1,
		maximum = maximum,
		clamp = true,
		get = function(config)
			return config.rows
		end,
		set = function(config, value)
			self:setGrid(config, config.columns, value)
		end,
	}))

	table.insert(fields, self:createValueField(targets, {
		name = "Count",
		label = "Frames",
		kind = "number",
		tip = tips.count,
		integer = true,
		minimum = 1,
		maximum = maximum * maximum,
		clamp = true,
		get = function(config)
			return config.count
		end,
		set = function(config, value)
			config.count = value
		end,
	}))

	for _, target in targets do
		if self:usesSpecialMesh(target) then
			table.insert(fields, self:createNote("SpecialMeshNote", MeshFlipbooks.messages.specialMesh))
			break
		end
	end
end

function MeshFlipbooks:buildFrameFields(targets: { Instance }, fields, config)
	local tips = MeshFlipbooks.tips
	local first = targets[1]

	table.insert(fields, self:createValueField(targets, {
		name = "Ids",
		label = string.format("Frame IDs (%d)", #config.ids),
		kind = "text",
		tip = tips.ids,
		placeholder = "Paste image ids",
		format = function(ids)
			return table.concat(ids, ", ")
		end,
		parse = function(text: string)
			return meshFlipbook.parseIds(text)
		end,
		get = function(current)
			return current.ids
		end,
		set = function(current, value)
			current.ids = value
		end,
	}))

	table.insert(fields, self:createAction("Import", "Import Image Files", tips.import, function()
		self:importImages(targets)
	end))

	table.insert(fields, self:createAction("Siblings", "Use Decals On Part", tips.siblings, function()
		self:collectSiblings(first)
	end))

	if self:hasForgeFrames(targets) then
		table.insert(fields, self:createAction("Forge", "Use Forge Frames", tips.forge, function()
			self:useForgeFrames(targets)
		end))
	end
end

function MeshFlipbooks:buildPlaybackFields(targets: { Instance })
	local tips = MeshFlipbooks.tips
	local first = targets[1]
	local fields = {}

	table.insert(fields, self:createValueField(targets, {
		name = "Fps",
		label = "FPS",
		kind = "number",
		tip = tips.fps,
		minimum = meshFlipbook.minimumFps,
		maximum = meshFlipbook.maximumFps,
		clamp = true,
		range = { min = 1, max = 60 },
		get = function(config)
			return config.fps
		end,
		set = function(config, value)
			config.fps = value
		end,
	}))

	table.insert(fields, self:createValueField(targets, {
		name = "Loop",
		label = "Mode",
		kind = "choice",
		tip = tips.loop,
		options = MeshFlipbooks.loopOptions,
		get = function(config)
			return config.loop
		end,
		set = function(config, value)
			config.loop = value
		end,
	}))

	table.insert(fields, self:createValueField(targets, {
		name = "Idle",
		label = "When Idle",
		kind = "choice",
		tip = tips.idle,
		options = MeshFlipbooks.idleOptions,
		get = function(config)
			return config.idle
		end,
		set = function(config, value)
			config.idle = value
		end,
	}))

	table.insert(fields, self:createValueField(targets, {
		name = "Reverse",
		label = "Reverse",
		kind = "toggle",
		tip = tips.reverse,
		get = function(config)
			return config.reverse
		end,
		set = function(config, value)
			config.reverse = value
		end,
	}))

	table.insert(fields, {
		id = "Flipbook.Frame",
		label = "Look At Frame",
		kind = "number",
		keywords = "flipbook preview",
		tip = tips.frame,
		integer = true,
		minimum = 1,
		sensitivity = 0.1,
		value = self.previewFrames[first] or 1,
		read = function()
			local config = meshFlipbook.read(first)

			if not config then
				return nil
			end

			return self.previewFrames[first] or meshFlipbook.getPosterIndex(config) or 1
		end,
		onChange = function(value)
			if value ~= nil then
				self:showFrame(targets, value)
			end
		end,
	})

	table.insert(fields, self:createNote("AnimateNote", MeshFlipbooks.messages.animate))

	table.insert(fields, self:createAction("Remove", "Remove Flipbook", tips.remove, function()
		self:remove(targets)
	end))

	return fields
end

function MeshFlipbooks:getSections(targets: { Instance })
	local first = targets[1]

	if not first then
		return {}
	end

	for _, target in targets do
		if not meshFlipbook.isHost(target) then
			return {}
		end
	end

	local config = meshFlipbook.read(first)

	if not config then
		return {
			{
				title = MeshFlipbooks.sectionTitle,
				key = "MeshFlipbook.Setup",
				after = true,
				fields = self:buildSetupFields(targets),
			},
		}
	end

	local fields = {
		self:createValueField(targets, {
			name = "Source",
			label = "Source",
			kind = "choice",
			tip = MeshFlipbooks.tips.source,
			options = MeshFlipbooks.sourceOptions,
			get = function(current)
				return current.source
			end,
			set = function(current, value, target)
				current.source = value
			end,
		}),
	}

	if config.source == "Frames" then
		self:buildFrameFields(targets, fields, config)
	else
		self:buildSheetFields(targets, fields)
	end

	local play = {
		text = "Play",
		tip = MeshFlipbooks.tips.play,
		callback = function()
			self:playTargets(targets)
		end,
	}

	return {
		{
			title = MeshFlipbooks.sectionTitle,
			key = "MeshFlipbook",
			after = true,
			action = play,
			fields = fields,
		},
		{
			title = MeshFlipbooks.playbackTitle,
			key = "MeshFlipbook.Playback",
			after = true,
			action = play,
			fields = self:buildPlaybackFields(targets),
		},
	}
end

function MeshFlipbooks:stop()
	self:finishEdit()
	self:stopPlayback()
end

function MeshFlipbooks:destroy()
	self:stop()
end

return MeshFlipbooks
]]></ProtectedString>
