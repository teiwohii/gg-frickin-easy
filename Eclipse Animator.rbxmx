							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local modifiers = require(script.Parent.Parent.Utility.modifiers)

local EditorHelpers = {}
EditorHelpers.__index = EditorHelpers

EditorHelpers.toggleKey = Enum.KeyCode.H
EditorHelpers.baseName = "Base"
EditorHelpers.originLabelName = "OriginLabel"

function EditorHelpers.isToggleInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.Keyboard
		and input.KeyCode == EditorHelpers.toggleKey
		and not userInputService:GetFocusedTextBox()
		and modifiers.isCtrl(input)
		and not modifiers.isShift(input)
end

function EditorHelpers.new()
	local self = setmetatable({}, EditorHelpers)

	self.hidden = false
	self.effects = nil
	self.listeners = {}

	return self
end

function EditorHelpers:isHidden(): boolean
	return self.hidden
end

function EditorHelpers:addListener(listener: (boolean) -> ())
	table.insert(self.listeners, listener)
end

function EditorHelpers:getOriginLabel(): BillboardGui?
	local effects = self.effects
	local base = if effects and effects.Parent then effects:FindFirstChild(EditorHelpers.baseName) else nil
	local label = if base then base:FindFirstChild(EditorHelpers.originLabelName) else nil

	return if label and label:IsA("BillboardGui") then label else nil
end

function EditorHelpers:applyOriginLabel(hidden: boolean)
	local label = self:getOriginLabel()

	if label and label.Enabled == hidden then
		label.Enabled = not hidden
	end
end

function EditorHelpers:notify()
	for _, listener in self.listeners do
		local success, problem = pcall(listener, self.hidden)

		if not success then
			warn(problem)
		end
	end
end

function EditorHelpers:setEffects(effects: Instance?)
	if self.effects ~= effects then
		self:applyOriginLabel(false)
	end

	self.effects = effects
	self:applyOriginLabel(self.hidden)
end

function EditorHelpers:setHidden(hidden: boolean)
	if self.hidden == hidden then
		self:applyOriginLabel(hidden)
		return
	end

	self.hidden = hidden
	self:applyOriginLabel(hidden)
	self:notify()
end

function EditorHelpers:toggle(): boolean
	self:setHidden(not self.hidden)

	return self.hidden
end

function EditorHelpers:release()
	self:setHidden(false)
	self.effects = nil
end

function EditorHelpers:destroy()
	self:release()
	table.clear(self.listeners)
end

return EditorHelpers
]]></ProtectedString>
