						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local soundCue = {}
soundCue.__index = soundCue

soundCue.defaultLength = 1
soundCue.minimumSpeed = 0.01

function soundCue.isHost(instance: any): boolean
	return typeof(instance) == "Instance" and instance:IsA("Sound")
end

function soundCue.isPlayable(instance: any): boolean
	return soundCue.isHost(instance) and instance.Parent ~= nil
end

function soundCue.getHosts(source: any): { Instance }
	return if soundCue.isHost(source) then { source } else {}
end

function soundCue.collect(roots: { Instance }): { Instance }
	local hosts = {}
	local seen = {}

	local function include(instance: Instance)
		if not seen[instance] and soundCue.isHost(instance) then
			seen[instance] = true
			table.insert(hosts, instance)
		end
	end

	for _, root in roots do
		include(root)

		for _, descendant in root:GetDescendants() do
			include(descendant)
		end
	end

	return hosts
end

function soundCue.getNaturalLength(sound: Sound): number
	local length = sound.TimeLength

	if length <= 0 then
		return soundCue.defaultLength
	end

	return length / math.max(sound.PlaybackSpeed, soundCue.minimumSpeed)
end

function soundCue.getOffset(sound: Sound, elapsed: number): number
	local offset = math.max(elapsed, 0) * math.max(sound.PlaybackSpeed, soundCue.minimumSpeed)
	local length = sound.TimeLength

	if sound.Looped and length > 0 then
		offset %= length
	end

	return offset
end

function soundCue.isOpen(sound: Sound, stretch: number?): boolean
	if stretch ~= nil and stretch > 0 then
		return false
	end

	return sound.Looped or sound.TimeLength <= 0
end

function soundCue.getLength(sound: Sound, stretch: number?): number
	if stretch and stretch > 0 then
		return stretch
	end

	return soundCue.getNaturalLength(sound)
end

return soundCue
]]></ProtectedString>
