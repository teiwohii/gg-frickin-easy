						<ProtectedString name="Source"><![CDATA[-- riftkuro



local require = require(script:FindFirstAncestor("container").requireModule)

local shortcuts = require("shortcuts")

local blenderEdit = require("blenderEdit")

local changeHistoryService = game:GetService("ChangeHistoryService")

local userInputService = require("userInputService")

local runService = game:GetService("RunService")

local selection = game:GetService("Selection")



local graphRootState = require("state")

local history = {}



local undoStack = {}

local redoStack = {}

local maxSize = 1000



local applyingUndoRedo = false

local connections = {}

local onNotify = nil

local listeners = {}

local batches = setmetatable({}, { __mode = "k" })



local function changed()

	for callback in listeners do

		task.defer(callback)

	end

end



function history.subscribe(callback)

	listeners[callback] = true

	return function()

		listeners[callback] = nil

	end

end



local jumpToFrameCallback = nil

local activeCheckFn = nil

local beforeUndoRedo = nil

local shortcutHeld = {}



function history.isApplying()

	return applyingUndoRedo

end



local guardCallbacks = {}

local guardCleanupCallback = nil



local function push(stack, item)

	table.insert(stack, item)

	if #stack > maxSize then

		table.remove(stack, 1)

	end

end



local function isActive()

	if graphRootState.LimbPointSetupActive then

		return true

	end

	if graphRootState.WorkspaceSelection then

		return false

	end



	if graphRootState.GraphEditor and graphRootState.GraphEditor.hasFocus() then

		return false

	end



	if graphRootState.CameraPreview and graphRootState.CameraPreview.isFull() then

		return true

	end



	if not activeCheckFn then

		return true

	end



	local ok, result = pcall(activeCheckFn)

	return ok and result == true

end



local externalRecordings = {}

local externalBefore = nil

local externalLabel = nil

local placement = { parts = {}, scales = {}, pivots = {} }

local placementParts = {}

local placementModels = {}

local placementRefreshAt = 0

local placementRefresh = 2

local selectionLimit = 512

local recordingTimeout = 30

local placementLimit = 2048

local placementFullRefresh = 10

local ownLabels = {}

local rigCandidates = setmetatable({}, { __mode = "k" })

local watchedParts = {}

local movedParts = {}

local knownRigs = {}

local nativeInput = game:GetService("UserInputService")

local placementLive = false

local placementDirty = true

local placementFullAt = 0

local studioBase = { undo = nil, redo = nil }

local trackedParents = setmetatable({}, { __mode = "k" })

local trackedLinks = {}

local probeParent = Instance.new("Folder")

local parentLimit = 256

local revertTimeout = 1

local sentinel = "EclipseAnimator_Session"

local nativeEcho = 0.5

local armEcho = 0.25

local shortcutEcho = 0.5

local armRetry = 1

local armSelection = {}

local shortcutRoutes =

	{ undo = { source = nil, at = -math.huge }, redo = { source = nil, at = -math.huge } }

local armed = false

local armingStudio = false

local armPending = false

local armForce = false

local armEchoes = 0

local armEchoAt = -math.huge

local armRetryAt = 0

local armSelectionCount = 0

local nativeChangedAt = -math.huge

local studioEdited = false

local sessionDirty = false

local sessionWasOpen = false

local selectionDirty = false

local uiModule = nil



local function studioTop()

	local undoName, redoName = nil, nil

	local okUndo, canUndo, nameUndo = pcall(changeHistoryService.GetCanUndo, changeHistoryService)

	if okUndo and canUndo then

		undoName = nameUndo or ""

	end



	local okRedo, canRedo, nameRedo = pcall(changeHistoryService.GetCanRedo, changeHistoryService)

	if okRedo and canRedo then

		redoName = nameRedo or ""

	end



	return undoName, redoName

end



local function sameSelection()

	local current = selection:Get()

	if #current ~= armSelectionCount then

		return false

	end



	for _, object in current do

		if not armSelection[object] then

			return false

		end

	end



	return true

end



local function untrackObject(object)

	trackedParents[object] = nil

	local link = trackedLinks[object]

	if link then

		trackedLinks[object] = nil

		link:Disconnect()

	end

end



local function trackObject(object, parent)

	trackedParents[object] = parent

	if not trackedLinks[object] then

		local ok, link = pcall(function()

			return object.Destroying:Connect(function()

				untrackObject(object)

			end)

		end)

		if ok then

			trackedLinks[object] = link

		else

			trackedParents[object] = nil

		end

	end

end



local function restorable(object, parent)

	if typeof(parent) ~= "Instance" or not parent:IsDescendantOf(game) then

		return false

	end



	return (pcall(function()

		object.Parent = probeParent

		object.Parent = nil

	end))

end



local function recordingOpen()

	if next(externalRecordings) then

		return true

	end



	local ok, open = pcall(changeHistoryService.IsRecordingInProgress, changeHistoryService)

	return ok and open == true

end



local function trackSelection()

	selectionDirty = true

	if armed and not armPending and not sameSelection() then

		armPending = true

	end



	local count = 0

	for _ in trackedParents do

		count += 1

	end



	local camera = workspace.CurrentCamera

	for _, object in selection:Get() do

		if count >= parentLimit then

			break

		end



		local parent = object.Parent

		if

			parent

			and trackedParents[object] == nil

			and not (camera and object:IsDescendantOf(camera))

		then

			trackObject(object, parent)

			count += 1

		end

	end

end



local function pruneSelection(forgetDeleted)

	selectionDirty = false

	local current = {}

	for _, object in selection:Get() do

		current[object] = true

	end



	for object in trackedParents do

		local parent = object.Parent

		if parent == nil then

			if forgetDeleted then

				untrackObject(object)

			end

		elseif current[object] then

			trackedParents[object] = parent

		else

			untrackObject(object)

		end

	end

end



local function deletionPending()

	for object in trackedParents do

		if object.Parent == nil then

			return true

		end

	end



	return false

end



local function markStudioBase()

	studioBase.undo, studioBase.redo = studioTop()

	studioEdited = false

	pruneSelection(true)

end



local function studioChanged()

	local undoName, redoName = studioTop()

	if undoName == studioBase.undo and redoName == studioBase.redo then

		return undoName ~= nil and (studioEdited or deletionPending())

	end



	if

		redoName ~= nil and redoName == studioBase.undo

		or undoName ~= nil and undoName == studioBase.redo

	then

		return false

	end



	return true

end



local function clearStudioStack()

	changeHistoryService:SetWaypoint("EclipseAnimator_Reset_Begin")

	changeHistoryService:SetWaypoint("EclipseAnimator_Reset_End")

	changeHistoryService:ResetWaypoints()

end



local function projectBusy()

	if graphRootState.LoadingProject then

		return true

	end



	local timeline = graphRootState.Timeline

	return timeline ~= nil and timeline.IsExportLocked ~= nil and timeline:IsExportLocked() == true

end



local function sessionOpen()

	if graphRootState.LoadingProject or isActive() then

		return true

	end



	if activeCheckFn then

		local ok, result = pcall(activeCheckFn)

		if ok and result == true then

			return true

		end

	end



	if uiModule == nil then

		local ok, module = pcall(require, "ui")

		uiModule = ok and module or false

	end



	local gui = uiModule and uiModule.EclipseGUI

	return typeof(gui) == "Instance"

		and gui.Enabled

		and gui:GetAttribute("EclipseConfirmationOpen") == true

		and graphRootState.currentRig ~= nil

end



local function armStudio()

	armPending, armForce = false, false

	if recordingOpen() then

		armPending, armForce = true, true

		return false

	end



	local selectionBefore = selection:Get()

	table.clear(armSelection)

	armSelectionCount = 0

	for _, object in selectionBefore do

		armSelection[object] = true

		armSelectionCount += 1

	end



	local current = selection:GetAttribute(sentinel)

	local base = if current == 1 or current == 2 then 3 else 1

	clearStudioStack()

	armed = true

	selection:SetAttribute(sentinel, base)

	changeHistoryService:SetWaypoint(sentinel)

	selection:SetAttribute(sentinel, base + 1)

	changeHistoryService:SetWaypoint(sentinel)

	local undoName = studioTop()

	if undoName ~= sentinel then

		armed, armEchoes = false, 0

		armRetryAt = os.clock() + armRetry

		markStudioBase()

		return false

	end



	armEchoes += 1

	armEchoAt = os.clock()

	armingStudio = true

	local ok, issue = pcall(function()

		changeHistoryService:Undo()

		if not sameSelection() then

			selection:Set(selectionBefore)

		end

	end)

	armingStudio = false

	if not ok then

		armed, armEchoes = false, 0

		armRetryAt = os.clock() + armRetry

		error(issue, 0)

	end



	markStudioBase()

	return true

end



local function disarmStudio()

	armPending, armForce = false, false

	local tagged = selection:GetAttribute(sentinel) ~= nil

	if tagged then

		selection:SetAttribute(sentinel, nil)

	end



	if armed or tagged then

		armed = false

		clearStudioStack()

		markStudioBase()

	end

end



local function resetStudioWaypoints(force)

	if force or armed or changeHistoryService:GetCanUndo() or changeHistoryService:GetCanRedo() then

		clearStudioStack()

	end



	armed = false

	sessionDirty = false

	if not (sessionOpen() and armStudio()) then

		markStudioBase()

	end

end



local function maintainArm(strict)

	if applyingUndoRedo or os.clock() < armRetryAt or recordingOpen() then

		return

	end



	local undoName, redoName = studioTop()

	if undoName == sentinel and redoName == sentinel and not armPending then

		return

	end



	if

		not strict

		and not armForce

		and (undoName ~= nil and undoName ~= sentinel or redoName ~= nil and redoName ~= sentinel)

	then

		armPending = false

		return

	end



	local ok, err = pcall(armStudio)

	if not ok then

		armed = false

		armRetryAt = os.clock() + armRetry

		warn("Eclipse could not route Studio undo to the animator:", err)

		return

	end



	local armedUndo, armedRedo = studioTop()

	if err and not (armedUndo == sentinel and armedRedo == sentinel) then

		armRetryAt = os.clock() + armRetry

	end

end



local function bindEntry(undoFn, redoFn, description, contextFrame, redoContextFrame)

	local undoCf, redoCf

	if type(contextFrame) == "table" then

		undoCf = contextFrame.undo

		redoCf = contextFrame.redo

	else

		undoCf = contextFrame

		redoCf = redoContextFrame

	end



	local raw = require("rawState").Timeline

	local layerId = raw.AnimationLayers and raw.AnimationLayers.active

	local master = raw.AnimationLayers and raw.AnimationLayers.master

	local activeByRig = raw.AnimationLayers and table.clone(raw.AnimationLayers.activeByRig or {})



	local function bound(fn)

		return function()

			return require("layers").history(layerId, fn, master, activeByRig)

		end

	end



	return {

		undo = bound(undoFn),

		redo = bound(redoFn),

		description = description or "Action",

		contextFrame = undoCf,

		undoContextFrame = undoCf,

		redoContextFrame = (redoCf ~= nil) and redoCf or undoCf,

		afterUndo = type(contextFrame) == "table" and contextFrame.afterUndo or nil,

		afterRedo = type(contextFrame) == "table" and contextFrame.afterRedo or nil,

	}

end



local function commit(entry, external)

	push(undoStack, entry)

	table.clear(redoStack)

	local undoName, redoName = studioTop()

	if not armed or undoName ~= sentinel or redoName ~= sentinel then

		armPending, armForce = true, true

	end

	if not external then

		sessionDirty = true

	end



	changed()

end



local function ownWaypoint(name)

	return type(name) ~= "string"

		or name == ""

		or name:find("Eclipse", 1, true) ~= nil

		or name == "Add Armature"

		or ownLabels[name] == true

end



local function placementRoot(part)

	return part:IsA("BasePart") and (part.Anchored or part.AssemblyRootPart == part)

end



local function forgetRigParts(rig)

	local cached = rigCandidates[rig]

	if cached then

		for _, connection in cached.connections do

			connection:Disconnect()

		end



		rigCandidates[rig] = nil

	end

end



local function rigParts(rig)

	local cached = rigCandidates[rig]

	if cached and not cached.dirty then

		return cached.parts

	end



	forgetRigParts(rig)

	local entry = { parts = {}, dirty = false, connections = {} }

	if rig:IsA("BasePart") then

		table.insert(entry.parts, rig)

	end



	for _, object in rig:GetDescendants() do

		if object:IsA("BasePart") then

			table.insert(entry.parts, object)

		end

	end



	local function invalidate(object)

		if object:IsA("BasePart") or object:IsA("JointInstance") then

			entry.dirty = true

			placementDirty = true

		end

	end



	entry.connections[1] = rig.DescendantAdded:Connect(invalidate)

	entry.connections[2] = rig.DescendantRemoving:Connect(invalidate)

	rigCandidates[rig] = entry

	return entry.parts

end



local function unwatchPart(part)

	local links = watchedParts[part]

	if links then

		links:Disconnect()

		watchedParts[part] = nil

	end



	movedParts[part] = nil

	placement.parts[part] = nil

end



local function watchPart(part)

	if watchedParts[part] then

		return

	end



	watchedParts[part] = part:GetPropertyChangedSignal("CFrame"):Connect(function()

		movedParts[part] = true

	end)

	placement.parts[part] = part.CFrame

end



local function rigSetChanged(rigs)

	if #rigs ~= #knownRigs then

		return true

	end



	for index, rig in rigs do

		if knownRigs[index] ~= rig then

			return true

		end

	end



	return false

end



local function refreshPlacementParts(force)

	placementRefreshAt = os.clock() + placementRefresh

	local ok, rigs = pcall(function()

		return graphRootState.getAllRigs and graphRootState.getAllRigs() or {}

	end)

	if not ok then

		return

	end



	if

		not force

		and not placementDirty

		and os.clock() < placementFullAt

		and not rigSetChanged(rigs)

	then

		return

	end



	placementDirty = false

	placementFullAt = os.clock() + placementFullRefresh

	table.clear(knownRigs)

	for index, rig in rigs do

		knownRigs[index] = rig

	end



	table.clear(placementParts)

	table.clear(placementModels)

	local animated = require("rawState").Timeline.MotorByPart or {}

	local cameraRig = require("cameraRig")

	local masterControl = require("masterControl")

	local current = {}

	for _, rig in rigs do

		if typeof(rig) ~= "Instance" or not rig.Parent or cameraRig.isRig(rig) then

			continue

		end



		current[rig] = true

		local master = masterControl.get(rig)

		local driven = master and master.Part1

		if rig:IsA("Model") then

			table.insert(placementModels, rig)

		end



		for _, part in rigParts(rig) do

			if #placementParts >= placementLimit then

				break

			end



			if part ~= driven and not animated[part] and placementRoot(part) then

				table.insert(placementParts, part)

			end

		end

	end



	for rig in rigCandidates do

		if not current[rig] then

			forgetRigParts(rig)

		end

	end



	local wanted = {}

	for _, part in placementParts do

		wanted[part] = true

		watchPart(part)

		if force and part.Parent then

			placement.parts[part] = part.CFrame

		end

	end



	for part in watchedParts do

		if not wanted[part] then

			unwatchPart(part)

		end

	end



	table.clear(placement.scales)

	table.clear(placement.pivots)

	for _, model in placementModels do

		if model.Parent then

			placement.scales[model] = model:GetScale()

			placement.pivots[model] = model:GetPivot()

		end

	end



	if force then

		table.clear(movedParts)

	end

end



local function settlePlacement()

	if not next(movedParts) then

		return

	end



	for part in movedParts do

		if part.Parent and watchedParts[part] then

			placement.parts[part] = part.CFrame

		end

	end



	table.clear(movedParts)

	for _, model in placementModels do

		if model.Parent then

			placement.scales[model] = model:GetScale()

			placement.pivots[model] = model:GetPivot()

		end

	end

end



local function captureNativeJoint(target, object, motor)
	if not motor or not motor.Parent then return false end
	local bone = object:IsA("Bone") and object or nil
	if not bone and not (typeof(motor) == "Instance" and motor:IsA("Motor6D")) then return false end
	if not bone and (not motor.Part0 or motor.Part1 ~= object) then return false end
	target.joints = target.joints or {}
	if target.joints[motor] then return true end
	local rig
	for _, candidate in knownRigs do
		if object:IsDescendantOf(candidate) then rig = candidate break end
	end
	target.joints[motor] = {
		part = object, bone = bone, rig = rig, pose = motor.C0,
		rest = bone and bone.CFrame or motor.C1,
		transform = bone and bone.Transform or motor.Transform,
		world = not bone and object.CFrame or nil,
		size = not bone and object.Size or nil,
	}
	return true
end

local function restoreNativeJoints(joints)
	local rigs = {}
	local applied = false
	for motor, saved in joints or {} do
		if motor.Parent and saved.part.Parent then
			if saved.bone then
				saved.bone.CFrame = saved.rest
			else
				motor.C1 = saved.rest
				motor.Transform = saved.transform
				saved.part.Size = saved.size
			end
			motor.C0 = saved.pose
			if saved.rig and saved.rig.Parent and not saved.bone then
				rigs[saved.rig] = rigs[saved.rig] or {}
				rigs[saved.rig][saved.part] = saved.world
			end
			if graphRootState.lastCFrames then graphRootState.lastCFrames[motor] = saved.pose end
			applied = true
		end
	end
	for rig, desired in rigs do require("nativeJoints").applyWorlds(rig, desired) end
	return applied
end

local function captureSelection(target)

	local animated = require("rawState").Timeline.MotorByPart or {}

	local count = 0



	local function add(part)

		if

			count < selectionLimit

			and not animated[part]

			and not watchedParts[part]

			and target.parts[part] == nil

		then

			count += 1

			target.parts[part] = part.CFrame

		end

	end



	for _, object in selection:Get() do

		if object:IsA("BasePart") or object:IsA("Bone") then
			if not captureNativeJoint(target, object, animated[object]) and object:IsA("BasePart") then
				add(object)
			end

		elseif object:IsA("Model") then

			if target.scales[object] == nil and placement.scales[object] == nil then

				target.scales[object] = object:GetScale()

			end



			if target.pivots[object] == nil then

				target.pivots[object] = object:GetPivot()

			end



			for _, part in object:GetDescendants() do

				if count >= selectionLimit then

					break

				end



				if placementRoot(part) then

					add(part)

				end

			end

		end

	end

end



local function writeDefault(raw, motor, value)

	local properties = require("properties")

	motor.Part1:SetAttribute("Default", require("document").pack(value))

	raw.DefaultPose[motor] = properties.encode(value)

	properties.setValue(motor, value)

end



local function captureNativeScale(timeline, motor)
	local raw = timeline:GetState()
	local layers = require("layers")
	local data = layers.ensure(raw)
	local result = {
		motor = motor,
		default = motor.Part1:GetAttribute("Default"),
		basis = motor.Part1:GetAttribute("EclipseScaleBasis"),
		enabled = motor.Part1:GetAttribute("Enabled"),
		disabled = motor.Part1:GetAttribute("EclipseDisabled"),
		rawDefault = raw.DefaultPose[motor],
		buckets = {},
	}
	for _, layer in data.layers do
		result.buckets[layer.id] = layer.keys[motor] and layers.clone(layer.keys[motor]) or false
	end
	return result
end

local function restoreNativeScale(timeline, snapshot)
	local motor = snapshot.motor
	if not motor.Parent then return false end
	local raw = timeline:GetState()
	local layers = require("layers")
	local data = layers.ensure(raw)
	timeline:_restoreMotorBucket(motor, {})
	motor.Part1:SetAttribute("Default", snapshot.default)
	motor.Part1:SetAttribute("EclipseScaleBasis", snapshot.basis)
	motor.Part1:SetAttribute("Enabled", snapshot.enabled)
	motor.Part1:SetAttribute("EclipseDisabled", snapshot.disabled)
	raw.DefaultPose[motor] = snapshot.rawDefault
	for _, layer in data.layers do
		local bucket = snapshot.buckets[layer.id]
		if bucket ~= nil then
			layer.keys[motor] = bucket and layers.clone(bucket) or nil
		end
	end
	layers.rebuild(raw)
	local active = layers.clone(raw.Keyframes[motor] or {})
	timeline:_restoreMotorBucket(motor, active)
	return true
end

local function adoptNativeScale(timeline, model, previousScale, nextScale)
	assert(previousScale > 0 and nextScale > 0 and previousScale < math.huge and nextScale < math.huge)
	local properties = require("properties")
	local document = require("document")
	local layers = require("layers")
	local raw = timeline:GetState()
	local motor
	for _, candidate in properties.list(model, true, true) do
		if candidate.PropertyId == "Scale" then motor = candidate break end
	end
	local created = motor == nil
	if created then
		motor = properties.enable(model, "Scale", true, raw)
		motor.Part1:SetAttribute("Default", document.pack(previousScale))
		motor.Part1:SetAttribute("Enabled", false)
		raw.DefaultPose[motor] = properties.encode(previousScale)
	end
	local before = captureNativeScale(timeline, motor)
	local ratio = nextScale / previousScale
	local after = table.clone(before)
	after.buckets = layers.clone(before.buckets)
	local basis = properties.scaleBasis(motor)
	after.basis = basis
	after.default = document.pack(motor.DefaultValue * ratio)
	after.rawDefault = properties.encode(motor.DefaultValue * ratio)
	if created then after.enabled = true end
	local function scaleKey(key)
		require("poseSpace").retargetKey(key, ratio)
		local function values(value)
			if typeof(value.PropertyValue) == "number" then value.PropertyValue *= ratio end
			if value.PhysicsLead then values(value.PhysicsLead) end
		end
		values(key)
	end
	for _, bucket in after.buckets do
		if bucket then
			for _, key in bucket do scaleKey(key) end
		end
	end
	restoreNativeScale(timeline, after)
	return before, after
end


local function applyPlacement(state)

	local applied = false

	if state.parents then

		for object, parent in state.parents do

			local target = parent or nil

			if object.Parent ~= target and pcall(function()

				object.Parent = target

			end) then

				applied = true

			end

		end

	end



	for motor, enabled in state.propertyEnabled or {} do
		if motor.Parent then motor.Part1:SetAttribute("Enabled", enabled) end
	end
	for _, snapshot in state.nativeScales or {} do
		applied = restoreNativeScale(graphRootState.Timeline, snapshot) or applied
	end
	for model, scale in state.scales do

		if

			model.Parent

			and math.abs(model:GetScale() - scale) > 1e-6

			and pcall(model.ScaleTo, model, scale)

		then

			applied = true

		end

	end



	for model in state.rigid do

		local cf = state.pivots[model]

		if

			model.Parent

			and not model:GetPivot():FuzzyEq(cf, 1e-5)

			and pcall(model.PivotTo, model, cf)

		then

			applied = true

		end

	end



	for part, cf in state.parts do

		if part.Parent and pcall(function()

			part.CFrame = cf

		end) then

			applied = true

		end

	end



	for model, cf in state.pivots do

		if

			model.Parent

			and not model.PrimaryPart

			and not model.WorldPivot:FuzzyEq(cf, 1e-5)

			and pcall(function()

				model.WorldPivot = cf

			end)

		then

			applied = true

		end

	end



	local timeline = graphRootState.Timeline

	local posed = nil

	if timeline then

		local raw = timeline:GetState()

		for motor, bucket in state.buckets do

			if motor.Parent and pcall(timeline._restoreMotorBucket, timeline, motor, bucket) then

				posed = posed or (typeof(motor) == "table" and motor.Rig) or (state.joints and state.joints[motor] and state.joints[motor].rig)

				applied = true

			end

		end



		for motor, value in state.defaults do

			if motor.Parent and pcall(writeDefault, raw, motor, value) then

				posed = posed or (typeof(motor) == "table" and motor.Rig) or (state.joints and state.joints[motor] and state.joints[motor].rig)

				applied = true

			end

		end

	end



	local poseRig = graphRootState.currentRig or posed

	if timeline and poseRig then

		pcall(function()

			timeline:ApplyPoseAtTime(poseRig, timeline:GetState().CurrentTime)

		end)

	end



	applied = restoreNativeJoints(state.joints) or applied
	pcall(function()

		require("motionPath").markDirty()

	end)



	return applied

end



local function movedWithin(model, parts)

	for part in parts do

		if part:IsDescendantOf(model) then

			return true

		end

	end



	return false

end



local function keyPropertyMoves(undoState, redoState)

	local timeline = graphRootState.Timeline

	if not timeline or not (next(undoState.pivots) or next(undoState.scales)) then

		return nil

	end



	local raw = timeline:GetState()

	if raw.Playing or blenderEdit.blocked() then

		return nil

	end



	local properties = require("properties")

	local frame = timeline:TimeToFrame(raw.CurrentTime)

	local recording = timeline:IsRecording()

	local sanitize = graphRootState.UIHelpers and graphRootState.UIHelpers.SanitizeName

	local keyed = false
	if recording then
		for model, previousScale in undoState.scales do
			if not table.find(knownRigs, model) then
				continue
			end
			local motor
			for _, candidate in properties.list(model, true, true) do
				if candidate.PropertyId == "Scale" then motor = candidate break end
			end
			if not motor then
				motor = properties.enable(model, "Scale", true, raw)
				motor.Part1:SetAttribute("Default", require("document").pack(previousScale))
				raw.DefaultPose[motor] = properties.encode(previousScale)
			elseif motor.Part1:GetAttribute("Enabled") == false then
				undoState.propertyEnabled = undoState.propertyEnabled or {}
				redoState.propertyEnabled = redoState.propertyEnabled or {}
				undoState.propertyEnabled[motor], redoState.propertyEnabled[motor] = false, true
				properties.enable(model, "Scale", true, raw)
			end
			local before = timeline:_snapshotMotorBucket(motor)
			local value = redoState.scales[model]
			timeline:RecordKeyframeForMotorAtCurrentTime(
				motor.Part1, motor, properties.encode(value),
				{ Frame = frame, PropertyValue = value }, sanitize
			)
			undoState.buckets[motor], redoState.buckets[motor] = before, timeline:_snapshotMotorBucket(motor)
			keyed = true
			graphRootState.currentProjectSaved = false
		end
	else
		for model, previousScale in undoState.scales do
			if table.find(knownRigs, model) then
				local before, after = adoptNativeScale(timeline, model, previousScale, redoState.scales[model])
				undoState.nativeScales = undoState.nativeScales or {}
				redoState.nativeScales = redoState.nativeScales or {}
				undoState.nativeScales[model], redoState.nativeScales[model] = before, after
				keyed = true
				graphRootState.currentProjectSaved = false
			end
		end
	end


	for model in undoState.pivots do

		if

			not table.find(knownRigs, model)

			or not movedWithin(model, undoState.parts)

			or properties.inheritedTransform(model)

		then

			continue

		end



		for _, motor in properties.list(model, false, true) do

			if motor.PropertyId ~= "CFrame" or motor:GetAttribute("EclipseDisabled") then

				continue

			end



			local value = properties.readValue(model, "CFrame")

			if recording then

				local before = timeline:_snapshotMotorBucket(motor)

				timeline:RecordKeyframeForMotorAtCurrentTime(

					motor.Part1,

					motor,

					properties.encode(value),

					{ Frame = frame, PropertyValue = value },

					sanitize

				)

				undoState.buckets[motor], redoState.buckets[motor] =

					before, timeline:_snapshotMotorBucket(motor)

				keyed = true

			else

				undoState.defaults[motor], redoState.defaults[motor] = motor.DefaultValue, value

				writeDefault(raw, motor, value)

			end



			graphRootState.currentProjectSaved = false

		end

	end



	return keyed and frame or nil

end



local function adoptNativeJoints(undoState, redoState)
	local timeline = graphRootState.Timeline
	if not timeline or not externalBefore or not externalBefore.joints then return false, nil end
	local raw = timeline:GetState()
	if raw.Playing or blenderEdit.blocked() then return false, nil end
	local recording = timeline:IsRecording()
	local frame = timeline:TimeToFrame(raw.CurrentTime)
	local sanitize = graphRootState.UIHelpers and graphRootState.UIHelpers.SanitizeName
	local changed = false
	undoState.joints, redoState.joints = {}, {}
	for motor, before in externalBefore.joints do
		local part = before.part
		if not motor.Parent or not part.Parent then continue end
		local scaled = false
		for model in undoState.scales do
			if part:IsDescendantOf(model) then scaled = true break end
		end
		if scaled then continue end
		local pose, size = motor.C0, before.size
		if not before.bone then
			size = part.Size
			if not motor.C0:FuzzyEq(before.pose, 1e-5)
				or not motor.C1:FuzzyEq(before.rest, 1e-5)
				or not motor.Transform:FuzzyEq(before.transform, 1e-5) then
				pose = motor.C0 * motor.Transform * motor.C1:Inverse() * before.rest * before.transform:Inverse()
			elseif not part.CFrame:FuzzyEq(before.world, 1e-5) then
				pose = motor.Part0.CFrame:ToObjectSpace(part.CFrame) * before.rest * before.transform:Inverse()
			end
		end
		if not pose:FuzzyEq(before.pose, 1e-4) or size ~= before.size then
			local after = table.clone(before)
			after.pose, after.size = pose, size
			if not before.bone then
				after.world = motor.Part0.CFrame * pose * before.transform * before.rest:Inverse()
			end
			undoState.joints[motor], redoState.joints[motor] = before, after
			changed = true
		end
	end
	if not changed then return false, nil end
	restoreNativeJoints(redoState.joints)
	if recording then
		for motor, after in redoState.joints do
			undoState.buckets[motor] = timeline:_snapshotMotorBucket(motor)
			timeline:RecordKeyframeForMotorAtCurrentTime(after.part, motor, require("properties").basePose(motor, after.pose), { Frame = frame }, sanitize)
			redoState.buckets[motor] = timeline:_snapshotMotorBucket(motor)
		end
	end
	graphRootState.currentProjectSaved = false
	return true, recording and frame or nil
end

local function adoptStudioEdit(name)

	local undoState = {

		parts = {},

		scales = {},

		parents = {},

		pivots = {},

		rigid = {},

		buckets = {},

		defaults = {},

	}

	local redoState = {

		parts = {},

		scales = {},

		parents = {},

		pivots = {},

		rigid = {},

		buckets = {},

		defaults = {},

	}

	local edited = false



	local function comparePart(part, cf)

		if cf and part.Parent and undoState.parts[part] == nil then

			local now = part.CFrame

			if not now:FuzzyEq(cf, 1e-5) then

				undoState.parts[part], redoState.parts[part] = cf, now

				edited = true

			end

		end

	end



	local function compareScale(model, scale)

		if model.Parent and undoState.scales[model] == nil then

			local now = model:GetScale()

			if math.abs(now - scale) > 1e-6 then

				undoState.scales[model], redoState.scales[model] = scale, now

				edited = true

			end

		end

	end



	for part in movedParts do

		comparePart(part, placement.parts[part])

	end



	for model, scale in placement.scales do

		compareScale(model, scale)

	end



	if externalBefore then

		for part, cf in externalBefore.parts do

			comparePart(part, cf)

		end



		for model, scale in externalBefore.scales do

			compareScale(model, scale)

		end

	end



	local checked = {}

	local function comparePivot(model, cf)

		if cf and model.Parent and not checked[model] then

			checked[model] = true

			local now = model:GetPivot()

			if not now:FuzzyEq(cf, 1e-5) then

				undoState.pivots[model], redoState.pivots[model] = cf, now

				edited = true

			end



			if placement.pivots[model] ~= nil then

				placement.pivots[model] = now

			end

		end

	end



	if externalBefore then

		for model, cf in externalBefore.pivots do

			comparePivot(model, cf)

		end

	end



	for model, cf in placement.pivots do

		if movedWithin(model, undoState.parts) then

			comparePivot(model, cf)

		end

	end



	for model, before in undoState.pivots do

		local delta = redoState.pivots[model] * before:Inverse()

		local rigid = nil

		for part, cf in undoState.parts do

			if part:IsDescendantOf(model) then

				rigid = (delta * cf):FuzzyEq(redoState.parts[part], 1e-3)

				if not rigid then

					break

				end

			end

		end



		if rigid then

			undoState.rigid[model], redoState.rigid[model] = true, true

		end

	end



	for object, parent in trackedParents do

		if object.Parent == nil and undoState.parents[object] == nil then

			if restorable(object, parent) then

				undoState.parents[object], redoState.parents[object] = parent, false

				edited = true

			else

				untrackObject(object)

			end

		end

	end



	local jointEdited, jointFrame = adoptNativeJoints(undoState, redoState)
	edited = edited or jointEdited
	if edited then

		local keyed, keyError = pcall(keyPropertyMoves, undoState, redoState)

		if not keyed then

			warn("Eclipse could not key a Studio move:", keyError)

		end



		local entry

		entry = bindEntry(function()

			entry.inert = not applyPlacement(undoState)

		end, function()

			entry.inert = not applyPlacement(redoState)

		end, "Studio: " .. tostring(externalLabel or name), jointFrame or (keyed and keyError or nil))

		entry.external = true

		commit(entry, true)

	end



	return edited

end



local function syncStudio()

	if applyingUndoRedo or recordingOpen() then

		return false

	end



	if studioChanged() then

		local ok, canUndo, name = pcall(changeHistoryService.GetCanUndo, changeHistoryService)

		local mirrored = ok and canUndo and ownWaypoint(name)

		if ok and canUndo and not mirrored and (externalBefore or placementLive) and isActive() then

			local adopted, result = pcall(adoptStudioEdit, name)

			if not adopted then

				warn("Eclipse could not keep a Studio edit undoable:", result)

			end



			mirrored = adopted and result == true

		end



		if not ((mirrored or isActive()) and pcall(resetStudioWaypoints)) then

			markStudioBase()

		end

	elseif selectionDirty then

		pruneSelection(false)

	end



	externalBefore, externalLabel = nil, nil

	return true

end



local function routeShortcut(direction, source)

	local now = os.clock()

	local last = shortcutRoutes[direction]

	if last.source ~= nil and last.source ~= source and now - last.at < shortcutEcho then

		last.source = nil

		return false

	end



	last.source, last.at = source, now

	if direction == "redo" then

		return history.redo()

	end



	return history.undo()

end



local function routeNative(redo, name)

	if name == sentinel and not redo and armEchoes > 0 and os.clock() - armEchoAt < nativeEcho then

		armEchoes -= 1

		return

	end



	nativeChangedAt = os.clock()

	if name == sentinel then

		armEchoes = 0

	end



	if not sessionOpen() then

		markStudioBase()

		return

	end



	if name ~= sentinel then

		return

	end



	armed = false

	armPending, armForce = true, true

	if not applyingUndoRedo then

		routeShortcut(redo and "redo" or "undo", "native")

	end

end



local function beginExternal(name, displayName)

	local own = ownWaypoint(name)

	if own and type(displayName) == "string" and displayName ~= "" then

		ownLabels[displayName] = true

	end



	local entry = externalRecordings[name]

	if entry then

		entry.count += 1

		entry.at = os.clock()

	else

		externalRecordings[name] = { count = 1, at = os.clock() }

	end



	if own or not isActive() then

		return

	end



	externalLabel = externalLabel or displayName or name

	externalBefore = externalBefore or { parts = {}, scales = {}, pivots = {} }

	pcall(captureSelection, externalBefore)

end



local function finishExternal(name, displayNameValue, identifier, operation)

	if not ownWaypoint(name) and operation ~= Enum.FinishRecordingOperation.Cancel then

		studioEdited = true

	end



	local entry = externalRecordings[name]

	if entry then

		entry.count -= 1

		if entry.count <= 0 then

			externalRecordings[name] = nil

		end

	end

end



local function pruneExternal()

	if not next(externalRecordings) then

		return

	end



	local now = os.clock()

	for name, entry in externalRecordings do

		if now - entry.at > recordingTimeout then

			if

				nativeInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)

				or nativeInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)

			then

				entry.at = now

			else

				externalRecordings[name] = nil

			end

		end

	end

end



function history.revertingNative()

	local now = os.clock()

	return now - nativeChangedAt < revertTimeout or now - armEchoAt < armEcho

end



function history.shortcut(direction)

	return routeShortcut(direction == "redo" and "redo" or "undo", "key")

end



function history.nativeEcho()

	if armingStudio then

		return true

	end



	if not armed and armEchoes == 0 then

		return false

	end



	local echo = armEchoes > 0 and os.clock() - armEchoAt < nativeEcho

	if not echo and armed then

		local undoName, redoName = studioTop()

		echo = undoName == nil and redoName == sentinel or undoName == sentinel and redoName == nil

	end



	return echo and sameSelection()

end



function history.protectSavedAnimations()

	syncStudio()

	local ok, err = pcall(resetStudioWaypoints, true)

	if not ok then

		warn("Eclipse could not protect saved animations from Studio undo:", err)

	end



	return ok

end



local function jumpIfNeeded(entry, direction)

	if not entry then

		return

	end



	if not jumpToFrameCallback then

		return

	end



	local target = nil

	if direction == "undo" and entry.undoContextFrame ~= nil then

		target = entry.undoContextFrame

	elseif direction == "redo" and entry.redoContextFrame ~= nil then

		target = entry.redoContextFrame

	else

		target = entry.contextFrame

	end



	if target == nil then

		return

	end



	pcall(jumpToFrameCallback, target)

end



function history.record(undoFn, redoFn, description, contextFrame, redoContextFrame)

	if type(undoFn) ~= "function" or type(redoFn) ~= "function" then

		warn("History.record: undoFn and redoFn must be functions")

		return

	end



	if applyingUndoRedo then

		return

	end



	local entry = bindEntry(undoFn, redoFn, description, contextFrame, redoContextFrame)

	local batch = batches[coroutine.running()]

	if batch then

		table.insert(batch, entry)

		return

	end



	syncStudio()

	commit(entry)

	return entry

end



function history.isLatest(entry)

	return entry ~= nil and not applyingUndoRedo and #redoStack == 0 and undoStack[#undoStack] == entry

end



function history.batch(description, callback)

	local thread = coroutine.running()

	if batches[thread] then

		return callback()

	end

	local entries = {}

	batches[thread] = entries

	local result = table.pack(xpcall(callback, debug.traceback))

	batches[thread] = nil

	if #entries > 0 then

		syncStudio()

		commit({

			description = description or entries[1].description,

			undoContextFrame = entries[1].undoContextFrame,

			redoContextFrame = entries[#entries].redoContextFrame,

			undo = function()

				local done = #entries + 1

				local ok, err = pcall(function()

					for i = #entries, 1, -1 do

						entries[i].undo()

						if entries[i].afterUndo then

							entries[i].afterUndo()

						end

						done = i

					end

				end)

				if not ok then

					for i = done, #entries do

						pcall(entries[i].redo)

					end



					error(err, 0)

				end

			end,

			redo = function()

				local done = 0

				local ok, err = pcall(function()

					for i, entry in entries do

						entry.redo()

						if entry.afterRedo then

							entry.afterRedo()

						end

						done = i

					end

				end)

				if not ok then

					for i = done, 1, -1 do

						pcall(entries[i].undo)

					end



					error(err, 0)

				end

			end,

		})

	end

	if not result[1] then

		error(result[2], 0)

	end

	return table.unpack(result, 2, result.n)

end



local generation = 0



function history.generation()

	return generation

end



function history.capture(entries, callback)

	local thread = coroutine.running()

	local outer = batches[thread]

	batches[thread] = entries

	local result = table.pack(pcall(callback))

	batches[thread] = outer

	if not result[1] then

		error(result[2], 0)

	end



	return table.unpack(result, 2, result.n)

end



function history.commitGroup(description, entries)

	if #entries == 0 or applyingUndoRedo then

		return nil

	end



	local outer = batches[coroutine.running()]

	if outer then

		table.move(entries, 1, #entries, #outer + 1, outer)

		return nil

	end



	if #entries == 1 then

		syncStudio()

		commit(entries[1])

		return entries[1]

	end



	history.batch(description, function()

		local target = batches[coroutine.running()]

		table.move(entries, 1, #entries, #target + 1, target)

	end)

	return undoStack[#undoStack]

end



function history.merge(description, entries)

	local count = #entries

	if count < 2 or applyingUndoRedo or #redoStack > 0 or count > #undoStack then

		return false

	end



	local offset = #undoStack - count

	for index, entry in entries do

		if undoStack[offset + index] ~= entry then

			return false

		end

	end



	for index = #undoStack, offset + 1, -1 do

		undoStack[index] = nil

	end



	history.commitGroup(description, entries)

	return true

end



function history.revertGroup(entries)

	local applying = applyingUndoRedo

	applyingUndoRedo = true

	local ok, err = pcall(function()

		for index = #entries, 1, -1 do

			entries[index].undo()

			if entries[index].afterUndo then

				entries[index].afterUndo()

			end

		end

	end)

	applyingUndoRedo = applying

	table.clear(entries)

	if not ok then

		error(err, 0)

	end

end



function history.undo()

	local setup = graphRootState.LimbPointSetupActive

	if setup then

		return setup:undo()

	end

	local picker = require("picker")

	if picker.isOpen() then

		if blenderEdit.blocked(true) then

			return false

		end



		return picker.undo()

	end



	if graphRootState.PivotEditor and graphRootState.PivotEditor.isActive() then

		graphRootState.PivotEditor.undo()

		return

	end



	if

		graphRootState.LiveSession

		and graphRootState.LiveSession.isJoined()

		and graphRootState.LiveSession.undo

	then

		task.spawn(graphRootState.LiveSession.undo)

		return

	end



	if blenderEdit.blocked(true) then

		return

	end



	if applyingUndoRedo or projectBusy() then

		return false, nil

	end



	if graphRootState.GreasePencil and graphRootState.GreasePencil.isDrawing() then

		graphRootState.GreasePencil.cancelStroke()

	end



	if beforeUndoRedo then

		beforeUndoRedo()

	end



	syncStudio()

	local action = table.remove(undoStack)

	if not action then

		if guardCleanupCallback then

			pcall(guardCleanupCallback)

		end



		return false, nil

	end



	local undoTimeline = graphRootState.Timeline

	if undoTimeline and undoTimeline.GetState then

		undoTimeline:GetState().Playing = false

	end



	applyingUndoRedo = true

	local ok, err = pcall(function()

		action.undo()

		jumpIfNeeded(action, "undo")

		if action.afterUndo then

			action.afterUndo()

		end

	end)

	applyingUndoRedo = false



	if not ok then

		warn("History undo failed:", err)

		if action.external then

			changed()

			return history.undo()

		end



		push(undoStack, action)

		return false, nil

	end



	push(redoStack, action)

	pcall(function()

		require("motionPath").markDirty()

	end)



	graphRootState.currentProjectSaved = false

	if not action.external then

		sessionDirty = true

	end



	changed()

	if action.external and action.inert then

		return history.undo()

	end



	return true, action.description

end



function history.redo()

	local setup = graphRootState.LimbPointSetupActive

	if setup then

		return setup:redo()

	end

	local picker = require("picker")

	if picker.isOpen() then

		if blenderEdit.blocked(true) then

			return false

		end



		return picker.redo()

	end



	if graphRootState.PivotEditor and graphRootState.PivotEditor.isActive() then

		graphRootState.PivotEditor.redo()

		return

	end



	if

		graphRootState.LiveSession

		and graphRootState.LiveSession.isJoined()

		and graphRootState.LiveSession.redo

	then

		task.spawn(graphRootState.LiveSession.redo)

		return

	end



	if blenderEdit.blocked(true) then

		return

	end



	if applyingUndoRedo or projectBusy() then

		return false, nil

	end



	if graphRootState.GreasePencil and graphRootState.GreasePencil.isDrawing() then

		graphRootState.GreasePencil.cancelStroke()

	end



	if beforeUndoRedo then

		beforeUndoRedo()

	end



	syncStudio()

	local action = table.remove(redoStack)

	if not action then

		return false, nil

	end



	local redoTimeline = graphRootState.Timeline

	if redoTimeline and redoTimeline.GetState then

		redoTimeline:GetState().Playing = false

	end



	applyingUndoRedo = true

	local ok, err = pcall(function()

		action.redo()

		jumpIfNeeded(action, "redo")

		if action.afterRedo then

			action.afterRedo()

		end

	end)

	applyingUndoRedo = false



	if not ok then

		warn("History redo failed:", err)

		if action.external then

			changed()

			return history.redo()

		end



		push(redoStack, action)

		return false, nil

	end



	push(undoStack, action)

	pcall(function()

		require("motionPath").markDirty()

	end)



	graphRootState.currentProjectSaved = false

	if not action.external then

		sessionDirty = true

	end



	changed()

	if action.external and action.inert then

		return history.redo()

	end



	return true, action.description

end



function history.clear()

	generation += 1

	table.clear(undoStack)

	table.clear(redoStack)

	externalBefore, externalLabel = nil, nil

	table.clear(movedParts)

	placementRefreshAt = 0

	placementLive = false

	if sessionDirty and not next(externalRecordings) then

		local ok, err = pcall(resetStudioWaypoints, true)

		if not ok then

			warn("Eclipse could not protect saved animations from Studio undo:", err)

		end

	else

		markStudioBase()

	end



	changed()

end



function history.hasAnimationEdits()

	for _, entry in undoStack do

		if entry.description ~= "Add rig" then

			return true

		end

	end



	return false

end



function history.canUndo()

	local setup = graphRootState.LimbPointSetupActive

	if setup then

		return setup.editBefore ~= nil or #setup.undoStack > 0

	end

	return #undoStack > 0

end



function history.canRedo()

	local setup = graphRootState.LimbPointSetupActive

	if setup then

		return not setup.editBefore and #setup.redoStack > 0

	end

	return #redoStack > 0

end



function history.getStats()

	return {

		undo = #undoStack,

		redo = #redoStack,

		max = maxSize,

		undoTotal = #undoStack,

		redoTotal = #redoStack,

	}

end



function history.setMaxSize(n)

	maxSize = math.max(1, math.floor(n))

end



function history.setNotifyHandler(fn)

	onNotify = fn

end



function history.setJumpToFrame(fn)

	jumpToFrameCallback = fn

end



function history.setGuardCleanup(fn)

	guardCleanupCallback = fn

end



function history.setBeforeUndoRedo(fn)

	beforeUndoRedo = fn

end



function history.setActiveCheck(fn)

	activeCheckFn = fn

end



function history.setGuardCallbacks(cbs)

	guardCallbacks = cbs or {}

end



function history.setGuardExpiry(seconds) end



function history.armGuard() end



local function isCtrlHeld()

	return userInputService:IsKeyDown(Enum.KeyCode.LeftControl)

		or userInputService:IsKeyDown(Enum.KeyCode.RightControl)

end



local function isShiftHeld()

	return userInputService:IsKeyDown(Enum.KeyCode.LeftShift)

		or userInputService:IsKeyDown(Enum.KeyCode.RightShift)

end



function history.init(markerInst)

	for _, c in connections do

		c:Disconnect()

	end



	table.clear(connections)

	table.clear(externalRecordings)

	for _, pair in

		{ { "OnRecordingStarted", beginExternal }, { "OnRecordingFinished", finishExternal } }

	do

		local ok, signal = pcall(function()

			return changeHistoryService[pair[1]]

		end)

		if ok and signal then

			table.insert(connections, signal:Connect(pair[2]))

		end

	end



	for _, pair in { { "OnUndo", false }, { "OnRedo", true } } do

		local ok, signal = pcall(function()

			return changeHistoryService[pair[1]]

		end)

		if ok and signal then

			table.insert(

				connections,

				signal:Connect(function(name)

					routeNative(pair[2], name)

				end)

			)

		end

	end



	table.insert(connections, selection.SelectionChanged:Connect(trackSelection))

	sessionWasOpen = false

	armed, armPending, armForce, armEchoes = false, false, false, 0

	markStudioBase()



	table.insert(

		connections,

		userInputService.InputBegan:Connect(function(input, gameProcessed)

			if input.UserInputType ~= Enum.UserInputType.Keyboard then

				return

			end



			if userInputService:GetFocusedTextBox() then

				return

			end



			if not isActive() then

				return

			end



			local direction

			if

				shortcuts.matches("Redo", input)

				or shortcuts.matches("RedoAlternate", input)

				or shortcuts.matches("RedoShift", input)

			then

				direction = "redo"

			elseif

				shortcuts.matches("Undo", input) or shortcuts.matches("UndoAlternate", input)

			then

				direction = "undo"

			end



			if direction and not shortcutHeld[input.KeyCode] then

				shortcutHeld[input.KeyCode] =

					{ input = input, direction = direction, nextAt = os.clock() + 0.65 }

				routeShortcut(direction, "key")

			end

		end)

	)



	table.insert(

		connections,

		userInputService.InputEnded:Connect(function(input)

			shortcutHeld[input.KeyCode] = nil

		end)

	)

	table.insert(

		connections,

		userInputService.WindowFocusReleased:Connect(function()

			table.clear(shortcutHeld)

		end)

	)

	table.insert(

		connections,

		runService.Heartbeat:Connect(function()

			for key, held in shortcutHeld do

				local active = userInputService:IsKeyDown(key)

					and isActive()

					and userInputService.isWindowFocused()

					and not userInputService:GetFocusedTextBox()

				local matches = held.direction == "undo"

						and (shortcuts.matches("Undo", held.input) or shortcuts.matches(

							"UndoAlternate",

							held.input

						))

					or held.direction == "redo"

						and (shortcuts.matches("Redo", held.input) or shortcuts.matches(

							"RedoAlternate",

							held.input

						) or shortcuts.matches("RedoShift", held.input))

				if not active or not matches then

					shortcutHeld[key] = nil

				elseif os.clock() >= held.nextAt then

					held.nextAt = os.clock() + 0.18

					routeShortcut(held.direction, "key")

				end

			end



			pruneExternal()

			local open = sessionOpen()

			if open ~= sessionWasOpen then

				sessionWasOpen = open

				if open then

					armPending, armForce = true, true

					if

						not (

							not applyingUndoRedo

							and not recordingOpen()

							and pcall(resetStudioWaypoints)

						)

					then

						markStudioBase()

					end

				else

					pcall(disarmStudio)

					markStudioBase()

				end

			end



			if

				not open

				and sessionDirty

				and not applyingUndoRedo

				and not next(externalRecordings)

			then

				pcall(resetStudioWaypoints, true)

			end



			if not isActive() then

				placementLive = false

				externalBefore, externalLabel = nil, nil

				if open then

					maintainArm(false)

				end



				return

			end



			if not placementLive then

				if next(externalRecordings) then

					return

				end



				pcall(refreshPlacementParts, true)

				markStudioBase()

			end



			if syncStudio() then

				if os.clock() >= placementRefreshAt then

					pcall(refreshPlacementParts)

				end



				settlePlacement()

				placementLive = true

			end



			maintainArm(true)

		end)

	)

end



function history.disconnect()

	if not next(externalRecordings) then

		pcall(disarmStudio)

		if sessionDirty then

			sessionDirty = false

			pcall(clearStudioStack)

		end

	end



	armed = false



	table.clear(shortcutHeld)

	table.clear(externalRecordings)

	placementLive = false

	for rig in rigCandidates do

		forgetRigParts(rig)

	end



	for part in watchedParts do

		unwatchPart(part)

	end



	table.clear(knownRigs)

	for object in trackedLinks do

		untrackObject(object)

	end



	placementDirty = true

	for _, c in connections do

		c:Disconnect()

	end



	table.clear(connections)

end



return history

]]></ProtectedString>
						<string name="ScriptGuid">{4DD27190-74E5-4E01-83E5-5A4846D3FC42}</string>
