							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local assetId = require(script.Parent.assetId)

local SoundHost = {}
SoundHost.__index = SoundHost

SoundHost.widgetId = "ArcAudioHost"
SoundHost.widgetTitle = "Arc Audio"
SoundHost.proxyAttribute = "ArcSoundProxy"
SoundHost.syncedProperties = { "Volume", "PlaybackSpeed", "Looped" }
SoundHost.shared = nil
SoundHost.silent = nil

function SoundHost.new(pluginObject: Plugin?, widget: Instance?)
	local self = setmetatable({}, SoundHost)

	self.plugin = pluginObject
	self.widget = widget
	self.ownsWidget = widget == nil
	self.creating = false
	self.records = {}

	return self
end

function SoundHost.install(pluginObject: Plugin?)
	if SoundHost.shared then
		SoundHost.shared:destroy()
	end

	SoundHost.shared = SoundHost.new(pluginObject)

	return SoundHost.shared
end

function SoundHost.get()
	if SoundHost.shared then
		return SoundHost.shared
	end

	if not SoundHost.silent then
		SoundHost.silent = SoundHost.new(nil)
	end

	return SoundHost.silent
end

function SoundHost.createPlayer()
	return {
		prepare = function(sound: Sound)
			SoundHost.get():prepare(sound)
		end,
		play = function(sound: Sound, offset: number?)
			SoundHost.get():play(sound, offset)
		end,
		stop = function(sound: Instance)
			SoundHost.get():stop(sound)
		end,
		sync = function(sound: Sound)
			SoundHost.get():sync(sound)
		end,
		release = function(sound: Instance)
			SoundHost.get():release(sound)
		end,
	}
end

function SoundHost:getWidget(): Instance?
	if self.widget then
		return self.widget
	end

	if not self.plugin or self.creating then
		return nil
	end

	self.creating = true

	local success, widget = pcall(function()
		local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, true, 200, 100, 200, 100)

		return self.plugin:CreateDockWidgetPluginGui(SoundHost.widgetId, info)
	end)

	self.creating = false

	if not success or not widget then
		return nil
	end

	widget.Name = SoundHost.widgetId
	widget.Title = SoundHost.widgetTitle
	widget.Enabled = false
	self.widget = widget

	return widget
end

function SoundHost:canPlay(): boolean
	return self:getWidget() ~= nil
end

function SoundHost:getProxy(source: Instance): Sound?
	local record = self.records[source]

	return if record then record.sound else nil
end

function SoundHost:isPlaying(source: Instance): boolean
	local record = self.records[source]

	return record ~= nil and record.sound.IsPlaying
end

function SoundHost:getCount(): number
	local count = 0

	for _, record in self.records do
		if record.sound.IsPlaying then
			count += 1
		end
	end

	return count
end

function SoundHost:ensure(source: Sound): Sound?
	local widget = self:getWidget()
	local id = assetId.normalize(source.SoundId)
	local record = self.records[source]

	if not widget or id == "" then
		self:release(source)
		return nil
	end

	if record and record.id == id and record.sound.Parent == widget then
		return record.sound
	end

	self:release(source)

	local success, proxy = pcall(function()
		return source:Clone()
	end)

	if not success or not proxy then
		return nil
	end

	proxy.Playing = false
	proxy.SoundId = id
	proxy:SetAttribute(SoundHost.proxyAttribute, true)
	proxy.Parent = widget
	self.records[source] = { sound = proxy, id = id }

	return proxy
end

function SoundHost:prepare(source: Sound)
	self:ensure(source)
end

function SoundHost:sync(source: Sound)
	local record = self.records[source]

	if not record then
		return
	end

	local proxy = record.sound

	for _, name in SoundHost.syncedProperties do
		local value = (source :: any)[name]

		if (proxy :: any)[name] ~= value then
			(proxy :: any)[name] = value
		end
	end
end

function SoundHost:play(source: Sound, offset: number?): Sound?
	local proxy = self:ensure(source)

	if not proxy then
		return nil
	end

	self:sync(source)
	proxy.TimePosition = math.max(offset or 0, 0)
	proxy:Play()

	return proxy
end

function SoundHost:stop(source: Instance)
	local record = self.records[source]

	if record and record.sound.Parent then
		record.sound:Stop()
	end
end

function SoundHost:release(source: Instance)
	local record = self.records[source]

	if not record then
		return
	end

	self.records[source] = nil
	record.sound:Stop()
	record.sound:Destroy()
end

function SoundHost:stopAll()
	for source in self.records do
		self:stop(source)
	end
end

function SoundHost:releaseAll()
	local sources = {}

	for source in self.records do
		table.insert(sources, source)
	end

	for _, source in sources do
		self:release(source)
	end
end

function SoundHost:destroy()
	self:releaseAll()

	if self.widget and self.ownsWidget then
		self.widget:Destroy()
	end

	self.widget = nil

	if SoundHost.shared == self then
		SoundHost.shared = nil
	end
end

return SoundHost
]]></ProtectedString>
