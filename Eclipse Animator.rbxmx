						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local FxLayout = {}
FxLayout.__index = FxLayout

local step = 8

function FxLayout.new(options)
	local self = setmetatable({
		margin = options and options.margin or 12,
		gap = options and options.gap or 8,
		placed = {},
	}, FxLayout)

	return self
end

function FxLayout.snap(value)
	return math.floor(value / step + 0.5) * step
end

function FxLayout:reset(screen)
	self.screen = screen
	table.clear(self.placed)
end

function FxLayout:block(position, size, id)
	table.insert(self.placed, { position = position, size = size, id = id })
end

function FxLayout:firstOverlap(position, size, ignore)
	local gap = self.gap
	for _, other in self.placed do
		if other.id == nil or other.id ~= ignore then
			local a1, a2 = position, position + size
			local b1, b2 = other.position, other.position + other.size
			if a1.X < b2.X + gap and a2.X + gap > b1.X and a1.Y < b2.Y + gap and a2.Y + gap > b1.Y then
				return other
			end
		end
	end

	return nil
end

function FxLayout:overlaps(position, size, ignore)
	return self:firstOverlap(position, size, ignore) ~= nil
end

function FxLayout.share(items, available)
	local result = {}
	local total = 0
	for index, item in items do
		result[index] = item.preferred
		total += item.preferred
	end

	if total <= available then
		return result
	end

	local pinned = {}
	for _ = 1, #items do
		local flexible, fixed = 0, 0
		for index, item in items do
			if pinned[index] then
				fixed += item.minimum
			else
				flexible += item.preferred
			end
		end

		local ratio = flexible > 0 and math.clamp((available - fixed) / flexible, 0, 1) or 0
		local changed = false
		for index, item in items do
			if pinned[index] then
				result[index] = item.minimum
			else
				local value = math.floor(item.preferred * ratio)
				if value < item.minimum then
					pinned[index] = true
					changed = true
					value = item.minimum
				end

				result[index] = value
			end
		end

		if not changed then
			break
		end
	end

	return result
end

function FxLayout.rectFrom(anchor, direction, size)
	return Vector2.new(
		direction.X < 0 and anchor.X - size.X or anchor.X,
		direction.Y < 0 and anchor.Y - size.Y or anchor.Y
	)
end

function FxLayout:room(anchor, direction)
	local margin = self.margin
	local screen = self.screen
	return Vector2.new(
		direction.X < 0 and anchor.X - margin or screen.X - margin - anchor.X,
		direction.Y < 0 and anchor.Y - margin or screen.Y - margin - anchor.Y
	)
end

function FxLayout:fit(anchor, direction, preferred, minimum, ignore)
	local gap = self.gap
	local room = self:room(anchor, direction)
	local width = math.floor(math.min(preferred.X, room.X))
	local height = math.floor(math.min(preferred.Y, room.Y))
	if width < minimum.X or height < minimum.Y then
		return nil
	end

	for _ = 1, #self.placed + 1 do
		local size = Vector2.new(width, height)
		local position = FxLayout.rectFrom(anchor, direction, size)
		if not self:inside(position, size) then
			return nil
		end

		local blocker = self:firstOverlap(position, size, ignore)
		if not blocker then
			return position, size
		end

		local near = blocker.position
		local far = blocker.position + blocker.size
		local cutWidth = math.floor(direction.X < 0 and anchor.X - far.X - gap or near.X - gap - anchor.X)
		local cutHeight = math.floor(direction.Y < 0 and anchor.Y - far.Y - gap or near.Y - gap - anchor.Y)
		local canWidth = cutWidth >= minimum.X and cutWidth < width
		local canHeight = cutHeight >= minimum.Y and cutHeight < height
		if canWidth and canHeight then
			if cutWidth * height >= width * cutHeight then
				width = cutWidth
			else
				height = cutHeight
			end
		elseif canWidth then
			width = cutWidth
		elseif canHeight then
			height = cutHeight
		else
			return nil
		end
	end

	return nil
end

function FxLayout:inside(position, size)
	local margin = self.margin
	local screen = self.screen
	return position.X >= margin - 0.5
		and position.Y >= margin - 0.5
		and position.X + size.X <= screen.X - margin + 0.5
		and position.Y + size.Y <= screen.Y - margin + 0.5
end

function FxLayout:clampInside(position, size)
	local margin = self.margin
	local screen = self.screen
	return Vector2.new(
		math.clamp(position.X, margin, math.max(margin, screen.X - margin - size.X)),
		math.clamp(position.Y, margin, math.max(margin, screen.Y - margin - size.Y))
	)
end

function FxLayout:free(position, size, ignore)
	return self:inside(position, size) and not self:overlaps(position, size, ignore)
end

function FxLayout:slide(position, size, axis, direction, ignore)
	if self:free(position, size, ignore) then
		return position, true
	end

	local limit = axis == "X" and self.screen.X or self.screen.Y
	local offset = axis == "X" and Vector2.new(step, 0) or Vector2.new(0, step)
	local count = math.ceil(limit / step)
	for index = 1, count do
		if direction ~= -1 then
			local forward = position + offset * index
			if self:free(forward, size, ignore) then
				return forward, true
			end
		end

		if direction ~= 1 then
			local backward = position - offset * index
			if self:free(backward, size, ignore) then
				return backward, true
			end
		end
	end

	return position, false
end

function FxLayout:fitSliding(anchor, direction, preferred, minimum, ignore, axis)
	local offset = axis == "X" and Vector2.new(step, 0) or Vector2.new(0, step)
	local limit = axis == "X" and self.screen.X or self.screen.Y
	local forward = axis == "X" and direction.X or direction.Y
	for index = 0, math.ceil(limit / step) do
		for _, sign in { forward, -forward } do
			if index > 0 or sign == forward then
				local position, size = self:fit(anchor + offset * index * sign, direction, preferred, minimum, ignore)
				if position then
					return position, size
				end
			end
		end
	end

	return nil
end

function FxLayout:nearestEdge(point)
	local screen = self.screen
	local distances = {
		{ edge = "Left", value = point.X },
		{ edge = "Right", value = screen.X - point.X },
		{ edge = "Top", value = point.Y },
		{ edge = "Bottom", value = screen.Y - point.Y },
	}
	table.sort(distances, function(a, b)
		return a.value < b.value
	end)
	return distances[1].edge
end

function FxLayout:edgePosition(edge, along, size)
	local margin = self.margin
	local screen = self.screen
	if edge == "Left" then
		return Vector2.new(margin, along)
	elseif edge == "Right" then
		return Vector2.new(screen.X - margin - size.X, along)
	elseif edge == "Top" then
		return Vector2.new(along, margin)
	end

	return Vector2.new(along, screen.Y - margin - size.Y)
end

function FxLayout.edgeAxis(edge)
	return (edge == "Left" or edge == "Right") and "Y" or "X"
end

function FxLayout:alongFromPoint(edge, point, size)
	if FxLayout.edgeAxis(edge) == "Y" then
		return FxLayout.snap(point.Y - size.Y / 2)
	end

	return FxLayout.snap(point.X - size.X / 2)
end

function FxLayout:placeOnEdge(edge, along, size, ignore)
	local axis = FxLayout.edgeAxis(edge)
	local position = self:edgePosition(edge, along, size)
	position = self:clampInside(position, size)
	if axis == "X" then
		position = Vector2.new(FxLayout.snap(position.X), position.Y)
	else
		position = Vector2.new(position.X, FxLayout.snap(position.Y))
	end

	position = self:clampInside(position, size)
	return self:slide(position, size, axis, 0, ignore)
end

function FxLayout:edgeAnchor(edge, position, size)
	if edge == "Right" then
		return Vector2.new(position.X + size.X, position.Y), Vector2.new(-1, 1)
	elseif edge == "Bottom" then
		return Vector2.new(position.X, position.Y + size.Y), Vector2.new(1, -1)
	end

	return position, Vector2.new(1, 1)
end

function FxLayout:dock(edge, along, preferred, minimum, ignore)
	local position, placed = self:placeOnEdge(edge, along, preferred, ignore)
	if placed then
		return position, preferred
	end

	local desired = self:clampInside(self:edgePosition(edge, along, preferred), preferred)
	local anchor, direction = self:edgeAnchor(edge, desired, preferred)
	local fitted, size = self:fit(anchor, direction, preferred, minimum, ignore)
	if fitted then
		return fitted, size
	end

	local axis = FxLayout.edgeAxis(edge)
	local across = axis == "X" and "Y" or "X"
	for _, slideAxis in { axis, across } do
		local slid, fittedSize = self:fitSliding(anchor, direction, preferred, minimum, ignore, slideAxis)
		if slid then
			return slid, fittedSize
		end
	end

	return desired, preferred
end

local centerAnchor = Vector2.new(0.5, 0.5)
local layoutClasses = { "UIListLayout", "UIGridLayout", "UITableLayout", "UIPageLayout" }
local constraintClasses = { "UIAspectRatioConstraint", "UISizeConstraint" }

local function hasChildOf(object, classes)
	for _, child in object:GetChildren() do
		if table.find(classes, child.ClassName) then
			return true
		end
	end

	return false
end

function FxLayout.center(object)
	if not object:IsA("GuiObject") or object.AnchorPoint == centerAnchor then
		return
	end

	if object.AutomaticSize ~= Enum.AutomaticSize.None or hasChildOf(object, constraintClasses) then
		return
	end

	local parent = object.Parent
	if parent and hasChildOf(parent, layoutClasses) then
		return
	end

	local anchor, size, position = object.AnchorPoint, object.Size, object.Position
	local dx, dy = 0.5 - anchor.X, 0.5 - anchor.Y
	object.AnchorPoint = centerAnchor
	object.Position = UDim2.new(
		position.X.Scale + size.X.Scale * dx,
		position.X.Offset + size.X.Offset * dx,
		position.Y.Scale + size.Y.Scale * dy,
		position.Y.Offset + size.Y.Offset * dy
	)
end

function FxLayout.centerTree(root, skip)
	local function visit(object)
		FxLayout.center(object)
		if skip and skip[object] then
			return
		end

		for _, child in object:GetChildren() do
			visit(child)
		end
	end

	visit(root)
end

function FxLayout.centered(position, size)
	return UDim2.fromOffset(position.X + size.X / 2, position.Y + size.Y / 2)
end

return FxLayout
]]></ProtectedString>
