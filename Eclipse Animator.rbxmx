					<Item class="ModuleScript" referent="RBXF4BE59F1F12A443F9FB8FB847FF06F01">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local utilities = require(script.Parent.utilities)
local collectionService = game:GetService("CollectionService")

local fragments = {}

function fragments.accepts(source)
    if not source:IsA("BasePart") or not source.Parent or source.Parent.Name ~= "Debris" then
        return false
    end
    if source:GetAttribute("Amount") ~= nil then
        return true
    end
    local ancestor = source.Parent
    while ancestor and ancestor ~= workspace do
        if ancestor:IsA("Attachment") and collectionService:HasTag(ancestor, "Shockwave") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function originFor(source)
    local ancestor = source.Parent
    while ancestor do
        if ancestor:IsA("Attachment") or ancestor:IsA("BasePart") then
            return ancestor
        end
        ancestor = ancestor.Parent
    end
    return source
end

local function stripConnections(copy)
    for _, child in copy:GetDescendants() do
        if child:IsA("JointInstance") or child:IsA("WeldConstraint")
            or child:IsA("LuaSourceContainer") or child:IsA("Constraint") then
            child:Destroy()
        end
    end
end

function fragments.emit(context, source)
    local attributes = source:GetAttributes()
    local origin = originFor(source)
    local queryAttributes = origin:GetAttributes()
    local amount = attributes.Amount
    if typeof(amount) == "NumberRange" then
        amount = utilities.random:NextInteger(math.floor(amount.Min), math.floor(amount.Max))
    else
        amount = math.floor(utilities.sample(amount, 1))
    end
    amount = math.max(0, amount)
    context.Schedule(utilities.sample(attributes.EmitDelay, 0), function()
        if not source.Parent then
            return
        end
        local frame = utilities.getCFrame(origin)
        local params = RaycastParams.new()
        local excluded = { context.Root, context.Container }
        local tag = queryAttributes.FilterTag
        local tagged = typeof(tag) == "string" and tag ~= "" and collectionService:GetTagged(tag) or {}
        if queryAttributes.FilterType == "Include" then
            params.FilterType = Enum.RaycastFilterType.Include
            params.FilterDescendantsInstances = tagged
        else
            for _, item in tagged do
                table.insert(excluded, item)
            end
            params.FilterDescendantsInstances = excluded
        end
        params.RespectCanCollide = queryAttributes.IgnoreCanCollide ~= true
        params.CollisionGroup = queryAttributes.RayCollisionGroup or "Default"

        local surfaces = {}
        if attributes.InheritanceEnabled then
            local overlap = OverlapParams.new()
            overlap.FilterType = params.FilterType
            overlap.FilterDescendantsInstances = params.FilterDescendantsInstances
            overlap.RespectCanCollide = params.RespectCanCollide
            overlap.CollisionGroup = params.CollisionGroup
            overlap.MaxParts = math.max(0, math.floor(utilities.sample(attributes.InheritanceMaxResults, 0)))
            surfaces = workspace:GetPartBoundsInRadius(frame.Position,
                math.max(0, utilities.sample(attributes.InheritanceRadius, 5)), overlap)
        end

        for _ = 1, amount do
            local copy = context.Own(source:Clone())
            utilities.cleanClone(copy)
            stripConnections(copy)
            copy.Name = source.Name .. "_Fragment"
            copy.Anchored = true
            copy.CanCollide = false
            copy.CanTouch = false
            copy.CanQuery = false
            local size = utilities.randomVector(attributes.MinSize or source.Size, attributes.MaxSize or source.Size)
                :Max(Vector3.one * 0.001)
            copy.Size = size
            copy.CFrame = frame
            copy.Transparency = math.clamp(utilities.sample(attributes.Transparency_Start, source.Transparency), 0, 1)
            if #surfaces > 0 then
                local surface = surfaces[utilities.random:NextInteger(1, #surfaces)]
                copy.Color = surface.Color
                copy.Material = surface.Material
                copy.MaterialVariant = surface.MaterialVariant
            end
            copy.Parent = context.Container
            local direction = utilities.randomVector(attributes.MinDirection or -Vector3.one,
                attributes.MaxDirection or Vector3.one)
            direction = direction.Magnitude > 0.0001 and direction.Unit or Vector3.yAxis
            local flightTime = math.max(1 / 60, utilities.sample(attributes.Airtime, 0.5))
            local destination = frame.Position + frame:VectorToWorldSpace(direction)
                * utilities.sample(attributes.LinearMagnitude, 0)
            local control = frame.Position:Lerp(destination, 0.5)
                + Vector3.yAxis * (workspace.Gravity * flightTime * flightTime / 4)
            local spin = utilities.randomVector(-Vector3.one, Vector3.one)
            spin = spin.Magnitude > 0.0001 and spin.Unit or Vector3.yAxis
            local spinSpeed = utilities.sample(attributes.AngularMagnitude, 0)
            local lifetime = math.max(0, utilities.sample(attributes.Lifetime, 1))
            local fadeTime = math.max(0, utilities.sample(attributes.Transparency_Duration, 0))
            local shrinkTime = math.max(0, utilities.sample(attributes.Size_Duration, 0))
            local finishSize = size * (attributes.SizeScaleEnd or Vector3.one)
            local startAlpha = copy.Transparency
            local finishAlpha = utilities.sample(attributes.Transparency_End, startAlpha)
            local position = frame.Position
            local turn = frame.Rotation
            local landed = false
            local totalTime = lifetime + math.max(fadeTime, shrinkTime)
            local branch = { finished = false, after = {} }
            for _, child in copy:GetChildren() do
                context.Walk(child, branch)
            end
            context.Handle.Stats.Fragments += 1
            context.Animate(totalTime, function(_, deltaTime, age)
                if not copy.Parent then
                    return
                end
                local remaining = deltaTime
                while remaining > 0 and not landed do
                    local tick = math.min(remaining, 1 / 60)
                    remaining -= tick
                    local phase = (age - remaining) / flightTime
                    local incoming = frame.Position:Lerp(control, phase)
                    local outgoing = control:Lerp(destination, phase)
                    local nextPosition = incoming:Lerp(outgoing, phase)
                    local travel = nextPosition - position
                    local hit = workspace:Raycast(position, travel, params)
                    if hit then
                        position = hit.Position + hit.Normal * (size.Y * 0.5)
                        landed = true
                    else
                        position = nextPosition
                        turn *= CFrame.fromAxisAngle(spin, spinSpeed * tick)
                    end
                end
                copy.CFrame = CFrame.new(position) * turn
                local ending = math.max(0, age - lifetime)
                local fade = age < lifetime and 0 or (fadeTime > 0 and math.min(ending / fadeTime, 1) or 1)
                local shrink = age < lifetime and 0 or (shrinkTime > 0 and math.min(ending / shrinkTime, 1) or 1)
                copy.Transparency = math.clamp(utilities.mix(startAlpha, finishAlpha,
                    utilities.curve(attributes.Transparency_Curve, fade)), 0, 1)
                copy.Size = size:Lerp(finishSize, utilities.curve(attributes.Size_Curve, shrink))
                    :Max(Vector3.one * 0.001)
            end, function()
                utilities.closeBranch(branch)
                utilities.hideGeometry(copy)
            end, source)
        end
    end, source)
end

return fragments
]]></ProtectedString>
