							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local sequenceTools = require(script.Parent.sequenceTools)

local spatialValue = {}

spatialValue.minimumSize = 0.001
spatialValue.maximumLightRange = 60
spatialValue.axes = {
	X = Vector3.xAxis,
	Y = Vector3.yAxis,
	Z = Vector3.zAxis,
}
spatialValue.axisNames = { "X", "Y", "Z" }

function spatialValue.isSpatial(instance: Instance): boolean
	return instance:IsA("PVInstance") or instance:IsA("Attachment")
end

function spatialValue.getPivot(instance: Instance): CFrame?
	if instance:IsA("PVInstance") then
		return instance:GetPivot()
	elseif instance:IsA("Attachment") then
		return instance.WorldCFrame
	end

	return nil
end

function spatialValue.setPivot(instance: Instance, cframe: CFrame)
	if instance:IsA("PVInstance") then
		instance:PivotTo(cframe)
	elseif instance:IsA("Attachment") then
		instance.WorldCFrame = cframe
	end
end

function spatialValue.filter(instances: { Instance }): { Instance }
	local spatial = {}

	for _, instance in instances do
		if spatialValue.isSpatial(instance) then
			table.insert(spatial, instance)
		end
	end

	return spatial
end

function spatialValue.getCenter(instances: { Instance }): Vector3?
	local total = Vector3.zero
	local count = 0

	for _, instance in instances do
		local pivot = spatialValue.getPivot(instance)

		if pivot then
			total += pivot.Position
			count += 1
		end
	end

	return if count > 0 then total / count else nil
end

function spatialValue.getExtents(instance: Instance): (Vector3?, Vector3?)
	local minimum = nil
	local maximum = nil

	local function include(position: Vector3, extent: Vector3)
		minimum = if minimum then minimum:Min(position - extent) else position - extent
		maximum = if maximum then maximum:Max(position + extent) else position + extent
	end

	local function visit(target: Instance)
		if target:IsA("BasePart") then
			local half = target.Size / 2
			local cframe = target.CFrame

			include(cframe.Position, (cframe.RightVector * half.X):Abs() + (cframe.UpVector * half.Y):Abs() + (cframe.LookVector * half.Z):Abs())
		elseif target:IsA("Attachment") then
			include(target.WorldPosition, Vector3.zero)
		end
	end

	visit(instance)

	if instance:IsA("Model") then
		for _, descendant in instance:GetDescendants() do
			if descendant:IsA("BasePart") then
				visit(descendant)
			end
		end
	end

	return minimum, maximum
end

function spatialValue.getBounds(instances: { Instance }): (Vector3?, Vector3?)
	local minimum = nil
	local maximum = nil

	for _, instance in instances do
		local low, high = spatialValue.getExtents(instance)

		if low and high then
			minimum = if minimum then minimum:Min(low) else low
			maximum = if maximum then maximum:Max(high) else high
		end
	end

	return minimum, maximum
end

function spatialValue.getComponent(vector: Vector3, axis: string): number
	return (vector :: any)[axis]
end

function spatialValue.withComponent(vector: Vector3, axis: string, value: number): Vector3
	return Vector3.new(if axis == "X" then value else vector.X, if axis == "Y" then value else vector.Y, if axis == "Z" then value else vector.Z)
end

function spatialValue.mirrorVector(vector: Vector3, axis: string): Vector3
	return spatialValue.withComponent(vector, axis, -spatialValue.getComponent(vector, axis))
end

function spatialValue.mirrorCFrame(cframe: CFrame, origin: Vector3, axis: string): CFrame
	local position = origin + spatialValue.mirrorVector(cframe.Position - origin, axis)
	local right = spatialValue.mirrorVector(cframe.RightVector, axis)
	local up = spatialValue.mirrorVector(cframe.UpVector, axis)
	local back = spatialValue.mirrorVector(-cframe.LookVector, axis)

	if axis == "X" then
		right = -right
	elseif axis == "Y" then
		up = -up
	else
		back = -back
	end

	return CFrame.fromMatrix(position, right, up, back)
end

function spatialValue.scaleUDim2(value: UDim2, factor: number): UDim2
	return UDim2.new(value.X.Scale * factor, math.round(value.X.Offset * factor), value.Y.Scale * factor, math.round(value.Y.Offset * factor))
end

function spatialValue.scaleEffect(instance: Instance, factor: number)
	if instance:IsA("ParticleEmitter") then
		instance.Size = sequenceTools.scale(instance.Size, factor)
		instance.Speed = NumberRange.new(instance.Speed.Min * factor, instance.Speed.Max * factor)
		instance.Acceleration *= factor
	elseif instance:IsA("Beam") then
		instance.Width0 *= factor
		instance.Width1 *= factor
		instance.CurveSize0 *= factor
		instance.CurveSize1 *= factor

		if instance.TextureMode ~= Enum.TextureMode.Stretch then
			instance.TextureLength *= factor
		end
	elseif instance:IsA("Trail") then
		instance.MinLength *= factor
		instance.MaxLength *= factor

		if instance.TextureMode ~= Enum.TextureMode.Stretch then
			instance.TextureLength *= factor
		end
	elseif instance:IsA("Light") then
		local light = instance :: any

		light.Range = math.min(light.Range * factor, spatialValue.maximumLightRange)
	elseif instance:IsA("Fire") then
		instance.Size = math.clamp(instance.Size * factor, 2, 30)
		instance.Heat = math.clamp(instance.Heat * factor, -25, 25)
	elseif instance:IsA("Smoke") then
		instance.Size = math.clamp(instance.Size * factor, 0.1, 100)
		instance.RiseVelocity = math.clamp(instance.RiseVelocity * factor, -25, 25)
	elseif instance:IsA("BillboardGui") then
		instance.Size = spatialValue.scaleUDim2(instance.Size, factor)
		instance.StudsOffset *= factor
		instance.StudsOffsetWorldSpace *= factor
	elseif instance:IsA("Texture") then
		instance.StudsPerTileU *= factor
		instance.StudsPerTileV *= factor
	elseif instance:IsA("SpecialMesh") then
		if instance.MeshType == Enum.MeshType.FileMesh then
			instance.Scale *= factor
		end

		instance.Offset *= factor
	end
end

function spatialValue.scaleNode(instance: Instance, factor: number, origin: Vector3)
	if instance:IsA("BasePart") then
		local cframe = instance.CFrame

		instance.Size = (instance.Size * factor):Max(Vector3.one * spatialValue.minimumSize)
		instance.CFrame = cframe.Rotation + (origin + (cframe.Position - origin) * factor)
	elseif instance:IsA("Attachment") then
		local parent = instance.Parent

		if parent and (parent:IsA("BasePart") or parent:IsA("Attachment")) then
			instance.Position *= factor
		else
			local world = instance.WorldCFrame

			instance.WorldCFrame = world.Rotation + (origin + (world.Position - origin) * factor)
		end
	elseif instance:IsA("Model") then
		local pivot = instance.WorldPivot

		if not instance.PrimaryPart then
			instance.WorldPivot = pivot.Rotation + (origin + (pivot.Position - origin) * factor)
		end
	else
		spatialValue.scaleEffect(instance, factor)
	end
end

function spatialValue.scale(root: Instance, factor: number, origin: Vector3)
	if factor <= 0 or factor == 1 then
		return
	end

	spatialValue.scaleNode(root, factor, origin)

	for _, descendant in root:GetDescendants() do
		spatialValue.scaleNode(descendant, factor, origin)
	end
end

return spatialValue
]]></ProtectedString>
