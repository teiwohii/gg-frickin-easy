						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">poseCache</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX2B3A36D97A6A403E900F5BDEFBECD449">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local nativeJoints = require("nativeJoints")
local poseSpace = require("poseSpace")
local rigPose = require("rigPose")
local easing = require("easing")
local PreviewClip = {}
PreviewClip.__index = PreviewClip

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function bracket(keys, time)
	local low, high = 1, #keys
	while low <= high do
		local middle = math.floor((low + high) / 2)
		if keys[middle].time <= time then
			low = middle + 1
		else
			high = middle - 1
		end
	end
	return keys[math.max(1, high)], keys[low]
end

local function sample(keys, time, world)
	if #keys == 0 then return nil end
	local left, right = bracket(keys, time)
	local value = left.value
	if not right or right == left then return value end
	local alpha = math.clamp((time - left.time) / (right.time - left.time), 0, 1)
	if left.easing then
		alpha = easing.apply(alpha, left.easing)
	elseif not world then
		alpha = easing.apply(alpha, left.nativeEasing)
	end
	return value:Lerp(right.value, alpha)
end

local function compileFrames(frames, joints)
	local channels, duration = {}, 0
	for _, frame in frames do
		if finite(frame.Time) and frame.Time >= 0 then
			duration = math.max(duration, frame.Time)
			for name, pose in frame.Data do
				if not joints[name] then continue end
				local channel = channels[name]
				if not channel then
					channel = { localKeys = {}, worldKeys = {} }
					channels[name] = channel
				end
				local transform = typeof(pose.CFrame) == "CFrame" and pose.CFrame or CFrame.identity
				local weight = finite(pose.Weight) and math.clamp(pose.Weight, 0, 1) or 1
				channel.localKeys[frame.Time] = {
					time = frame.Time,
					value = CFrame.identity:Lerp(transform, weight),
					easing = pose.EclipseEasingKeyData,
					nativeEasing = { EasingStyle = pose.PoseEasingStyle, EasingDirection = pose.PoseEasingDirection },
				}
				if typeof(pose.WorldCFrame) == "CFrame" then
					channel.worldKeys[frame.Time] = { time = frame.Time, value = pose.WorldCFrame, easing = pose.EclipseEasingKeyData }
				end
			end
		end
	end
	for _, channel in channels do
		for _, field in { "localKeys", "worldKeys" } do
			local ordered = {}
			for _, key in channel[field] do table.insert(ordered, key) end
			table.sort(ordered, function(a, b) return a.time < b.time end)
			channel[field] = ordered
		end
	end
	return channels, duration
end

local function buildPreviewSamplers(rig, sequence, motors, eligible)
	local result = {}
	if not rig or not eligible or not next(eligible) then
		return result
	end

	local timeline = require("state").Timeline
	local source = sequence:FindFirstChild("EclipseKeyframeData")
	if not source or not timeline or not timeline.CreatePreviewSampler then
		return result
	end

	local ok, archive = pcall(function()
		return game:GetService("HttpService"):JSONDecode(require("chunkStore").read(source))
	end)
	if
		not ok
		or typeof(archive) ~= "table"
		or (archive.version ~= 1 and archive.version ~= 2)
		or typeof(archive.tracks) ~= "table"
	then
		return result
	end

	local decode = require("keyframeStorage").decode
	local fps = sequence:GetAttribute("FPS")
	if typeof(fps) ~= "number" or fps < 1 or fps > 1000 then
		return result
	end

	local ratio = poseSpace.savedRatio(rig, sequence)
	local matched = {}
	for _, saved in archive.tracks do
		local valid, part = pcall(function()
			local part = rig
			for _, step in saved.path do
				local count, found = 0, nil
				for _, child in part:GetChildren() do
					if child.Name == step.name and child.ClassName == step.class then
						count += 1
						if count == step.index then
							found = child
							break
						end
					end
				end

				if not found then
					return nil
				end

				part = found
			end

			return part
		end)
		if not valid or not part or not eligible[part.Name] then
			continue
		end

		local native = motors[part.Name]
		if
			not native
			or (native:IsA("Motor6D") and native.Part1 ~= part)
			or (native:IsA("Bone") and native ~= part)
		then
			continue
		end

		if matched[native] then
			result[part.Name] = nil
			continue
		end

		matched[native] = true
		local motor = native:IsA("Bone") and require("boneMotor").get(native) or native
		if require("pivotSpace").jointOffset(motor) then
			continue
		end

		local success, sampler = pcall(function()
			if saved.parented == false then
				return nil
			end

			local storage = require("keyframeStorage")
			local stamped = typeof(motor) == "Instance"
				and motor:GetAttribute("EclipseAnimatorDefaultC0")
			local live = typeof(stamped) == "CFrame" and stamped or motor.C0
			local rebase = storage.restRebase(rig, sequence, saved, motor, live)
			local bucket = {}
			for _, record in saved.keys do
				local frame = record.frame
				if
					typeof(frame) ~= "number"
					or frame < 0
					or frame ~= frame
					or frame >= math.huge
					or bucket[frame]
				then
					return nil
				end

				local key = decode(record.data)
				if
					typeof(key) ~= "table"
					or typeof(key.C0) ~= "CFrame"
					or key.Parented == false
					or key.IK
					or key.HS
					or key.HeadFollow
					or key.WorldCFrame
					or key.MasterWorld
					or key.PhysicsLead
					or key.PhysicsTail
					or key.BlenderCurve
				then
					return nil
				end

				for id, value in key.WholePoseScale or {} do
					if value ~= 1 then
						return nil
					end
				end

				for id in key.GraphCurves or {} do
					if id:sub(1, 6) == "scale_" then
						return nil
					end
				end

				for _, channels in { key.Channels or {}, key.GraphCurves or {} } do
					for id, point in channels do
						if id:sub(1, 6) == "scale_" and point.Value ~= 1 then
							return nil
						end
					end
				end

				storage.rebaseKey(key, rebase, timeline)
				poseSpace.retargetKey(key, ratio, nil, nil)
				key.Frame, key.Time, key.Motor, key.Part = frame, frame / fps, motor, part
				bucket[frame] = key
			end

			if not next(bucket) then
				return nil
			end

			local rest = rebase and live
				or saved.rest and poseSpace.scaleTranslation(decode(saved.rest), ratio)
				or motor.C0
			return timeline:CreatePreviewSampler(motor, bucket, rest)
		end)
		if success then
			result[part.Name] = sampler
		end
	end

	return result
end

function PreviewClip.new(rig, sequence)
	assert(typeof(rig) == "Instance" and rig:IsA("Model"), "Choose a rig model to preview.")
	assert(typeof(sequence) == "Instance" and sequence:IsA("KeyframeSequence"), "Choose a saved animation to preview.")
	local originalPose = rigPose.capture(rig)
	nativeJoints.prepare(rig)
	local joints = require("rigTraversal").jointMap(rig)
	local frames, _, _, detached, recovery = require("convertToTable")(sequence, joints)
	local channels, duration = compileFrames(frames, joints)
	local samplers = buildPreviewSamplers(rig, sequence, joints, recovery)
	local self = setmetatable({
		rig = rig,
		duration = duration,
		bindings = {},
		byPart = {},
		pose = originalPose,
		anchor = require("masterControl").root(rig),
		delta = CFrame.identity,
		poseScale = poseSpace.getImportScale(rig, sequence, true),
		worldScale = poseSpace.savedRatio(rig, sequence),
		authoredPivot = sequence:GetAttribute("EclipseAuthoredPivot"),
		importPivot = poseSpace.getImportPivot(rig, sequence),
		facial = require("facialAnimation").preview(sequence, rig),
		closed = false,
	}, PreviewClip)
	self.anchorFrame = self.anchor and self.anchor.CFrame
	local fps = sequence:GetAttribute("FPS")
	local skip = sequence:GetAttribute("EclipseSkipFrames") or sequence:GetAttribute("SkipFrames") or 0
	if finite(fps) and fps >= 1 and fps <= 1000 and finite(skip) and skip > 0 then
		self.quantum = (math.clamp(math.floor(skip), 0, 1000) + 1) / fps
	end
	for name, joint in joints do
		if joint:IsA("Motor6D") and joint.Part1 then self.byPart[joint.Part1] = joint end
		local channel = channels[name]
		if channel then
			local rest = joint:IsA("Motor6D") and joint.C0 or joint.CFrame * joint.Transform
			local savedRest = joint:GetAttribute("EclipseAnimatorDefaultC0")
			if joint:IsA("Motor6D") and typeof(savedRest) == "CFrame" then
				rest = savedRest
			end
			table.insert(self.bindings, {
				joint = joint,
				channel = channel,
				rest = rest,
				sampler = samplers[name],
				detached = detached[name] == true,
			})
		end
	end
	return self
end

function PreviewClip:followPlacement()
	local anchor = self.anchor
	if not anchor or not anchor.Parent or not anchor:IsDescendantOf(self.rig) then return false end
	local current, previous = anchor.CFrame, self.anchorFrame
	self.anchorFrame = current
	if not previous or current:FuzzyEq(previous, 1e-6) then return false end
	local movement = (current * previous:Inverse()):Orthonormalize()
	self.delta = (movement * self.delta):Orthonormalize()
	if typeof(self.importPivot) == "CFrame" then self.importPivot = movement * self.importPivot end
	for item, properties in self.pose do
		if item:IsA("BasePart") then properties.CFrame = movement * properties.CFrame end
	end
	return true
end

function PreviewClip:placementDelta()
	return self.delta
end

function PreviewClip:seek(time)
	if self.closed then return end
	assert(finite(time), "Preview time must be a finite number of seconds.")
	time = math.clamp(time, 0, self.duration)
	if self.quantum then time = math.floor(time / self.quantum + 1e-7) * self.quantum end
	local moved = self:followPlacement()
	if self.applied and self.time == time and not moved then return end
	if not self.applied then
		rigPose.captureBonds(self.rig)
		nativeJoints.prepare(self.rig)
		for _, binding in self.bindings do
			local joint = binding.joint
			if joint:GetAttribute("EclipseAnimatorDefaultC0") == nil then
				joint:SetAttribute("EclipseAnimatorDefaultC0", binding.rest)
				binding.stamp = binding.rest
			end
			if joint:GetAttribute("EclipseRigRestC0") == nil then rigPose.rememberRest(joint, binding.rest) end
		end
	end
	self.applied, self.time = true, time
	local targets = {}
	for _, binding in self.bindings do
		local joint = binding.joint
		if not joint.Parent then continue end
		local absolute = binding.sampler and binding.sampler(time)
		local relative = not absolute and poseSpace.scaleTranslation(sample(binding.channel.localKeys, time), self.poseScale)
		if joint:IsA("Bone") then
			joint.Transform = absolute and joint.CFrame:ToObjectSpace(absolute) or relative
		else
			joint.C0 = absolute or binding.rest * relative
			if binding.detached and joint.Part0 and joint.Part1 then
				local frame = sample(binding.channel.worldKeys, time, true)
				if frame then targets[joint.Part1] = poseSpace.retargetWorld(frame, self.worldScale, self.authoredPivot, self.importPivot) end
			end
		end
	end
	local cache, visiting = {}, {}
	local function world(part)
		if targets[part] then return targets[part] end
		if cache[part] then return cache[part] end
		if visiting[part] then return part.CFrame end
		visiting[part] = true
		local joint = self.byPart[part]
		local frame = joint and joint.Part0 and world(joint.Part0) * joint.C0 * joint.Transform * joint.C1:Inverse() or part.CFrame
		cache[part], visiting[part] = frame, nil
		return frame
	end
	for part, frame in targets do
		local joint = self.byPart[part]
		joint.C0 = world(joint.Part0):Inverse() * frame * joint.C1 * joint.Transform:Inverse()
	end
	if self.facial then self.facial.apply(time) end
	nativeJoints.flush(self.rig)
	rigPose.assemble(self.rig)
	if self.anchor and self.anchor.Parent then self.anchorFrame = self.anchor.CFrame end
end

function PreviewClip:close()
	if self.closed then return end
	self:followPlacement()
	self.closed = true
	if self.facial then self.facial.restore() end
	if self.applied then
		for _, binding in self.bindings do
			local joint = binding.joint
			if not joint.Parent then continue end
			if joint:IsA("Motor6D") then joint.C0 = binding.rest end
			joint.Transform = CFrame.identity
			if binding.stamp and joint:GetAttribute("EclipseAnimatorDefaultC0") == binding.stamp then
				joint:SetAttribute("EclipseAnimatorDefaultC0", nil)
			end
		end
		nativeJoints.flush(self.rig)
		rigPose.restore(self.rig, self.pose)
		rigPose.releaseBonds(self.rig)
	end
	if self.onClosed then self.onClosed() end
end

function PreviewClip.clock()
	local clock = { clips = {}, elapsed = 0, duration = 0 }
	function clock:clear()
		if self.connection then self.connection:Disconnect(); self.connection = nil end
		table.clear(self.clips)
		self.elapsed, self.duration = 0, 0
	end
	function clock:advance(dt)
		if not finite(dt) or dt <= 0 or self.duration == 0 then return end
		self.elapsed = (self.elapsed + dt) % self.duration
		for clip in self.clips do clip:seek(self.elapsed) end
	end
	function clock:restart(clips)
		self:clear()
		for _, clip in clips do
			if not clip.closed then
				self.clips[clip] = true
				self.duration = math.max(self.duration, clip.duration)
				clip:seek(0)
			end
		end
		if self.duration > 0 then
			self.connection = game:GetService("RunService").PreRender:Connect(function(dt) self:advance(dt) end)
		end
	end
	function clock:remove(clip)
		local remaining = {}
		for other in self.clips do if other ~= clip then table.insert(remaining, other) end end
		self:restart(remaining)
	end
	return clock
end

return PreviewClip
]]></ProtectedString>
