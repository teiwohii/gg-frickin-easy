						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.configuration)

local emitStyle = {}

emitStyle.markers = { "EmitDelay", "EmitDuration", "TimeScale_Start", "TimeScale_End" }
emitStyle.styledCount = 1

function emitStyle.isStyled(instance: Instance): boolean
	for _, name in emitStyle.markers do
		if typeof(instance:GetAttribute(name)) == "number" then
			return true
		end
	end

	return false
end

function emitStyle.getDefault(instance: Instance, name: string): number
	if name == "EmitCount" and emitStyle.isStyled(instance) then
		return emitStyle.styledCount
	end

	return configuration.Keyframes.emitDefaults[name]
end

function emitStyle.getValue(instance: Instance, name: string): number
	local value = instance:GetAttribute(name)

	return if typeof(value) == "number" then value else emitStyle.getDefault(instance, name)
end

return emitStyle
]]></ProtectedString>
							<string name="ScriptGuid">{CAB9B6F5-C039-4B53-A2E0-9D6CC401DDEB}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">emitStyle</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX3560A17A9B5242E6BF8FC39579C65AF9">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = game:GetService("UserInputService")
local runService = game:GetService("RunService")

local InputSignal = {}
InputSignal.__index = InputSignal

function InputSignal.new()
	local self = setmetatable({}, InputSignal)

	self.listeners = {}

	return self
end

function InputSignal:Connect(callback)
	local listeners = self.listeners
	local connection = { Connected = true }

	function connection.Disconnect()
		connection.Connected = false

		local index = table.find(listeners, connection)

		if index then
			table.remove(listeners, index)
		end
	end

	connection.callback = callback
	table.insert(listeners, connection)

	return connection
end

function InputSignal:Once(callback)
	local connection = nil

	connection = self:Connect(function(...)
		connection.Disconnect()
		callback(...)
	end)

	return connection
end

function InputSignal:Wait()
	local thread = coroutine.running()

	self:Once(function(...)
		task.spawn(thread, ...)
	end)

	return coroutine.yield()
end

function InputSignal:fire(...)
	for _, connection in table.clone(self.listeners) do
		if connection.Connected then
			task.spawn(connection.callback, ...)
		end
	end
end

local InputHub = {}
InputHub.__index = InputHub

InputHub.offscreen = Vector3.new(-100000, -100000, 0)
InputHub.pointerTypes = {
	[Enum.UserInputType.MouseButton1] = true,
	[Enum.UserInputType.MouseButton2] = true,
	[Enum.UserInputType.MouseButton3] = true,
	[Enum.UserInputType.MouseMovement] = true,
	[Enum.UserInputType.MouseWheel] = true,
	[Enum.UserInputType.Touch] = true,
}

function InputHub.new()
	local self = setmetatable({}, InputHub)

	self.InputBegan = InputSignal.new()
	self.InputChanged = InputSignal.new()
	self.InputEnded = InputSignal.new()
	self.WindowFocusReleased = InputSignal.new()
	self.DockChanged = InputSignal.new()
	self.widget = nil
	self.surface = nil
	self.screen = nil
	self.docked = false
	self.onDock = false
	self.keysDown = {}
	self.buttonsDown = {}
	self.focusedBox = nil
	self.surfaceConnections = {}
	self.objectConnections = {}
	self.tick = 0
	self.handled = {}
	self.lastPointer = nil
	self.lastDockPosition = Vector2.zero

	runService.Heartbeat:Connect(function()
		self.tick += 1
		self:pollPointer()
	end)

	userInputService.InputBegan:Connect(function(input, processed)
		self:fromService(self.InputBegan, input, processed)
	end)

	userInputService.InputChanged:Connect(function(input, processed)
		self:fromService(self.InputChanged, input, processed)
	end)

	userInputService.InputEnded:Connect(function(input, processed)
		self:fromService(self.InputEnded, input, processed)
	end)

	userInputService.WindowFocusReleased:Connect(function()
		table.clear(self.keysDown)
		table.clear(self.buttonsDown)
		self.WindowFocusReleased:fire()
	end)

	return self
end

function InputHub:isPointer(input: InputObject): boolean
	return InputHub.pointerTypes[input.UserInputType] == true
end

function InputHub:createProxy(input: InputObject)
	return setmetatable({ Position = InputHub.offscreen }, {
		__index = function(_, key)
			local value = (input :: any)[key]

			if typeof(value) == "function" then
				return function(_, ...)
					return value(input, ...)
				end
			end

			return value
		end,
	})
end

function InputHub:createPointer(inputType: Enum.UserInputType, state: Enum.UserInputState, position: Vector2, delta: Vector2)
	return {
		UserInputType = inputType,
		UserInputState = state,
		KeyCode = Enum.KeyCode.Unknown,
		Position = Vector3.new(position.X, position.Y, 0),
		Delta = Vector3.new(delta.X, delta.Y, 0),
	}
end

function InputHub:getRelativePosition(): Vector2?
	local widget = self.widget

	if not widget then
		return nil
	end

	local success, position = pcall(function()
		return (widget :: any):GetRelativeMousePosition()
	end)

	return if success and typeof(position) == "Vector2" then position else nil
end

function InputHub:isInsideWidget(position: Vector2): boolean
	local size = self.widget.AbsoluteSize

	return position.X >= 0 and position.Y >= 0 and position.X <= size.X and position.Y <= size.Y
end

function InputHub:releaseDockButtons()
	local position = self.lastDockPosition

	for inputType in table.clone(self.buttonsDown) do
		self.buttonsDown[inputType] = nil
		self.InputEnded:fire(self:createPointer(inputType, Enum.UserInputState.End, position, Vector2.zero), false)
	end
end

function InputHub:pollPointer()
	if not self.docked or not self.widget or not self.widget.Enabled then
		self.lastPointer = nil
		return
	end

	local position = self:getRelativePosition()

	if not position then
		return
	end

	local held = next(self.buttonsDown) ~= nil
	local inside = self:isInsideWidget(position)

	if not inside and not held then
		if self.lastPointer then
			self.onDock = false
		end

		self.lastPointer = nil
		return
	end

	local last = self.lastPointer

	if last and last == position then
		return
	end

	self.onDock = true
	self.lastPointer = position
	self.lastDockPosition = position
	self.InputChanged:fire(self:createPointer(Enum.UserInputType.MouseMovement, Enum.UserInputState.Change, position, if last then position - last else Vector2.zero), false)
end

function InputHub:fromService(signal, input: InputObject, processed: boolean)
	if self.docked and input.UserInputType == Enum.UserInputType.MouseMovement and next(self.buttonsDown) ~= nil and self.onDock then
		self:releaseDockButtons()
	end

	if signal == self.InputEnded then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			self.keysDown[input.KeyCode] = nil
		else
			self.buttonsDown[input.UserInputType] = nil
		end
	end

	if self.docked and self:isPointer(input) then
		self.onDock = false
		signal:fire(self:createProxy(input), processed)
		return
	end

	signal:fire(input, processed)
end

function InputHub:isDuplicate(signal, input: InputObject): boolean
	local key = tostring(signal) .. tostring(input.UserInputType) .. tostring(input.KeyCode)

	if self.handled[key] == self.tick then
		return true
	end

	self.handled[key] = self.tick

	return false
end

function InputHub:fromSurface(signal, input: InputObject)
	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.MouseMovement or self:isDuplicate(signal, input) then
		return
	end

	if self:isPointer(input) then
		self.lastDockPosition = Vector2.new(input.Position.X, input.Position.Y)
	end

	if inputType == Enum.UserInputType.Keyboard then
		if signal == self.InputBegan then
			self.keysDown[input.KeyCode] = true
		elseif signal == self.InputEnded then
			self.keysDown[input.KeyCode] = nil
		end
	elseif self:isPointer(input) then
		self.onDock = true

		if signal == self.InputBegan then
			self.buttonsDown[inputType] = true
		elseif signal == self.InputEnded then
			self.buttonsDown[inputType] = nil
		end
	end

	local processed = inputType == Enum.UserInputType.Keyboard and self:GetFocusedTextBox() ~= nil

	signal:fire(input, processed)
end


function InputHub:watchObject(object: Instance)
	if not object:IsA("GuiObject") or self.objectConnections[object] then
		return
	end

	local connections = {
		object.InputBegan:Connect(function(input)
			self:fromSurface(self.InputBegan, input)
		end),
		object.InputChanged:Connect(function(input)
			self:fromSurface(self.InputChanged, input)
		end),
		object.InputEnded:Connect(function(input)
			self:fromSurface(self.InputEnded, input)
		end),
	}

	if object:IsA("TextBox") then
		local box = object :: TextBox

		table.insert(connections, box.Focused:Connect(function()
			self.focusedBox = box
		end))

		table.insert(connections, box.FocusLost:Connect(function()
			if self.focusedBox == box then
				self.focusedBox = nil
			end
		end))
	end

	self.objectConnections[object] = connections
end

function InputHub:unwatchObject(object: Instance)
	local connections = self.objectConnections[object]

	if not connections then
		return
	end

	for _, connection in connections do
		connection:Disconnect()
	end

	self.objectConnections[object] = nil
end

function InputHub:clearSurface()
	for _, connection in self.surfaceConnections do
		connection:Disconnect()
	end

	table.clear(self.surfaceConnections)

	for object in table.clone(self.objectConnections) do
		self:unwatchObject(object)
	end

	self.widget = nil
	self.surface = nil
	self.screen = nil
	self.focusedBox = nil
	self.onDock = false
end

function InputHub:attachSurface(widget: LayerCollector, surface: GuiObject, screen: LayerCollector?)
	self:clearSurface()
	self.widget = widget
	self.surface = surface
	self.screen = screen

	local connections = self.surfaceConnections

	table.insert(connections, surface.MouseEnter:Connect(function()
		self.onDock = true
	end))

	for _, descendant in widget:GetDescendants() do
		self:watchObject(descendant)
	end

	table.insert(connections, widget.DescendantAdded:Connect(function(descendant)
		self:watchObject(descendant)
	end))

	table.insert(connections, widget.DescendantRemoving:Connect(function(descendant)
		self:unwatchObject(descendant)
	end))
end

function InputHub:setDocked(docked: boolean)
	if self.docked == docked then
		return
	end

	self.docked = docked
	self.onDock = false
	table.clear(self.keysDown)
	table.clear(self.buttonsDown)
	self.DockChanged:fire(docked)
end

function InputHub:isDocked(): boolean
	return self.docked
end

function InputHub:isPointerOnDock(): boolean
	return self.docked and self.onDock
end

function InputHub:getWidget(): LayerCollector?
	return self.widget
end

function InputHub:getSurfaceSize(gui: Instance?): Vector2
	if self.docked and self.widget and (gui == nil or gui == self.screen or gui == self.widget) then
		return self.widget.AbsoluteSize
	end

	if gui and gui:IsA("GuiBase2d") then
		return gui.AbsoluteSize
	end

	local camera = workspace.CurrentCamera

	return if camera then camera.ViewportSize else Vector2.zero
end

function InputHub:GetMouseLocation(): Vector2
	if self:isPointerOnDock() and self.widget then
		local success, position = pcall(function()
			return (self.widget :: any):GetRelativeMousePosition()
		end)

		if success and typeof(position) == "Vector2" then
			return position
		end
	end

	return userInputService:GetMouseLocation()
end

function InputHub:IsKeyDown(keyCode: Enum.KeyCode): boolean
	return userInputService:IsKeyDown(keyCode) or self.keysDown[keyCode] == true
end

function InputHub:IsMouseButtonPressed(inputType: Enum.UserInputType): boolean
	return userInputService:IsMouseButtonPressed(inputType) or self.buttonsDown[inputType] == true
end

function InputHub:GetFocusedTextBox(): TextBox?
	local focused = userInputService:GetFocusedTextBox()

	if focused then
		return focused
	end

	local box = self.focusedBox

	if box and box.Parent and box:IsFocused() then
		return box
	end

	return nil
end

return InputHub.new()
]]></ProtectedString>
