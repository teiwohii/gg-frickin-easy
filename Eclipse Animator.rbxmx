						<ProtectedString name="Source"><![CDATA[-- riftkuro



local require = require(script:FindFirstAncestor("container").requireModule)



local preview = {}

local originals, locals, hidden = {}, {}, {}

local root, context, hooks

local watchers = {}

local hiddenRefs = {}



local function watch(connection)

	watchers[connection] = true

	return connection

end



local function canHide(object)

	return object:IsA("BasePart")

		or object:IsA("Decal")

		or object:IsA("ParticleEmitter")

		or object:IsA("Beam")

		or object:IsA("Trail")

end



local function hide(object)

	if not root or not canHide(object) or hidden[object] ~= nil then

		return

	end



	hidden[object] = object.LocalTransparencyModifier

	local saved = root:FindFirstChild("HiddenParts")

	if not saved then

		saved = Instance.new("Folder")

		saved.Name = "HiddenParts"

		saved.Parent = root

	end



	local ref = Instance.new("ObjectValue")

	ref.Value = object

	ref:SetAttribute("Before", hidden[object])

	ref.Parent = saved

	hiddenRefs[object] = ref

	object.LocalTransparencyModifier = 1

end



function preview.original(object)

	return originals[object] or object

end



function preview.localOf(object)

	return locals[object] or object

end



function preview.active()

	return root ~= nil

end



function preview.recover(container)

	local saved = container:FindFirstChild("HiddenParts")

	for _, ref in saved and saved:GetChildren() or {} do

		local part = ref:IsA("ObjectValue") and ref.Value

		if part and canHide(part) then

			part.LocalTransparencyModifier = ref:GetAttribute("Before") or 0

		end

	end

end



local function mapTree(source, copy)

	locals[source], originals[copy] = copy, source

	local children = {}

	for _, child in copy:GetChildren() do

		local class = children[child.ClassName]

		if not class then

			class = {}

			children[child.ClassName] = class

		end



		local queue = class[child.Name]

		if not queue then

			queue = { next = 1 }

			class[child.Name] = queue

		end



		table.insert(queue, child)

	end



	for _, child in source:GetChildren() do

		local class = children[child.ClassName]

		local queue = class and class[child.Name]

		local candidate = queue and queue[queue.next]

		if candidate then

			queue.next += 1

			mapTree(child, candidate)

		end

	end

end



function preview.shareR6Control(owner, bone)

	local controls = require("r6Controls")

	local originalOwner = controls.resolveOwner(originals[controls.ownerInstance(owner)])

	if not root or not originalOwner then

		return

	end



	local original =

		controls.ensure(originalOwner, bone:GetAttribute("EclipseR6Control"), bone.CFrame)

	mapTree(original, bone)

	local a, b = controls.get(original), controls.get(bone)

	locals[a], originals[b] = b, a

end



local function references(source)

	if

		source:IsA("JointInstance")

		or source:IsA("WeldConstraint")

		or source:IsA("NoCollisionConstraint")

	then

		return { "Part0", "Part1" }

	end



	if source:IsA("Beam") or source:IsA("Trail") or source:IsA("Constraint") then

		return { "Attachment0", "Attachment1" }

	end



	if source:IsA("Model") then

		return { "PrimaryPart" }

	end



	if source:IsA("ObjectValue") then

		return { "Value" }

	end



	if

		source:IsA("PVAdornment")

		or source:IsA("Highlight")

		or source:IsA("BillboardGui")

		or source:IsA("SurfaceGui")

	then

		return { "Adornee" }

	end



	return nil

end



local function remapReferences()

	for source, target in locals do

		if typeof(source) ~= "Instance" or typeof(target) ~= "Instance" then

			continue

		end



		for _, property in references(source) or {} do

			local value = source[property]

			target[property] = locals[value] or value

		end

	end



	require("target").remapLive(locals)

end



local batching = false



function preview.localize(rig)

	if not root or originals[rig] or locals[rig] then

		return preview.localOf(rig)

	end



	if not (rig:IsA("Model") or rig:IsA("BasePart")) then

		if rig:IsA("ParticleEmitter") or rig:IsA("Beam") or rig:IsA("Trail") then

			local owner = rig:FindFirstAncestorWhichIsA("Model")

				or rig:FindFirstAncestorWhichIsA("BasePart")

			if owner then

				preview.localize(owner)

				return preview.localOf(rig)

			end

		end



		return rig

	end



	if not rig:GetAttribute("EclipseTrackId") then

		rig:SetAttribute("EclipseTrackId", game:GetService("HttpService"):GenerateGUID(false))

	end



	local flags = {}

	local objects = { rig }

	for _, v in rig:GetDescendants() do

		table.insert(objects, v)

	end



	for _, v in objects do

		local excluded = v ~= rig

			and (v.Name == "AnimSaves" or v:IsA("KeyframeSequence") or v:IsA("LuaSourceContainer"))

		local wanted = not excluded

		if v.Archivable ~= wanted then

			flags[v] = v.Archivable

			v.Archivable = wanted

		end

	end



	local ok, copy = pcall(rig.Clone, rig)

	for v, value in flags do

		v.Archivable = value

	end



	assert(ok and copy, "Could not create a local Live preview for " .. rig.Name)

	mapTree(rig, copy)

	copy.Archivable = false

	copy.Parent = root

	for _, v in objects do

		local c = locals[v]

		if c and canHide(c) then

			c.LocalTransparencyModifier = hidden[v] or v.LocalTransparencyModifier

			hide(v)

		elseif c and c:IsA("BaseScript") then

			c.Enabled = false

		end

	end



	local queued = false

	local watched, watchStructure = {}, nil



	local function syncDescendants()

		if queued then

			return

		end



		queued = true

		task.defer(function()

			queued = false

			if not root or not copy.Parent or locals[rig] ~= copy then

				return

			end



			local removed = {}

			for source, localObject in locals do

				if

					typeof(source) == "Instance"

					and typeof(localObject) == "Instance"

					and localObject ~= copy

					and localObject:IsDescendantOf(copy)

					and not source:IsDescendantOf(rig)

				then

					table.insert(removed, { source, localObject })

				end

			end



			for _, pair in removed do

				local source, localObject = pair[1], pair[2]

				if hidden[source] ~= nil then

					if source.Parent then

						source.LocalTransparencyModifier = hidden[source]

					end



					hidden[source] = nil

					if hiddenRefs[source] then

						hiddenRefs[source]:Destroy()

						hiddenRefs[source] = nil

					end

				end



				if watched[source] then

					for _, connection in watched[source] do

						connection:Disconnect()

						watchers[connection] = nil

					end



					watched[source] = nil

				end



				locals[source], originals[localObject] = nil, nil

				localObject:Destroy()

			end



			local function visit(source)

				for _, child in source:GetChildren() do

					if

						child.Name == "AnimSaves"

						or child:IsA("KeyframeSequence")

						or child:IsA("LuaSourceContainer")

					then

						continue

					end



					watchStructure(child)

					local target = locals[child]

					if not target then

						target = Instance.fromExisting(child)

						locals[child], originals[target] = target, child

						if canHide(child) then

							target.LocalTransparencyModifier = hidden[child]

								or child.LocalTransparencyModifier

							hide(child)

						end

					end



					if target.Parent ~= locals[source] then

						target.Parent = locals[source]

					end



					visit(child)

				end

			end



			visit(rig)



			remapReferences()

		end)

	end



	watchStructure = function(source)

		if watched[source] then

			return

		end



		watched[source] = { watch(source.AncestryChanged:Connect(syncDescendants)) }

		for _, property in references(source) or {} do

			table.insert(

				watched[source],

				watch(source:GetPropertyChangedSignal(property):Connect(syncDescendants))

			)

		end

	end



	for _, source in objects do

		if locals[source] then

			watchStructure(source)

		end

	end



	watch(rig.DescendantAdded:Connect(syncDescendants))

	watch(rig.DescendantRemoving:Connect(syncDescendants))

	watch(rig.Destroying:Connect(function()

		if copy.Parent then

			copy:Destroy()

		end

	end))

	if not batching then

		remapReferences()

	end



	return copy

end



local function remap(value, mapping, seen)

	if mapping[value] then

		return mapping[value]

	end



	if type(value) ~= "table" or getmetatable(value) ~= nil then

		return value

	end



	seen = seen or {}

	if seen[value] then

		return seen[value]

	end



	local result = {}

	seen[value] = result

	for key, item in value do

		result[remap(key, mapping, seen)] = remap(item, mapping, seen)

	end



	return result

end



preview.remap = remap



function preview.syncControls(source, target, raw)

	local masterModule = require("masterControl")

	local different = false

	for _, attribute in { "EclipseMasterControl", "EclipseMasterRest", "EclipseMasterRadius" } do

		if source:GetAttribute(attribute) ~= target:GetAttribute(attribute) then

			different = true

		end

	end

	if different then

		masterModule.read(source, target)

	end

	local scene = require("motors")

	local destination = scene.motors(target, raw)

	local changed = false

	for id, motor in scene.motors(source, raw) do

		local other = destination[id]

		if

			other

			and require("customRest").isJoint(motor)

			and require("customRest").isJoint(other)

		then

			for _, attribute in require("customRest").attributeNames(motor, other) do

				local value = motor:GetAttribute(attribute)

				if other:GetAttribute(attribute) ~= value then

					other:SetAttribute(attribute, value)

					changed = true

				end

			end

		end

	end

	if changed then

		require("limbIk").invalidate(target)

	end

end



local function bindMotors(source, target)

	local scene = require("motors")

	local properties = require("properties")

	local raw = context.Timeline:GetState()

	preview.syncControls(source, target, raw)

	local propertyData = properties.snapshot(source, raw, false)

	properties.restore(target, propertyData, context.Timeline, context.UIHelpers.SanitizeName)

	local a, b = properties.folder(source, false), properties.folder(target, false)

	if a and b then

		if originals[source] then

			originals[a], locals[b] = b, a

		else

			locals[a], originals[b] = b, a

		end

	end



	local controls = require("r6Controls")

	for _, bone in source:GetDescendants() do

		if controls.isControl(bone) then

			local control = controls.get(bone)

			local owner = control

				and (originals[source] and originals[control.Owner] or locals[control.Owner])

			if owner and owner.Parent and owner.Part1 then

				local rest = raw.DefaultPose[control] or bone.CFrame

				local destination =

					controls.ensure(owner, bone:GetAttribute("EclipseR6Control"), rest)

				destination.CFrame = rest

				destination.Transform = CFrame.identity

				for _, attribute in { "EclipseIKControlSpace", "EclipseIKAnchorOffset" } do

					destination:SetAttribute(attribute, bone:GetAttribute(attribute))

				end

			end

		end

	end



	local from = scene.motors(source, raw)

	local to = scene.motors(target, raw)

	for id, motor in from do

		local other = to[id]

		if other then

			if raw.DefaultPose[motor] == nil then

				raw.DefaultPose[other] = nil

			end



			if originals[source] then

				originals[motor], locals[other] = other, motor

				if motor.Part1 and other.Part1 then

					originals[motor.Part1], locals[other.Part1] = other.Part1, motor.Part1

				end

			else

				locals[motor], originals[other] = other, motor

				if motor.Part1 and other.Part1 then

					locals[motor.Part1], originals[other.Part1] = other.Part1, motor.Part1

				end

			end

		end

	end

end



local function remapInPlace(value, mapping, seen)

	if mapping[value] then

		return mapping[value]

	end



	if type(value) ~= "table" or getmetatable(value) ~= nil then

		return value

	end



	if seen[value] then

		return value

	end



	seen[value] = true

	local entries = {}

	for key, item in value do

		entries[#entries + 1] =

			{ remapInPlace(key, mapping, seen), remapInPlace(item, mapping, seen) }

	end



	table.clear(value)

	for _, entry in entries do

		value[entry[1]] = entry[2]

	end



	return value

end



local function transferData(mapping)

	local raw = context.Timeline:GetState()

	local seen = {}

	for _, name in

		{

			"DefaultPose",

			"DefaultWorldPose",

			"DefaultSize",

			"ParentingDefaults",

			"MotorByPart",

			"Keyframes",

			"GreaseStrokes",

			"CopiedKeyframes",

			"AnimationLayers",

		}

	do

		if raw[name] then

			raw[name] = remapInPlace(raw[name], mapping, seen)

		end

	end



	for _, name in { "_motorUniform", "_motorHasScale", "_evaluationBuckets" } do

		if raw[name] then

			table.clear(raw[name])

		end

	end



	context.currentRig = mapping[context.currentRig] or context.currentRig

	for _, name in { "extraRigs", "activeObjectMotors", "lastCFrames", "exportSequences" } do

		context[name] = remapInPlace(context[name] or {}, mapping, seen)

	end

end



local function transfer(mapping)

	require("target").remapLive(mapping)

	require("eventPlayback").clear()

	if context.OnionSkin and context.OnionSkin.Clear then

		context.OnionSkin:Clear()

	end



	local raw = context.Timeline:GetState()

	local organizationModule = require("organization")

	local events = require("events")

	local cache = require("simulationCache")



	if context.Axis then

		context.Axis:SelectBone(nil)

		context.Axis:ClearAxis()

	end



	if context.Rig and context.Rig.GetBonesFolder then

		for _, rig in context.getAllRigs() do

			if mapping[rig] then

				local folder = context.Rig:GetBonesFolder(rig)

				if folder then

					folder:Destroy()

				end

			end

		end

	end



	local organization = remap(organizationModule.snapshot(), mapping)

	local clips = remap(cache.list(raw), mapping)

	for _, rig in context.getAllRigs() do

		local target = mapping[rig]

		if target then

			local track = events.get(rig)

			events.detach(rig)

			events.attach(target, track)

		end

	end



	transferData(mapping)

	cache.set(raw, clips)

	require("scene").remapLive(context, mapping)

	if context.Axis then

		context.Axis:SelectBone(nil)

		context.Axis:ClearAxis()

		context.Axis:SetCurrentRig(context.currentRig)

	end



	if context.Timeline.ClearSelectedKeyframes then

		context.Timeline:ClearSelectedKeyframes()

	end



	if context.Rig then

		context.Rig:DestroyHierarchyItems()

	end



	organizationModule.restore(organization, "live")

	if hooks.RefreshStructure then

		hooks.RefreshStructure()

	end



	require("limbIk").clearLive()

	for _, rig in context.getAllRigs() do

		require("limbIk").invalidate(rig)

		context.Timeline:ApplyPoseAtTime(rig, raw.CurrentTime, { OnlyRig = true })

	end

end



function preview.begin(state, refs)

	assert(not root, "Live preview already exists")

	context, hooks = state, refs

	root = Instance.new("Folder")

	root.Name = "EclipseLivePreview"

	root.Archivable = false

	root:SetAttribute("EclipseLocalLivePreview", true)

	root.Parent = assert(workspace.CurrentCamera, "No local camera")

	local ok, err = xpcall(function()

		local rigs = state.getAllRigs()

		batching = true

		for _, rig in rigs do

			preview.localize(rig)

		end



		batching = false

		remapReferences()

		for _, rig in rigs do

			if locals[rig] then

				bindMotors(rig, locals[rig])

			end

		end



		transfer(locals)

	end, debug.traceback)

	batching = false

	if not ok then

		preview.finish()

		error(err, 0)

	end

end



function preview.finish()

	if not root then

		return

	end



	local ok, err = xpcall(function()

		for _, rig in context.getAllRigs() do

			if originals[rig] then

				bindMotors(rig, originals[rig])

			end

		end



		transfer(originals)

	end, debug.traceback)

	if not ok then

		local restored, restoreError = pcall(transferData, originals)

		if restored and hooks.RefreshStructure then

			local rebuilt, rebuildError = pcall(hooks.RefreshStructure)

			if not rebuilt then

				err = tostring(err) .. "\n" .. tostring(rebuildError)

			end

		elseif not restored then

			err = tostring(err) .. "\n" .. tostring(restoreError)

		end

	end



	for connection in watchers do

		connection:Disconnect()

	end



	watchers = {}

	for part, value in hidden do

		if part.Parent then

			part.LocalTransparencyModifier = value

		end

	end



	local old = root

	root = nil

	originals, locals, hidden, hiddenRefs = {}, {}, {}, {}

	context, hooks = nil, nil

	old:Destroy()

	if not ok then

		error(err, 0)

	end

end



local function finitePose(value)

	if typeof(value) ~= "CFrame" then

		return false

	end



	for _, number in { value:GetComponents() } do

		if number ~= number or math.abs(number) == math.huge then

			return false

		end

	end



	return true

end



local function validSize(value)

	return typeof(value) == "Vector3"

		and value.X > 0

		and value.X < math.huge

		and value.Y > 0

		and value.Y < math.huge

		and value.Z > 0

		and value.Z < math.huge

end



local function manifestCovers(consumed, commit)

	if not consumed then

		return false

	end



	if consumed.text == commit then

		return true

	end



	local ok, expected = pcall(function()

		return game:GetService("HttpService"):JSONDecode(commit)

	end)

	if not ok or type(expected) ~= "table" or type(consumed.index) ~= "table" then

		return false

	end



	for id, names in expected do

		local current = consumed.index[id]

		if type(names) ~= "table" or type(current) ~= "table" or #current == 0 then

			return false

		end



		local required = 0

		for _, name in names do

			local shard, revision = tostring(name):match("^Page(%d+)_(%d+)_%d+$")

			if shard ~= id then

				return false

			end



			required = math.max(required, tonumber(revision))

		end



		for _, name in current do

			local shard, revision = tostring(name):match("^Page(%d+)_(%d+)_%d+$")

			if shard ~= id or tonumber(revision) < required then

				return false

			end

		end

	end



	return true

end



function preview.stream(adapter)

	local self =

		{ nodes = {}, last = 0, active = false, receivers = setmetatable({}, { __mode = "k" }) }

	local commits = setmetatable({}, { __mode = "k" })



	local function editedRigs()

		local state = adapter.state

		local result = {}

		local axis = state.Axis



		local function include(part)

			if typeof(part) ~= "Instance" then

				return

			end



			for _, rig in adapter.rigs do

				if part == rig or part:IsDescendantOf(rig) then

					result[rig] = true

				end

			end

		end



		local snapshots = axis and axis.GetManipulationSnapshots and axis:GetManipulationSnapshots()

		for _, info in snapshots or {} do

			include(info.part or info.motor and info.motor.Part1)

		end



		for _, info in state.manipulationMotors or {} do

			include(info.part or info.motor and info.motor.Part1)

		end



		for _, bone in axis and axis.GetSelectedBones and axis:GetSelectedBones() or {} do

			local part = state.Rig

				and state.Rig.GetPartFromBone

				and state.Rig:GetPartFromBone(state.currentRig, bone)

			include(part or bone)

		end



		if state.CameraPreview and state.CameraPreview.isViewRotating() then

			include(state.CameraPreview.target())

		end



		if not next(result) and state.currentRig then

			result[state.currentRig] = true

		end



		return result

	end



	local function belongs(motor, rigs)

		local part = motor.Part1

		if typeof(part) ~= "Instance" then

			return false

		end



		for rig in rigs do

			if part == rig or part:IsDescendantOf(rig) then

				return true

			end

		end



		return false

	end



	function self:publish(peer, editing, force)

		if not editing then

			return false

		end



		if not self.active then

			adapter:refresh()

			self.editRigs = editedRigs()

			self.active = true

			peer:SetAttribute("PoseActive", true)

		end



		if not force and os.clock() - self.last < 1 / 30 then

			return true

		end



		self.last = os.clock()

		local folder = peer:FindFirstChild("Pose")

		if not folder then

			folder = Instance.new("Folder")

			folder.Name = "Pose"

			folder.Parent = peer

		end



		local nextNode = #folder:GetChildren()

		local parenting = require("parenting")

		local raw = adapter.state.Timeline:GetState()

		local present = {}

		for id, motor in adapter.motors do

			local part = motor.Part1

			if

				belongs(motor, self.editRigs)

				and id ~= "$origin"

				and typeof(part) == "Instance"

				and part.Parent

				and (part:IsA("BasePart") or part:IsA("Bone"))

				and not (typeof(motor) == "table" and motor.IsEclipseProperty)

			then

				present[id] = true

				local node = self.nodes[id]

				if not node then

					nextNode += 1

					node = Instance.new("CFrameValue")

					node.Name = tostring(nextNode)

					node:SetAttribute("Track", id)

					self.nodes[id] = node

				end



				local world = parenting.worldOf(motor, raw.MotorByPart)

				if node.Value ~= world then

					node.Value = world

				end



				if node:GetAttribute("C0") ~= motor.C0 then

					node:SetAttribute("C0", motor.C0)

				end



				if part:IsA("BasePart") and node:GetAttribute("Size") ~= part.Size then

					node:SetAttribute("Size", part.Size)

				end



				node.Parent = folder

			end

		end



		for id, node in self.nodes do

			if not present[id] then

				node:Destroy()

				self.nodes[id] = nil

			end

		end



		return true

	end



	function self:commit(peer)

		if not self.active then

			return

		end



		peer:SetAttribute("PoseCommit", peer:GetAttribute("Manifest"))

		peer:SetAttribute("PoseActive", false)

		self.active = false

	end



	function self:apply(peer, consumed, dt)

		local commit = peer:GetAttribute("PoseCommit")

		if not peer:GetAttribute("PoseActive") then

			local cached = commits[peer]

			local text = consumed and consumed.text

			if not cached or cached.commit ~= commit or cached.text ~= text then

				cached = {

					commit = commit,

					text = text,

					covered = not commit or manifestCovers(consumed, commit),

				}

				commits[peer] = cached

			end



			if cached.covered then

				self.receivers[peer] = nil

				return false

			end

		end



		local folder = peer:FindFirstChild("Pose")

		if not folder then

			return false

		end



		local previous = self.receivers[peer] or {}

		self.receivers[peer] = previous

		local step = type(dt) == "number" and dt == dt and math.clamp(dt, 0, 1) or 1 / 60

		local alpha = 1 - math.exp(-step * 90)

		local applied = false

		local updates = {}

		for _, node in folder:GetChildren() do

			if node:IsA("CFrameValue") then

				local id = node:GetAttribute("Track")

				local motor = adapter.motors[id]

				local cf = node:GetAttribute("C0")

				if

					motor

					and motor.Parent

					and finitePose(cf)

					and finitePose(node.Value)

					and not (typeof(motor) == "table" and motor.IsEclipseProperty)

					and not (self.active and belongs(motor, self.editRigs))

				then

					local old = previous[id]

					local world = old and old.world:Lerp(node.Value, alpha) or node.Value

					local localPose = old and old.cf:Lerp(cf, alpha) or cf

					table.insert(updates, {

						motor = motor,

						pose = localPose,

						world = world,

						size = node:GetAttribute("Size"),

					})



					previous[id] = { world = world, cf = localPose }

					applied = true

				end

			end

		end



		adapter.state.lastCFrames = adapter.state.lastCFrames or {}

		for _, masterPass in { true, false } do

			for _, update in updates do

				local m = update.motor

				local master = typeof(m) == "table" and m.IsEclipseMasterControl == true

				if master == masterPass then

					m.C0 = update.pose

					adapter.state.lastCFrames[m] = m.C0

				end

			end

		end



		for _, update in updates do

			local m = update.motor

			local part = m.Part1

			if

				typeof(part) == "Instance"

				and part:IsA("BasePart")

				and not (typeof(m) == "table" and m.IsEclipseMasterControl)

			then

				part.CFrame = update.world

				if validSize(update.size) then

					part.Size = update.size

				end

			end

		end



		return applied

	end



	return self

end



return preview

]]></ProtectedString>
						<string name="ScriptGuid">{A2A5BD3A-AE6F-4AD9-B75E-47C34F2C2D95}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">rigPreview</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX41CFA1241C974C0F90473066DCA8CE78">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local rigTraversal = require("rigTraversal")

local joints = {}
local rigs = setmetatable({}, { __mode = "k" })
local busy = false

local function rescale(frame, scale)
	return CFrame.new(frame.Position * scale) * frame.Rotation
end

local function recover(constraint)
	local enabled = constraint:GetAttribute("EclipseConstraintEnabled")
	if enabled == nil then
		return
	end

	local owner = constraint.Parent
	local scale = 1
	while owner do
		local original = owner:GetAttribute("EclipseNativeJointScale")
		if owner:IsA("Model") and original then
			scale = owner:GetScale() / original
			break
		end

		owner = owner.Parent
	end

	local rest = constraint:GetAttribute("EclipseConstraintRestC0")
	if rest and constraint.Attachment0 then
		constraint.Attachment0.CFrame = rescale(rest, scale)
	end

	constraint.Transform =
		rescale(constraint:GetAttribute("EclipseConstraintTransform") or CFrame.identity, scale)
	local kinematic = constraint:GetAttribute("EclipseConstraintKinematic")
	if kinematic ~= nil then
		constraint.IsKinematic = kinematic
	end
	constraint:SetAttribute("EclipseConstraintKinematic", nil)
	constraint.Enabled = enabled
	constraint:SetAttribute("EclipseConstraintEnabled", nil)
	constraint:SetAttribute("EclipseConstraintTransform", nil)
	constraint:SetAttribute("EclipseConstraintRestC0", nil)
end

local function restoreMotor(motor)
	local rest = motor:GetAttribute("EclipseConstraintBorrowedC0")
	if typeof(rest) == "CFrame" then
		local owner, scale = motor.Parent, 1
		local original = motor:GetAttribute("EclipseConstraintBorrowedScale")
		while original and owner do
			if owner:IsA("Model") and owner:GetAttribute("EclipseNativeJointScale") then
				scale = owner:GetScale() / original
				break
			end
			owner = owner.Parent
		end
		motor.C0 = rescale(rest, scale)
		motor.C1 = rescale(motor:GetAttribute("EclipseConstraintBorrowedC1") or motor.C1, scale)
		motor:SetAttribute("EclipseConstraintBorrowedScale", nil)
		motor:SetAttribute("EclipseConstraintBorrowedC0", nil)
		motor:SetAttribute("EclipseConstraintBorrowedC1", nil)
	else
		motor:Destroy()
	end
end

function joints.recover(scope)
	for _, motor in rigTraversal.descendants(scope) do
		if
			motor:IsA("Motor6D")
			and (
				motor:GetAttribute("EclipseConstraintProxy")
				or motor:GetAttribute("EclipseConstraintBorrowedC0")
			)
		then
			restoreMotor(motor)
		end
	end

	for _, constraint in rigTraversal.descendants(scope) do
		if constraint:IsA("AnimationConstraint") then
			recover(constraint)
		end
	end

	for _, object in rigTraversal.descendants(scope) do
		if object:IsA("Model") then
			object:SetAttribute("EclipseNativeJointScale", nil)
		end
	end

	if scope:IsA("Model") then
		scope:SetAttribute("EclipseNativeJointScale", nil)
	end
end

local function remove(entry)
	for _, connection in entry.connections do
		connection:Disconnect()
	end

	for constraint, row in entry.rows do
		restoreMotor(row.motor)
		if constraint.Parent then
			recover(constraint)
		end
	end
end

function joints.release(rig)
	local entry = rigs[rig]
	if not entry then
		return
	end

	for constraint, row in entry.rows do
		if constraint.Parent and constraint.Attachment0 and row.motor.Parent then
			row.motor.C0 = rescale(row.restC0 * row.transform, rig:GetScale() / entry.scale)
		end
	end

	joints.flush(rig)
	rigs[rig] = nil
	remove(entry)
	rig:SetAttribute("EclipseNativeJointScale", nil)
end

function joints.clear()
	local list = {}
	for rig in rigs do
		table.insert(list, rig)
	end

	for _, rig in list do
		joints.release(rig)
	end
end

function joints.prepare(rig)
	if busy or not rig or not rig:IsA("Model") then
		return
	end

	local entry = rigs[rig]
	if entry and not entry.dirty then
		return
	end

	local constraints = {}
	for _, item in rigTraversal.rigDescendants(rig) do
		if item:IsA("AnimationConstraint") then
			table.insert(constraints, item)
		end
	end

	if #constraints == 0 and not entry then
		return
	end

	if not entry then
		joints.recover(rig)
		rig:SetAttribute("EclipseNativeJointScale", rig:GetScale())
		entry = { rows = {}, connections = {}, dirty = true, rig = rig, scale = rig:GetScale() }
		rigs[rig] = entry

		local function changed(item)
			if not busy and (item:IsA("AnimationConstraint") or item:IsA("Attachment")) then
				entry.dirty = true
			end
		end

		table.insert(entry.connections, rig.DescendantAdded:Connect(changed))
		table.insert(entry.connections, rig.DescendantRemoving:Connect(changed))
		table.insert(
			entry.connections,
			rig.Destroying:Connect(function()
				joints.release(rig)
			end)
		)
	end

	busy = true
	local ok, err = xpcall(function()
		for constraint, row in entry.rows do
			if not constraint:IsDescendantOf(rig) or not row.motor.Parent then
				restoreMotor(row.motor)
				if constraint.Parent then
					recover(constraint)
				end

				entry.rows[constraint] = nil
			end
		end

		local occupied, claimed = {}, {}
		for _, row in entry.rows do
			if row.motor.Part1 then
				claimed[row.motor.Part1] = true
			end
		end
		for _, motor in rigTraversal.rigDescendants(rig) do
			if
				motor:IsA("Motor6D")
				and motor.Part1
				and not motor:GetAttribute("EclipseConstraintProxy")
			then
				if not occupied[motor.Part1] or motor.Enabled then
					occupied[motor.Part1] = motor
				end
			end
		end

		for _, constraint in constraints do
			if entry.rows[constraint] then
				continue
			end

			recover(constraint)
			local a, b = constraint.Attachment0, constraint.Attachment1
			if
				not constraint.Enabled
				or not a
				or not b
				or not a.Parent
				or not b.Parent
				or not a.Parent:IsA("BasePart")
				or not b.Parent:IsA("BasePart")
				or claimed[b.Parent]
				or occupied[b.Parent]
					and (occupied[b.Parent].Enabled or occupied[b.Parent].Part0 ~= a.Parent)
			then
				continue
			end

			local motor = occupied[b.Parent]
			local borrowed = motor ~= nil
			if borrowed then
				motor:SetAttribute("EclipseConstraintBorrowedC0", motor.C0)
				motor:SetAttribute("EclipseConstraintBorrowedC1", motor.C1)
				motor:SetAttribute("EclipseConstraintBorrowedScale", rig:GetScale())
			else
				motor = Instance.new("Motor6D")
				motor.Name = constraint.Name
				motor.Archivable = false
				motor.Enabled = false
				motor:SetAttribute("EclipseConstraintProxy", true)
			end
			motor.C0 = a.CFrame * constraint.Transform
			motor.C1 = b.CFrame
			motor.Part0 = a.Parent
			motor.Part1 = b.Parent
			entry.rows[constraint] =
				{ motor = motor, transform = constraint.Transform, restC0 = a.CFrame }
			constraint:SetAttribute("EclipseConstraintEnabled", constraint.Enabled)
			constraint:SetAttribute("EclipseConstraintTransform", constraint.Transform)
			constraint:SetAttribute("EclipseConstraintRestC0", a.CFrame)
			constraint:SetAttribute("EclipseConstraintKinematic", constraint.IsKinematic)
			constraint.IsKinematic = false
			constraint.Enabled = true
			table.insert(
				entry.connections,
				constraint:GetPropertyChangedSignal("IsKinematic"):Connect(function()
					if constraint.IsKinematic then
						constraint.IsKinematic = false
					end
				end)
			)
			if not borrowed then
				motor.Parent = constraint.Parent
			end
			occupied[b.Parent] = motor
			claimed[b.Parent] = true
		end

		entry.dirty = false
	end, debug.traceback)
	busy = false
	if not ok then
		joints.release(rig)
		error(err)
	end
end

function joints.applyWorlds(rig, desired)
	local entry = rigs[rig]
	if entry then
		for constraint, row in entry.rows do
			local motor = row.motor
			local a, b = constraint.Attachment0, constraint.Attachment1
			if not constraint.Parent or not a or not b or not motor.Part0 or not motor.Part1 then
				entry.dirty = true
				continue
			end

			local rest = rescale(row.restC0, rig:GetScale() / entry.scale)
			local transform = rest:Inverse() * motor.C0
			if constraint.Transform ~= transform then
				constraint.Transform = transform
			end
		end
	end

	if not next(desired) and not (entry and next(entry.rows)) then
		return
	end

	local map, parts, seen = {}, {}, {}
	local welds = {}
	local passive = rigTraversal.passiveMotors(rig)

	local function part(value)
		if value and value:IsA("BasePart") and not seen[value] then
			seen[value] = true
			table.insert(parts, value)
		end
	end

	for _, item in rigTraversal.activeObjects(rig) do
		if item:IsA("BasePart") then
			part(item)
		elseif
			item:IsA("JointInstance")
			and item.Part0
			and item.Part1
			and (
				item.Enabled
				or item:GetAttribute("EclipseConstraintProxy")
				or item:GetAttribute("EclipseConstraintBorrowedC0")
			)
		then
			local accessory = item.Part0:FindFirstAncestorOfClass("Accessory")
			if passive[item] or accessory and not item.Part1:IsDescendantOf(accessory) then
				map[item.Part0] = {
					Part0 = item.Part1,
					C0 = item.C1,
					C1 = item.C0 * (item:IsA("Motor6D") and item.Transform or CFrame.identity),
				}
			elseif item:IsA("Motor6D") or not map[item.Part1] then
				map[item.Part1] = item
			end

			part(item.Part0)
			part(item.Part1)
		elseif
			item:IsA("WeldConstraint")
			and item.Part0
			and item.Part1
			and not (item:GetAttribute("EclipseAccessorySource") and not item.Enabled)
		then
			table.insert(welds, item)
			part(item.Part0)
			part(item.Part1)
		elseif
			item:IsA("RigidConstraint")
			and item.Enabled
			and item.Attachment0
			and item.Attachment1
		then
			local a, b = item.Attachment0, item.Attachment1
			if
				a.Parent
				and b.Parent
				and a.Parent:IsA("BasePart")
				and b.Parent:IsA("BasePart")
				and a:IsDescendantOf(rig)
				and b:IsDescendantOf(rig)
			then
				local accessory = a.Parent:FindFirstAncestorOfClass("Accessory")
				if accessory and not b:IsDescendantOf(accessory) then
					a, b = b, a
				end

				if not map[b.Parent] then
					map[b.Parent] =
						{ Part0 = a.Parent, Part1 = b.Parent, C0 = a.CFrame, C1 = b.CFrame }
				end

				part(a.Parent)
				part(b.Parent)
			end
		end
	end

	if #welds > 0 then
		local reached = {}
		for value, joint in map do
			reached[value] = true
			reached[joint.Part0] = true
		end

		require("rigPose").spreadWelds(rig, welds, reached, function(value, parent, offset)
			map[value] = { Part0 = parent, Part1 = value, C0 = offset, C1 = CFrame.identity }
		end)
	end

	for value in desired do
		part(value)
	end

	local worlds, visiting = {}, {}

	local parenting = require("parenting")

	local function world(value)
		if worlds[value] then
			return worlds[value]
		end

		local joint = map[value]
		if
			desired[value]
			and (
				not joint
				or typeof(joint) == "Instance"
					and joint:IsA("Motor6D")
					and parenting.getDefault(joint) == false
			)
		then
			return desired[value]
		end

		if visiting[value] then
			return value.CFrame
		end

		visiting[value] = true
		local frame = joint and world(joint.Part0) * joint.C0 * joint.C1:Inverse() or value.CFrame
		visiting[value] = nil
		worlds[value] = frame
		return frame
	end

	local moved, frames = {}, {}
	for _, value in parts do
		local frame = world(value)
		if not value.CFrame:FuzzyEq(frame, 1e-6) then
			table.insert(moved, value)
			table.insert(frames, frame)
		end
	end

	if #moved > 0 then
		workspace:BulkMoveTo(moved, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function joints.flush(rig, externalWorld)
	if not rig then
		return
	end

	local desired = {}
	for _, joint in rigTraversal.externalMotors(rig) do
		if joint:IsA("Motor6D") and joint.Enabled and joint.Part0 and joint.Part1 then
			if not joint.Part0:IsDescendantOf(rig) or not joint.Part1:IsDescendantOf(rig) then
				local parent = rigTraversal.passiveMotors(rig)[joint] and joint.Part1 or joint.Part0
				desired[parent] = externalWorld and externalWorld(parent) or parent.CFrame
			end
		end
	end
	joints.applyWorlds(rig, desired)
	require("rigPose").syncAccessories(rig)
end

return joints
]]></ProtectedString>
