						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local timing = {}

function timing.seconds(value)
	value = tonumber(value)
	return value and value == value and math.abs(value) < math.huge and math.clamp(value, 0, 86400)
		or 0
end

function timing.duration(data, length, finite)
	local span =
		math.max(0, timing.seconds(length or data.Duration) - timing.seconds(data.StartOffset))
	local speed = math.clamp(tonumber(data.Speed) or 1, 0.01, 20)
	local limit = timing.seconds(data.PlayDuration)
	if length == nil and timing.seconds(data.Duration) == 0 and limit > 0 then
		return limit
	end
	if data.Looped and span > 0 then
		return limit > 0 and limit or finite and span / speed or math.huge
	end
	return limit > 0 and math.min(limit, span / speed) or span / speed
end

function timing.sample(data, elapsed, length)
	local duration = timing.duration(data, length)
	if elapsed < 0 or elapsed >= duration then
		return nil
	end
	local start = timing.seconds(data.StartOffset)
	local speed = math.clamp(tonumber(data.Speed) or 1, 0.01, 20)
	local offset = elapsed * speed
	if data.Looped then
		offset %= timing.seconds(length or data.Duration) - start
	end
	local gain = 1
	local fadeIn, fadeOut = timing.seconds(data.FadeIn), timing.seconds(data.FadeOut)
	if fadeIn > 0 then
		gain = math.min(gain, elapsed / fadeIn)
	end
	if fadeOut > 0 then
		gain = math.min(gain, (duration - elapsed) / fadeOut)
	end
	return start + offset, math.clamp(gain, 0, 1)
end

return timing
]]></ProtectedString>
