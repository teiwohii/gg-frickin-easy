							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)

local Palette = {}
Palette.__index = Palette

Palette.expandedText = "v"
Palette.collapsedText = ">"

function Palette.new(page: Frame, templates: Instance, context, builder)
	local self = setmetatable({}, Palette)

	self.page = page
	self.list = page.List
	self.search = page.Search
	self.search.PlaceholderText = "Search objects"
	self.templates = templates
	self.context = context
	self.builder = builder
	self.groups = {}
	self.collapsed = {}
	self.filter = ""
	self.connections = {}

	self:build()
	self:bind()

	return self
end

function Palette:connect(signal: RBXScriptSignal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function Palette:bind()
	self:connect(self.search:GetPropertyChangedSignal("Text"), function()
		self.filter = string.lower(string.gsub(self.search.Text, "^%s*(.-)%s*$", "%1"))
		self:applyVisibility()
	end)
end

function Palette:createItem(id: string, order: number, grid: Frame)
	local item = configuration.Create.Palette.items[id]

	if not item then
		return nil
	end

	local button = self.templates.PaletteItem:Clone()

	button.Name = id
	button.LayoutOrder = order
	button.Label.Text = item.label
	self.context.icons:apply(button.Icon, item.icon)
	button.Parent = grid


	self:connect(button.Activated, function()
		self.builder:add(id)
	end)

	return { id = id, button = button, text = string.lower(item.label .. " " .. id .. " " .. (item.className or "")) }
end

function Palette:build()
	local order = 0

	for _, category in configuration.Create.Palette.categories do
		order += 1

		local header = self.templates.Section:Clone()

		header.Name = "Category"
		header.Title.Text = category.title
		header.LayoutOrder = order
		header.Parent = self.list

		order += 1

		local grid = self.templates.PaletteGrid:Clone()

		grid.Name = "Items"
		grid.LayoutOrder = order
		grid.Parent = self.list

		local group = { title = category.title, header = header, grid = grid, items = {} }

		for index, id in category.items do
			local item = self:createItem(id, index, grid)

			if item then
				table.insert(group.items, item)
			end
		end

		self:connect(header.Activated, function()
			self.collapsed[group.title] = not self.collapsed[group.title]
			self:applyVisibility()
		end)

		table.insert(self.groups, group)
	end

	self:applyVisibility()
end

function Palette:applyVisibility()
	local filtering = self.filter ~= ""

	for _, group in self.groups do
		local collapsed = not filtering and self.collapsed[group.title] == true
		local anyVisible = false

		for _, item in group.items do
			local visible = not filtering or string.find(item.text, self.filter, 1, true) ~= nil

			item.button.Visible = visible
			anyVisible = anyVisible or visible
		end

		group.header.Visible = anyVisible
		group.header.Arrow.Text = if collapsed then Palette.collapsedText else Palette.expandedText
		group.grid.Visible = anyVisible and not collapsed
	end
end

function Palette:destroy()
	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)

	for _, group in self.groups do
		group.header:Destroy()
		group.grid:Destroy()
	end

	table.clear(self.groups)
end

return Palette
]]></ProtectedString>
