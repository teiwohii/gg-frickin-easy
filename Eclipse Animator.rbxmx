							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)
local Dragger = require(script.Parent.Parent.UI.Dragger)

local Window = {}
Window.__index = Window

Window.tabs = { "Inspect", "Add", "Textures", "Meshes", "Tools", "Library" }
Window.tabSuffix = "Tab"
Window.noAssetText = "No Asset"
Window.defaultTab = "Inspect"

function Window.new(frame: Frame)
	local self = setmetatable({}, Window)

	local content = frame.Tab.Content

	self.frame = frame
	self.scale = frame.UIScale
	self.assetButton = content.AssetMenu
	self.animateButton = content.Animate
	self.settingsButton = content.CreateSettings
	self.emitModuleButton = content.EmitModule
	self.exitButton = content.CreateExit
	self.tabBar = frame.Workspace.Tabs
	self.pages = frame.Workspace.Pages
	self.templates = frame.Templates
	self.dragger = Dragger.new(content.Drag, frame)
	self.currentTab = nil
	self.tabHandlers = {}
	self.connections = {}
	self.renameConnection = nil

	self:bind()
	self:setTab(Window.defaultTab)
	self:setAssetName(nil)

	return self
end

function Window:bind()
	for _, name in Window.tabs do
		local button = self.tabBar[name .. Window.tabSuffix]

		table.insert(self.connections, button.Activated:Connect(function()
			self:setTab(name)
		end))
	end
end

function Window:getFrame(): Frame
	return self.frame
end

function Window:getScale(): number
	return if self.scale.Scale > 0 then self.scale.Scale else 1
end

function Window:setScale(scale: number)
	self.scale.Scale = math.clamp(scale, 0.5, 2)
end

function Window:getPage(name: string): Frame
	return self.pages[name]
end

function Window:getTab(): string?
	return self.currentTab
end

function Window:addTabHandler(handler: (string) -> ())
	table.insert(self.tabHandlers, handler)
end

function Window:setTab(name: string)
	if self.currentTab == name then
		return
	end

	self.currentTab = name

	local colors = configuration.Colors

	for _, other in Window.tabs do
		local active = other == name
		local button = self.tabBar[other .. Window.tabSuffix]

		self.pages[other].Visible = active
		button.Indicator.Visible = active
		button.Label.TextColor3 = if active then colors.Text else colors.SubtleText
	end

	for _, handler in self.tabHandlers do
		handler(name)
	end
end

function Window:setAssetName(name: string?)
	self.assetButton.Label.Text = name or Window.noAssetText
	self.assetButton.Label.TextColor3 = if name then configuration.Colors.Text else configuration.Colors.SubtleText
end

function Window:endRename()
	if self.renameConnection then
		self.renameConnection:Disconnect()
		self.renameConnection = nil
	end

	local box = self.assetButton.RenameBox

	box.Visible = false
	box:ReleaseFocus(false)
	self.assetButton.Label.Visible = true
end

function Window:beginRename(current: string, callback: (string) -> ())
	self:endRename()

	local box = self.assetButton.RenameBox

	box.Text = current
	box.Visible = true
	self.assetButton.Label.Visible = false

	self.renameConnection = box.FocusLost:Connect(function(enterPressed)
		local text = box.Text

		self:endRename()

		if enterPressed then
			callback(text)
		end
	end)

	box:CaptureFocus()
	box.SelectionStart = 1
	box.CursorPosition = #box.Text + 1
end

function Window:isRenaming(): boolean
	return self.renameConnection ~= nil
end

function Window:endDrag()
	self.dragger:endDrag()
end

function Window:destroy()
	self:endRename()
	self.dragger:destroy()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	table.clear(self.tabHandlers)
end

return Window
]]></ProtectedString>
