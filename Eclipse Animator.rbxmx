					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local selectionService = game:GetService("Selection")

local organization = require("organization")
local state = require("state")
local config = require("config")
local ui = require("ui")
local project = require("project")
local export = require("export")
local armatureImport = require("armatureImport")
local notification = require("notification")
local alert = require("alert")
local windowFx = require("windowFx")
local data = require("projectData")
local history = require("history")
local legacyEvents = require("legacyEvents")

local buttons = {}

local attached = false
local membership = require("membership")
local pendingArmature = setmetatable({}, { __mode = "k" })

local function attach()
	if attached then
		return
	end

	attached = true
	local function hideWindow(frame)
		local shrunk = pcall(windowFx.shrink, frame, function()
			ui.EclipseGUI.Enabled = false
		end)
		if not shrunk then
			ui.EclipseGUI.Enabled = false
		end
	end

	ui.RequestEvent.OnInvoke = function(action)
		if action == "IsInProject" then
			return ui.PluginActiveBool.Value and ui.AnimatorFrame.Visible
		end

		if action == "RequestCloseProject" then
			if ui.PluginActiveBool.Value and ui.AnimatorFrame.Visible then
				alert.showReturnWarning()
			else
				hideWindow(ui.PrimaryFrame.Visible and ui.PrimaryFrame or ui.AnimatorFrame)
			end

			return true
		end

		return false
	end

	ui.ExitButton.MouseButton1Click:Connect(function()
		local finalized, issue = pcall(function()
			if not state.LoadingProject and not state.Timeline:IsExportLocked() then
				project.finalizeCurrentManipulation()
			end
		end)
		if not finalized then
			warn("[Eclipse] " .. tostring(issue))
		end

		hideWindow(ui.AnimatorFrame.Visible and ui.AnimatorFrame or ui.PrimaryFrame)
	end)

	local nameBox = ui.ProjectNameTextBox
	nameBox.ClearTextOnFocus = false
	nameBox.Focused:Connect(function()
		if nameBox.Text:match("%S") then
			nameBox.PlaceholderText = nameBox.Text
		end

		nameBox.Text = ""
	end)
	nameBox.FocusLost:Connect(function()
		local oldName = nameBox.PlaceholderText
		local nextName = nameBox.Text:match("%S") and data.sanitizeExportName(nameBox.Text)
			or oldName
		project.setProjectName(nextName)
		if nextName ~= oldName then
			state.currentProjectSaved = false
			export.requestRename(nextName)
		end
	end)

	armatureImport.resolveTarget = function()
		local rigs = state.getAllRigs()
		if not ui.PluginActiveBool.Value then
			return nil
		end

		local chosen = {}

		local function collect(part)
			if typeof(part) ~= "Instance" then
				return
			end

			local reference = part.Parent and part.Parent:FindFirstChild("EclipseSourceRig")
			part = reference and reference.Value or part
			for _, rig in rigs do
				if part == rig or part:IsDescendantOf(rig) then
					chosen[rig] = true
					return true
				end
			end
		end

		local selection = selectionService:Get()
		for _, part in selection do
			if not collect(part) then
				return nil
			end
		end

		if next(chosen) == nil and state.Rig then
			for item, selected in state.Rig._selectedItems do
				if selected then
					collect((item.grandpa or item).linkedRigInstance)
				end
			end
		end

		local target
		for rig in chosen do
			if target then
				return nil
			end

			target = rig
		end

		return target or (#rigs == 1 and rigs[1] or nil)
	end

	armatureImport.onBeforeImport = function(rig)
		if state.currentRig and ui.PluginActiveBool.Value and state.Timeline then
			local tl = state.Timeline:GetState()
			tl.Playing = false
			tl.CurrentTime = 0
			state.Timeline:ApplyPoseAtTime(state.currentRig, 0)
			state.Timeline:UpdatePlayhead()
			pendingArmature[rig] = membership.capture(tl, rig)
		end
	end

	armatureImport.onImported = function(arm, rigRoot)
		if not state.currentRig then
			return
		end

		if not ui.PluginActiveBool.Value then
			return
		end

		local active = false
		for _, rig in state.getAllRigs() do
			if rigRoot == rig or rigRoot:IsDescendantOf(rig) or rig:IsDescendantOf(rigRoot) then
				active = true
				break
			end
		end

		if active then
			local tl = state.Timeline:GetState()
			tl.Playing = false
			tl.CurrentTime = 0
			local previous = pendingArmature[rigRoot]
			if previous then
				local live = {}
				for _, motor in require("parenting").collectMotors(rigRoot) do
					live[motor] = true
					live[motor.Part1] = true
				end

				local retained = {}
				for field, values in previous do
					if field ~= "owned" then
						retained[field] = {}
						for key, value in values do
							if live[field == "MotorByPart" and value or key] then
								retained[field][key] = value
							end
						end
					end
				end

				for motor in previous.Keyframes do
					if not live[motor] then
						state.Timeline:_restoreMotorBucket(motor, {})
					end
				end

				membership.remove(tl, rigRoot, previous)
				membership.restoreNativeDefaults(tl, rigRoot, previous)
				membership.restore(tl, retained)
				for motor in state.lastCFrames do
					if not live[motor] and membership.belongs(motor, rigRoot, previous.owned) then
						state.lastCFrames[motor] = nil
					end
				end

				pendingArmature[rigRoot] = nil
			end

			state.currentProjectSaved = false
			state.Timeline:CaptureDefaultPoseAdditive(rigRoot)
			state.Rig:BuildRigHierarchy(state.currentRig)
			state.Rig:CreateBonesForRig(state.currentRig)
			if rigRoot ~= state.currentRig then
				state.Rig:CreateBonesForRig(rigRoot)
			end

			state.Timeline:UpdatePlayhead()
		end
	end

	ui.ProjectCreator_BTN.MouseButton1Click:Connect(function()
		local selectedRigs = project.getSelectedAnimatableRigs()
		if #selectedRigs > 1 then
			project.openEmptyProject(nil)
			for _, rig in selectedRigs do
				project.addRigToTimeline(
					rig,
					{ Loading = true, AllowDuplicateName = true, NewRig = true }
				)
			end

			state.currentProjectSaved = false
			history.clear()
			return
		end

		local selected = project.getSelectedAnimatableRig()
		if not selected then
			return
		end

		project.stopAllAnimations()
		project.setProjectName(data.getNextDefaultExportName(selected:FindFirstChild("AnimSaves")))
		state.currentRig = selected
		state.currentProjectSave = nil
		state.currentProjectSequence = nil
		pcall(function()
			armatureImport.restore(selected)
		end)
		ui.PluginActiveBool.Value = true
		state.currentProjectSaved = false
		table.clear(state.lastCFrames)
		table.clear(state.extraRigs)
		table.clear(state.activeObjectMotors)
		project.syncObjectMotorStates()

		history.clear()
		state.Timeline:ClearTimelineData()
		organization.reset()
		state.Timeline:LoadProjectSettings()
		state.Timeline:CaptureDefaultPose(state.currentRig, true)
		state.Timeline:InitializeRotationModeForRig(state.currentRig)
		state.Timeline:SetLooping(true)
		state.Timeline:SetRecording(true)

		state.Rig:LockRigLimbs(state.currentRig, true)
		state.Axis:SetCurrentRig(state.currentRig)

		ui.PrimaryFrame.Visible = false
		ui.AnimatorFrame.Visible = true

		state.ignoreSelectionChanged = true
		selectionService:Set({})
		state.ignoreSelectionChanged = false

		state.Timeline:BuildTimelineUI(project.getCurrentRig)
		state.Timeline:GetState().CurrentTime = 0
		state.Timeline:GetState().Playing = false
		state.Timeline:UpdatePlayhead()

		state.Rig:BuildRigHierarchy(state.currentRig)
		state.Rig:CreateBonesForRig(state.currentRig)

		project.clearAnimButtons()
		if state.currentRig:FindFirstChild("AnimSaves") then
			project.populateAnimButtons(state.currentRig)
		end

		history.armGuard()
	end)

	ui.BlankProjectCreator_BTN.MouseButton1Click:Connect(function()
		local selected = project.getSelectedAnimatableRigs()
		project.openEmptyProject(nil)
		project.addSelectionToTimeline(
			selected,
			{ Loading = true, AllowDuplicateName = true, NewRig = true }
		)
		history.clear()
	end)

	ui.ReturnButton.MouseButton1Click:Connect(function()
		if state.LoadingProject or state.Timeline:IsExportLocked() then
			return
		end

		if state.currentProjectSaved then
			project.clearCurrentRig(true)
		else
			alert.showReturnWarning()
		end
	end)

	ui.AgreeButton.MouseButton1Click:Connect(function()
		if state.LoadingProject or state.Timeline:IsExportLocked() then
			return
		end

		alert.hideReturnWarning(function()
			project.clearCurrentRig(true)
			state.currentProjectSaved = false
			ui.PrimaryFrame.Visible = true
			windowFx.pop(ui.PrimaryFrame)
		end)
	end)

	ui.DisagreeButton.MouseButton1Click:Connect(function()
		alert.hideReturnWarning(function()
			ui.AnimatorFrame.Visible = true
			windowFx.pop(ui.AnimatorFrame)
		end)
	end)

	ui.ExportButton.MouseButton1Click:Connect(function()
		export.exportCurrentAnimation()
	end)

	if ui.SaveButton then
		ui.SaveButton.MouseButton1Click:Connect(function()
			export.saveProject()
		end)
		ui.SaveButton.MouseButton2Click:Connect(function()
			require("fileTools").openSaveAs()
		end)
	end

	if ui.AddRigButton then
		ui.AddRigButton.MouseButton1Click:Connect(function()
			if not ui.isAnimatorActive() then
				return
			end

			local selected = selectionService:Get()[1]
			if not selected then
				notification.show(
					"NOTHING SELECTED",
					"Select a rig or an object to add it to the timeline."
				)
				return
			end

			if #selectionService:Get() == 1 and legacyEvents.isTrack(selected) then
				local item = state.Rig._lastClickedItem
				local owner = item and (item.grandpa or item)
				local target = owner and owner.linkedRigInstance or state.Rig._lastEventRig
				local matched = false
				for _, rig in state.getAllRigs() do
					if target == rig then
						matched = true
						break
					end
				end

				state.Timeline:ImportLegacyEvents(selected, matched and target or state.currentRig)
				return
			end

			project.addSelectionToTimeline()
		end)
	end

	ui.ClosingEvent.Event:Connect(function()
		if state.UIHelpers then
			state.UIHelpers:Destroy()
		end

		if
			state.currentRig
			and not state.currentProjectSaved
			and state.Timeline
			and state.Timeline:HasAnyKeyframes()
		then
			export.exportCurrentAnimation({ showResults = false })
		end
	end)

	local descriptions = config.UI.Descriptions or {}
	local hoverDialog = state.UIHelpers and state.UIHelpers.hoverDialog
	if hoverDialog then
		for _, frame in { ui.PrimaryFrame, ui.AnimatorFrame } do
			local bar = frame:FindFirstChild("Bar")
			local appearance = bar and bar:FindFirstChild("Appearence")
			local icon = appearance and appearance:FindFirstChild("Icon")
			if icon then
				hoverDialog:latchToInstance(
					icon,
					"Community Server - find the link on our Creator Store page. Developed by riftkuro"
				)
			end
		end

		if ui.AddRigButton then
			hoverDialog:latchToInstance(ui.AddRigButton, function()
				local selected = selectionService:Get()[1]
				if selected and selected:FindFirstChildOfClass("Humanoid") then
					return descriptions.AddRig or "Add Rig"
				end

				return descriptions.AddObject or "Add Object"
			end)
		end

		hoverDialog:latchToInstance(ui.LoopButton, function()
			if state.Timeline and state.Timeline:IsLooping() then
				return descriptions.LoopOn or "Disable Loop"
			end

			return descriptions.LoopOff or "Enable Loop"
		end)

		if ui.RecordButton then
			hoverDialog:latchToInstance(ui.RecordButton, function()
				if state.Timeline and state.Timeline:IsRecording() then
					return descriptions.RecordOn or "Disable Live Recording"
				end

				return descriptions.RecordOff or "Enable Live Recording"
			end)
		end

		if ui.SaveButton then
			hoverDialog:latchToInstance(ui.SaveButton, function()
				return "Save " .. export.documentKind()
			end)
		end

		hoverDialog:latchToInstance(ui.ExportButton, descriptions.Export or "Export Animation")
		hoverDialog:latchToInstance(ui.ReturnButton, descriptions.Close or "Close Animation")
	end
end

buttons.attach = attach

return buttons
]]></ProtectedString>
						<string name="ScriptGuid">{1E5D818A-6A1C-4E0F-ADF4-23B589F32F2D}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">buttons</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1923033A9CFA4E3FB9C2261029BC3735">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local chrome = require("chrome")
local toolModule = require("tool")
local gifEditor = require("gifEditor")
local userInputService = game:GetService("UserInputService")
local httpService = game:GetService("HttpService")

local theme = require("theme")
local themeConfig = require("themeConfig")
local windowFx = require("windowFx")
local mainState = require("state")

local customize = {}

local font = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
local iconReset = "rbxassetid://78735604616196"
local iconSave = "rbxassetid://133945325216888"
local iconLoad = "rbxassetid://117142004423616"
local iconClose = "rbxassetid://104480403429046"
local cardBg = Color3.fromRGB(26, 14, 40)
local fieldBg = Color3.fromRGB(16, 7, 26)
local chipBg = Color3.fromRGB(100, 0, 151)
local txt = Color3.fromRGB(235, 228, 242)
local txtDim = Color3.fromRGB(157, 157, 157)

local screenGui = nil
local window = nil
local scroll = nil
local grid = nil
local modeChip = nil
local presetsChip = nil
local presetsFrame = nil
local showingPresets = false
local userPresets = {}
local getSetting = nil
local setSetting = nil
local tooltip = nil
local resetHint = nil
local picker = nil
local modal = nil
local layoutTool = nil
local windowRefs = nil
local cards = {}
local pickerKey = nil
local pickerValue = nil
local pickerSnapshot = nil
local pickerStop = 1
local lastResetPress = 0
local initialized = false
local closing = false
local suppressPickerClose = false

local editingFields = setmetatable({}, { __mode = "k" })

local function fieldText(box)
	return editingFields[box] or box.Text
end

local function setFieldText(box, value)
	if editingFields[box] == nil then
		box.Text = value
	end
end

local function mk(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end

	if inst:IsA("TextBox") then
		inst.ClearTextOnFocus = false
		inst.Focused:Connect(function()
			if not inst.TextEditable or inst:GetAttribute("PreserveTextOnFocus") then
				return
			end

			editingFields[inst] = inst.Text
			inst.Text = ""
		end)

		inst.FocusLost:Connect(function()
			local previous = editingFields[inst]
			editingFields[inst] = nil
			if previous ~= nil and not inst.Text:match("%S") then
				inst.Text = previous
			end
		end)
	end

	inst.Parent = parent
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		inst:SetAttribute("ThemeTxt", "Txt")
	end

	return inst
end

local function corner(inst, r)
	mk("UICorner", { CornerRadius = UDim.new(0, r) }, inst)
end

local function copyValue(v)
	if not v then
		return nil
	end

	local stops = {}
	for _, c in ipairs(v.stops or {}) do
		table.insert(stops, c)
	end

	return {
		stops = stops,
		rot = v.rot,
		t = v.t,
		image = v.image,
		frames = v.frames,
		layout = v.layout and table.clone(v.layout),
		mode = v.mode,
	}
end

local function baseKeyFor(key)
	local exp = themeConfig.simpleExpand[key]
	if exp then
		return exp[1].target
	end

	return key
end

local function currentValueFor(key)
	local base = baseKeyFor(key)
	local ov = theme.getOverride(base)
	if ov then
		return copyValue(ov)
	end

	return copyValue(theme.sampleDefaultValue(base))
end

local function accent()
	return theme.get("MenuSel", chipBg)
end

local function guiScale()
	local sc = screenGui and screenGui:FindFirstChildOfClass("UIScale")
	return (sc and sc.Scale) or 1
end

local function ensureTooltip()
	if tooltip then
		return
	end

	tooltip = mk("TextLabel", {
		Name = "EclipseCustomizeTip",
		BackgroundColor3 = Color3.fromRGB(12, 5, 20),
		TextColor3 = txt,
		FontFace = font,
		TextSize = 9,
		Visible = false,
		ZIndex = 120,
		AutomaticSize = Enum.AutomaticSize.XY,
		Text = "",
	}, screenGui)
	corner(tooltip, 4)
	mk("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
	}, tooltip)
	local tipStroke =
		mk("UIStroke", { Color = Color3.fromRGB(140, 80, 210), Transparency = 0.4 }, tooltip)
	tooltip:SetAttribute("ThemeBg", "Tip")
	tooltip:SetAttribute("ThemeTxt", "TipT")
	tipStroke:SetAttribute("ThemeStrk", "Strk")
end

local function moveTooltip()
	local mp = userInputService:GetMouseLocation()
	local scale = guiScale()
	tooltip.Position = UDim2.fromOffset(
		(mp.X - screenGui.AbsolutePosition.X) / scale + 14,
		(mp.Y - screenGui.AbsolutePosition.Y) / scale + 12
	)
end

local function attachTip(gui, textOrFn)
	local hd = mainState.UIHelpers and mainState.UIHelpers.hoverDialog
	if hd then
		hd:latchToInstance(gui, textOrFn)
		return
	end

	ensureTooltip()
	gui.MouseEnter:Connect(function()
		tooltip.Text = typeof(textOrFn) == "function" and textOrFn() or textOrFn
		moveTooltip()
		tooltip.Visible = true
	end)
	gui.MouseMoved:Connect(function()
		if tooltip.Visible then
			moveTooltip()
		end
	end)
	gui.MouseLeave:Connect(function()
		tooltip.Visible = false
	end)
end

local function tagText(lbl, shade)
	lbl:SetAttribute("ThemeTxt", "Txt")
	if shade then
		lbl:SetAttribute("ThemeShade", shade)
	end

	return lbl
end

local function tagField(box)
	local shell = Instance.new("Frame")
	shell.Name = box.Name .. "Surface"
	shell.Size = box.Size
	shell.Position = box.Position
	shell.AnchorPoint = box.AnchorPoint
	shell.ZIndex = box.ZIndex
	shell.BorderSizePixel = 0
	shell.BackgroundColor3 = box.BackgroundColor3
	shell.Parent = box.Parent
	shell:SetAttribute("ThemeBg", "Pnl")
	shell:SetAttribute("ThemeShade", -0.45)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = shell
	box.Parent = shell
	box.Size = UDim2.fromScale(1, 1)
	box.Position = UDim2.new()
	box.AnchorPoint = Vector2.zero
	box.BackgroundTransparency = 1
	box.ZIndex = shell.ZIndex + 1
	box:SetAttribute("ThemeTxt", "Txt")
	box:SetAttribute("ThemeShade", nil)
	return box
end

local function paintSwatch(swatch, v)
	local g = swatch:FindFirstChild("SwatchGradient")
	if v.stops and #v.stops > 1 then
		swatch.BackgroundColor3 = Color3.new(1, 1, 1)
		local kps = {}
		for i, c in ipairs(v.stops) do
			table.insert(kps, ColorSequenceKeypoint.new((i - 1) / (#v.stops - 1), c))
		end

		g.Color = ColorSequence.new(kps)
		g.Rotation = v.rot or 90
		g.Enabled = true
	else
		g.Enabled = false
		swatch.BackgroundColor3 = (v.stops and v.stops[1]) or Color3.new(1, 1, 1)
	end
end

local function refreshCards()
	for _, card in pairs(cards) do
		if card.refresh then
			card.refresh()
		end
	end
end

local closePicker

local commitQueued = false
local commitTransient = false

local function commitPicker(transient)
	commitTransient = transient == true and (commitQueued == false or commitTransient)
	if commitQueued then
		return
	end

	commitQueued = true
	task.defer(function()
		commitQueued = false
		if pickerKey and pickerValue then
			theme.set(pickerKey, copyValue(pickerValue), commitTransient)
			refreshCards()
		end
	end)
end

local function positionPicker()
	if not picker or not window then
		return
	end

	local scale = guiScale()
	local guiPos = screenGui.AbsolutePosition
	local x = (window.AbsolutePosition.X - guiPos.X + window.AbsoluteSize.X) / scale + 10
	local y = (window.AbsolutePosition.Y - guiPos.Y) / scale + 30
	local cam = workspace.CurrentCamera
	if cam and (x + 190) * scale > cam.ViewportSize.X then
		x = (window.AbsolutePosition.X - guiPos.X) / scale - 190
	end

	picker.Position = UDim2.fromOffset(x, y)
end

local function buildPicker()
	picker = mk("Frame", {
		Name = "EclipseColorPicker",
		Size = UDim2.fromOffset(180, 288),
		Position = UDim2.new(0.5, 250, 0.5, -160),
		BackgroundColor3 = Color3.fromRGB(20, 9, 32),
		Visible = false,
		ZIndex = 90,
	}, screenGui)
	corner(picker, 8)
	local pickerStroke = mk(
		"UIStroke",
		{ Color = Color3.fromRGB(120, 70, 180), Transparency = 0.4, Thickness = 1 },
		picker
	)
	picker:SetAttribute("ThemeBg", "Bg")
	pickerStroke:SetAttribute("ThemeStrk", "Strk")

	local sv = mk("ImageButton", {
		Name = "SV",
		Size = UDim2.fromOffset(160, 96),
		Position = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Color3.new(1, 0, 0),
		AutoButtonColor = false,
		ZIndex = 31,
	}, picker)
	corner(sv, 4)
	local whiteOv = mk(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 31 },
		sv
	)
	corner(whiteOv, 4)
	mk("UIGradient", { Transparency = NumberSequence.new(0, 1) }, whiteOv)
	local blackOv = mk(
		"Frame",
		{ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 32 },
		sv
	)
	corner(blackOv, 4)
	mk("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90 }, blackOv)
	local svCursor = mk("Frame", {
		Name = "Cursor",
		Size = UDim2.fromOffset(8, 8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 33,
	}, sv)
	mk("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1.5 }, svCursor)
	corner(svCursor, 4)

	local hue = mk("ImageButton", {
		Name = "Hue",
		Size = UDim2.fromOffset(160, 12),
		Position = UDim2.fromOffset(10, 112),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		ZIndex = 31,
	}, picker)
	corner(hue, 6)
	local hueKps = {}
	for i = 0, 6 do
		table.insert(
			hueKps,
			ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 == 1 and 0.999 or i / 6, 1, 1))
		)
	end

	mk("UIGradient", { Color = ColorSequence.new(hueKps) }, hue)
	local hueCursor = mk("Frame", {
		Name = "Cursor",
		Size = UDim2.new(0, 3, 1, 2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 33,
	}, hue)
	corner(hueCursor, 2)

	local hexBox = tagField(mk("TextBox", {
		Name = "Hex",
		Size = UDim2.fromOffset(70, 18),
		Position = UDim2.fromOffset(10, 132),
		BackgroundColor3 = fieldBg,
		TextColor3 = txt,
		FontFace = font,
		TextSize = 10,
		Text = "#ffffff",
		ClearTextOnFocus = false,
		ZIndex = 31,
	}, picker))
	corner(hexBox, 4)
	local rgbBoxes = {}
	for i = 1, 3 do
		local b = tagField(mk("TextBox", {
			Size = UDim2.fromOffset(26, 18),
			Position = UDim2.fromOffset(84 + (i - 1) * 29, 132),
			BackgroundColor3 = fieldBg,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 10,
			Text = "255",
			ClearTextOnFocus = false,
			ZIndex = 31,
		}, picker))
		corner(b, 4)
		rgbBoxes[i] = b
	end

	local flatBtn = mk("TextButton", {
		Name = "Flat",
		Size = UDim2.fromOffset(76, 18),
		Position = UDim2.fromOffset(10, 156),
		BackgroundColor3 = Color3.fromRGB(100, 0, 151),
		TextColor3 = txt,
		FontFace = font,
		TextSize = 10,
		Text = "FLAT",
		AutoButtonColor = true,
		ZIndex = 31,
	}, picker)
	corner(flatBtn, 4)
	local gradBtn = mk("TextButton", {
		Name = "Grad",
		Size = UDim2.fromOffset(76, 18),
		Position = UDim2.fromOffset(94, 156),
		BackgroundColor3 = fieldBg,
		TextColor3 = txt,
		FontFace = font,
		TextSize = 10,
		Text = "GRADIENT",
		AutoButtonColor = true,
		ZIndex = 31,
	}, picker)
	corner(gradBtn, 4)

	local stopA = mk("TextButton", {
		Name = "StopA",
		Size = UDim2.fromOffset(24, 18),
		Position = UDim2.fromOffset(10, 180),
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 31,
	}, picker)
	corner(stopA, 4)
	mk("UIStroke", { Name = "Sel", Color = Color3.new(1, 1, 1), Thickness = 1.5 }, stopA)
	local stopB = mk("TextButton", {
		Name = "StopB",
		Size = UDim2.fromOffset(24, 18),
		Position = UDim2.fromOffset(40, 180),
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 31,
	}, picker)
	corner(stopB, 4)
	mk(
		"UIStroke",
		{ Name = "Sel", Color = Color3.new(1, 1, 1), Thickness = 1.5, Transparency = 1 },
		stopB
	)
	local rotLabel = tagText(
		mk("TextLabel", {
			Size = UDim2.fromOffset(28, 18),
			Position = UDim2.fromOffset(72, 180),
			BackgroundTransparency = 1,
			TextColor3 = txtDim,
			FontFace = font,
			TextSize = 9,
			Text = "ROT",
			ZIndex = 31,
		}, picker),
		-0.35
	)
	local rotBox = tagField(mk("TextBox", {
		Name = "Rot",
		Size = UDim2.fromOffset(36, 18),
		Position = UDim2.fromOffset(100, 180),
		BackgroundColor3 = fieldBg,
		TextColor3 = txt,
		FontFace = font,
		TextSize = 10,
		Text = "90",
		ClearTextOnFocus = false,
		ZIndex = 31,
	}, picker))
	corner(rotBox, 4)

	local palette = {
		Color3.fromRGB(255, 255, 255),
		Color3.fromRGB(20, 20, 24),
		Color3.fromRGB(255, 84, 84),
		Color3.fromRGB(255, 157, 77),
		Color3.fromRGB(255, 222, 114),
		Color3.fromRGB(85, 200, 120),
		Color3.fromRGB(96, 200, 255),
		Color3.fromRGB(90, 120, 255),
		Color3.fromRGB(160, 90, 255),
		Color3.fromRGB(255, 105, 180),
	}
	for i, pc in ipairs(palette) do
		local col = (i - 1) % 5
		local rowIdx = math.floor((i - 1) / 5)
		local pb = mk("TextButton", {
			Size = UDim2.fromOffset(24, 14),
			Position = UDim2.fromOffset(10 + col * 32, 204 + rowIdx * 18),
			Text = "",
			AutoButtonColor = true,
			BackgroundColor3 = pc,
			ZIndex = 31,
		}, picker)
		corner(pb, 4)
		pb.MouseButton1Click:Connect(function()
			if pickerValue then
				pickerValue.stops[math.min(pickerStop, #pickerValue.stops)] = pc
				commitPicker()
				customize._refreshPicker()
			end
		end)
	end

	local cancelBtn = mk("TextButton", {
		Size = UDim2.new(0.5, -13, 0, 20),
		Position = UDim2.fromOffset(10, 258),
		BackgroundColor3 = fieldBg,
		TextColor3 = txtDim,
		FontFace = font,
		TextSize = 10,
		Text = "CANCEL",
		ZIndex = 31,
	}, picker)
	corner(cancelBtn, 5)
	cancelBtn:SetAttribute("ThemeBg", "Pnl")
	cancelBtn:SetAttribute("ThemeShade", -0.45)
	cancelBtn:SetAttribute("ThemeTxt", "Txt")
	local doneBtn = mk("TextButton", {
		Size = UDim2.new(0.5, -13, 0, 20),
		Position = UDim2.new(0.5, 3, 0, 258),
		BackgroundColor3 = Color3.fromRGB(100, 0, 151),
		TextColor3 = txt,
		FontFace = font,
		TextSize = 10,
		Text = "DONE",
		ZIndex = 31,
	}, picker)
	corner(doneBtn, 5)
	doneBtn:SetAttribute("ThemeBg", "MenuSel")

	local gradRow = { stopA, stopB, rotLabel, rotBox.Parent }

	local function curColor()
		return pickerValue.stops[math.min(pickerStop, #pickerValue.stops)]
	end

	local function setCurColor(c, transient)
		pickerValue.stops[math.min(pickerStop, #pickerValue.stops)] = c
		commitPicker(transient)
	end

	local function refreshPicker(skipHsv)
		if not pickerValue then
			return
		end

		local isGrad = #pickerValue.stops > 1
		local inactive = theme.get("Pnl", fieldBg):Lerp(Color3.new(0, 0, 0), 0.3)
		flatBtn.BackgroundColor3 = isGrad and inactive or accent()
		gradBtn.BackgroundColor3 = isGrad and accent() or inactive
		for _, chip in { flatBtn, gradBtn } do
			local c = chip.BackgroundColor3
			chip.TextColor3 = c.R * 0.2126 + c.G * 0.7152 + c.B * 0.0722 > 0.55
					and Color3.fromRGB(15, 25, 28)
				or theme.get("Txt", txt)
		end

		for _, el in ipairs(gradRow) do
			el.Visible = isGrad
		end

		stopA.BackgroundColor3 = pickerValue.stops[1]
		if isGrad then
			stopB.BackgroundColor3 = pickerValue.stops[2]
		end

		stopA.Sel.Transparency = pickerStop == 1 and 0 or 1
		stopB.Sel.Transparency = pickerStop == 2 and 0 or 1
		local c = curColor()
		local h, s, v = c:ToHSV()
		if not skipHsv then
			sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			svCursor.Position = UDim2.fromScale(s, 1 - v)
			hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
		end

		setFieldText(
			hexBox,
			string.format(
				"#%02x%02x%02x",
				math.round(c.R * 255),
				math.round(c.G * 255),
				math.round(c.B * 255)
			)
		)
		setFieldText(rgbBoxes[1], tostring(math.round(c.R * 255)))
		setFieldText(rgbBoxes[2], tostring(math.round(c.G * 255)))
		setFieldText(rgbBoxes[3], tostring(math.round(c.B * 255)))
		setFieldText(rotBox, tostring(pickerValue.rot or 90))
	end

	theme.onChanged(function()
		if picker and picker.Visible then
			refreshPicker()
		end
	end)

	local draggingSv = false
	local draggingHue = false

	local function applySvFromMouse()
		local mp = userInputService:GetMouseLocation()
		local p = sv.AbsolutePosition
		local sz = sv.AbsoluteSize
		local s = math.clamp((mp.X - p.X) / sz.X, 0, 1)
		local vv = 1 - math.clamp((mp.Y - p.Y) / sz.Y, 0, 1)
		local h = select(1, curColor():ToHSV())
		local baseH = select(1, sv.BackgroundColor3:ToHSV())
		svCursor.Position = UDim2.fromScale(s, 1 - vv)
		setCurColor(Color3.fromHSV(baseH, s, vv), true)
		refreshPicker(true)
	end

	local function applyHueFromMouse()
		local mp = userInputService:GetMouseLocation()
		local p = hue.AbsolutePosition
		local sz = hue.AbsoluteSize
		local h = math.clamp((mp.X - p.X) / sz.X, 0, 0.999)
		local c = curColor()
		local _, s, v = c:ToHSV()
		hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		setCurColor(Color3.fromHSV(h, math.max(s, 0.001), math.max(v, 0.001)), true)
		refreshPicker(true)
	end

	sv.MouseButton1Down:Connect(function()
		draggingSv = true
		applySvFromMouse()
	end)
	hue.MouseButton1Down:Connect(function()
		draggingHue = true
		applyHueFromMouse()
	end)
	userInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		if draggingSv then
			applySvFromMouse()
		end

		if draggingHue then
			applyHueFromMouse()
		end
	end)
	userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local wasDragging = draggingSv or draggingHue
			draggingSv = false
			draggingHue = false
			if wasDragging then
				commitPicker()
			end
		end
	end)

	hexBox.FocusLost:Connect(function()
		local v = theme.parseValue(hexBox.Text:gsub("%s", ""))
		if v then
			setCurColor(v.stops[1])
		end

		refreshPicker()
	end)
	for i, box in ipairs(rgbBoxes) do
		require("numericInput").connect(box, { step = 1 }, function()
			local n = tonumber(box.Text)
			if n then
				local c = curColor()
				local rgb = { math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255) }
				rgb[i] = math.clamp(math.round(n), 0, 255)
				setCurColor(Color3.fromRGB(rgb[1], rgb[2], rgb[3]))
			end

			refreshPicker()
		end)
	end

	require("numericInput").connect(rotBox, { step = 1 }, function()
		local n = tonumber(rotBox.Text)
		if n then
			pickerValue.rot = math.round(n)
			commitPicker()
		end

		refreshPicker()
	end)

	flatBtn.MouseButton1Click:Connect(function()
		if #pickerValue.stops > 1 then
			pickerValue.stops = { pickerValue.stops[1] }
			pickerValue.rot = nil
			pickerStop = 1
			commitPicker()
		end

		refreshPicker()
	end)
	gradBtn.MouseButton1Click:Connect(function()
		if #pickerValue.stops == 1 then
			pickerValue.stops =
				{ pickerValue.stops[1], pickerValue.stops[1]:Lerp(Color3.new(0, 0, 0), 0.5) }
			pickerValue.rot = pickerValue.rot or 90
			commitPicker()
		end

		refreshPicker()
	end)
	stopA.MouseButton1Click:Connect(function()
		pickerStop = 1
		refreshPicker()
	end)
	stopB.MouseButton1Click:Connect(function()
		pickerStop = 2
		refreshPicker()
	end)
	doneBtn.MouseButton1Click:Connect(function()
		closePicker()
	end)
	cancelBtn.MouseButton1Click:Connect(function()
		if pickerSnapshot then
			theme.load(pickerSnapshot)
			refreshCards()
		end

		closePicker()
	end)

	picker:SetAttribute("RefreshPicker", true)
	customize._refreshPicker = refreshPicker
end

closePicker = function()
	if picker and picker.Visible then
		windowFx.shrink(picker, function()
			picker.Visible = false
			pickerKey = nil
			pickerValue = nil
		end)
	else
		pickerKey = nil
		pickerValue = nil
	end
end

local function openPicker(key)
	pickerKey = key
	pickerValue = currentValueFor(key)
	pickerSnapshot = theme.encode()
	pickerStop = 1
	positionPicker()
	customize._refreshPicker()
	theme.applyTree(picker)
	picker.Visible = true
	windowFx.pop(picker)
end

local function openBackgroundLayout()
	if layoutTool and not layoutTool.closed then
		return
	end

	if not window or not window.Visible or closing then
		return
	end

	closePicker()
	if modal then
		modal:Destroy()
		modal = nil
	end

	local tool
	tool = toolModule.new(
		windowRefs,
		"EclipseBackgroundLayout",
		"BACKGROUND LAYOUT",
		Vector2.new(300, 278),
		false,

		function()
			if layoutTool == tool then
				layoutTool = nil
			end
		end,
		{ AllowMainMenu = true }
	)
	layoutTool = tool
	local panel, boxes = tool.frame, {}
	local fitLabel, parallaxLabel, smoothnessBox
	local fitNames = { Crop = "FILL", Fit = "FIT", Stretch = "STRETCH" }

	local function refresh()
		local layout = theme.getBackgroundLayout()
		if fitLabel then
			fitLabel.Text = "MODE: " .. fitNames[layout.fit]
		end
		if parallaxLabel then
			parallaxLabel.Text = "MOUSE PARALLAX: " .. (layout.parallax and "ON" or "OFF")
		end
		if smoothnessBox then
			smoothnessBox.Text = tostring(math.round(layout.smoothness))
		end
		for key, box in boxes do
			box.Text = tostring(math.round(layout[key] * 100))
		end
	end

	for i, row in
		{
			{ "scale", "Scale (%)", 25, 200 },
			{ "x", "Horizontal (%)", -100, 100 },
			{ "y", "Vertical (%)", -100, 100 },
		}
	do
		local key, y = row[1], 38 + (i - 1) * 32
		toolModule.label(
			panel,
			key .. "Label",
			row[2],
			UDim2.fromOffset(12, y),
			UDim2.fromOffset(166, 24)
		)
		local box = toolModule.field(panel, key, "", UDim2.fromOffset(184, y), UDim2.fromOffset(104, 24))
		boxes[key] = box
		require("numericInput").connect(box, { step = 1, min = row[3], max = row[4] }, function()
			if tool.closed then
				return
			end

			local n = tonumber(box.Text)
			if n then
				local layout = theme.getBackgroundLayout()
				layout[key] = n / 100
				theme.setBackgroundLayout(layout)
			end

			refresh()
		end)
	end

	local _, label = toolModule.button(
		panel,
		"FitMode",
		"MODE: FILL",
		UDim2.fromOffset(12, 138),
		UDim2.fromOffset(276, 28),
		function()
			local layout = theme.getBackgroundLayout()
			layout.fit = ({ Crop = "Fit", Fit = "Stretch", Stretch = "Crop" })[layout.fit]
			theme.setBackgroundLayout(layout)
			refresh()
		end
	)
	fitLabel = label
	local _, toggleLabel = toolModule.button(
		panel,
		"Parallax",
		"MOUSE PARALLAX: OFF",
		UDim2.fromOffset(12, 172),
		UDim2.fromOffset(276, 28),
		function()
			if tool.closed then
				return
			end
			local layout = theme.getBackgroundLayout()
			layout.parallax = not layout.parallax
			theme.setBackgroundLayout(layout)
			refresh()
		end
	)
	parallaxLabel = toggleLabel
	toolModule.label(
		panel,
		"SmoothnessLabel",
		"Smoothness (%)",
		UDim2.fromOffset(12, 206),
		UDim2.fromOffset(166, 24)
	)
	smoothnessBox =
		toolModule.field(panel, "Smoothness", "65", UDim2.fromOffset(184, 206), UDim2.fromOffset(104, 24))
	require("numericInput").connect(smoothnessBox, { step = 1, min = 0, max = 100 }, function()
		if tool.closed then
			return
		end
		local n = tonumber(smoothnessBox.Text)
		if n then
			local layout = theme.getBackgroundLayout()
			layout.smoothness = n
			theme.setBackgroundLayout(layout)
		end
		refresh()
	end)
	toolModule.button(
		panel,
		"Reset",
		"RESET",
		UDim2.fromOffset(12, 238),
		UDim2.fromOffset(132, 28),
		function()
			if tool.closed then
				return
			end

			theme.setBackgroundLayout({})
			refresh()
		end
	)
	toolModule.button(
		panel,
		"Done",
		"DONE",
		UDim2.fromOffset(156, 238),
		UDim2.fromOffset(132, 28),
		function()
			tool:close()
		end
	)
	table.insert(
		tool.connections,
		window:GetPropertyChangedSignal("Visible"):Connect(function()
			if not window.Visible then
				tool:close()
			end
		end)
	)
	table.insert(
		tool.connections,
		window.Destroying:Connect(function()
			tool:close(true)
		end)
	)
	table.insert(
		tool.connections,
		screenGui.Destroying:Connect(function()
			tool:close(true)
		end)
	)
	table.insert(
		tool.connections,
		require("userInputService").InputBegan:Connect(function(input)
			if input.KeyCode == Enum.KeyCode.Escape then
				tool:close()
			end
		end)
	)
	refresh()
end

local function buildCard(setting, order)
	local card = mk("Frame", {
		Name = setting.key,
		LayoutOrder = order,
		BackgroundColor3 = cardBg,
		BackgroundTransparency = 0.25,
	}, scroll)
	corner(card, 6)
	local cardStroke = mk(
		"UIStroke",
		{ Color = Color3.fromRGB(90, 50, 140), Transparency = 0.7, Thickness = 1 },
		card
	)
	card:SetAttribute("ThemeBg", "Pnl")
	cardStroke:SetAttribute("ThemeStrk", "Strk")

	local entry = { setting = setting }

	if setting.kind == "image" then
		tagText(mk("TextLabel", {
			Size = UDim2.new(1, -66, 0, 12),
			Position = UDim2.fromOffset(8, 6),
			BackgroundTransparency = 1,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 8,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = setting.label,
		}, card))
		local idBox = tagField(mk("TextBox", {
			Name = "BackgroundAssetId",
			Size = UDim2.new(1, -58, 0, 16),
			Position = UDim2.fromOffset(8, 17),
			BackgroundColor3 = fieldBg,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 9,
			Text = "",
			PlaceholderText = "rbxassetid://...",
			ClearTextOnFocus = false,
		}, card))
		corner(idBox, 4)
		local gif = mk("TextButton", {
			Name = "GIF",
			Text = "GIF",
			Position = UDim2.new(1, -42, 0, 36),
			Size = UDim2.fromOffset(34, 10),
			BackgroundColor3 = chipBg,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 9,
			BorderSizePixel = 0,
		}, card)
		corner(gif, 3)
		gif:SetAttribute("ThemeBg", "MenuSel")
		gif:SetAttribute("ThemeTxt", "Txt")
		local image = mk("TextButton", {
			Name = "IMAGE",
			Text = "IMAGE",
			Position = UDim2.new(1, -94, 0, 36),
			Size = UDim2.fromOffset(44, 10),
			BackgroundColor3 = chipBg,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 9,
			BorderSizePixel = 0,
		}, card)
		corner(image, 3)
		image:SetAttribute("ThemeBg", "TopBtn")
		image:SetAttribute("ThemeTxt", "Txt")
		local layout = mk("TextButton", {
			Name = "LAYOUT",
			Text = "LAYOUT",
			Position = UDim2.new(1, -154, 0, 36),
			Size = UDim2.fromOffset(52, 10),
			BackgroundColor3 = chipBg,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 9,
			BorderSizePixel = 0,
		}, card)
		corner(layout, 3)
		layout:SetAttribute("ThemeBg", "TopBtn")
		layout:SetAttribute("ThemeTxt", "Txt")
		layout.Activated:Connect(openBackgroundLayout)
		image.Activated:Connect(function()
			theme.setBackgroundMode("image")
			entry.refresh()
		end)
		gif.Activated:Connect(function()
			theme.setBackgroundMode("gif")
			entry.refresh()
			gifEditor.open(screenGui, theme.getOverride("Img"), function(frames)
				local previous = theme.getOverride("Img")
				local applied = theme.set("Img", {
					frames = frames,
					layout = previous and previous.layout,
					mode = frames and "gif" or "image",
					image = previous and previous.image or (frames and frames[1].image) or "",
					t = previous and previous.t or 0.85,
					stops = { Color3.new(1, 1, 1) },
				})
				entry.refresh()
				return applied
			end)
		end)
		local localImage = mk("TextButton", {
			Name = "LocalImage",
			Text = "LOCAL",
			Position = UDim2.fromOffset(8, 36),
			Size = UDim2.fromOffset(44, 10),
			BackgroundColor3 = chipBg,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 9,
			BorderSizePixel = 0,
		}, card)
		corner(localImage, 3)
		localImage:SetAttribute("ThemeBg", "TopBtn")
		localImage:SetAttribute("ThemeTxt", "Txt")
		local importing = false
		localImage.Activated:Connect(function()
			if importing then
				return
			end
			importing = true
			localImage.Interactable = false
			local id, message = require("upload").promptLocal()
			importing = false
			if not localImage.Parent then
				return
			end
			localImage.Interactable = true
			if id then
				local value = copyValue(theme.getOverride("Img"))
					or { stops = { Color3.new(1, 1, 1) }, t = 0.85 }
				value.image, value.mode = id, "image"
				theme.set("Img", value)
				entry.refresh()
			end
			if message then
				require("notification").show("LOCAL IMAGE", message, 7)
			end
		end)
		local tBox = tagField(mk("TextBox", {
			Name = "Transparency",
			Size = UDim2.fromOffset(34, 16),
			Position = UDim2.new(1, -42, 0, 17),
			BackgroundColor3 = fieldBg,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 10,
			Text = "0",
			ClearTextOnFocus = false,
		}, card))
		corner(tBox, 4)

		local function commitImage()
			local id = fieldText(idBox):gsub("%s", "")
			if tonumber(id) then
				id = "rbxassetid://" .. id
			end

			local t = math.clamp(tonumber(fieldText(tBox)) or 0.85, 0, 1)
			local previous = theme.getOverride("Img")
			local value = copyValue(previous) or { stops = { Color3.new(1, 1, 1) } }
			value.t = t
			if not (value.frames and value.mode ~= "image") then
				value.image = id
				value.mode = "image"
			end

			theme.set("Img", value)
		end

		idBox.FocusLost:Connect(commitImage)
		require("numericInput").connect(tBox, { step = 0.05, min = 0, max = 1 }, function()
			local value = tonumber(tBox.Text)
			if value then
				theme.setBackgroundTransparency(value)
			end

			entry.refresh()
		end)

		entry.refresh = function()
			local ov = theme.getOverride("Img")
			local playing = ov and ov.frames and ov.mode ~= "image"
			setFieldText(idBox, playing and "GIF OCCUPIED" or (ov and ov.image) or "")
			idBox.TextEditable = not playing
			gif:SetAttribute("ThemeBg", playing and "MenuSel" or "TopBtn")
			image:SetAttribute("ThemeBg", playing and "TopBtn" or "MenuSel")
			theme.applyInstance(gif)
			theme.applyInstance(image)
			setFieldText(tBox, tostring((ov and ov.t) or 0.85))
		end
	else
		local swatch = mk("ImageButton", {
			Name = "Swatch",
			Size = UDim2.fromOffset(28, 28),
			Position = UDim2.fromOffset(8, 10),
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(1, 1, 1),
		}, card)
		corner(swatch, 5)
		mk(
			"UIStroke",
			{ Color = Color3.fromRGB(255, 255, 255), Transparency = 0.75, Thickness = 1 },
			swatch
		)
		mk("UIGradient", { Name = "SwatchGradient", Enabled = false }, swatch)

		tagText(mk("TextLabel", {
			Size = UDim2.new(1, -100, 0, 12),
			Position = UDim2.fromOffset(44, 8),
			BackgroundTransparency = 1,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = setting.label,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, card))
		tagText(
			mk("TextLabel", {
				Size = UDim2.new(1, -54, 0, 18),
				Position = UDim2.fromOffset(44, 22),
				BackgroundTransparency = 1,
				TextColor3 = txtDim,
				FontFace = font,
				TextSize = 8,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				Text = setting.desc,
				TextWrapped = true,
			}, card),
			-0.35
		)

		local tBox = tagField(mk("TextBox", {
			Size = UDim2.fromOffset(34, 16),
			Position = UDim2.new(1, -42, 0, 8),
			BackgroundColor3 = fieldBg,
			TextColor3 = txt,
			FontFace = font,
			TextSize = 10,
			Text = "0",
			ClearTextOnFocus = false,
		}, card))
		corner(tBox, 4)

		swatch.MouseButton1Click:Connect(function()
			suppressPickerClose = true
			openPicker(setting.key)
			task.delay(0.05, function()
				suppressPickerClose = false
			end)
		end)
		swatch.MouseButton2Click:Connect(function()
			theme.clear(setting.key)
			refreshCards()
		end)
		require("numericInput").connect(tBox, { step = 0.05, min = 0, max = 1 }, function()
			local t = tonumber(fieldText(tBox))
			if t then
				local v = currentValueFor(setting.key)
				v.t = math.clamp(t, 0, 1)
				theme.set(setting.key, v)
			else
				entry.refresh()
			end
		end)

		entry.refresh = function()
			local v = currentValueFor(setting.key)
			paintSwatch(swatch, v)
			setFieldText(
				tBox,
				tostring(v.t or theme.restingTransparency(baseKeyFor(setting.key)) or 0)
			)
		end
	end

	entry.refresh()
	cards[setting.key] = entry
end

local function rebuildCards()
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	table.clear(cards)
	local list = theme.getMode() == "S" and themeConfig.simpleSettings or themeConfig.settings
	for order, setting in ipairs(list) do
		buildCard(setting, order)
	end

	modeChip.Text = theme.getMode() == "S" and "SIMPLE" or "ADVANCED"
end

customize._rebuildCards = rebuildCards

local function loadUserPresets()
	userPresets = {}
	local raw = getSetting and getSetting(themeConfig.presetsKey)
	local decoded = nil
	if typeof(raw) == "string" and raw ~= "" then
		pcall(function()
			decoded = httpService:JSONDecode(raw)
		end)
	end

	for i = 1, themeConfig.maxUserPresets do
		local e = typeof(decoded) == "table" and decoded[i] or nil
		userPresets[i] = {
			name = (e and typeof(e.name) == "string" and e.name) or ("Preset " .. i),
			data = (e and typeof(e.data) == "string" and e.data) or nil,
		}
	end
end

local function saveUserPresets()
	if setSetting then
		setSetting(themeConfig.presetsKey, httpService:JSONEncode(userPresets))
	end
end

local rebuildPresets

local function presetRow(order, name, hasData, tip, onApply, onSaveSlot, onRename)
	local row = mk("TextButton", {
		Size = UDim2.new(1, -6, 0, 24),
		BackgroundColor3 = cardBg,
		BackgroundTransparency = 0.25,
		Text = "",
		AutoButtonColor = true,
		LayoutOrder = order,
	}, presetsFrame)
	corner(row, 6)
	local rowStroke = mk(
		"UIStroke",
		{ Color = Color3.fromRGB(90, 50, 140), Transparency = 0.7, Thickness = 1 },
		row
	)
	row:SetAttribute("ThemeBg", "Pnl")
	rowStroke:SetAttribute("ThemeStrk", "Strk")
	local nameLbl = tagText(
		mk("TextLabel", {
			Size = UDim2.new(1, -70, 1, 0),
			Position = UDim2.fromOffset(10, 0),
			BackgroundTransparency = 1,
			TextColor3 = hasData and txt or txtDim,
			FontFace = font,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = name,
		}, row),
		hasData and 0 or -0.35
	)

	local status = tagText(mk("TextLabel", {
		Name = "LoadProgress",
		BackgroundTransparency = 1,
		Text = "",
		TextSize = 10,
		FontFace = font,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, onSaveSlot and -30 or -8, 0, 0),
		Size = UDim2.new(0, 140, 1, 0),
		Visible = false,
	}, row))
	local request = 0

	local function progressCallback(ticket)
		return function(done, total, state)
			if ticket ~= request or not row.Parent then
				return
			end

			if state == "cancelled" then
				status.Visible = false
				nameLbl.Size = UDim2.new(1, -70, 1, 0)
				return
			end

			status.Visible = true
			nameLbl.Size = UDim2.new(1, onSaveSlot and -180 or -158, 1, 0)
			nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
			local fraction = math.clamp(total == 0 and 1 or done / total, 0, 1)
			local blocks = math.floor(fraction * 10)
			status.Text = state == "partial" and (done .. "/" .. total .. " loaded - retry")
				or state == "failed" and "load failed - see notice"
				or "["
					.. string.rep("=", blocks)
					.. string.rep("-", 10 - blocks)
					.. "] "
					.. math.floor(fraction * 100)
					.. "%"
			if state == "complete" or state == "failed" or state == "partial" then
				task.delay(state ~= "complete" and 8 or 0.5, function()
					if ticket == request and row.Parent then
						status.Visible = false
						nameLbl.Size = UDim2.new(1, -70, 1, 0)
					end
				end)
			end
		end
	end

	local lastClick = 0
	row.MouseButton1Click:Connect(function()
		if onRename and os.clock() - lastClick < 0.4 then
			lastClick = 0
			nameLbl.Visible = false
			local box = mk("TextBox", {
				Size = UDim2.new(1, -70, 1, -6),
				Position = UDim2.fromOffset(10, 3),
				BackgroundColor3 = fieldBg,
				TextColor3 = txt,
				FontFace = font,
				TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = nameLbl.Text,
				ClearTextOnFocus = false,
			}, row)
			corner(box, 4)
			task.defer(function()
				box:CaptureFocus()
			end)
			box.FocusLost:Connect(function()
				local newName = box.Text
				box:Destroy()
				nameLbl.Visible = true
				onRename(newName)
			end)
			return
		end

		lastClick = os.clock()
		if onApply then
			request += 1
			onApply(progressCallback(request))
		end
	end)

	if onSaveSlot then
		local sBtn = mk("ImageButton", {
			Size = UDim2.fromOffset(15, 15),
			Position = UDim2.new(1, -24, 0, 4),
			BackgroundTransparency = 1,
			Image = iconSave,
			ImageColor3 = txtDim,
		}, row)
		sBtn:SetAttribute("ThemeImg", "Txt")
		sBtn:SetAttribute("ThemeShade", -0.35)
		attachTip(sBtn, "Save the current theme into this slot")
		sBtn.MouseButton1Click:Connect(onSaveSlot)
	end
end

rebuildPresets = function()
	if not presetsFrame then
		return
	end

	for _, c in ipairs(presetsFrame:GetChildren()) do
		if c:IsA("TextButton") or c:IsA("TextLabel") or c.Name == "CommunityDivider" then
			c:Destroy()
		end
	end

	local order = 0

	local function header(text)
		order += 1
		tagText(
			mk("TextLabel", {
				Size = UDim2.new(1, -6, 0, 16),
				BackgroundTransparency = 1,
				TextColor3 = txtDim,
				FontFace = font,
				TextSize = 9,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = text,
				LayoutOrder = order,
			}, presetsFrame),
			-0.3
		)
	end

	header("Eclipse Presets")
	for _, p in ipairs(themeConfig.builtinPresets) do
		order += 1
		presetRow(order, p.name, true, p.desc .. " . Click to apply", function(progress)
			theme.load(p.data, p.name, progress)
			customize._rebuildCards()
		end, nil, nil)
	end

	header("Community Presets")
	for _, p in themeConfig.communityPresets do
		order += 1
		presetRow(order, p.name, true, p.desc, function(progress)
			theme.load(p.data, p.name, progress)
			customize._rebuildCards()
		end, nil, nil)
	end

	header("Your Presets")
	for i, slot in ipairs(userPresets) do
		order += 1
		local tip = slot.data and "Click to apply . Double-click to rename"
			or "Empty . Press the save icon to store the current theme"
		presetRow(order, slot.name, slot.data ~= nil, tip, function(progress)
			if slot.data then
				theme.load(slot.data, slot.name, progress)
				customize._rebuildCards()
			end
		end, function()
			slot.data = theme.encode()
			saveUserPresets()
			rebuildPresets()
		end, function(newName)
			newName = newName:gsub("^%s+", ""):gsub("%s+$", "")
			if newName ~= "" then
				slot.name = newName:sub(1, 24)
			end

			saveUserPresets()
			rebuildPresets()
		end)
	end
end

local function setPresetsView(visible)
	showingPresets = visible
	if presetsFrame then
		presetsFrame.Visible = visible
	end

	if scroll then
		scroll.Visible = not visible
	end

	if visible then
		closePicker()
		rebuildPresets()
	end
end

local function tryClipboard(text)
	local ok = pcall(function()
		game:GetService("StudioService"):CopyToClipboard(text)
	end)
	if not ok then
		ok = pcall(function()
			setclipboard(text)
		end)
	end

	return ok
end

local function showModal(titleText, prefill, buttonText, onConfirm)
	if modal then
		modal:Destroy()
	end

	modal = mk("Frame", {
		Size = UDim2.new(1, -20, 0, 96),
		Position = UDim2.new(0, 10, 0.5, -48),
		BackgroundColor3 = Color3.fromRGB(14, 6, 24),
		ZIndex = 40,
	}, window)
	corner(modal, 8)
	local modalStroke =
		mk("UIStroke", { Color = Color3.fromRGB(140, 80, 210), Transparency = 0.3 }, modal)
	modal:SetAttribute("ThemeBg", "Bg")
	modalStroke:SetAttribute("ThemeStrk", "Strk")
	tagText(mk("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 6),
		BackgroundTransparency = 1,
		TextColor3 = txt,
		FontFace = font,
		TextSize = 12,
		Text = titleText,
		ZIndex = 41,
	}, modal))
	local box = tagField(mk("TextBox", {
		Size = UDim2.new(1, -20, 0, 24),
		Position = UDim2.fromOffset(10, 28),
		BackgroundColor3 = fieldBg,
		TextColor3 = txt,
		FontFace = font,
		TextSize = 9,
		Text = prefill or "",
		PlaceholderText = "Paste preset JSON here",
		ClearTextOnFocus = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 41,
	}, modal))
	corner(box, 5)
	local confirm = mk("TextButton", {
		Size = UDim2.new(0.5, -15, 0, 22),
		Position = UDim2.fromOffset(10, 62),
		BackgroundColor3 = Color3.fromRGB(100, 0, 151),
		TextColor3 = txt,
		FontFace = font,
		TextSize = 10,
		Text = buttonText,
		ZIndex = 41,
	}, modal)
	corner(confirm, 5)
	confirm:SetAttribute("ThemeBg", "MenuSel")
	local cancel = mk("TextButton", {
		Size = UDim2.new(0.5, -15, 0, 22),
		Position = UDim2.new(0.5, 5, 0, 62),
		BackgroundColor3 = fieldBg,
		TextColor3 = txtDim,
		FontFace = font,
		TextSize = 10,
		Text = "CLOSE",
		ZIndex = 41,
	}, modal)
	corner(cancel, 5)
	cancel:SetAttribute("ThemeBg", "Pnl")
	cancel:SetAttribute("ThemeShade", -0.45)
	cancel:SetAttribute("ThemeTxt", "Txt")

	if prefill and prefill ~= "" then
		box:SetAttribute("PreserveTextOnFocus", true)
		task.defer(function()
			box:CaptureFocus()
			box.CursorPosition = #box.Text + 1
			box.SelectionStart = 1
		end)
	end

	confirm.MouseButton1Click:Connect(function()
		if onConfirm then
			onConfirm(box)
		end
	end)
	cancel.MouseButton1Click:Connect(function()
		modal:Destroy()
		modal = nil
	end)
end

local function buildWindow()
	window = mk("Frame", {
		Name = "EclipseCustomize",
		Size = UDim2.fromOffset(480, 330),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 25,
	}, screenGui)
	corner(window, 5)

	local surface = mk("Frame", {
		Name = "WindowSurface",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(18, 10, 26),
		BorderSizePixel = 0,
		ZIndex = -1,
	}, window)
	corner(surface, 5)
	surface:SetAttribute("ThemeBg", "Bg")

	local backdrop = mk("Frame", {
		Name = "Backdrop",
		Position = UDim2.fromOffset(4, chrome.HEIGHT),
		Size = UDim2.new(1, -8, 1, -chrome.HEIGHT - 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 0,
	}, window)
	corner(backdrop, 5)
	backdrop:SetAttribute("ThemeBgImage", 1)
	local wg = mk("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(52, 28, 76)),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(24, 9, 38)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 4, 19)),
		}),
	}, backdrop)
	wg:SetAttribute("ThemeGrad", "Bg")
	local bdStroke = mk(
		"UIStroke",
		{ Color = Color3.fromRGB(120, 70, 180), Transparency = 0.35, Thickness = 1 },
		surface
	)
	bdStroke:SetAttribute("ThemeStrk", "Strk")

	local bar, title, drag = chrome.header(window, "CUSTOMIZATION", 1, 282)
	bar.Name = "Bar"

	local chipGradient = function(chip)
		theme.separateButtonText(chip)
	end

	presetsChip = mk("TextButton", {
		Size = UDim2.fromOffset(66, 18),
		Position = UDim2.new(1, -268, 0, 5),
		BackgroundColor3 = chipBg,
		TextColor3 = txt,
		FontFace = font,
		TextSize = 9,
		Text = "PRESETS",
	}, bar)
	presetsChip:SetAttribute("ThemeBg", "MenuSel")
	presetsChip:SetAttribute("ThemeTxt", "TopT")
	corner(presetsChip, 2)
	chipGradient(presetsChip)
	attachTip(presetsChip, "Built-in themes + your own saved presets")

	modeChip = mk("TextButton", {
		Size = UDim2.fromOffset(78, 18),
		Position = UDim2.new(1, -196, 0, 5),
		BackgroundColor3 = chipBg,
		TextColor3 = txt,
		FontFace = font,
		TextSize = 9,
		Text = "ADVANCED",
	}, bar)
	modeChip:SetAttribute("ThemeBg", "MenuSel")
	modeChip:SetAttribute("ThemeTxt", "TopT")
	corner(modeChip, 2)
	chipGradient(modeChip)
	attachTip(modeChip, function()
		return theme.getMode() == "A" and "Switch to simple for easier customization"
			or "Switch to advanced for more options"
	end)

	local function iconBtn(image, xOff)
		local b = mk("ImageButton", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.new(1, xOff, 0, 5),
			BackgroundTransparency = 1,
			Image = image,
			ImageColor3 = Color3.new(1, 1, 1),
		}, bar)
		b:SetAttribute("ThemeImg", "TopT")
		return b
	end

	local resetBtn = iconBtn(iconReset, -110)
	local saveBtn = iconBtn(iconSave, -85)
	local loadBtn = iconBtn(iconLoad, -60)

	local closeBtn = chrome.close(bar, nil, 4)

	attachTip(resetBtn, "Reset every color to default")
	attachTip(saveBtn, "Copy this theme to your clipboard")
	attachTip(loadBtn, "Load a theme from JSON")
	attachTip(closeBtn, "Close")

	resetHint = mk("TextLabel", {
		Size = UDim2.fromOffset(150, 14),
		Position = UDim2.new(1, -196, 0, 28),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(255, 170, 170),
		FontFace = font,
		TextSize = 9,
		Text = "Press again to reset",
		Visible = false,
		ZIndex = 26,
	}, window)

	scroll = mk("ScrollingFrame", {
		Name = "Cards",
		Size = UDim2.new(1, -16, 1, -40),
		Position = UDim2.fromOffset(8, 34),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Color3.fromRGB(150, 100, 220),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	}, window)
	scroll:SetAttribute("ThemeScr", "Scr")
	grid = mk("UIGridLayout", {
		CellSize = UDim2.new(0.5, -8, 0, 48),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroll)
	mk("UIPadding", {
		PaddingLeft = UDim.new(0, 2),
		PaddingTop = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 6),
	}, scroll)

	presetsFrame = mk("ScrollingFrame", {
		Name = "Presets",
		Size = UDim2.new(1, -16, 1, -40),
		Position = UDim2.fromOffset(8, 34),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Color3.fromRGB(150, 100, 220),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Visible = false,
	}, window)
	presetsFrame:SetAttribute("ThemeScr", "Scr")
	mk(
		"UIListLayout",
		{ Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder },
		presetsFrame
	)
	mk("UIPadding", {
		PaddingLeft = UDim.new(0, 2),
		PaddingTop = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 6),
	}, presetsFrame)

	presetsChip.MouseButton1Click:Connect(function()
		setPresetsView(not showingPresets)
	end)

	chrome.bindDrag(window, drag, {
		changed = function()
			if picker.Visible then
				positionPicker()
			end
		end,
	})

	modeChip.MouseButton1Click:Connect(function()
		theme.setMode(theme.getMode() == "S" and "A" or "S")
		closePicker()
		rebuildCards()
	end)

	resetBtn.MouseButton1Click:Connect(function()
		if os.clock() - lastResetPress < 2.5 then
			lastResetPress = 0
			resetHint.Visible = false
			theme.resetAll()
			closePicker()
			refreshCards()
		else
			lastResetPress = os.clock()
			resetHint.Visible = true
			task.delay(2.5, function()
				if os.clock() - lastResetPress >= 2.4 then
					resetHint.Visible = false
				end
			end)
		end
	end)

	saveBtn.MouseButton1Click:Connect(function()
		local encoded = theme.encode()
		if tryClipboard(encoded) then
			showModal("Preset copied to clipboard!", encoded, "COPY AGAIN", function(box)
				tryClipboard(box.Text)
			end)
		else
			showModal("Save Preset - press CTRL+C", encoded, "SELECT ALL", function(box)
				box:CaptureFocus()
				box.CursorPosition = #box.Text + 1
				box.SelectionStart = 1
			end)
		end
	end)

	loadBtn.MouseButton1Click:Connect(function()
		showModal("Load Preset", "", "LOAD", function(box)
			if theme.load(box.Text) then
				modal:Destroy()
				modal = nil
				closePicker()
				rebuildCards()
			else
				box.Text = ""
				box.PlaceholderText = "Invalid preset JSON, try again"
			end
		end)
	end)

	closeBtn.MouseButton1Click:Connect(function()
		customize.close()
	end)

	buildPicker()
end

function customize.open()
	if not window or window.Visible and not closing then
		return
	end

	closing = false
	setPresetsView(false)
	rebuildCards()
	theme.applyTree(window)
	windowFx.pop(window)
	window.Visible = true
end

function customize.close(immediate)
	if layoutTool then
		layoutTool:close()
	end

	if not window or not window.Visible or (closing and not immediate) then
		return
	end

	closing = true
	closePicker()
	if modal then
		modal:Destroy()
		modal = nil
	end

	if immediate then
		windowFx.clear(window)
		window.Visible = false
		closing = false
		if picker then
			windowFx.clear(picker)
			picker.Visible = false
		end
		return
	end

	windowFx.shrink(window, function()
		window.Visible = false
		closing = false
	end)
end

function customize.init(refs)
	if initialized then
		return
	end

	screenGui = refs and refs.ScreenGui
	if not screenGui then
		return
	end

	windowRefs = refs
	getSetting = refs.GetSetting
	setSetting = refs.SetSetting
	initialized = true
	loadUserPresets()
	buildWindow()
	local alert = require("ui").AlertFrame
	local function dismissForConfirmation()
		if screenGui:GetAttribute("EclipseConfirmationOpen") or (alert and alert.Visible) then
			customize.close(true)
		end
	end
	screenGui:GetAttributeChangedSignal("EclipseConfirmationOpen"):Connect(dismissForConfirmation)
	if alert then
		alert:GetPropertyChangedSignal("Visible"):Connect(dismissForConfirmation)
	end
end

return customize
]]></ProtectedString>
						<string name="ScriptGuid">{EF9D8854-1234-4F87-9AFD-9056D2A75D48}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">customize</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX96B0032070154454A6D41AAB26429AAD">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local players = game:GetService("Players")
local selection = game:GetService("Selection")
local changes = game:GetService("ChangeHistoryService")
local tool = require("tool")
local theme = require("theme")
local history = require("history")
local appearance = require("appearance")
local rigPose = require("rigPose")
local layout = require("layout")
local catalog = {}

local function clean(model)
	for _, item in model:GetDescendants() do
		if item:IsA("LuaSourceContainer") then
			item:Destroy()
		elseif item:IsA("BasePart") then
			item.CanCollide = false
			item.Massless = true
		end
	end
end

local maxAssets = 10
local clothing = { Shirt = "SHIRT", Pants = "PANTS", ShirtGraphic = "T-SHIRT" }

function catalog.outfitId(value)
	local text = tostring(value or ""):match("^%s*(.-)%s*$")
	local id = tonumber(text:match("^%d+$"))
		or tonumber(text:match("[Oo]utfits?/(%d+)"))
		or tonumber(text:match("[?&][Oo]utfit[Ii]d=(%d+)"))
		or tonumber(text:match("[?&]id=(%d+)"))
	assert(id and id > 0 and id < 2 ^ 53, "Enter a valid outfit ID or link.")
	return id
end

function catalog.outfit(id, kind)
	local description = players:GetHumanoidDescriptionFromOutfitIdAsync(id)
	local ok, model =
		pcall(players.CreateHumanoidModelFromDescriptionAsync, players, description, kind)
	description:Destroy()
	if not ok then
		error(model, 0)
	end

	clean(model)
	return model
end

function catalog.kind(item)
	if item:IsA("Accoutrement") then
		return "ACCESSORY"
	elseif clothing[item.ClassName] then
		return clothing[item.ClassName]
	elseif item.ClassName == "Decal" then
		return item:FindFirstChildOfClass("WrapTextureTransfer") and "MAKEUP" or "CLASSIC FACE"
	end

	return nil
end

function catalog.asset()
	error("Loading accessories by ID is temporarily disabled.", 0)
end

function catalog.displaced(rig, item)
	local kind = catalog.kind(item)
	local found = {}
	if kind == "CLASSIC FACE" or kind == "MAKEUP" then
		local head = rig:FindFirstChild("Head")
		if head then
			for _, d in head:GetChildren() do
				if
					d ~= item
					and d.ClassName == "Decal"
					and catalog.kind(d) == kind
					and (
						if kind == "MAKEUP"
							then d.Name == item.Name
							else d.Face == Enum.NormalId.Front
					)
				then
					table.insert(found, d)
				end
			end
		end
	elseif clothing[item.ClassName] then
		for _, c in rig:GetChildren() do
			if c ~= item and c.ClassName == item.ClassName then
				table.insert(found, c)
			end
		end
	end

	return found
end

function catalog.attach(rig, asset)
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	assert(humanoid, "Select one rig")
	if asset:IsA("Accoutrement") then
		local handle = asset:FindFirstChild("Handle")
		assert(handle and handle:IsA("BasePart"), "This accessory has no handle")
		for _, part in asset:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = false
			end
		end

		humanoid:AddAccessory(asset)
		if not handle:FindFirstChild("AccessoryWeld") then
			local mount = handle:FindFirstChildOfClass("Attachment")
			local socket
			if mount then
				for _, item in rig:GetDescendants() do
					if
						item:IsA("Attachment")
						and item.Name == mount.Name
						and item.Parent:IsA("BasePart")
						and not item:FindFirstAncestorWhichIsA("Accessory")
					then
						socket = item
						break
					end
				end

				assert(socket, "This accessory does not fit the selected rig")
			end

			local body = socket and socket.Parent or rig:FindFirstChild("Head")
			assert(body and body:IsA("BasePart"), "This rig has no accessory mount")
			local weld = Instance.new("Weld")
			weld.Name = "AccessoryWeld"
			weld.Part0 = handle
			weld.Part1 = body
			weld.C0 = mount and mount.CFrame or asset.AttachmentPoint
			weld.C1 = socket and socket.CFrame or CFrame.new(0, 0.5, 0)
			handle.CFrame = body.CFrame * weld.C1 * weld.C0:Inverse()
			weld.Parent = handle
		end
	elseif clothing[asset.ClassName] then
		asset.Name = asset.ClassName
		asset.Parent = rig
	else
		local head = rig:FindFirstChild("Head")
		assert(head and head:IsA("BasePart"), "This rig has no head")
		if catalog.kind(asset) == "CLASSIC FACE" then
			asset.Name = "face"
			asset.Face = Enum.NormalId.Front
		end

		asset.Parent = head
	end
end

function catalog.init(options)
	local gui, frame, state = options.Gui, options.Frame, options.State
	local connections = {}
	local destroyed, busy, generation = false, false, 0
	local assets, preview, target, popup
	local tab = tool.make("Frame", frame, "AccessoriesTab", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 78),
		Size = UDim2.fromOffset(464, 204),
		Visible = false,
	})
	local viewport = tool.make("ViewportFrame", tab, "Preview", {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(128, 166),
		BorderSizePixel = 0,
		Ambient = Color3.fromRGB(200, 200, 200),
		LightColor = Color3.new(1, 1, 1),
	})
	viewport:SetAttribute("ThemeBg", "Pnl")
	tool.make("UICorner", viewport, "Corner", { CornerRadius = UDim.new(0, 3) })
	local world = Instance.new("WorldModel", viewport)
	local rigLabel = tool.label(
		tab,
		"RigName",
		"Select a rig",
		UDim2.fromOffset(0, 174),
		UDim2.fromOffset(128, 30)
	)
	rigLabel.TextXAlignment = Enum.TextXAlignment.Center
	rigLabel.TextTruncate = Enum.TextTruncate.AtEnd
	tool.label(
		tab,
		"Header",
		"ACCESSORY / FACE / CLOTHING / MAKEUP",
		UDim2.fromOffset(144, 0),
		UDim2.fromOffset(320, 18)
	)
	local input =
		tool.field(tab, "AssetId", "", UDim2.fromOffset(144, 26), UDim2.fromOffset(230, 28))
	input.PlaceholderText = "Asset IDs / links, comma separated"
	local loadButton, loadLabel =
		tool.button(tab, "Load", "LOAD", UDim2.fromOffset(382, 26), UDim2.fromOffset(82, 28))
	local name =
		tool.label(tab, "AssetName", "", UDim2.fromOffset(144, 64), UDim2.fromOffset(320, 40))
	local kind =
		tool.label(tab, "AssetType", "", UDim2.fromOffset(144, 108), UDim2.fromOffset(320, 20))
	local status =
		tool.label(tab, "Status", "", UDim2.fromOffset(144, 134), UDim2.fromOffset(320, 34))
	name.TextWrapped = true
	name.TextTruncate = Enum.TextTruncate.AtEnd
	status.TextWrapped = true
	local insert =
		tool.button(tab, "Insert", "INSERT", UDim2.fromOffset(144, 174), UDim2.fromOffset(320, 30))

	local function connect(signal, callback)
		table.insert(connections, signal:Connect(callback))
	end

	local function resolve()
		return appearance.resolve(selection:Get(), state.Rig and state.Rig._selectedItems)
	end

	local function active()
		return not destroyed and gui.Enabled and tab.Visible
	end

	local function paint()
		loadLabel.Text = busy and "LOADING..." or "LOAD"
		layout.enabled(loadButton, not busy)
		layout.enabled(insert, not busy and target ~= nil and assets ~= nil and preview ~= nil)
	end

	local function release()
		if assets then
			for _, item in assets do
				item:Destroy()
			end

			assets = nil
		end
	end

	local function show()
		world:ClearAllChildren()
		preview = nil
		local rig, multiple = resolve()
		target = not multiple and rig or nil
		rigLabel.Text = target and target.Name or "Select one rig"
		if target then
			local model
			local ok, err = pcall(function()
				model = appearance.clone(target)
				clean(model)
				rigPose.assemble(model)
				model:PivotTo(CFrame.identity)
				model.Parent = world
				if assets then
					for _, item in assets do
						local copy = item:Clone()
						for _, old in catalog.displaced(model, copy) do
							old:Destroy()
						end

						catalog.attach(model, copy)
					end
				end

				for _, part in model:GetDescendants() do
					if part:IsA("BasePart") then
						part.Anchored = true
					end
				end

				options.FitCamera(viewport, model)
			end)
			if ok then
				preview = model
			else
				if model then
					model:Destroy()
				end

				status.Text = "Couldn't preview this item on this rig."
				warn("Eclipse accessory preview: " .. tostring(err))
			end
		end

		paint()
	end

	local controller = {}

	function controller.load()
		if not active() or busy then
			return
		end
		generation += 1
		local request, value = generation, input.Text
		busy = true
		release()
		name.Text, kind.Text, status.Text = "", "", "Loading from Roblox..."
		show()
		task.spawn(function()
			local ok, loaded, failures = pcall(catalog.asset, value, function()
				return not destroyed and request == generation and active()
			end)
			if destroyed or request ~= generation or not active() then
				if ok and loaded then
					for _, item in loaded do
						item:Destroy()
					end
				end

				return
			end

			busy = false
			if ok then
				assets = loaded
				local names = {}
				for _, item in loaded do
					table.insert(names, item.Name)
				end

				name.Text = table.concat(names, ", ")
				kind.Text = #loaded == 1 and catalog.kind(loaded[1]) or #loaded .. " ITEMS"
				status.Text = #failures > 0
						and string.format(
							"Loaded %d of %d. %s",
							#loaded,
							#loaded + #failures,
							failures[1]
						)
					or "Loaded. Select a rig to preview and insert."
				if #failures > 0 then
					warn("Eclipse accessories: " .. table.concat(failures, " | "))
				end

				show()
			else
				status.Text = tostring(loaded):gsub("^.-:%d+: ", ""):match("[^\n]+")
				paint()
			end
		end)
	end

	function controller.insert()
		if not active() or busy or not assets or not preview or resolve() ~= target then
			return
		end

		local rig = target
		local items, names = {}, {}
		for i, source in assets do
			items[i] = source:Clone()
			names[i] = source.Name
		end

		local title = table.concat(names, ", ")

		local inFile = false
		for _, r in state.getAllRigs() do
			if r == rig then
				inFile = true
				break
			end
		end

		local recording
		if not inFile then
			recording = changes:TryBeginRecording("EclipseAccessory", "Insert accessory")
			if not recording then
				for _, item in items do
					item:Destroy()
				end

				return
			end
		end

		local displaced = {}
		local function undo()
			for i = #items, 1, -1 do
				items[i].Parent = nil
				for _, entry in displaced[i] or {} do
					entry[1].Parent = entry[2]
				end
			end

			displaced = {}
			state.currentProjectSaved = false
		end

		local function redo()
			displaced = {}
			for i, item in items do
				local moved = {}
				displaced[i] = moved
				for _, d in catalog.displaced(rig, item) do
					table.insert(moved, { d, d.Parent })
					d.Parent = nil
				end

				catalog.attach(rig, item)
			end

			state.currentProjectSaved = false
		end

		local ok, err = pcall(redo)
		if not ok then
			undo()
			for _, item in items do
				item:Destroy()
			end

			status.Text = (
				#items > 1 and "These items don't fit the selected rig: "
				or "This item doesn't fit the selected rig: "
			)
				.. (tostring(err):gsub("^.-:%d+: ", ""):match("[^\n]+") or "unknown error")
			warn(tostring(err))
		end

		if recording then
			changes:FinishRecording(
				recording,
				ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel
			)
		elseif ok then
			history.record(undo, redo, "Insert " .. title)
		end

		if ok then
			status.Text = "Inserted " .. title
			show()
		end
	end

	function controller.outfits()
		if popup then
			popup:close(true)
		end

		local window =
			tool.new({ ScreenGui = gui }, "EclipseOutfits", "OUTFITS", Vector2.new(422, 288), false)
		popup = window
		local body = window.frame
		local field =
			tool.field(body, "OutfitId", "", UDim2.fromOffset(16, 40), UDim2.fromOffset(390, 28))
		field.PlaceholderText = "Outfit ID / link"
		local thumbnail = tool.make("ImageLabel", body, "Thumbnail", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(16, 78),
			Size = UDim2.fromOffset(120, 120),
			Image = "",
		})
		local notice = tool.label(
			body,
			"Notice",
			"Outfits load by Outfit ID. Paste the ID or link of a saved outfit, pick R6 or R15, then insert. Browsing a user's outfit list isn't available in the plugin.",
			UDim2.fromOffset(146, 78),
			UDim2.fromOffset(260, 80)
		)
		notice.TextYAlignment = Enum.TextYAlignment.Top
		local message =
			tool.label(body, "Status", "", UDim2.fromOffset(146, 162), UDim2.fromOffset(260, 36))
		message.TextYAlignment = Enum.TextYAlignment.Top
		local r6 =
			tool.button(body, "R6", "R6", UDim2.fromOffset(16, 208), UDim2.fromOffset(62, 28))
		local r15 =
			tool.button(body, "R15", "R15", UDim2.fromOffset(86, 208), UDim2.fromOffset(62, 28))
		local add, addText = tool.button(
			body,
			"Insert",
			"INSERT OUTFIT",
			UDim2.fromOffset(16, 248),
			UDim2.fromOffset(390, 28)
		)
		local mode, outfitId, adding = "R15", nil, false

		local function refresh()
			options.SetButtonSelected(r6, mode == "R6")
			options.SetButtonSelected(r15, mode == "R15")
			layout.enabled(add, outfitId ~= nil and not adding)
			layout.enabled(r6, not adding)
			layout.enabled(r15, not adding)
			addText.Text = adding and "LOADING..." or "INSERT OUTFIT"
		end

		field:GetPropertyChangedSignal("Text"):Connect(function()
			local ok, id = pcall(catalog.outfitId, field.Text)
			outfitId = ok and id or nil
			thumbnail.Image = outfitId
					and "rbxthumb://type=Outfit&id=" .. string.format("%.0f", outfitId) .. "&w=150&h=150"
				or ""
			message.Text = if outfitId or not field.Text:match("%S")
				then ""
				else "Enter a valid outfit ID or link."
			refresh()
		end)
		r6.Activated:Connect(function()
			if not adding then
				mode = "R6"
				refresh()
			end
		end)
		r15.Activated:Connect(function()
			if not adding then
				mode = "R15"
				refresh()
			end
		end)
		add.Activated:Connect(function()
			if adding or not outfitId then
				return
			end

			adding = true
			message.Text = ""
			refresh()
			local id, kind = outfitId, Enum.HumanoidRigType[mode]
			task.spawn(function()
				local ok, model = pcall(options.BuildOutfit or catalog.outfit, id, kind)
				if window.closed or destroyed then
					if ok then
						model:Destroy()
					end

					return
				end

				adding = false
				if ok then
					model.Name = "Outfit " .. string.format("%.0f", id)
					options.PlaceModel(model, "Eclipse Insert Outfit")
					window:close()
				else
					local text = tostring(model)
					message.Text = if text:find("429", 1, true)
							or text:lower():find("rate limit", 1, true)
							or text:lower():find("too many requests", 1, true)
						then "Roblox is rate limiting outfit requests. Try again shortly."
						else "Couldn't load this outfit. Check the ID; the outfit must exist and be public."
					warn(text)
					refresh()
				end
			end)
		end)
		refresh()
		theme.applyTree(body)
	end

	function controller.destroy()
		if destroyed then
			return
		end

		destroyed = true
		generation += 1
		for _, connection in connections do
			connection:Disconnect()
		end

		if popup then
			popup:close(true)
		end

		release()
		world:ClearAllChildren()
	end

	connect(loadButton.Activated, controller.load)
	connect(input.FocusLost, function(enter)
		if enter then
			controller.load()
		end
	end)
	connect(input:GetPropertyChangedSignal("Text"), function()
		generation += 1
		busy = false
		release()
		name.Text = ""
		kind.Text = ""
		status.Text = ""
		paint()
	end)
	connect(insert.Activated, controller.insert)
	connect(frame.RigsTab.AvatarPanel.Outfits.Activated, controller.outfits)
	connect(selection.SelectionChanged, function()
		if active() then
			if not busy then
				status.Text = ""
			end

			show()
		end
	end)
	local elapsed = 0
	connect(game:GetService("RunService").Heartbeat, function(dt)
		if not active() then
			return
		end

		elapsed += dt
		if elapsed < 0.2 then
			return
		end

		elapsed = 0
		if resolve() ~= target then
			if not busy then
				status.Text = ""
			end

			show()
		end
	end)

	local function visibility()
		generation += 1
		busy = false
		if active() then
			show()
		end

		if not gui.Enabled and popup then
			popup:close(true)
		end
	end

	connect(tab:GetPropertyChangedSignal("Visible"), visibility)
	connect(gui:GetPropertyChangedSignal("Enabled"), visibility)
	connect(options.Owner.Destroying, controller.destroy)
	connect(tab.Destroying, controller.destroy)
	theme.applyTree(tab)
	paint()
	return controller
end

return catalog
]]></ProtectedString>
						<string name="ScriptGuid">{A0C73409-0918-423C-858C-A5AE9AD883FA}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">catalog</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX381B78E5D6FE456F932E8D6DBD35A6A2">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local weld = require("transaction")
local coreGui = game:GetService("CoreGui")
local selection = game:GetService("Selection")
local tweenService = game:GetService("TweenService")
local changeHistoryService = game:GetService("ChangeHistoryService")

local ui = require("ui")
local state = require("state")
local avatar = require("avatar")
local catalog = require("catalog")
local rigPose = require("rigPose")
local masterControl = require("masterControl")
local layout = require("layout")
local appearance = require("appearance")
local boneMotor = require("boneMotor")
local history = require("history")
local drag = require("drag")
local windowFx = require("windowFx")

local btnValue = Color3.fromRGB(51, 0, 77)
local btnSel = Color3.fromRGB(100, 0, 151)

local theme = require("theme")
theme.onChanged(function()
	btnValue = theme.isGradient("TopBtn") and Color3.new(1, 1, 1)
		or theme.get("TopBtn", Color3.fromRGB(51, 0, 77))
	btnSel = theme.get("MenuSel", Color3.fromRGB(100, 0, 151))
end)

local helperMenu = {}

local initialized = false
local selectionConnection

function helperMenu.destroy()
	if selectionConnection then
		selectionConnection:Disconnect()
		selectionConnection = nil
	end

	initialized = false
end

local miscGui = nil
local frame = nil
local rigStore = nil

local anchorPart = nil
local targetInstances = {}
local pendingSelection = nil
local sweepTarget = nil
local animatable = true
local emptyTweens = {}

local function setEmptyVisible(vp, visible)
	local empty = vp and vp:FindFirstChild("EmptyState")
	if not empty then
		return
	end

	empty.Visible = visible
	local swirl = empty:FindFirstChild("Swirl")
	if not swirl then
		return
	end

	if visible then
		if not emptyTweens[swirl] then
			emptyTweens[swirl] = {
				tweenService:Create(
					swirl,
					TweenInfo.new(7, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1),
					{ Rotation = 360 }
				),
				tweenService:Create(
					swirl,
					TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
					{ ImageTransparency = 0.88 }
				),
			}
		end

		for _, t in ipairs(emptyTweens[swirl]) do
			t:Play()
		end
	else
		if emptyTweens[swirl] then
			for _, t in ipairs(emptyTweens[swirl]) do
				t:Pause()
			end
		end
	end
end

local function fitCamera(vp, inst, zoom)
	local cf, size
	if inst:IsA("Model") then
		cf, size = inst:GetBoundingBox()
	else
		cf, size = inst.CFrame, inst.Size
	end

	local viewportSize = vp.AbsoluteSize
	local aspect = viewportSize.Y > 0 and viewportSize.X / viewportSize.Y or 1
	local vertical = math.tan(math.rad(35) * 0.5)
	local dist = math.max(size.Y / (2 * vertical), size.X / (2 * vertical * math.max(0.1, aspect)))
			* 1.15
		+ size.Z * 0.6
	local camPos = cf.Position + Vector3.new(0.45, 0.28, -1).Unit * dist
	local cam = vp:FindFirstChildOfClass("Camera")
	if not cam then
		cam = Instance.new("Camera")
		cam.Parent = vp
	end

	cam.FieldOfView = 35
	cam.CFrame = CFrame.lookAt(camPos, cf.Position)
	vp.CurrentCamera = cam
end

local function setPreview(vp, inst)
	local wm = vp and vp:FindFirstChildOfClass("WorldModel")
	if not wm then
		return
	end

	wm:ClearAllChildren()

	if inst then
		local ok, clone = pcall(function()
			return inst:Clone()
		end)
		if ok and clone then
			clone.Parent = wm
			pcall(function()
				fitCamera(vp, clone)
			end)
			setEmptyVisible(vp, false)
			return
		end
	end

	setEmptyVisible(vp, true)
end

local function sanitizeCharacter(model)
	if not model then
		return
	end

	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") then
			d:Destroy()
		elseif d:IsA("Humanoid") then
			d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
	end
end

local function countJoints(container)
	local n = 0
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			n += 1
		end
	end

	return n
end

local function setToggleVisual(row, on)
	local fill = row and row:FindFirstChild("Toggle") and row.Toggle:FindFirstChild("Fill")
	if fill then
		fill.Visible = on
	end
end

local function setButtonSelected(btn, selected)
	if not btn then
		return
	end

	btn.BackgroundColor3 = selected and btnSel or btnValue
	btn:SetAttribute("ThemeBg", selected and "MenuSel" or "TopBtn")
	theme.applyInstance(btn)
	local s = btn:FindFirstChildOfClass("UIStroke")
	if s then
		s.Transparency = selected and 0.3 or 0.75
	end
end

local function placeModel(model, waypointName)
	local cam = workspace.CurrentCamera
	local pos = Vector3.new(0, 8, 0)
	local camPos = Vector3.new(0, 8, -20)
	if cam then
		camPos = cam.CFrame.Position
		pos = camPos + cam.CFrame.LookVector * 14
	end

	local rigRoot = masterControl.root(model)
	if rigRoot and (not model.PrimaryPart or rigRoot.Name == "HumanoidRootPart") then
		model.PrimaryPart = rigRoot
	end

	rigPose.assemble(model)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Locked = false
		end
	end

	model.Parent = workspace

	local params = RaycastParams.new()
	params.FilterDescendantsInstances = { model }
	params.FilterType = Enum.RaycastFilterType.Exclude
	local hit =
		workspace:Raycast(Vector3.new(pos.X, pos.Y + 20, pos.Z), Vector3.new(0, -120, 0), params)

	local look = Vector3.new(camPos.X, pos.Y, camPos.Z) - pos
	local yaw = 0
	if look.Magnitude > 0.001 then
		yaw = math.atan2(-look.X, -look.Z)
	end

	local snappedYaw = math.rad(math.round(math.deg(yaw) / 90) * 90)
	model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, snappedYaw, 0))

	if hit then
		local bboxCf, size = model:GetBoundingBox()
		local deltaY = (hit.Position.Y + size.Y / 2) - bboxCf.Position.Y
		model:PivotTo(model:GetPivot() + Vector3.new(0, deltaY, 0))
	end

	sanitizeCharacter(model)

	if
		rigRoot
		and rigRoot:IsDescendantOf(model)
		and (rigRoot.Name == "HumanoidRootPart" or #require("rigTraversal").joints(rigRoot) > 0)
	then
		rigRoot.Anchored = true
	end

	selection:Set({ model })
	changeHistoryService:SetWaypoint(waypointName)
end

function helperMenu.captureSelection(selected)
	pendingSelection = table.clone(selected or selection:Get())
end

function helperMenu.init()
	if initialized then
		return
	end

	initialized = true
	state.HelperMenu = helperMenu
	helperMenu.captureSelection()

	miscGui = ui.MiscGUI
	local storage = ui.EclipseGUI and ui.EclipseGUI:FindFirstChild("Storage")
	frame = windowFx.solidify(storage and storage:FindFirstChild("HelperFrame"))
	rigStore = storage and storage:FindFirstChild("HelperRigs")
	if not miscGui or not frame then
		return
	end

	layout.apply(frame)
	frame.Parent = miscGui
	frame.Visible = true
	theme.addRoot(miscGui)

	if miscGui.Enabled then
		windowFx.pop(frame)
	end

	require("poseReset").attach(frame, selection, state, miscGui)
	frame.ResetPose.Activated:Connect(function()
		local rig, multiple =
			rigPose.resolve(selection:Get(), state.Rig and state.Rig._selectedItems)
		if not rig or multiple then
			frame.ResetStatus.Text = "Select one rig to reset."
			return
		end

		if state.Timeline then
			state.Timeline:GetState().Playing = false
		end

		local playing = state.currentAnimations[rig]
		if playing then
			playing:close()
		end

		local recording
		local editing = ui.isAnimatorActive()
		if not editing then
			pcall(function()
				recording =
					changeHistoryService:TryBeginRecording("EclipseResetPose", "Reset rig pose")
			end)
			if not recording then
				changeHistoryService:SetWaypoint("Before Eclipse Reset Pose")
			end
		end

		local before = rigPose.capture(rig)
		local defaults = state.Timeline and state.Timeline:GetState().DefaultPose
		local ok, err = pcall(rigPose.reset, rig, defaults, boneMotor)
		if not ok then
			rigPose.restore(rig, before)
			if recording then
				changeHistoryService:FinishRecording(
					recording,
					Enum.FinishRecordingOperation.Cancel
				)
			end

			frame.ResetStatus.Text = "Could not reset this rig."
			warn(err)
			return
		end

		local after = rigPose.capture(rig)
		if editing then
			history.record(function()
				if rig.Parent then
					rigPose.restore(rig, before)
				end
			end, function()
				if rig.Parent then
					rigPose.restore(rig, after)
				end
			end, "Reset rig pose")
		elseif recording then
			changeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
		else
			changeHistoryService:SetWaypoint("Eclipse Reset Pose")
		end

		frame.ResetStatus.Text = rig.Name .. " reset."
	end)
	frame.Destroying:Once(helperMenu.destroy)
	ui.EclipseGUI.Destroying:Once(helperMenu.destroy)
	local bar = frame.Bar
	local weldTab = frame.WeldTab
	local rigsTab = frame.RigsTab
	local anchorCard = weldTab.AnchorCard
	local targetCard = weldTab.TargetCard
	local binder = weldTab.BinderPanel
	local sweeper = weldTab.SweeperPanel
	local blankPanel = rigsTab.BlankRigsPanel

	drag.makeDraggable({ bar, bar.Title }, frame, nil, {
		dragThreshold = 5,
		suppressClickAfterDrag = true,
	})

	bar.CloseButton.MouseButton1Click:Connect(function()
		windowFx.shrink(frame, function()
			miscGui.Enabled = false
		end)
	end)

	local function selectTab(name)
		layout.selectTab(frame, name)
		if frame:FindFirstChild("AccessoriesTab") then
			frame.AccessoriesTab.Visible = name == "ACCESSORIES"
		end

		frame.ResetPose.Visible = name ~= "ACCESSORIES"
		frame.ResetStatus.Visible = name ~= "ACCESSORIES"
		setButtonSelected(bar.TabButtons.ACCESSORIESTab, name == "ACCESSORIES")
		weldTab.Visible = (name == "WELD")
		rigsTab.Visible = (name == "RIGS")
		setButtonSelected(bar.TabButtons.WELDTab, name == "WELD")
		setButtonSelected(bar.TabButtons.RIGSTab, name == "RIGS")
	end

	bar.TabButtons.WELDTab.MouseButton1Click:Connect(function()
		selectTab("WELD")
	end)
	bar.TabButtons.RIGSTab.MouseButton1Click:Connect(function()
		selectTab("RIGS")
	end)
	bar.TabButtons.ACCESSORIESTab.Activated:Connect(function()
		selectTab("ACCESSORIES")
	end)
	selectTab("WELD")

	local function refreshWeldSelection()
		if
			not frame.Parent
			or not anchorCard:FindFirstChild("TargetName")
			or not targetCard:FindFirstChild("TargetName")
		then
			return
		end

		local sel = pendingSelection or selection:Get()
		pendingSelection = nil
		anchorPart, targetInstances = weld.selection(sel)
		anchorCard.TargetName.Text = anchorPart and anchorPart.Name or "Select a part first"
		setPreview(anchorCard.Preview, anchorPart)
		if #targetInstances == 1 then
			local target = targetInstances[1]
			targetCard.TargetName.Text = target.Name .. (target:IsA("Model") and " (Model)" or "")
			setPreview(targetCard.Preview, target)
		elseif #targetInstances > 1 then
			targetCard.TargetName.Text = tostring(#targetInstances) .. " targets"
			local group = Instance.new("Model")
			for _, target in targetInstances do
				local ok, clone = pcall(function()
					return target:Clone()
				end)
				if ok and clone then
					clone.Parent = group
				end
			end

			setPreview(targetCard.Preview, group)
			group:Destroy()
		else
			targetCard.TargetName.Text = "Ctrl+select targets"
			setPreview(targetCard.Preview, nil)
		end

		local ready = pcall(weld.plan, anchorPart, targetInstances)
		layout.enabled(binder.BindButton, ready)
		layout.enabled(binder.BindInPlaceButton, ready)
		binder.Hint.Text = ""

		local newSweep = nil
		for _, inst in ipairs(sel) do
			if
				inst:IsA("Model")
				or inst:IsA("Tool")
				or inst:IsA("Folder")
				or inst:IsA("Accessory")
			then
				newSweep = inst
				break
			end
		end

		sweepTarget = newSweep

		if sweepTarget then
			sweeper.TargetName.Text = sweepTarget.Name
			sweeper.JointCount.Text = countJoints(sweepTarget) .. " joints found"
		else
			sweeper.TargetName.Text = "Select a model or folder"
			sweeper.JointCount.Text = "No selection"
		end

		layout.enabled(sweeper.SweepButton, sweepTarget ~= nil and countJoints(sweepTarget) > 0)
	end

	selectionConnection = selection.SelectionChanged:Connect(function()
		if miscGui.Enabled then
			pendingSelection = nil
			refreshWeldSelection()
		end
	end)

	miscGui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if miscGui.Enabled then
			windowFx.pop(frame)
			refreshWeldSelection()
		end
	end)

	local animatableRow = binder.AnimatableRow
	animatableRow.Toggle.MouseButton1Click:Connect(function()
		animatable = not animatable
		setToggleVisual(animatableRow, animatable)
	end)
	setToggleVisual(animatableRow, animatable)

	local function feedback(text)
		binder.Hint.Text = text
	end

	local function bind(inPlace)
		local valid, reason = pcall(weld.plan, anchorPart, targetInstances)
		if not valid then
			feedback(tostring(reason):gsub("^.-:%d+: ", ""))
			return
		end

		if ui.isAnimatorActive() then
			local ok, count = pcall(
				require("partRigging").bindTargets,
				anchorPart,
				targetInstances,
				inPlace,
				animatable
			)
			if not ok then
				feedback(tostring(count):gsub("^.-:%d+: ", ""))
				return
			end

			feedback(
				string.format(
					animatable and "Bound %d target%s for the whole rig. P/W remains available."
						or "Bound %d target%s with fixed joints.",
					count,
					count == 1 and "" or "s"
				)
			)
			return
		end

		local recording
		pcall(function()
			recording = changeHistoryService:TryBeginRecording("EclipseBindTargets", "Bind targets")
		end)
		if not recording then
			changeHistoryService:SetWaypoint("Before Eclipse Bind")
		end

		local ok, count =
			pcall(weld.apply, anchorPart, targetInstances, inPlace, animatable, workspace)
		if recording then
			changeHistoryService:FinishRecording(
				recording,
				ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel
			)
		elseif ok then
			changeHistoryService:SetWaypoint("Eclipse Bind")
		end

		if not ok then
			feedback(tostring(count):gsub("^.-:%d+: ", ""))
			return
		end

		feedback(
			string.format(
				"Bound %d target%s to %s",
				count,
				count == 1 and "" or "s",
				anchorPart.Name
			)
		)
	end

	binder.BindButton.MouseButton1Click:Connect(function()
		bind(false)
	end)
	binder.BindInPlaceButton.MouseButton1Click:Connect(function()
		bind(true)
	end)

	sweeper.SweepButton.MouseButton1Click:Connect(function()
		if not sweepTarget or not sweepTarget.Parent then
			sweeper.JointCount.Text = "select something first!"
			return
		end

		local swept = 0
		for _, d in ipairs(sweepTarget:GetDescendants()) do
			if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
				d:Destroy()
				swept += 1
			end
		end

		changeHistoryService:SetWaypoint("Eclipse Sweep")
		sweeper.JointCount.Text = "Removed " .. swept .. " joints"
		layout.enabled(sweeper.SweepButton, false)
	end)

	catalog.init({
		Gui = miscGui,
		Frame = frame,
		Owner = ui.EclipseGUI,
		State = state,
		FitCamera = fitCamera,
		PlaceModel = placeModel,
		SetButtonSelected = setButtonSelected,
	})
	avatar.init({
		Gui = miscGui,
		Tab = rigsTab,
		Owner = ui.EclipseGUI,
		State = state,
		SetButtonSelected = setButtonSelected,
		SetEmptyVisible = setEmptyVisible,
		FitCamera = fitCamera,
		PlaceModel = placeModel,
		OnTheme = theme.onChanged,
	})

	if rigStore then
		for _, presetButton in ipairs(blankPanel.PresetGrid:GetChildren()) do
			if presetButton:IsA("TextButton") then
				local rigName = presetButton:GetAttribute("RigName")
				local source = rigName and rigStore:FindFirstChild(rigName)
				if source then
					presetButton.MouseButton1Click:Connect(function()
						local clone = source:Clone()
						placeModel(clone, "Eclipse Spawn Rig")
					end)
				end
			end
		end
	end

	blankPanel.PresetGrid.CameraPreset.Activated:Connect(function()
		local camera = require("cameraRig")
		local source
		if ui.isAnimatorActive() then
			local candidates = {}
			for _, rig in state.getAllRigs() do
				if camera.isRig(rig) then
					table.insert(candidates, rig)
				end
			end

			if camera.isRig(state.currentRig) then
				source = state.currentRig
			elseif #candidates == 1 then
				source = candidates[1]
			elseif #candidates > 1 then
				frame.ResetStatus.Text = "Select the camera to copy in the timeline."
				return
			end
		end

		local ok, model = pcall(require("export").createCameraRig, source)
		if not ok then
			frame.ResetStatus.Text = tostring(model):gsub("^.-:%d+: ", "")
			return
		end

		model.Parent = workspace
		require("cameraRig").organize(model, require("project").getProjectExportName())
		selection:Set({ model })
		changeHistoryService:SetWaypoint("Eclipse Insert Camera Rig")
		frame.ResetStatus.Text = source and "Camera + FOV copied to AnimSaves."
			or "Camera rig added. Export camera keys to animate it."
	end)

	setEmptyVisible(anchorCard.Preview, true)
	setEmptyVisible(targetCard.Preview, true)
	refreshWeldSelection()
end

return helperMenu
