					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local shortcuts = require("shortcuts")
local userInputService = require("userInputService")
local nativeInput = game:GetService("UserInputService")
local selectionService = game:GetService("Selection")
local state = require("state")
local ui = require("ui")
local editActions = require("editActions")
local rawState = require("rawState")

local editShortcuts = {}
local connections = {}
local actions = {}
local preservedSelection = {}
local restoring = false
local handled = false
local guardUntil = 0
local chordWasDown = false
local owned = false
local deleteWindow = 0.5
local selectionParents = setmetatable({}, { __mode = "k" })
local keysSelected = false

local function ownsSelection()
	return not state.WorkspaceSelection
		and not state.ViewportBoxSelecting
		and not (state.PresentationHidden and not state.CameraPoseMode)
		and ui.isAnimatorActive()
		and userInputService.isWindowFocused()
		and not userInputService.isCapturingKeys()
		and userInputService:GetFocusedTextBox() == nil
end

local function canSelectKeys()
	return not (state.GraphEditor and state.GraphEditor.hasFocus())
end

local function syncOwnership()
	local active = ownsSelection()
	if active ~= owned then
		owned = active
		handled, guardUntil, chordWasDown = false, 0, false
		preservedSelection = selectionService:Get()
	end

	return active
end

local function isStudioSelectAll()
	return (
		userInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or userInputService:IsKeyDown(Enum.KeyCode.RightControl)
		or userInputService:IsKeyDown(Enum.KeyCode.LeftMeta)
		or userInputService:IsKeyDown(Enum.KeyCode.RightMeta)
		or userInputService:IsKeyDown(Enum.KeyCode.LeftSuper)
		or userInputService:IsKeyDown(Enum.KeyCode.RightSuper)
	)
		and userInputService:IsKeyDown(Enum.KeyCode.A)
		and not (
			userInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or userInputService:IsKeyDown(Enum.KeyCode.RightShift)
			or userInputService:IsKeyDown(Enum.KeyCode.LeftAlt)
			or userInputService:IsKeyDown(Enum.KeyCode.RightAlt)
		)
end

local function selectAll()
	if not handled then
		handled = true
		if canSelectKeys() then
			editActions.SelectAll()
		end
	end

	guardUntil = os.clock() + 0.15
end

local function timelineKeysSelected()
	local raw = rawState.Timeline
	return raw ~= nil
		and (
			raw.SelectedKeyframe ~= nil
			or raw.SelectedKeyframes ~= nil and next(raw.SelectedKeyframes) ~= nil
			or raw.SelectedChannelKeyframes ~= nil and next(raw.SelectedChannelKeyframes) ~= nil
		)
end

local function trackSelectionParents()
	local now = os.clock()
	local current = {}
	for _, instance in selectionService:Get() do
		local parent = instance.Parent
		if parent then
			current[instance] = true
			selectionParents[instance] = { parent = parent, left = nil }
		end
	end

	for instance, row in selectionParents do
		if not current[instance] then
			row.left = row.left or now
			if now - row.left > deleteWindow then
				selectionParents[instance] = nil
			end
		end
	end
end

local function guardStudioDelete(input)
	if not shortcuts.matches("DeleteKeys", input) or not ownsSelection() then
		return
	end

	if
		not keysSelected
		and not timelineKeysSelected()
		and not (state.GraphEditor and state.GraphEditor.hasFocus())
	then
		return
	end

	local now = os.clock()
	for instance, row in selectionParents do
		if
			instance.Parent == nil
			and (row.left == nil or now - row.left <= deleteWindow)
			and row.parent:IsDescendantOf(game)
		then
			pcall(function()
				instance.Parent = row.parent
			end)
		end
	end

	table.clear(selectionParents)
	if #selectionService:Get() > 0 then
		local previousIgnore = state.ignoreSelectionChanged
		state.ignoreSelectionChanged = true
		pcall(function()
			selectionService:Set({})
		end)
		state.ignoreSelectionChanged = previousIgnore
	end

	preservedSelection = {}
end

local function restoreSelection()
	local current = selectionService:Get()
	local keep, expected = {}, {}
	for _, instance in preservedSelection do
		if instance.Parent then
			table.insert(keep, instance)
			expected[instance] = true
		end
	end

	local changed = #current ~= #keep
	for _, instance in current do
		if not expected[instance] then
			changed = true
			break
		end
	end

	if not changed then
		return
	end

	restoring = true
	local previousIgnore = state.ignoreSelectionChanged
	state.ignoreSelectionChanged = true
	local ok, err = pcall(function()
		selectionService:Set(keep)
	end)
	state.ignoreSelectionChanged = previousIgnore
	restoring = false
	if not ok then
		warn(err)
	end
end

local function nativeDockSelectAll()
	if not userInputService.isDockKeyboardFocused() or userInputService.isPointerHeld() then
		return false
	end
	 
	 
	local selected = {}
	local selection = selectionService:Get()
	for _, object in selection do
		if object.Parent ~= workspace and object.Parent ~= game then
			return false
		end
		selected[object] = true
	end
	if not next(selected) then
		return false
	end
	local function selectable(root)
		if root:IsA("BasePart") and not root.Locked then
			return true
		end
		for _, child in root:GetDescendants() do
			if child:IsA("BasePart") and not child.Locked then
				return true
			end
		end
		return false
	end
	local roots = workspace:GetChildren()
	local allRoots = true
	for _, root in roots do
		allRoots = allRoots and selected[root] == true
	end
	if allRoots then
		return selected[workspace] == true or #selection == #roots
	end
	for _, object in selection do
		if object.Parent ~= workspace then
			return false
		end
	end
	for _, root in roots do
		if selectable(root) ~= (selected[root] == true) then
			return false
		end
	end
	return true
end

function editShortcuts.init(plugin)
	if #connections > 0 then
		return
	end

	preservedSelection = selectionService:Get()
	owned = ownsSelection()
	trackSelectionParents()

	local function began(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			guardUntil = 0
			return
		end

		if not syncOwnership() then
			return
		end

		guardStudioDelete(input)

		if state.EclipseFXKeys and state.EclipseFXKeys.claims(input) then
			return
		end

		if
			shortcuts.matches("SelectAll", input)
			or input.KeyCode == Enum.KeyCode.A and isStudioSelectAll()
		then
			chordWasDown = true
			selectAll()
			restoreSelection()
		end
	end

	table.insert(
		connections,
		userInputService.SelectAllRequested:Connect(function()
			if state.EclipseFXKeys and state.EclipseFXKeys.hasFocus() then
				state.EclipseFXKeys.selectAll()
				if syncOwnership() then
					restoreSelection()
				end
			elseif syncOwnership() then
				handled = false
				selectAll()
				restoreSelection()
			end
		end)
	)
	table.insert(connections, nativeInput.InputBegan:Connect(began))
	table.insert(
		connections,
		userInputService.InputBegan:Connect(function(input)
			began(input)
			if
				input.UserInputType == Enum.UserInputType.Keyboard
				and syncOwnership()
				and canSelectKeys()
				and shortcuts.matches("FitTimeline", input)
			then
				state.Timeline:FitTimeline()
			end
		end)
	)
	table.insert(
		connections,
		game:GetService("RunService").Heartbeat:Connect(function()
			local active = syncOwnership()
			keysSelected = active and timelineKeysSelected()
			local down = active
				and not (state.EclipseFXKeys and state.EclipseFXKeys.hasFocus())
				and (shortcuts.isDown("SelectAll") or isStudioSelectAll())
			if down and not chordWasDown then
				selectAll()
				restoreSelection()
			elseif not down then
				handled = false
			end

			chordWasDown = down
		end)
	)
	if plugin then
		local action = plugin:CreatePluginAction(
			"EclipseSelectAllKeyframes",
			"Eclipse: Select all keyframes",
			"Select all keyframes in the active Eclipse editor",
			"",
			true
		)
		table.insert(actions, action)
		table.insert(
			connections,
			action.Triggered:Connect(function()
				if state.EclipseFXKeys and state.EclipseFXKeys.hasFocus() then
					state.EclipseFXKeys.selectAll()
					if syncOwnership() then
						restoreSelection()
					end
				elseif syncOwnership() and canSelectKeys() then
					handled = false
					selectAll()
					restoreSelection()
				end
			end)
		)
	end

	table.insert(
		connections,
		selectionService.SelectionChanged:Connect(function()
			if restoring then
				return
			end

			trackSelectionParents()
			local active = syncOwnership()
			if state.ignoreSelectionChanged then
				preservedSelection = selectionService:Get()
				return
			end

			local native = active and nativeDockSelectAll()
			local chord = shortcuts.isDown("SelectAll") or isStudioSelectAll() or native
			if active and (chord or os.clock() < guardUntil) then
				if chord then
					if native then
						handled = false
					end
					chordWasDown = true
					if not (state.EclipseFXKeys and state.EclipseFXKeys.hasFocus()) then
						selectAll()
					end
				end

				restoreSelection()
			else
				preservedSelection = selectionService:Get()
			end
		end)
	)
	table.insert(
		connections,
		userInputService.InputEnded:Connect(function(input)
			if shortcuts.isKey("SelectAll", input.KeyCode) or input.KeyCode == Enum.KeyCode.A then
				handled, chordWasDown = false, false
			end
		end)
	)
	table.insert(
		connections,
		userInputService.WindowFocusReleased:Connect(function()
			handled, guardUntil, chordWasDown, owned = false, 0, false, false
			preservedSelection = selectionService:Get()
		end)
	)
end

function editShortcuts.destroy()
	for _, connection in connections do
		connection:Disconnect()
	end

	for _, action in actions do
		action:Destroy()
	end

	table.clear(connections)
	table.clear(actions)
	table.clear(preservedSelection)
	table.clear(selectionParents)
	keysSelected = false
	handled, guardUntil, restoring, chordWasDown, owned = false, 0, false, false, false
end

return editShortcuts
]]></ProtectedString>
						<string name="ScriptGuid">{D4082926-F213-4761-B2BF-ED7F8AEDEDF6}</string>
