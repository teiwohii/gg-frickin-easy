					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local camera = require("cameraRig")
local import = {}
local current

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function import.parse(text)
	assert(type(text) == "string" and #text > 0 and #text <= 32000000, "Paste the camera FOV text copied from Eclipse Blender.")
	local ok, data = pcall(game.HttpService.JSONDecode, game.HttpService, text)
	assert(ok and type(data) == "table", "The camera FOV text is not valid JSON.")
	assert(data.format == "EclipseCameraFOV" and data.version == 1 and data.units == "VerticalDegrees", "Copy Camera FOV from Eclipse Blender 1.5.16 or later.")
	assert(finite(data.fps) and data.fps >= 1 and data.fps <= 240, "Invalid source FPS.")
	assert(type(data.samples) == "table" and #data.samples > 0 and #data.samples <= 600000, "The FOV samples are missing or too large.")
	local previous = -1
	for _, row in data.samples do
		assert(type(row) == "table" and finite(row[1]) and row[1] >= 0 and row[1] <= 144000 and row[1] > previous, "FOV frames must be ordered and unique.")
		assert(finite(row[2]) and row[2] >= 1 and row[2] <= 120, "Roblox camera FOV must be between 1 and 120 degrees.")
		previous = row[1]
	end
	assert(data.samples[1][1] == 0, "The FOV export must start at frame zero.")
	return data
end

function import.camera(state)
	local cameras, selected = {}, {}
	local selection = game:GetService("Selection"):Get()
	for _, rig in state.getAllRigs() do
		if camera.isRig(rig) then
			table.insert(cameras, rig)
			for _, item in selection do
				local original = require("rigPreview").original(rig)
				if item == rig or item:IsDescendantOf(rig) or original and (item == original or item:IsDescendantOf(original)) then
					selected[rig] = true
				end
			end
		end
	end
	if #cameras == 1 then
		return cameras[1]
	end
	local chosen
	for rig in selected do
		assert(not chosen, "Select just one timeline camera first.")
		chosen = rig
	end
	chosen = chosen or (table.find(cameras, state.currentRig) and state.currentRig)
	assert(chosen, #cameras == 0 and "Add a camera to the timeline first." or "Select the timeline camera you want to import into first.")
	return chosen
end

function import.apply(state, rig, data)
	local timeline = state.Timeline
	local raw = timeline:GetState()
	assert(not raw.Playing and not timeline:IsExportLocked() and not state.LoadingProject, "Pause playback before importing camera FOV.")
	assert(not require("blenderEdit").blocked() and not state.PhysicsSimulating, "Finish the current edit or stop Blender Follow before importing camera FOV.")
	assert(table.find(state.getAllRigs(), rig) and camera.isRig(rig) and rig.Parent, "The selected camera is no longer in this project.")
	local motor = assert(camera.motor(rig, "FovPart"), "The camera has no FOV track.")
	assert(not require("layers").active(raw, motor).locked, "Unlock the active animation layer first.")
	local before = timeline:_snapshotMotorBucket(motor)
	local beforeEnd = timeline:CaptureTimelineEnd()
	local after = {}
	local last = data.samples[#data.samples][1] / data.fps * raw.FPS
	assert(last <= 1000000, "The imported FOV is too long for this project's frame rate.")
	local afterEnd = table.clone(beforeEnd)
	afterEnd.frame = math.max(beforeEnd.frame, math.ceil(last))
	for frame, key in before or {} do
		if frame > last then
			after[frame] = key
		end
	end
	for _, row in data.samples do
		local frame = row[1] / data.fps * raw.FPS
		local pose = camera.encode(motor, row[2])
		after[frame] = {
			Frame = frame, Time = row[1] / data.fps, Motor = motor, Part = motor.Part1,
			C0 = pose, Position = pose.Position, Rotation = pose.Rotation,
			Parented = true, EasingStyle = "Linear", EasingDirection = "In",
			HandleType = "Vector",
		}
	end
	local function apply(bucket, range)
		if not motor.Parent or not table.find(state.getAllRigs(), rig) then
			return
		end
		timeline:_restoreMotorBucket(motor, bucket)
		timeline:ApplyTimelineEnd(range)
		timeline:ApplyPoseAtTime(rig, raw.CurrentTime)
		timeline:UpdatePlayhead()
		state.currentProjectSaved = false
	end
	apply(after, afterEnd)
	require("history").record(function() apply(before, beforeEnd) end, function() apply(after, afterEnd) end, "Import Blender camera FOV")
	return #data.samples
end

function import.open(refs)
	if current then
		return current
	end
	if not refs.Active() then
		return
	end
	local ok, rig = pcall(import.camera, refs.State)
	if not ok then
		require("notification").show("BLENDER CAMERA FOV", tostring(rig):gsub("^.-:%d+: ", ""))
		return
	end
	local tool = require("tool")
	local window = tool.new(refs, "EclipseBlenderFOV", "ADD BLENDER CAMERA FOV", Vector2.new(500, 370), false, function() current = nil end)
	current = window
	tool.label(window.frame, "Camera", "Camera: " .. rig.Name, UDim2.fromOffset(16, 38), UDim2.new(1, -32, 0, 24))
	tool.label(window.frame, "Hint", "Paste Copy Camera FOV from the Eclipse panel in Blender.", UDim2.fromOffset(16, 66), UDim2.new(1, -32, 0, 30))
	local box = tool.field(window.frame, "FOVText", "", UDim2.fromOffset(16, 104), UDim2.new(1, -32, 0, 162))
	box.PlaceholderText = "Camera FOV text goes here..."
	box.MultiLine, box.TextWrapped, box.TextTruncate = true, true, Enum.TextTruncate.None
	box.TextYAlignment = Enum.TextYAlignment.Top
	local status = tool.label(window.frame, "Status", "Imports from frame 0. Undo restores the previous FOV keys.", UDim2.fromOffset(16, 274), UDim2.new(1, -32, 0, 46))
	status.TextWrapped = true
	tool.button(window.frame, "Save", "SAVE", UDim2.new(1, -136, 1, -42), UDim2.fromOffset(120, 28), function()
		local good, result = pcall(function()
			return import.apply(refs.State, rig, import.parse(box.Text))
		end)
		if good then
			window:close()
		else
			status.Text = tostring(result):gsub("^.-:%d+: ", "")
		end
	end)
	require("theme").applyTree(window.frame)
	return window
end

return import
]]></ProtectedString>
						<string name="ScriptGuid">{158ADA02-06C0-4E64-A3AA-66D50DF4090E}</string>
