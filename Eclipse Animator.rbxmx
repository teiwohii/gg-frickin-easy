							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = require(script.Parent.ShapeKit)

local energyBeam = {}

energyBeam.id = "EnergyBeam"
energyBeam.title = "Energy Beam"
energyBeam.root = "Part"
energyBeam.minimumSegments = 4
energyBeam.maximumSegments = 32

energyBeam.params = ShapeKit.join({
	{ name = "Length", kind = "number", default = 20, min = 0.1, max = 2000, tip = "How long the beam is, from tip to tip." },
	{ name = "Thickness", kind = "number", default = 3, min = 0, max = 200, tip = "How thick the beam is in the middle. Both ends taper to nothing." },
	{ name = "Segments", kind = "number", default = 12, min = 4, max = 32, integer = true, tip = "How many pieces make up the outline. More pieces make the ends rounder." },
	{ name = "Roundness", kind = "number", default = 0.5, min = 0.1, max = 2, tip = "0.5 gives a smooth rounded capsule. Lower values make the ends blunter, higher values make them pointier." },
	{ name = "Core", label = "Bright Core", kind = "toggle", default = true, tip = "Adds a thinner, brighter beam inside the main one." },
	{ name = "CoreScale", label = "Core Thickness", kind = "number", default = 0.45, min = 0.05, max = 1, tip = "How thick the core is compared to the beam." },
	{ name = "CoreColor", label = "Core Color", kind = "color", default = Color3.fromRGB(255, 255, 255), tip = "Color of the bright core." },
}, ShapeKit.beamParams({ Color = Color3.fromRGB(110, 190, 255) }))

function energyBeam.getWidth(alpha: number, thickness: number, roundness: number): number
	local centered = math.clamp(alpha * 2 - 1, -1, 1)

	return thickness * (math.max(1 - centered * centered, 0) ^ roundness)
end

function energyBeam.layer(kit, prefix: string, length: number, thickness: number, segments: number, roundness: number, color: Color3, transparency: number, order: number)
	local properties = kit:getBeamProperties()
	local previous = nil

	properties.Color = ColorSequence.new(color)
	properties.FaceCamera = true

	for index = 0, segments do
		local alpha = index / segments
		local point = kit:attachment(prefix .. "Point" .. index, CFrame.new((alpha - 0.5) * length, 0, 0))
		local width = energyBeam.getWidth(alpha, thickness, roundness)

		if previous then
			local beam = Instance.new("Beam")

			beam.Name = prefix .. "Beam" .. index

			for name, value in properties do
				(beam :: any)[name] = value
			end

			beam.Transparency = NumberSequence.new(transparency)
			beam.Width0 = previous.width
			beam.Width1 = width
			beam.ZOffset = order
			beam.Attachment0 = previous.point
			beam.Attachment1 = point
			beam.Parent = kit.root
			kit.count += 1
		end

		previous = { point = point, width = width }
	end
end

function energyBeam.build(kit, params)
	local length = math.max(tonumber(params.Length) or 20, 0.01)
	local thickness = math.max(tonumber(params.Thickness) or 3, 0)
	local segments = math.clamp(math.round(tonumber(params.Segments) or 12), energyBeam.minimumSegments, energyBeam.maximumSegments)
	local roundness = math.clamp(tonumber(params.Roundness) or 0.5, 0.1, 2)
	local base = math.clamp(tonumber(params.Transparency) or 0, 0, 1)
	local color = if typeof(params.Color) == "Color3" then params.Color else ShapeKit.defaultColor

	energyBeam.layer(kit, "", length, thickness, segments, roundness, color, base, 0)

	if params.Core ~= false then
		local scale = math.clamp(tonumber(params.CoreScale) or 0.45, 0.05, 1)
		local coreColor = if typeof(params.CoreColor) == "Color3" then params.CoreColor else Color3.new(1, 1, 1)

		energyBeam.layer(kit, "Core", length * (0.85 + 0.15 * scale), thickness * scale, segments, roundness, coreColor, base, 1)
	end
end

return energyBeam
]]></ProtectedString>
