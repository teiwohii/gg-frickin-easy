								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local colorOps = require(script.Parent.Parent.colorOps)
local Tool = require(script.Parent.Tool)

local RecolorTool = Tool.extend()

RecolorTool.id = "Recolor"
RecolorTool.title = "Recolor Effect"
RecolorTool.keywords = "colour color tint hue shift palette"
RecolorTool.modes = { "Tint", "Hue Shift" }

function RecolorTool.new(context)
	local self = setmetatable({}, RecolorTool)

	Tool.init(self, context, {
		Mode = "Tint",
		Color = Color3.fromRGB(120, 200, 255),
		Shift = 30,
		Whites = false,
	})

	return self
end

function RecolorTool:getFields()
	return {
		self:choice("Mode", "Mode", RecolorTool.modes, { tip = "Tint moves every colour to one hue. Hue Shift turns every colour around the colour wheel by the same amount." }),
		self:field("Color", "Tint Colour", "color"),
		self:field("Shift", "Hue Shift", "number", { range = { min = -180, max = 180 }, tip = "Degrees around the colour wheel." }),
		self:field("Whites", "Colour Whites", "toggle", { tip = "Off leaves white and grey as they are, which keeps bright cores white." }),
		self:action("Apply", "Recolor Selection", function()
			self:apply()
		end, nil, true),
	}
end

function RecolorTool:apply()
	local roots = self:requireRoots(false)

	if not roots then
		return
	end

	local params = self.params

	local transform = function(color: Color3): Color3
		if params.Mode == "Hue Shift" then
			return colorOps.shift(color, params.Shift / 360, 0)
		end

		return colorOps.tint(color, params.Color, params.Whites)
	end

	self:run("Recolor", function()
		for _, instance in self:getAffected() do
			colorOps.apply(instance, transform)
		end
	end)
end

return RecolorTool
]]></ProtectedString>
								<string name="ScriptGuid">{3739CB59-89E8-40C5-A282-F66A7853D63D}</string>
