					<Item class="ModuleScript" referent="RBX2C67FD606FD54BA1A5D9622D2FF666BE">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)
local valueCodec = require(script.Parent.Parent.Utility.valueCodec)
local Drawer = require(script.Parent.Drawer)
local sequenceTools = require(script.Parent.sequenceTools)

local CurveEditor = Drawer.extend()

CurveEditor.pickRadius = 8
CurveEditor.lineThickness = 2
CurveEditor.bandWidth = 3
CurveEditor.headroom = 1.15
CurveEditor.minimumMaximum = 0.001
CurveEditor.defaultTitle = "Curve"
CurveEditor.hintText = "Click to add. Drag to move. %s deletes the selected point."

function CurveEditor.new(frame: Frame, root: GuiObject, templates: Instance, group: { any })
	local self = setmetatable({}, CurveEditor)

	Drawer.init(self, frame, root, group, frame.Header.CloseCurve)

	self.templates = templates
	self.graph = frame.Graph
	self.lineContainer = frame.Graph.Lines
	self.pointContainer = frame.Graph.Points
	self.bandContainer = frame.Graph.Bands
	self.timeBox = frame.Point.Time.Box
	self.valueBox = frame.Point.Value.Box
	self.envelopeBox = frame.Point.Envelope.Box
	self.maximumBox = frame.Range.Maximum.Box
	self.points = {}
	self.lines = {}
	self.handles = {}
	self.bands = {}
	self.handleConnections = {}
	self.maximum = 1
	self.minimum = 0
	self.signed = false
	self.selected = 1
	self.armed = false
	self.dragIndex = nil
	self.dragMoved = false
	self.original = nil
	self.changeHandler = nil

	self:buildPresets()
	self:bind()

	return self
end

function CurveEditor:buildPresets()
	local container = self.frame.Presets

	for index, preset in configuration.Create.Sequences.curves do
		local button = self.templates.PresetButton:Clone()

		button.Name = "Preset"
		button.LayoutOrder = index
		button.Label.Text = preset.label
		button.Label.TextSize = 11
		button.Parent = container

		self:connect(button.Activated, function()
			self:applySequence(sequenceTools.fromPreset(preset, self:getPresetScale()))
		end)
	end
end

function CurveEditor:bind()
	local frame = self.frame

	self:connect(self.graph.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not self.dragIndex then
			self:pressGraph(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)

	self:connect(userInputService.InputChanged, function(input)
		if self.dragIndex and input.UserInputType == Enum.UserInputType.MouseMovement then
			self:dragTo(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)

	self:connect(userInputService.InputEnded, function(input)
		if self.dragIndex and input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:finishDrag()
		end
	end)

	self:connect(userInputService.InputBegan, function(input)
		self:onInput(input)
	end)

	self:connect(self.timeBox.FocusLost, function()
		self:editSelected("time", self.timeBox.Text)
	end)

	self:connect(self.valueBox.FocusLost, function()
		self:editSelected("value", self.valueBox.Text)
	end)

	self:connect(self.envelopeBox.FocusLost, function()
		self:editSelected("envelope", self.envelopeBox.Text)
	end)

	self:connect(self.maximumBox.FocusLost, function()
		local number = valueCodec.readNumbers(self.maximumBox.Text)[1]

		if number and number > 0 then
			self.maximum = math.max(number, CurveEditor.minimumMaximum)
		end

		self:render()
	end)

	self:connect(frame.Range.FitCurve.Activated, function()
		self:fit()
		self:render()
	end)

	self:connect(frame.Range.SmoothCurve.Activated, function()
		self:applySequence(sequenceTools.smooth(self:getSequence()))
	end)

	self:connect(frame.Range.LinearCurve.Activated, function()
		self:applySequence(sequenceTools.simplify(self:getSequence(), self.maximum))
	end)

	self:connect(frame.Actions.CopyCurve.Activated, function()
		sequenceTools.copy(self:getSequence())
	end)

	self:connect(frame.Actions.PasteCurve.Activated, function()
		local copied = sequenceTools.paste("NumberSequence")

		if copied then
			self:applySequence(copied)
		end
	end)

	self:connect(frame.Actions.FlipCurve.Activated, function()
		self:applySequence(sequenceTools.flip(self:getSequence()))
	end)

	self:connect(frame.Actions.InvertCurve.Activated, function()
		self:applySequence(sequenceTools.invert(self:getSequence(), self:getPresetScale()))
	end)

	self:connect(frame.Actions.ResetCurve.Activated, function()
		if self.original then
			self:applySequence(self.original)
		end
	end)
end

function CurveEditor:onInput(input: InputObject)
	if not self.armed or not self:isOpen() then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if not self:isInside(input) then
			self.armed = false
		end
	elseif self:isDeleteInput(input) then
		self:removePoint(self.selected)
	end
end

function CurveEditor:isArmed(): boolean
	return self.armed
end

function CurveEditor:isDragging(): boolean
	return self.dragIndex ~= nil
end

function CurveEditor:getSequence(): NumberSequence
	return sequenceTools.fromPoints(self.points)
end

function CurveEditor:getPeak(): number
	local peak = 0

	for _, point in self.points do
		peak = math.max(peak, point.value + point.envelope)
	end

	return peak
end

function CurveEditor:getPresetScale(): number
	local peak = 0

	for _, point in self.points do
		peak = math.max(peak, point.value)
	end

	return if peak > 0 then peak else self.maximum
end

function CurveEditor:fit()
	local peak = self:getPeak()

	self.maximum = if peak > 0 then peak * CurveEditor.headroom else 1
end

function CurveEditor:getGraphSize(): Vector2
	local width = self.frame.Size.X.Offset + self.graph.Size.X.Offset

	return Vector2.new(width, self.graph.Size.Y.Offset)
end

function CurveEditor:toGraph(point: Vector2): (number, number)
	local position = self.graph.AbsolutePosition
	local size = self.graph.AbsoluteSize
	local time = math.clamp((point.X - position.X) / math.max(size.X, 1), 0, 1)
	local alpha = math.clamp(1 - (point.Y - position.Y) / math.max(size.Y, 1), 0, 1)

	return time, self.minimum + alpha * (self.maximum - self.minimum)
end

function CurveEditor:getAlpha(value: number): number
	return (value - self.minimum) / math.max(self.maximum - self.minimum, CurveEditor.minimumMaximum)
end

function CurveEditor:updateRange()
	local lowest = 0

	for _, point in self.points do
		lowest = math.min(lowest, point.value)
	end

	if lowest < 0 or self.signed then
		self.maximum = math.max(self.maximum, -lowest * CurveEditor.headroom)
		self.minimum = -self.maximum
	else
		self.minimum = 0
	end
end

function CurveEditor:toPixels(point): Vector2
	local size = self:getGraphSize()

	return Vector2.new(point.time * size.X, (1 - self:getAlpha(point.value)) * size.Y)
end

function CurveEditor:findPoint(position: Vector2): number?
	local scale = self:getScale()
	local origin = self.graph.AbsolutePosition
	local best = nil
	local bestDistance = CurveEditor.pickRadius * scale

	for index, point in self.points do
		local pixels = self:toPixels(point) * scale
		local distance = (Vector2.new(origin.X + pixels.X, origin.Y + pixels.Y) - position).Magnitude

		if distance <= bestDistance then
			best = index
			bestDistance = distance
		end
	end

	return best
end

function CurveEditor:pressGraph(position: Vector2)
	local existing = self:findPoint(position)

	if existing then
		self:beginDrag(existing)
		return
	end

	if #self.points >= configuration.Create.maxSequencePoints then
		return
	end

	local time, value = self:toGraph(position)

	if time <= 0 or time >= 1 then
		return
	end

	local point = { time = time, value = value, envelope = 0 }

	table.insert(self.points, point)

	table.sort(self.points, function(a, b)
		return a.time < b.time
	end)

	self.dragMoved = true
	self:beginDrag(table.find(self.points, point) or 1, true)
	self:render()
	self:emit(false)
end

function CurveEditor:beginDrag(index: number, keepMoved: boolean?)
	self.dragIndex = index
	self.selected = index
	self.armed = true

	if not keepMoved then
		self.dragMoved = false
	end

	self:render()
end

function CurveEditor:dragTo(position: Vector2)
	local index = self.dragIndex
	local point = self.points[index]

	if not point then
		return
	end

	local time, value = self:toGraph(position)
	local gap = sequenceTools.minimumGap

	if index == 1 then
		time = 0
	elseif index == #self.points then
		time = 1
	else
		time = math.clamp(time, self.points[index - 1].time + gap, self.points[index + 1].time - gap)
	end

	point.time = time
	point.value = value
	self.dragMoved = true
	self:render()
	self:emit(false)
end

function CurveEditor:finishDrag()
	local moved = self.dragMoved

	self.dragIndex = nil
	self.dragMoved = false
	self:render()

	if moved then
		self:emit(true)
	end
end

function CurveEditor:removePoint(index: number)
	if index == 1 or index == #self.points or #self.points <= 2 then
		return
	end

	table.remove(self.points, index)
	self.selected = math.clamp(self.selected, 1, #self.points)
	self.armed = false
	self.dragIndex = nil
	self:render()
	self:emit(true)
end

function CurveEditor:editSelected(key: string, text: string)
	local point = self.points[self.selected]
	local number = valueCodec.readNumbers(text)[1]

	if not point or number == nil then
		self:render()
		return
	end

	if key == "time" then
		local index = self.selected

		if index > 1 and index < #self.points then
			local gap = sequenceTools.minimumGap

			point.time = math.clamp(number, self.points[index - 1].time + gap, self.points[index + 1].time - gap)
		end
	elseif key == "value" then
		point.value = number

		if number > self.maximum then
			self.maximum = number * CurveEditor.headroom
		end
	else
		point.envelope = math.max(number, 0)
	end

	self:render()
	self:emit(true)
end

function CurveEditor:emit(final: boolean)
	if self.changeHandler then
		self.changeHandler(self:getSequence(), final)
	end
end

function CurveEditor:applySequence(sequence: NumberSequence)
	self.points = sequenceTools.toPoints(sequence)
	self.selected = math.clamp(self.selected, 1, #self.points)

	if self:getPeak() > self.maximum then
		self:fit()
	end

	self:render()
	self:emit(true)
end

function CurveEditor:setSequence(sequence: NumberSequence)
	self.points = sequenceTools.toPoints(sequence)
	self.selected = math.clamp(self.selected, 1, #self.points)

	if self:getPeak() > self.maximum then
		self:fit()
	end

	self:render()
end

function CurveEditor:getPooled(pool, index: number, templateName: string, parent: Instance)
	local instance = pool[index]

	if not instance then
		instance = self.templates[templateName]:Clone()
		instance.Parent = parent
		pool[index] = instance
	end

	instance.Visible = true

	return instance
end

function CurveEditor:hideUnused(pool, used: number)
	for index = used + 1, #pool do
		pool[index].Visible = false
	end
end

function CurveEditor:bindHandle(handle: GuiButton, index: number)
	if self.handleConnections[handle] then
		return
	end

	self.handleConnections[handle] = {
		handle.MouseButton1Down:Connect(function()
			self:beginDrag(handle:GetAttribute("Index"))
		end),
		handle.MouseButton2Click:Connect(function()
			self:removePoint(handle:GetAttribute("Index"))
		end),
	}

	handle:SetAttribute("Index", index)
end

function CurveEditor:render()
	self:updateRange()

	local colors = configuration.Colors
	local size = self:getGraphSize()
	local lineCount = 0

	for index = 1, #self.points - 1 do
		local from = self:toPixels(self.points[index])
		local to = self:toPixels(self.points[index + 1])
		local delta = to - from
		local middle = (from + to) / 2
		local line = self:getPooled(self.lines, index, "GraphLine", self.lineContainer)

		line.Position = UDim2.fromOffset(middle.X, middle.Y)
		line.Size = UDim2.fromOffset(delta.Magnitude + 1, CurveEditor.lineThickness)
		line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
		line:SetAttribute("ThemeBg", "MenuSel")
		line.BackgroundColor3 = colors.Light
		lineCount = index
	end

	self:hideUnused(self.lines, lineCount)

	local bandCount = 0

	for index, point in self.points do
		local handle = self:getPooled(self.handles, index, "CurvePoint", self.pointContainer)

		self:bindHandle(handle, index)
		handle:SetAttribute("Index", index)
		handle.Position = UDim2.fromScale(point.time, math.clamp(1 - self:getAlpha(point.value), 0, 1))
		handle:SetAttribute("ThemeBg", if index == self.selected then "Txt" else "MenuSel")
		handle.BackgroundColor3 = if index == self.selected then colors.Text else colors.Light

		if point.envelope > 0 then
			bandCount += 1

			local band = self:getPooled(self.bands, bandCount, "CurveBand", self.bandContainer)
			local pixels = self:toPixels(point)

			band.Position = UDim2.fromOffset(pixels.X, pixels.Y)
			band.Size = UDim2.fromOffset(CurveEditor.bandWidth, math.max(point.envelope / (self.maximum - self.minimum) * size.Y * 2, 2))
			band:SetAttribute("ThemeBg", "MenuSel")
			band.BackgroundColor3 = colors.Light
		end
	end

	self:hideUnused(self.handles, #self.points)
	self:hideUnused(self.bands, bandCount)

	self.graph.Maximum.Text = valueCodec.round(self.maximum)
	self.graph.Minimum.Text = valueCodec.round(self.minimum)

	local selected = self.points[self.selected]

	if selected then
		if not self.timeBox:IsFocused() then
			self.timeBox.Text = valueCodec.round(selected.time)
		end

		if not self.valueBox:IsFocused() then
			self.valueBox.Text = valueCodec.round(selected.value)
		end

		if not self.envelopeBox:IsFocused() then
			self.envelopeBox.Text = valueCodec.round(selected.envelope)
		end
	end

	if not self.maximumBox:IsFocused() then
		self.maximumBox.Text = valueCodec.round(self.maximum)
	end
end

function CurveEditor:open(options)
	self.changeHandler = nil
	self:show(options.owner)

	self.changeHandler = options.onChange
	self.original = options.sequence
	self.points = sequenceTools.toPoints(options.sequence)
	self.selected = 1
	self.armed = false
	self.dragIndex = nil
	self.signed = options.signed == true
	self.frame.Hint.Text = string.format(CurveEditor.hintText, self:getDeleteKeyName())
	self.minimum = 0
	self.frame.Header.Title.Text = options.title or CurveEditor.defaultTitle

	local peak = self:getPeak()
	local hint = options.maximum or 0

	self.maximum = math.max(if peak > hint then peak * CurveEditor.headroom else hint, CurveEditor.minimumMaximum)

	if self.maximum <= CurveEditor.minimumMaximum then
		self.maximum = 1
	end

	self:render()
end

function CurveEditor:toggle(options)
	if self:isOpen() and self.owner == options.owner then
		self:close()
		return
	end

	self:open(options)
end

function CurveEditor:close()
	if self.dragIndex then
		self:finishDrag()
	end

	self.armed = false
	self.changeHandler = nil
	self:hide()
end

function CurveEditor:destroy()
	for _, connections in self.handleConnections do
		for _, connection in connections do
			connection:Disconnect()
		end
	end

	table.clear(self.handleConnections)
	Drawer.destroy(self)
end

return CurveEditor
]]></ProtectedString>
							<string name="ScriptGuid">{48E59AA8-DDC5-44C9-9178-78E063499F0A}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">CurveEditor</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXCCEAD02B25B747D88AC978ACEB08B622">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)
local valueCodec = require(script.Parent.Parent.Utility.valueCodec)
local Drawer = require(script.Parent.Drawer)
local sequenceTools = require(script.Parent.sequenceTools)

local GradientEditor = Drawer.extend()

GradientEditor.defaultTitle = "Gradient"
GradientEditor.hintText = "Click the bar to add. Drag markers. %s deletes the selected one."
GradientEditor.selectedSize = UDim2.fromOffset(12, 14)
GradientEditor.normalSize = UDim2.fromOffset(10, 13)

function GradientEditor.new(frame: Frame, root: GuiObject, templates: Instance, group: { any }, colors)
	local self = setmetatable({}, GradientEditor)

	Drawer.init(self, frame, root, group, frame.Header.CloseGradient)

	self.templates = templates
	self.colors = colors
	self.bar = frame.Bar
	self.fill = frame.Bar.Fill
	self.markerContainer = frame.Markers
	self.timeBox = frame.Point.Time.Box
	self.swatch = frame.Point.Swatch
	self.hexBox = frame.Point.Hex
	self.points = {}
	self.markers = {}
	self.markerConnections = {}
	self.selected = 1
	self.armed = false
	self.dragIndex = nil
	self.dragMoved = false
	self.colorDirty = false
	self.original = nil
	self.changeHandler = nil

	self:buildPresets()
	self:bind()

	return self
end

function GradientEditor:buildPresets()
	local container = self.frame.Presets

	for index, preset in configuration.Create.Sequences.gradients do
		local button = self.templates.GradientPreset:Clone()
		local sequence = sequenceTools.gradientFromPreset(preset)

		button.Name = "Preset"
		button.LayoutOrder = index
		button.Fill.Color = sequence
		button.Parent = container

		self:connect(button.Activated, function()
			self:applySequence(sequence)
		end)
	end
end

function GradientEditor:bind()
	local frame = self.frame

	self:connect(self.bar.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not self.dragIndex then
			self:addPoint(self:toTime(input.Position.X))
		end
	end)

	self:connect(userInputService.InputChanged, function(input)
		if self.dragIndex and input.UserInputType == Enum.UserInputType.MouseMovement then
			self:dragTo(self:toTime(input.Position.X))
		end
	end)

	self:connect(userInputService.InputEnded, function(input)
		if self.dragIndex and input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:finishDrag()
		end
	end)

	self:connect(userInputService.InputBegan, function(input)
		self:onInput(input)
	end)

	self:connect(self.timeBox.FocusLost, function()
		local number = valueCodec.readNumbers(self.timeBox.Text)[1]
		local index = self.selected
		local point = self.points[index]

		if number and point and index > 1 and index < #self.points then
			local gap = sequenceTools.minimumGap

			point.time = math.clamp(number, self.points[index - 1].time + gap, self.points[index + 1].time - gap)
			self:render()
			self:emit(true)
		else
			self:render()
		end
	end)

	self:connect(self.hexBox.FocusLost, function()
		local color = self:parseColor(self.hexBox.Text)
		local point = self.points[self.selected]

		if color and point then
			point.color = color
			self:render()
			self:emit(true)
		else
			self:render()
		end
	end)

	self:connect(self.swatch.Activated, function()
		self:openColor()
	end)

	self:connect(frame.Actions.CopyGradient.Activated, function()
		sequenceTools.copy(self:getSequence())
	end)

	self:connect(frame.Actions.PasteGradient.Activated, function()
		local copied = sequenceTools.paste("ColorSequence")

		if copied then
			self:applySequence(copied)
		end
	end)

	self:connect(frame.Actions.FlipGradient.Activated, function()
		self:applySequence(sequenceTools.flipColor(self:getSequence()))
	end)

	self:connect(frame.Actions.SpreadGradient.Activated, function()
		self:applySequence(sequenceTools.spreadColor(self:getSequence()))
	end)

	self:connect(frame.Actions.ResetGradient.Activated, function()
		if self.original then
			self:applySequence(self.original)
		end
	end)
end

function GradientEditor:onInput(input: InputObject)
	if not self.armed or not self:isOpen() then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if not self:isInside(input) then
			self.armed = false
		end
	elseif self:isDeleteInput(input) then
		self:closeColor()
		self:removePoint(self.selected)
	end
end

function GradientEditor:isArmed(): boolean
	return self.armed
end

function GradientEditor:parseColor(text: string): Color3?
	local hex = string.match(text, "^%s*#?(%x%x%x%x%x%x)%s*$")

	if hex then
		local success, color = pcall(Color3.fromHex, hex)

		return if success then color else nil
	end

	local numbers = valueCodec.readNumbers(text)

	if #numbers >= 3 then
		return Color3.fromRGB(math.clamp(numbers[1], 0, 255), math.clamp(numbers[2], 0, 255), math.clamp(numbers[3], 0, 255))
	end

	return nil
end

function GradientEditor:isDragging(): boolean
	return self.dragIndex ~= nil or self.colorDirty
end

function GradientEditor:getSequence(): ColorSequence
	return sequenceTools.fromColorPoints(self.points)
end

function GradientEditor:toTime(x: number): number
	local position = self.bar.AbsolutePosition.X
	local width = math.max(self.bar.AbsoluteSize.X, 1)

	return math.clamp((x - position) / width, 0, 1)
end

function GradientEditor:addPoint(time: number)
	if #self.points >= configuration.Create.maxSequencePoints or time <= 0 or time >= 1 then
		return
	end

	local point = { time = time, color = sequenceTools.evaluateColor(self:getSequence(), time) }

	table.insert(self.points, point)

	table.sort(self.points, function(a, b)
		return a.time < b.time
	end)

	self.selected = table.find(self.points, point) or 1
	self.armed = true
	self.dragIndex = self.selected
	self.dragMoved = true
	self:render()
	self:emit(false)
end

function GradientEditor:beginDrag(index: number)
	self.selected = index
	self.armed = true
	self.dragIndex = index
	self.dragMoved = false
	self:render()
end

function GradientEditor:dragTo(time: number)
	local index = self.dragIndex
	local point = self.points[index]

	if not point or index == 1 or index == #self.points then
		return
	end

	local gap = sequenceTools.minimumGap

	point.time = math.clamp(time, self.points[index - 1].time + gap, self.points[index + 1].time - gap)
	self.dragMoved = true
	self:render()
	self:emit(false)
end

function GradientEditor:finishDrag()
	local moved = self.dragMoved

	self.dragIndex = nil
	self.dragMoved = false

	if moved then
		self:emit(true)
	end
end

function GradientEditor:removePoint(index: number)
	if index == 1 or index == #self.points or #self.points <= 2 then
		return
	end

	table.remove(self.points, index)
	self.selected = math.clamp(self.selected, 1, #self.points)
	self.armed = false
	self.dragIndex = nil
	self:render()
	self:emit(true)
end

function GradientEditor:openColor()
	local point = self.points[self.selected]

	if not point then
		return
	end

	self.colorDirty = false

	self.colors:toggle({
		owner = self,
		anchor = self.swatch,
		color = point.color,
		title = "Gradient Colour",
		onChanged = function(color: Color3)
			point.color = color
			self.colorDirty = true
			self:render()
			self:emit(false)
		end,
		onClosed = function()
			if self.colorDirty then
				self.colorDirty = false
				self:emit(true)
			end
		end,
	})
end

function GradientEditor:closeColor()
	if self.colors:isOpen() and self.colors:getOwner() == self then
		self.colors:close()
	end
end

function GradientEditor:emit(final: boolean)
	if self.changeHandler then
		self.changeHandler(self:getSequence(), final)
	end
end

function GradientEditor:applySequence(sequence: ColorSequence)
	self:closeColor()
	self.points = sequenceTools.toColorPoints(sequence)
	self.selected = math.clamp(self.selected, 1, #self.points)
	self:render()
	self:emit(true)
end

function GradientEditor:setSequence(sequence: ColorSequence)
	self.points = sequenceTools.toColorPoints(sequence)
	self.selected = math.clamp(self.selected, 1, #self.points)
	self:render()
end

function GradientEditor:bindMarker(marker: GuiButton)
	if self.markerConnections[marker] then
		return
	end

	self.markerConnections[marker] = {
		marker.MouseButton1Down:Connect(function()
			self:closeColor()
			self:beginDrag(marker:GetAttribute("Index"))
		end),
		marker.MouseButton2Click:Connect(function()
			self:closeColor()
			self:removePoint(marker:GetAttribute("Index"))
		end),
	}
end

function GradientEditor:render()
	local colors = configuration.Colors

	self.fill.Color = self:getSequence()

	for index, point in self.points do
		local marker = self.markers[index]

		if not marker then
			marker = self.templates.GradientMarker:Clone()
			marker.Parent = self.markerContainer
			self.markers[index] = marker
			self:bindMarker(marker)
		end

		local isSelected = index == self.selected
		local stroke = marker:FindFirstChildOfClass("UIStroke")

		marker:SetAttribute("Index", index)
		marker.Visible = true
		marker.Position = UDim2.fromScale(point.time, 0)
		marker:SetAttribute("EclipseFXValueColor", true)
		marker.BackgroundColor3 = point.color
		marker.Size = if isSelected then GradientEditor.selectedSize else GradientEditor.normalSize
		marker.ZIndex = if isSelected then 3 else 2

		if stroke then
			stroke:SetAttribute("ThemeStrk", if isSelected then "MenuSel" else "Txt")
			stroke.Color = if isSelected then colors.Light else colors.Text
			stroke.Thickness = if isSelected then 2 else 1
		end
	end

	for index = #self.points + 1, #self.markers do
		self.markers[index].Visible = false
	end

	local selected = self.points[self.selected]

	if not selected then
		return
	end

	self.swatch.BackgroundColor3 = selected.color

	if not self.timeBox:IsFocused() then
		self.timeBox.Text = valueCodec.round(selected.time)
	end

	if not self.hexBox:IsFocused() then
		self.hexBox.Text = "#" .. string.upper(selected.color:ToHex())
	end
end

function GradientEditor:open(options)
	self:closeColor()
	self.changeHandler = nil
	self:show(options.owner)

	self.changeHandler = options.onChange
	self.original = options.sequence
	self.points = sequenceTools.toColorPoints(options.sequence)
	self.selected = 1
	self.armed = false
	self.dragIndex = nil
	self.frame.Header.Title.Text = options.title or GradientEditor.defaultTitle
	self.frame.Hint.Text = string.format(GradientEditor.hintText, self:getDeleteKeyName())
	self:render()
end

function GradientEditor:toggle(options)
	if self:isOpen() and self.owner == options.owner then
		self:close()
		return
	end

	self:open(options)
end

function GradientEditor:close()
	if self.dragIndex then
		self:finishDrag()
	end

	self:closeColor()
	self.armed = false
	self.changeHandler = nil
	self:hide()
end

function GradientEditor:destroy()
	for _, connections in self.markerConnections do
		for _, connection in connections do
			connection:Disconnect()
		end
	end

	table.clear(self.markerConnections)
	Drawer.destroy(self)
end

return GradientEditor
]]></ProtectedString>
							<string name="ScriptGuid">{DBB1BFB3-71EB-474C-8EE2-58B6255F89B3}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">GradientEditor</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX93A1394B8D68432F9C25B7275356498E">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)
local Organizer = require(script.Parent.Parent.Project.Organizer)
local SelectionValidator = require(script.Parent.Parent.Project.SelectionValidator)

local Asset = {}
Asset.__index = Asset

Asset.searchDepth = 3
Asset.baseName = "Base"
Asset.spawnAttempts = 12

Asset.messages = {
	empty = "Nothing is selected. Select an Arc project, or the VFX you want to turn into an asset.",
	invalid = "Some of the selected objects can't be used in an asset: %s.",
	missingEffects = "That project has no Effects model, so it can't be opened.",
}

function Asset.new(factory, history)
	local self = setmetatable({}, Asset)

	self.factory = factory
	self.history = history
	self.validator = SelectionValidator.new(configuration.Classes)
	self.project = nil
	self.organizer = nil
	self.handlers = {}
	self.connection = nil

	return self
end

function Asset:addChangedHandler(handler: (Instance?) -> ())
	table.insert(self.handlers, handler)
end

function Asset:notify()
	for _, handler in self.handlers do
		local success, problem = pcall(handler, self.project)

		if not success then
			warn(problem)
		end
	end
end

function Asset:isOpen(): boolean
	return self.project ~= nil
end

function Asset:getProject(): Instance?
	return self.project
end

function Asset:getName(): string?
	return if self.project then self.project.Name else nil
end

function Asset:getEffects(): Model?
	return if self.project then self.factory:getEffects(self.project) else nil
end

function Asset:getBase(): BasePart?
	local effects = self:getEffects()
	local base = effects and effects:FindFirstChild(Asset.baseName)

	return if base and base:IsA("BasePart") then base else nil
end

function Asset:getOrganizer()
	return self.organizer
end

function Asset:isBase(instance: Instance): boolean
	return instance == self:getBase()
end

function Asset:contains(instance: Instance): boolean
	local effects = self:getEffects()

	return effects ~= nil and (instance == effects or instance:IsDescendantOf(effects))
end

function Asset:isEditable(instance: Instance): boolean
	local effects = self:getEffects()

	return effects ~= nil and instance ~= effects and instance:IsDescendantOf(effects) and not self:isBase(instance)
end

function Asset:getSpawnCFrame(): CFrame
	local camera = workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * configuration.Create.spawnDistance
	local parameters = RaycastParams.new()

	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = {}

	local position = origin + direction
	local ignored = {}

	for _ = 1, Asset.spawnAttempts do
		local result = workspace:Raycast(origin, direction * 4, parameters)

		if not result then
			break
		end

		if self:isSolidSurface(result.Instance) then
			position = result.Position + Vector3.new(0, 0.5, 0)

			break
		end

		table.insert(ignored, result.Instance)
		parameters.FilterDescendantsInstances = ignored
	end

	return CFrame.new(position)
end

function Asset:isSolidSurface(instance: Instance): boolean
	if not instance:IsA("BasePart") then
		return false
	end

	if instance:IsA("Terrain") then
		return true
	end

	return instance.CanCollide and instance.Transparency < 1
end

function Asset:getOrigin(): CFrame
	local base = self:getBase()

	if base then
		return base.CFrame
	end

	local effects = self:getEffects()

	if effects then
		return effects:GetPivot()
	end

	return self:getSpawnCFrame()
end

function Asset:collectProjects(parent: Instance, depth: number, results: { Instance })
	for _, child in parent:GetChildren() do
		if self.factory:isProject(child) then
			table.insert(results, child)
		elseif depth < Asset.searchDepth and (child:IsA("Folder") or child:IsA("Model")) and child ~= script.Parent.Parent.Parent then
			self:collectProjects(child, depth + 1, results)
		end
	end
end

function Asset:listProjects(): { Instance }
	local results = {}

	self:collectProjects(workspace, 1, results)

	table.sort(results, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	return results
end

function Asset:getUniqueName(base: string): string
	local taken = {}

	for _, project in self:listProjects() do
		taken[project.Name] = true
	end

	if not taken[base] then
		return base
	end

	local index = 2

	while taken[base .. " " .. index] do
		index += 1
	end

	return base .. " " .. index
end

function Asset:create(name: string?): Instance?
	local project = self.history:run("New Asset", function()
		return self.factory:createEmpty(self:getUniqueName(name or configuration.Create.defaultAssetName), self:getSpawnCFrame())
	end)

	if project then
		self:open(project)
	end

	return project
end

function Asset:formatNames(instances: { Instance }): string
	local names = {}

	for index, instance in instances do
		if index > 3 then
			table.insert(names, string.format("and %d more", #instances - 3))
			break
		end

		table.insert(names, string.format("%s (%s)", instance.Name, instance.ClassName))
	end

	return table.concat(names, ", ")
end

function Asset:openFromSelection(instances: { Instance }): (boolean, string?)
	if #instances == 0 then
		return false, Asset.messages.empty
	end

	for _, instance in instances do
		local owner = self.factory:getOwningProject(instance)

		if owner then
			return self:open(owner)
		end
	end

	local result, rejected = self.validator:validate(instances)

	if result ~= SelectionValidator.Result.valid then
		return false, string.format(Asset.messages.invalid, self:formatNames(rejected))
	end

	local project = self.factory:create(self:getUniqueName(instances[1].Name), instances)

	if not project then
		return false, Asset.messages.empty
	end

	return self:open(project)
end

function Asset:open(project: Instance): (boolean, string?)
	if not self.factory:getEffects(project) then
		return false, Asset.messages.missingEffects
	end

	if self.project == project then
		return true
	end

	self:detach()

	self.project = project
	self.organizer = Organizer.new(project)

	self.connection = project.AncestryChanged:Connect(function()
		if not project:IsDescendantOf(workspace) then
			self:close()
		end
	end)

	self:notify()

	return true
end

function Asset:detach()
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end

	self.project = nil
	self.organizer = nil
end

function Asset:close()
	if not self.project then
		return
	end

	self:detach()
	self:notify()
end

function Asset:rename(name: string): boolean
	local trimmed = string.gsub(name, "^%s*(.-)%s*$", "%1")

	if trimmed == "" or not self.project then
		return false
	end

	self.history:run("Rename Asset", function()
		self.project.Name = trimmed
	end)

	self:notify()

	return true
end

function Asset:reload()
	if self.organizer then
		self.organizer:load()
	end
end

function Asset:destroy()
	self:detach()
	table.clear(self.handlers)
end

return Asset
]]></ProtectedString>
							<string name="ScriptGuid">{59FD4451-D800-406D-9A5D-B4859A303CBB}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Asset</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXF1F91A549B1B481A89D10075D3CDD84D">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)
local pinner = require(script.Parent.Parent.Utility.pinner)
local PremiumGate = require(script.Parent.Parent.Premium.PremiumGate)

local Hierarchy = {}
Hierarchy.__index = Hierarchy

Hierarchy.expandedText = "v"
Hierarchy.collapsedText = ">"
Hierarchy.arrowOffset = 2
Hierarchy.iconOffset = 18
Hierarchy.labelOffset = 38
Hierarchy.rightInset = 20
Hierarchy.fallbackHeight = 316
Hierarchy.folderName = "Folder"
Hierarchy.modelName = "Group"
Hierarchy.baseColor = Color3.fromRGB(222, 222, 228)
Hierarchy.dragThreshold = 6
Hierarchy.dragOffset = Vector2.new(14, 8)
Hierarchy.dropTransparency = 0.25
Hierarchy.clickSuppressTime = 0.15
Hierarchy.pointChildren = { "ParticleEmitter", "Light", "Fire", "Smoke", "Sparkles", "BillboardGui", "Sound" }
Hierarchy.modelChildren = { "PVInstance", "Sound" }
Hierarchy.partChildren = { "Attachment", "ParticleEmitter", "Beam", "Trail", "Light", "Fire", "Smoke", "Sparkles", "Decal", "SurfaceGui", "BillboardGui", "DataModelMesh", "Highlight", "Sound" }

function Hierarchy.new(panel: Frame, templates: Instance, context)
	local self = setmetatable({}, Hierarchy)

	self.panel = panel
	self.list = panel.List
	self.search = panel.Search
	self.startPage = panel.Start
	self.groupButton = panel.Header.Group
	self.template = templates.HierarchyRow
	self.projectTemplate = templates.ProjectItem
	self.ghostTemplate = templates.DragGhost
	self.drag = nil
	self.suppressUntil = 0
	self.context = context
	self.asset = context.asset
	self.selection = context.selection
	self.entries = {}
	self.entryByInstance = {}
	self.collapsed = setmetatable({}, { __mode = "k" })
	self.rowConnections = {}
	self.watchConnections = {}
	self.projectConnections = {}
	self.projectRows = {}
	self.connections = {}
	self.filter = ""
	self.pending = false
	self.active = false
	self.lastClicked = nil
	self.lastClickTime = 0
	self.renaming = nil

	context.icons:apply(self.groupButton.Icon, "group")
	self:bind()

	return self
end

function Hierarchy:bind()
	table.insert(self.connections, self.search:GetPropertyChangedSignal("Text"):Connect(function()
		local filter = string.lower(string.gsub(self.search.Text, "^%s*(.-)%s*$", "%1"))

		if filter ~= self.filter then
			self.filter = filter
			self:rebuild()
		end
	end))

	table.insert(self.connections, self.groupButton.Activated:Connect(function()
		self:groupSelection()
	end))

	table.insert(self.connections, userInputService.InputChanged:Connect(function(input)
		if self.drag and input.UserInputType == Enum.UserInputType.MouseMovement then
			self:updateDrag(Vector2.new(input.Position.X, input.Position.Y))
		end
	end))

	table.insert(self.connections, userInputService.InputEnded:Connect(function(input)
		if self.drag and input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:finishDrag(Vector2.new(input.Position.X, input.Position.Y))
		end
	end))

	table.insert(self.connections, self.startPage.NewAsset.Activated:Connect(function()
		self.context.newAsset()
	end))

	table.insert(self.connections, self.startPage.OpenAsset.Activated:Connect(function()
		self.context.openSelected()
	end))
end

function Hierarchy:start()
	self.active = true
	self:watch()
	self:rebuild()
end

function Hierarchy:stop()
	self.active = false
	self:cancelDrag()
	self:endRename(false)
	self:unwatch()
end

function Hierarchy:unwatch()
	for _, connection in self.watchConnections do
		connection:Disconnect()
	end

	table.clear(self.watchConnections)
end

function Hierarchy:watch()
	self:unwatch()

	local project = self.asset:getProject()

	if not project or not self.active then
		return
	end

	table.insert(self.watchConnections, project.DescendantAdded:Connect(function()
		self:schedule()
	end))

	table.insert(self.watchConnections, project.DescendantRemoving:Connect(function()
		self:schedule()
	end))
end

function Hierarchy:schedule()
	if self.pending then
		return
	end

	self.pending = true

	task.defer(function()
		self.pending = false

		if self.active then
			self:rebuild()
		end
	end)
end

function Hierarchy:onAssetChanged()
	table.clear(self.collapsed)
	self.lastClicked = nil
	self.list.CanvasPosition = Vector2.zero
	self:watch()
	self:rebuild()
end

function Hierarchy:isHiddenInstance(instance: Instance): boolean
	return instance:GetAttribute(configuration.Create.hiddenAttribute) == true
end

function Hierarchy:isFolder(instance: Instance): boolean
	local organizer = self.asset:getOrganizer()

	return organizer ~= nil and organizer:isFolder(instance)
end

function Hierarchy:getChildren(parent: Instance): { Instance }
	local organizer = self.asset:getOrganizer()
	local source = if organizer then organizer:getDisplayChildren(parent) else parent:GetChildren()
	local children = {}

	for _, child in source do
		if not self:isHiddenInstance(child) then
			table.insert(children, child)
		end
	end

	return pinner.arrange(children, function(child)
		return self.asset:isBase(child)
	end)
end

function Hierarchy:isExpanded(instance: Instance, childCount: number): boolean
	local stored = self.collapsed[instance]

	if stored ~= nil then
		return not stored
	end

	if instance:GetAttribute(configuration.Create.generatorAttribute) ~= nil then
		return false
	end

	return childCount <= configuration.Create.collapseThreshold
end

function Hierarchy:matches(instance: Instance): boolean
	return string.find(string.lower(instance.Name), self.filter, 1, true) ~= nil or string.find(string.lower(instance.ClassName), self.filter, 1, true) ~= nil
end

function Hierarchy:collect(parent: Instance, depth: number, entries, visited)
	for _, child in self:getChildren(parent) do
		if not visited[child] then
			visited[child] = true

			local children = self:getChildren(child)
			local filtering = self.filter ~= ""
			local expanded = filtering or self:isExpanded(child, #children)

			if not filtering or self:matches(child) then
				table.insert(entries, {
					instance = child,
					depth = if filtering then 0 else depth,
					isFolder = self:isFolder(child),
					hasChildren = #children > 0 and not filtering,
					expanded = expanded,
				})
			end

			if expanded and #children > 0 then
				self:collect(child, depth + 1, entries, visited)
			end
		end
	end

	return entries
end

function Hierarchy:clearRows()
	self:cancelDrag()
	self:endRename(false)

	for _, connection in self.rowConnections do
		connection:Disconnect()
	end

	table.clear(self.rowConnections)

	for _, entry in self.entries do
		if entry.row then
			entry.row:Destroy()
		end
	end

	table.clear(self.entries)
	table.clear(self.entryByInstance)
end

function Hierarchy:connectRow(signal: RBXScriptSignal, callback)
	table.insert(self.rowConnections, signal:Connect(callback))
end

function Hierarchy:canHide(entry): boolean
	return not self.asset:isBase(entry.instance)
end

function Hierarchy:resolve(entry): { Instance }
	if entry.isFolder then
		return self.asset:getOrganizer():collectInstances(entry.instance)
	end

	return { entry.instance }
end

function Hierarchy:createRow(entry, order: number)
	local instance = entry.instance
	local row = self.template:Clone()
	local indent = entry.depth * configuration.Create.rowIndent
	local labelOffset = Hierarchy.labelOffset + indent

	row.LayoutOrder = order
	row.Arrow.Position = UDim2.fromOffset(Hierarchy.arrowOffset + indent, 0)
	row.Arrow.Visible = entry.hasChildren
	row.Arrow.Text = if entry.expanded then Hierarchy.expandedText else Hierarchy.collapsedText
	row.Icon.Position = UDim2.new(0, Hierarchy.iconOffset + indent, 0.5, 0)
	row.Label.Position = UDim2.fromOffset(labelOffset, 0)
	row.Label.Size = UDim2.new(1, -labelOffset - Hierarchy.rightInset, 1, 0)
	row.Label.Text = instance.Name
	row.Rename.Position = UDim2.fromOffset(labelOffset - 2, 1)
	row.Rename.Size = UDim2.new(1, -labelOffset - 2, 1, -2)
	row.Hide.Visible = self:canHide(entry)
	row.Pin.Visible = pinner.isShown(instance)

	if entry.isFolder then
		self.context.icons:apply(row.Icon, "folder")
	else
		self.context.icons:applyInstance(row.Icon, instance)
	end

	if self.asset:isBase(instance) then
		row.Label:SetAttribute("ThemeTxt", "Txt")
		row.Label.TextColor3 = Hierarchy.baseColor
	end

	entry.row = row

	self:connectRow(row.Activated, function()
		self:onActivated(entry)
	end)

	self:connectRow(row.MouseButton2Click, function()
		self:openContextMenu(entry)
	end)

	self:connectRow(row.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:beginDrag(entry, Vector2.new(input.Position.X, input.Position.Y))
		end
	end)

	self:connectRow(row.Arrow.Activated, function()
		self.collapsed[instance] = entry.expanded
		self:rebuild()
	end)

	self:connectRow(row.Hide.Activated, function()
		self:toggleHidden(entry)
	end)

	self:connectRow(row.MouseEnter, function()
		entry.hovered = true
		self:styleRow(entry)
	end)

	self:connectRow(row.MouseLeave, function()
		entry.hovered = false
		self:styleRow(entry)
	end)

	self:connectRow(instance:GetPropertyChangedSignal("Name"), function()
		row.Label.Text = instance.Name
	end)

	row.Parent = self.list
end

function Hierarchy:rebuild()
	local effects = self.asset:getEffects()
	local canvas = self.list.CanvasPosition

	self:clearRows()

	local open = effects ~= nil

	self.list.Visible = open
	self.search.Visible = open
	self.groupButton.Visible = open
	self.startPage.Visible = not open

	if not open then
		self:refreshProjects()
		return
	end

	self:clearProjects()
	self.asset:reload()
	self.entries = self:collect(effects, 0, {}, {})

	for index, entry in self.entries do
		entry.index = index
		self.entryByInstance[entry.instance] = entry
		self:createRow(entry, index)
	end

	self:restyle()
	self.list.CanvasPosition = canvas

	if self.context.structureChanged then
		self.context.structureChanged()
	end
end

function Hierarchy:isEntrySelected(entry, lookup): boolean
	if not entry.isFolder then
		return lookup[entry.instance] == true
	end

	local members = self:resolve(entry)

	if #members == 0 then
		return false
	end

	for _, member in members do
		if not lookup[member] then
			return false
		end
	end

	return true
end

function Hierarchy:isEntryHidden(entry): boolean
	local hideManager = self.context.hideManager

	for _, instance in self:resolve(entry) do
		if not hideManager:isHidden(instance) then
			return false
		end
	end

	return true
end

function Hierarchy:styleRow(entry)
	local row = entry.row
	local colors = configuration.Colors
	local settings = configuration.Create

	if not row then
		return
	end

	if entry.selected then
		row:SetAttribute("ThemeBg", "MenuSel")
		row.BackgroundColor3 = colors.Light
		row.BackgroundTransparency = settings.selectionTransparency
	elseif entry.hovered then
		row:SetAttribute("ThemeBg", "MenuSel")
		row.BackgroundColor3 = colors.Light
		row.BackgroundTransparency = settings.hoverTransparency
	else
		row:SetAttribute("ThemeBg", "Pnl")
		row.BackgroundColor3 = colors.Tertiary
		row.BackgroundTransparency = if entry.index % 2 == 0 then settings.stripeTransparency else 1
	end

	if row.Hide.Visible then
		row.Hide.ImageColor3 = if self:isEntryHidden(entry) then settings.hiddenIconColor else settings.visibleIconColor
	end
end

function Hierarchy:restyle()
	local lookup = self.selection:getLookup()

	for _, entry in self.entries do
		entry.selected = self:isEntrySelected(entry, lookup)
		self:styleRow(entry)
	end
end

function Hierarchy:isModifierDown(first: Enum.KeyCode, second: Enum.KeyCode): boolean
	return userInputService:IsKeyDown(first) or userInputService:IsKeyDown(second)
end

function Hierarchy:selectRange(target)
	local anchor = self.lastClicked and self.entryByInstance[self.lastClicked]

	if not anchor then
		self.selection:set(self:resolve(target))
		return
	end

	local first = math.min(anchor.index, target.index)
	local last = math.max(anchor.index, target.index)
	local instances = {}

	for index = first, last do
		for _, instance in self:resolve(self.entries[index]) do
			if not table.find(instances, instance) then
				table.insert(instances, instance)
			end
		end
	end

	self.selection:set(instances)
end

function Hierarchy:isOneOf(instance: Instance, classNames: { string }): boolean
	for _, className in classNames do
		if instance:IsA(className) then
			return true
		end
	end

	return false
end

function Hierarchy:canDrop(item: Instance, target): boolean
	local organizer = self.asset:getOrganizer()
	local destination = target.instance

	if item == destination or self.asset:isBase(item) then
		return false
	end

	if target.isFolder then
		return organizer ~= nil and organizer:canMoveInto(item, destination)
	end

	if self:isFolder(item) or self.asset:isBase(destination) or destination:IsDescendantOf(item) or item.Parent == destination then
		return false
	end

	if destination:IsA("Model") then
		return self:isOneOf(item, Hierarchy.modelChildren)
	elseif destination:IsA("BasePart") then
		return self:isOneOf(item, Hierarchy.partChildren)
	elseif destination:IsA("Attachment") then
		return self:isOneOf(item, Hierarchy.pointChildren)
	end

	return false
end

function Hierarchy:getDragItems(entry): { Instance }
	if entry.isFolder or not entry.selected then
		return { entry.instance }
	end

	local items = self:getEditableRoots()

	return if #items > 0 then items else { entry.instance }
end

function Hierarchy:beginDrag(entry, point: Vector2)
	if self.renaming or self.filter ~= "" or self.selection:isPicking() or self.asset:isBase(entry.instance) then
		return
	end

	self.drag = { entry = entry, start = point, active = false, target = nil, items = nil, ghost = nil }
end

function Hierarchy:getEntryAt(point: Vector2)
	local listPosition = self.list.AbsolutePosition
	local listSize = self.list.AbsoluteSize

	if point.Y < listPosition.Y or point.Y > listPosition.Y + listSize.Y or point.X < listPosition.X or point.X > listPosition.X + listSize.X then
		return nil, false
	end

	for _, entry in self.entries do
		local row = entry.row

		if row then
			local position = row.AbsolutePosition
			local size = row.AbsoluteSize

			if point.Y >= position.Y and point.Y < position.Y + size.Y then
				return entry, true
			end
		end
	end

	return nil, true
end

function Hierarchy:canDropAny(items: { Instance }, target): boolean
	for _, item in items do
		if self:canDrop(item, target) then
			return true
		end
	end

	return false
end

function Hierarchy:updateDrag(point: Vector2)
	local drag = self.drag

	if not drag.active then
		if (point - drag.start).Magnitude < Hierarchy.dragThreshold then
			return
		end

		drag.active = true
		drag.items = self:getDragItems(drag.entry)
		drag.ghost = self.ghostTemplate:Clone()
		drag.ghost.Text = if #drag.items == 1 then drag.items[1].Name else string.format("%d objects", #drag.items)
		drag.ghost.Parent = self.context.root
	end

	local scale = self.context.getScale()
	local origin = self.context.root.AbsolutePosition
	local offset = Hierarchy.dragOffset

	drag.ghost.Position = UDim2.fromOffset((point.X - origin.X) / scale + offset.X, (point.Y - origin.Y) / scale + offset.Y)

	local hovered = self:getEntryAt(point)
	local target = if hovered and self:canDropAny(drag.items, hovered) then hovered else nil

	if target ~= drag.target then
		local previous = drag.target

		drag.target = target

		if previous then
			self:styleRow(previous)
		end

		if target and target.row then
			target.row:SetAttribute("ThemeBg", "MenuSel")
			target.row.BackgroundColor3 = configuration.Colors.Light
			target.row.BackgroundTransparency = Hierarchy.dropTransparency
		end
	end
end

function Hierarchy:cancelDrag()
	local drag = self.drag

	self.drag = nil

	if drag and drag.ghost then
		drag.ghost:Destroy()
	end

	if drag and drag.target then
		self:styleRow(drag.target)
	end
end

function Hierarchy:moveInto(items: { Instance }, target)
	local organizer = self.asset:getOrganizer()
	local destination = target.instance

	self.context.history:run("Move", function()
		if target.isFolder then
			organizer:moveInto(items, destination)
			return
		end

		for _, item in items do
			if self:canDrop(item, target) then
				local world = if item:IsA("Attachment") then item.WorldCFrame else nil

				if organizer then
					organizer:moveOut({ item })
				end

				item.Parent = destination

				if world then
					(item :: Attachment).WorldCFrame = world
				end
			end
		end
	end)

	self.collapsed[destination] = false
end

function Hierarchy:moveOut(items: { Instance })
	local organizer = self.asset:getOrganizer()
	local effects = self.asset:getEffects()

	self.context.history:run("Move", function()
		for _, item in items do
			if organizer and organizer:getOwner(item) then
				organizer:moveOut({ item })
			elseif effects and item:IsA("PVInstance") and item.Parent ~= effects and not self:isFolder(item) then
				item.Parent = effects
			end
		end
	end)
end

function Hierarchy:finishDrag(point: Vector2)
	local drag = self.drag

	if not drag or not drag.active then
		self.drag = nil
		return
	end

	local hovered, inside = self:getEntryAt(point)
	local target = drag.target
	local items = drag.items

	self:cancelDrag()
	self.suppressUntil = os.clock() + Hierarchy.clickSuppressTime

	if target then
		self:moveInto(items, target)
	elseif inside and not hovered then
		self:moveOut(items)
	else
		return
	end

	self:rebuild()
end

function Hierarchy:onActivated(entry)
	if self.renaming or os.clock() < self.suppressUntil then
		return
	end

	local now = os.clock()
	local isDouble = self.lastClicked == entry.instance and now - self.lastClickTime <= configuration.Create.doubleClickTime
	local picking = self.selection:isPicking()

	if isDouble and not picking then
		self.lastClickTime = 0
		self:beginRename(entry)
		return
	end

	if not picking and self:isModifierDown(Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift) then
		self:selectRange(entry)
		self.lastClickTime = 0
		return
	end

	self.lastClickTime = now
	self.lastClicked = entry.instance

	if not picking and self:isModifierDown(Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl) then
		local current = self.selection:get()
		local members = self:resolve(entry)
		local removing = entry.selected

		for _, member in members do
			local index = table.find(current, member)

			if removing and index then
				table.remove(current, index)
			elseif not removing and not index then
				table.insert(current, member)
			end
		end

		self.selection:set(current)
		return
	end

	self.selection:set(self:resolve(entry))
end

function Hierarchy:canRename(entry): boolean
	return not self.asset:isBase(entry.instance)
end

function Hierarchy:beginRename(entry)
	self:endRename(false)

	local row = entry.row

	if not row or not self:canRename(entry) then
		return
	end

	local box = row.Rename

	box.Text = entry.instance.Name
	box.Visible = true
	row.Label.Visible = false
	self.renaming = { entry = entry, box = box }

	self.renaming.connection = box.FocusLost:Connect(function(enterPressed)
		self:endRename(enterPressed)
	end)

	box:CaptureFocus()
	box.SelectionStart = 1
	box.CursorPosition = #box.Text + 1
end

function Hierarchy:endRename(apply: boolean)
	local renaming = self.renaming

	if not renaming then
		return
	end

	self.renaming = nil
	renaming.connection:Disconnect()

	local entry = renaming.entry
	local box = renaming.box
	local text = string.gsub(box.Text, "^%s*(.-)%s*$", "%1")

	if box.Parent then
		box.Visible = false
		box:ReleaseFocus(false)
	end

	if entry.row and entry.row.Parent then
		entry.row.Label.Visible = true
	end

	if apply and text ~= "" and entry.instance.Parent and text ~= entry.instance.Name then
		self.context.history:run("Rename", function()
			entry.instance.Name = text
		end)
	end
end

function Hierarchy:toggleHidden(entry)
	local hideManager = self.context.hideManager
	local hide = not self:isEntryHidden(entry)

	for _, instance in self:resolve(entry) do
		if hide then
			hideManager:hide(instance)
		else
			hideManager:show(instance)
		end
	end

	self:restyle()
end

function Hierarchy:getEditableRoots(): { Instance }
	local roots = {}

	for _, instance in self.selection:getRoots() do
		if self.asset:isEditable(instance) then
			table.insert(roots, instance)
		end
	end

	return roots
end

function Hierarchy:groupSelection()
	local organizer = self.asset:getOrganizer()
	local roots = self:getEditableRoots()

	if not organizer or #roots == 0 then
		self.context.notify("Select the objects to put in a folder first.")
		return
	end

	local record = self.context.history:run("Group", function()
		return organizer:createFolder(roots, { name = Hierarchy.folderName })
	end)

	self:rebuild()

	local entry = record and self.entryByInstance[record]

	if entry then
		self:beginRename(entry)
	end
end

function Hierarchy:ungroup(record: Instance)
	local organizer = self.asset:getOrganizer()

	if not organizer then
		return
	end

	self.context.history:run("Ungroup", function()
		organizer:ungroup(record)
	end)

	self:rebuild()
end

function Hierarchy:wrapInModel()
	local roots = {}

	for _, instance in self:getEditableRoots() do
		if instance:IsA("PVInstance") then
			table.insert(roots, instance)
		end
	end

	if #roots == 0 then
		self.context.notify("Select parts or models to group into a model.")
		return
	end

	local model = self.context.history:run("Group As Model", function()
		local group = Instance.new("Model")

		group.Name = Hierarchy.modelName
		group.Parent = roots[1].Parent

		for _, instance in roots do
			instance.Parent = group
		end

		return group
	end)

	if model then
		self.selection:set({ model })
	end
end

function Hierarchy:duplicateSelection()
	local organizer = self.asset:getOrganizer()
	local roots = self:getEditableRoots()

	if #roots == 0 then
		return
	end

	local clones = self.context.history:run("Duplicate", function()
		local created = {}

		for _, instance in roots do
			local clone = instance:Clone()

			clone.Parent = instance.Parent
			table.insert(created, clone)

			local owner = organizer and organizer:getOwner(instance)

			if owner then
				organizer:moveInto({ clone }, owner)
			end
		end

		return created
	end)

	if clones then
		self.selection:set(clones)
	end
end

function Hierarchy:deleteSelection()
	local roots = self:getEditableRoots()

	if #roots == 0 then
		return
	end

	self.context.history:run("Delete", function()
		for _, instance in roots do
			instance.Parent = nil
		end
	end)

	self.selection:set({})
end

function Hierarchy:selectChildren(entry)
	local instances = {}

	for _, root in self:resolve(entry) do
		for _, child in self:getChildren(root) do
			table.insert(instances, child)
		end
	end

	if #instances > 0 then
		self.collapsed[entry.instance] = false
		self.selection:set(instances)
		self:rebuild()
	end
end

function Hierarchy:getPinTargets(entry): { Instance }
	local targets = {}

	for _, instance in if entry.selected then self:getEditableRoots() else { entry.instance } do
		if instance.Parent and not self.asset:isBase(instance) then
			table.insert(targets, instance)
		end
	end

	if #targets == 0 then
		table.insert(targets, entry.instance)
	end

	return targets
end

function Hierarchy:togglePinned(targets: { Instance })
	if not PremiumGate.get():request(pinner.feature) then
		return
	end

	self.context.history:run("Pin", function()
		pinner.toggle(targets)
	end)

	self:rebuild()
end

function Hierarchy:openContextMenu(entry)
	if not entry.selected then
		self.selection:set(self:resolve(entry))
	end

	local items = {}

	if self:canRename(entry) then
		table.insert(items, {
			text = "Rename",
			callback = function()
				local current = self.entryByInstance[entry.instance]

				if current then
					self:beginRename(current)
				end
			end,
		})
	end

	table.insert(items, {
		text = "Duplicate",
		callback = function()
			self:duplicateSelection()
		end,
	})

	table.insert(items, {
		text = "Delete",
		callback = function()
			self:deleteSelection()
		end,
	})

	table.insert(items, { separator = true })

	table.insert(items, {
		text = "Group In Folder",
		icon = "folder",
		callback = function()
			self:groupSelection()
		end,
	})

	if entry.isFolder then
		table.insert(items, {
			text = "Ungroup Folder",
			callback = function()
				self:ungroup(entry.instance)
			end,
		})
	end

	table.insert(items, {
		text = "Group As Model",
		icon = "Model",
		callback = function()
			self:wrapInModel()
		end,
	})

	if not self.asset:isBase(entry.instance) then
		local targets = self:getPinTargets(entry)

		table.insert(items, {
			text = pinner.getLabel(targets),
			callback = function()
				self:togglePinned(targets)
			end,
		})
	end

	table.insert(items, { separator = true })

	if entry.hasChildren then
		table.insert(items, {
			text = "Select Children",
			callback = function()
				self:selectChildren(entry)
			end,
		})
	end

	table.insert(items, {
		text = "Frame In View",
		callback = function()
			self.context.frameSelection()
		end,
	})

	self.context.menu:open({
		position = userInputService:GetMouseLocation(),
		items = items,
		width = 160,
		search = false,
	})
end

function Hierarchy:getListParent(instance: Instance): Instance?
	local organizer = self.asset:getOrganizer()

	return if organizer then organizer:getListParent(instance) else instance.Parent
end

function Hierarchy:reveal(instance: Instance)
	local effects = self.asset:getEffects()

	if not effects or not instance:IsDescendantOf(effects) or self.filter ~= "" then
		return
	end

	local changed = false
	local current = self:getListParent(instance)
	local guard = 0

	while current and current ~= effects and guard < 64 do
		if not self:isExpanded(current, #self:getChildren(current)) then
			self.collapsed[current] = false
			changed = true
		end

		current = self:getListParent(current)
		guard += 1
	end

	if changed then
		self:rebuild()
	end

	local entry = self.entryByInstance[instance]

	if not entry then
		return
	end

	local rowHeight = configuration.Create.rowHeight
	local top = (entry.index - 1) * rowHeight
	local scale = self.context.getScale()
	local window = self.list.AbsoluteWindowSize.Y / scale

	if window <= 0 then
		window = Hierarchy.fallbackHeight
	end

	local canvas = self.list.CanvasPosition

	if top < canvas.Y then
		self.list.CanvasPosition = Vector2.new(canvas.X, top)
	elseif top + rowHeight > canvas.Y + window then
		self.list.CanvasPosition = Vector2.new(canvas.X, top + rowHeight - window)
	end
end

function Hierarchy:onSelectionChanged(instances: { Instance })
	if not self.active then
		return
	end

	local first = instances[1]

	if first and self.asset:isOpen() then
		self:reveal(first)
	end

	self:restyle()
end

function Hierarchy:clearProjects()
	for _, connection in self.projectConnections do
		connection:Disconnect()
	end

	table.clear(self.projectConnections)

	for _, row in self.projectRows do
		row:Destroy()
	end

	table.clear(self.projectRows)
end

function Hierarchy:refreshProjects()
	self:clearProjects()

	local projects = self.asset:listProjects()

	self.startPage.ProjectsTitle.Visible = #projects > 0

	for index, project in projects do
		local row = self.projectTemplate:Clone()

		row.LayoutOrder = index
		row.Label.Text = project.Name
		self.context.icons:apply(row.Icon, "project")
		row.Parent = self.startPage.Projects
		table.insert(self.projectRows, row)

		table.insert(self.projectConnections, row.Activated:Connect(function()
			self.context.openProject(project)
		end))
	end
end

function Hierarchy:destroy()
	self:stop()
	self:clearRows()
	self:clearProjects()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
end

return Hierarchy
]]></ProtectedString>
							<string name="ScriptGuid">{A03A7053-64A6-4C76-85FC-1D51AF2A1158}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Hierarchy</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX18850CC191DA4D4BB0E266B857969AF0">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)
local valueCodec = require(script.Parent.Parent.Utility.valueCodec)
local Form = require(script.Parent.Form)
local PropertyFavorites = require(script.Parent.Parent.Utility.PropertyFavorites)
local PremiumGate = require(script.Parent.Parent.Premium.PremiumGate)

local userInputService = require(script.Parent.Parent.Utility.inputHub)

local Inspector = {}
Inspector.__index = Inspector

Inspector.componentKinds = {
	Vector3 = { "X", "Y", "Z" },
	Vector2 = { "X", "Y" },
	NumberRange = { "Min", "Max" },
}

Inspector.signedSequences = {
	Squash = true,
}

Inspector.hiddenPreviews = {
	MeshId = true,
	SoundId = true,
}

Inspector.textureTip = "Paste an asset id, or click the preview square to pick one of Roblox's built-in textures."
Inspector.emptyText = "Select something in the hierarchy or the viewport to edit it."
Inspector.unsupportedText = "The selection has nothing Create can edit."
Inspector.favoritePrefix = "Favorite."
Inspector.favoriteMenuWidth = 190

function Inspector.new(page: Frame, templates: Instance, context)
	local self = setmetatable({}, Inspector)

	self.page = page
	self.header = page.Header
	self.search = page.Search
	self.empty = page.Empty
	self.context = context
	self.access = context.access
	self.history = context.history
	self.form = Form.new(page.List, templates, context)
	self.targets = {}
	self.providers = {}
	self.actions = {}
	self.watchConnections = {}
	self.connections = {}
	self.subscriptions = {}
	self.favorites = PropertyFavorites.get()
	self.editing = false
	self.pendingRefresh = false
	self.pendingRebuild = false
	self.active = false

	self:bind()

	return self
end

function Inspector:bind()
	table.insert(self.connections, self.search:GetPropertyChangedSignal("Text"):Connect(function()
		self.form:setFilter(self.search.Text)
	end))

	table.insert(self.connections, self.header.NameBox.FocusLost:Connect(function(enterPressed)
		self:renameTargets(self.header.NameBox.Text, enterPressed)
	end))
end

function Inspector:addSectionProvider(provider)
	table.insert(self.providers, provider)
end

function Inspector:setAction(name: string, action)
	self.actions[name] = action
end

function Inspector:subscribe()
	if #self.subscriptions > 0 then
		return
	end

	self.favorites = PropertyFavorites.get()

	table.insert(self.subscriptions, self.favorites:onChanged(function()
		self:scheduleRebuild()
	end))

	local unlocked = self.favorites:isUnlocked()

	table.insert(self.subscriptions, PremiumGate.get():onChanged(function()
		local current = self.favorites:isUnlocked()

		if current ~= unlocked then
			unlocked = current
			self:scheduleRebuild()
		end
	end))
end

function Inspector:unsubscribe()
	for _, disconnect in self.subscriptions do
		disconnect()
	end

	table.clear(self.subscriptions)
end

function Inspector:openFavoriteMenu(name: string)
	self.context.menu:open({
		position = userInputService:GetMouseLocation(),
		items = {
			{
				text = self.favorites:getLabel(name),
				callback = function()
					self.favorites:request(name)
				end,
			},
		},
		width = Inspector.favoriteMenuWidth,
		search = false,
	})
end

function Inspector:start()
	self.active = true
	self:subscribe()
	self:setSelection(self.context.selection:get())
end

function Inspector:stop()
	self.active = false
	self:unsubscribe()
	self:finishEdit()
	self:unwatch()
	self.form:clear()
	table.clear(self.targets)
end

function Inspector:getTargets(): { Instance }
	return self.targets
end

function Inspector:isSupported(instance: Instance): boolean
	if #self.access:getSections(instance) > 0 then
		return true
	end

	for _, provider in self.providers do
		if provider:handles(instance) then
			return true
		end
	end

	return false
end

function Inspector:isSameTargets(instances: { Instance }): boolean
	if #instances ~= #self.targets then
		return false
	end

	for index, instance in instances do
		if self.targets[index] ~= instance then
			return false
		end
	end

	return true
end

function Inspector:setSelection(instances: { Instance })
	if not self.active then
		return
	end

	local supported = {}

	for _, instance in instances do
		if instance.Parent and self:isSupported(instance) then
			table.insert(supported, instance)
		end
	end

	self.selectionCount = #instances

	if self:isSameTargets(supported) and #supported > 0 then
		self.form:refresh()
		return
	end

	self:finishEdit()
	self.targets = supported
	self:watch()
	self:rebuild()
end

function Inspector:unwatch()
	for _, connection in self.watchConnections do
		connection:Disconnect()
	end

	table.clear(self.watchConnections)
end

function Inspector:getSignature(target: Instance): string
	local parts = {}

	for _, provider in self.providers do
		if provider.getSignature then
			table.insert(parts, provider:getSignature(target))
		end
	end

	return table.concat(parts, "|")
end

function Inspector:watch()
	self:unwatch()

	for index, target in self.targets do
		if index > configuration.Create.maxWatched then
			break
		end

		table.insert(self.watchConnections, target.Changed:Connect(function(property)
			if property == "Name" then
				self:updateHeader()
			end

			self:scheduleRefresh()
		end))

		local generatorAttribute = configuration.Create.generatorAttribute
		local generated = target:GetAttribute(generatorAttribute) ~= nil
		local signature = self:getSignature(target)

		table.insert(self.watchConnections, target.AttributeChanged:Connect(function(attribute)
			local present = target:GetAttribute(generatorAttribute) ~= nil
			local current = self:getSignature(target)

			if (attribute == generatorAttribute and present ~= generated) or current ~= signature then
				generated = present
				signature = current
				self:scheduleRebuild()
			else
				self:scheduleRefresh()
			end
		end))

		local mover = target

		if target:IsA("Model") then
			mover = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
		end

		if mover and (mover:IsA("BasePart") or mover:IsA("Attachment")) then
			table.insert(self.watchConnections, mover:GetPropertyChangedSignal("CFrame"):Connect(function()
				self:scheduleRefresh()
			end))
		end
	end
end

function Inspector:scheduleRefresh()
	if self.pendingRefresh then
		return
	end

	self.pendingRefresh = true

	task.defer(function()
		self.pendingRefresh = false

		if self.active and not self.pendingRebuild then
			self.form:refresh()
		end
	end)
end

function Inspector:scheduleRebuild()
	if self.pendingRebuild then
		return
	end

	self.pendingRebuild = true

	task.defer(function()
		self.pendingRebuild = false

		if self.active then
			self:rebuild()
		end
	end)
end

function Inspector:getAliveTargets(): { Instance }
	local alive = {}

	for _, target in self.targets do
		if target.Parent then
			table.insert(alive, target)
		end
	end

	return alive
end

function Inspector:readShared(name: string)
	local targets = self.targets
	local first = targets[1]

	if not first then
		return false
	end

	local success, value = self.access:read(first, name)

	if not success then
		return false
	end

	local kind = typeof(value)
	local mixed = false
	local values = nil

	for index = 2, #targets do
		local otherSuccess, other = self.access:read(targets[index], name)

		if not otherSuccess then
			return false
		end

		local otherKind = typeof(other)

		if otherKind ~= kind and not ((kind == "nil" and otherKind == "Instance") or (kind == "Instance" and otherKind == "nil")) then
			return false
		end

		if not self.access:equals(value, other) then
			mixed = true
			values = values or { value }
			table.insert(values, other)
		end
	end

	local parts = nil
	local components = Inspector.componentKinds[kind]

	if mixed and components and values then
		parts = {}

		for _, component in components do
			for _, other in values do
				if math.abs(other[component] - value[component]) > self.access.tolerance then
					parts[component] = true
					break
				end
			end
		end
	end

	return true, value, mixed, parts
end

function Inspector:finishEdit()
	if self.editing then
		self.editing = false
		self.editingProperty = nil
		self.history:finish()
	end
end

function Inspector:apply(name: string, value, final: boolean, component: string?)
	if self.editing and self.editingProperty ~= name then
		self:finishEdit()
	end
	if not self.editing then
		self.editing = true
		self.editingProperty = name
		if name == "MeshId" then
			self.history:begin("Edit " .. self.access:getLabel(name))
		else
			self.history:beginProperties("Edit " .. self.access:getLabel(name), self.access, self.targets, { name })
		end
	end

	for _, target in self.targets do
		if target.Parent then
			local applied = value

			if component and value ~= nil then
				local success, current = self.access:read(target, name)

				if success and current ~= nil then
					applied = self.access:withComponent(current, component, value[component])
				end
			end

			self.access:write(target, name, applied)
		end
	end

	if final then
		self:finishEdit()
	end
end

function Inspector:createDescriptor(name: string, favorite: boolean?)
	local shared, value, mixed, parts = self:readShared(name)

	if not shared then
		return nil
	end

	local kind = self.access:getKind(name, value)

	if not kind then
		return nil
	end

	local meta = self.access:getMeta(name) or {}
	local ranges = configuration.PropertyRanges
	local settings = self.context.settings

	local descriptor = {
		id = if favorite then Inspector.favoritePrefix .. name else name,
		label = if favorite then self.access:getLabel(name) else self.favorites:decorate(name, self.access:getLabel(name)),
		onLabelMenu = function()
			self:openFavoriteMenu(name)
		end,
		kind = kind,
		value = value,
		mixed = mixed,
		parts = parts,
		range = ranges.ranges[name],
		integer = meta.integer == true or ranges.integers[name] == true,
		className = meta.className,
		graphMaximum = configuration.Create.Schema.sequenceMaximums[name],
		signed = Inspector.signedSequences[name],
		preview = not Inspector.hiddenPreviews[name],
		tip = configuration.Create.Schema.tips[name],
		read = function()
			local _, current, currentMixed, currentParts = self:readShared(name)

			return current, currentMixed, currentParts
		end,
		onChange = function(changed, final, component)
			self:apply(name, changed, final, component)
		end,
	}

	if meta.increment and settings then
		descriptor.getStep = function()
			return settings:getIncrement(meta.increment)
		end
	end

	if kind == "instance" then
		descriptor.accepts = function(instance: Instance)
			return table.find(self.targets, instance) == nil
		end
	end

	if kind == "asset" and descriptor.preview then
		descriptor.tip = Inspector.textureTip
		descriptor.onPreview = function(anchor: GuiObject)
			self:openTextureMenu(name, anchor)
		end
	end

	if kind == "text" and typeof(value) ~= "string" then
		local sample = value

		descriptor.format = valueCodec.format
		descriptor.parse = function(text: string)
			return valueCodec.parse(text, sample)
		end
	end

	return descriptor
end

function Inspector:openTextureMenu(name: string, anchor: GuiObject)
	local items = { { text = "Built-in Textures", disabled = true } }

	for _, texture in configuration.Create.Blocks.textureList do
		table.insert(items, {
			text = texture.label,
			image = texture.image,
			callback = function()
				self:apply(name, texture.image, true)
			end,
		})
	end

	self.context.menu:toggle({ anchor = anchor, items = items, width = 160, search = false })
end

function Inspector:getAction(name: string?)
	local action = name and self.actions[name]

	if not action then
		return nil
	end

	return {
		text = action.text,
		tip = action.tip,
		callback = function(button)
			action.callback(self:getAliveTargets(), button)
		end,
	}
end

function Inspector:isHiddenProperty(name: string): boolean
	for _, provider in self.providers do
		if provider.hidesProperty then
			for _, target in self.targets do
				if provider:hidesProperty(target, name) then
					return true
				end
			end
		end
	end

	return false
end

function Inspector:buildSections()
	local sections = {}
	local first = self.targets[1]

	if not first then
		return sections
	end

	local favorites = {}

	for _, name in self.favorites:list() do
		local descriptor = if self:isHiddenProperty(name) then nil else self:createDescriptor(name, true)

		if descriptor then
			table.insert(favorites, descriptor)
		end
	end

	if #favorites > 0 then
		table.insert(sections, {
			title = PropertyFavorites.sectionTitle,
			key = "Inspect.Favorites",
			fields = favorites,
		})
	end

	local trailing = {}

	for _, provider in self.providers do
		for _, section in provider:getSections(self.targets) do
			table.insert(if section.after then trailing else sections, section)
		end
	end

	for _, section in self.access:getSections(first) do
		local fields = {}

		for _, name in section.properties do
			local descriptor = if self:isHiddenProperty(name) then nil else self:createDescriptor(name)

			if descriptor then
				table.insert(fields, descriptor)
			end
		end

		if #fields > 0 then
			table.insert(sections, {
				title = section.title,
				key = "Inspect." .. section.title,
				collapsed = section.collapsed,
				action = self:getAction(section.action),
				fields = fields,
			})
		end
	end

	for _, section in trailing do
		table.insert(sections, section)
	end

	return sections
end

function Inspector:isSameClass(): boolean
	local className = self.targets[1].ClassName

	for _, target in self.targets do
		if target.ClassName ~= className then
			return false
		end
	end

	return true
end

function Inspector:updateHeader()
	local count = #self.targets
	local header = self.header
	local nameBox = header.NameBox

	if count == 0 then
		return
	end

	local first = self.targets[1]

	if count == 1 then
		self.context.icons:applyInstance(header.Icon, first)
		header.Class.Text = first.ClassName

		if not nameBox:IsFocused() then
			nameBox.Text = first.Name
		end

		nameBox.PlaceholderText = ""

		return
	end

	local sameClass = self:isSameClass()

	if sameClass then
		self.context.icons:applyInstance(header.Icon, first)
		header.Class.Text = first.ClassName
	else
		self.context.icons:apply(header.Icon, "mixed")
		header.Class.Text = "Mixed"
	end

	if not nameBox:IsFocused() then
		nameBox.Text = ""
	end

	nameBox.PlaceholderText = string.format("%d objects", count)
end

function Inspector:renameTargets(text: string, apply: boolean)
	local trimmed = string.gsub(text, "^%s*(.-)%s*$", "%1")
	local targets = self:getAliveTargets()

	if not apply or trimmed == "" or #targets == 0 then
		self:updateHeader()
		return
	end

	self.history:run("Rename", function()
		for _, target in targets do
			if not (self.context.asset and self.context.asset:isBase(target)) then
				target.Name = trimmed
			end
		end
	end)

	self:updateHeader()
end

function Inspector:rebuild()
	local hasTargets = #self.targets > 0

	self.header.Visible = hasTargets
	self.search.Visible = hasTargets
	self.page.List.Visible = hasTargets
	self.empty.Visible = not hasTargets
	self.empty.Text = if (self.selectionCount or 0) > 0 then Inspector.unsupportedText else Inspector.emptyText

	if not hasTargets then
		self.form:clear()
		return
	end

	self:updateHeader()
	self.form:setSections(self:buildSections())
end

function Inspector:refresh()
	self.form:refresh()
end

function Inspector:destroy()
	self:stop()
	self.form:destroy()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
end

return Inspector
]]></ProtectedString>
							<string name="ScriptGuid">{61AAEFE6-DBA1-4C1E-86F3-9768A5E07760}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Inspector</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
