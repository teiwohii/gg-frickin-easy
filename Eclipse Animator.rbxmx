						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local soundCue = require(script.Parent.soundCue)

local SoundClock = {}
SoundClock.__index = SoundClock

SoundClock.jumpThreshold = 0.5

function SoundClock.new()
	local self = setmetatable({}, SoundClock)

	self.targetProvider = nil
	self.eventsProvider = nil
	self.playingProvider = nil
	self.player = nil
	self.tracks = {}
	self.active = {}
	self.dirty = true
	self.lastTarget = nil
	self.connection = nil

	return self
end

function SoundClock:setTargetProvider(provider: () -> number)
	self.targetProvider = provider
end

function SoundClock:setEventsProvider(provider: () -> { any })
	self.eventsProvider = provider
end

function SoundClock:setPlayingProvider(provider: (() -> boolean)?)
	self.playingProvider = provider
end

function SoundClock:setPlayer(player)
	self.player = player
end

function SoundClock:invalidate()
	self.dirty = true
end

function SoundClock:isRunning(): boolean
	return self.connection ~= nil
end

function SoundClock:isSounding(host: Instance): boolean
	return self.active[host] ~= nil
end

function SoundClock:start()
	self:stop()
	self.dirty = true

	self.connection = runService.Heartbeat:Connect(function()
		self:update()
	end)
end

function SoundClock:silence(host: Instance)
	if not self.active[host] then
		return
	end

	self.active[host] = nil

	if self.player then
		self.player.stop(host)
	end
end

function SoundClock:silenceAll()
	local hosts = {}

	for host in self.active do
		table.insert(hosts, host)
	end

	for _, host in hosts do
		self:silence(host)
	end
end

function SoundClock:rebuild()
	local tracks = {}

	for _, event in if self.eventsProvider then self.eventsProvider() else {} do
		local host = event.host

		if soundCue.isPlayable(host) then
			local track = tracks[host]

			if not track then
				track = {}
				tracks[host] = track
			end

			table.insert(track, { start = event.start, stretch = event.stretch })
		end
	end

	for _, track in tracks do
		table.sort(track, function(a, b)
			return a.start < b.start
		end)
	end

	for host in self.active do
		if not tracks[host] then
			self:silence(host)
		end
	end

	local player = self.player

	for host in self.tracks do
		if not tracks[host] and player and player.release then
			player.release(host)
		end
	end

	for host in tracks do
		if player and player.prepare then
			player.prepare(host)
		end
	end

	self.tracks = tracks
	self.lastTarget = nil
end

function SoundClock:getActive(host: Instance, track, target: number)
	for index = #track, 1, -1 do
		local event = track[index]

		if event.start <= target then
			local sound = host :: Sound

			if soundCue.isOpen(sound, event.stretch) or target < event.start + soundCue.getLength(sound, event.stretch) then
				return event
			end

			return nil
		end
	end

	return nil
end

function SoundClock:update()
	local target = if self.targetProvider then self.targetProvider() else 0
	local playing = self.playingProvider == nil or self.playingProvider()

	if self.dirty then
		self.dirty = false
		self:rebuild()
	end

	local last = self.lastTarget
	local jumped = last == nil or target < last or target - last > SoundClock.jumpThreshold

	self.lastTarget = target

	for host, track in self.tracks do
		local event = if playing and host.Parent then self:getActive(host, track, target) else nil

		if not event then
			self:silence(host)
		elseif self.active[host] ~= event or jumped then
			self.active[host] = event

			if self.player then
				self.player.play(host, soundCue.getOffset(host :: Sound, target - event.start))
			end
		elseif self.player and self.player.sync then
			self.player.sync(host)
		end
	end
end

function SoundClock:getEndTime(): number
	local finish = 0

	for host, track in self.tracks do
		for _, event in track do
			finish = math.max(finish, event.start + soundCue.getLength(host :: Sound, event.stretch))
		end
	end

	return finish
end

function SoundClock:clear()
	self:silenceAll()

	local player = self.player

	for host in self.tracks do
		if player and player.release then
			player.release(host)
		end
	end

	table.clear(self.tracks)
	self.lastTarget = nil
	self.dirty = true
end

function SoundClock:stop()
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end

	self:clear()
end

return SoundClock
]]></ProtectedString>
