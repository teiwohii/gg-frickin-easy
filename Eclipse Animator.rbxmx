							<ProtectedString name="Source"><![CDATA[-- riftkuro
return function(require)
	local configModule = require("../Helpers/AfterimageConfig")
	local visual = require("../Helpers/AfterimageVisual")
	local geometryModule = require("./Geometry")
	local Afterimages = {}
	Afterimages.__index = Afterimages

	function Afterimages.new()
		return setmetatable(
			{ rows = {}, assets = {}, meshes = {}, connections = {}, foreign = {}, own = {} },
			Afterimages
		)
	end

	function Afterimages:destroy()
		self.destroyed = true
		for _, connection in self.connections do
			connection:Disconnect()
		end
		table.clear(self.connections)
		for _, row in self.rows do
			for _, slot in row.slots do
				slot.model:Destroy()
			end
		end
		for _, object in self.assets do
			object:Destroy()
		end
		for _, state in self.meshes do
			state.mesh:Destroy()
		end
		if self.root then
			self.root:Destroy()
		end
		table.clear(self.rows)
		table.clear(self.assets)
		table.clear(self.meshes)
	end

	function Afterimages:hide()
		for _, row in self.rows do
			for _, slot in row.slots do
				if slot.model.Parent then
					slot.model.Parent = nil
				end
			end
		end
	end

	function Afterimages:bind(objects)
		assert(not self.destroyed, "Afterimage runtime was destroyed")
		for _, row in self.rows do
			row.object = assert(objects[row.target], "Missing afterimage track")
		end
	end

	function Afterimages:prepare(package, data, objects, current)
		local yieldedAt = os.clock()
		local function check()
			current()
			assert(not self.destroyed, "Afterimage preparation cancelled")
		end
		check()
		self.root = Instance.new("Folder")
		self.root.Name = "EclipseCutsceneAfterimages"
		self.root.Archivable = false
		self.root.Parent = workspace
		local folder =
			assert(package:FindFirstChild("AfterimageAssets"), "Missing afterimage assets")
		for _, original in folder:GetChildren() do
			check()
			local copy = Instance.fromExisting(original)
			self.assets[original.Name] = copy
			local geometry = data.Geometry[original.Name]
			if geometry then
				local state = geometryModule.create(copy, geometry)
				 
				local ok, issue = pcall(check)
				if not ok then
					state.mesh:Destroy()
					error(issue, 0)
				end
				table.insert(self.meshes, state)
			end
		end
		for _, baked in data.Effects do
			check()
			local row = {
				target = baked.Target,
				object = assert(objects[baked.Target], "Missing afterimage track"),
				slots = {},
				poses = {},
			}
			table.insert(self.rows, row)
			local plan = { rows = {} }
			for _, node in baked.Nodes do
				table.insert(
					plan.rows,
					{ prototype = assert(self.assets[node.Asset]), parent = node.Parent }
				)
			end
			for _, saved in baked.Poses do
				local pose = { rows = saved.Rows, meshes = {}, moving = saved.Moving }
				for index, id in saved.Meshes do
					pose.meshes[index] = { prototype = assert(self.assets[id]) }
				end
				table.insert(row.poses, pose)
			end
			local config = configModule.normalize(baked.Settings)
			local capacity = math.min(
				#row.poses,
				config.MaxVisible,
				math.ceil((config.HoldFrames + config.FadeFrames) / config.IntervalFrames)
			)
			for _ = 1, capacity do
				local slot = visual.slot(plan)
				self.own[slot.highlight] = true
				table.insert(row.slots, slot)
				if os.clock() - yieldedAt >= 0.004 then
					task.wait()
					yieldedAt = os.clock()
				end
				check()
			end
		end
		local function added(object)
			if object:IsA("Highlight") and not self.own[object] then
				self.foreign[object] = true
			end
		end
		for _, object in game:GetDescendants() do
			added(object)
		end
		table.insert(self.connections, game.DescendantAdded:Connect(added))
		table.insert(
			self.connections,
			game.DescendantRemoving:Connect(function(object)
				self.foreign[object] = nil
			end)
		)
	end

	function Afterimages:step(frame)
		if self.destroyed then
			return
		end
		local budget, requested = configModule.MAX_VISIBLE, 0
		for object in self.foreign do
			if object:IsDescendantOf(game) then
				budget -= 1
			end
		end
		for _, row in self.rows do
			row.config = configModule.read(row.object)
			 
			 
			row.config.Amount = math.min(row.config.Amount, #row.poses)
			row.wanted = #configModule.visible(row.config, frame, row.poses, nil, #row.slots)
			row.grant = 0
			requested += row.wanted
		end
		if requested > configModule.WARNING_COUNT and not self.warned then
			self.warned = true
			warn("[Eclipse Afterimage] More than 20 afterimages at once may cause lag.")
		end
		while budget > 0 do
			local allocated = false
			for _, row in self.rows do
				if row.grant < row.wanted and budget > 0 then
					row.grant += 1
					budget -= 1
					allocated = true
				end
			end
			if not allocated then
				break
			end
		end
		for _, row in self.rows do
			local limit = row.grant
			if row.grant > 0 and row.grant == row.wanted then
				limit = nil
			end
			row.visible = configModule.visible(row.config, frame, row.poses, limit, #row.slots)
			local used = {}
			for _, emission in row.visible do
				used[emission.slot] = true
			end
			for index, slot in row.slots do
				if not used[index] then
					slot.model.Parent = nil
				end
			end
		end
		for _, row in self.rows do
			for _, emission in row.visible do
				local slot = row.slots[emission.slot]
				if slot.birth ~= emission.index then
					visual.apply(slot, row.poses[emission.index], emission.index)
				end
				local color, opacity =
					configModule.color(row.config, emission.index, emission.birth, frame - emission.birth)
				visual.paint(slot, row.config, emission.alpha * (opacity or 1), color)
				if slot.model.Parent ~= self.root then
					slot.model.Parent = self.root
				end
			end
		end
	end

	return Afterimages
end
]]></ProtectedString>
