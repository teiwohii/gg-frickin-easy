					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
 
local require = require(script:FindFirstAncestor("container").requireModule)
local configModule = require("afterimageConfig")
local binding = require("afterimageBinding")
local visual = require("afterimageGeometry")
local export = {}

function export.build(state, rigs, ids, root, current, lastFrame)
	local assets = Instance.new("Folder")
	assets.Name = "AfterimageAssets"
	assets.Parent = root
	local result = { Effects = {}, Geometry = {} }
	local assetIds, serial = {}, 0
	local yieldedAt = os.clock()
	local function asset(object, geometry)
		serial += 1
		local copy = Instance.fromExisting(object)
		copy.Name = tostring(serial)
		copy.Archivable = true
		copy.Parent = assets
		if geometry then
			result.Geometry[copy.Name] = geometry
		end
		return copy.Name
	end

	for _, model in rigs do
		if
			not binding.is(model)
			or not ids[model]
			or not require("organization").isEnabled(model)
		then
			continue
		end
		current()
		local target = binding.target(model)
		local owner = target and binding.owner(target, rigs)
		assert(owner, "Afterimage source is missing: " .. model.Name)
		local config = configModule.read(model)
		local plan = visual.plan(owner, target)
		local poses = {}
		local row = { Target = ids[model], Nodes = {}, Poses = {}, Settings = config }
		local ok, issue = xpcall(function()
			for _, node in plan.rows do
				table.insert(row.Nodes, { Asset = asset(node.prototype), Parent = node.parent })
			end
			for index = 1, config.Amount do
				if configModule.birth(config, index) > lastFrame then
					break
				end
				current()
				 
				local pose = require("afterimageSampler").capture(
					state,
					plan,
					configModule.birth(config, index),
					true
				)
				table.insert(poses, pose)
				if pose.moving then
					visual.finishPose(pose)
				end
				local meshes = {}
				for nodeIndex, entry in pose.moving and pose.meshes or {} do
					local id = assetIds[entry]
					if not id then
						id = asset(
							entry.prototype,
							entry.editable and require("meshData").capture(entry.editable)
						)
						assetIds[entry] = id
					end
					meshes[nodeIndex] = id
				end
				table.insert(row.Poses, { Rows = pose.rows, Meshes = meshes, Moving = pose.moving })
				if os.clock() - yieldedAt >= 0.004 then
					task.wait()
					yieldedAt = os.clock()
				end
				current()
			end
			table.insert(result.Effects, row)
		end, debug.traceback)
		for _, pose in poses do
			visual.destroyPose(pose)
		end
		visual.destroyPlan(plan)
		assert(ok, issue)
	end
	return result
end

return export
]]></ProtectedString>
