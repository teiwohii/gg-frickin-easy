								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local spatial = require(script.Parent.Parent.spatial)
local Tool = require(script.Parent.Tool)

local LinearTool = Tool.extend()

LinearTool.id = "Linear"
LinearTool.title = "Linear Array"
LinearTool.keywords = "line row array duplicate copies step directional"
LinearTool.groupName = "Linear Array"
LinearTool.maximumCount = 128

function LinearTool.new(context)
	local self = setmetatable({}, LinearTool)

	Tool.init(self, context, {
		Count = 5,
		Offset = Vector3.new(2, 0, 0),
		Rotation = Vector3.zero,
		ScaleStep = 1,
		Local = true,
		Group = true,
	})

	return self
end

function LinearTool:getFields()
	return {
		self:field("Count", "Count", "number", { integer = true, minimum = 2, maximum = LinearTool.maximumCount, clamp = true, range = { min = 2, max = 32 } }),
		self:field("Offset", "Step", "vector3", { tip = "Studs between one copy and the next." }),
		self:field("Rotation", "Turn Per Copy", "vector3", { tip = "Degrees added to each copy. Combine with a local step for curves and spirals." }),
		self:field("ScaleStep", "Scale Per Copy", "number", { minimum = 0.05, range = { min = 0.5, max = 1.5 }, tip = "1 keeps every copy the same size. 0.9 shrinks each one by 10%." }),
		self:field("Local", "Local Step", "toggle", { tip = "On moves along each copy's own axes. Off uses the world axes." }),
		self:field("Group", "Group Result", "toggle"),
		self:action("Apply", "Create Linear Array", function()
			self:apply()
		end, nil, true),
	}
end

function LinearTool:build(root: Instance, created: { Instance })
	local params = self.params
	local pivot = spatial.getPivot(root)

	if not pivot then
		return
	end

	local count = math.clamp(math.round(params.Count), 2, LinearTool.maximumCount)
	local turn = CFrame.fromOrientation(math.rad(params.Rotation.X), math.rad(params.Rotation.Y), math.rad(params.Rotation.Z))
	local parent = root.Parent
	local container = parent

	if params.Group and root:IsA("PVInstance") then
		local group = Instance.new("Model")

		group.Name = LinearTool.groupName
		group.WorldPivot = pivot
		group.Parent = parent
		container = group
		root.Parent = group
		table.insert(created, group)
	else
		table.insert(created, root)
	end

	local current = pivot
	local scale = 1

	for _ = 2, count do
		local copy = root:Clone()

		if params.Local then
			current = current * CFrame.new(params.Offset) * turn
		else
			current = (turn * current.Rotation) + (current.Position + params.Offset)
		end

		scale *= params.ScaleStep
		copy.Parent = container
		spatial.setPivot(copy, current)
		spatial.scale(copy, scale, current.Position)

		if container == parent then
			table.insert(created, copy)
		end
	end
end

function LinearTool:apply()
	local roots = self:requireRoots(true)

	if not roots then
		return
	end

	local created = self:run("Linear Array", function()
		local results = {}

		for _, root in roots do
			self:build(root, results)
		end

		return results
	end)

	if created and #created > 0 then
		self.selection:set(created)
	end
end

return LinearTool
]]></ProtectedString>
								<string name="ScriptGuid">{38B70A26-DAA6-4A92-AD41-50D8A3E961A2}</string>
