					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

type Matrix = { number }
local m = {}
local orders = { XYZ = true, XZY = true, YXZ = true, YZX = true, ZXY = true, ZYX = true }
m.axes = { Vector3.xAxis, Vector3.yAxis, Vector3.zAxis }

local function finite(value)
	return type(value) == "number" and value > -math.huge and value < math.huge
end

function m.identity(): Matrix
	local result = table.create(16, 0)
	for index = 1, 16, 5 do result[index] = 1 end
	return result
end

function m.isFinite(value)
	if type(value) ~= "table" then return false end
	for index = 1, 12 do
		if not finite(value[index]) then return false end
	end
	return true
end

function m.isFiniteVector(value)
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end

function m.isFiniteCFrame(value)
	if typeof(value) ~= "CFrame" then return false end
	for _, component in { value:GetComponents() } do
		if not finite(component) then return false end
	end
	return true
end

function m.isRigidCFrame(value)
	if not m.isFiniteCFrame(value) then return false end
	local axes = { value.XVector, value.YVector, value.ZVector }
	for i = 1, 3 do
		for j = i, 3 do
			if math.abs(axes[i]:Dot(axes[j]) - (i == j and 1 or 0)) >= 0.001 then return false end
		end
	end
	return axes[1]:Cross(axes[2]):Dot(axes[3]) > 0.999
end

function m.fromCFrame(value): Matrix
	local components = { value:GetComponents() }
	local result = m.identity()
	for row = 1, 3 do
		result[row * 4] = components[row]
		for column = 1, 3 do result[(row - 1) * 4 + column] = components[row * 3 + column] end
	end
	return result
end

local function unpackMatrix(value, strict)
	if typeof(value) == "CFrame" then
		assert(not strict or m.isFiniteCFrame(value), "The transform has invalid coordinates.")
		return m.fromCFrame(value)
	end
	assert(not strict or type(value) == "table", "A transform matrix is required.")
	local result = m.identity()
	if type(value) == "table" then
		for index = 1, 16 do
			local row, column = math.ceil(index / 4), (index - 1) % 4 + 1
			local component = type(value[row]) == "table" and value[row][column] or value[index]
			if strict and (index <= 12 or component ~= nil) then
				assert(finite(component), "The transform has an invalid matrix entry.")
			end
			if finite(component) and (strict or math.abs(component) < 1e30) then result[index] = component end
		end
	end
	return result
end

function m.read(value) return unpackMatrix(value, false) end
function m.readStrict(value) return unpackMatrix(value, true) end
function m.position(value) return Vector3.new(value[4], value[8], value[12]) end
function m.column(value, column) return Vector3.new(value[column], value[column + 4], value[column + 8]) end

function m.withPosition(value, position)
	local result = table.clone(value)
	result[4], result[8], result[12] = position.X, position.Y, position.Z
	return result
end

function m.translation(position) return m.withPosition(m.identity(), position) end

function m.mul(left, right): Matrix
	local result = m.identity()
	for row = 0, 2 do
		for column = 1, 4 do
			local value = column == 4 and left[row * 4 + 4] or 0
			for inner = 0, 2 do value += left[row * 4 + inner + 1] * right[inner * 4 + column] end
			result[row * 4 + column] = value
		end
	end
	return result
end

function m.inverse(value): Matrix
	assert(m.isFinite(value), "Cannot invert a transform with invalid coordinates.")
	local rows = {}
	for row = 1, 3 do
		rows[row] = {}
		for column = 1, 3 do
			rows[row][column] = value[(row - 1) * 4 + column]
			rows[row][column + 3] = row == column and 1 or 0
		end
	end
	for column = 1, 3 do
		local pivot = column
		for row = column + 1, 3 do
			if math.abs(rows[row][column]) > math.abs(rows[pivot][column]) then pivot = row end
		end
		rows[pivot], rows[column] = rows[column], rows[pivot]
		local divisor = rows[column][column]
		assert(math.abs(divisor) > 1e-12, "Cannot invert a collapsed transform.")
		for entry = 1, 6 do rows[column][entry] /= divisor end
		for row = 1, 3 do
			if row ~= column then
				local factor = rows[row][column]
				for entry = 1, 6 do rows[row][entry] -= factor * rows[column][entry] end
			end
		end
	end
	local result = m.identity()
	for row = 1, 3 do
		local position = 0
		for column = 1, 3 do
			local component = rows[row][column + 3]
			result[(row - 1) * 4 + column] = component
			position -= component * value[column * 4]
		end
		result[row * 4] = position
	end
	return result
end

function m.vector(value, vector)
	local coordinates, result = { vector.X, vector.Y, vector.Z }, {}
	for row = 0, 2 do
		local sum = 0
		for column = 1, 3 do sum += value[row * 4 + column] * coordinates[column] end
		result[row + 1] = sum
	end
	return Vector3.new(table.unpack(result))
end

function m.point(value, point) return m.vector(value, point) + m.position(value) end

function m.scale(value)
	local a, b, c = m.column(value, 1), m.column(value, 2), m.column(value, 3)
	local direction = a:Cross(b):Dot(c) < 0 and -1 or 1
	return Vector3.new(a.Magnitude, b.Magnitude, c.Magnitude) * direction
end

local function closestRotation(value)
	assert(m.isFinite(value), "The transform has invalid coordinates.")
	local scale = m.scale(value)
	if math.min(math.abs(scale.X), math.abs(scale.Y), math.abs(scale.Z)) < 1e-10 then return CFrame.identity end
	local x, y, z = m.column(value, 1) / scale.X, m.column(value, 2) / scale.Y, m.column(value, 3) / scale.Z
	if math.max(math.abs(x:Dot(y)), math.abs(x:Dot(z)), math.abs(y:Dot(z))) < 1e-7 then
		return CFrame.fromMatrix(Vector3.zero, x, y, z):Orthonormalize()
	end
	local a = table.clone(value)
	local magnitude = 0
	for row = 0, 2 do
		for column = 1, 3 do magnitude = math.max(magnitude, math.abs(a[row * 4 + column])) end
	end
	local sign = scale.X < 0 and -1 or 1
	for row = 0, 2 do
		for column = 1, 3 do a[row * 4 + column] *= sign / magnitude end
	end
	local xx, yy, zz = a[1], a[6], a[11]
	local k = {
		{ xx - yy - zz, a[2] + a[5], a[3] + a[9], a[10] - a[7] },
		{ a[2] + a[5], yy - xx - zz, a[7] + a[10], a[3] - a[9] },
		{ a[3] + a[9], a[7] + a[10], zz - xx - yy, a[5] - a[2] },
		{ a[10] - a[7], a[3] - a[9], a[5] - a[2], xx + yy + zz },
	}
	local vectors = {}
	for row = 1, 4 do vectors[row] = table.create(4, 0); vectors[row][row] = 1 end
	for _ = 1, 48 do
		local p, q, largest = 1, 2, 0
		for row = 1, 3 do
			for column = row + 1, 4 do
				if math.abs(k[row][column]) > largest then p, q, largest = row, column, math.abs(k[row][column]) end
			end
		end
		if largest < 1e-13 then break end
		local angle = math.atan2(2 * k[p][q], k[q][q] - k[p][p]) * 0.5
		local c, s = math.cos(angle), math.sin(angle)
		for row = 1, 4 do
			local x, y = k[row][p], k[row][q]
			k[row][p], k[row][q] = c * x - s * y, s * x + c * y
			local vx, vy = vectors[row][p], vectors[row][q]
			vectors[row][p], vectors[row][q] = c * vx - s * vy, s * vx + c * vy
		end
		for column = 1, 4 do
			local x, y = k[p][column], k[q][column]
			k[p][column], k[q][column] = c * x - s * y, s * x + c * y
		end
	end
	local index = 1
	for column = 2, 4 do if k[column][column] > k[index][index] then index = column end end
	return CFrame.new(0, 0, 0, vectors[1][index], vectors[2][index], vectors[3][index], vectors[4][index])
end

function m.toCFrame(value) return CFrame.new(m.position(value)) * closestRotation(value) end
function m.toCFrameAndRotation(value)
	local rotation = closestRotation(value)
	return CFrame.new(m.position(value)) * rotation, m.fromCFrame(rotation)
end

function m.compose(frame, scale)
	local result, components = m.fromCFrame(frame), { scale.X, scale.Y, scale.Z }
	for index = 1, 12 do
		local column = (index - 1) % 4 + 1
		if column < 4 then result[index] *= components[column] end
	end
	return result
end

function m.normalized(value) return m.fromCFrame(m.toCFrame(value)) end
function m.normalizedColumns(value)
	local result = table.clone(value)
	for column = 1, 3 do
		local length = m.column(value, column).Magnitude
		if length > 1e-15 then
			for row = 0, 2 do result[row * 4 + column] /= length end
		end
	end
	return result
end

function m.orthogonalizedY(value, normalize)
	local x, y, z = m.column(value, 1), m.column(value, 2), m.column(value, 3)
	local yLength = y.Magnitude
	if yLength > 0 then
		local direction = y / yLength
		x -= direction * x:Dot(direction)
		z -= direction * z:Dot(direction)
	end
	local xLength, zLength = x.Magnitude, z.Magnitude
	local nx, nz = xLength > 0 and x / xLength or Vector3.zero, zLength > 0 and z / zLength or Vector3.zero
	local sum, difference = nx + nz, nx - nz
	local area = nx:Cross(nz).Magnitude
	if sum.Magnitude > 1e-6 and difference.Magnitude > 1e-6 then
		local diagonal, opposite = sum.Unit, difference.Unit
		nx, nz = (diagonal + opposite) / math.sqrt(2), (diagonal - opposite) / math.sqrt(2)
	end
	if normalize == false then
		x, z = nx * xLength * math.sqrt(area), nz * zLength * math.sqrt(area)
	else
		x, z = nx, nz
		if yLength > 0 then y /= yLength end
	end
	local result = table.clone(value)
	for column, vector in { x, y, z } do
		result[column], result[column + 4], result[column + 8] = vector.X, vector.Y, vector.Z
	end
	return result
end

function m.lerp(left, right, alpha)
	if alpha <= 0 then return left end
	if alpha >= 1 then return right end
	local a, b = closestRotation(left), closestRotation(right)
	local stretchA = m.mul(m.fromCFrame(a:Inverse()), left)
	local stretchB = m.mul(m.fromCFrame(b:Inverse()), right)
	local stretch = m.identity()
	for row = 0, 2 do
		for column = 1, 3 do
			local index = row * 4 + column
			stretch[index] = stretchA[index] * (1 - alpha) + stretchB[index] * alpha
		end
	end
	return m.withPosition(m.mul(m.fromCFrame(a:Lerp(b, alpha)), stretch), m.position(left):Lerp(m.position(right), alpha))
end

function m.translationScaled(value, scale) return m.withPosition(value, m.position(value) * scale) end
function m.error(left, right)
	local difference = 0
	for index = 1, 12 do difference = math.max(difference, math.abs(left[index] - right[index])) end
	return difference
end

function m.euler(frame, order)
	local mode = orders[order] and order or "XYZ"
	return Vector3.new(frame:ToEulerAngles(Enum.RotationOrder[mode:reverse()]))
end

function m.fromEuler(angles, order)
	local mode = orders[order] and order or "XYZ"
	return CFrame.fromEulerAngles(angles.X, angles.Y, angles.Z, Enum.RotationOrder[mode:reverse()])
end

function m.blenderAffineEuler(value, order)
	local mode = orders[order] and order or "XYZ"
	local angles = m.euler(closestRotation(value), mode)
	local components = { angles.X, angles.Y, angles.Z }
	local axes = { X = 1, Y = 2, Z = 3 }
	local middle = axes[mode:sub(2, 2)]
	local alternative = {}
	for axis = 1, 3 do
		local angle = axis == middle and math.pi - components[axis] or components[axis] + math.pi
		alternative[axis] = (angle + math.pi) % (2 * math.pi) - math.pi
	end
	if math.abs(alternative[1]) + math.abs(alternative[2]) + math.abs(alternative[3]) < math.abs(angles.X) + math.abs(angles.Y) + math.abs(angles.Z) then
		angles = Vector3.new(table.unpack(alternative))
	end
	return angles, Vector3.new(m.column(value, 1).Magnitude, m.column(value, 2).Magnitude, m.column(value, 3).Magnitude)
end

return m
]]></ProtectedString>
