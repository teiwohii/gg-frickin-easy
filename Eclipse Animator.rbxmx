						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local PremiumGate = require(script.Parent.Parent.Premium.PremiumGate)

local pinner = {}
pinner.__index = pinner

pinner.attribute = "ArcPinned"
pinner.feature = "pinner"
pinner.markName = "PinMark"
pinner.markWidth = 3
pinner.labels = {
	pin = "Pin to Top",
	unpin = "Unpin",
}
pinner.messages = {
	pinned = "Pinned %d item(s) to the top of the list.",
	unpinned = "Unpinned %d item(s).",
	nothing = "Select what you want to pin first.",
}

function pinner.isUnlocked(): boolean
	return PremiumGate.get():isUnlocked(pinner.feature)
end

function pinner.isPinned(instance: Instance): boolean
	return instance:GetAttribute(pinner.attribute) == true
end

function pinner.isShown(instance: Instance): boolean
	return pinner.isPinned(instance) and pinner.isUnlocked()
end

function pinner.getLabel(instances: { Instance }): string
	local text = if pinner.shouldPin(instances) or not pinner.isUnlocked() then pinner.labels.pin else pinner.labels.unpin

	return PremiumGate.get():label(pinner.feature, text)
end

function pinner.shouldPin(instances: { Instance }): boolean
	for _, instance in instances do
		if not pinner.isPinned(instance) then
			return true
		end
	end

	return false
end

function pinner.arrange(children: { Instance }, isFixed: ((Instance) -> boolean)?): { Instance }
	if not pinner.isUnlocked() then
		return children
	end

	local fixed = {}
	local pinned = {}
	local rest = {}

	for _, child in children do
		if isFixed and isFixed(child) then
			table.insert(fixed, child)
		elseif pinner.isPinned(child) then
			table.insert(pinned, child)
		else
			table.insert(rest, child)
		end
	end

	if #pinned == 0 then
		return children
	end

	table.move(pinned, 1, #pinned, #fixed + 1, fixed)
	table.move(rest, 1, #rest, #fixed + 1, fixed)

	return fixed
end

function pinner.set(instances: { Instance }, pinned: boolean): number
	local changed = 0

	for _, instance in instances do
		if instance.Parent and pinner.isPinned(instance) ~= pinned then
			instance:SetAttribute(pinner.attribute, if pinned then true else nil)
			changed += 1
		end
	end

	return changed
end

function pinner.toggle(instances: { Instance }): (boolean, number)
	local pin = pinner.shouldPin(instances)

	return pin, pinner.set(instances, pin)
end

function pinner.describe(pinned: boolean, count: number): string
	return string.format(if pinned then pinner.messages.pinned else pinner.messages.unpinned, count)
end

return pinner
]]></ProtectedString>
