						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro



local require = require(script:FindFirstAncestor("container").requireModule)



local http = game:GetService("HttpService")

local policy = require("policy")

local dataModule = require("chunkStore")

local r6Controls = require("r6Controls")

local masterControl = require("masterControl")

local physics = require("simulationCache")

local storage = {}

local mainState = require("state")



local function checkpoint()

	if mainState.ProjectWorkStep then

		mainState.ProjectWorkStep()

	end

end



local nameValue = "EclipseKeyframeData"

local retained = setmetatable({}, { __mode = "k" })

local rawKept = setmetatable({}, { __mode = "k" })

local loadIssues = {}



function storage.noteIssue(kind, detail)

	table.insert(loadIssues, { kind = kind, detail = tostring(detail) })

	warn("[Eclipse] " .. tostring(detail))

end



function storage.loadIssues()

	return loadIssues

end



function storage.clearIssues()

	loadIssues = {}

end



function storage.keepRaw(rig, instance, reason)

	if typeof(instance) ~= "Instance" or typeof(rig) ~= "Instance" then

		return

	end



	local kept = rawKept[rig] or {}

	rawKept[rig] = kept

	for _, existing in kept do

		if

			existing.Name == instance.Name

			and existing:GetAttribute("EclipseUnreadableSource") == instance:GetDebugId()

		then

			return

		end

	end



	local copy = instance:Clone()

	copy:SetAttribute("EclipseUnreadableReason", tostring(reason))

	copy:SetAttribute("EclipseUnreadableSource", instance:GetDebugId())

	table.insert(kept, copy)

end



function storage.rawCount(rig)

	local count = 0

	for owner, kept in rawKept do

		if not rig or owner == rig then

			count += #kept

		end

	end



	return count

end



function storage.writeRaw(sequence, rig)

	local kept = rawKept[rig]

	if not kept or #kept == 0 then

		return

	end



	local folder = Instance.new("Folder")

	folder.Name = "EclipseUnreadable"

	for _, copy in kept do

		copy:Clone().Parent = folder

		checkpoint()

	end



	folder.Parent = sequence

end

local omitted = {

	Motor = true,

	Part = true,

	Button = true,

	SanitizeName = true,

	_EclipseRawStored = true,

	_EclipseRawChannels = true,

}



local function encode(value, seen)

	local kind = typeof(value)

	if kind == "CFrame" then

		return { C = { value:GetComponents() } }

	elseif kind == "Vector3" then

		return { V = { value.X, value.Y, value.Z } }

	elseif kind == "EnumItem" then

		return { E = { (tostring(value.EnumType):gsub("Enum%.", "")), value.Name } }

	elseif kind == "number" then

		assert(value == value and math.abs(value) < math.huge, "Non-finite keyframe value")

		return value

	elseif kind == "string" or kind == "boolean" then

		return value

	elseif kind == "table" then

		seen = seen or {}

		if seen[value] then

			return nil

		end



		seen[value] = true

		local pose = typeof(value.C0) == "CFrame" and value.C0 or nil

		local derived = false

		local flat = {}

		local keys = {}

		for key in value do

			if not omitted[key] and (typeof(key) == "string" or typeof(key) == "number") then

				table.insert(keys, key)

			end

		end



		table.sort(keys, function(a, b)

			local kindA, kindB = type(a), type(b)

			if kindA ~= kindB then

				return kindA == "number"

			end



			return a < b

		end)

		for _, key in keys do

			local item = value[key]

			if

				pose

				and (

					(key == "Position" and item == pose.Position)

					or (key == "Rotation" and item == pose.Rotation)

				)

			then

				derived = true

				continue

			end



			local encoded = encode(item, seen)

			if encoded ~= nil then

				table.insert(flat, key)

				table.insert(flat, encoded)

			end

		end



		if derived then

			table.insert(flat, "_EclipseDerivedPose")

			table.insert(flat, true)

		end



		seen[value] = nil

		return { T = flat }

	end



	return nil

end



local function decode(value, budget)

	if typeof(value) ~= "table" then

		return value

	end



	if value.T then

		local flat, out = value.T, {}

		for index = 1, #flat, 2 do

			out[flat[index]] = decode(flat[index + 1], budget)

			if budget then

				budget()

			end

		end



		if out._EclipseDerivedPose then

			out._EclipseDerivedPose = nil

			if typeof(out.C0) == "CFrame" then

				if out.Position == nil then

					out.Position = out.C0.Position

				end



				if out.Rotation == nil then

					out.Rotation = out.C0.Rotation

				end

			end

		end



		return out

	elseif value.C then

		return CFrame.new(table.unpack(value.C))

	elseif value.V then

		return Vector3.new(table.unpack(value.V))

	elseif value.E then

		return Enum[value.E[1]][value.E[2]]

	end



	if value.type == "CFrame" then

		return CFrame.new(table.unpack(value.value))

	elseif value.type == "Vector3" then

		return Vector3.new(table.unpack(value.value))

	elseif value.type == "Enum" then

		return Enum[value.enum][value.value]

	elseif value.type == "Table" then

		local out = {}

		for _, entry in value.entries do

			out[entry.key] = decode(entry.value, budget)

			if budget then

				budget()

			end

		end



		return out

	end



	error("Invalid keyframe encoding")

end



local function ordinalOf(parent, part, ordinals)

	local known = ordinals and ordinals[parent]

	if known then

		return known[part] or 0

	end



	local found = {}

	local counts = {}

	for _, child in parent:GetChildren() do

		local class = child.ClassName

		local names = counts[class]

		if not names then

			names = {}

			counts[class] = names

		end



		local count = (names[child.Name] or 0) + 1

		names[child.Name] = count

		found[child] = count

	end



	if ordinals then

		ordinals[parent] = found

	end



	return found[part] or 0

end



local function pathOf(part, rig, bindings)

	if typeof(part) ~= "Instance" then

		return nil

	end



	if part ~= rig and not part:IsDescendantOf(rig) then

		return require("trackOrganizationStorage").bindingPath(rig, part, bindings)

	end



	local ordinals = bindings and bindings.ordinals

	local path = {}

	while part ~= rig do

		local parent = part.Parent

		table.insert(path, 1, {

			name = part.Name,

			class = part.ClassName,

			index = ordinalOf(parent, part, ordinals),

		})

		part = parent

	end



	return path

end



local function resolve(rig, path)

	local part = rig

	for _, step in path do

		if step.link == "Part1" then

			if not part:IsA("Motor6D") or not part.Part1 then

				return nil

			end



			part = part.Part1

			continue

		end



		local count, found = 0, nil

		for _, child in part:GetChildren() do

			if child.Name == step.name and child.ClassName == step.class then

				count += 1

				if count == step.index then

					found = child

					break

				end

			end

		end



		if not found and step.class == "Bone" then

			found = r6Controls.findNamed(part, step.name, step.index)

		end



		if not found then

			return nil

		end



		part = found

	end



	return part

end



local bindingIdValue = "EclipseKeyframeBindingId"



local function bindingId(object, used)

	if not object then

		return nil

	end

	local original = require("rigPreview").original(object) or object

	local id = original:GetAttribute(bindingIdValue) or object:GetAttribute(bindingIdValue)

	if typeof(id) ~= "string" or id == "" or used[id] and used[id] ~= object then

		id = http:GenerateGUID(false)

	end

	if original:GetAttribute(bindingIdValue) ~= id then

		original:SetAttribute(bindingIdValue, id)

	end

	if object:GetAttribute(bindingIdValue) ~= id then

		object:SetAttribute(bindingIdValue, id)

	end

	used[id] = object

	return id

end



local function incomingJoints(part)

	local joints, seen = {}, {}

	if not part:IsA("BasePart") then

		return joints

	end

	local function add(joint)

		if joint:IsA("Motor6D") and joint.Part1 == part and not seen[joint] then

			seen[joint] = true

			table.insert(joints, joint)

		end

	end

	for _, joint in require("rigTraversal").joints(part) do

		add(joint)

	end

	local model = part:FindFirstAncestorOfClass("Model")

	if model then

		for _, joint in require("rigTraversal").rigDescendants(model) do

			add(joint)

		end

	end

	return joints

end



local function claimedIds(data)

	local claimed = {}

	for _, track in data.tracks do

		if typeof(track.partId) == "string" then

			claimed[track.partId] = true

		end

		if typeof(track.jointId) == "string" then

			claimed[track.jointId] = true

		end

	end

	return claimed

end



local function bindingResolver(rig, state, sequence, claimed)

	local ids, seen = {}, {}

	local function add(object)

		if typeof(object) ~= "Instance" or seen[object] then

			return

		end

		seen[object] = true

		if object ~= rig and object.Parent == nil then

			return

		end

		local id = object:GetAttribute(bindingIdValue)

		if typeof(id) == "string" then

			ids[id] = ids[id] == nil and object or false

		end

	end

	add(rig)

	for _, object in require("rigTraversal").rigDescendants(rig) do

		add(object)

	end

	for _, joint in incomingJoints(rig) do

		add(joint)

	end

	for motor in state.DefaultPose do

		if require("membership").belongs(motor, rig) then

			add(motor)

			add(motor.Part0)

			add(motor.Part1)

		end

	end

	local authored = sequence:GetAttribute("EclipseAuthoredRigId")

	local exact = sequence:GetAttribute("EclipseRawRecovery") == true

		or authored ~= nil and authored == rig:GetAttribute("EclipseTrackId")

	return function(path, id)

		if id and ids[id] then

			return ids[id]

		end

		if

			id

			and ids[id] == nil

			and require("cameraRig").isRig(rig)

			and rig:GetAttribute("EclipseCamera") == true

		then

			local generated = {

				CamPart = true,

				FovPart = true,

				CamTarget = true,

				AttachToPart = true,

				RootPart = true,

			}

			local last = path and path[#path]

			local known = last

				and generated[last.name]

				and (#path == 1 or #path == 2 and path[1].name == "RootPart")

			local object = known and resolve(rig, path)

			if

				object

				and object:GetAttribute(bindingIdValue) == nil

				and (object:IsA("BasePart") or object:IsA("Motor6D"))

			then

				object:SetAttribute(bindingIdValue, id)

				ids[id] = object

				return object

			end

		end

		local object = path and resolve(rig, path) or nil

		if id and ids[id] == false then

			return object and object:GetAttribute(bindingIdValue) == id and object or nil

		end

		if id and exact and object then

			local current = object:GetAttribute(bindingIdValue)

			if

				typeof(current) == "string"

				and current ~= id

				and (not claimed or claimed[current])

			then

				return nil

			end

		end

		return object

	end,

		exact

end



local function collect(rig, state, fullArchive)

	local tracks, archived, usedIds = {}, {}, {}

	local incoming = {}

	for _, motor in require("rigTraversal").rigDescendants(rig) do

		if motor:IsA("Motor6D") and motor.Part1 then

			incoming[motor.Part1] = (incoming[motor.Part1] or 0) + 1

		end

	end



	local bindings = { ordinals = {} }

	local limbIk = require("limbIk")

	local hasMaster = masterControl.get(rig, true) ~= nil

	local buckets = state.Keyframes

	if hasMaster or fullArchive then

		buckets = table.clone(buckets)

		for motor in state.DefaultPose do

			if not buckets[motor] then

				buckets[motor] = {}

			end

		end

	end



	local visited = 0

	for motor, bucket in buckets do

		visited += 1

		if visited % 64 == 0 then

			checkpoint()

		end



		if

			typeof(motor) == "table"

			and (motor.IsEclipseArmatureControl or motor.IsEclipseProperty)

		then

			continue

		end



		local path = pathOf(motor.Part1, rig, bindings)

		if not path then

			continue

		end



		checkpoint()

		local jointPath = typeof(motor) == "Instance"

				and motor:IsA("Motor6D")

				and (fullArchive or (incoming[motor.Part1] or 0) > 1)

				and pathOf(motor, rig, bindings)

			or nil

		local rest = (fullArchive or not next(bucket)) and state.DefaultPose[motor]

		local control = typeof(motor) == "table" and motor.IsEclipseR6Control

		local points = limbIk.customPoints(motor)

		local needed = points ~= nil

			or jointPath ~= nil

			or fullArchive

			or control

			or rest

			or hasMaster

			or not policy.channelsEnabled()

		for _, key in bucket do

			if

				key.CamAttachTarget ~= nil

				or key.CamTargetEnabled ~= nil

				or key.CamTrackTo ~= nil

				or key.CamTargetParent ~= nil

				or typeof(key.IK) == "boolean"

				or policy.isDisabled(key)

				or key.ChannelPoseC0

				or key.BlenderCurve

				or key.BlenderSource

				or next(key.KeyGroups or {})

			then

				needed = true

				break

			end

		end



		if not needed then

			for _, key in bucket do

				for _, channel in key.Channels or {} do

					if channel.Easing then

						needed = true

						break

					end

				end



				if needed then

					break

				end

			end

		end



		if needed and (points or rest or hasMaster or next(bucket)) then

			local keys = {}

			local seen = {}

			local encoded = 0

			for frame, key in bucket do

				table.insert(keys, { frame = frame, data = encode(key, seen) })

				encoded += 1

				if encoded % 16 == 0 then

					checkpoint()

				end

			end



			local partId = fullArchive and bindingId(motor.Part1, usedIds) or nil

			local jointId = fullArchive

					and typeof(motor) == "Instance"

					and motor:IsA("Motor6D")

					and bindingId(motor, usedIds)

				or nil

			local descriptor = control

					and {

						kind = motor:GetAttribute("EclipseR6Control"),

						customIK = motor.Owner:GetAttribute("EclipseAutoIK") == true or nil,

						limbPoints = encode(limbIk.customPoints(motor.Owner)),

						customRest = encode(require("customRest").rest(motor.Owner)),

						owner = pathOf(motor.Owner.Part1, rig, bindings),

						rest = encode(state.DefaultPose[motor] or motor.Bone.CFrame),

						attributes = encode(motor:GetAttributes()),

					}

				or nil

			table.insert(tracks, {

				path = path,

				jointPath = jointPath,

				partId = partId,

				jointId = jointId,

				jointC1 = fullArchive

						and typeof(motor) == "Instance"

						and motor:IsA("Motor6D")

						and encode(require("properties").basePose(motor, motor.C1))

					or nil,


				keys = keys,

				rest = rest and encode(rest) or nil,

				world = fullArchive and encode(state.DefaultWorldPose[motor]) or nil,

				parented = if fullArchive then state.ParentingDefaults[motor] else nil,

				size = fullArchive and encode(state.DefaultSize[motor.Part1]) or nil,

				control = descriptor,

				limbPoints = points and encode(points) or nil,

			})

			if not control then

				archived[motor] = true

			end

		end

	end



	return tracks, archived

end



local plans = setmetatable({}, { __mode = "k" })



function storage.plan(rig, state, fullArchive)

	local step = mainState.ProjectWorkStep

	local full = fullArchive and true or false

	local cached = step and plans[rig]

	if

		cached

		and cached.step == step

		and cached.state == state

		and cached.full == full

		and cached.keyframes == state.Keyframes

		and cached.defaults == state.DefaultPose

		and cached.retained == retained[rig]

	then

		return cached.tracks, cached.archived

	end



	local tracks, archived = collect(rig, state, fullArchive)

	if step then

		plans[rig] = {

			step = step,

			state = state,

			full = full,

			keyframes = state.Keyframes,

			defaults = state.DefaultPose,

			retained = retained[rig],

			tracks = tracks,

			archived = archived,

		}

	end



	return tracks, archived

end



local function encodeTracks(tracks)

	local out = { '{"version":2,"quaternionInterpolation":2,"tracks":[' }

	for i, track in tracks do

		if i > 1 then

			table.insert(out, ",")

		end



		local metadata = table.clone(track)

		metadata.keys = nil

		local text = http:JSONEncode(metadata)

		table.insert(out, text:sub(1, -2))

		table.insert(out, ',"keys":[')

		for first = 1, #track.keys, 64 do

			local batch = table.create(math.min(64, #track.keys - first + 1))

			for index = first, math.min(first + 63, #track.keys) do

				table.insert(batch, track.keys[index])

			end



			if first > 1 then

				table.insert(out, ",")

			end



			local encoded = http:JSONEncode(batch)

			table.insert(out, encoded:sub(2, -2))

			checkpoint()

		end



		table.insert(out, "]}")

		checkpoint()

	end



	table.insert(out, "]}")

	return table.concat(out)

end



function storage.write(sequence, rig, state, fullArchive, prepared)

	local planted = rig:GetAttribute("EclipseIKFeetPlanted")

	if planted == nil then

		planted = require("preferences").get("IKFeetPlanted")

	end



	sequence:SetAttribute("EclipseIKFeetPlanted", planted)

	local follow = rig:GetAttribute("EclipseIKLegsFollowTorso")

	if follow == nil then

		follow = require("preferences").get("IKLegsFollowTorso")

	end

	sequence:SetAttribute("EclipseIKLegsFollowTorso", follow)

	sequence:SetAttribute("EclipseIKSettingsVersion", 2)

	sequence:SetAttribute(

		"EclipseR6BendPercent",

		rig:GetAttribute("EclipseR6BendPercent") or require("preferences").get("R6BendPercent")

	)

	local tracks = prepared or storage.plan(rig, state, fullArchive)

	local kept = retained[rig]

	if kept and #kept > 0 then

		local present = {}

		local byPath, byPathJoint = {}, {}

		for index, track in tracks do

			present[storage.trackKey(track)] = index

			if type(track.path) == "table" then

				local pathKey = http:JSONEncode(track.path)

				byPath[pathKey] = byPath[pathKey] or index

				if track.jointPath then

					byPathJoint[http:JSONEncode({ track.path, track.jointPath })] = index

				end

			end

		end



		tracks = table.clone(tracks)

		for _, track in kept do

			local index = present[storage.trackKey(track)]

			if track.partial and not index and type(track.path) == "table" then

				index = track.jointPath

						and byPathJoint[http:JSONEncode({ track.path, track.jointPath })]

					or byPath[http:JSONEncode(track.path)]

			end



			if track.partial and index then

				local target = table.clone(tracks[index])

				target.keys = table.clone(target.keys or {})

				local frames = {}

				for _, record in target.keys do

					frames[record.frame] = true

				end



				for _, record in track.keys or {} do

					if not frames[record.frame] then

						table.insert(target.keys, record)

					end

				end



				tracks[index] = target

				continue

			end



			if not index then

				table.insert(tracks, track)

			elseif #(tracks[index].keys or {}) == 0 then

				tracks[index] = track

			end

		end

	end



	if #tracks > 0 then

		dataModule.write(sequence, nameValue, encodeTracks(tracks))

	end



	if fullArchive then

		storage.writeRaw(sequence, rig)

	end



	local modifierTracks = require("mods").collect(rig, state, pathOf)

	if #modifierTracks > 0 then

		dataModule.write(

			sequence,

			"EclipseCurveModifiers",

			http:JSONEncode({ version = 1, tracks = modifierTracks })

		)

	end



	physics.write(sequence, rig, state, encode, pathOf)

end



local function restorePoints(motor, encoded, rig, ratio)

	if not encoded or typeof(motor) ~= "Instance" or not motor:IsA("Motor6D") then

		return

	end

	local decoded, points = pcall(decode, encoded)

	if

		not decoded

		or typeof(points) ~= "table"

		or typeof(points.a) ~= "Vector3"

		or typeof(points.b) ~= "Vector3"

		or points.a.Magnitude ~= points.a.Magnitude

		or points.b.Magnitude ~= points.b.Magnitude

		or points.a.Magnitude >= math.huge

		or points.b.Magnitude >= math.huge

		or (points.b - points.a).Magnitude < 0.001

	then

		storage.noteIssue(

			"track",

			motor.Name .. ": saved IK points are invalid and were ignored; the keys are kept."

		)

		return

	end



	motor:SetAttribute("EclipseLimbIKPointA", points.a * (ratio or 1))

	motor:SetAttribute("EclipseLimbIKPointB", points.b * (ratio or 1))

	require("limbIk").invalidate(rig)

end



local function restoreControl(rig, track, state, archive, ratio)

	local descriptor = track.control

	local last = track.path[#track.path]

	local kind = descriptor and descriptor.kind

		or last

			and last.class == "Bone"

			and ({ IK = "root", Spine = "spine", UpperTorso = "upper" })[last.name]

	if not kind then

		return nil

	end



	local ownerPath = descriptor and descriptor.owner or table.clone(track.path)

	if not descriptor then

		table.remove(ownerPath)

	end



	local ownerPart = resolve(rig, ownerPath)

	local owner = ownerPart and state.MotorByPart[ownerPart]

	if not owner then

		for candidate in state.DefaultPose do

			if candidate.Part1 == ownerPart then

				owner = candidate

				break

			end

		end

	end



	if not require("customRest").isJoint(owner) then

		return nil

	end



	local bone

	if descriptor then

		if descriptor.customIK == true then

			assert(

				require("customRest").chain(rig, owner, require("parenting").collectMotors(rig)),

				"Saved custom IK chain is no longer connected"

			)

			owner:SetAttribute("EclipseAutoIK", true)

			require("customRest").restoreRest(

				owner,

				descriptor.customRest and decode(descriptor.customRest)

			)

			require("limbIk").invalidate(rig)

		end



		restorePoints(owner, descriptor.limbPoints, rig, ratio)

		bone = r6Controls.ensure(owner, kind, decode(descriptor.rest))

		local attributes = decode(descriptor.attributes) or {}



		bone:SetAttribute("EclipseIKControlSpace", attributes.EclipseIKControlSpace)

		bone:SetAttribute("EclipseIKAnchorOffset", attributes.EclipseIKAnchorOffset)

		for name, value in attributes do

			bone:SetAttribute(name, value)

		end



		if

			descriptor.customIK

			and r6Controls.rigRoot(rig, owner.Part0)

			and not attributes.EclipseIKControlSpace

			and not attributes.EclipseIKAnchorOffset

		then

			bone:SetAttribute("EclipseIKControlSpace", nil)

			local first, offset

			for _, saved in archive and archive.tracks or {} do

				if resolve(rig, saved.path) == ownerPart then

					for _, record in saved.keys do

						local key = decode(record.data)

						if

							key.IKAnchor

							and key.IKRigWorld

							and (not first or record.frame < first)

						then

							first = record.frame

							offset = key.IKRigWorld:ToObjectSpace(key.IKAnchor)

						end

					end

				end

			end



			bone:SetAttribute("EclipseIKAnchorOffset", offset)

		end

	else

		local ik = require("limbIk")

		local chain = ik.chain(rig, owner)

		if not chain or (chain.kind ~= "R6" and chain.kind ~= "Torso") then

			return nil

		end



		ik.prepare(chain)

		bone = r6Controls.find(owner, kind)

	end



	if not bone then

		return nil

	end



	local motor = r6Controls.get(bone)

	if descriptor and descriptor.customIK then

		r6Controls.anchor(owner, kind)

	end



	state.DefaultPose[motor] = descriptor and decode(descriptor.rest) or bone.CFrame

	state.MotorByPart[bone], state.ParentingDefaults[motor] = motor, true

	return bone

end



local function restoreAttachment(rig, data, state)

	if not require("cameraRig").isRig(rig) then

		return

	end



	local partsMotor = require("cameraParts").ensureMotor(rig)

	if partsMotor then

		state.DefaultPose[partsMotor] = state.DefaultPose[partsMotor] or CFrame.identity

		state.MotorByPart[partsMotor.Part1] = partsMotor

		state.ParentingDefaults[partsMotor] = true

	end



	for _, track in data.tracks do

		local last = type(track.path) == "table" and track.path[#track.path]

		if last and last.name == "AttachToPart" then

			for _, record in track.keys or {} do

				local decoded, key = pcall(decode, record.data)

				if decoded and type(key) == "table" and key.CamAttachTarget ~= nil then

					local motor = require("target").ensureAttachment(rig)

					if motor then

						state.DefaultPose[motor] = state.DefaultPose[motor] or CFrame.identity

						state.MotorByPart[motor.Part1] = motor

						state.ParentingDefaults[motor] = true

					end



					return

				end

			end

		end

	end

end



 

 

local function importedJoint(part, motor, exact)

	if motor or exact or not part or not part:IsA("BasePart") then

		return motor

	end

	local selected

	for _, candidate in incomingJoints(part) do

		if candidate.Part0 and candidate.Part1 == part then

			if selected and selected ~= candidate then

				return nil

			end

			selected = candidate

		end

	end

	return selected

end



local function readArchive(source, budget, layered)

	local data = dataModule.decodeArchive(dataModule.read(source), budget, layered == true)

	if type(data) ~= "table" or type(data.tracks) ~= "table" then

		return { version = 2, tracks = {}, salvaged = true, lost = 1, problem = "empty archive" }

	end



	local kept, dropped = {}, 0

	for _, track in data.tracks do

		if type(track) == "table" and type(track.path) == "table" then

			if type(track.keys) ~= "table" then

				track.keys = {}

			end



			table.insert(kept, track)

		else

			dropped += 1

		end

		checkpoint()

	end



	if dropped > 0 then

		data.tracks = kept

		data.salvaged = true

		data.lost = (data.lost or 0) + dropped

		data.problem = data.problem or (dropped .. " tracks have no part path")

	end



	return data

end



local function checkVersion(data, rig)

	local version = tonumber(data.version)

	if version ~= 1 and version ~= 2 then

		storage.noteIssue(

			"version",

			(rig and rig.Name or "?")

				.. ": keyframe archive version "

				.. tostring(data.version)

				.. " is newer than this Eclipse build; it was read as version 2."

		)

	end

end



local function projectOf(sequence)

	local entry = sequence.Parent

	local rigs = entry and entry.Parent

	local save = rigs and rigs.Name == "Rigs" and rigs.Parent

	if save and save:GetAttribute("EclipseSave") == true then

		return save, entry

	end



	return nil, entry

end



function storage.completeSave(folder)

	return typeof(folder) == "Instance"

		and folder:IsA("Folder")

		and folder:FindFirstChild("Rigs") ~= nil

		and folder:GetAttribute("EclipseSaveComplete") ~= false

		and folder:GetAttribute("EclipseSaveInProgress") ~= true

		and folder:GetAttribute("EclipseSavePending") ~= true

end



local function matchingEntry(save, entry)

	local rigs = save and save:FindFirstChild("Rigs")

	if not rigs or not entry then

		return nil

	end



	local id = entry:GetAttribute("RigId")

	local exact, legacy = {}, {}

	for _, other in rigs:GetChildren() do

		local otherId = other:GetAttribute("RigId")

		if typeof(id) == "string" and id ~= "" and otherId == id then

			table.insert(exact, other)

		elseif

			(typeof(id) ~= "string" or id == "" or typeof(otherId) ~= "string" or otherId == "")

			and other.Name == entry.Name

			and other:GetAttribute("RigName") == entry:GetAttribute("RigName")

			and other:GetAttribute("RigClass") == entry:GetAttribute("RigClass")

		then

			table.insert(legacy, other)

		end

	end



	if #exact > 0 then

		return #exact == 1 and exact[1] or nil

	end

	return #legacy == 1 and legacy[1] or nil

end



function storage.fallbackSaves(save)

	local candidates = {}

	local id = save and save:GetAttribute("EclipseProjectId")

	if typeof(id) ~= "string" then

		return candidates

	end



	local root = require("root")

	local okBackups, backups = pcall(root.get, "EclipseAnimator_Backups", false)

	for _, backup in okBackups and backups and backups:GetChildren() or {} do

		if

			backup ~= save

			and backup:GetAttribute("EclipseProjectId") == id

			and storage.completeSave(backup)

		then

			table.insert(candidates, {

				save = backup,

				time = tonumber(backup:GetAttribute("EclipseBackupTime")) or 0,

				label = "the previous version " .. backup.Name .. " from Backups",

			})

		end

	end



	local okRecovery, recovery = pcall(root.get, "EclipseRecovery", false)

	for _, copy in okRecovery and recovery and recovery:GetChildren() or {} do

		local archive = copy:IsA("Folder") and copy:FindFirstChild("Archive")

		if

			archive

			and archive ~= save

			and copy:GetAttribute("Complete") == true

			and copy:GetAttribute("ProjectId") == id

			and archive:FindFirstChild("Rigs")

		then

			table.insert(candidates, {

				save = archive,

				time = tonumber(copy:GetAttribute("Time")) or 0,

				label = "the recovery snapshot "

					.. tostring(copy:GetAttribute("Title") or copy.Name),

			})

		end

	end



	table.sort(candidates, function(a, b)

		return a.time > b.time

	end)

	return candidates

end



function storage.fallbackArchive(sequence, rig, budget, layered, allowExports)

	local save, entry = projectOf(sequence)

	for _, candidate in storage.fallbackSaves(save) do

		checkpoint()

		local other = matchingEntry(candidate.save, entry)

		local animation = other and other:FindFirstChild("Animation")

		local source = animation and animation:FindFirstChild(nameValue)

		if source then

			local ok, data = pcall(readArchive, source, budget, layered)

			if ok and not data.salvaged and #data.tracks > 0 then

				return data, candidate.label

			end

		end

	end



	local animSaves = allowExports and rig and rig:FindFirstChild("AnimSaves")

	local id = save and save:GetAttribute("EclipseProjectId")

	local exactExports, legacyExports = {}, {}

	for _, animation in animSaves and animSaves:GetChildren() or {} do

		checkpoint()

		if animation ~= sequence and animation:IsA("KeyframeSequence") and animation:FindFirstChild(nameValue) then

			local projectId = animation:GetAttribute("EclipseProjectId")

			if id and projectId == id then

				table.insert(exactExports, animation)

			elseif save and not projectId and animation.Name == save.Name then

				table.insert(legacyExports, animation)

			end

		end

	end

	local exports = #exactExports > 0 and exactExports or (#legacyExports == 1 and legacyExports or {})

	for _, animation in exports do

		checkpoint()

		local source = animation:FindFirstChild(nameValue)

		if source then

			local ok, data = pcall(readArchive, source, budget, layered)

			if ok and not data.salvaged and #data.tracks > 0 then

				return data,

					"the exported animation "

						.. animation.Name

						.. " in "

						.. rig.Name

						.. " > AnimSaves"

			end

		end

	end



	return nil

end



function storage.loadArchive(sequence, rig, source, budget, layered)

	local readable, data = pcall(readArchive, source, budget, layered)

	if not readable then

		data = { version = 2, tracks = {}, salvaged = true, lost = 1, problem = tostring(data) }

	end

	if not data.salvaged then

		checkVersion(data, rig)

		return data

	end



	local name = rig and rig.Name or sequence.Name

	storage.keepRaw(rig, source, data.problem)

	local fallback, label =

		storage.fallbackArchive(sequence, rig, budget, layered, #data.tracks == 0)

	if fallback and #data.tracks == 0 then

		storage.noteIssue(

			"fallback",

			name

				.. ": the saved keys could not be read ("

				.. tostring(data.problem)

				.. "); used "

				.. label

				.. " instead. The unreadable data is kept with the project."

		)

		checkVersion(fallback, rig)

		return fallback

	end



	if fallback then

		local present = {}

		for _, track in data.tracks do

			present[storage.trackKey(track)] = true

		end



		local added = 0

		for _, track in fallback.tracks do

			if not present[storage.trackKey(track)] then

				table.insert(data.tracks, track)

				added += 1

			end

		end



		storage.noteIssue(

			"chunk",

			name

				.. ": the saved keys were damaged ("

				.. tostring(data.problem)

				.. "); "

				.. #data.tracks - added

				.. " tracks were recovered from the save and "

				.. added

				.. " from "

				.. label

				.. ". The unreadable data is kept with the project."

		)

	else

		storage.noteIssue(

			"chunk",

			name

				.. ": the saved keys were damaged ("

				.. tostring(data.problem)

				.. "); "

				.. #data.tracks

				.. " tracks were recovered, "

				.. tostring(data.lost)

				.. " could not be read. The unreadable data is kept with the project."

		)

	end



	checkVersion(data, rig)

	return data

end



function storage.prepareRead(sequence, rig, state, budget, layered)

	local stale = sequence:FindFirstChild("EclipseUnreadable")

	if stale then

		for _, child in stale:GetChildren() do

			storage.keepRaw(

				rig,

				child,

				child:GetAttribute("EclipseUnreadableReason") or "unreadable"

			)

		end

	end



	local source = sequence:FindFirstChild(nameValue)

	if not source then

		return nil, {}

	end



	local data = storage.loadArchive(sequence, rig, source, budget, layered)

	restoreAttachment(rig, data, state)

	local motors = {}

	local find, exact = bindingResolver(rig, state, sequence, claimedIds(data))

	for _, track in data.tracks do

		pcall(function()

			local part = find(track.path, track.partId)

			local motor = part and state.MotorByPart[part]

			if track.jointPath or track.jointId then

				motor = find(track.jointPath, track.jointId)

				if not part or not motor or not motor:IsA("Motor6D") or motor.Part1 ~= part then

					motor = nil

				end

				motor = importedJoint(part, motor, exact)

			end



			if not motor and part and not track.jointPath and not track.jointId then

				for candidate in state.DefaultPose do

					if candidate.Part1 == part then

						motor = candidate

						break

					end

				end

			end



			if motor then

				motors[motor] = true

			end

		end)

	end



	return data, motors

end



local function restoreQuaternionVersion(snapshot, samples)

	local ordered = {}

	for _, key in snapshot do

		table.insert(ordered, key)

	end



	table.sort(ordered, function(a, b)

		return a.Time < b.Time

	end)

	local version = 2

	local oldError, newError, count = 0, 0, 0

	local interp = require("interp")



	local function errorSquared(a, b)

		return (a.RightVector - b.RightVector).Magnitude ^ 2

			+ (a.UpVector - b.UpVector).Magnitude ^ 2

			+ (a.LookVector - b.LookVector).Magnitude ^ 2

	end



	for _, sample in samples or {} do

		checkpoint()

		local left, right

		for i = 1, #ordered - 1 do

			if

				sample.time > ordered[i].Time + 1e-5

				and sample.time < ordered[i + 1].Time - 1e-5

			then

				left, right = ordered[i], ordered[i + 1]

				break

			end

		end



		if

			left

			and not left.QuaternionInterpolationVersion

			and interp.usesAutomaticBezier(left, right)

		then

			local alpha = (sample.time - left.Time) / (right.Time - left.Time)

			local modern = interp.cframe(snapshot, left, right, alpha, "C0")

			left.QuaternionInterpolationVersion = 1

			local old = interp.cframe(snapshot, left, right, alpha, "C0")

			left.QuaternionInterpolationVersion = nil

			if modern and old then

				newError += errorSquared(modern, sample.c0)

				oldError += errorSquared(old, sample.c0)

				count += 1

			end

		end

	end



	if count >= 2 and oldError < count * 1e-6 and newError > oldError + count * 1e-5 then

		version = 1

	end



	for _, key in ordered do

		key.QuaternionInterpolationVersion = key.QuaternionInterpolationVersion or version

	end

end



local generatedJoint = {

	"EclipseConstraintProxy",

	"EclipseConstraintBorrowedC0",

	"EclipseCameraAttachment",

	"EclipseCamTarget",

	"EclipsePartRigJoint",

}



local function authoredJoint(rig, motor)

	if

		typeof(motor) ~= "Instance"

		or not motor:IsA("Motor6D")

		or not motor.Archivable

		or not motor.Part1

		or motor.Part1:GetAttribute("EclipseAccessoryControlPart")

		or rig:FindFirstChild("EclipseSourceRig")

		or require("cameraRig").isRig(rig)

	then

		return false

	end



	for _, name in generatedJoint do

		if motor:GetAttribute(name) ~= nil then

			return false

		end

	end



	return true

end



local function restRebase(rig, sequence, track, motor, live)

	if

		not track.rest

		or track.control

		or typeof(live) ~= "CFrame"

		or sequence:GetAttribute("EclipseRawRecovery") == true

		or not authoredJoint(rig, motor)

	then

		return nil

	end



	local poseSpace = require("poseSpace")

	local ratio = poseSpace.savedRatio(rig, sequence)

	local saved = decode(track.rest)

	if

		typeof(saved) ~= "CFrame" or poseSpace.scaleTranslation(saved, ratio):FuzzyEq(live, 1e-4)

	then

		return nil

	end



	for _, record in track.keys or {} do

		local flat = type(record.data) == "table" and record.data.T

		if type(flat) == "table" then

			for index = 1, #flat, 2 do

				if flat[index] == "BlenderCurve" or flat[index] == "BlenderSource" then

					return nil

				end

			end

		end

	end



	return { source = saved, target = poseSpace.scaleTranslation(live, 1 / ratio) }

end



local function rebaseKey(key, rebase, timeline)

	if rebase then

		require("poseSpace").rebaseKey(key, rebase.source, rebase.target, timeline, 1)

	end

end



storage.restRebase = restRebase

storage.rebaseKey = rebaseKey



function storage.read(

