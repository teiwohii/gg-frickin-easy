			<Item class="ModuleScript" referent="RBXB9BF3BB26BC64C99983BAF5E6AFE1338">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- riftkuro

local container = script.Parent
local index

local function build()
	local map = {}
	for _, descendant in container:GetDescendants() do
		if descendant:IsA("ModuleScript") and descendant ~= script then
			if map[descendant.Name] then
				error("Duplicate Eclipse module name: " .. descendant.Name, 0)
			end

			map[descendant.Name] = descendant
		end
	end

	return map
end

local function resolve(target)
	if type(target) ~= "string" then
		assert(
			typeof(target) == "Instance"
				and target:IsA("ModuleScript")
				and target:IsDescendantOf(container),
			"Eclipse requires a bundled ModuleScript"
		)
		return require(target)
	end

	if not index then
		index = build()
	end

	local module = index[target]
	if not module then
		index = build()
		module = index[target]
	end

	if not module then
		error("Unknown Eclipse module: " .. tostring(target), 0)
	end

	return require(module)
end

return resolve
]]></ProtectedString>
