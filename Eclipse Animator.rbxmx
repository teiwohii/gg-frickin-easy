						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local runService = game:GetService("RunService")
local tweenService = game:GetService("TweenService")
local theme = require("theme")
local windowFx = require("windowFx")
local motion = require("motion")
local preferences = require("preferences")
local inputModule = require("userInputService")
local rawState = require("rawState")
local FxLayout = require("FxLayout")

local MiniTimeline = {}
MiniTimeline.__index = MiniTimeline

local defaultSize = Vector2.new(300, 108)
local minimumSize = Vector2.new(160, 80)
local inset = 8
local trackPadding = 10
local rulerHeight = 14
local tickSpacing = 45
local tickSteps = { 1, 2, 5, 10, 15, 30, 60, 120, 300 }
local gripSize = 12
local zoomStep = 0.1
local minimumVisibleFrames = 8
local moveInfo = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local cornerCursor = "rbxasset://SystemCursors/SizeNESW"
local heightCursor = "rbxasset://SystemCursors/SizeNS"
local addWidth = 22
local addGap = 6
local keySize = 16
local keyImage = require("assetIds").KeyframeShapes.Default
local doubleClickTime = 0.32
local dragThreshold = 3

local function make(className, parent, name, props)
	local object = Instance.new(className)
	object.Name = name
	for key, value in props do
		object[key] = value
	end

	object.Parent = parent
	return object
end

local function tag(object, attribute, key)
	object:SetAttribute(attribute, key)
	return object
end

local function round(object, radius)
	make("UICorner", object, "Corner", { CornerRadius = UDim.new(0, radius) })
end

local function outline(object, transparency)
	return tag(
		make("UIStroke", object, "Outline", {
			Color = theme.panelOutlineDefault(),
			Thickness = 1,
			Transparency = transparency or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		"ThemeStrk",
		"Strk"
	)
end

local function tickStep(pixelsPerFrame)
	local raw = tickSpacing / math.max(1e-6, pixelsPerFrame)
	for _, step in tickSteps do
		if step >= raw then
			return step
		end
	end

	return math.ceil(raw / 300) * 300
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
end

local function isPan(input)
	return input.UserInputType == Enum.UserInputType.MouseButton2
		or input.UserInputType == Enum.UserInputType.MouseButton3
end

function MiniTimeline.new(options)
	local self = setmetatable({
		options = options,
		margin = options.margin or 12,
		zIndex = options.zIndex or 90,
		connections = {},
		ticks = {},
		size = options.size or defaultSize,
		preferred = options.size or defaultSize,
		minSize = minimumSize,
		position = Vector2.new(0, options.margin or 12),
		zoom = 1,
		scroll = 0,
		keys = {},
		keyWidgets = {},
		selection = {},
		open = false,
		hidden = false,
		destroyed = false,
	}, MiniTimeline)

	self:build()
	self:bind()
	return self
end

function MiniTimeline:connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

function MiniTimeline:build()
	local z = self.zIndex
	local window = tag(
		make("Frame", nil, "EclipseFXTimeline", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = FxLayout.centered(self.position, self.size),
			Size = UDim2.fromOffset(self.size.X, self.size.Y),
			BackgroundColor3 = Color3.fromRGB(22, 16, 28),
			BorderSizePixel = 0,
			Active = true,
			Visible = false,
			ZIndex = z,
		}),
		"ThemeBg",
		"Bg"
	)
	round(window, 6)
	outline(window)

	self.dragHandle = tag(make("TextButton", window, "DragHandle", {
		Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 0, 24),
		Text = "Effects", Font = Enum.Font.RobotoMono, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
		AutoButtonColor = false, ZIndex = z + 3,
	}), "ThemeTxt", "Txt")
	local track = tag(
		make("Frame", window, "Track", {
			Position = UDim2.fromOffset(inset + addWidth + addGap, inset + 24),
			Size = UDim2.new(1, -inset * 2 - addWidth - addGap, 1, -inset * 2 - 24),
			BackgroundColor3 = Color3.fromRGB(15, 12, 19),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Active = true,
			ZIndex = z + 1,
		}),
		"ThemeBg",
		"Pnl"
	)
	round(track, 5)
	outline(track, 0.35)

	local addButton = tag(
		make("TextButton", window, "AddKey", {
			Position = UDim2.fromOffset(inset, inset + 24),
			Size = UDim2.fromOffset(addWidth, addWidth),
			BackgroundColor3 = Color3.fromRGB(51, 0, 77),
			BorderSizePixel = 0,
			AutoButtonColor = true,
			Text = "+",
			FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold),
			TextSize = 16,
			TextColor3 = Color3.fromRGB(235, 228, 242),
			ZIndex = z + 2,
		}),
		"ThemeBg",
		"TopBtn"
	)
	tag(addButton, "ThemeTxt", "Txt")
	round(addButton, 4)
	outline(addButton, 0.35)

	local keyLayer = make("Frame", track, "Keys", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Active = false,
		ZIndex = z + 4,
	})
	self.addButton = addButton
	self.keyLayer = keyLayer

	local scrubber = tag(
		make("Frame", track, "Scrubber", {
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = Color3.fromRGB(255, 217, 0),
			BorderSizePixel = 0,
			Active = false,
			Interactable = false,
			ZIndex = z + 5,
		}),
		"ThemeBg",
		"Ph"
	)
	round(scrubber, 1)

	local scrollBar = make("Frame", track, "ScrollBar", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, trackPadding, 1, -2),
		Size = UDim2.new(1, -trackPadding * 2, 0, 5),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = z + 6,
	})
	local thumb = tag(
		make("Frame", scrollBar, "Thumb", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = theme.panelOutlineDefault(),
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			Active = true,
			ZIndex = z + 7,
		}),
		"ThemeBg",
		"Strk"
	)
	round(thumb, 3)

	local function grip(name, anchor, position)
		return make("TextButton", window, name, {
			AnchorPoint = anchor,
			Position = position,
			Size = UDim2.fromOffset(gripSize, gripSize),
			Text = "",
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Active = true,
			Selectable = false,
			ZIndex = z + 10,
		})
	end

	self.window = window
	self.track = track
	self.scrubber = scrubber
	self.scrollBar = scrollBar
	self.thumb = thumb
	self.leftGrip = grip("ResizeBottomLeft", Vector2.new(0, 1), UDim2.fromScale(0, 1))
	self.rightGrip = grip("ResizeBottomRight", Vector2.new(1, 1), UDim2.fromScale(1, 1))

	FxLayout.centerTree(window)
	theme.applyTree(window)
	window.Parent = self.options.parent
end

function MiniTimeline:makeTick(index)
	local z = self.zIndex
	local line = make("Frame", self.track, "Header" .. index, {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0, 1, 1, 0),
		BackgroundColor3 = Color3.fromRGB(170, 170, 170),
		BackgroundTransparency = 0.75,
		BorderSizePixel = 0,
		Active = false,
		Interactable = false,
		ZIndex = z + 2,
	})
	local label = tag(
		make("TextLabel", line, "Number", {
			Position = UDim2.fromOffset(3, 1),
			Size = UDim2.fromOffset(40, rulerHeight),
			BackgroundTransparency = 1,
			FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json"),
			TextSize = 10,
			TextColor3 = Color3.fromRGB(150, 150, 150),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Active = false,
			Interactable = false,
			ZIndex = z + 3,
		}),
		"ThemeTxt",
		"Tick"
	)
	tag(line, "ThemeBg", "Tick")
	FxLayout.centerTree(line)
	theme.applyTree(line)
	local entry = { line = line, label = label }
	self.ticks[index] = entry
	return entry
end

function MiniTimeline:scaleFactor()
	return motion.scale(self.track)
end

function MiniTimeline:trackWidth()
	return self.track.AbsoluteSize.X / self:scaleFactor()
end

function MiniTimeline:pointerX()
	return (inputModule:GetMouseLocation().X - self.track.AbsolutePosition.X) / self:scaleFactor()
end

function MiniTimeline:maxFrame()
	return math.max(1, math.floor(rawState.Config.Length * rawState.Timeline.FPS + 0.5))
end

function MiniTimeline:viewWidth()
	return math.max(1, self:trackWidth() - trackPadding * 2)
end

function MiniTimeline:contentWidth()
	return self:viewWidth() * self.zoom
end

function MiniTimeline:maxZoom()
	return math.max(1, self:maxFrame() / minimumVisibleFrames)
end

function MiniTimeline:clampView()
	self.zoom = math.clamp(self.zoom, 1, self:maxZoom())
	self.scroll = math.clamp(self.scroll, 0, math.max(0, self:contentWidth() - self:viewWidth()))
end

function MiniTimeline:frameToX(frame)
	return trackPadding + frame / self:maxFrame() * self:contentWidth() - self.scroll
end

function MiniTimeline:xToFrame(x)
	local frame = (x - trackPadding + self.scroll) / self:contentWidth() * self:maxFrame()
	return math.clamp(math.floor(frame + 0.5), 0, self:maxFrame())
end

function MiniTimeline:currentFrame()
	local timeline = rawState.Timeline
	return math.clamp(math.floor(timeline.CurrentTime * timeline.FPS + 0.5), 0, self:maxFrame())
end

function MiniTimeline:renderTicks()
	local maxFrame = self:maxFrame()
	local content = self:contentWidth()
	local step = tickStep(content / maxFrame)
	local first = math.max(0, math.floor(self.scroll / content * maxFrame / step) * step)
	local last = math.min(
		maxFrame,
		math.ceil((self.scroll + self:viewWidth()) / content * maxFrame / step) * step
	)
	local frames = {}
	for frame = first, last, step do
		if frame == maxFrame or maxFrame - frame >= step * 0.6 then
			table.insert(frames, frame)
		end
	end

	if last == maxFrame and frames[#frames] ~= maxFrame then
		table.insert(frames, maxFrame)
	end

	for index, frame in frames do
		local entry = self.ticks[index] or self:makeTick(index)
		entry.line.Position = UDim2.new(0, self:frameToX(frame), 0.5, 0)
		entry.label.Text = tostring(frame)
		entry.line.Visible = true
	end

	for index = #frames + 1, #self.ticks do
		self.ticks[index].line.Visible = false
	end
end

function MiniTimeline:renderScrollBar()
	local ratio = math.clamp(self:viewWidth() / self:contentWidth(), 0, 1)
	self.scrollBar.Visible = ratio < 0.999
	if not self.scrollBar.Visible then
		return
	end

	local range = math.max(1, self:contentWidth() - self:viewWidth())
	self.thumb.Size = UDim2.fromScale(ratio, 1)
	self.thumb.Position = UDim2.fromScale((1 - ratio) * (self.scroll / range) + ratio / 2, 0.5)
end

function MiniTimeline:followPlayback(frame)
	if not rawState.Timeline.Playing or self.drag then
		return
	end

	local x = self:frameToX(frame)
	if x < trackPadding or x > self:trackWidth() - trackPadding then
		self.scroll = frame / self:maxFrame() * self:contentWidth() - self:viewWidth() * 0.1
		self:clampView()
	end
end

function MiniTimeline:update()
	if self.destroyed or not self.window.Visible or self.track.AbsoluteSize.X <= 0 then
		return
	end

	self:clampView()
	local frame = self:currentFrame()
	self:followPlayback(frame)

	local key = string.format(
		"%d:%.2f:%.4f:%.2f",
		self:maxFrame(),
		self:trackWidth(),
		self.zoom,
		self.scroll
	)
	if key ~= self.layoutKey then
		self.layoutKey = key
		self:renderTicks()
		self:renderScrollBar()
	end

	local x = self:frameToX(frame)
	self.scrubber.Position = UDim2.new(0, x, 0.5, 0)
	self.scrubber.Visible = x >= 0 and x <= self:trackWidth()
	self:renderKeys()
end

function MiniTimeline:setKeys(keys, selection)
	self.keys = keys or {}
	self.selection = selection or {}
	local alive = {}
	for _, key in self.keys do
		alive[key.Id] = true
		if not self.keyWidgets[key.Id] then
			self:makeKey(key.Id)
		end
	end

	for id, widget in self.keyWidgets do
		if not alive[id] then
			widget:Destroy()
			self.keyWidgets[id] = nil
		end
	end

	self:renderKeys()
end

function MiniTimeline:makeKey(id)
	local widget = make("ImageButton", self.keyLayer, "Key", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(keySize, keySize),
		BackgroundTransparency = 1,
		Image = keyImage,
		ScaleType = Enum.ScaleType.Fit,
		AutoButtonColor = false,
		ZIndex = self.zIndex + 4,
	})
	make("UIAspectRatioConstraint", widget, "UIAspectRatioConstraint", {})
	self.keyWidgets[id] = widget

	self:connect(widget.MouseEnter, function()
		self.hoverKey = id
		self:renderKeys()
	end)
	self:connect(widget.MouseLeave, function()
		if self.hoverKey == id then
			self.hoverKey = nil
		end

		self:renderKeys()
	end)
	self:connect(widget.InputBegan, function(input)
		if isPress(input) then
			self:pressKey(id, input)
		end
	end)

	return widget
end

function MiniTimeline:keyColors()
	local colors = rawState.Colors or {}
	return theme.get("KfD", colors.KEYFRAME_DEFAULT_COLOR or Color3.fromRGB(255, 255, 255)),
		theme.get("KfS", colors.KEYFRAME_SELECTED_COLOR or Color3.fromRGB(145, 90, 255)),
		theme.get("KfH", colors.KEYFRAME_HOVER_COLOR or Color3.fromRGB(158, 158, 158))
end

function MiniTimeline:keyOpacity(name)
	local ok, override = pcall(theme.getOverride, name)
	if ok and type(override) == "table" and type(override.t) == "number" then
		return override.t
	end

	return 0
end

function MiniTimeline:dragBounds()
	local low, high = math.huge, -math.huge
	for _, key in self.keys do
		if self.selection[key.Id] then
			low = math.min(low, key.Frame)
			high = math.max(high, key.Frame)
		end
	end

	return low, high
end

function MiniTimeline:previewFrame(key)
	local drag = self.keyDrag
	if drag and drag.delta ~= 0 and self.selection[key.Id] then
		return key.Frame + drag.delta
	end

	return key.Frame
end

function MiniTimeline:renderKeys()
	if not self.keyLayer then
		return
	end

	local width = self:trackWidth()
	local default, selected, hover = self:keyColors()
	for _, key in self.keys do
		local widget = self.keyWidgets[key.Id]
		if widget then
			local frame = self:previewFrame(key)
			local x = self:frameToX(frame)
			local isSelected = self.selection[key.Id] == true
			local isHovered = self.hoverKey == key.Id
			widget.Position = UDim2.new(0, x, 0.5, rulerHeight / 2)
			widget.Visible = x >= -keySize and x <= width + keySize
			widget.ImageColor3 = isSelected and selected or isHovered and hover or default
			widget.ImageTransparency = 0
			widget.ZIndex = self.zIndex + 4 + (isSelected and 1 or 0)
		end
	end
end

function MiniTimeline:keyAtPointer()
	if not self.keyLayer then
		return nil
	end

	local pointer = inputModule:GetMouseLocation()
	for id, widget in self.keyWidgets do
		if widget.Visible then
			local center = widget.AbsolutePosition + widget.AbsoluteSize / 2
			local reach = math.max(widget.AbsoluteSize.X, 8) * 0.6
			if math.abs(pointer.X - center.X) <= reach and math.abs(pointer.Y - center.Y) <= reach then
				return id
			end
		end
	end

	return nil
end

function MiniTimeline:modifierDown()
	return inputModule:IsKeyDown(Enum.KeyCode.LeftShift)
		or inputModule:IsKeyDown(Enum.KeyCode.RightShift)
		or inputModule:IsKeyDown(Enum.KeyCode.LeftControl)
		or inputModule:IsKeyDown(Enum.KeyCode.RightControl)
end

function MiniTimeline:pressKey(id, input)
	local options = self.options
	if self:modifierDown() then
		if options.onToggleKey then
			options.onToggleKey(id)
		end

		return
	end

	if not self.selection[id] and options.onSelectKey then
		options.onSelectKey(id, false)
	end

	local startX = self:pointerX()
	local startFrame = 0
	for _, key in self.keys do
		if key.Id == id then
			startFrame = key.Frame
		end
	end

	local grab = startX - self:frameToX(startFrame)
	local drag = { id = id, delta = 0, moved = false }
	self.keyDrag = drag

	self:beginDrag(input, function()
		local x = self:pointerX()
		if not drag.moved and math.abs(x - startX) < dragThreshold then
			return
		end

		drag.moved = true
		local low, high = self:dragBounds()
		local delta = self:xToFrame(x - grab) - startFrame
		if low ~= math.huge then
			delta = math.clamp(delta, -low, math.max(-low, self:maxFrame() - high))
		end

		drag.delta = delta
		self:renderKeys()
	end, function()
		if self.keyDrag == drag then
			self.keyDrag = nil
		end

		if drag.moved then
			if drag.delta ~= 0 and options.onMoveKeys then
				options.onMoveKeys(drag.delta)
			end

			self:renderKeys()
			return
		end

		local now = os.clock()
		local double = self.lastKeyClick and self.lastKeyClick.id == id and now - self.lastKeyClick.at <= doubleClickTime
		self.lastKeyClick = { id = id, at = now }
		if double then
			self.lastKeyClick = nil
			if options.onOpenKey then
				options.onOpenKey(id, self.keyWidgets[id])
			end
		elseif options.onClickKey then
			options.onClickKey(id)
		end
	end)
end

function MiniTimeline:pointerY()
	return (inputModule:GetMouseLocation().Y - self.track.AbsolutePosition.Y) / self:scaleFactor()
end

function MiniTimeline:boxSelect(input)
	local options = self.options
	local startX = self:pointerX()
	local startY = self:pointerY()
	local additive = self:modifierDown()
	local box = self.selectBox
	if not box then
		local _, selected = self:keyColors()
		box = make("Frame", self.track, "SelectionBox", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = selected,
			BackgroundTransparency = 0.85,
			BorderSizePixel = 0,
			Visible = false,
			Active = false,
			Interactable = false,
			ZIndex = self.zIndex + 6,
		})
		make("UIStroke", box, "Stroke", {
			Color = selected,
			Thickness = 1,
			Transparency = 0.2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		})
		self.selectBox = box
	end

	local moved = false
	self:beginDrag(input, function()
		local x = math.clamp(self:pointerX(), 0, self:trackWidth())
		local y = math.clamp(self:pointerY(), 0, self.track.AbsoluteSize.Y / self:scaleFactor())
		if not moved and math.abs(x - startX) < dragThreshold and math.abs(y - startY) < dragThreshold then
			return
		end

		moved = true
		local left, right = math.min(startX, x), math.max(startX, x)
		local top, bottom = math.min(startY, y), math.max(startY, y)
		box.Position = UDim2.fromOffset((left + right) / 2, (top + bottom) / 2)
		box.Size = UDim2.fromOffset(right - left, bottom - top)
		box.Visible = true
		if options.onBoxSelect then
			local from = (left - trackPadding + self.scroll) / self:contentWidth() * self:maxFrame()
			local to = (right - trackPadding + self.scroll) / self:contentWidth() * self:maxFrame()
			options.onBoxSelect(from, to, additive)
		end
	end, function()
		box.Visible = false
		if moved then
			return
		end

		if not additive and options.onDeselectKey then
			options.onDeselectKey()
		end

		local state = self.options.state
		local timeline = state and state.Timeline
		if timeline and not (timeline.IsExportLocked and timeline:IsExportLocked()) then
			rawState.Timeline.Playing = false
			self:seekToPointer()
		end
	end)
end

function MiniTimeline:seekToPointer()
	local state = self.options.state
	local timeline = state and state.Timeline
	local fps = rawState.Timeline.FPS
	if not timeline or not fps or fps <= 0 then
		return
	end

	timeline:SeekToTime(self:xToFrame(self:pointerX()) / fps, function()
		return state.currentRig
	end)
	self:update()
end

function MiniTimeline:endDrag()
	if self.drag then
		self.drag.finish()
	end
end

function MiniTimeline:beginDrag(input, onMove, onEnd)
	self:endDrag()
	local drag = { connections = {} }
	self.drag = drag

	function drag.finish()
		if self.drag ~= drag then
			return
		end

		self.drag = nil
		for _, connection in drag.connections do
			connection:Disconnect()
		end

		if onEnd then
			onEnd()
		end
	end

	table.insert(
		drag.connections,
		inputModule.InputChanged:Connect(function(changed)
			if changed.UserInputType == Enum.UserInputType.MouseMovement then
				onMove()
			end
		end)
	)
	table.insert(
		drag.connections,
		inputModule.InputEnded:Connect(function(ended)
			if ended.UserInputType == input.UserInputType then
				drag.finish()
			end
		end)
	)
	table.insert(drag.connections, inputModule.WindowFocusReleased:Connect(drag.finish))
end

function MiniTimeline:wheel(direction)
	if
		inputModule:IsKeyDown(Enum.KeyCode.LeftShift)
		or inputModule:IsKeyDown(Enum.KeyCode.RightShift)
	then
		self.scroll -= direction * self:viewWidth() * 0.15
	else
		local x = math.clamp(self:pointerX(), trackPadding, self:trackWidth() - trackPadding)
		local anchor = (x - trackPadding + self.scroll) / self:contentWidth()
		local factor = (1 + zoomStep) ^ preferences.timelineScrollSpeed()
		self.zoom = math.clamp(self.zoom * factor ^ direction, 1, self:maxZoom())
		self.scroll = anchor * self:contentWidth() - (x - trackPadding)
	end

	self:clampView()
	self:update()
end

function MiniTimeline:setCursor(icon)
	local mouse = self.options.mouse
	if mouse then
		mouse.Icon = icon or ""
	end
end

function MiniTimeline:bindResize(handle, cursor, resizeWidth)
	self:connect(handle.MouseEnter, function()
		self:setCursor(cursor)
	end)
	self:connect(handle.MouseLeave, function()
		if not self.resizing then
			self:setCursor(nil)
		end
	end)
	self:connect(handle.InputBegan, function(input)
		if not isPress(input) then
			return
		end

		inputModule.trackGuiPress(input, handle)
		local start = inputModule:GetMouseLocation()
		local startSize = self.size
		self.resizing = true
		self:beginDrag(input, function()
			local delta = (inputModule:GetMouseLocation() - start) / motion.scale(self.window)
			self:setSize(Vector2.new(
				resizeWidth and startSize.X - delta.X or startSize.X,
				startSize.Y + delta.Y
			), true)
		end, function()
			self.resizing = false
			self:setCursor(nil)
			if self.options.onResizeEnded then
				self.options.onResizeEnded(self.size)
			end
		end)
	end)
end

function MiniTimeline:bind()
	local track = self.track
	self:connect(self.addButton.Activated, function()
		if self.options.onAddKey then
			self.options.onAddKey()
		end
	end)

	self:connect(track.InputBegan, function(input)
		if self.keyDrag or self:keyAtPointer() then
			return
		end

		if isPress(input) and self.options.onFocus then
			self.options.onFocus()
		end

		if isPress(input) and self:pointerY() > rulerHeight + 2 then
			inputModule.trackGuiPress(input, track)
			self:boxSelect(input)
		elseif isPress(input) then
			inputModule.trackGuiPress(input, track)
			local state = self.options.state
			local timeline = state and state.Timeline
			if not timeline or (timeline.IsExportLocked and timeline:IsExportLocked()) then
				return
			end

			rawState.Timeline.Playing = false
			self:seekToPointer()
			self:beginDrag(input, function()
				self:seekToPointer()
			end)
		elseif isPan(input) then
			local startX, startScroll = inputModule:GetMouseLocation().X, self.scroll
			self:beginDrag(input, function()
				self.scroll = startScroll
					- (inputModule:GetMouseLocation().X - startX) / self:scaleFactor()
				self:clampView()
				self:update()
			end)
		end
	end)
	self:connect(track.MouseWheelForward, function()
		self:wheel(1)
	end)
	self:connect(track.MouseWheelBackward, function()
		self:wheel(-1)
	end)
	self:connect(track:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:update()
	end)

	self:connect(self.thumb.InputBegan, function(input)
		if not isPress(input) then
			return
		end

		inputModule.trackGuiPress(input, self.thumb)
		local startX, startScroll = inputModule:GetMouseLocation().X, self.scroll
		self:beginDrag(input, function()
			local delta = (inputModule:GetMouseLocation().X - startX) / self:scaleFactor()
			self.scroll = startScroll + delta * self:contentWidth() / self:viewWidth()
			self:clampView()
			self:update()
		end)
	end)

	self:bindResize(self.leftGrip, cornerCursor, true)
	self:bindResize(self.rightGrip, heightCursor, false)
end

function MiniTimeline:limits()
	local maximum = self.maxSize or Vector2.new(4000, 4000)
	return Vector2.new(math.max(minimumSize.X, maximum.X), math.max(minimumSize.Y, maximum.Y))
end

function MiniTimeline:setMaxSize(size)
	self.maxSize = size
end

function MiniTimeline:setSize(size, byUser)
	local maximum = self:limits()
	local previous = self.size
	self.size = Vector2.new(
		math.clamp(math.floor(size.X + 0.5), minimumSize.X, maximum.X),
		math.clamp(math.floor(size.Y + 0.5), minimumSize.Y, maximum.Y)
	)
	self.preferred = self.size
	self.window.Size = UDim2.fromOffset(self.size.X, self.size.Y)
	self.window.Position = FxLayout.centered(self.position, self.size)
	self:update()
	if self.size ~= previous and self.options.onResize then
		self.options.onResize(self.size, byUser)
	end
end

function MiniTimeline:place(position, animated)
	position = Vector2.new(math.floor(position.X + 0.5), math.floor(position.Y + 0.5))
	local moved = position ~= self.position
	self.position = position
	local target = FxLayout.centered(position, self.size)
	if self.freshShow then
		self.freshShow = false
		animated = false
	end

	if self.moveTween then
		self.moveTween:Cancel()
		self.moveTween = nil
	end

	if animated and moved and self.window.Visible then
		self.moveTween = tweenService:Create(self.window, moveInfo, { Position = target })
		self.moveTween:Play()
	else
		self.window.Position = target
	end
end

function MiniTimeline:arrange(position, size, animated)
	position = Vector2.new(math.floor(position.X + 0.5), math.floor(position.Y + 0.5))
	size = Vector2.new(
		math.max(math.floor(size.X + 0.5), minimumSize.X),
		math.max(math.floor(size.Y + 0.5), minimumSize.Y)
	)
	local changed = position ~= self.position or size ~= self.size
	self.position = position
	self.size = size
	if self.freshShow then
		self.freshShow = false
		animated = false
	end

	if self.moveTween then
		self.moveTween:Cancel()
		self.moveTween = nil
	end

	local targetPosition = FxLayout.centered(position, size)
	local targetSize = UDim2.fromOffset(size.X, size.Y)
	if animated and changed and self.window.Visible and not self.resizing then
		self.moveTween = tweenService:Create(self.window, moveInfo, { Position = targetPosition, Size = targetSize })
		self.moveTween:Play()
	else
		self.window.Position = targetPosition
		self.window.Size = targetSize
	end

	self:update()
end

function MiniTimeline:rect()
	return self.position, self.size
end

function MiniTimeline:isShown()
	return self.open and not self.hidden
end

function MiniTimeline:setHidden(hidden, instant)
	if self.destroyed then
		return
	end

	self.hidden = hidden == true
	self:apply(instant)
end

function MiniTimeline:startLoop()
	if self.loop then
		return
	end

	self.loop = runService.Heartbeat:Connect(function()
		self:update()
	end)
end

function MiniTimeline:stopLoop()
	if self.loop then
		self.loop:Disconnect()
		self.loop = nil
	end
end

function MiniTimeline:apply(instant)
	local show = self:isShown()
	local window = self.window
	if show == self.applied and not instant then
		return
	end

	self.applied = show
	if show then
		self.freshShow = true
		window.Visible = true
		self.layoutKey = nil
		self.window.Size = UDim2.fromOffset(self.size.X, self.size.Y)
		self.window.Position = FxLayout.centered(self.position, self.size)
		self:startLoop()
		if instant then
			windowFx.clear(window)
		else
			windowFx.pop(window, "batch")
		end

		return
	end

	self:stopLoop()
	self:endDrag()
	self:setCursor(nil)
	if instant then
		windowFx.clear(window)
		window.Visible = false
	else
		windowFx.shrink(window, function()
			if not self:isShown() then
				window.Visible = false
			end
		end, "batch")
	end
end

function MiniTimeline:setState(open, hidden, instant)
	if self.destroyed then
		return
	end

	self.open = open == true
	self.hidden = hidden == true
	self:apply(instant)
end

function MiniTimeline:setOpen(open, instant)
	if self.destroyed then
		return
	end

	self.open = open == true
	self:apply(instant)
end

function MiniTimeline:destroy()
	if self.destroyed then
		return
	end

	self.destroyed = true
	self:stopLoop()
	self:endDrag()
	if self.moveTween then
		self.moveTween:Cancel()
	end

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	windowFx.clear(self.window)
	self.window:Destroy()
end

return MiniTimeline
