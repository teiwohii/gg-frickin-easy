							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)

local sequenceTools = {}

sequenceTools.minimumGap = 0.001
sequenceTools.clipboard = {}

function sequenceTools.getLimit(): number
	return configuration.Create.maxSequencePoints
end

function sequenceTools.toPoints(sequence: NumberSequence)
	local points = {}

	for _, keypoint in sequence.Keypoints do
		table.insert(points, { time = keypoint.Time, value = keypoint.Value, envelope = keypoint.Envelope })
	end

	return points
end

function sequenceTools.normalizeTimes(points)
	table.sort(points, function(a, b)
		return a.time < b.time
	end)

	while #points > sequenceTools.getLimit() do
		table.remove(points, #points - 1)
	end

	local count = #points

	points[1].time = 0
	points[count].time = 1

	for index = 2, count - 1 do
		local minimum = points[index - 1].time + sequenceTools.minimumGap
		local maximum = 1 - (count - index) * sequenceTools.minimumGap

		points[index].time = math.clamp(points[index].time, minimum, maximum)
	end

	return points
end

function sequenceTools.fromPoints(points): NumberSequence
	local copy = {}

	for _, point in points do
		table.insert(copy, { time = point.time, value = point.value, envelope = point.envelope or 0 })
	end

	if #copy == 0 then
		return NumberSequence.new(0)
	elseif #copy == 1 then
		return NumberSequence.new(math.max(copy[1].value, 0))
	end

	sequenceTools.normalizeTimes(copy)

	local keypoints = {}

	for _, point in copy do
		table.insert(keypoints, NumberSequenceKeypoint.new(point.time, point.value, math.max(point.envelope, 0)))
	end

	return NumberSequence.new(keypoints)
end

function sequenceTools.toColorPoints(sequence: ColorSequence)
	local points = {}

	for _, keypoint in sequence.Keypoints do
		table.insert(points, { time = keypoint.Time, color = keypoint.Value })
	end

	return points
end

function sequenceTools.fromColorPoints(points): ColorSequence
	local copy = {}

	for _, point in points do
		table.insert(copy, { time = point.time, color = point.color })
	end

	if #copy == 0 then
		return ColorSequence.new(Color3.new(1, 1, 1))
	elseif #copy == 1 then
		return ColorSequence.new(copy[1].color)
	end

	sequenceTools.normalizeTimes(copy)

	local keypoints = {}

	for _, point in copy do
		table.insert(keypoints, ColorSequenceKeypoint.new(point.time, point.color))
	end

	return ColorSequence.new(keypoints)
end

function sequenceTools.evaluate(sequence: NumberSequence, time: number): number
	local keypoints = sequence.Keypoints

	if time <= keypoints[1].Time then
		return keypoints[1].Value
	end

	for index = 2, #keypoints do
		local current = keypoints[index]

		if time <= current.Time then
			local previous = keypoints[index - 1]
			local span = current.Time - previous.Time
			local alpha = if span > 0 then (time - previous.Time) / span else 1

			return previous.Value + (current.Value - previous.Value) * alpha
		end
	end

	return keypoints[#keypoints].Value
end

function sequenceTools.evaluateColor(sequence: ColorSequence, time: number): Color3
	local keypoints = sequence.Keypoints

	if time <= keypoints[1].Time then
		return keypoints[1].Value
	end

	for index = 2, #keypoints do
		local current = keypoints[index]

		if time <= current.Time then
			local previous = keypoints[index - 1]
			local span = current.Time - previous.Time
			local alpha = if span > 0 then (time - previous.Time) / span else 1

			return previous.Value:Lerp(current.Value, alpha)
		end
	end

	return keypoints[#keypoints].Value
end

function sequenceTools.getPeak(sequence: NumberSequence): number
	local peak = 0

	for _, keypoint in sequence.Keypoints do
		peak = math.max(peak, keypoint.Value + keypoint.Envelope)
	end

	return peak
end

function sequenceTools.flip(sequence: NumberSequence): NumberSequence
	local points = sequenceTools.toPoints(sequence)

	for _, point in points do
		point.time = 1 - point.time
	end

	return sequenceTools.fromPoints(points)
end

function sequenceTools.invert(sequence: NumberSequence, maximum: number): NumberSequence
	local points = sequenceTools.toPoints(sequence)

	for _, point in points do
		point.value = math.max(maximum - point.value, 0)
	end

	return sequenceTools.fromPoints(points)
end

function sequenceTools.scale(sequence: NumberSequence, factor: number): NumberSequence
	local points = sequenceTools.toPoints(sequence)

	for _, point in points do
		point.value *= factor
		point.envelope *= math.abs(factor)
	end

	return sequenceTools.fromPoints(points)
end

function sequenceTools.smooth(sequence: NumberSequence): NumberSequence
	local source = sequenceTools.toPoints(sequence)
	local limit = sequenceTools.getLimit()
	local segments = #source - 1
	local samples = math.min(configuration.Create.Sequences.smoothSamples, math.floor((limit - #source) / math.max(segments, 1)))

	if samples < 1 then
		return sequence
	end

	local points = {}

	for index = 1, segments do
		local from = source[index]
		local to = source[index + 1]

		table.insert(points, from)

		for sample = 1, samples do
			local alpha = sample / (samples + 1)
			local eased = alpha * alpha * (3 - 2 * alpha)

			table.insert(points, {
				time = from.time + (to.time - from.time) * alpha,
				value = from.value + (to.value - from.value) * eased,
				envelope = from.envelope + (to.envelope - from.envelope) * eased,
			})
		end
	end

	table.insert(points, source[#source])

	return sequenceTools.fromPoints(points)
end

function sequenceTools.simplify(sequence: NumberSequence, maximum: number): NumberSequence
	local points = sequenceTools.toPoints(sequence)
	local tolerance = configuration.Create.Sequences.simplifyTolerance * math.max(maximum, 0.001)
	local changed = true

	while changed and #points > 2 do
		changed = false

		for index = 2, #points - 1 do
			local previous = points[index - 1]
			local current = points[index]
			local following = points[index + 1]
			local span = following.time - previous.time
			local alpha = if span > 0 then (current.time - previous.time) / span else 0
			local expected = previous.value + (following.value - previous.value) * alpha

			if math.abs(expected - current.value) <= tolerance then
				table.remove(points, index)
				changed = true
				break
			end
		end
	end

	return sequenceTools.fromPoints(points)
end

function sequenceTools.fromPreset(preset, maximum: number): NumberSequence
	local points = {}

	for _, point in preset.points do
		table.insert(points, { time = point[1], value = point[2] * maximum, envelope = 0 })
	end

	return sequenceTools.fromPoints(points)
end

function sequenceTools.gradientFromPreset(preset): ColorSequence
	local points = {}

	for _, point in preset.points do
		table.insert(points, { time = point[1], color = point[2] })
	end

	return sequenceTools.fromColorPoints(points)
end

function sequenceTools.flipColor(sequence: ColorSequence): ColorSequence
	local points = sequenceTools.toColorPoints(sequence)

	for _, point in points do
		point.time = 1 - point.time
	end

	return sequenceTools.fromColorPoints(points)
end

function sequenceTools.spreadColor(sequence: ColorSequence): ColorSequence
	local points = sequenceTools.toColorPoints(sequence)
	local count = #points

	for index, point in points do
		point.time = (index - 1) / math.max(count - 1, 1)
	end

	return sequenceTools.fromColorPoints(points)
end

function sequenceTools.mapColors(sequence: ColorSequence, transform: (Color3) -> Color3): ColorSequence
	local points = sequenceTools.toColorPoints(sequence)

	for _, point in points do
		point.color = transform(point.color)
	end

	return sequenceTools.fromColorPoints(points)
end

function sequenceTools.copy(value)
	sequenceTools.clipboard[typeof(value)] = value
end

function sequenceTools.paste(kind: string)
	return sequenceTools.clipboard[kind]
end

return sequenceTools
]]></ProtectedString>
							<string name="ScriptGuid">{14D675BD-98F2-4E80-A00C-362240959EE8}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">sequenceTools</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX8C0D07E164ED498584A05148B6DF70E6">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)
local valueCodec = require(script.Parent.Parent.Utility.valueCodec)
local sequenceTools = require(script.Parent.sequenceTools)

local function extend(Base)
	local Class = setmetatable({}, { __index = Base })

	Class.__index = Class

	return Class
end

local Field = {}
Field.__index = Field

Field.template = "FieldNumber"
Field.precision = 1e5

function Field.create(Class, form, descriptor)
	local self = setmetatable({}, Class)

	self.form = form
	self.context = form.context
	self.descriptor = descriptor
	self.row = form.templates[Class.template]:Clone()
	self.connections = {}
	self.value = descriptor.value
	self.mixed = descriptor.mixed == true
	self.parts = descriptor.parts
	self.dirty = false

	local label = self.row:FindFirstChild("Label")

	if label and label:IsA("TextLabel") then
		label.Text = descriptor.label or descriptor.id or ""
		self.label = label
		self:bindTip(label)

		if descriptor.onLabelMenu then
			self:connect(label.InputBegan, function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton2 then
					descriptor.onLabelMenu(label)
				end
			end)
		end
	end

	self:bind()
	self:display(self.value, self.mixed)

	return self
end

function Field:connect(signal: RBXScriptSignal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function Field:bindTip(target: GuiObject)
	local tip = self.descriptor.tip
	local hover = self.context.hover

	if not tip or not hover then
		return
	end

	self:connect(target.MouseEnter, function()
		hover:showText(target, tip)
	end)

	self:connect(target.MouseLeave, function()
		if hover.current == target then
			hover:hide()
		end
	end)
end

function Field:bind() end

function Field:display(_value, _mixed) end

function Field:isBusy(): boolean
	return false
end

function Field:getLabelText(): string
	return self.descriptor.label or self.descriptor.id or ""
end

function Field:commit(value, final: boolean?, component: string?)
	self.value = value

	if not component then
		self.mixed = false
		self.parts = nil
	elseif self.parts then
		self.parts[component] = nil
	end

	local handler = self.descriptor.onChange

	if handler then
		handler(value, final ~= false, component)
	end
end

function Field:refresh()
	local read = self.descriptor.read

	if not read then
		return
	end

	local value, mixed, parts = read()

	self.value = value
	self.mixed = mixed == true
	self.parts = parts

	if not self:isBusy() then
		self:display(value, self.mixed)
	end
end

function Field:snap(number: number): number
	local descriptor = self.descriptor

	if descriptor.integer then
		number = math.round(number)
	end

	local step = if descriptor.getStep then descriptor.getStep() else descriptor.step

	if step and step > 0 then
		number = math.round(number / step) * step
	end

	if descriptor.minimum then
		number = math.max(number, descriptor.minimum)
	end

	if descriptor.maximum and descriptor.clamp then
		number = math.min(number, descriptor.maximum)
	end

	return math.round(number * Field.precision) / Field.precision
end

function Field:parseNumber(text: string): number?
	local numbers = valueCodec.readNumbers(text)

	return numbers[1]
end

function Field:getSensitivity(start: number): number
	local descriptor = self.descriptor

	if descriptor.sensitivity then
		return descriptor.sensitivity
	end

	local step = if descriptor.getStep then descriptor.getStep() else descriptor.step

	if step and step > 0 then
		return step / 4
	end

	if descriptor.integer then
		return 0.2
	end

	if descriptor.range then
		return math.max((descriptor.range.max - descriptor.range.min) / 240, 0.001)
	end

	return math.max(math.abs(start) * 0.01, 0.01)
end

function Field:setBoxNumber(box: TextBox, value: number?, mixed: boolean)
	if box:IsFocused() then
		return
	end

	box.Text = if mixed or value == nil then "" else valueCodec.round(value)
	box.PlaceholderText = if mixed then configuration.Create.mixedText else ""
end

function Field:destroy()
	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	self.row:Destroy()
end

local NumberField = extend(Field)

NumberField.template = "FieldNumber"

function NumberField:bind()
	self.box = self.row.Value.Box

	self:connect(self.box.FocusLost, function()
		local number = self:parseNumber(self.box.Text)

		if number == nil then
			self:display(self.value, self.mixed)
			return
		end

		self:commit(self:snap(number), true)
		self:display(self.value, false)
	end)

	self.form:bindScrub(self, self.label, function()
		return if typeof(self.value) == "number" then self.value else nil
	end, function(number: number, final: boolean)
		self:commit(self:snap(number), final)
		self:display(self.value, false)
	end)
end

function NumberField:isBusy(): boolean
	return self.box:IsFocused()
end

function NumberField:display(value, mixed: boolean)
	self:setBoxNumber(self.box, value, mixed)
end

local TextField = extend(Field)

TextField.template = "FieldText"

function TextField:bind()
	self.box = self.row.Value.Box

	self:connect(self.box.FocusLost, function()
		local descriptor = self.descriptor
		local value = self.box.Text

		if descriptor.parse then
			value = descriptor.parse(self.box.Text)

			if value == nil then
				self:display(self.value, self.mixed)
				return
			end
		end

		self:commit(value, true)
		self:display(self.value, false)
	end)
end

function TextField:isBusy(): boolean
	return self.box:IsFocused()
end

function TextField:display(value, mixed: boolean)
	local descriptor = self.descriptor

	if mixed or value == nil then
		self.box.Text = ""
	elseif descriptor.format then
		self.box.Text = descriptor.format(value)
	else
		self.box.Text = tostring(value)
	end

	self.box.PlaceholderText = if mixed then configuration.Create.mixedText else (descriptor.placeholder or "")
end

local ComponentField = extend(Field)

ComponentField.template = "FieldVector3"
ComponentField.components = { "X", "Y", "Z" }

function ComponentField:getComponent(value, component: string): number?
	return if value ~= nil then value[component] else nil
end

function ComponentField:withComponent(value, component: string, number: number)
	return self.context.access:withComponent(value, component, number)
end

function ComponentField:bind()
	self.boxes = {}

	for _, component in self.components do
		local box = self.row.Value[component]

		self.boxes[component] = box

		self:connect(box.FocusLost, function()
			local number = self:parseNumber(box.Text)

			if number == nil or self.value == nil then
				self:display(self.value, self.mixed)
				return
			end

			self:commit(self:withComponent(self.value, component, self:snap(number)), true, component)
			self:display(self.value, self.mixed)
		end)
	end
end

function ComponentField:isBusy(): boolean
	for _, box in self.boxes do
		if box:IsFocused() then
			return true
		end
	end

	return false
end

function ComponentField:display(value, mixed: boolean)
	for component, box in self.boxes do
		local differs = mixed and (self.parts == nil or self.parts[component] == true)

		self:setBoxNumber(box, self:getComponent(value, component), differs)
	end
end

local Vector3Field = extend(ComponentField)

Vector3Field.template = "FieldVector3"
Vector3Field.components = { "X", "Y", "Z" }

local Vector2Field = extend(ComponentField)

Vector2Field.template = "FieldVector2"
Vector2Field.components = { "X", "Y" }

local RangeField = extend(ComponentField)

RangeField.template = "FieldRange"
RangeField.components = { "Min", "Max" }

function RangeField:bind()
	ComponentField.bind(self)

	self.form:bindScrub(self, self.label, function()
		return if typeof(self.value) == "NumberRange" then self.value.Max else nil
	end, function(number: number, final: boolean)
		local value = self.value
		local delta = self:snap(number) - value.Max

		self:commit(NumberRange.new(value.Min + delta, value.Max + delta), final)
		self:display(self.value, false)
	end)
end

local ToggleField = extend(Field)

ToggleField.template = "FieldToggle"
ToggleField.mixedTransparency = 0.6

function ToggleField:bind()
	self.check = self.row.Value.Check
	self.state = self.row.Value.State

	self:connect(self.check.Activated, function()
		self:commit(if self.mixed then true else self.value ~= true, true)
		self:display(self.value, false)
	end)
end

function ToggleField:display(value, mixed: boolean)
	self.check.Mark.Visible = mixed or value == true
	self.check.Mark.BackgroundTransparency = if mixed then ToggleField.mixedTransparency else 0
	self.state.Text = if mixed then configuration.Create.mixedText else ""
end

local ChoiceField = extend(Field)

ChoiceField.template = "FieldChoice"

function ChoiceField:getOptions()
	local descriptor = self.descriptor

	if descriptor.getOptions then
		return descriptor.getOptions()
	end

	if descriptor.options then
		return descriptor.options
	end

	local enumType = descriptor.enumType or (if typeof(self.value) == "EnumItem" then self.value.EnumType else nil)
	local options = {}

	if enumType then
		for _, item in enumType:GetEnumItems() do
			table.insert(options, { value = item, label = item.Name })
		end
	end

	return options
end

function ChoiceField:getOptionLabel(value): string
	for _, option in self:getOptions() do
		if option.value == value then
			return option.label
		end
	end

	return valueCodec.format(value)
end

function ChoiceField:bind()
	self.button = self.row.Value.Button

	self:connect(self.button.Activated, function()
		local items = {}

		for _, option in self:getOptions() do
			table.insert(items, {
				text = option.label,
				checked = not self.mixed and option.value == self.value,
				callback = function()
					self:commit(option.value, true)
					self:display(self.value, false)
				end,
			})
		end

		self.context.menu:toggle({ anchor = self.button, owner = self, items = items })
	end)
end

function ChoiceField:display(value, mixed: boolean)
	local text = if mixed then configuration.Create.mixedText else self:getOptionLabel(value)

	self.button.Label.Text = if text == "" then (self.descriptor.placeholder or "") else text
end

local ColorField = extend(Field)

ColorField.template = "FieldColor"

function ColorField:parse(text: string): Color3?
	local hex = string.match(text, "^%s*#?(%x%x%x%x%x%x)%s*$")

	if hex then
		local success, color = pcall(Color3.fromHex, hex)

		return if success then color else nil
	end

	local numbers = valueCodec.readNumbers(text)

	if #numbers >= 3 then
		return Color3.fromRGB(math.clamp(numbers[1], 0, 255), math.clamp(numbers[2], 0, 255), math.clamp(numbers[3], 0, 255))
	end

	return nil
end

function ColorField:bind()
	self.swatch = self.row.Value.Swatch
	self.box = self.row.Value.Box

	self:connect(self.swatch.Activated, function()
		self.dirty = false

		self.context.colors:toggle({
			owner = self,
			anchor = self.swatch,
			color = if typeof(self.value) == "Color3" then self.value else Color3.new(1, 1, 1),
			title = self:getLabelText(),
			onChanged = function(color: Color3)
				self.dirty = true
				self:commit(color, false)
				self:display(color, false)
			end,
			onClosed = function()
				if self.dirty then
					self.dirty = false
					self:commit(self.value, true)
				end
			end,
		})
	end)

	self:connect(self.box.FocusLost, function()
		local color = self:parse(self.box.Text)

		if not color then
			self:display(self.value, self.mixed)
			return
		end

		self:commit(color, true)
		self:display(color, false)
	end)
end

function ColorField:isBusy(): boolean
	return self.box:IsFocused() or self.context.colors:getOwner() == self
end

function ColorField:display(value, mixed: boolean)
	if typeof(value) == "Color3" then
		self.swatch:SetAttribute("EclipseFXValueColor", true)
		self.swatch.BackgroundColor3 = value
	end

	if self.box:IsFocused() then
		return
	end

	self.box.Text = if mixed or typeof(value) ~= "Color3" then "" else valueCodec.format(value)
	self.box.PlaceholderText = if mixed then configuration.Create.mixedText else ""
end

local AssetField = extend(Field)

AssetField.template = "FieldAsset"

function AssetField:bind()
	self.box = self.row.Value.Box
	self.thumb = self.row.Value.Thumb

	if self.descriptor.preview == false then
		self.thumb.Visible = false
		self.box.Size = UDim2.fromScale(1, 1)
	end

	self:connect(self.box.FocusLost, function()
		local value = self.context.access:normalizeAsset(self.box.Text)

		self:commit(value, true)
		self:display(self.value, false)
	end)

	self:connect(self.thumb.Activated, function()
		if self.descriptor.onPreview then
			self.descriptor.onPreview(self.thumb)
		end
	end)
end

function AssetField:isBusy(): boolean
	return self.box:IsFocused()
end

function AssetField:display(value, mixed: boolean)
	local text = if mixed or typeof(value) ~= "string" then "" else value

	self.box.Text = text
	self.box.PlaceholderText = if mixed then configuration.Create.mixedText else "Asset id"

	if self.thumb.Visible then
		self.thumb.Image = text
	end
end

local InstanceField = extend(Field)

InstanceField.template = "FieldInstance"

function InstanceField:accepts(instance: Instance): boolean
	local descriptor = self.descriptor

	if descriptor.className and not instance:IsA(descriptor.className) then
		return false
	end

	return descriptor.accepts == nil or descriptor.accepts(instance)
end

function InstanceField:bind()
	self.button = self.row.Value.Button
	self.clear = self.row.Value.Clear
	self.picking = false

	local selection = self.context.selection

	self:connect(self.button.Activated, function()
		if self.picking then
			selection:cancelPick()
			return
		end

		self.picking = true
		self.button.Label.Text = configuration.Create.pickText

		selection:beginPick(function(instance)
			return self:accepts(instance)
		end, function(instance)
			self.picking = false
			self:commit(instance, true)
			self:display(instance, false)
		end, function()
			if self.context.notify then
				self.context.notify(string.format("That can't be used here. Pick %s.", self.descriptor.className or "another object"))
			end
		end, function()
			self.picking = false
			self:display(self.value, self.mixed)
		end)
	end)

	self:connect(self.button.MouseButton2Click, function()
		if typeof(self.value) == "Instance" and self.value.Parent then
			selection:set({ self.value })
		end
	end)

	self:connect(self.clear.Activated, function()
		if self.picking then
			selection:cancelPick()
		end

		self:commit(nil, true)
		self:display(nil, false)
	end)
end

function InstanceField:isBusy(): boolean
	return self.picking
end

function InstanceField:display(value, mixed: boolean)
	if mixed then
		self.button.Label.Text = configuration.Create.mixedText
	elseif typeof(value) == "Instance" then
		self.button.Label.Text = value.Name
	else
		self.button.Label.Text = configuration.Create.noneText
	end
end

function InstanceField:destroy()
	if self.picking then
		self.context.selection:cancelPick()
	end

	Field.destroy(self)
end

local SequenceField = extend(Field)

SequenceField.template = "FieldSequence"
SequenceField.bars = 36
SequenceField.minimumHeight = 0.04
SequenceField.mixedTransparency = 0.6

function SequenceField:bind()
	self.button = self.row.Value.Button
	self.graph = self.button.Graph
	self.bars = {}

	local template = self.form.templates.GraphLine
	local count = SequenceField.bars

	for index = 1, count do
		local bar = template:Clone()

		bar.Name = "Bar"
		bar.AnchorPoint = Vector2.new(0, 1)
		bar.Position = UDim2.fromScale((index - 1) / count, 1)
		bar.Size = UDim2.fromScale(1 / count, 0)
		bar.Parent = self.graph
		self.bars[index] = bar
	end

	self:connect(self.button.Activated, function()
		self.context.curves:toggle({
			owner = self,
			title = self:getLabelText(),
			sequence = if typeof(self.value) == "NumberSequence" then self.value else NumberSequence.new(1),
			maximum = self.descriptor.graphMaximum,
			signed = self.descriptor.signed,
			onChange = function(sequence: NumberSequence, final: boolean)
				self:commit(sequence, final)
				self:draw(sequence, false)
			end,
		})
	end)
end

function SequenceField:isBusy(): boolean
	return self.context.curves:getOwner() == self and self.context.curves:isDragging()
end

function SequenceField:draw(sequence, mixed: boolean)
	if typeof(sequence) ~= "NumberSequence" then
		return
	end

	local count = SequenceField.bars
	local reference = self.descriptor.graphMaximum
	local peak = 0

	for _, keypoint in sequence.Keypoints do
		peak = math.max(peak, math.abs(keypoint.Value))
	end

	if reference and reference <= 1 then
		peak = math.max(peak, reference)
	end

	if peak <= 0 then
		peak = 1
	end

	for index, bar in self.bars do
		local value = sequenceTools.evaluate(sequence, (index - 0.5) / count)
		local height = math.clamp(math.abs(value) / peak, SequenceField.minimumHeight, 1)

		bar.Size = UDim2.fromScale(1 / count, height)
		bar.BackgroundTransparency = if mixed then SequenceField.mixedTransparency else 0
	end
end

function SequenceField:display(value, mixed: boolean)
	self:draw(value, mixed)

	local curves = self.context.curves

	if curves:getOwner() == self and not curves:isDragging() and typeof(value) == "NumberSequence" then
		curves:setSequence(value)
	end
end

function SequenceField:destroy()
	if self.context.curves:getOwner() == self then
		self.context.curves:close()
	end

	Field.destroy(self)
end

local GradientField = extend(Field)

GradientField.template = "FieldGradient"

function GradientField:bind()
	self.button = self.row.Value.Button

	self:connect(self.button.Activated, function()
		self.context.gradients:toggle({
			owner = self,
			title = self:getLabelText(),
			sequence = if typeof(self.value) == "ColorSequence" then self.value else ColorSequence.new(Color3.new(1, 1, 1)),
			onChange = function(sequence: ColorSequence, final: boolean)
				self:commit(sequence, final)
				self.button.Fill.Color = sequence
			end,
		})
	end)
end

function GradientField:isBusy(): boolean
	return self.context.gradients:getOwner() == self and self.context.gradients:isDragging()
end

function GradientField:display(value, _mixed: boolean)
	if typeof(value) ~= "ColorSequence" then
		return
	end

	self.button.Fill.Color = value

	local gradients = self.context.gradients

	if gradients:getOwner() == self and not gradients:isDragging() then
		gradients:setSequence(value)
	end
end

function GradientField:destroy()
	if self.context.gradients:getOwner() == self then
		self.context.gradients:close()
	end

	Field.destroy(self)
end

local ActionField = extend(Field)

ActionField.template = "FieldAction"

function ActionField:bind()
	self.button = self.row.Value.Button
	self.button.Label.Text = self:getLabelText()
	self:bindTip(self.button)

	if self.descriptor.accent then
		self.button:SetAttribute("ThemeBg", "MenuSel")
		self.button.BackgroundColor3 = configuration.Colors.Light
	end

	self:connect(self.button.Activated, function()
		if self.descriptor.onAction then
			self.descriptor.onAction(self.button)
		end
	end)
end

local NoteField = extend(Field)

NoteField.template = "FieldNote"

function NoteField:bind()
	self.row.Text = self.descriptor.text or ""
end

return {
	number = NumberField,
	text = TextField,
	vector3 = Vector3Field,
	vector2 = Vector2Field,
	range = RangeField,
	toggle = ToggleField,
	choice = ChoiceField,
	color = ColorField,
	asset = AssetField,
	instance = InstanceField,
	sequence = SequenceField,
	gradient = GradientField,
	action = ActionField,
	note = NoteField,
}
]]></ProtectedString>
							<string name="ScriptGuid">{7339AA23-9B65-43B4-9E4B-D21175352DC6}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">fieldKinds</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXDE53EA9DE8FF4169919DF31CDE475D80">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)
local fieldKinds = require(script.Parent.fieldKinds)

local Form = {}
Form.__index = Form

Form.expandedText = "v"
Form.collapsedText = ">"
Form.scrubThreshold = 3
Form.fineFactor = 0.1

function Form.new(list: ScrollingFrame, templates: Instance, context)
	local self = setmetatable({}, Form)

	self.list = list
	self.templates = templates
	self.context = context
	self.entries = {}
	self.collapsed = {}
	self.filter = ""
	self.scrub = nil
	self.connections = {}
	self.entryConnections = {}

	self:bind()

	return self
end

function Form:bind()
	table.insert(self.connections, userInputService.InputChanged:Connect(function(input)
		if self.scrub and input.UserInputType == Enum.UserInputType.MouseMovement then
			self:updateScrub(input.Position.X)
		end
	end))

	table.insert(self.connections, userInputService.InputEnded:Connect(function(input)
		if self.scrub and input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:finishScrub()
		end
	end))
end

function Form:bindScrub(field, handle: GuiObject?, getValue: () -> number?, setValue: (number, boolean) -> ())
	if not handle then
		return
	end

	field:connect(handle.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		local start = getValue()

		if start == nil then
			return
		end

		self.scrub = {
			field = field,
			start = start,
			origin = input.Position.X,
			sensitivity = field:getSensitivity(start),
			setValue = setValue,
			moved = false,
			last = start,
		}
	end)
end

function Form:isFine(): boolean
	return userInputService:IsKeyDown(Enum.KeyCode.LeftShift) or userInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

function Form:updateScrub(x: number)
	local scrub = self.scrub
	local delta = x - scrub.origin

	if not scrub.moved then
		if math.abs(delta) < Form.scrubThreshold then
			return
		end

		scrub.moved = true
	end

	local factor = if self:isFine() then Form.fineFactor else 1

	scrub.last = scrub.start + delta * scrub.sensitivity * factor
	scrub.setValue(scrub.last, false)
end

function Form:finishScrub()
	local scrub = self.scrub

	self.scrub = nil

	if scrub and scrub.moved then
		scrub.setValue(scrub.last, true)
	end
end

function Form:isScrubbing(): boolean
	return self.scrub ~= nil and self.scrub.moved
end

function Form:getKey(section): string
	return section.key or section.title
end

function Form:isCollapsed(section): boolean
	local stored = self.collapsed[self:getKey(section)]

	if stored ~= nil then
		return stored
	end

	return section.collapsed == true
end

function Form:createHeader(section, order: number)
	local header = self.templates.Section:Clone()

	header.Title.Text = section.title
	header.LayoutOrder = order

	table.insert(self.entryConnections, header.Activated:Connect(function()
		self.collapsed[self:getKey(section)] = not self:isCollapsed(section)
		self:applyVisibility()
	end))

	local action = section.action

	if action then
		header.Action.Visible = true
		header.Action.Label.Text = action.text

		table.insert(self.entryConnections, header.Action.Activated:Connect(function()
			action.callback(header.Action)
		end))

		if action.tip and self.context.hover then
			local hover = self.context.hover

			table.insert(self.entryConnections, header.Action.MouseEnter:Connect(function()
				hover:showText(header.Action, action.tip)
			end))

			table.insert(self.entryConnections, header.Action.MouseLeave:Connect(function()
				if hover.current == header.Action then
					hover:hide()
				end
			end))
		end
	end

	header.Parent = self.list

	return header
end

function Form:setSections(sections)
	local canvas = self.list.CanvasPosition

	self:clear()

	local order = 0

	for _, section in sections do
		order += 1

		local entry = {
			section = section,
			header = if section.title then self:createHeader(section, order) else nil,
			fields = {},
		}

		for _, descriptor in section.fields do
			local Class = fieldKinds[descriptor.kind]

			if Class then
				order += 1

				local field = Class.create(Class, self, descriptor)

				field.row.LayoutOrder = order
				field.row.Parent = self.list
				table.insert(entry.fields, field)
			end
		end

		table.insert(self.entries, entry)
	end

	self:applyVisibility()
	self.list.CanvasPosition = canvas
end

function Form:matches(field): boolean
	if self.filter == "" then
		return true
	end

	local descriptor = field.descriptor
	local text = string.lower((descriptor.label or "") .. " " .. (descriptor.id or "") .. " " .. (descriptor.keywords or ""))

	return string.find(text, self.filter, 1, true) ~= nil
end

function Form:applyVisibility()
	local filtering = self.filter ~= ""

	for _, entry in self.entries do
		local section = entry.section
		local collapsed = not filtering and self:isCollapsed(section)
		local titleMatches = filtering and section.title ~= nil and string.find(string.lower(section.title), self.filter, 1, true) ~= nil
		local anyVisible = false

		for _, field in entry.fields do
			local visible = not collapsed and (titleMatches or self:matches(field))

			field.row.Visible = visible
			anyVisible = anyVisible or visible
		end

		if entry.header then
			entry.header.Visible = not filtering or anyVisible
			entry.header.Arrow.Text = if collapsed then Form.collapsedText else Form.expandedText
		end
	end
end

function Form:setFilter(text: string)
	local filter = string.lower(string.gsub(text, "^%s*(.-)%s*$", "%1"))

	if filter == self.filter then
		return
	end

	self.filter = filter
	self:applyVisibility()
end

function Form:refresh()
	for _, entry in self.entries do
		for _, field in entry.fields do
			field:refresh()
		end
	end
end

function Form:getField(id: string)
	for _, entry in self.entries do
		for _, field in entry.fields do
			if field.descriptor.id == id then
				return field
			end
		end
	end

	return nil
end

function Form:getFieldCount(): number
	local count = 0

	for _, entry in self.entries do
		count += #entry.fields
	end

	return count
end

function Form:clear()
	self.scrub = nil

	for _, connection in self.entryConnections do
		connection:Disconnect()
	end

	table.clear(self.entryConnections)

	for _, entry in self.entries do
		for _, field in entry.fields do
			field:destroy()
		end

		if entry.header then
			entry.header:Destroy()
		end
	end

	table.clear(self.entries)

	local menu = self.context.menu

	if menu and menu:isOpen() and typeof(menu:getOwner()) == "table" and menu:getOwner().form == self then
		menu:close()
	end

	local colors = self.context.colors

	if colors and colors:isOpen() and typeof(colors:getOwner()) == "table" and colors:getOwner().form == self then
		colors:close()
	end
end

function Form:destroy()
	self:clear()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
end

return Form
]]></ProtectedString>
							<string name="ScriptGuid">{6A11F95D-5101-4A6C-B7A9-B6E8681B2F12}</string>
