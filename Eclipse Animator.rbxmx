local assets = {}

for _, group in
	{
		script.singleColors,
		script.lightingEffects,
		script.dualColors,
		script.miscEffects,
	}
do
	for _, asset in require(group) do
		table.insert(assets, asset)
	end
end

return assets
]]></ProtectedString>
