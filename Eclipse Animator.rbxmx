local byKey, ordered = {}, {}
for _, option in optionsValue do
	byKey[option.key] = option
end

for groupIndex, group in groups do
	for index, key in group.keys do
		local option = assert(byKey[key], key)
		option.group = group.name
		option.blenderFeature = group.blenderFeature == true or option.blenderFeature
		option.order = option.featured and 0 or groupIndex * 100 + index
		table.insert(ordered, option)
		byKey[key] = nil
	end
end

assert(next(byKey) == nil, "Uncategorized preference")
optionsValue = ordered

local refs = {}
local active
local sessions = {}

local function make(class, parent, name, props)
	local object = Instance.new(class)
	object.Name = name
	for key, value in props do
		object[key] = value
	end

	object.Parent = parent
	return object
end

local function tag(object, attribute, key)
	object:SetAttribute(attribute, key)
	return object
end

local function round(object, radius)
	make("UICorner", object, "Corner", { CornerRadius = UDim.new(0, radius) })
end

local function outline(object, transparency)
	return tag(
		make("UIStroke", object, "Outline", {
			Color = theme.panelOutlineDefault(),
			Thickness = 1,
			Transparency = transparency or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		"ThemeStrk",
		"Strk"
	)
end

local function connect(session, signal, callback)
	local connection = signal:Connect(callback)
	table.insert(session.connections, connection)
	return connection
end

local function disconnect(session)
	if session.colorAnchor and colorPicker.isOpen(session.colorAnchor) then
		colorPicker.close(true)
	end

	for _, connection in session.connections do
		connection:Disconnect()
	end

	table.clear(session.connections)
	for _, cleanup in session.tipCleanups do
		cleanup()
	end

	table.clear(session.tipCleanups)
	if session.unsubscribe then
		session.unsubscribe()
		session.unsubscribe = nil
	end

	if session.flashTweens then
		for tween, stroke in session.flashTweens do
			tween:Cancel()
			stroke:Destroy()
		end

		table.clear(session.flashTweens)
	end
end

local function buildFeaturedBanner(session, row, onActivated)
	row.Size = UDim2.new(1, 0, 0, featuredHeight)
	local banner = tag(
		make("TextButton", row, "FeaturedBanner", {
			Size = UDim2.fromScale(1, 1),
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.fromRGB(15, 12, 19):Lerp(Color3.new(), 0.2),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 102,
		}),
		"ThemeBg",
		"Pnl"
	)
	banner:SetAttribute("ThemeShade", -0.2)
	round(banner, 2)
	local stroke = outline(banner, 0.35)

	local frames = featuredAnimation.frames
	local tile = make("ImageLabel", banner, "SakuraFrame", {
		AnchorPoint = Vector2.new(0.5, featuredAnimation.focus),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = frames[1],
		Active = false,
		Interactable = false,
		ZIndex = 102,
	})
	if not featuredPreloaded then
		featuredPreloaded = true
		task.spawn(function()
			local assets = table.create(#frames)
			for index, frame in frames do
				assets[index] = frame
			end

			pcall(game:GetService("ContentProvider").PreloadAsync, game:GetService("ContentProvider"), assets)
		end)
	end

	local function fitFrame()
		local size = banner.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end

		local layoutWidth = size.X * featuredHeight / size.Y
		local scale = featuredAnimation.scale
		tile.Size = UDim2.new(scale, 0, 0, layoutWidth * scale / featuredAnimation.aspect)
	end

	connect(session, banner:GetPropertyChangedSignal("AbsoluteSize"), fitFrame)
	fitFrame()

	local function showFrame(frame)
		tile.Image = frames[frame + 1]
	end

	local elapsed, current = 0, 0
	showFrame(current)
	connect(session, runService.Heartbeat, function(deltaTime)
		if session.closing or not row.Visible then
			return
		end

		elapsed += deltaTime
		local frame = math.floor(elapsed * featuredAnimation.fps) % #frames
		if frame ~= current then
			current = frame
			showFrame(frame)
		end
	end)
	connect(session, banner.MouseEnter, function()
		windowFx.setRestingProperty(stroke, "Transparency", 0)
	end)
	connect(session, banner.MouseLeave, function()
		windowFx.setRestingProperty(stroke, "Transparency", 0.35)
	end)
	connect(session, banner.Activated, onActivated)
	return banner
end

local function scaleOf(session)
	local animationScale = session.window:FindFirstChild("EclipseWindowScale")
	local scale = session.window.AbsoluteSize.X
		/ (width * (animationScale and animationScale.Scale or 1))
	return scale > 0 and scale or 1
end

local function restingPosition(session)
	local window = session.window
	local animationScale = window:FindFirstChild("EclipseWindowScale")
	local scale = animationScale and animationScale.Scale or 1
	return window.AbsolutePosition + window.AbsoluteSize * (0.5 - 0.5 / scale)
end

local function place(session, point)
	local window = session.window
	local parent = window.Parent
	if not parent then
		return
	end

	local scale = scaleOf(session)
	local origin, viewport = parent.AbsolutePosition, parent.AbsoluteSize
	local desired = UDim2.fromOffset(
		(point.X - origin.X) / scale + width * 0.5,
		(point.Y - origin.Y) / scale + height * 0.5
	)
	window.Position = windowMotion.reachable(
		desired,
		Vector2.new(width, height),
		viewport / scale,
		Vector2.new(0.5, 0.5),
		scale
	)
end

local function hideTip(session)
	if not session.hoverDialog then
		return
	end

	for _, tip in session.tips do
		session.hoverDialog:disappear(tip.button)
	end
end

local function dispose(session, destroyWindow)
	if session.disposed then
		return
	end

	session.disposed = true
	session.closing = true
	hideTip(session)
	disconnect(session)
	if session.hoverDialog then
		session.hoverDialog:Destroy()
		session.hoverDialog = nil
	end

	windowFx.clear(session.window)
	sessions[session] = nil
	if active == session then
		active = nil
	end

	if destroyWindow then
		session.window:Destroy()
	end
end

local function bindDrag(session, handle)
	windowMotion.resetOnOpen(session.window)
	chrome.bindDrag(session.window, handle, {
		disabled = function()
			return session.closing or session.window:GetAttribute("EclipseDocked") == true
		end,
		clamp = true,
		threshold = 3,
		began = function()
			hideTip(session)
		end,
	})
	connect(session, session.window.Parent:GetPropertyChangedSignal("AbsoluteSize"), function()
		if not session.closing and not session.window:GetAttribute("EclipseDocked") then
			hideTip(session)
			place(session, restingPosition(session))
		end
	end)
end

local function bindTip(session, button, text)
	local tooltip = session.hoverDialog
	if not tooltip then
		return
	end

	local options = { maxWidth = 320 }
	table.insert(session.tipCleanups, tooltip:latchToInstance(button, text, options))

	local function show()
		if session.closing or not button.Parent then
			return
		end

		tooltip:popup(text, button, options)
	end

	connect(session, button.SelectionGained, show)
	connect(session, button.SelectionLost, function()
		tooltip:disappear(button)
	end)
	connect(session, button.Activated, function()
		if tooltip.open and tooltip.causedElement == button then
			tooltip:disappear(button)
		else
			show()
		end
	end)
end

function editor.blenderSuggestion()
	local channels = preferences.get("TransformChannels") == true
	local continuous = preferences.get("ContinuousTimeline") == true
	if channels and continuous then
		return nil
	end

	if not channels and not continuous then
		return "To get the full Blender feel, enable transform channels and continuous timeline too."
	end

	if not channels then
		return "To get the full Blender feel, enable transform channels too."
	end

	return "To get the full Blender feel, enable continuous timeline too."
end

function editor.init(newRefs)
	if refs.ScreenGui ~= newRefs.ScreenGui then
		editor.destroy()
	end

	refs = newRefs
end

local function highlightRows(session, keys)
	if not session or session.closing then
		return
	end

	if session.flashTweens then
		for tween, stroke in session.flashTweens do
			tween:Cancel()
			stroke:Destroy()
		end
	end

	session.flashTweens = {}
	local first = session.rows and session.rows[keys[1]]
	local last = session.rows and session.rows[keys[#keys]]
	if not first or not last then
		return
	end

	local scroll = first.Parent
	local midpoint = (first.AbsolutePosition.Y + last.AbsolutePosition.Y + last.AbsoluteSize.Y)
		* 0.5
	local target = scroll.CanvasPosition.Y
		+ midpoint
		- scroll.AbsolutePosition.Y
		- scroll.AbsoluteSize.Y * 0.5
	local maximum = math.max(0, scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteSize.Y)
	scroll.CanvasPosition = Vector2.new(0, math.clamp(target, 0, maximum))

	for _, key in keys do
		local row = session.rows[key]
		local stroke = make("UIStroke", row, "GraphPreferenceHighlight", {
			Color = theme.get("Txt", Color3.new(1, 1, 1)),
			Thickness = 2,
			StrokeSizingMode = Enum.StrokeSizingMode.FixedSize,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		})
		local tween = tweenService:Create(
			stroke,
			TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true, 0.18),
			{ Transparency = 0.55 }
		)
		session.flashTweens[tween] = stroke
		tween.Completed:Once(function()
			session.flashTweens[tween] = nil
			stroke:Destroy()
		end)
		tween:Play()
	end
end

local function openFocused(keys, group)
	local session = editor.open()
	if not session then
		return
	end

	session.selectGroup(group or "All")
	local focusVersion = session.focusVersion
	if not session.graphRaised then
		session.graphRaised = true
		for _, object in { session.window, table.unpack(session.window:GetDescendants()) } do
			if object:IsA("GuiObject") then
				object.ZIndex += 200
			end
		end
	end

	task.delay(0.25, function()
		if
			not session.closing
			and session.window.Parent
			and session.focusVersion == focusVersion
		then
			highlightRows(session, keys)
		end
	end)
	return session
end

function editor.openGraphPreferences()
	return openFocused(
		{ "GraphClamp", "GraphCompressionPercent", "GraphAutoSmoothing" },
		"Graph & Drawing"
	)
end

function editor.openMotionPathPreferences()
	return openFocused({ "MotionPathRange", "MotionPathEachSide" }, "Motion Paths")
end

function editor.openImagePreviewerPreferences()
	return openFocused({ "ImagePreviewerNativeImageScale" })
end

function editor.open()
	if active and not active.closing then
		if active.window.Parent then
			return active
		end

		dispose(active, false)
	end

	local parent = refs.ScreenGui
	if not parent or not parent.Parent then
		return
	end

	local titleTemplate = refs.RigItemTemplate
		and refs.RigItemTemplate:FindFirstChild("Title", true)
	local fontFace = titleTemplate and titleTemplate.FontFace
		or Font.new("rbxasset://fonts/families/RobotoMono.json")
	local window = tag(
		make("Frame", nil, "PreferencesEditor", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(width, height),
			BackgroundColor3 = Color3.fromRGB(22, 16, 28),
			BorderSizePixel = 0,
			Active = true,
			Visible = false,
			ZIndex = 100,
		}),
		"ThemeBg",
		"Bg"
	)
	round(window, 6)
	outline(window)
	local session = {
		window = window,
		connections = {},
		controls = {},
		units = {},
		rows = {},
		flushers = {},
		tips = {},
		tipCleanups = {},
		hoverDialog = nil,
	}

	function session.flush()
		if session.closing then
			return
		end

		for _, flush in session.flushers do
			flush()
		end
	end

	active = session
	sessions[session] = true
	window.Destroying:Once(function()
		dispose(session, false)
	end)

	local function label(parentObject, name, text, position, size)
		return tag(
			make("TextLabel", parentObject, name, {
				Text = text,
				Position = position,
				Size = size,
				BackgroundTransparency = 1,
				FontFace = fontFace,
				TextSize = 14,
				TextColor3 = Color3.fromRGB(230, 223, 238),
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 103,
			}),
			"ThemeTxt",
			"Txt"
		)
	end

	local header = tag(
		make("Frame", window, "Header", {
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundColor3 = Color3.fromRGB(49, 16, 65),
			BorderSizePixel = 0,
			ZIndex = 101,
		}),
		"ThemeBg",
		"Top"
	)
	round(header, 6)
	tag(
		make("Frame", header, "LowerEdge", {
			Position = UDim2.new(0, 0, 1, -6),
			Size = UDim2.new(1, 0, 0, 6),
			BackgroundColor3 = header.BackgroundColor3,
			BorderSizePixel = 0,
			ZIndex = 101,
		}),
		"ThemeBg",
		"Top"
	)
	local title = tag(
		label(header, "Title", "PREFERENCES", UDim2.fromOffset(12, 0), UDim2.new(1, -46, 1, 0)),
		"ThemeTxt",
		"TopT"
	)
	title.TextSize = 15
	local dragHandle = make("TextButton", header, "DragHandle", {
		Text = "",
		Size = UDim2.new(1, -114, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Active = true,
		ZIndex = 104,
	})
	local close = require("chrome").close(header, nil, 105)
	close.AnchorPoint = Vector2.new(0, 0.5)
	close.Position = UDim2.new(1, -30, 0.5, 0)
	local body = tag(
		make("Frame", window, "Body", {
			Position = UDim2.fromOffset(148, 80),
			Size = UDim2.new(1, -158, 1, -90),
			BackgroundColor3 = Color3.fromRGB(15, 12, 19),
			BorderSizePixel = 0,
			ZIndex = 101,
		}),
		"ThemeBg",
		"Pnl"
	)
	round(body, 5)
	outline(body, 0.35)
	local scroll = tag(
		make("ScrollingFrame", body, "Options", {
			Position = UDim2.fromOffset(2, 2),
			Size = UDim2.new(1, -4, 1, -4),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarImageColor3 = Color3.fromRGB(111, 78, 130),
			ZIndex = 102,
		}),
		"ThemeScr",
		"Scr"
	)
	make(
		"UIListLayout",
		scroll,
		"Layout",
		{ Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }
	)
	make("UIPadding", scroll, "Padding", {
		PaddingLeft = UDim.new(0, 5),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
	})
	local search = tag(
		make("TextBox", window, "Search", {
			Position = UDim2.fromOffset(10, 42),
			Size = UDim2.new(1, -20, 0, 28),
			Text = "",
			PlaceholderText = "Search all preferences",
			ClearTextOnFocus = false,
			FontFace = fontFace,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundColor3 = body.BackgroundColor3,
			BorderSizePixel = 0,
			TextColor3 = theme.get("Txt", Color3.new(1, 1, 1)),
			ZIndex = 103,
		}),
		"ThemeBg",
		"Pnl"
	)
	tag(search, "ThemeTxt", "Txt")
	round(search, 4)
	outline(search, 0.35)
	make(
		"UIPadding",
		search,
		"Padding",
		{ PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9) }
	)
	local categories = make("ScrollingFrame", window, "Categories", {
		Position = UDim2.fromOffset(10, 80),
		Size = UDim2.new(0, 128, 1, -90),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 102,
	})
	make(
		"UIListLayout",
		categories,
		"Layout",
		{ Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }
	)
	session.group = "All"
	local groupButtons, sectionHeaders = {}, {}
	local empty = label(
		body,
		"Empty",
		"No matching preferences",
		UDim2.fromOffset(12, 12),
		UDim2.new(1, -24, 0, 24)
	)
	empty.TextSize = 13
	empty.Visible = false

	local function filter()
		hideTip(session)
		local query = search.Text:lower():match("^%s*(.-)%s*$")
		local matches, total = {}, 0
		for _, option in optionsValue do
			local haystack = (option.label .. " " .. option.group .. " " .. (option.tip or "")):lower()
			local match = (session.group == "All" or option.group == session.group)
				and (not option.blenderOnly or preferences.get("BlenderCameraBeta") == true)
				and (not option.dependsOn or preferences.get(option.dependsOn) == true)
			for word in query:gmatch("%S+") do
				if not haystack:find(word, 1, true) then
					match = false
				end
			end

			if option.key == "MotionPathEachSide" then
				local mode = preferences.get("MotionPathRange")
				match = match and (mode == 2 or mode == 3)
				session.rows[option.key].Label.Text = mode == 2 and "Keys each side"
					or "Frames each side"
			end

			if option.key == "MotionPathStart" or option.key == "MotionPathEnd" then
				match = match and preferences.get("MotionPathRange") == 4
			end

			session.rows[option.key].Visible = match
			if match then
				matches[option.group] = true
				total += 1
			end
		end

		for name, header in sectionHeaders do
			header.Visible = matches[name] == true
		end

		for name, button in groupButtons do
			button.SelectionHighlight.Visible = name == session.group
		end

		empty.Visible = total == 0
	end

	function session.selectGroup(name)
		if not groupButtons[name] then
			return
		end

		session.flush()
		session.focusVersion = (session.focusVersion or 0) + 1
		session.group = name
		search.Text = ""
		filter()
		scroll.CanvasPosition = Vector2.zero
	end

	local categoryNames = { "All" }
	for _, group in groups do
		table.insert(categoryNames, group.name)
	end

	for index, name in categoryNames do
		local button = tag(
			make("TextButton", categories, name, {
				Size = UDim2.new(1, -4, 0, 30),
				LayoutOrder = index,
				Text = "",
				BackgroundColor3 = body.BackgroundColor3,
				BorderSizePixel = 0,
				AutoButtonColor = true,
				ZIndex = 102,
			}),
			"ThemeBg",
			"Pnl"
		)
		round(button, 4)
		local selected = tag(
			make("Frame", button, "SelectionHighlight", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = theme.get("MenuSel", Color3.fromRGB(45, 27, 56)),
				BorderSizePixel = 0,
				ZIndex = 103,
			}),
			"ThemeBg",
			"MenuSel"
		)
		round(selected, 4)
		local text = label(button, "Label", name, UDim2.fromOffset(8, 0), UDim2.new(1, -12, 1, 0))
		text.TextSize = 11
		text.ZIndex = 104
		if name == "Blender Familiar" then
			text:SetAttribute("ThemeTxt", nil)
			text.TextColor3 = Color3.fromRGB(234, 118, 0)
		end
		groupButtons[name] = button
		connect(session, button.Activated, function()
			if not session.closing then
				session.selectGroup(name)
			end
		end)
	end

	for index, group in groups do
		local header = label(
			scroll,
			"Section" .. index,
			group.name:upper(),
			UDim2.new(),
			UDim2.new(1, 0, 0, 26)
		)
		header.LayoutOrder = index * 100
		header.TextSize = 12
		header.TextTransparency = 0.25
		if group.blenderFeature then
			header:SetAttribute("ThemeTxt", nil)
			header.TextColor3 = Color3.fromRGB(234, 118, 0)
		end
		sectionHeaders[group.name] = header
	end

	connect(session, search:GetPropertyChangedSignal("Text"), function()
		if session.closing then
			return
		end

		if search.Text ~= "" then
			session.focusVersion = (session.focusVersion or 0) + 1
			session.group = "All"
		end

		filter()
		scroll.CanvasPosition = Vector2.zero
	end)

	local function refresh(key, force)
		local control = session.controls[key]
		if not control or session.closing then
			return
		end

		if control:GetAttribute("PreferenceColor") then
			control.BackgroundColor3 = preferences.color(key)
		elseif key == "DefaultRotationMode" then
			local value = preferences.get(key)
			control.Text = value == "Quaternion" and value .. "  v"
				or "Euler " .. value .. "  v"
		elseif control:IsA("Frame") then
			for _, button in control:GetChildren() do
				button.Highlight.Visible = tonumber(button.Name) == preferences.get(key)
			end
		elseif control:IsA("TextBox") then
			if not control:IsFocused() or force then
				control.Text = tostring(preferences.get(key)) .. (session.units[key] or "")
			end
		else
			control.Mark.Visible = preferences.get(key) == true
		end
	end

	for index, option in optionsValue do
		local unavailable = preferences.unavailableReason(option.key)
		local row = make("Frame", scroll, option.key, {
			Size = UDim2.new(1, 0, 0, 36),
			LayoutOrder = option.order,
			BackgroundTransparency = 1,
			ZIndex = 102,
		})
		session.rows[option.key] = row
		row.Visible = not option.blenderOnly or preferences.get("BlenderCameraBeta") == true
		local optionLabel = label(
			row,
			"Label",
			option.label,
			UDim2.fromOffset(7, 0),
			UDim2.new(1, option.choices and -170 or option.numeric and -134 or -96, 1, 0)
		)
		optionLabel.TextWrapped = true
		if unavailable then
			optionLabel.TextTransparency = 0.55
			optionLabel.TextSize = 12
			optionLabel.Text = option.label .. " (temporarily unavailable)"
		end
		optionLabel.TextYAlignment = Enum.TextYAlignment.Center
		if option.featured then
			buildFeaturedBanner(session, row, function()
				if session.closing or unavailable then
					return
				end

				preferences.set(option.key, preferences.get(option.key) ~= true)
				refresh(option.key)
			end)
			optionLabel.Position += UDim2.fromOffset(6, 0)
			optionLabel.Size -= UDim2.fromOffset(6, 0)
			optionLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
			optionLabel.TextStrokeTransparency = 0.55
		end

		local dependent = option.dependsOn ~= nil or option.blenderOnly == true
		if dependent then
			optionLabel.Position += UDim2.fromOffset(18, 0)
			optionLabel.Size -= UDim2.fromOffset(18, 0)
			tag(
				make("Frame", row, "DependencyLine", {
					Position = UDim2.fromOffset(12, -3),
					Size = UDim2.new(0, 1, 1, 6),
					BackgroundColor3 = theme.get("Strk", theme.panelOutlineDefault()),
					BorderSizePixel = 0,
					Active = false,
					ZIndex = 103,
				}),
				"ThemeBg",
				"Strk"
			)
		end


		if option.key == "ImagePreviewerNativeImageScale" then
			optionLabel.TextWrapped = true
			optionLabel.TextSize = 12
		end

		if option.choiceLabels then
			optionLabel.TextSize = 12
			optionLabel.Size = UDim2.new(1, option.tip and -268 or -242, 1, 0)
		end

		if option.color then
			local button = make("TextButton", row, "ColorSwatch", {
				Position = UDim2.new(1, -32, 0.5, -12),
				Size = UDim2.fromOffset(24, 24),
				Text = "",
				AutoButtonColor = false,
				BorderSizePixel = 0,
				ZIndex = 105,
				BackgroundColor3 = preferences.color(option.key),
			})
			button:SetAttribute("PreferenceColor", true)
			round(button, 4)
			outline(button, 0.2)
			session.controls[option.key] = button
			connect(session, button.Activated, function()
				if session.closing then
					return
				end

				session.colorAnchor = button
				colorPicker.open(
					refs,
					button,
					{ stops = { preferences.color(option.key) }, rot = 0 },

					function(value)
						if not session.closing then
							preferences.set(option.key, value.stops[1])
							refresh(option.key, true)
						end
					end,
					{
						solid = true,
						commitOnDone = true,
						alive = function()
							return not session.closing and button.Parent ~= nil
						end,
					}
				)
			end)
		elseif option.rotationChoice then
			optionLabel.Size = UDim2.new(1, -180, 1, 0)
			optionLabel.TextSize = 12
			local button = tag(
				make("TextButton", row, "RotationChoice", {
					Position = UDim2.new(1, -120, 0.5, -14),
					Size = UDim2.fromOffset(112, 28),
					BackgroundColor3 = body.BackgroundColor3,
					BorderSizePixel = 0,
					FontFace = fontFace,
					TextSize = 12,
					TextColor3 = theme.get("Txt", Color3.new(1, 1, 1)),
					ZIndex = 105,
				}),
				"ThemeBg",
				"Bg"
			)
			button:SetAttribute("ThemeTxt", "Txt")
			round(button, 4)
			outline(button, 0.35)
			session.controls[option.key] = button
			connect(session, button.Activated, function()
				if session.rotationPopup then
					session.rotationPopup:Destroy()
					session.rotationPopup = nil
					return
				end

				local pos = (button.AbsolutePosition - window.AbsolutePosition) / scaleOf(session)
				local popup = tag(
					make("Frame", window, "RotationModes", {
						Position = UDim2.fromOffset(
							pos.X,
							math.max(
								0,
								math.min(pos.Y + 28, window.AbsoluteSize.Y / scaleOf(session) - 202)
							)
						),
						Size = UDim2.fromOffset(112, 196),
						BackgroundColor3 = body.BackgroundColor3,
						BorderSizePixel = 0,
						ZIndex = window.ZIndex + 20,
					}),
					"ThemeBg",
					"Bg"
				)
				session.rotationPopup = popup
				round(popup, 4)
				outline(popup)
				for i, mode in { "Quaternion", "XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX" } do
					local item = tag(
						make("TextButton", popup, mode, {
							Position = UDim2.fromOffset(0, (i - 1) * 28),
							Size = UDim2.fromOffset(112, 28),
							Text = mode == "Quaternion" and mode or "Euler " .. mode,
							BackgroundTransparency = 1,
							FontFace = fontFace,
							TextSize = 12,
							TextColor3 = theme.get("Txt", Color3.new(1, 1, 1)),
							ZIndex = popup.ZIndex + 1,
						}),
						"ThemeTxt",
						"Txt"
					)
					connect(session, item.Activated, function()
						preferences.set(option.key, mode)
						popup:Destroy()
						session.rotationPopup = nil
						refresh(option.key)
					end)
				end

				theme.applyTree(popup)
			end)
		elseif option.choices then
			local choiceWidth = option.choiceLabels and 206 or 98
			local buttonWidth = option.choiceLabels
					and (choiceWidth - 4 * (#option.choices - 1)) / #option.choices
				or 30
			local choices = make("Frame", row, "Choices", {
				Position = UDim2.new(1, -choiceWidth - 8, 0.5, -14),
				Size = UDim2.fromOffset(choiceWidth, 28),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 103,
			})
			session.controls[option.key] = choices
			for index, value in option.choices do
				local button = tag(
					make("TextButton", choices, tostring(value), {
						Position = UDim2.fromOffset((index - 1) * (buttonWidth + 4), 0),
						Size = UDim2.fromOffset(buttonWidth, 28),
						Text = "",
						BackgroundColor3 = Color3.fromRGB(45, 27, 56),
						BorderSizePixel = 0,
						AutoButtonColor = true,
						ZIndex = 103,
					}),
					"ThemeBg",
					"TopBtn"
				)
				round(button, 4)
				outline(button, 0.35)
				local highlight = tag(
					make("Frame", button, "Highlight", {
						Size = UDim2.fromScale(1, 1),
						BackgroundColor3 = Color3.fromRGB(100, 0, 151),
						BorderSizePixel = 0,
						ZIndex = 104,
					}),
					"ThemeBg",
					"MenuSel"
				)
				round(highlight, 4)
				outline(highlight, 0)
				local text = label(
					button,
					"Number",
					option.choiceLabels and option.choiceLabels[index] or tostring(value),
					UDim2.new(),
					UDim2.fromScale(1, 1)
				)
				text.TextSize = option.choiceLabels and 11 or 15
				text.TextXAlignment = Enum.TextXAlignment.Center
				text.ZIndex = 105
				connect(session, button.Activated, function()
					if session.closing then
						return
					end

					preferences.set(option.key, value)
					refresh(option.key)
				end)
			end
		elseif option.numeric then
			local shell = tag(
				make("Frame", row, "Input", {
					Position = UDim2.new(1, -70, 0.5, -14),
					Size = UDim2.fromOffset(62, 28),
					BackgroundColor3 = Color3.fromRGB(22, 16, 28),
					BorderSizePixel = 0,
					ZIndex = 103,
				}),
				"ThemeBg",
				"Bg"
			)
			round(shell, 4)
			outline(shell)
			local box = tag(
				make("TextBox", shell, "Value", {
					Position = UDim2.fromOffset(5, 2),
					Size = UDim2.new(1, -10, 1, -4),
					Text = "",
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					FontFace = fontFace,
					TextSize = 15,
					TextColor3 = Color3.fromRGB(230, 223, 238),
					ClearTextOnFocus = true,
					TextXAlignment = Enum.TextXAlignment.Center,
					ZIndex = 104,
				}),
				"ThemeTxt",
				"Txt"
			)
			box.TextScaled = true
			make(
				"UITextSizeConstraint",
				box,
				"TextSizeLimit",
				{ MinTextSize = 10, MaxTextSize = 15 }
			)
			session.controls[option.key] = box
			session.units[option.key] = option.unit
			connect(session, box.Focused, function()
				box.Text = ""
			end)

			local function flush()
				if session.closing then
					return
				end

				local text = box.Text:gsub("%%%s*$", ""):gsub("px%s*$", "")
				local value = tonumber(text)
				if value and value == value and math.abs(value) < math.huge then
					preferences.set(option.key, value)
				end

				refresh(option.key, true)
			end

			table.insert(session.flushers, flush)
			require("numericInput").bind(box, {
				step = option.step
					or (
						(
								option.unit == "%"
								or option.unit == "px"
								or option.key == "FrameStep"
								or option.key == "KeyframeJumpStep"
								or option.key == "DefaultFPS"
								or option.key == "CameraPreviewFPS"
								or option.key == "DefaultTrackLength"
							)
							and 1
						or 0.1
					),
				min = option.min,
				max = option.max,
			})
			connect(session, box.FocusLost, flush)
		else
			local toggle = tag(
				make("TextButton", row, "Toggle", {
					Position = UDim2.new(1, -32, 0.5, -12),
					Size = UDim2.fromOffset(24, 24),
					Text = "",
					BackgroundColor3 = Color3.fromRGB(45, 27, 56),
					BorderSizePixel = 0,
					AutoButtonColor = true,
					ZIndex = 103,
				}),
				"ThemeBg",
				"TopBtn"
			)
			round(toggle, 4)
			outline(toggle, 0.35)
			local mark = tag(make("ImageLabel", toggle, "Mark", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(16, 14),
				BackgroundTransparency = 1,
				Image = "rbxasset://studio_svg_textures/Shared/Ribbon/Dark/Standard/Checkmark@3x.png",
				ImageRectOffset = Vector2.new(10, 12),
				ImageRectSize = Vector2.new(28, 24),
				ImageColor3 = Color3.fromRGB(230, 223, 238),
				ZIndex = 104,
			}), "ThemeImg", "Txt")
			session.controls[option.key] = toggle
			if unavailable then
				toggle.Active, toggle.Interactable, toggle.Selectable = false, false, false
				toggle.AutoButtonColor = false
				toggle.BackgroundTransparency = 0.65
			end
			connect(session, toggle.Activated, function()
				if session.closing or unavailable then
					return
				end

				local enabling = preferences.get(option.key) ~= true
				local saved = preferences.set(option.key, enabling)
				if saved and enabling and option.key == "HideAnimatorDuringTransform" then
					require("notification").show("HIDE ANIMATOR", "Will not affect undocked mode.", 5)
				end

				if saved and enabling and option.key == "AutomaticOnionSkin" then
					require("notification").show(
						"POSE GHOSTS",
						"May cause performance issues. Disable if on a lower-end device.",
						5
					)
				end

				if saved and enabling and option.key == "BlenderCameraBeta" then
					local tip = editor.blenderSuggestion()
					if tip then
						require("notification").show("BLENDER CAMERA", tip, 10)
					end
				end

				refresh(option.key)
			end)
		end

		local reset = tag(
			make("ImageButton", row, "Reset", {
				Position = UDim2.new(
					1,
					option.rotationChoice and -150
						or option.choiceLabels and -240
						or option.choices and -132
						or option.numeric and -96
						or -58,
					0.5,
					-9
				),
				Size = UDim2.fromOffset(18, 18),
				Image = resetIcon,
				ImageColor3 = Color3.fromRGB(230, 223, 238),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 104,
			}),
			"ThemeImg",
			"Txt"
		)
		if unavailable then
			reset.Active, reset.Interactable, reset.Selectable = false, false, false
			reset.AutoButtonColor = false
			reset.ImageTransparency = 0.65
		end
		local default = preferences.defaults()[option.key]
		table.insert(session.tips, {
			button = reset,
			text = "Reset to default: " .. tostring(default) .. (option.unit or ""),
		})
		connect(session, reset.Activated, function()
			if session.closing or unavailable then
				return
			end

			local control = session.controls[option.key]
			if colorPicker.isOpen(control) then
				colorPicker.close(true)
			end

			if control:IsA("TextBox") and control:IsFocused() then
				control:ReleaseFocus()
			end

			preferences.set(option.key, default)
			refresh(option.key, true)
		end)
		if option.tip then
			local info = tag(
				make("TextButton", row, "Info", {
					Position = UDim2.new(
						1,
						option.rotationChoice and -176
							or option.choiceLabels and -266
							or option.choices and -158
							or option.numeric and -122
							or -84,
						0.5,
						-9
					),
					Size = UDim2.fromOffset(18, 18),
					Text = "i",
					FontFace = fontFace,
					TextSize = 13,
					TextColor3 = Color3.fromRGB(230, 223, 238),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ZIndex = 104,
				}),
				"ThemeTxt",
				"Txt"
			)
			round(info, 9)
			outline(info, 0.35)
			table.insert(session.tips, { button = info, text = option.tip })
		end

		if option.blenderFeature then
			for _, text in row:GetDescendants() do
				if text:IsA("TextLabel") or text:IsA("TextButton") or text:IsA("TextBox") then
					text:SetAttribute("ThemeTxt", nil)
					text.TextColor3 = Color3.fromRGB(234, 118, 0)
				elseif text:IsA("ImageLabel") and text.Name == "Mark" then
					text:SetAttribute("ThemeImg", nil)
					text.ImageColor3 = Color3.fromRGB(234, 118, 0)
				end
			end
		end

		refresh(option.key)
	end

	session.unsubscribe = preferences.subscribe(function(key)
		refresh(key)
		if
			key == "BlenderCameraBeta"
			or key == "HideAnimatorDuringTransform"
			or key == "MotionPathRange"
		then
			hideTip(session)
			filter()
		end
	end)
	filter()
	connect(session, close.Activated, editor.close)
	connect(session, scroll:GetPropertyChangedSignal("CanvasPosition"), function()
		hideTip(session)
	end)
	connect(session, userInputService.InputBegan, function(input)
		if shortcuts.matches("Cancel", input) then
			if session.colorAnchor and colorPicker.isOpen(session.colorAnchor) then
				colorPicker.cancel()
				return
			end

			editor.close()
		end
	end)
	window.Parent = parent
	if refs.HoverDialog and refs.HoverDialog.ui and refs.HoverDialog.mouse then
		local tip = refs.HoverDialog.ui:Clone()
		tip.Name = "PreferenceInformation"
		tip.Visible = false
		local label = tip:FindFirstChild("Information")
		if label then
			local limit = label:FindFirstChild("TooltipSizeLimit")
			if limit then
				limit:Destroy()
			end

			for property, value in refs.HoverDialog.labelDefaults or {} do
				label[property] = value
			end
		end

		tip.Parent = window
		session.hoverDialog = require("HoverDialog").initialize(tip, refs.HoverDialog.mouse)
	end

	require("tool").attachPopup(
		window,
		header,
		refs,
		"PreferencesEditor",
		"PREFERENCES",
		Vector2.new(width, 320),
		editor.close
	)
	bindDrag(session, dragHandle)
	for _, tip in session.tips do
		bindTip(session, tip.button, tip.text)
	end

	theme.applyTree(window)
	task.defer(function()
		if session.closing or not window.Parent then
			return
		end

		place(session, restingPosition(session))
		window.Visible = true
		windowFx.pop(window, "batch")
	end)
	return session
end

function editor.close()
	local session = active
	if not session or session.closing then
		return
	end

	session.flush()
	local focused = userInputService:GetFocusedTextBox()
	if focused and focused:IsDescendantOf(session.window) then
		focused:ReleaseFocus()
	end

	session.closing = true
	active = nil
	hideTip(session)
	disconnect(session)
	for _, object in session.window:GetDescendants() do
		if object:IsA("GuiButton") then
			object.Interactable = false
		end

		if object:IsA("TextBox") then
			object.TextEditable = false
		end
	end

	windowFx.shrink(session.window, function()
		dispose(session, true)
	end, "batch")
end

function editor.destroy()
	local pending = {}
	for session in sessions do
		table.insert(pending, session)
	end

	for _, session in pending do
		if not session.closing and session.flush then
			session.flush()
		end

		dispose(session, true)
	end

	active = nil
end

return editor
]]></ProtectedString>
						<string name="ScriptGuid">{131AA3D9-26B2-488C-AE24-65191D8769D8}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">preferencesEditor</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1F07FFFDABD1408082C329676426CB49">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local events = require("events")
local faces = require("faces")
local playback = require("eventPlayback")

local cameraRig = require("cameraRig")
local tracks = require("properties")
local partRig = require("partRig")
local tool = require("tool")
local history = require("history")
local theme = require("theme")
local notification = require("notification")
local edit = require("blenderEdit")
local settings = {}
local refs, window, owner
local unsubscribe

function settings.close()
	require("propertyBatch").close()
	if unsubscribe then
		unsubscribe()
		unsubscribe = nil
	end

	owner = nil
	if window then
		local old = window
		window = nil
		old:close()
	end
end

function settings.openBatch(rig)
	settings.close()
	require("propertyBatch").open(refs, rig)
end

function settings.recordSelected()
	if not refs or not refs.Active() or edit.blocked() then
		return 0
	end

	local motors = {}
	for item in refs.State.Rig._selectedItems do
		local motor = item:fetchMotor()
		if tracks.is(motor) then
			table.insert(motors, motor)
		end
	end

	if #motors == 0 then
		return 0
	end

	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local before, after = {}, {}
	for _, motor in motors do
		before[motor] = timeline:_snapshotMotorBucket(motor)
		local value = tracks.readValue(motor.Rig, motor.PropertyId)
		timeline:RecordKeyframeForMotorAtCurrentTime(
			motor.Part1,
			motor,
			tracks.encode(value),
			{ PropertyValue = value },
			refs.State.UIHelpers.SanitizeName
		)
		after[motor] = timeline:_snapshotMotorBucket(motor)
	end

	local function apply(data)
		for motor, bucket in data do
			timeline:_restoreMotorBucket(motor, bucket)
		end

		for _, rig in refs.State.getAllRigs() do
			timeline:ApplyPoseAtTime(rig, raw.CurrentTime, { OnlyRig = true })
		end

		refs.State.currentProjectSaved = false
	end

	refs.State.currentProjectSaved = false
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Record properties")
	return #motors
end

local function addKey(motor, firstFree)
	if
		not refs
		or not refs.Active()
		or edit.blocked()
		or not tracks.is(motor)
		or not motor.Parent
		or not tracks.enabled(motor.Rig, motor.PropertyId)
	then
		return
	end

	refs.Finalize()
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local frame = math.max(0, timeline:TimeToFrame(raw.CurrentTime))
	local bucket = raw.Keyframes[motor] or {}
	while firstFree and bucket[frame] do
		frame += 1
	end

	local value = tracks.readValue(motor.Rig, motor.PropertyId)
	local before = timeline:_snapshotMotorBucket(motor)
	timeline:EnsureTimelineEnd(frame)
	timeline:RecordKeyframeForMotorAtCurrentTime(
		motor.Part1,
		motor,
		tracks.encode(value),
		{ Frame = frame, PropertyValue = value },
		refs.State.UIHelpers.SanitizeName
	)
	local after = timeline:_snapshotMotorBucket(motor)

	local function apply(data)
		if not motor.Parent then
			return
		end

		timeline:_restoreMotorBucket(motor, data)
		timeline:ApplyPoseAtTime(motor.Rig, raw.CurrentTime, { OnlyRig = true })
		refs.State.currentProjectSaved = false
	end

	refs.State.currentProjectSaved = false
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Add " .. motor.PropertyId .. " key")
	return frame
end

function settings.addFirstFreeKey(motor)
	return addKey(motor, true)
end

function settings.addAtCurrentTime(motor)
	return addKey(motor, false)
end

function settings.setEnabled(rig, id, enabled)
	assert(not edit.blocked(), "Finish the current edit before changing properties")
	refs.Finalize()
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local before = tracks.snapshot(rig, raw, true)
	tracks.enable(rig, id, enabled, raw)
	local after = tracks.snapshot(rig, raw, true)

	local function apply(data)
		tracks.restore(rig, data, timeline, refs.State.UIHelpers.SanitizeName)
		refs.RefreshStructure()
		timeline:ApplyPoseAtTime(rig, raw.CurrentTime, { OnlyRig = true })
		refs.State.currentProjectSaved = false
	end

	apply(after)
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Toggle " .. id .. " property")
end

function settings.setTrackEnabled(rig, id, enabled)
	assert(id == "Events" or id == "Faces", "Unknown item track")
	refs.Finalize()
	local track = events.get(rig)
	local before = events.snapshot(track)
	local field = id == "Events" and "Enabled" or "FacesEnabled"
	local after = events.snapshot(track)
	after[field] = enabled ~= false

	local function apply(value)
		events.restore(track, value)
		if id == "Events" then
			playback.disable()
		end

		refs.RefreshStructure()
		refs.State.Timeline:ApplyPoseAtTime(rig, refs.State.Timeline:GetState().CurrentTime)
	end

	apply(after)
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Toggle " .. id)
end

function settings.setPartTracks(rig, enabled)
	assert(not edit.blocked(), "Finish the current edit first")
	refs.Finalize()
	local before = rig:GetAttribute("EclipseIndividualParts")

	local function apply(value)
		rig:SetAttribute("EclipseIndividualParts", value)
		refs.RefreshStructure()
		refs.State.currentProjectSaved = false
	end

	apply(enabled)
	history.record(function()
		apply(before)
	end, function()
		apply(enabled)
	end, "Toggle individual parts")
end

local function missing(rig)
	return typeof(rig) == "Instance" and not rig:IsDescendantOf(game)
end

local function placeholder(rig)
	for _, record in refs.State.MissingRigEntries or {} do
		if record.holder == rig then
			return true
		end
	end

	return false
end

local function restoreMissing(rig)
	assert(not edit.blocked(), "Finish the current edit first")
	assert(
		missing(rig) and table.find(refs.State.getProjectRigs(), rig),
		"This item is no longer missing"
	)
	refs.Finalize()
	local before = rig.Parent
	local function place(parent)
		rig.Parent = parent
		if parent and cameraRig.isRig(rig) then
			cameraRig.organize(rig, require("project").getProjectExportName())
		end

		refs.RefreshStructure()
		local timeline = refs.State.Timeline
		if rig:IsDescendantOf(workspace) then
			timeline:ApplyPoseAtTime(rig, timeline:GetState().CurrentTime)
		end

		refs.State.currentProjectSaved = false
	end

	place(workspace)
	local after = rig.Parent
	history.record(function()
		place(before)
	end, function()
		place(after)
	end, "Restore " .. rig.Name)
end

local function openMissing(rig)
	settings.close()
	owner = rig
	local restorable = not placeholder(rig)
	window = tool.new(
		refs,
		"EclipseItemSettings",
		"MISSING ITEM",
		Vector2.new(290, restorable and 176 or 146),
		false,
		function()
			window = nil
			owner = nil
		end
	)
	local frame = window.frame
	local title =
		tool.label(frame, "Item", rig.Name, UDim2.fromOffset(12, 33), UDim2.new(1, -24, 0, 21))
	title.TextWrapped = false
	title.TextTruncate = Enum.TextTruncate.AtEnd
	local note = tool.label(
		frame,
		"Note",
		restorable and "This item was deleted from the place. Its keys are kept."
			or "This saved item isn't in the place. Its keys are kept and saved.",
		UDim2.fromOffset(12, 58),
		UDim2.new(1, -24, 0, 34)
	)
	note.TextWrapped = true
	note.TextTransparency = 0.25
	if restorable then
		tool.button(
			frame,
			"RestoreRig",
			"RESTORE TO WORKSPACE",
			UDim2.new(0, 12, 1, -66),
			UDim2.new(1, -24, 0, 24),
			function()
				settings.close()
				local ok, err = pcall(restoreMissing, rig)
				if not ok then
					notification.show("RESTORE", (tostring(err):gsub("^.-:%d+: ", "")))
				end
			end
		)
	end

	local _, label = tool.button(
		frame,
		"DeleteRig",
		"REMOVE FROM ANIMATION",
		UDim2.new(0, 12, 1, -36),
		UDim2.new(1, -24, 0, 24),
		function()
			settings.close()
			refs.Remove(rig)
		end
	)
	label:SetAttribute("ThemeTxt", nil)
	label.TextColor3 = Color3.fromRGB(245, 135, 148)
	theme.applyTree(frame)
end

function settings.open(rig)
	if
		refs
		and refs.Active()
		and refs.Remove
		and missing(rig)
		and table.find(refs.State.getProjectRigs(), rig)
	then
		local ok, err = pcall(openMissing, rig)
		if not ok then
			warn("Eclipse could not open the missing item menu:", err)
			settings.close()
			notification.show("ITEM SETTINGS", "Could not open this item's settings. Its keys are still kept.")
		end

		return
	end

	if not refs or not refs.Active() or not table.find(refs.State.getAllRigs(), rig) then
		return
	end

	settings.close()
	owner = rig
	local camera = cameraRig.isRig(rig)
	local definitions = camera
			and {
				{ id = "EclipseTrackTarget", label = "Track CamTarget" },
				{ id = "EclipseHideCamTarget", label = "Hide CamTarget" },
			}
		or tracks.catalog(rig)
	for i = #definitions, 1, -1 do
		if definitions[i].hidden then
			table.remove(definitions, i)
		end
	end

	table.insert(definitions, 1, { id = "Events", label = "Events" })
	if faces.supports(rig) then
		table.insert(definitions, 2, { id = "Faces", label = "Faces" })
	end

	local trackCount = faces.supports(rig) and 2 or 1
	if partRig.supports(rig) then
		trackCount += 1
		table.insert(
			definitions,
			trackCount,
			{ id = "IndividualParts", label = "Individual parts" }
		)
	end

	local hasProperties = #definitions > trackCount
	local height = 116
		+ math.clamp(#definitions, 1, 9) * 27
		+ 22
		+ (hasProperties and 32 or 0)
		+ (camera and 60 or 0)
	window = tool.new(
		refs,
		"EclipseItemSettings",
		"ITEM SETTINGS",
		Vector2.new(290, height),
		false,

		function()
			if unsubscribe then
				unsubscribe()
				unsubscribe = nil
			end

			window = nil
			owner = nil
		end
	)
	local frame = window.frame
	local title =
		tool.label(frame, "Item", rig.Name, UDim2.fromOffset(12, 33), UDim2.new(1, -24, 0, 21))
	title.TextWrapped = false
	title.TextTruncate = Enum.TextTruncate.AtEnd
	local divider = tool.make("Frame", frame, "Divider", {
		Position = UDim2.fromOffset(12, 61),
		Size = UDim2.new(1, -24, 0, 1),
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(69, 41, 93),
	})
	divider:SetAttribute("ThemeBg", "Strk")
	local list = tool.make("ScrollingFrame", frame, "Properties", {
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 1, camera and -176 or hasProperties and -146 or -116),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
	})
	tool.make(
		"UIListLayout",
		list,
		"Rows",
		{ Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }
	)
	if #definitions == 0 then
		tool.label(
			list,
			"Empty",
			"No additional properties",
			UDim2.fromOffset(0, 0),
			UDim2.new(1, 0, 0, 24)
		)
	end

	local function section(name, order)
		local header = tool.make(
			"Frame",
			list,
			name .. "Section",
			{ Size = UDim2.new(1, -6, 0, 20), BackgroundTransparency = 1, LayoutOrder = order }
		)
		local label = tool.label(
			header,
			"Title",
			string.upper(name),
			UDim2.fromOffset(1, 0),
			UDim2.new(1, 0, 1, 0)
		)
		label.TextSize = 10
		label.TextTransparency = 0.35
	end

	section("Tracks", 0)
	if hasProperties then
		local divider = tool.make("Frame", list, "PropertyDivider", {
			Size = UDim2.new(1, -6, 0, 1),
			BorderSizePixel = 0,
			LayoutOrder = trackCount * 10 + 1,
		})
		divider:SetAttribute("ThemeBg", "Strk")
		section(camera and "Camera target" or "Properties", trackCount * 10 + 2)
	end

	local rows = {}

	local function refresh()
		for id, row in rows do
			local enabled = id == "Events" and events.get(rig).Enabled ~= false
				or id == "Faces" and events.get(rig).FacesEnabled == true
				or id ~= "Events"
					and id ~= "Faces"
					and (camera and rig:GetAttribute(id) == true or not camera and tracks.enabled(
						rig,
						id
					))
			local checked = id == "IndividualParts"
					and partRig.enabled(rig, refs.State.Timeline:GetState())
				or id ~= "IndividualParts" and enabled
			row.check.Visible = checked
			row.label.TextTransparency = checked and 0 or 0.2
		end
	end

	for index, def in definitions do
		local button = tool.make("TextButton", list, def.id, {
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			BackgroundColor3 = Color3.fromRGB(51, 0, 77),
			Size = UDim2.new(1, -6, 0, 24),
			LayoutOrder = index * 10,
		})
		local box = tool.make("Frame", button, "Checkbox", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 1, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.fromRGB(51, 0, 77),
		})
		box:SetAttribute("ThemeBg", "TopBtn")
		local stroke = tool.make("UIStroke", box, "Outline", {
			Color = Color3.fromRGB(69, 41, 93),
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		})
		stroke:SetAttribute("ThemeStrk", "Strk")
		local check =
			tool.label(box, "Check", "X", UDim2.fromOffset(0, -1), UDim2.fromScale(1, 1))
		check.TextXAlignment = Enum.TextXAlignment.Center
		check.TextSize = 14
		if def.id == "Events" or def.id == "Faces" then
			local icon = tool.make("ImageLabel", button, "Icon", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(26, 4),
				Size = UDim2.fromOffset(16, 16),
				Image = def.id == "Faces" and faces.ICON or "",
				ImageColor3 = theme.get("Txt", Color3.new(1, 1, 1)),
			})
			if def.id == "Events" then
				require("eventIcons").attach(icon, "track")
			else
				faces.attach(icon)
			end
		end

		local label =
			tool.label(button, "Label", def.label, UDim2.fromOffset(26, 0), UDim2.new(1, -26, 1, 0))
		label.TextWrapped = false
		if def.id == "Events" or def.id == "Faces" then
			label.Position = UDim2.fromOffset(48, 0)
			label.Size = UDim2.new(1, -48, 1, 0)
		end

		rows[def.id] = { check = check, label = label }
		button.MouseEnter:Connect(function()
			button.BackgroundTransparency = 0.5
		end)
		button.MouseLeave:Connect(function()
			button.BackgroundTransparency = 1
		end)
		button:SetAttribute("ThemeBg", "TopBtn")
		button.Activated:Connect(function()
			if tracks.required(rig, def.id) then
				return
			end

			if not rig.Parent or not table.find(refs.State.getAllRigs(), rig) then
				settings.close()
				return
			end

			local ok, err
			if def.id == "Events" or def.id == "Faces" then
				local track = events.get(rig)
				local value = if def.id == "Events" then track.Enabled else track.FacesEnabled
				ok, err = pcall(settings.setTrackEnabled, rig, def.id, value == false)
			elseif def.id == "IndividualParts" then
				ok, err = pcall(function()
					settings.close()
					require("partRigging").open(rig)
				end)
			elseif camera then
				ok, err = pcall(
					require("targets").setOption,
					rig,
					def.id,
					rig:GetAttribute(def.id) ~= true
				)
			else
				ok, err = pcall(settings.setEnabled, rig, def.id, not tracks.enabled(rig, def.id))
			end

			if ok then
				refresh()
			else
				notification.show("PROPERTY", (tostring(err):gsub("^.-:%d+: ", "")))
			end
		end)
	end

	refresh()
	unsubscribe = history.subscribe(function()
		if owner ~= rig then
			return
		end

		if not rig.Parent or not table.find(refs.State.getAllRigs(), rig) then
			settings.close()
			return
		end

		refresh()
	end)
	if hasProperties and not camera then
		tool.button(frame, "AddProperties", "ADD MULTIPLE PROPERTIES...",
			UDim2.new(0, 12, 1, -66), UDim2.new(1, -24, 0, 24), function()
				settings.openBatch(rig)
			end)
	end
	if camera then
		tool.button(
			frame,
			"AttachToPart",
			"ATTACH TO PART...",
			UDim2.new(0, 12, 1, -96),
			UDim2.new(1, -24, 0, 24),

			function()
				settings.close()
				require("targets").openCameraAttachment(rig)
			end
		)
	end

	if camera then
		tool.button(
			frame,
			"ParentTarget",
			"PARENT AT CURRENT FRAME...",
			UDim2.new(0, 12, 1, -66),
			UDim2.new(1, -24, 0, 24),

			function()
				settings.close()
				require("targets").openParent(rig)
			end
		)
	end

	local button, label = tool.button(
		frame,
		"DeleteRig",
		"REMOVE FROM ANIMATION",
		UDim2.new(0, 12, 1, -36),
		UDim2.new(1, -24, 0, 24),

		function()
			settings.close()
			refs.Remove(rig)
		end
	)
	label:SetAttribute("ThemeTxt", nil)
	label.TextColor3 = Color3.fromRGB(245, 135, 148)
	theme.applyTree(frame)
end

function settings.setFaceValue(rig, id, value)
	assert(refs and refs.Active() and not edit.blocked(), "Finish the current edit first")
	assert(tracks.faceControls(rig), "This rig has no dynamic head")
	local definition = tracks.definition(rig, id)
	assert(
		definition
			and definition.facial
			and typeof(value) == "number"
			and value == value
			and value >= 0
			and value <= 1,
		"Enter a value from 0 to 1"
	)
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	assert(not raw.Playing, "Pause playback to edit the face")
	local motor = tracks.enable(rig, id, true, raw)
	local before = timeline:_snapshotMotorBucket(motor)
	local frame = timeline:TimeToFrame(raw.CurrentTime)
	timeline:RecordKeyframeForMotorAtCurrentTime(
		motor.Part1,
		motor,
		tracks.encode(value),
		{ Frame = frame, PropertyValue = value },
		refs.State.UIHelpers.SanitizeName
	)
	local after = timeline:_snapshotMotorBucket(motor)
	local function apply(bucket)
		timeline:_restoreMotorBucket(motor, bucket)
		timeline:ApplyPoseAtTime(rig, raw.CurrentTime, { OnlyRig = true })
		refs.State.currentProjectSaved = false
	end
	apply(after)
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Edit " .. definition.label, frame)
	return motor
end

function settings.openFaceControls(rig)
	return require("poseSliders").toggleFace(rig)
end

function settings.init(options)
	refs = options
	require("targets").init(options)
	require("cameraParts").init(options)
	options.State.PropertySettings = settings
	options.ScreenGui.Destroying:Once(settings.close)
	options.Plugin.Unloading:Once(settings.close)
	options.AnimatorFrame:GetPropertyChangedSignal("Visible"):Connect(function()
		if not options.AnimatorFrame.Visible then
			settings.close()
		end
	end)
end

return settings
]]></ProtectedString>
						<string name="ScriptGuid">{A1BB2C7D-3BF3-47D3-905E-7E64DA7BC028}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">propertySettings</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXEB97114D2F3241DE8D1CF2A49F783009">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local preferences = require("preferences")
local propertyGizmo = require("propertyGizmo")
local tracks = require("properties")
local policy = require("policy")
local edit = require("blenderEdit")
local armatureModule = require("armatureRuntime")
local history = require("history")
local notification = require("notification")
local scale = {}
local refs, selected, active = nil, nil, false
local selecting = false

function scale.isActive()
	return active and preferences.get("ScaleGizmo") ~= false
end

local function adapter(motor)
	if not motor or not motor.Parent or tracks.is(motor) then
		return nil
	end

	local part = motor.Part1
	if
		typeof(part) ~= "Instance"
		or not part:IsA("BasePart")
		or not policy.channelAvailable(motor, "scale_x")
	then
		return nil
	end

	if typeof(motor) == "table" and (motor.IsEclipseMasterControl or motor.IsTranslationOnly) then
		return nil
	end

	local state = refs.State
	local timeline, rig = state.Timeline, state.currentRig
	local raw = timeline:GetState()
	local base = raw.DefaultSize[part]
	if not base then
		return nil
	end

	local armature = typeof(motor) == "table" and motor.IsEclipseArmatureControl
	local target = {
		IsEclipseScaleAdapter = true,
		Parent = part.Parent,
		Rig = part,
		Part1 = part,
		PropertyId = "Size",
		DefaultValue = base * (armature and 1 or tracks.scaleFactor(motor)),
	}

	function target.read()
		return armature and (motor.InputScale or Vector3.one) * base or part.Size
	end

	function target.capture()
		return {
			c0 = motor.C0,
			cf = part.CFrame,
			edit = armature and armatureModule.captureEdit(motor) or nil,
			bucket = timeline:_snapshotMotorBucket(motor),
		}
	end

	function target.write(value, saved, offset)
		if not part.Parent or not motor.Parent then
			return
		end

		local placement = saved and saved.placement
		if armature then
			motor.InputScale = armatureModule.constrainScale(motor, value / base)
			if placement and placement.edit then
				motor.C0 = placement.c0
				armatureModule.evaluate(rig, true)
				local shift = placement.cf.Position + (offset or Vector3.zero) - part.Position
				motor.C0 = armatureModule.solveEditC0(motor, placement.edit.world + shift, placement.edit)
			end

			armatureModule.evaluate(rig, true)
		else
			part.Size = value
			if placement then
				local shift = offset or Vector3.zero
				motor.C0 = placement.c0 + motor.Part0.CFrame:VectorToObjectSpace(shift)
				part.CFrame = placement.cf + shift
			end
		end
	end

	function target.finish(saved, cancel)
		if not part.Parent or not motor.Parent then
			return
		end

		local value = target.read()
		local pose = target.capture()
		local original = saved.placement or pose

		local function restorePose(size, placement)
			target.write(size)
			motor.C0 = placement.c0
			if armature then
				if placement.edit then
					armatureModule.restoreEdit(motor, placement.edit)
				end

				armatureModule.evaluate(rig, true)
			else
				part.CFrame = placement.cf
			end

			require("resize").syncBones(state, part)
		end

		if cancel then
			restorePose(saved.value, original)
			return
		end

		if (value - saved.value).Magnitude < 1e-6 and pose.c0 == original.c0 then
			return
		end

		require("humanoidScale").changed(motor)
		if timeline:IsRecording() then
			local before = original.bucket or timeline:_snapshotMotorBucket(motor)
			local channels = { "scale_x", "scale_y", "scale_z" }
			if pose.c0 ~= original.c0 then
				for _, id in { "loc_x", "loc_y", "loc_z" } do
					table.insert(channels, id)
				end
			end

			timeline:RecordPartialKeyframeForMotorAtCurrentTime(
				part,
				motor,
				motor.C0,
				channels,
				state.UIHelpers.SanitizeName,
				{ Frame = saved.frame }
			)
			local after = timeline:_snapshotMotorBucket(motor)

			local function restore(bucket)
				if not motor.Parent then
					return
				end

				timeline:_restoreMotorBucket(motor, bucket)
				timeline:ApplyPoseAtTime(rig, raw.CurrentTime, { OnlyRig = true })
				state.currentProjectSaved = false
			end

			history.record(function()
				restore(before)
			end, function()
				restore(after)
			end, "Scale " .. part.Name, saved.frame)
		else
			local function restore(size, placement)
				restorePose(size, placement)
				state.currentProjectSaved = false
			end

			history.record(function() end, function() end, "Scale " .. part.Name, {
				afterUndo = function()
					restore(saved.value, original)
				end,
				afterRedo = function()
					restore(value, pose)
				end,
			})
		end

		state.currentProjectSaved = false
		state.lastCFrames[motor] = motor.C0
	end

	return target
end

local function show()
	if not scale.isActive() then
		propertyGizmo.select(selected)
		return false
	end

	local target
	local part = selected and (tracks.is(selected) and selected.Rig or selected.Part1)
	local mesh = typeof(part) == "Instance"
		and part:IsA("BasePart")
		and part:FindFirstChildWhichIsA("DataModelMesh")
	if mesh and tracks.definition(mesh, "Scale") then
		local project = refs.State.currentRig

		selecting = true
		local ok, err = xpcall(function()
			if not table.find(refs.State.getAllRigs(), mesh) then
				refs.AddRig(mesh, { Loading = true, MeshScaleTarget = true })
			end

			if not table.find(refs.State.getAllRigs(), mesh) then
				return
			end

			target = tracks.enable(mesh, "Scale", true, refs.State.Timeline:GetState())
			require("resize").prepare(mesh)
			if not active or refs.State.currentRig ~= project or not mesh.Parent then
				target = nil
				return
			end

			if refs.RefreshStructure then
				refs.RefreshStructure()
			end
		end, debug.traceback)
		selecting = false
		if not ok then
			error(err)
		end
	elseif
		tracks.is(selected)
		and (
			selected.Rig:IsA("BasePart")
			or selected.Rig:IsA("Model")
			or selected.Rig:IsA("DataModelMesh")
		)
	then
		local id = selected.Rig:IsA("BasePart") and "Size" or "Scale"
		local enabled = tracks.enabled(selected.Rig, id)
		target = tracks.enable(selected.Rig, id, true, refs.State.Timeline:GetState())
		if not enabled then
			refs.State.currentProjectSaved = false
			if refs.RefreshStructure then
				refs.RefreshStructure()
			end
		end

		if selected.Rig:IsA("DataModelMesh") then
			require("resize").prepare(selected.Rig)
		end
	else
		target = adapter(selected)
	end

	if not active then
		target = nil
	end

	propertyGizmo.select(target)
	refs.State.Axis:RefreshAxis()
	return target ~= nil
end

function scale.select(motor, group)
	if group and #group > 1 then
		if selecting then
			return
		end
		propertyGizmo.finish(true)
		selected, active = motor, false
		propertyGizmo.select(motor, group)
		return
	end
	if selecting then
		return
	end

	if selected == motor then
		if not active then
			propertyGizmo.select(motor)
		end

		return
	end

	selected = motor
	show()
end

function scale.disable()
	if not active then
		return
	end

	propertyGizmo.finish(false)
	active = false
	propertyGizmo.select(selected)
	refs.State.Axis:RefreshAxis()
end

function scale.clear()
	propertyGizmo.finish(true)
	selected, active = nil, false
	propertyGizmo.select(nil)
end

function scale.start()
	if not refs or preferences.get("ScaleGizmo") == false then
		return false
	end

	if propertyGizmo.isEditing() then
		propertyGizmo.finish(true)
		return false
	end

	if refs.State.Timeline:GetState().Playing or refs.State.PhysicsSimulating or edit.blocked() then
		return false
	end

	refs.Finalize()
	active = true
	if not show() then
		scale.disable()
		notification.show("SCALE", "Select a rig limb, mesh part or imported armature control.")
		return false
	end

	return propertyGizmo.begin("pointer")
end

function scale.reset()
	if
		not refs
		or not selected
		or not selected.Parent
		or propertyGizmo.isEditing()
		or refs.State.Timeline:GetState().Playing
		or refs.State.PhysicsSimulating
		or edit.blocked()
	then
		return false
	end

	refs.Finalize()
	local wasActive = active
	active = true
	local ok, result = xpcall(function()
		return show() and propertyGizmo.reset()
	end, debug.traceback)
	active = wasActive
	if not active then
		propertyGizmo.select(selected)
		refs.State.Axis:RefreshAxis()
	end

	if not ok then
		error(result, 0)
	end

	return result
end

function scale.toggle()
	if not refs or preferences.get("ScaleGizmo") == false then
		return
	end

	if active then
		scale.disable()
		return
	end

	if refs.State.Timeline:GetState().Playing or refs.State.PhysicsSimulating or edit.blocked() then
		return
	end

	refs.Finalize()
	active = true
	if not show() then
		scale.disable()
		notification.show(
			"SIZING GIZMO",
			"Select a rig limb, mesh part or imported armature control."
		)
	end
end

function scale.init(options)
	refs, selected, active = options, nil, false
	options.State.ScaleGizmo = scale
	local unsubscribe = preferences.subscribe(function(key, value)
		if key == "ScaleGizmo" and value == false then
			scale.disable()
		end
	end)
	options.ScreenGui.Destroying:Once(unsubscribe)
end

return scale
]]></ProtectedString>
						<string name="ScriptGuid">{6FE775B3-1928-41C7-AD95-153BA70E0964}</string>
