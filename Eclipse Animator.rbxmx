							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local flipbookTiming = require(script.Parent.flipbookTiming)

local TexturePlayer = {}
TexturePlayer.__index = TexturePlayer

function TexturePlayer.new()
	local self = setmetatable({}, TexturePlayer)

	self.sprites = {}
	self.count = 0
	self.lifetime = flipbookTiming.defaultLifetime
	self.heartbeat = nil

	return self
end

function TexturePlayer:setLifetime(lifetime: number)
	self.lifetime = math.max(lifetime, flipbookTiming.minimumLifetime)
end

function TexturePlayer:getLifetime(): number
	return self.lifetime
end

function TexturePlayer:getRate(entry): number
	if entry.fps then
		return entry.fps
	end

	return flipbookTiming.getRate(entry.frames, entry.mode, entry.framerate, self.lifetime)
end

function TexturePlayer:getFrameAt(entry, elapsed: number): number
	return flipbookTiming.getIndexAt(entry.frames, entry.mode, self:getRate(entry), elapsed)
end

function TexturePlayer:getSpriteFrameAt(sprite, elapsed: number): number
	local entry = sprite:getEntry()
	local rate = sprite:getRate() or self:getRate(entry)

	return flipbookTiming.getIndexAt(sprite:getFrameCount(), entry.mode, rate, elapsed)
end

function TexturePlayer:isPlaying(sprite): boolean
	return self.sprites[sprite] ~= nil
end

function TexturePlayer:isRunning(): boolean
	return self.heartbeat ~= nil
end

function TexturePlayer:play(sprite)
	if not sprite:isAnimated() then
		self:stop(sprite)
		return
	end

	if not self.sprites[sprite] then
		self.count += 1
	end

	self.sprites[sprite] = os.clock()
	sprite:showFrame(0)
	self:updateHeartbeat()
end

function TexturePlayer:stop(sprite)
	if not self.sprites[sprite] then
		return
	end

	self.sprites[sprite] = nil
	self.count -= 1
	sprite:showPoster()
	self:updateHeartbeat()
end

function TexturePlayer:stopAll()
	for sprite in self.sprites do
		sprite:showPoster()
	end

	table.clear(self.sprites)
	self.count = 0
	self:updateHeartbeat()
end

function TexturePlayer:updateHeartbeat()
	local needed = self.count > 0

	if needed and not self.heartbeat then
		self.heartbeat = runService.Heartbeat:Connect(function()
			self:update(os.clock())
		end)
	elseif not needed and self.heartbeat then
		self.heartbeat:Disconnect()
		self.heartbeat = nil
	end
end

function TexturePlayer:update(now: number)
	for sprite, started in self.sprites do
		if sprite:getEntry() then
			sprite:showFrame(self:getSpriteFrameAt(sprite, now - started))
		end
	end
end

function TexturePlayer:destroy()
	self:stopAll()
end

return TexturePlayer
]]></ProtectedString>
							<string name="ScriptGuid">{9CE25EFB-908E-4E01-B927-6833186D647A}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">TexturePlayer</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX2499EF1C041B4E408FF91AE424295D7F">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local flipbookTiming = require(script.Parent.flipbookTiming)

local TextureInserter = {}
TextureInserter.__index = TextureInserter

TextureInserter.staticTemplate = "Static"
TextureInserter.flipbookTemplate = "Flipbook"
TextureInserter.emitterClass = "ParticleEmitter"

TextureInserter.menuTexts = {
	replace = "Replace Texture",
}

TextureInserter.messages = {
	needsTarget = "Select a Part, MeshPart, Model or Attachment to put the texture on.",
	failed = "The texture could not be inserted.",
	inserted = "Added \"%s\" to %s.",
	insertedMany = "Added \"%s\" to %d objects.",
	replaced = "Replaced the texture of %s with \"%s\".",
	replacedMany = "Replaced the texture of %d emitters with \"%s\".",
}

TextureInserter.targetTexts = {
	none = "Select a part, model or attachment to insert into.",
	host = "Inserts into %s \"%s\".",
	container = "Inserts a new emitter in \"%s\".",
	many = "Inserts into %d selected objects.",
	newAsset = "Nothing selected: inserts into a new asset.",
	replace = "Replaces the texture of \"%s\".",
	replaceMany = "Replaces the texture of %d emitters.",
}

function TextureInserter.new(context, builder, templates: Instance?, marks)
	local self = setmetatable({}, TextureInserter)

	self.context = context
	self.builder = builder
	self.asset = context.asset
	self.selection = context.selection
	self.history = context.history
	self.templates = templates
	self.marks = marks
	self.insertedHandler = nil

	return self
end

function TextureInserter:setInsertedHandler(handler: (({ Instance }) -> ())?)
	self.insertedHandler = handler
end

function TextureInserter:getTemplate(entry): ParticleEmitter?
	local templates = self.templates

	if not templates then
		return nil
	end

	local name = if entry.frames > 1 then TextureInserter.flipbookTemplate else TextureInserter.staticTemplate
	local template = templates:FindFirstChild(name)

	return if template and template:IsA(TextureInserter.emitterClass) then template else nil
end

function TextureInserter:getFlipbookLifetime(): number
	local template = if self.templates then self.templates:FindFirstChild(TextureInserter.flipbookTemplate) else nil

	if template and template:IsA(TextureInserter.emitterClass) then
		return math.max(flipbookTiming.getAverage(template.Lifetime), flipbookTiming.minimumLifetime)
	end

	return flipbookTiming.defaultLifetime
end

function TextureInserter:configure(emitter: ParticleEmitter, entry)
	emitter.Texture = entry.image
	emitter.FlipbookLayout = entry.layout

	if entry.frames > 1 then
		emitter.FlipbookMode = entry.mode
		emitter.FlipbookFramerate = NumberRange.new(entry.framerate)
		emitter.FlipbookStartRandom = entry.startRandom
	end
end

function TextureInserter:createEmitter(entry): ParticleEmitter
	local template = self:getTemplate(entry)
	local emitter = if template then template:Clone() else Instance.new(TextureInserter.emitterClass)

	emitter.Name = entry.name
	self:configure(emitter, entry)

	return emitter
end

function TextureInserter:isInAsset(instance: Instance): boolean
	local effects = self.asset:getEffects()

	return effects ~= nil and (instance == effects or instance:IsDescendantOf(effects))
end

function TextureInserter:resolve(instance: Instance): (Instance?, Instance?)
	if not instance:IsDescendantOf(workspace) or self.asset:isBase(instance) then
		return nil, nil
	end

	if instance:IsA("Attachment") or instance:IsA("BasePart") then
		return instance, nil
	end

	if instance:IsA("Model") then
		if self:isInAsset(instance) and not self.builder:isGenerated(instance) then
			return nil, instance
		end

		local part = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)

		if part then
			return part, nil
		end

		return nil, instance
	end

	local point = self.builder:getPoint(instance)

	if point and not self.asset:isBase(point) then
		return point, nil
	end

	return nil, nil
end

function TextureInserter:plan()
	local plan = { hosts = {}, containers = {}, createAsset = false }
	local selected = self.selection:get()

	for _, instance in selected do
		local host, container = self:resolve(instance)

		if host and not table.find(plan.hosts, host) then
			table.insert(plan.hosts, host)
		elseif container and not table.find(plan.containers, container) then
			table.insert(plan.containers, container)
		end
	end

	if #plan.hosts + #plan.containers > 0 then
		return plan
	end

	local effects = self.asset:getEffects()

	if effects then
		table.insert(plan.containers, effects)
	elseif #selected == 0 then
		plan.createAsset = true
	end

	return plan
end

function TextureInserter:getTargetText(): string
	local texts = TextureInserter.targetTexts
	local emitters = self:getEmitters()

	if #emitters == 1 then
		return string.format(texts.replace, emitters[1].Name)
	elseif #emitters > 1 then
		return string.format(texts.replaceMany, #emitters)
	end

	local plan = self:plan()
	local total = #plan.hosts + #plan.containers

	if plan.createAsset then
		return texts.newAsset
	elseif total == 0 then
		return texts.none
	elseif total > 1 then
		return string.format(texts.many, total)
	elseif plan.hosts[1] then
		return string.format(texts.host, plan.hosts[1].ClassName, plan.hosts[1].Name)
	end

	return string.format(texts.container, plan.containers[1].Name)
end

function TextureInserter:getPlacement(container: Instance): CFrame
	if self:isInAsset(container) then
		return self.builder:getPlacement(container)
	end

	return if container:IsA("PVInstance") then container:GetPivot() else CFrame.identity
end

function TextureInserter:getEmitters(): { ParticleEmitter }
	local emitters = {}

	for _, instance in self.selection:get() do
		if instance:IsA(TextureInserter.emitterClass) and instance:IsDescendantOf(workspace) then
			table.insert(emitters, instance)
		end
	end

	return emitters
end

function TextureInserter:isReplacing(): boolean
	return #self:getEmitters() > 0
end

function TextureInserter:record(entry)
	if self.marks then
		self.marks:addRecent(entry.key)
	end
end

function TextureInserter:insert(entry): { Instance }
	local messages = TextureInserter.messages
	local plan = self:plan()

	if plan.createAsset then
		if not self.context.suite:ensureAsset() then
			return {}
		end

		plan = self:plan()
	end

	if #plan.hosts + #plan.containers == 0 then
		self.context.notify(messages.needsTarget)
		return {}
	end

	local created = self.history:run("Insert Texture", function()
		local emitters = {}

		for _, host in plan.hosts do
			local emitter = self:createEmitter(entry)

			emitter.Parent = host
			table.insert(emitters, emitter)
		end

		for _, container in plan.containers do
			local holder = self.builder:createHolder(container, self:getPlacement(container), entry.name)
			local emitter = self:createEmitter(entry)

			emitter.Parent = self.builder:createAttachment(holder)
			table.insert(emitters, emitter)
		end

		return emitters
	end)

	if not created or #created == 0 then
		self.context.notify(messages.failed)
		return {}
	end

	local first = plan.hosts[1] or plan.containers[1]

	self:record(entry)
	self.selection:set(created)

	if #created == 1 then
		self.context.notify(string.format(messages.inserted, entry.name, first.Name))
	else
		self.context.notify(string.format(messages.insertedMany, entry.name, #created))
	end

	if self.insertedHandler then
		self.insertedHandler(created)
	end

	return created
end

function TextureInserter:replace(entry): number
	local messages = TextureInserter.messages
	local emitters = self:getEmitters()

	if #emitters == 0 then
		return 0
	end

	self.history:beginProperties("Replace Texture", self.context.access, emitters, {
		"Texture", "FlipbookLayout", "FlipbookMode", "FlipbookFramerate", "FlipbookStartRandom",
	})
	local ok, problem = pcall(function()
		for _, emitter in emitters do
			self:configure(emitter, entry)
		end
	end)
	self.history:finish(not ok)
	if not ok then
		self.context.notify(messages.failed)
		warn(problem)
		return 0
	end

	self:record(entry)

	if #emitters == 1 then
		self.context.notify(string.format(messages.replaced, emitters[1].Name, entry.name))
	else
		self.context.notify(string.format(messages.replacedMany, #emitters, entry.name))
	end

	return #emitters
end

function TextureInserter:activate(entry): number
	if self:isReplacing() then
		return self:replace(entry)
	end

	return #self:insert(entry)
end

return TextureInserter
]]></ProtectedString>
							<string name="ScriptGuid">{568E5747-F910-449D-B899-D376DEBEEABD}</string>
