								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local spatial = require(script.Parent.Parent.spatial)
local Tool = require(script.Parent.Tool)

local ResizeTool = Tool.extend()

ResizeTool.id = "Resize"
ResizeTool.title = "Resize Effect"
ResizeTool.keywords = "scale size bigger smaller whole effect"
ResizeTool.pivots = { "Selection Centre", "Each Object", "Asset Origin" }

function ResizeTool.new(context)
	local self = setmetatable({}, ResizeTool)

	Tool.init(self, context, {
		Factor = 1.5,
		Around = "Selection Centre",
	})

	return self
end

function ResizeTool:getFields()
	return {
		self:field("Factor", "Factor", "number", { minimum = 0.01, range = { min = 0.1, max = 4 }, tip = "2 doubles everything: parts, attachment offsets, particle size and speed, beam width and curve, light range." }),
		self:choice("Around", "Around", ResizeTool.pivots, { tip = "The point everything grows away from." }),
		self:action("Apply", "Resize Selection", function()
			self:apply()
		end, nil, true),
	}
end

function ResizeTool:getPivotOf(root: Instance): Vector3?
	local pivot = spatial.getPivot(root)

	if pivot then
		return pivot.Position
	end

	local ancestor = root:FindFirstAncestorWhichIsA("PVInstance")

	return if ancestor then ancestor:GetPivot().Position else nil
end

function ResizeTool:apply()
	local roots = self:requireRoots(false)

	if not roots then
		return
	end

	local params = self.params
	local shared = self:getOrigin()

	if params.Around == "Selection Centre" then
		shared = spatial.getCenter(roots) or shared
	end

	self:run("Resize", function()
		for _, root in roots do
			local origin = shared

			if params.Around == "Each Object" then
				origin = self:getPivotOf(root) or shared
			end

			spatial.scale(root, params.Factor, origin)
		end
	end)
end

return ResizeTool
]]></ProtectedString>
								<string name="ScriptGuid">{81C5D102-1143-4895-BD0A-2ED2366BC6D9}</string>
