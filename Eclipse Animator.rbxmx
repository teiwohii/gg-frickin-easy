				<Item class="ModuleScript" referent="RBX293747227BD8430EAC75845C27695B64">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local options = require("physicsOptions")
local tool = require("tool")
local scene = require("scene")
local panel = {}

function panel.new(parent, refs, locked, resized)
	local root = tool.make("Frame", parent, "PhysicsMotionOptions", { BackgroundTransparency = 1 })
	local draft = options.copy(scene.get().advanced)
	local sections = { motion = false, constant = false, events = false }
	local fields, height = {}, 90
	local draw, api
	local function changed()
		scene.get().advanced = options.copy(draft)
		refs.State.currentProjectSaved = false
	end
	local function button(name, text, x, y, width, callback)
		return tool.button(
			root,
			name,
			text,
			UDim2.new(x, 0, 0, y),
			UDim2.new(width, -4, 0, 26),
			function()
				if locked() then
					return
				end
				local ok, issue = pcall(function()
					api.read(false)
					callback()
				end)
				if not ok then
					require("notification").show("PHYSICS", tostring(issue), 4)
				end
			end
		)
	end
	local function field(name, title, value, x, y, width, write)
		tool.label(root, name .. "Label", title, UDim2.new(x, 0, 0, y), UDim2.new(width, -5, 0, 18))
		local box = tool.make("TextBox", root, name, {
			Position = UDim2.new(x, 0, 0, y + 18),
			Size = UDim2.new(width, -5, 0, 25),
			Text = tostring(value),
			ClearTextOnFocus = false,
			Font = Enum.Font.Code,
			TextSize = 12,
		})
		box:SetAttribute("ThemeBg", "Pnl")
		box:SetAttribute("ThemeTxt", "Txt")
		table.insert(fields, { box = box, write = write })
		box.FocusLost:Connect(function()
			if locked() then
				return
			end
			local number = tonumber(box.Text)
			if number and number == number and math.abs(number) < math.huge then
				write(number)
				changed()
			end
		end)
	end
	local function vectorFields(name, title, value, y, write)
		local values = { value.X, value.Y, value.Z }
		for i, axis in { "X", "Y", "Z" } do
			field(
				name .. axis,
				title .. " " .. axis,
				values[i],
				(i - 1) / 3,
				y,
				1 / 3,
				function(number)
					values[i] = number
					write(Vector3.new(table.unpack(values)))
				end
			)
		end
	end
	local function selectTarget(name, value, y, write)
		local rows = options.targets(scene.entries())
		local index, label = 0, "Missing target (choose again)"
		for i, row in rows do
			if row.id == value then
				index, label = i, row.label
			end
		end
		button(name, label, 0, y, 1, function()
			index = index % #rows + 1
			write(rows[index].id)
			changed()
			draw()
		end)
	end
	draw = function()
		for _, child in root:GetChildren() do
			child:Destroy()
		end
		table.clear(fields)
		local y = 0
		local function section(id, text)
			button(id, (sections[id] and "- " or "+ ") .. text, 0, y, 1, function()
				api.read(true)
				sections[id] = not sections[id]
				draw()
			end)
			y += 30
			return sections[id]
		end
		if section("motion", "PUSH SPACE & SPIN") then
			button("PushSpace", "Push: " .. draft.pushSpace, 0, y, 0.5, function()
				draft.pushSpace = draft.pushSpace == "World" and "Local" or "World"
				changed()
				draw()
			end)
			button("SpinSpace", "Spin: " .. draft.spinSpace, 0.5, y, 0.5, function()
				draft.spinSpace = draft.spinSpace == "World" and "Local" or "World"
				changed()
				draw()
			end)
			y += 30
			vectorFields("Spin", "Spin (turns/s)", draft.angularVelocity, y, function(v)
				draft.angularVelocity = v
			end)
			y += 50
		end
		if section("constant", "PHYSICS STYLE: " .. draft.style:upper()) then
			button("Style", "Style: " .. draft.style, 0, y, 1, function()
				draft.style = draft.style == "Default" and "Constant" or "Default"
				changed()
				draw()
			end)
			y += 30
			field("Interval", "Default step (frames)", draft.interval, 0, y, 1, function(v)
				draft.interval = v
			end)
			y += 50
			for _, target in options.targets(scene.entries()) do
				if target.id == "All" then
					continue
				end
				local id = target.id
				field(
					"Step" .. y,
					target.label .. " (0 = inherit)",
					draft.intervals[id] or 0,
					0,
					y,
					1,
					function(v)
						draft.intervals[id] = v ~= 0 and v or nil
					end
				)
				y += 48
			end
		end
		if section("events", "PHYSICS EVENTS (" .. #draft.events .. ")") then
			tool.label(
				root,
				"EventHelp",
				"At project frame | push = studs/s | spin = turns/s",
				UDim2.fromOffset(0, y),
				UDim2.new(1, 0, 0, 22)
			)
			y += 26
			for i, event in draft.events do
				local index = i
				field("Frame" .. i, "Event " .. i .. " frame", event.frame, 0, y, 0.5, function(v)
					event.frame = v
				end)
				button("Delete" .. i, "REMOVE", 0.5, y + 18, 0.5, function()
					table.remove(draft.events, index)
					changed()
					draw()
				end)
				y += 50
				selectTarget("Target" .. i, event.target, y, function(v)
					event.target = v
				end)
				y += 30
				button("Mode" .. i, event.mode .. " velocity", 0, y, 0.5, function()
					event.mode = event.mode == "Set" and "Add" or "Set"
					changed()
					draw()
				end)
				button("Space" .. i, event.space, 0.5, y, 0.5, function()
					event.space = event.space == "World" and "Local" or "World"
					changed()
					draw()
				end)
				y += 30
				vectorFields("EventPush" .. i, "Push", event.velocity, y, function(v)
					event.velocity = v
				end)
				y += 48
				vectorFields("EventSpin" .. i, "Spin", event.angular, y, function(v)
					event.angular = v
				end)
				y += 56
			end
			button("AddEvent", "+ ADD EVENT", 0, y, 1, function()
				if #draft.events >= 128 then
					return
				end
				api.read(true)
				local raw = refs.State.Timeline:GetState()
				table.insert(draft.events, {
					frame = math.round(raw.CurrentTime * raw.FPS),
					target = "All",
					mode = "Set",
					space = "World",
					velocity = Vector3.zero,
					angular = Vector3.zero,
				})
				changed()
				draw()
			end)
			y += 30
		end
		height = y
		require("theme").applyTree(root)
		if resized then
			resized()
		end
	end
	api = {
		root = root,
		height = function()
			return height
		end,
		load = function(settings)
			draft = options.copy(settings)
			scene.get().advanced = options.copy(draft)
			draw()
		end,
		read = function(commit)
			for _, row in fields do
				local value = tonumber(row.box.Text)
				assert(
					value and value == value and math.abs(value) < math.huge,
					"Enter finite physics option values"
				)
				row.write(value)
			end
			if commit then
				changed()
			end
			return options.copy(draft)
		end,
	}
	draw()
	return api
end

return panel
]]></ProtectedString>
