						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local nativeRequire = require
local require = nativeRequire(script:FindFirstAncestor("container").requireModule)

local theme = require("theme")
local motion = require("motion")

local ArcHost = {}
ArcHost.__index = ArcHost

local fontFamily = "rbxasset://fonts/families/RobotoMono.json"
local pageNames = { "Inspect", "Add", "Tools", "Library", "Textures", "Meshes" }
local popupZIndex = 400
local subtleAttribute = "EclipseArcSubtle"
local styledAttribute = "EclipseArcStyled"
local sceneFolderName = "Eclipse FX"
local originAttribute = "EclipseFXOrigin"

local arcColors = {
	dark = Color3.fromRGB(40, 40, 44),
	input = Color3.fromRGB(26, 26, 29),
	light = Color3.fromRGB(150, 150, 158),
	border = Color3.fromRGB(165, 165, 172),
	text = Color3.fromRGB(246, 246, 246),
	subtle = Color3.fromRGB(185, 185, 190),
	white = Color3.new(1, 1, 1),
}

local function near(a, b)
	return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.03
end

local function coreFolder()
	return script:FindFirstAncestor("container").Parent:FindFirstChild("Effects")
end

local function palette()
	local panel = theme.get("Pnl", Color3.fromRGB(22, 0, 32))
	local text = theme.get("Txt", Color3.fromRGB(235, 228, 242))
	return {
		panel = panel,
		input = panel:Lerp(Color3.new(), 0.35),
		button = theme.get("TopBtn", Color3.fromRGB(51, 0, 77)),
		selected = theme.get("MenuSel", Color3.fromRGB(100, 0, 151)),
		top = theme.get("Top", Color3.fromRGB(33, 0, 49)),
		stroke = theme.get("Strk", theme.panelOutlineDefault()),
		text = text,
		subtle = text:Lerp(panel, 0.4),
	}
end

function ArcHost.new(options)
	local self = setmetatable({
		options = options,
		gui = options.gui,
		enabled = false,
		browserTab = nil,
		selectionHandlers = {},
		connections = {},
		destroyed = false,
	}, ArcHost)

	local ok, problem = xpcall(function()
	local core = coreFolder()
	assert(core, "Eclipse FX needs the Effects folder")
	self.core = core
	self.modules = core.Modules
	self.configuration = nativeRequire(self.modules.Utility.configuration)

	self:installShared()
	self:buildFrame()
	self:buildSuite()
	self:applyPalette()
	self:restyle(self.gui)
	table.insert(self.connections, self.gui.DescendantAdded:Connect(function(object)
		task.defer(function()
			if not self.destroyed and object:IsDescendantOf(self.gui) then
				self:restyleObject(object)
			end
		end)
	end))

	table.insert(self.connections, {
		Disconnect = theme.onChanged(function()
			if not self.destroyed then
				self:applyPalette()
				self:refreshSubtle(self.gui)
			end
		end),
	})

	end, debug.traceback)
	if not ok then
		pcall(self.destroy, self)
		error(problem, 0)
	end

	return self
end

function ArcHost:installShared()
	local modules = self.modules
	local configuration = self.configuration
	local plugin = self.options.plugin
	local unlocked = {
		getFeatures = function()
			return configuration.Premium.features
		end,
		isOwned = function()
			return true
		end,
		hasFeature = function()
			return true
		end,
		onChanged = function()
			return function() end
		end,
		isChecking = function()
			return false
		end,
		hasChecked = function()
			return true
		end,
		refresh = function() end,
	}

	nativeRequire(modules.Premium.PremiumGate).install(unlocked, {
		notifier = {
			notify = function(_, _, text)
				self:notify(text)
			end,
		},
	})
	nativeRequire(modules.Utility.SoundHost).install(plugin)
	nativeRequire(modules.Utility.PropertyFavorites).install(plugin)

	local EditorHelpers = nativeRequire(modules.VFX.EditorHelpers)
	EditorHelpers.isToggleInput = function()
		return false
	end

	local Drawer = nativeRequire(modules.Create.Drawer)
	Drawer.placer = function(target)
		return self:placeDrawer(target)
	end
end

function ArcHost:buildFrame()
	local frame = self.core.UI.Tabs.Create:Clone()
	frame.Name = "ArcCreate"
	frame.AnchorPoint = Vector2.zero
	frame.Position = UDim2.new()
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundTransparency = 1
	frame.Active = false
	frame.Visible = false
	frame.ZIndex = popupZIndex

	for _, child in frame:GetChildren() do
		if child:IsA("UIStroke") or child:IsA("UIGradient") or child:IsA("UICorner") then
			child:Destroy()
		elseif child.Name == "Theme" or child.Name == "ArcHalfTone" then
			child:Destroy()
		elseif child.Name == "Tab" or child.Name == "Preview" then
			child.Visible = false
		end
	end

	local scale = frame:FindFirstChildOfClass("UIScale")
	if scale then
		scale.Scale = 1
	end

	self:restyle(frame)
	self.frame = frame
	frame.Parent = self.gui
end

function ArcHost:createInterface()
	local host = self
	local closedPrompt = {
		isOpen = function()
			return false
		end,
		open = function() end,
		close = function() end,
	}
	local interface = {
		gui = self.gui,
		create = self.frame,
		dock = nil,
		hover = self:createHover(),
		namingPrompt = closedPrompt,
		relativePrompt = closedPrompt,
		themeManager = {
			decorate = function(_, target)
				host:decoratePopup(target)
			end,
		},
		alertPrompt = {
			isOpen = function()
				return false
			end,
			open = function(_, options)
				host:confirm(options)
			end,
			close = function() end,
		},
		notifier = {
			notify = function(_, _, text)
				host:notify(text)
			end,
		},
	}

	function interface.setEnabled(_, enabled)
		host.enabled = enabled == true
	end

	function interface.isEnabled()
		return host.enabled
	end

	function interface.showCreate()
		host.frame.Visible = true
	end

	function interface.hideCreate()
		host.frame.Visible = false
		if host.hiddenHandler then
			host.hiddenHandler()
		end
	end

	function interface.setCreateHiddenHandler(_, handler)
		host.hiddenHandler = handler
	end

	function interface.onClose(_, handler)
		host.closeHandler = handler
	end

	function interface.close(target)
		target:hideCreate()
	end

	function interface.showPrimary() end

	return interface
end

function ArcHost:createHover()
	local dialog = self.options.hoverDialog
	local hover = { current = nil }

	function hover.showText(target, owner, text)
		if not dialog or not text or text == "" then
			return
		end

		target.current = owner
		dialog:popup(text, owner, { maxWidth = 280 })
	end

	function hover.show() end

	function hover.hide(target)
		if dialog and target.current then
			dialog:disappear(target.current)
		end

		target.current = nil
	end

	function hover.destroy(target)
		target:hide()
	end

	return hover
end

function ArcHost:buildSuite()
	local modules = self.modules
	local ProjectFactory = nativeRequire(modules.Project.ProjectFactory)
	local CreateSuite = nativeRequire(modules.Create.CreateSuite)
	local session = {
		isActive = function()
			return false
		end,
		requestExit = function(_, callback)
			callback()
		end,
		addExitHandler = function() end,
	}
	local launcher = {
		getStoredRelative = function()
			return nil
		end,
		requestRelative = function() end,
		launch = function() end,
		isValidRelative = function()
			return false
		end,
	}

	self.interface = self:createInterface()
	self.factory = self:createFactory(ProjectFactory)
	self.suite = CreateSuite.new({
		plugin = self.options.plugin,
		interface = self.interface,
		button = nil,
		session = session,
		launcher = launcher,
		factory = self.factory,
		templates = self.core.Template,
		assets = self.core:FindFirstChild("Assets"),
	})

	self.suite.context.getScale = function() return motion.scale(self.frame) end
	self.formClass = nativeRequire(modules.Create.Form)
	self:adaptAsset()
	if self.suite.meshParticles then
		self.suite.meshParticles.previewHandler = function(targets)
			self:emitMeshes(targets)
		end
	end

	local window = self.suite.window
	window.setScale = function() end
	window.setTab = function(target, name)
		target.currentTab = name
	end
	window.scale.Scale = 1

	self.suite.selection:addChangedHandler(function(instances)
		for _, handler in self.selectionHandlers do
			task.spawn(handler, instances)
		end
	end)

	local workspaceFrame = self.frame:FindFirstChild("Workspace")
	if workspaceFrame then
		workspaceFrame.Visible = false
	end
end

function ArcHost:createFactory(ProjectFactory)
	local factory = ProjectFactory.new(self.core.Template:FindFirstChild("Project"))
	local organizerName = nativeRequire(self.modules.Project.Organizer).containerName

	function factory.isProject(_, instance)
		return instance ~= nil and instance:IsA("Folder") and instance.Name == sceneFolderName
	end

	function factory.getEffects(target, project)
		return if target:isProject(project) then project else nil
	end

	function factory.isBasePart()
		return false
	end

	function factory.hasEffectsContent(_, effects)
		for _, child in effects:GetChildren() do
			if child.Name ~= organizerName then
				return true
			end
		end

		return false
	end

	function factory.createEmpty(target, _, pivot)
		local folder = Instance.new("Folder")
		folder.Name = sceneFolderName
		folder:SetAttribute(originAttribute, pivot or CFrame.identity)
		target.lastOffset = Vector3.zero
		folder.Parent = workspace
		return folder
	end

	function factory.create(target, _, instances)
		local folder = target:createEmpty(sceneFolderName, nil)
		local failed = {}
		for _, instance in target:getRootInstances(instances) do
			local moved = pcall(function()
				instance.Parent = folder
			end)
			if not moved then
				table.insert(failed, instance)
			end
		end

		return folder, failed
	end

	return factory
end

function ArcHost:adaptAsset()
	local asset = self.suite.asset
	local Hierarchy = self.suite.hierarchy
	local Organizer = nativeRequire(self.modules.Project.Organizer)
	local hiddenAttribute = self.configuration.Create.hiddenAttribute

	function asset.getBase()
		return nil
	end

	function asset.isBase(target, instance)
		local effects = target:getEffects()
		return instance ~= nil
			and effects ~= nil
			and instance.Parent == effects
			and instance.Name == Organizer.containerName
			and instance:IsA("Folder")
	end

	function asset.getOrigin(target)
		local effects = target:getEffects()
		local origin = effects and effects:GetAttribute(originAttribute)
		if typeof(origin) == "CFrame" then
			return origin
		end

		return target:getSpawnCFrame()
	end

	function asset.create(target)
		local existing = target:listProjects()[1]
		if existing then
			target:open(existing)
			return existing
		end

		local folder = target.history:run("New Eclipse FX Folder", function()
			return target.factory:createEmpty(sceneFolderName, target:getSpawnCFrame())
		end)
		if folder then
			target:open(folder)
		end

		return folder
	end

	if not Organizer.eclipseHidden then
		Organizer.eclipseHidden = true
		local getContainer = Organizer.getContainer
		function Organizer.getContainer(target, create)
			local container = getContainer(target, create)
			if container and target.project and target.project.Name == sceneFolderName then
				container:SetAttribute(hiddenAttribute, true)
			end

			return container
		end

		local isAlive = Organizer.isAlive
		function Organizer.isAlive(target, instance)
			if instance ~= nil and instance == target.project and instance.Parent and instance.Name == sceneFolderName then
				return true
			end

			return isAlive(target, instance)
		end
	end

	local host = self
	local getChildren = Hierarchy.getChildren
	function Hierarchy.getChildren(target, parent)
		local children = getChildren(target, parent)
		if parent ~= nil and parent == target.asset:getEffects() then
			for _, root in host:getLinked() do
				if root.Parent and not table.find(children, root) then
					table.insert(children, root)
				end
			end
		end

		return children
	end

	local reveal = Hierarchy.reveal
	function Hierarchy.reveal(target, instance)
		local root = host:linkedRoot(instance)
		if not root then
			return reveal(target, instance)
		end

		if target.filter ~= "" then
			return
		end

		local changed = false
		local current = instance.Parent
		while current and (current == root or current:IsDescendantOf(root)) do
			if target.collapsed[current] ~= false then
				target.collapsed[current] = false
				changed = true
			end

			if current == root then
				break
			end

			current = current.Parent
		end

		if changed then
			target:rebuild()
		end
	end

	local rebuild = Hierarchy.rebuild
	function Hierarchy.rebuild(target, ...)
		rebuild(target, ...)
		if not target.asset:getEffects() then
			target:clearProjects()
			target.startPage.Visible = false
			target.list.Visible = true
		end
	end
end

function ArcHost:requireArc(...)
	local current = self.modules
	for _, name in { ... } do
		current = current:FindFirstChild(name)
		if not current then
			return nil
		end
	end

	return nativeRequire(current)
end

function ArcHost:setLinkedProvider(provider)
	self.linkedProvider = provider
end

function ArcHost:getLinked()
	local provider = self.linkedProvider
	if not provider then
		return {}
	end

	local ok, list = pcall(provider)
	return ok and type(list) == "table" and list or {}
end

function ArcHost:linkedRoot(instance)
	if typeof(instance) ~= "Instance" then
		return nil
	end

	for _, root in self:getLinked() do
		if instance == root or instance:IsDescendantOf(root) then
			return root
		end
	end

	return nil
end

function ArcHost:refreshLinked()
	for _, connection in self.linkedWatchers or {} do
		connection:Disconnect()
	end

	self.linkedWatchers = {}
	local Hierarchy = self.suite.hierarchy
	local linked = self:getLinked()
	if #linked > 0 and not self.suite.asset:isOpen() then
		pcall(function()
			self.suite.asset:create()
		end)
	end

	local function schedule()
		pcall(function()
			Hierarchy:schedule()
		end)
	end

	for _, root in linked do
		table.insert(self.linkedWatchers, root.DescendantAdded:Connect(schedule))
		table.insert(self.linkedWatchers, root.DescendantRemoving:Connect(schedule))
		table.insert(self.linkedWatchers, root:GetPropertyChangedSignal("Name"):Connect(schedule))
	end

	schedule()
end

function ArcHost:openSceneFolder()
	pcall(function()
		local scene = workspace:FindFirstChild(sceneFolderName)
		if scene then
			require("eclipseEmit").MeshParticle.restoreTree(scene)
		end
	end)

	local asset = self.suite.asset
	if asset:isOpen() then
		return
	end

	local existing = asset:listProjects()[1]
	if existing then
		asset:open(existing)
	end
end

function ArcHost:getPanel(name)
	if name == "Hierarchy" then
		return self.frame:FindFirstChild("Hierarchy") or self.mounted and self.mounted.Hierarchy
	end

	if self.mounted and self.mounted[name] then
		return self.mounted[name]
	end

	return self.suite.window:getPage(name)
end

function ArcHost:mount(name, parent)
	local panel = self:getPanel(name)
	if not panel then
		return nil
	end

	self.mounted = self.mounted or {}
	self.mounted[name] = panel
	panel.AnchorPoint = Vector2.zero
	panel.Position = UDim2.new()
	panel.Size = UDim2.fromScale(1, 1)
	panel.BackgroundTransparency = 1
	panel.Visible = true
	for _, child in panel:GetChildren() do
		if child:IsA("UIStroke") then
			child.Enabled = false
		end
	end

	panel.Parent = parent
	return panel
end

function ArcHost:setBrowserTab(name)
	if self.browserTab == name then
		return
	end

	self.browserTab = name
	if not self.frame:IsDescendantOf(game) then
		return
	end

	local window = self.suite.window
	window.currentTab = name or ""
	for _, handler in window.tabHandlers do
		local ok, problem = pcall(handler, name or "")
		if not ok then
			warn("[Eclipse FX] " .. tostring(problem))
		end
	end
end

function ArcHost:onSelectionChanged(handler)
	table.insert(self.selectionHandlers, handler)
end

function ArcHost:getSelection()
	return self.suite.selection:get()
end

function ArcHost:hasSelection()
	return #self.suite.selection:get() > 0
end

function ArcHost:hasSceneSelection()
	local project = self.suite.asset:getProject()
	if not project then
		return false
	end

	for _, instance in self.suite.selection:get() do
		if instance == project or instance:IsDescendantOf(project) or self:linkedRoot(instance) then
			return true
		end
	end

	return false
end

function ArcHost:getEffects()
	return self.suite.asset:getEffects()
end

function ArcHost:setDrawerAnchor(provider)
	self.drawerAnchor = provider
end

function ArcHost:placeDrawer(Drawer)
	local provider = self.drawerAnchor
	local anchor = provider and provider(Drawer)
	local frame = Drawer.frame
	if not anchor or not anchor.Parent then
		return false
	end

	local root = self.frame
	local scale = motion.scale(frame)
	local origin = root.AbsolutePosition
	local screen = root.AbsoluteSize / scale
	local left = (anchor.AbsolutePosition.X - origin.X) / scale
	local top = (anchor.AbsolutePosition.Y - origin.Y) / scale
	local width = (anchor.AbsoluteSize.X) / scale
	local size = Vector2.new(frame.Size.X.Offset, frame.Size.Y.Offset)
	local gap = 8
	local x = left - size.X - gap
	if x < gap then
		x = left + width + gap
	end

	x = math.clamp(x, gap, math.max(gap, screen.X - size.X - gap))
	local y = math.clamp(top, gap, math.max(gap, screen.Y - size.Y - gap))
	frame.AnchorPoint = Vector2.zero
	frame.Position = UDim2.fromOffset(x, y)
	return true
end

function ArcHost:start()
	if self.destroyed then
		return
	end

	local ok, problem = pcall(function()
		self.suite:show()
		self:openSceneFolder()
	end)
	if not ok then
		warn("[Eclipse FX] " .. tostring(problem))
	end
end

function ArcHost:stop()
	require("fxEmit").stop()
	if self.destroyed then
		return
	end

	if not self.frame:IsDescendantOf(game) then
		pcall(function()
			self.suite.selection:stop()
		end)
		return
	end

	local ok, problem = pcall(function()
		self.suite:hide()
	end)
	if not ok then
		pcall(function()
			self.suite.selection:stop()
		end)
		warn("[Eclipse FX] " .. tostring(problem))
	end
end

function ArcHost:closePopups()
	pcall(function()
		self.suite:closePopups()
	end)
end

function ArcHost:emit()
	local roots = self.suite.selection:getRoots()
	if #roots == 0 then
		roots = {}
		local effects = self:getEffects()
		if effects then table.insert(roots, effects) end
		for _, root in self:getLinked() do table.insert(roots, root) end
	end
	local ok, fired = pcall(require("fxEmit").fire, roots, self.suite.preview)
	if not ok then warn("[Eclipse FX] " .. tostring(fired)); return 0 end
	return fired
end

function ArcHost:emitMeshes(roots)
	local fxEmit = require("fxEmit")
	local meshes, seen = {}, {}
	local function collect(instance)
		if seen[instance] then
			return
		end

		seen[instance] = true
		if fxEmit.kind(instance) == "Mesh Particle" then
			table.insert(meshes, instance)
			return
		end

		for _, child in instance:GetChildren() do
			collect(child)
		end
	end

	for _, root in roots or {} do
		if typeof(root) == "Instance" and root.Parent then
			collect(root)
		end
	end

	if #meshes == 0 then
		return 0
	end

	local ok, fired = pcall(fxEmit.fire, meshes)
	if not ok then
		warn("[Eclipse FX] " .. tostring(fired))
		return 0
	end

	return fired
end

function ArcHost:notify(text)
	if self.options.notify then
		self.options.notify(text)
	end
end

function ArcHost:confirm(options)
	if self.options.confirm then
		self.options.confirm(options)
	elseif options.onAgree then
		options.onAgree()
	end
end

function ArcHost:applyPalette()
	local colors = self.configuration.Colors
	local values = palette()
	colors.Dark = values.button
	colors.Secondary = values.panel
	colors.Tertiary = values.panel
	colors.Light = values.selected
	colors.Primary = values.selected
	colors.Input = values.input
	colors.Border = values.stroke
	colors.WindowTop = values.top
	colors.PanelTop = values.top
	colors.PanelBottom = values.top
	colors.Text = values.text
	colors.SubtleText = values.subtle

	local Hierarchy = nativeRequire(self.modules.Create.Hierarchy)
	Hierarchy.baseColor = values.text
end

function ArcHost:refreshSubtle(root)
	local values = palette()
	local subtle = values.subtle
	for _, object in root:GetDescendants() do
		local role = object:GetAttribute("EclipseFXColor")
		if role and values[role] and object:IsA("GuiObject") then object.BackgroundColor3 = values[role] end
		if object:IsA("TextBox") then object.PlaceholderColor3 = subtle end
		if object:GetAttribute(subtleAttribute) then
			object.TextColor3 = subtle
		end
	end
end

function ArcHost:restyleObject(object)
	if object:GetAttribute(styledAttribute) then
		return
	end

	if object.Name == "ArcHalfTone" and object:IsA("ImageLabel") then
		object:Destroy()
		return
	end

	object:SetAttribute(styledAttribute, true)
	local values = palette()
	if object:IsA("GuiObject") and not object:GetAttribute("ThemeBg")
		and not object:GetAttribute("EclipseFXColor") and not object:GetAttribute("EclipseFXValueColor")
		and object.Name ~= "Icon" and not object:FindFirstChildOfClass("UIGradient") then
		for _, entry in { { "input", "input" }, { "button", "TopBtn" }, { "panel", "Pnl" },
			{ "selected", "MenuSel" }, { "top", "Top" }, { "stroke", "Strk" } } do
			if near(object.BackgroundColor3, values[entry[1]]) then
				object:SetAttribute(entry[1] == "input" and "EclipseFXColor" or "ThemeBg", entry[2])
				break
			end
		end
	end

	if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
		local weight = object.FontFace.Weight
		local bold = weight == Enum.FontWeight.Bold
			or weight == Enum.FontWeight.SemiBold
			or weight == Enum.FontWeight.Heavy
		if object.FontFace.Family:find("Arial") or object.FontFace.Family:find("SourceSans") then
			object.FontFace = Font.new(fontFamily, bold and Enum.FontWeight.Bold or Enum.FontWeight.Medium)
			if object.TextSize > 9 then
				object.TextSize -= 1
			end
		end

		if near(object.TextColor3, arcColors.text) then
			object.TextColor3 = values.text
			object:SetAttribute("ThemeTxt", "Txt")
		elseif near(object.TextColor3, arcColors.subtle) then
			object.TextColor3 = values.subtle
			object:SetAttribute(subtleAttribute, true)
		end

		if object:IsA("TextBox") then
			object.PlaceholderColor3 = values.subtle
		end
	end

	if object:IsA("GuiObject") and not object:GetAttribute("ThemeBg") and not object:GetAttribute("EclipseFXValueColor") then
		local color = object.BackgroundColor3
		local size = object.Size
		local thin = (size.X.Scale == 0 and size.X.Offset <= 3) or (size.Y.Scale == 0 and size.Y.Offset <= 3)
		if near(color, arcColors.dark) then
			if thin then
				object.BackgroundColor3 = values.stroke
				object:SetAttribute("ThemeBg", "Strk")
			elseif object:IsA("GuiButton") then
				object.BackgroundColor3 = values.button
				object:SetAttribute("ThemeBg", "TopBtn")
			else
				object.BackgroundColor3 = values.panel
				object:SetAttribute("ThemeBg", "Pnl")
			end
		elseif near(color, arcColors.input) then
			object.BackgroundColor3 = values.input
			object:SetAttribute("EclipseFXColor", "input")
		elseif near(color, arcColors.light) then
			if thin then
				object.BackgroundColor3 = values.stroke
				object:SetAttribute("ThemeBg", "Strk")
			else
				object.BackgroundColor3 = values.selected
				object:SetAttribute("ThemeBg", "MenuSel")
			end
		elseif near(color, arcColors.white) and object:FindFirstChildOfClass("UIGradient") and not object:IsA("ImageLabel") then
			local named = object.Name
			if named == "Tab" or named == "Header" or named == "Section" then
				for _, child in object:GetChildren() do
					if child:IsA("UIGradient") then
						child:Destroy()
					end
				end
				object.BackgroundColor3 = values.top
				object:SetAttribute("ThemeBg", "Top")
			end
		end
	end

	if object:IsA("TextBox") then
		object.BackgroundColor3 = values.input
		object:SetAttribute("EclipseFXColor", "input")
	elseif object:IsA("GuiObject") then
		local parent = object.Parent
		local toggle = object.Name == "Check" and object:FindFirstChild("Mark")
		local mark = object.Name == "Mark" and parent and parent.Name == "Check"
		local badge = object.Name == "Badge" and object:IsA("TextLabel")
		if toggle or mark or badge then
			object:SetAttribute("EclipseFXColor", nil)
			object:SetAttribute("ThemeBg", (mark or badge) and "MenuSel" or "TopBtn")
			theme.applyInstance(object)
		end
	end

	if object:IsA("UIStroke") then
		if near(object.Color, arcColors.light) or near(object.Color, arcColors.border) then
			object.Color = values.stroke
			object:SetAttribute("ThemeStrk", "Strk")
			if object.Thickness > 1 then
				object.Thickness = 1
			end
		end
	end
end

function ArcHost:restyle(root)
	self:restyleObject(root)
	for _, object in root:GetDescendants() do
		if object.Parent then
			self:restyleObject(object)
		end
	end
end

function ArcHost:decoratePopup(target)
	if not target then
		return
	end

	self:restyle(target)
	if target:IsA("GuiObject") then
		target.ZIndex = math.max(target.ZIndex, popupZIndex)
	end
end

function ArcHost:shutdownSuite()
	local suite = self.suite
	if not suite then
		return
	end

	pcall(function()
		suite.selection:stop()
		table.clear(suite.selection.handlers)
	end)

	local ok, problem = pcall(function()
		suite:destroy()
	end)
	if ok then
		return
	end

	if self.frame and self.frame.Parent and self.frame:IsDescendantOf(game) then
		warn("[Eclipse FX] " .. tostring(problem))
	end

	for _, key in {
		"preview",
		"paths",
		"flipbooks",
		"screens",
		"strikes",
		"sounds",
		"library",
		"textures",
		"meshes",
		"toolbox",
		"palette",
		"generators",
		"inspector",
		"hierarchy",
		"textureDrawer",
		"meshDrawer",
		"texturePlayer",
		"textureMarks",
		"flipbook",
		"curves",
		"gradients",
		"colors",
		"menu",
		"window",
		"asset",
		"settings",
		"hideManager",
		"history",
	} do
		local part = suite[key]
		if part and part.destroy then
			pcall(part.destroy, part)
		end
	end

	pcall(function()
		suite.helpers:release()
		suite.undoScope:switch(nil)
	end)
end

function ArcHost:destroy()
	if self.destroyed then
		return
	end

	self.destroyed = true
	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	for _, connection in self.linkedWatchers or {} do
		connection:Disconnect()
	end

	self.linkedProvider = nil
	self:shutdownSuite()

	if self.modules then
		local Drawer = nativeRequire(self.modules.Create.Drawer)
		Drawer.placer = nil
	end
	if self.mounted then
		for _, panel in self.mounted do
			panel:Destroy()
		end
	end

	if self.frame then self.frame:Destroy() end
end

return ArcHost
