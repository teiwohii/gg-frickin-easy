							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")
local contentProvider = game:GetService("ContentProvider")

local meshFlipbook = require(script.Parent.meshFlipbook)

local FlipbookClock = {}
FlipbookClock.__index = FlipbookClock

function FlipbookClock.new()
	local self = setmetatable({}, FlipbookClock)

	self.targetProvider = nil
	self.eventsProvider = nil
	self.tracks = {}
	self.preloaded = {}
	self.dirty = true
	self.lastTarget = nil
	self.connection = nil

	return self
end

function FlipbookClock:setTargetProvider(provider: () -> number)
	self.targetProvider = provider
end

function FlipbookClock:setEventsProvider(provider: () -> { any })
	self.eventsProvider = provider
end

function FlipbookClock:invalidate()
	self.dirty = true
end

function FlipbookClock:isRunning(): boolean
	return self.connection ~= nil
end

function FlipbookClock:start()
	self:stop()
	self.dirty = true

	self.connection = runService.Heartbeat:Connect(function()
		self:update()
	end)
end

function FlipbookClock:preload(hosts)
	local pending = {}

	for host in hosts do
		local config = meshFlipbook.read(host)

		for _, image in if config then meshFlipbook.getImages(config) else {} do
			if not self.preloaded[image] then
				self.preloaded[image] = true
				table.insert(pending, image)
			end
		end
	end

	if #pending == 0 then
		return
	end

	task.spawn(function()
		pcall(function()
			contentProvider:PreloadAsync(pending)
		end)
	end)
end

function FlipbookClock:rebuild()
	local previous = self.tracks
	local tracks = {}

	for _, event in if self.eventsProvider then self.eventsProvider() else {} do
		local host = event.host

		if typeof(host) == "Instance" and host.Parent and meshFlipbook.has(host) then
			local track = tracks[host]

			if not track then
				track = {}
				tracks[host] = track
			end

			table.insert(track, {
				start = event.start,
				plays = event.plays,
				stretch = event.stretch,
			})
		end
	end

	for _, track in tracks do
		table.sort(track, function(a, b)
			return a.start < b.start
		end)
	end

	for host in previous do
		if not tracks[host] and host.Parent then
			meshFlipbook.applyRest(host)
		end
	end

	self.tracks = tracks
	self.lastTarget = nil
	self:preload(tracks)
end

function FlipbookClock:getActive(track, target: number)
	for index = #track, 1, -1 do
		if track[index].start <= target then
			return track[index]
		end
	end

	return nil
end

function FlipbookClock:update()
	local target = if self.targetProvider then self.targetProvider() else 0

	if self.dirty then
		self.dirty = false
		self:rebuild()
	end

	if self.lastTarget == target then
		return
	end

	self.lastTarget = target

	for host, track in self.tracks do
		local config = if host.Parent then meshFlipbook.read(host) else nil

		if config then
			local active = self:getActive(track, target)
			local index = if active then meshFlipbook.getIndexAt(config, target - active.start, active.plays, active.stretch) else meshFlipbook.getIdleIndex(config)

			meshFlipbook.apply(host, config, index)
		end
	end
end

function FlipbookClock:getEndTime(): number
	local finish = 0

	for host, track in self.tracks do
		local config = if host.Parent then meshFlipbook.read(host) else nil

		if config then
			for _, event in track do
				finish = math.max(finish, event.start + (meshFlipbook.getTotalLength(config, event.plays, event.stretch) or 0))
			end
		end
	end

	return finish
end

function FlipbookClock:clear()
	for host in self.tracks do
		if host.Parent then
			meshFlipbook.applyRest(host)
		end
	end

	table.clear(self.tracks)
	self.lastTarget = nil
	self.dirty = true
end

function FlipbookClock:stop()
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end

	self:clear()
end

return FlipbookClock
]]></ProtectedString>
