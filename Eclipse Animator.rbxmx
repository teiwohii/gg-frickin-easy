								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local httpService = game:GetService("HttpService")

local configuration = require(script.Parent.Parent.Parent.Utility.configuration)
local Tool = require(script.Parent.Tool)

local TransparencyTool = Tool.extend()

TransparencyTool.id = "TransparencyEffect"
TransparencyTool.title = "Transparency Effect"
TransparencyTool.keywords = "fade transparency opacity appear disappear in out animate keyframe"
TransparencyTool.classNames = { "BasePart", "Decal", "ParticleEmitter", "Beam", "Trail", "Highlight" }
TransparencyTool.easings = { "Linear", "Ease In", "Ease Out", "Ease In Out" }
TransparencyTool.messages = {
	none = "Nothing in the selection can fade. Select parts, particles, beams, trails, decals or highlights.",
	added = "Transparency effect added to %d object(s). The keyframes are written when you press Animate.",
	cleared = "Removed the waiting transparency effects from %d object(s).",
	nothingQueued = "The selection has no transparency effects waiting.",
}

function TransparencyTool.new(context)
	local self = setmetatable({}, TransparencyTool)

	Tool.init(self, context, {
		From = 0,
		To = 1,
		Start = 0,
		Duration = 0.5,
		Easing = "Linear",
		Hold = true,
	})

	return self
end

function TransparencyTool:getFields()
	local share = { minimum = 0, maximum = 1, clamp = true, range = { min = 0, max = 1 } }

	local function shared(tip: string)
		local options = table.clone(share)

		options.tip = tip

		return options
	end

	return {
		self:field("From", "Start", "number", shared("Transparency when the effect starts. 0 is fully visible, 1 is invisible. Particles, beams and trails keep their own fade shape.")),
		self:field("To", "End", "number", shared("Transparency when the effect ends.")),
		self:field("Start", "Starts At", "number", { minimum = 0, range = { min = 0, max = 5 }, tip = "Seconds into the animation." }),
		self:field("Duration", "Duration", "number", { minimum = 0.02, range = { min = 0.05, max = 5 }, tip = "How many seconds the change takes." }),
		self:choice("Easing", "Easing", TransparencyTool.easings),
		self:field("Hold", "Hold After End", "toggle", { tip = "Keep the end value for the rest of the animation." }),
		self:action("Apply", "Add to Selection", function()
			self:apply()
		end, "Adds the effect to everything selected. Arc writes the keyframes when you open this asset in the Animator.", true),
		self:action("Clear", "Remove from Selection", function()
			self:clear()
		end, "Removes transparency effects that have not been written as keyframes yet."),
	}
end

function TransparencyTool:canFade(instance: Instance): boolean
	for _, className in TransparencyTool.classNames do
		if instance:IsA(className) then
			return true
		end
	end

	return false
end

function TransparencyTool:getTargets(): { Instance }
	local targets = {}

	for _, instance in self:getAffected() do
		if self:canFade(instance) then
			table.insert(targets, instance)
		end
	end

	return targets
end

function TransparencyTool:readQueue(instance: Instance)
	local raw = instance:GetAttribute(configuration.Effects.transparencyQueueAttribute)

	if typeof(raw) ~= "string" or raw == "" then
		return {}
	end

	local success, decoded = pcall(function()
		return httpService:JSONDecode(raw)
	end)

	return if success and typeof(decoded) == "table" then decoded else {}
end

function TransparencyTool:apply()
	if not self:requireRoots(false) then
		return
	end

	local targets = self:getTargets()

	if #targets == 0 then
		self.context.notify(TransparencyTool.messages.none)
		return
	end

	local params = self.params
	local item = {
		from = math.clamp(params.From, 0, 1),
		to = math.clamp(params.To, 0, 1),
		start = math.max(params.Start, 0),
		length = math.max(params.Duration, 0.02),
		easing = params.Easing,
		hold = params.Hold == true,
	}

	self:run("Transparency Effect", function()
		for _, instance in targets do
			local queue = self:readQueue(instance)

			table.insert(queue, item)
			instance:SetAttribute(configuration.Effects.transparencyQueueAttribute, httpService:JSONEncode(queue))
		end
	end)

	self.context.notify(string.format(TransparencyTool.messages.added, #targets))
end

function TransparencyTool:clear()
	if not self:requireRoots(false) then
		return
	end

	local attribute = configuration.Effects.transparencyQueueAttribute
	local queued = {}

	for _, instance in self:getAffected() do
		if instance:GetAttribute(attribute) ~= nil then
			table.insert(queued, instance)
		end
	end

	if #queued == 0 then
		self.context.notify(TransparencyTool.messages.nothingQueued)
		return
	end

	self:run("Remove Transparency Effect", function()
		for _, instance in queued do
			instance:SetAttribute(attribute, nil)
		end
	end)

	self.context.notify(string.format(TransparencyTool.messages.cleared, #queued))
end

return TransparencyTool
]]></ProtectedString>
								<string name="ScriptGuid">{AE44392D-5F6F-4FED-A3F3-6BD8939177FB}</string>
