						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local emitModule = require("eclipseEmit")
local fxEmit = {}

local activeHandles = setmetatable({}, { __mode = "k" })
function fxEmit.stop()
	for handle in activeHandles do
		handle:Cancel()
	end
	table.clear(activeHandles)
end

local hiddenAttribute = "ArcHidden"
local skippedNames = {
	RenderTemplate = true,
	PartIcleProperties = true,
	GraphBlender = true,
	Organization = true,
}

local function isMeshPair(instance)
	return instance:IsA("Model") and instance:FindFirstChild("Start") ~= nil and instance:FindFirstChild("End") ~= nil
end

local function isConfigured(instance)
	return instance:FindFirstChild("PartIcleProperties") ~= nil
end

local function isMeshEffect(instance)
	if not instance:IsA("BasePart") or not (instance:IsA("MeshPart") or instance:FindFirstChildOfClass("SpecialMesh")) then
		return false
	end

	local enabled = instance:GetAttribute("MeshParticle_Enabled")
	if enabled ~= nil then
		return enabled == true
	end

	local scene = workspace:FindFirstChild("Eclipse FX")
	return scene ~= nil and instance:IsDescendantOf(scene)
end

function fxEmit.kind(instance)
	return emitModule.Classify(instance)
end

function fxEmit.isEmittable(instance)
	return fxEmit.kind(instance) ~= nil
end

local function skipped(instance)
	return emitModule.IsRuntime(instance) or skippedNames[instance.Name] == true or instance:GetAttribute(hiddenAttribute) == true
end

local function sealed(instance)
	return isConfigured(instance) or isMeshPair(instance) or isMeshEffect(instance) or fxEmit.kind(instance) == "Debris"
end

function fxEmit.contains(instance)
	if skipped(instance) then
		return false
	end

	if fxEmit.isEmittable(instance) then
		return true
	end

	for _, child in instance:GetChildren() do
		if fxEmit.contains(child) then
			return true
		end
	end

	return false
end

function fxEmit.count(instance)
	if skipped(instance) then
		return 0
	end

	local total = if fxEmit.isEmittable(instance) then 1 else 0
	if sealed(instance) then
		return total
	end

	for _, child in instance:GetChildren() do
		total += fxEmit.count(child)
	end

	return total
end

local vfxClasses = { "ParticleEmitter", "Beam", "Trail", "Fire", "Smoke", "Sparkles" }

local function vfxInstance(instance)
	for _, className in vfxClasses do
		if instance:IsA(className) then
			return true
		end
	end

	return fxEmit.isEmittable(instance)
end

function fxEmit.isVfxObject(instance, includeRig)
	if typeof(instance) ~= "Instance" or skipped(instance) then
		return false
	end

	if instance:GetAttribute("EclipseEffectObject") == 1 then
		return true
	end

	if not includeRig and (instance:FindFirstChildWhichIsA("Humanoid", true) or instance:FindFirstChildWhichIsA("AnimationController", true)) then
		return false
	end

	if vfxInstance(instance) then
		return true
	end

	for _, descendant in instance:GetDescendants() do
		if not skipped(descendant) and vfxInstance(descendant) then
			return true
		end
	end

	return false
end

function fxEmit.tree(root)
	local rows = {}

	local function visit(instance, depth)
		for _, child in instance:GetChildren() do
			if not fxEmit.contains(child) then
				continue
			end

			table.insert(rows, {
				instance = child,
				depth = depth,
				kind = fxEmit.kind(child) or "Group",
				count = fxEmit.count(child),
			})
			if not sealed(child) then
				visit(child, depth + 1)
			end
		end
	end

	visit(root, 0)
	return rows
end

local function emitNative(emitter, preview)
	if preview and preview:isBurst(emitter) then
		preview:emitInstances({ emitter })
		return
	end

	local handle = emitModule.Emit(emitter)
	activeHandles[handle] = true
end

local function fireOne(instance, preview, emitModule, skipNative)
	if skipped(instance) then
		return 0
	end
	if skipNative and skipNative(instance) then
		return 0
	end

	if instance:IsA("ParticleEmitter") then
		emitNative(instance, preview)
		return 1
	end

	if fxEmit.isEmittable(instance) then
		local ok, problem = pcall(emitModule.Emit, instance)
		if not ok then
			warn("[Eclipse FX] " .. tostring(problem))
			return 0
		end

		if type(problem) == "table" and type(problem.Cancel) == "function" then
			activeHandles[problem] = true
		end
		return 1
	end

	local fired = 0
	for _, child in instance:GetChildren() do
		fired += fireOne(child, preview, emitModule, skipNative)
	end

	return fired
end

local function topRoots(targets)
	local roots = {}
	local seen = {}
	for _, target in targets do
		local covered = false
		for _, other in targets do
			if other ~= target and target:IsDescendantOf(other) then
				covered = true
				break
			end
		end

		if not covered and not seen[target] then
			seen[target] = true
			table.insert(roots, target)
		end
	end

	return roots
end

function fxEmit.targetCount(targets)
	local count = 0
	for _, root in topRoots(targets) do count += fxEmit.count(root) end
	return count
end

function fxEmit.nativeEmitters(targets)
	local result = {}

	local function visit(instance)
		if skipped(instance) then
			return
		end

		if instance:IsA("ParticleEmitter") then
			table.insert(result, instance)
			return
		end

		if fxEmit.isEmittable(instance) then
			return
		end

		for _, child in instance:GetChildren() do
			visit(child)
		end
	end

	for _, root in topRoots(targets) do
		if root.Parent then
			visit(root)
		end
	end

	return result
end

function fxEmit.meshEffects(targets)
	local result = {}

	local function visit(instance)
		if skipped(instance) then
			return
		end

		if isMeshEffect(instance) then
			table.insert(result, instance)
			return
		end

		if fxEmit.isEmittable(instance) then
			return
		end

		for _, child in instance:GetChildren() do
			visit(child)
		end
	end

	for _, root in topRoots(targets) do
		if root.Parent then
			visit(root)
		end
	end

	return result
end

function fxEmit.beamEffects(targets)
	local result = {}
	local function visit(instance)
		if skipped(instance) or sealed(instance) then return end
		if instance:IsA("Beam") then
			table.insert(result, instance)
			return
		end
		if fxEmit.isEmittable(instance) then return end
		for _, child in instance:GetChildren() do visit(child) end
	end
	for _, root in topRoots(targets) do
		if root.Parent then visit(root) end
	end
	return result
end

function fxEmit.fire(targets, preview, skipNative)
	local fired = 0
	for _, root in topRoots(targets) do
		if root.Parent then
			fired += fireOne(root, preview, emitModule, skipNative)
		end
	end

	return fired
end

return fxEmit

