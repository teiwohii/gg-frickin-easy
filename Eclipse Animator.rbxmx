						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local tweenService = game:GetService("TweenService")
local runService = game:GetService("RunService")
local httpService = game:GetService("HttpService")
local theme = require("theme")
local preferences = require("preferences")
local windowFx = require("windowFx")
local chrome = require("chrome")
local motion = require("motion")
local inputModule = require("userInputService")
local MiniTimeline = require("MiniTimeline")
local ArcHost = require("ArcHost")
local FxWindow = require("FxWindow")
local FxLayout = require("FxLayout")
local KeyEditor = require("KeyEditor")
local EffectsRow = require("EffectsRow")
local fxEmit = require("fxEmit")

local eclipseFx = {}

local preferenceKey = "EclipseFX"
local layoutKey = "EclipseFX_Layout_v1"
local icons = {
	scene = "rbxassetid://79177212497435",
	timeline = "rbxassetid://126827005623644",
	tools = "rbxassetid://16039541976",
	add = "rbxassetid://4177208442",
	textures = "rbxassetid://10584235904",
}
local arrowIcon = "rbxassetid://95938704261741"
local halftoneIcon = "rbxassetid://71635441690027"
local margin = 12
local gap = 8
local barHeight = 30
local buttonHeight = 22
local textButtonWidth = 52
local dividerWidth = 10
local iconGap = 2
local trayGap = 6
local trayPadding = 4
local dragThreshold = 6
local sceneSize = Vector2.new(280, 380)
local sceneMinSize = Vector2.new(190, 150)
local propertiesSize = Vector2.new(300, 420)
local propertiesMinSize = Vector2.new(210, 170)
local texturesSize = Vector2.new(380, 440)
local texturesMinSize = Vector2.new(220, 180)
local toolPanelMinSize = Vector2.new(160, 60)
local toolChrome = 8 + 26 + 2 + 6
local dropdownSize = Vector2.new(310, 440)
local tipHeight = 36
local toolsTip = "<b>Tip:</b> Drag any tool by its title onto your screen to pin it there as a quick-access panel."
local toolPanelWidth = 264
local toolPanelMaxHeight = 380
local baseZIndex = 90
local dropdownZIndex = 150
local slideInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local fadeInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local idleColor = Color3.fromRGB(51, 0, 77)
local white = Color3.new(1, 1, 1)
local black = Color3.new(0, 0, 0)

local function make(className, parent, name, props)
	local object = Instance.new(className)
	object.Name = name
	for key, value in props do
		object[key] = value
	end

	object.Parent = parent
	return object
end

local function tag(object, attribute, key)
	object:SetAttribute(attribute, key)
	return object
end

local function round(object, radius)
	make("UICorner", object, "Corner", { CornerRadius = UDim.new(0, radius) })
end

local function menuSurface(object, zIndex)
	object.BackgroundColor3 = white
	object.BackgroundTransparency = 0
	object.BorderSizePixel = 0
	round(object, 4)
	tag(
		make("UIGradient", object, "PanelGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(58, 33, 84)),
				ColorSequenceKeypoint.new(0.45, Color3.fromRGB(28, 10, 42)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(13, 4, 20)),
			}),
		}),
		"ThemeGrad",
		"Menu"
	)
	local inner = make("Frame", object, "InnerStroke", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -2, 1, -2),
		BackgroundTransparency = 1,
		Active = false,
		Interactable = false,
		ZIndex = zIndex,
	})
	round(inner, 3)
	tag(
		make("UIStroke", inner, "UIStroke", {
			Color = Color3.fromRGB(107, 0, 139),
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		"ThemeStrk",
		"Strk"
	)
end

local function rowButton(parent, name, className, size, zIndex)
	local button = make(className, parent, name, {
		Size = size,
		BackgroundColor3 = idleColor,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		ZIndex = zIndex,
	})
	if button:IsA("TextButton") then
		button.Text = ""
	else
		button.Image = ""
	end

	round(button, 3)
	local halftone = make("ImageLabel", button, "Halftone", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = halftoneIcon,
		ImageColor3 = white,
		ImageTransparency = 1,
		Active = false,
		Interactable = false,
		ZIndex = zIndex + 1,
	})
	round(halftone, 3)
	return button
end

local function buttonLabel(button, text, zIndex)
	return tag(
		make("TextLabel", button, "Title", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = text,
			FontFace = chrome.FONT,
			TextSize = 12,
			TextColor3 = Color3.fromRGB(176, 176, 176),
			Active = false,
			Interactable = false,
			ZIndex = zIndex,
		}),
		"ThemeTxt",
		"Txt"
	)
end

local function buttonIcon(button, image, zIndex)
	return tag(
		make("ImageLabel", button, "Icon", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.85, 0.85),
			BackgroundTransparency = 1,
			Image = image,
			ScaleType = Enum.ScaleType.Fit,
			Active = false,
			Interactable = false,
			ZIndex = zIndex,
		}),
		"ThemeImg",
		"Txt"
	)
end

local function spacer(parent, name, width, order)
	return make("Frame", parent, name, {
		Size = UDim2.fromOffset(width, buttonHeight),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Active = false,
	})
end

local Widget = {}
Widget.__index = Widget

function Widget.new(refs)
	local self = setmetatable({
		refs = refs,
		connections = {},
		resetters = {},
		buttonTweens = {},
		trayTweens = {},
		open = false,
		hiddenAll = false,
		shown = false,
		sceneOpen = false,
		timelineOpen = false,
		texturesOpen = false,
		texturesTab = "Textures",
		dropdown = nil,
		toolPanels = {},
		destroyed = false,
	}, Widget)

	local ok, problem = xpcall(function()
	self:loadLayout()
	self:buildGui()
	self:buildCorner()
	self.host = ArcHost.new({
		plugin = refs.Plugin,
		gui = self.gui,
		hoverDialog = refs.HoverDialog,
		notify = function(text)
			self:notify(text)
		end,
		confirm = function(options)
			self:confirm(options)
		end,
	})
	self.host.suite.history.propertyRecorder = function(name)
		local state = refs.State
		local project = state and state.currentRig
		if not project then return nil end
		return function(undo, redo)
			if state.currentRig ~= project then return end
			local history = require("history")
			history.record(function() end, function() end, name, {
				afterUndo = undo,
				afterRedo = redo,
			})
			state.currentProjectSaved = false
		end
	end
	self:buildWindows()
	self:buildDropdowns()
	self:bindTools()
	self:bindAdd()
	self:bind()
	self:restoreTools()
	self.ready = true
	self:refresh()
	end, debug.traceback)
	if not ok then
		pcall(self.destroy, self)
		error(problem, 0)
	end

	return self
end

function Widget:connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

function Widget:notify(text)
	local notify = self.refs.Notify
	if notify then
		pcall(notify, "ECLIPSE FX", text)
	end
end

function Widget:confirm(options)
	local confirm = self.refs.Confirm
	if confirm then
		confirm(options.title or "ECLIPSE FX", options.description or "", options.agreeText or "OK", function()
			if options.onAgree then
				options.onAgree()
			end
		end)
	elseif options.onAgree then
		options.onAgree()
	end
end

function Widget:loadLayout()
	local data
	local plugin = self.refs.Plugin
	if plugin then
		local ok, stored = pcall(function()
			return plugin:GetSetting(layoutKey)
		end)
		if ok and type(stored) == "string" and stored ~= "" then
			local decoded, value = pcall(httpService.JSONDecode, httpService, stored)
			if decoded and type(value) == "table" then
				data = value
			end
		end
	end

	data = data or {}
	self.saved = data
	self.open = data.open == true
	self.savedPositions = type(data.positions) == "table" and data.positions or {}
	self.sceneOpen = data.scene == true
	self.timelineOpen = data.timeline == true
	self.texturesOpen = data.textures == true
	self.texturesTab = data.texturesTab == "Meshes" and "Meshes" or "Textures"
	self.hiddenAll = data.hidden == true
	self.savedSizes = type(data.sizes) == "table" and data.sizes or {}
end

function Widget:positionFromSave(key)
	local entry = self.savedPositions[key]
	if type(entry) ~= "table" then return nil end
	local x, y = tonumber(entry[1]), tonumber(entry[2])
	if not x or not y or x ~= x or y ~= y or math.abs(x) == math.huge or math.abs(y) == math.huge then return nil end
	return Vector2.new(x, y)
end

function Widget:bindPosition(frame, handle, key, place)
	return self:connect(handle.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		inputModule.trackGuiPress(input, handle)
		local start = Vector2.new(input.Position.X, input.Position.Y)
		local origin, size = self:guiRect(frame)
		local scale = self:layoutScale()
		motion.begin(frame, input, function(point)
			local layout = FxLayout.new({ margin = margin, gap = gap })
			layout:reset(self:screenSize())
			local position = layout:clampInside(origin + (Vector2.new(point.X, point.Y) - start) / scale, size)
			self.savedPositions[key] = { position.X, position.Y }
			if place then place(position) else frame.Position = FxLayout.centered(position, size) end
		end, function() self:saveLayout(true) end, "move")
	end)
end

function Widget:sizeFromSave(key, fallback)
	local entry = self.savedSizes[key]
	if type(entry) == "table" and tonumber(entry[1]) and tonumber(entry[2]) then
		return Vector2.new(tonumber(entry[1]), tonumber(entry[2]))
	end

	return fallback
end

function Widget:saveLayout(immediate)
	if self.destroyed or self.restoring then
		return
	end

	self.saveVersion = (self.saveVersion or 0) + 1
	local version = self.saveVersion
	local function write()
		if self.destroyed or version ~= self.saveVersion then
			return
		end

		local tools = {}
		for _, panel in self.toolPanels do
			local entry = { id = panel.id, edge = panel.edge, along = panel.along }
			if panel.userSize then
				entry.size = { panel.userSize.X, panel.userSize.Y }
			end

			table.insert(tools, entry)
		end

		local data = {
			open = self.open,
			scene = self.sceneOpen,
			timeline = self.timelineOpen,
			textures = self.texturesOpen,
			texturesTab = self.texturesTab,
			hidden = self.hiddenAll,
			sizes = {
				scene = { self.scene.preferred.X, self.scene.preferred.Y },
				properties = { self.properties.preferred.X, self.properties.preferred.Y },
				timeline = { self.timeline.preferred.X, self.timeline.preferred.Y },
				textures = { self.textures.preferred.X, self.textures.preferred.Y },
			},
			tools = tools,
			positions = self.savedPositions,
		}
		local plugin = self.refs.Plugin
		if plugin then
			pcall(function()
				plugin:SetSetting(layoutKey, httpService:JSONEncode(data))
			end)
		end
	end
	if immediate then write() else task.delay(0.4, write) end
end

function Widget:buildGui()
	local source = self.refs.ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "Eclipse FX"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = source.ZIndexBehavior
	gui.DisplayOrder = source.DisplayOrder
	gui.IgnoreGuiInset = source.IgnoreGuiInset
	gui.Enabled = source.Enabled
	gui:SetAttribute("EclipseFX", true)
	self.uiScale = make("UIScale", gui, "UIScale", { Scale = 1 })
	self.gui = gui

	local sourceScale = source:FindFirstChildOfClass("UIScale")
	local function mirrorScale()
		self.uiScale.Scale = sourceScale and sourceScale.Scale or 1
	end

	mirrorScale()
	if sourceScale then
		self:connect(sourceScale:GetPropertyChangedSignal("Scale"), function()
			mirrorScale()
			self:relayout(false)
		end)
	end

	self:connect(source:GetPropertyChangedSignal("Enabled"), function()
		self:syncEnabled()
	end)
	self:connect(gui:GetPropertyChangedSignal("AbsoluteSize"), function()
		self:relayout(false)
	end)
	self:connect(gui.Destroying, function()
		self:destroy()
	end)

	gui.Parent = game:GetService("CoreGui")
	inputModule.attachSurface(gui)
	theme.addRoot(gui)
end

function Widget:syncEnabled()
	local state = self.refs.State
	if state and state.PresentationHidden then
		return
	end

	self.gui.Enabled = self.refs.ScreenGui.Enabled
	if not self.gui.Enabled and self.ready then
		self:closeDropdown()
		self.host:closePopups()
	end
end

function Widget:buildCorner()
	local root = make("Frame", nil, "EclipseFX", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -margin, 1, -margin),
		Size = UDim2.fromOffset(barHeight, barHeight),
		Active = true,
		Visible = false,
		ZIndex = baseZIndex,
	})
	menuSurface(root, baseZIndex + 1)

	local toggle = rowButton(root, "Toggle", "TextButton", UDim2.new(1, -6, 1, -6), baseZIndex + 2)
	toggle.AnchorPoint = Vector2.new(0.5, 0.5)
	toggle.Position = UDim2.fromScale(0.5, 0.5)
	local arrow = tag(
		make("ImageLabel", toggle, "Arrow", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(10, 10),
			BackgroundTransparency = 1,
			Image = arrowIcon,
			ImageColor3 = Color3.fromRGB(176, 176, 176),
			ScaleType = Enum.ScaleType.Fit,
			Rotation = 180,
			Active = false,
			Interactable = false,
			ZIndex = baseZIndex + 4,
		}),
		"ThemeImg",
		"Txt"
	)

	local tray = make("CanvasGroup", root, "Dropdown", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0, -trayGap, 0.5, 0),
		Size = UDim2.fromOffset(0, barHeight),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Visible = false,
		ZIndex = baseZIndex,
	})
	round(tray, 4)
	local trayBackground = make("Frame", tray, "Background", {
		Size = UDim2.fromScale(1, 1),
		Active = false,
		Interactable = false,
		ZIndex = baseZIndex,
	})
	menuSurface(trayBackground, baseZIndex + 1)

	local content = make("Frame", tray, "Content", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 100, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = baseZIndex + 2,
	})
	make("UIListLayout", content, "Layout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local z = baseZIndex + 3
	local hide = rowButton(content, "Hide", "TextButton", UDim2.fromOffset(textButtonWidth, buttonHeight), z)
	hide.LayoutOrder = 1
	local hideLabel = buttonLabel(hide, "Hide", z + 2)

	local emit = rowButton(content, "Emit", "TextButton", UDim2.fromOffset(textButtonWidth - 4, buttonHeight), z)
	emit.LayoutOrder = 2
	buttonLabel(emit, "Emit", z + 2)

	local divider = spacer(content, "Divider", dividerWidth, 3)
	local line = tag(
		make("Frame", divider, "Line", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = Color3.fromRGB(204, 38, 255),
			BorderSizePixel = 0,
			Active = false,
			ZIndex = z + 1,
		}),
		"ThemeBg",
		"Div"
	)
	tag(
		make("UIGradient", line, "UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.798),
				NumberSequenceKeypoint.new(0.501, 0),
				NumberSequenceKeypoint.new(1, 0.781),
			}),
		}),
		"ThemeGrad",
		"Div"
	)

	local iconButtons = {}
	local order = 4
	for index, name in { "scene", "timeline", "tools", "add", "textures" } do
		if index > 1 then
			spacer(content, "Gap" .. index, iconGap, order)
			order += 1
		end

		local button = rowButton(content, name, "ImageButton", UDim2.fromOffset(buttonHeight, buttonHeight), z)
		button.LayoutOrder = order
		order += 1
		buttonIcon(button, icons[name], z + 2)
		iconButtons[name] = button
	end

	self.root = root
	self.toggle = toggle
	self.arrow = arrow
	self.tray = tray
	self.trayContent = content
	self.hideButton = hide
	self.hideLabel = hideLabel
	self.emitButton = emit
	self.iconButtons = iconButtons
	self.trayDivider = divider

	self:wireButton(toggle, function()
		return self.open
	end)
	self:wireButton(hide, function()
		return self.hiddenAll
	end)
	self:wireButton(emit)
	self:wireButton(iconButtons.scene, function()
		return self.sceneOpen and not self.hiddenAll
	end)
	self:wireButton(iconButtons.timeline, function()
		return self.timelineOpen and not self.hiddenAll
	end)
	self:wireButton(iconButtons.tools, function()
		return self.dropdown == "tools"
	end)
	self:wireButton(iconButtons.add, function()
		return self.dropdown == "add"
	end)
	self:wireButton(iconButtons.textures, function()
		return self.texturesOpen and not self.hiddenAll
	end)

	FxLayout.centerTree(root)
	self:applyTrayItems()
	theme.applyTree(root)
	root.Parent = self.gui
end

function Widget:trayItems()
	local items = {}
	for _, child in self.trayContent:GetChildren() do
		if child:IsA("GuiObject") then
			table.insert(items, child)
		end
	end

	return items
end

function Widget:trayPosition(width)
	return UDim2.new(0, -trayGap - width / 2, 0.5, 0)
end

function Widget:applyTrayItems()
	local width = trayPadding * 2
	for _, item in self:trayItems() do
		item.Visible = not self.hiddenAll or item == self.hideButton or item == self.emitButton
		if item.Visible then
			width += item.Size.X.Offset
		end
	end

	self.trayWidth = width
	self.trayContent.Size = UDim2.new(0, width, 1, 0)
	self.trayContent.Position = UDim2.new(1, -width / 2, 0.5, 0)
	self.hideLabel.Text = self.hiddenAll and "Unhide" or "Hide"
	if self.open then
		self:cancelTray()
		self:playTray(self.tray, { Size = UDim2.fromOffset(width, barHeight), Position = self:trayPosition(width) })
	end
end

function Widget:paintButton(button, mode)
	local active = self.buttonTweens[button]
	if active then
		for _, tween in active do
			tween:Cancel()
		end
	end

	local color, transparency, halftoneColor, halftoneTransparency
	if mode == "selected" then
		color = theme.get("MenuSel", Color3.fromRGB(100, 0, 151))
		transparency, halftoneColor, halftoneTransparency = 0, black, 0.4
	elseif mode == "hover" then
		color = theme.get("MenuHov", Color3.fromRGB(34, 0, 52))
		transparency, halftoneColor, halftoneTransparency = 0, white, 0.8
	else
		color, transparency, halftoneColor, halftoneTransparency = idleColor, 1, white, 1
	end

	if button.BackgroundTransparency >= 0.99 then
		button.BackgroundColor3 = color
	end

	local tweens = {
		tweenService:Create(button, fadeInfo, { BackgroundColor3 = color, BackgroundTransparency = transparency }),
	}
	local halftone = button:FindFirstChild("Halftone")
	if halftone then
		table.insert(
			tweens,
			tweenService:Create(halftone, fadeInfo, { ImageColor3 = halftoneColor, ImageTransparency = halftoneTransparency })
		)
	end

	self.buttonTweens[button] = tweens
	for _, tween in tweens do
		tween:Play()
	end
end

function Widget:wireButton(button, isSelected)
	local hovering = false

	local function rest()
		if isSelected and isSelected() then
			self:paintButton(button, "selected")
		else
			self:paintButton(button, hovering and "hover" or "idle")
		end
	end

	self:connect(button.MouseEnter, function()
		hovering = true
		rest()
	end)
	self:connect(button.MouseLeave, function()
		hovering = false
		rest()
	end)
	self:connect(button.MouseButton1Down, function()
		self:paintButton(button, "selected")
	end)
	self:connect(button.MouseButton1Up, rest)
	self.resetters[button] = function()
		hovering = false
		rest()
	end
	rest()
end

function Widget:restButton(button)
	local reset = self.resetters[button]
	if reset then
		reset()
	end
end

function Widget:restAll()
	for button in self.resetters do
		self:restButton(button)
	end
end

function Widget:buildWindows()
	local refs = self.refs
	local mouse = refs.Mouse

	local function onResize()
		self:relayout(false)
	end

	local function onResizeEnded()
		self:saveLayout()
	end

	self.scene = FxWindow.new({
		parent = self.gui,
		name = "EclipseFXScene",
		title = "Scene",
		draggable = true,
		size = self:sizeFromSave("scene", sceneSize),
		minSize = sceneMinSize,
		zIndex = baseZIndex,
		mouse = mouse,
		grips = { "BottomLeft" },
		onResize = onResize,
		onResizeEnded = onResizeEnded,
	})
	self.host:mount("Hierarchy", self.scene.body)

	self.properties = FxWindow.new({
		parent = self.gui,
		name = "EclipseFXProperties",
		title = "Properties",
		draggable = true,
		size = self:sizeFromSave("properties", propertiesSize),
		minSize = propertiesMinSize,
		zIndex = baseZIndex,
		mouse = mouse,
		grips = { "BottomLeft" },
		onResize = onResize,
		onResizeEnded = onResizeEnded,
	})
	self.host:mount("Inspect", self.properties.body)

	self.textures = FxWindow.new({
		parent = self.gui,
		name = "EclipseFXTextures",
		title = "Textures",
		draggable = true,
		size = self:sizeFromSave("textures", texturesSize),
		minSize = texturesMinSize,
		zIndex = baseZIndex,
		mouse = mouse,
		grips = { "BottomRight" },
		onResize = onResize,
		onResizeEnded = onResizeEnded,
	})
	self:buildTextureTabs()

	self.timeline = MiniTimeline.new({
		parent = self.gui,
		state = refs.State,
		mouse = mouse,
		margin = margin,
		zIndex = baseZIndex,
		size = self:sizeFromSave("timeline", nil),
		onResize = function(_, byUser)
			if byUser then
				self:relayout(false)
			end
		end,
		onResizeEnded = function()
			self:saveLayout()
		end,
	})
	for _, name in { "scene", "properties", "textures" } do
		local window = self[name]
		self:bindPosition(window.frame, window.dragHandle, name, function(position) window:place(position, false) end)
	end
	self:bindPosition(self.timeline.window, self.timeline.dragHandle, "timeline", function(position) self.timeline:place(position, false) end)
	self.keyEditor = KeyEditor.new({
		getPosition = function() return self:positionFromSave("emit") end,
		bindPosition = function(frame, handle) return self:bindPosition(frame, handle, "emit") end,
		gui = self.gui,
		timeline = self.timeline,
		host = self.host,
		state = refs.State,
		isActive = function()
			return self:runtimeActive()
		end,
		getScale = function()
			return self:layoutScale()
		end,
		getLinked = function()
			return self:timelineVfx()
		end,
	})
	self.effectsRow = EffectsRow.new({
		animatorFrame = refs.AnimatorFrame,
		state = refs.State,
	})
	self.keyEditor:addView(self.effectsRow)

	self.host:setDrawerAnchor(function(drawer)
		local suite = self.host.suite
		if (drawer == suite.textureDrawer or drawer == suite.meshDrawer) and self.textures:isShown() then
			return self.textures.frame
		end

		if self.properties:isShown() then
			return self.properties.frame
		end

		if self.scene:isShown() then
			return self.scene.frame
		end

		if self.textures:isShown() then
			return self.textures.frame
		end

		return self.root
	end)
end

function Widget:buildTextureTabs()
	local body = self.textures.body
	local z = baseZIndex + 3
	local bar = make("Frame", body, "TabBar", {
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 0, 22),
		BackgroundTransparency = 1,
		ZIndex = z,
	})
	make("UIListLayout", bar, "Layout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local pages = make("Frame", body, "Pages", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 1, -30),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = z,
	})

	self.textureTabs = {}
	self.texturePages = {}
	for index, name in { "Textures", "Meshes" } do
		local button = tag(
			make("TextButton", bar, name, {
				Size = UDim2.fromOffset(84, 22),
				LayoutOrder = index,
				BackgroundColor3 = Color3.fromRGB(51, 0, 77),
				BorderSizePixel = 0,
				AutoButtonColor = true,
				Text = name,
				FontFace = chrome.FONT,
				TextSize = 12,
				TextColor3 = Color3.fromRGB(230, 223, 238),
				ZIndex = z + 1,
			}),
			"ThemeBg",
			"TopBtn"
		)
		tag(button, "ThemeTxt", "Txt")
		round(button, 4)
		local highlight = tag(
			make("Frame", button, "ActiveBar", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(0.5, 1),
				Size = UDim2.new(1, -8, 0, 2),
				BackgroundColor3 = Color3.fromRGB(197, 66, 110),
				BorderSizePixel = 0,
				Visible = false,
				ZIndex = z + 2,
			}),
			"ThemeBg",
			"Ph"
		)
		round(highlight, 1)
		self.textureTabs[name] = button

		local holder = make("Frame", pages, name, {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = z,
		})
		self.host:mount(name, holder)
		self.texturePages[name] = holder

		self:connect(button.Activated, function()
			self:setTexturesTab(name)
		end)
	end

	theme.applyTree(body)
	self:applyTexturesTab()
end

function Widget:applyTexturesTab()
	for name, button in self.textureTabs do
		local active = name == self.texturesTab
		button.ActiveBar.Visible = active
		button.TextTransparency = active and 0 or 0.35
		self.texturePages[name].Visible = active
	end

	self:syncBrowserTab()
end

function Widget:setTexturesTab(name)
	if self.texturesTab == name then
		return
	end

	self.texturesTab = name
	self:applyTexturesTab()
	self:saveLayout()
end

function Widget:syncBrowserTab()
	if self.host then
		self.host:setBrowserTab(self.textures and self.textures:isShown() and self.texturesTab or nil)
	end
end

function Widget:buildDropdown(name, page, tip)
	local frame = make("Frame", self.gui, "EclipseFX" .. name .. "Dropdown", {
		Size = UDim2.fromOffset(dropdownSize.X, dropdownSize.Y),
		Visible = false,
		Active = true,
		ZIndex = dropdownZIndex,
	})
	menuSurface(frame, dropdownZIndex + 1)
	local handle = make("TextButton", frame, "DragHandle", {
		Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 0, 24),
		Text = name, FontFace = chrome.FONT, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = dropdownZIndex + 3,
	})
	handle:SetAttribute("ThemeTxt", "Txt")
	self:bindPosition(frame, handle, string.lower(name))
	local footer = tip and tipHeight or 0
	local body = make("Frame", frame, "Body", {
		Position = UDim2.fromOffset(4, 24),
		Size = UDim2.new(1, -8, 1, -28 - footer),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = dropdownZIndex + 2,
	})

	if tip then
		tag(
			make("Frame", frame, "TipDivider", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, -footer),
				Size = UDim2.new(1, -16, 0, 1),
				BackgroundColor3 = Color3.fromRGB(69, 41, 93),
				BorderSizePixel = 0,
				Active = false,
				ZIndex = dropdownZIndex + 2,
			}),
			"ThemeBg",
			"Strk"
		)
		local label = tag(
			make("TextLabel", frame, "Tip", {
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 10, 1, -4),
				Size = UDim2.new(1, -20, 0, footer - 6),
				BackgroundTransparency = 1,
				Text = tip,
				FontFace = chrome.FONT,
				TextSize = 11,
				TextColor3 = Color3.fromRGB(235, 228, 242),
				TextTransparency = 0.3,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				Active = false,
				Interactable = false,
				ZIndex = dropdownZIndex + 2,
			}),
			"ThemeTxt",
			"Txt"
		)
		label.RichText = true
	end
	self.host:mount(page, body)
	FxLayout.centerTree(frame, { [body] = true })
	theme.applyTree(frame)
	return { frame = frame, body = body }
end

function Widget:buildDropdowns()
	self.dropdowns = {
		tools = self:buildDropdown("Tools", "Tools"),
		add = self:buildDropdown("Add", "Add"),
	}
end

function Widget:layoutScale()
	return math.max(self.uiScale.Scale, 0.001)
end

function Widget:screenSize()
	return self.gui.AbsoluteSize / self:layoutScale()
end

function Widget:toLayout(point)
	return (point - self.gui.AbsolutePosition) / self:layoutScale()
end

function Widget:guiRect(object)
	return self:toLayout(object.AbsolutePosition), object.AbsoluteSize / self:layoutScale()
end

function Widget:placeDropdown(name)
	local dropdown = self.dropdowns[name]
	local button = self.iconButtons[name]
	if not dropdown or not button then
		return
	end

	local screen = self:screenSize()
	local trayPosition = self:guiRect(self.tray)
	local buttonPosition, buttonSize = self:guiRect(button)
	local height = math.min(dropdownSize.Y, math.max(160, trayPosition.Y - gap - margin))
	local width = dropdownSize.X
	local x = buttonPosition.X + buttonSize.X - width
	x = math.clamp(x, margin, math.max(margin, screen.X - margin - width))
	local y = trayPosition.Y - gap - height
	local saved = self:positionFromSave(name)
	if saved then x, y = saved.X, saved.Y end
	x = math.clamp(x, margin, math.max(margin, screen.X - margin - width))
	y = math.clamp(y, margin, math.max(margin, screen.Y - margin - height))
	dropdown.frame.Size = UDim2.fromOffset(width, height)
	dropdown.frame.Position = FxLayout.centered(Vector2.new(x, math.max(margin, y)), Vector2.new(width, height))
end

function Widget:closeDropdown()
	if not self.dropdown then
		return
	end

	local previous = self.dropdowns[self.dropdown]
	self.dropdown = nil
	self:endToolDrag()
	if previous then
		local frame = previous.frame
		windowFx.shrink(frame, function()
			if not self.dropdown or self.dropdowns[self.dropdown] ~= previous then
				frame.Visible = false
			end
		end, "batch")
	end

	self:restAll()
end

function Widget:setDropdown(name)
	if self.dropdown == name then
		self:closeDropdown()
		return
	end

	local previous = self.dropdown and self.dropdowns[self.dropdown]
	if previous then
		windowFx.clear(previous.frame)
		previous.frame.Visible = false
	end

	self.dropdown = name
	local dropdown = self.dropdowns[name]
	if dropdown then
		self:placeDropdown(name)
		dropdown.frame.Visible = true
		windowFx.pop(dropdown.frame, "batch")
	end

	self:restAll()
end

function Widget:bind()
	local refs = self.refs
	self:connect(self.toggle.Activated, function()
		self:setOpen(not self.open)
	end)
	self:connect(self.hideButton.Activated, function()
		self:setHiddenAll(not self.hiddenAll)
	end)
	self:connect(self.emitButton.Activated, function()
		if self.keyEditor then
			self.keyEditor:suspendScrub()
		end

		if self.host:emit() == 0 then
			self:notify("Nothing to emit yet. Add VFX to the scene first.")
		end
	end)
	self:connect(self.iconButtons.scene.Activated, function()
		self:setSceneOpen(not self.sceneOpen)
	end)
	self:connect(self.iconButtons.timeline.Activated, function()
		self:setTimelineOpen(not self.timelineOpen)
	end)
	self:connect(self.iconButtons.tools.Activated, function()
		self:setDropdown("tools")
	end)
	self:connect(self.iconButtons.add.Activated, function()
		self:setDropdown("add")
	end)
	self:connect(self.iconButtons.textures.Activated, function()
		self:setTexturesOpen(not self.texturesOpen)
	end)

	if refs.HoverDialog then
		local tips = {
			[self.iconButtons.scene] = "View Scene",
			[self.iconButtons.timeline] = "VFX Timeline",
			[self.iconButtons.tools] = "Tools",
			[self.iconButtons.add] = "Add",
			[self.iconButtons.textures] = "Textures",
		}
		for button, text in tips do
			local release = refs.HoverDialog:latchToInstance(button, text)
			table.insert(self.connections, { Disconnect = release })
		end
	end

	if refs.AnimatorFrame then
		self:connect(refs.AnimatorFrame:GetPropertyChangedSignal("Visible"), function()
			self:refresh()
		end)
	end

	self.host:onSelectionChanged(function()
		self:applyWindows(false)
	end)

	self.host:setLinkedProvider(function()
		return self:timelineVfx()
	end)
	local nextLinkCheck = 0
	self:connect(runService.Heartbeat, function()
		if self:shouldShow() ~= self.shown or self:runtimeActive() ~= self.running then self:refresh() end
		local now = os.clock()
		if now < nextLinkCheck or not self.shown then
			return
		end

		nextLinkCheck = now + 0.5
		self:checkLinked()
	end)

	self:connect(inputModule.InputBegan, function(input)
		if input.KeyCode == Enum.KeyCode.Escape and self.dropdown and not inputModule:GetFocusedTextBox() then
			self:closeDropdown()
		end
	end)

	local unsubscribe = preferences.subscribe(function(key)
		if key == preferenceKey then
			self:refresh()
		end
	end)
	table.insert(self.connections, { Disconnect = unsubscribe })

	local unsubscribeTheme = theme.onChanged(function()
		if not self.destroyed then
			self:restAll()
		end
	end)
	table.insert(self.connections, { Disconnect = unsubscribeTheme })

	self:connect(refs.ScreenGui.Destroying, function()
		self:destroy()
	end)

	if refs.Plugin then
		self:connect(refs.Plugin.Unloading, function()
			self:destroy()
		end)
	end
end

function Widget:timelineVfx()
	local state = self.refs.State
	local rigs = state and state.getProjectRigs and state.getProjectRigs() or {}
	local scene = workspace:FindFirstChild("Eclipse FX")
	local result = {}
	for _, rig in rigs do
		if
			typeof(rig) == "Instance"
			and rig.Parent
			and not (scene and (rig == scene or rig:IsDescendantOf(scene)))
			and fxEmit.isVfxObject(rig, true)
		then
			table.insert(result, rig)
		end
	end

	return result
end

function Widget:checkLinked()
	local current = self:timelineVfx()
	local previous = self.linkedList or {}
	local same = #current == #previous
	if same then
		for index, root in current do
			if previous[index] ~= root then
				same = false
				break
			end
		end
	end

	if not same then
		self.linkedList = current
		self.host:refreshLinked()
	end
end

function Widget:runtimeActive()
	local state = self.refs.State
	local gui = self.refs.ScreenGui
	local animatorFrame = self.refs.AnimatorFrame
	return not self.destroyed
		and state ~= nil
		and state.currentRig ~= nil
		and gui ~= nil and gui.Parent ~= nil and gui.Enabled
		and animatorFrame ~= nil and animatorFrame.Parent ~= nil
		and (animatorFrame.Visible or state.PresentationHidden == true or state.CameraPoseMode == true)
end

function Widget:shouldShow()
	local animatorFrame = self.refs.AnimatorFrame
	if preferences.get(preferenceKey) ~= true or not animatorFrame or not animatorFrame.Parent then return false end
	local ancestor = animatorFrame
	while ancestor do
		if ancestor:IsA("GuiObject") and not ancestor.Visible then return false end
		if ancestor:IsA("LayerCollector") and not ancestor.Enabled then return false end
		ancestor = ancestor.Parent
	end
	return true
end

function Widget:refresh()
	if self.destroyed then
		return
	end

	local show = self:shouldShow()
	local changed = show ~= self.shown
	local running = self:runtimeActive()
	local runtimeChanged = running ~= self.running
	self.running = running
	self.shown = show
	self.root.Visible = show
	if self.effectsRow then
		self.effectsRow:setEnabled(show)
	end
	if not show then
		self:saveLayout(true)
		if self.keyEditor then self.keyEditor:closePicker(true) end
		self:cancelTray()
		self:closeDropdown()
		self.host:closePopups()
	elseif changed then
		self:setOpen(self.open, true)
	end
	if runtimeChanged then
		if running then
			self.host:start()
			if self.keyEditor then self.keyEditor.scrubSuspended = false end
		else
			self.host:stop()
		end
		if self.keyEditor then self.keyEditor:refreshScrub() end
	end

	self:applyWindows(not changed or not show)
end

function Widget:windowHidden()
	return not self.shown or self.hiddenAll
end

function Widget:applyWindows(instant)
	if self.destroyed then
		return
	end

	local hidden = self:windowHidden()
	self.scene:setState(self.sceneOpen, hidden, instant)
	self.properties:setState(self.sceneOpen and self.host:hasSceneSelection(), hidden, instant)
	self.textures:setState(self.texturesOpen, hidden, instant)
	self.timeline:setState(self.timelineOpen, hidden, instant)
	if self.keyEditor and not self.timeline:isShown() then
		self.keyEditor:closePickerFor(self.timeline, instant)
	end

	for _, panel in self.toolPanels do
		panel.window:setState(true, hidden, instant)
	end

	self:syncBrowserTab()
	self:relayout(not instant)
	self:restAll()
end

function Widget:cornerRects()
	local rects = {}
	if not self.root.Visible then
		return rects
	end

	local screen = self:screenSize()
	local rootPosition = Vector2.new(screen.X - margin - barHeight, screen.Y - margin - barHeight)
	table.insert(rects, { rootPosition, Vector2.new(barHeight, barHeight) })
	if self.open then
		local width = self.trayWidth or 0
		table.insert(rects, { rootPosition - Vector2.new(trayGap + width, 0), Vector2.new(width, barHeight) })
	end

	return rects
end

function Widget:shareAxis(keys, axis, available)
	local items, shown = {}, {}
	for _, key in keys do
		local window = self[key]
		if window:isShown() then
			table.insert(shown, key)
			table.insert(items, {
				preferred = math.min(window.preferred[axis], available),
				minimum = window.minSize[axis],
			})
		end
	end

	local shared = FxLayout.share(items, available - gap * math.max(#items - 1, 0))
	local result = {}
	for index, key in shown do
		result[key] = shared[index]
	end

	return result
end

function Widget:toolPreferred(panel, usable)
	local window = panel.window
	local minimum = window.minSize
	local width = panel.userSize and panel.userSize.X or toolPanelWidth
	local height = panel.userSize and panel.userSize.Y or toolPanelMaxHeight
	height = math.min(height, panel.contentHeight or height)
	return Vector2.new(
		math.clamp(width, minimum.X, math.max(minimum.X, usable.X)),
		math.clamp(height, minimum.Y, math.max(minimum.Y, usable.Y))
	)
end

function Widget:applyToolGrips(panel)
	if panel.gripEdge == panel.edge then
		return
	end

	panel.gripEdge = panel.edge
	if panel.edge == "Right" then
		panel.window:showGrips({ "BottomLeft" })
	elseif panel.edge == "Bottom" then
		panel.window:showGrips({ "TopRight" })
	else
		panel.window:showGrips({ "BottomRight" })
	end
end

function Widget:relayout(animated)
	if self.destroyed or not self.ready then
		return
	end

	local screen = self:screenSize()
	if screen.X <= 0 or screen.Y <= 0 then
		return
	end

	local layout = FxLayout.new({ margin = margin, gap = gap })
	layout:reset(screen)
	for _, rect in self:cornerRects() do
		layout:block(rect[1], rect[2], "corner")
	end

	local right = screen.X - margin
	local usable = screen - Vector2.new(margin * 2, margin * 2)
	local columnHeight = usable.Y - (self.root.Visible and barHeight + gap or 0)
	local widths = self:shareAxis({ "textures", "properties", "scene" }, "X", usable.X)
	local heights = self:shareAxis({ "scene", "timeline" }, "Y", columnHeight)

	local function settle(window, anchor, direction, preferred, id)
		local saved = self:positionFromSave(id)
		if saved then
			local size = Vector2.new(math.min(window.preferred.X, usable.X), math.min(window.preferred.Y, usable.Y))
			local position = layout:clampInside(saved, size)
			window:arrange(position, size, false)
			layout:block(position, size, id)
			return position, size
		end
		local minimum = window.minSize
		preferred = Vector2.new(math.max(preferred.X, minimum.X), math.max(preferred.Y, minimum.Y))
		local position, size = layout:fit(anchor, direction, preferred, minimum, id)
		if not position then
			position, size = layout:fitSliding(anchor, direction, preferred, minimum, id, "Y")
		end

		if not position then
			position, size = layout:fitSliding(anchor, direction, preferred, minimum, id, "X")
		end

		if not position then
			size = Vector2.new(math.min(preferred.X, usable.X), math.min(preferred.Y, usable.Y))
			position = layout:clampInside(FxLayout.rectFrom(anchor, direction, size), size)
		end

		window:arrange(position, size, animated)
		layout:block(position, size, id)
		return position, size
	end

	for _, panel in self.toolPanels do
		local window = panel.window
		if window:isShown() then
			local preferred = self:toolPreferred(panel, usable)
			local position, size = layout:dock(panel.edge, panel.along, preferred, window.minSize, panel)
			window:arrange(position, size, animated)
			layout:block(position, size, panel)
			self:applyToolGrips(panel)
		end
	end

	local columnTop = margin
	if self.scene:isShown() then
		local preferred = Vector2.new(widths.scene, heights.scene)
		local position, size = settle(self.scene, Vector2.new(right, margin), Vector2.new(-1, 1), preferred, "scene")
		columnTop = position.Y + size.Y + gap
	end

	if self.timeline:isShown() then
		self.timeline:setMaxSize(usable)
		local preferred = Vector2.new(math.min(self.timeline.preferred.X, usable.X), heights.timeline)
		settle(self.timeline, Vector2.new(right, columnTop), Vector2.new(-1, 1), preferred, "timeline")
	end

	if self.properties:isShown() then
		local edge = self.scene:isShown() and self.scene.position.X - gap or right
		local preferred = Vector2.new(widths.properties, math.min(self.properties.preferred.Y, usable.Y))
		settle(self.properties, Vector2.new(edge, margin), Vector2.new(-1, 1), preferred, "properties")
	end

	if self.textures:isShown() then
		local preferred = Vector2.new(widths.textures, math.min(self.textures.preferred.Y, usable.Y))
		settle(self.textures, Vector2.new(margin, margin), Vector2.new(1, 1), preferred, "textures")
	end

	if self.dropdown then
		self:placeDropdown(self.dropdown)
	end
end

function Widget:setHiddenAll(hidden)
	self.hiddenAll = hidden == true
	if self.hiddenAll then
		self:closeDropdown()
		self.host:closePopups()
	end

	self:applyTrayItems()
	self:applyWindows(false)
	self:saveLayout()
end

function Widget:setSceneOpen(open)
	if self.hiddenAll then
		return
	end

	self.sceneOpen = open == true
	self:applyWindows(false)
	self:saveLayout()
end

function Widget:setTimelineOpen(open)
	if self.hiddenAll then
		return
	end

	self.timelineOpen = open == true
	self:applyWindows(false)
	self:saveLayout()
end

function Widget:setTexturesOpen(open)
	if self.hiddenAll then
		return
	end

	self.texturesOpen = open == true
	self:applyWindows(false)
	self:saveLayout()
end

function Widget:cancelTray()
	for _, tween in self.trayTweens do
		tween:Cancel()
	end

	table.clear(self.trayTweens)
end

function Widget:playTray(target, properties)
	local tween = tweenService:Create(target, slideInfo, properties)
	table.insert(self.trayTweens, tween)
	tween:Play()
	return tween
end

function Widget:setOpen(open, instant)
	if self.destroyed or (open == self.open and not instant) then
		return
	end

	self.open = open
	if self.ready then self:saveLayout() end
	self.trayVersion = (self.trayVersion or 0) + 1
	local version = self.trayVersion
	local tray = self.tray
	self:cancelTray()
	if not open then
		self:closeDropdown()
		if self.refs.HoverDialog then
			for _, button in self.iconButtons do
				self.refs.HoverDialog:disappear(button)
			end
		end
	end

	self:restAll()
	local width = self.trayWidth or 0
	if instant then
		tray.Size = UDim2.fromOffset(open and width or 0, barHeight)
		tray.Position = self:trayPosition(open and width or 0)
		tray.GroupTransparency = open and 0 or 1
		tray.Visible = open
		self.arrow.Rotation = open and 0 or 180
		self:relayout(false)
		return
	end

	tray.Visible = true
	self:playTray(self.arrow, { Rotation = open and 0 or 180 })
	self:playTray(tray, {
		Size = UDim2.fromOffset(open and width or 0, barHeight),
		Position = self:trayPosition(open and width or 0),
		GroupTransparency = open and 0 or 1,
	}).Completed:Once(function(playback)
		if playback == Enum.PlaybackState.Completed and version == self.trayVersion and not self.open and not self.destroyed then
			tray.Visible = false
		end
	end)
	self:relayout(true)
end

function Widget:bindTools()
	local toolbox = self.host.suite.toolbox
	local form = toolbox.form
	local originalSetSections = form.setSections
	form.setSections = function(target, sections)
		originalSetSections(target, sections)
		self:bindToolHeaders()
	end

	local originalSync = toolbox.sync
	toolbox.sync = function(target)
		originalSync(target)
		self:syncToolPanels(false)
	end

	local originalRefresh = toolbox.refresh
	toolbox.refresh = function(target)
		originalRefresh(target)
		self:syncToolPanels(true)
	end

	self:bindToolHeaders()
end

function Widget:bindAdd()
	local builder = self.host.suite.builder
	local original = builder.createdHandler
	builder:setCreatedHandler(function(created)
		if original then
			original(created)
		end

		if self.dropdown == "add" then
			self:closeDropdown()
		end
	end)
end

function Widget:bindToolHeaders()
	self.headerConnections = self.headerConnections or {}
	for _, connection in self.headerConnections do
		connection:Disconnect()
	end

	table.clear(self.headerConnections)
	local form = self.host.suite.toolbox.form
	for _, entry in form.entries do
		local header = entry.header
		local key = entry.section and entry.section.key
		local id = type(key) == "string" and key:match("^Tool%.(.+)$")
		if header and id then
			table.insert(
				self.headerConnections,
				header.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						self:beginToolDrag(input, id, entry.section.title)
					end
				end)
			)
		end
	end
end

function Widget:endToolDrag()
	local drag = self.toolDrag
	if not drag then
		return
	end

	self.toolDrag = nil
	for _, connection in drag.connections do
		connection:Disconnect()
	end

	if drag.ghost then
		drag.ghost:Destroy()
	end
end

function Widget:makeGhost(title)
	local ghost = make("Frame", self.gui, "EclipseFXToolGhost", {
		Size = UDim2.fromOffset(toolPanelWidth, 30),
		BackgroundTransparency = 0.15,
		Active = false,
		ZIndex = dropdownZIndex + 50,
	})
	menuSurface(ghost, dropdownZIndex + 51)
	buttonLabel(ghost, title or "Tool", dropdownZIndex + 52)
	FxLayout.centerTree(ghost)
	theme.applyTree(ghost)
	return ghost
end

function Widget:beginToolDrag(input, id, title, panel)
	self:endToolDrag()
	local start = inputModule:GetMouseLocation()
	local drag = { connections = {}, id = id, title = title, panel = panel, moved = false }
	self.toolDrag = drag

	local function pointer()
		return self:toLayout(inputModule:GetMouseLocation())
	end

	table.insert(
		drag.connections,
		inputModule.InputChanged:Connect(function(changed)
			if changed.UserInputType ~= Enum.UserInputType.MouseMovement then
				return
			end

			local current = inputModule:GetMouseLocation()
			if not drag.moved then
				if (current - start).Magnitude < dragThreshold then
					return
				end

				drag.moved = true
				drag.ghost = self:makeGhost(title)
				if panel then
					panel.window.frame.Visible = false
				end
			end

			local point = pointer()
			drag.ghost.Position = UDim2.fromOffset(point.X, point.Y)
		end)
	)
	table.insert(
		drag.connections,
		inputModule.InputEnded:Connect(function(ended)
			if ended.UserInputType ~= input.UserInputType then
				return
			end

			local moved = drag.moved
			local point = pointer()
			self:endToolDrag()
			if not moved then
				return
			end

			if panel then
				panel.window.frame.Visible = panel.window:isShown()
				self:redockTool(panel, point)
				return
			end

			local dropdown = self.dropdown and self.dropdowns[self.dropdown]
			if dropdown then
				local position, size = self:guiRect(dropdown.frame)
				local inside = point.X >= position.X
					and point.X <= position.X + size.X
					and point.Y >= position.Y
					and point.Y <= position.Y + size.Y
				if inside then
					return
				end
			end

			self:dockTool(id, point)
		end)
	)
	table.insert(drag.connections, inputModule.WindowFocusReleased:Connect(function()
		self:endToolDrag()
		if panel then
			panel.window.frame.Visible = panel.window:isShown()
		end
	end))
end

function Widget:findToolPanel(id)
	for _, panel in self.toolPanels do
		if panel.id == id then
			return panel
		end
	end

	return nil
end

function Widget:edgeFor(point, size)
	local layout = FxLayout.new({ margin = margin, gap = gap })
	layout:reset(self:screenSize())
	local edge = layout:nearestEdge(point)
	return edge, layout:alongFromPoint(edge, point, size)
end

function Widget:dockTool(id, point)
	local existing = self:findToolPanel(id)
	if existing then
		self:redockTool(existing, point)
		return
	end

	local panel = self:createToolPanel(id)
	if not panel then
		return
	end

	panel.edge, panel.along = self:edgeFor(point, panel.window.size)
	table.insert(self.toolPanels, panel)
	self:closeDropdown()
	self:applyWindows(false)
	self:saveLayout()
end

function Widget:redockTool(panel, point)
	panel.edge, panel.along = self:edgeFor(point, panel.window.size)
	self:relayout(true)
	self:saveLayout()
end

function Widget:removeToolPanel(panel)
	local index = table.find(self.toolPanels, panel)
	if index then
		table.remove(self.toolPanels, index)
	end

	if panel.form then
		panel.form:destroy()
	end

	panel.window:destroy()
	self:relayout(true)
	self:saveLayout()
end

function Widget:createToolPanel(id)
	local suite = self.host.suite
	local tool = suite.toolbox:getTool(id)
	if not tool then
		return nil
	end

	local panel = { id = id, tool = tool }
	panel.window = FxWindow.new({
		parent = self.gui,
		name = "EclipseFXTool_" .. id,
		title = tool.title,
		titleSize = 13,
		titleHeight = 26,
		size = Vector2.new(toolPanelWidth, 120),
		minSize = toolPanelMinSize,
		zIndex = baseZIndex + 5,
		mouse = self.refs.Mouse,
		closable = true,
		draggable = true,
		inset = 6,
		onResize = function(size, byUser)
			if byUser then
				panel.userSize = size
			end

			self:relayout(false)
		end,
		onResizeEnded = function()
			self:saveLayout()
		end,
	})

	local list = make("ScrollingFrame", panel.window.body, "List", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = baseZIndex + 7,
	})
	local layout = make("UIListLayout", list, "Layout", {
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	make("UIPadding", list, "Padding", {
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 6),
	})

	panel.form = self.host.formClass.new(list, suite.window.templates, suite.context)
	panel.list = list
	panel.layout = layout
	self:buildToolForm(panel)

	panel.window:connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
		self:fitToolPanel(panel)
	end)
	panel.window:connect(panel.window.closeButton.Activated, function()
		self:removeToolPanel(panel)
	end)
	panel.window:connect(panel.window.dragHandle.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:beginToolDrag(input, id, tool.title, panel)
		end
	end)

	self.host:restyle(panel.window.frame)
	task.defer(function()
		self:fitToolPanel(panel)
	end)
	return panel
end

function Widget:buildToolForm(panel)
	panel.signature = panel.tool:getSignature()
	panel.form:setSections({
		{
			key = "Tool." .. panel.id,
			collapsed = false,
			fields = panel.tool:getFields(),
		},
	})
	self.host:restyle(panel.list)
end

function Widget:fitToolPanel(panel)
	if panel.window.destroyed then
		return
	end

	local content = panel.layout.AbsoluteContentSize.Y / math.max(motion.scale(panel.list), 0.001)
	local height = math.floor(content + toolChrome + 0.5)
	if not panel.contentHeight or math.abs(height - panel.contentHeight) > 1 then
		panel.contentHeight = height
		self:relayout(false)
	end
end

function Widget:syncToolPanels(refreshOnly)
	for _, panel in self.toolPanels do
		if panel.tool:getSignature() ~= panel.signature then
			self:buildToolForm(panel)
		elseif refreshOnly then
			panel.form:refresh()
		end
	end
end

function Widget:restoreTools()
	local saved = self.saved and self.saved.tools
	if type(saved) ~= "table" then
		return
	end

	self.restoring = true
	for _, entry in saved do
		if type(entry) == "table" and type(entry.id) == "string" and not self:findToolPanel(entry.id) then
			local panel = self:createToolPanel(entry.id)
			if panel then
				local edge = entry.edge
				if edge ~= "Left" and edge ~= "Right" and edge ~= "Top" and edge ~= "Bottom" then
					edge = "Top"
				end

				panel.edge = edge
				panel.along = tonumber(entry.along) or margin
				local size = entry.size
				if type(size) == "table" and tonumber(size[1]) and tonumber(size[2]) then
					panel.userSize = Vector2.new(tonumber(size[1]), tonumber(size[2]))
				end
				table.insert(self.toolPanels, panel)
			end
		end
	end

	self.restoring = false
end

function Widget:destroy()
	if self.destroyed then
		return
	end

	if self.ready then self:saveLayout(true) end
	self.destroyed = true
	self:endToolDrag()
	self:cancelTray()
	for _, tweens in self.buttonTweens do
		for _, tween in tweens do
			tween:Cancel()
		end
	end

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	if self.headerConnections then
		for _, connection in self.headerConnections do
			connection:Disconnect()
		end
	end

	if self.keyEditor then
		pcall(function()
			self.keyEditor:destroy()
		end)
	end

	if self.effectsRow then
		pcall(function()
			self.effectsRow:destroy()
		end)
	end

	if self.host then
		pcall(function()
			self.host:destroy()
		end)
	end

	for _, panel in self.toolPanels do
		pcall(function()
			panel.form:destroy()
		end)
		panel.window:destroy()
	end

	table.clear(self.toolPanels)
	pcall(function()
		self.timeline:destroy()
	end)
	for _, window in { self.scene, self.properties, self.textures } do
		if window then
			window:destroy()
		end
	end

	if self.gui then self.gui:Destroy() end
end

local active

function eclipseFx.init(refs)
	if active then
		active:destroy()
		active = nil
	end

	if not refs or not refs.ScreenGui or not refs.ScreenGui.Parent then
		return
	end

	active = Widget.new(refs)
end

function eclipseFx.get()
	return active
end

function eclipseFx.isSceneOpen()
	return active ~= nil and active.sceneOpen
end

function eclipseFx.isTimelineOpen()
	return active ~= nil and active.timelineOpen
end

function eclipseFx.getSceneEffects()
	return active and active.host:getEffects()
end

function eclipseFx.destroy()
	if active then
		active:destroy()
		active = nil
	end
end

return eclipseFx
