							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = require(script.Parent.ShapeKit)

local slash = {}

slash.id = "Slash"
slash.title = "Slash"
slash.root = "Part"

slash.params = ShapeKit.join({
	{ name = "Radius", kind = "number", default = 6, min = 0.1, max = 200 },
	{ name = "Arc", kind = "number", default = 140, min = 5, max = 350 },
	{ name = "Width", kind = "number", default = 3, min = 0, max = 50, tip = "The widest point, in the middle of the slash." },
	{ name = "Sharpness", kind = "number", default = 1, min = 0.2, max = 4, tip = "Higher values keep the ends thin for longer." },
	{ name = "Points", kind = "number", default = 6, min = 2, max = 16, integer = true },
	{ name = "Fade", kind = "toggle", default = true, tip = "Fades the slash out towards its tips." },
	{ name = "Upright", kind = "toggle", default = false },
}, ShapeKit.beamParams())

function slash.build(kit, params)
	local points = math.clamp(math.round(params.Points), 2, 16)
	local arc = math.rad(math.clamp(params.Arc, 1, 350))
	local step = arc / points
	local handle = 4 / 3 * math.tan(step / 4) * params.Radius
	local samples = {}

	for index = 0, points do
		local fraction = index / points
		local angle = -arc / 2 + index * step
		local profile = math.sin(math.pi * fraction)
		local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))

		table.insert(samples, {
			position = radial * params.Radius,
			tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle)),
			normal = if params.Upright then radial else Vector3.yAxis,
			handle = handle,
			width = params.Width * profile ^ math.max(params.Sharpness, 0.05),
			fade = if params.Fade then 1 - profile else 0,
		})
	end

	kit:path(samples, { closed = false })
end

return slash
]]></ProtectedString>
								<string name="ScriptGuid">{AE0F2401-144C-4CE3-8380-DEC7A89E498F}</string>
