							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local Form = require(script.Parent.Form)
local PremiumGate = require(script.Parent.Parent.Premium.PremiumGate)

local Toolbox = {}
Toolbox.__index = Toolbox

Toolbox.toolNames = {
	"SnapTool",
	"TransformTool",
	"AlignTool",
	"MirrorTool",
	"RadialTool",
	"LinearTool",
	"RandomizeTool",
	"AdvancedRandomTool",
	"ResizeTool",
	"RetimeTool",
	"TransparencyTool",
	"RecolorTool",
	"SwapColorTool",
	"AdjustTool",
	"ClipboardTool",
}

function Toolbox.new(page: Frame, templates: Instance, context)
	local self = setmetatable({}, Toolbox)

	self.page = page
	self.search = page.Search
	self.context = context
	self.form = Form.new(page.List, templates, context)
	self.tools = {}
	self.built = false
	self.signature = ""
	self.unsubscribe = nil
	self.connections = {}

	for _, name in Toolbox.toolNames do
		local Class = require(script.Parent.Tools[name])

		table.insert(self.tools, Class.new(context))
	end

	table.insert(self.connections, self.search:GetPropertyChangedSignal("Text"):Connect(function()
		self.form:setFilter(self.search.Text)
	end))

	return self
end

function Toolbox:getTool(id: string)
	for _, tool in self.tools do
		if tool.id == id then
			return tool
		end
	end

	return nil
end

function Toolbox:build()
	local sections = {}

	for _, tool in self.tools do
		table.insert(sections, {
			title = tool.title,
			key = "Tool." .. tool.id,
			collapsed = tool.collapsed,
			fields = tool:getFields(),
		})
	end

	self.form:setSections(sections)
	self.built = true
	self.signature = self:getSignature()
end

function Toolbox:getSignature(): string
	local parts = {}

	for _, tool in self.tools do
		table.insert(parts, tool:getSignature())
	end

	return table.concat(parts, "|")
end

function Toolbox:sync()
	if self.built and self:getSignature() ~= self.signature then
		self:build()
	end
end

function Toolbox:start()
	if not self.built then
		self:build()
	else
		self.form:refresh()
	end

	if not self.unsubscribe then
		self.unsubscribe = PremiumGate.get():onChanged(function()
			self:sync()
		end)
	end
end

function Toolbox:stop()
	if self.unsubscribe then
		self.unsubscribe()
		self.unsubscribe = nil
	end

	self.form:clear()
	self.built = false
end

function Toolbox:refresh()
	if self.built then
		self.form:refresh()
	end
end

function Toolbox:destroy()
	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)

	for _, tool in self.tools do
		tool:destroy()
	end

	self.form:destroy()
end

return Toolbox
]]></ProtectedString>
							<string name="ScriptGuid">{73126FD8-D712-4468-99B7-CDDFB4BF2EFF}</string>
