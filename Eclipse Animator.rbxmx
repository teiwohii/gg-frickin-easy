		for _, entry in channels do

			local row = entry.row

			local copy = copies[entry.source]

			local global = globalRecords[row.Target]

			if global and #row.Samples == 1 and row.Kind == "Property" then

				local authored = false

				for _, motor in properties.list(entry.source) do

					local property = motor.PropertyId == "TimeOfDay" and "ClockTime"

						or motor.PropertyId

					if property == row.Property and next(authoredTracks[motor] or {}) then

						authored = true

						break

					end

				end

				if not authored then

					redundant[row] = true

					global.Properties[row.Property] = nil

				end

			end

			if

				copy

				and copy.Parent

				and not bound(entry.source)

				and #row.Samples == 1

				and row.Kind == "Property"

