							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = require(script.Parent.ShapeKit)

local spiral = {}

spiral.id = "Spiral"
spiral.title = "Spiral"
spiral.root = "Part"

spiral.params = ShapeKit.join({
	{ name = "Radius", kind = "number", default = 3, min = 0, max = 200, tip = "Radius at the bottom of the spiral." },
	{ name = "EndRadius", label = "End Radius", kind = "number", default = 3, min = 0, max = 200, tip = "Radius at the top. Make it smaller for a cone." },
	{ name = "Height", kind = "number", default = 6, min = 0, max = 200 },
	{ name = "Turns", kind = "number", default = 2, min = 0.1, max = 12 },
	{ name = "Width", kind = "number", default = 0.8, min = 0, max = 50 },
	{ name = "EndWidth", label = "End Width", kind = "number", default = 0.2, min = 0, max = 50 },
	{ name = "Resolution", kind = "number", default = 6, min = 3, max = 16, integer = true, tip = "Beams per turn." },
	{ name = "Clockwise", kind = "toggle", default = false },
	{ name = "Upright", kind = "toggle", default = true },
}, ShapeKit.beamParams())

spiral.maximumBeams = 96

function spiral.build(kit, params)
	local turns = math.clamp(params.Turns, 0.1, 12)
	local resolution = math.clamp(math.round(params.Resolution), 3, 16)
	local total = math.clamp(math.round(turns * resolution), 2, spiral.maximumBeams)
	local sweep = turns * math.pi * 2 * (if params.Clockwise then -1 else 1)
	local growth = params.EndRadius - params.Radius
	local samples = {}

	for index = 0, total do
		local fraction = index / total
		local angle = sweep * fraction
		local radius = params.Radius + growth * fraction
		local cosine = math.cos(angle)
		local sine = math.sin(angle)
		local derivative = Vector3.new(-sine * radius * sweep + cosine * growth, params.Height, cosine * radius * sweep + sine * growth)

		table.insert(samples, {
			position = Vector3.new(cosine * radius, params.Height * fraction, sine * radius),
			tangent = derivative,
			normal = if params.Upright then Vector3.new(cosine, 0, sine) else Vector3.yAxis,
			handle = derivative.Magnitude / total / 3,
			width = params.Width + (params.EndWidth - params.Width) * fraction,
		})
	end

	kit:path(samples, { closed = false })
end

return spiral
]]></ProtectedString>
								<string name="ScriptGuid">{4E436B09-3C49-4D0E-8A7A-6F3F2826F135}</string>
