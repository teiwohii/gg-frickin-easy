							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local LibraryKind = require(script.Parent.LibraryKind)
local soundCue = require(script.Parent.Parent.Animation.soundCue)
local SoundHost = require(script.Parent.Parent.Utility.SoundHost)

local SoundLibraryKind = setmetatable({}, { __index = LibraryKind })
SoundLibraryKind.__index = SoundLibraryKind

SoundLibraryKind.id = "Sound"
SoundLibraryKind.label = "Sound"
SoundLibraryKind.plural = "Sounds"
SoundLibraryKind.order = 10
SoundLibraryKind.fallbackIcon = "Sound"
SoundLibraryKind.singleText = "Sound"
SoundLibraryKind.countText = "%d sounds"
SoundLibraryKind.tip = "Sounds with their id, volume, speed and timing."

function SoundLibraryKind.new(definition)
	local self = setmetatable({}, SoundLibraryKind)

	self:configure(definition)
	self.sources = {}
	self.previewed = nil

	return self
end

function SoundLibraryKind:accepts(roots: { Instance }): boolean
	if #roots == 0 then
		return false
	end

	for _, root in roots do
		if not soundCue.isHost(root) then
			return false
		end
	end

	return true
end

function SoundLibraryKind:getIcon(_roots: { Instance }): string
	return self.fallbackIcon
end

function SoundLibraryKind:canPreview(): boolean
	return true
end

function SoundLibraryKind:isPreviewing(item): boolean
	if self.previewed ~= item then
		return false
	end

	local host = SoundHost.get()

	for _, source in self.sources do
		if host:isPlaying(source) then
			return true
		end
	end

	return false
end

function SoundLibraryKind:stopPreview()
	local host = SoundHost.get()

	for _, source in self.sources do
		host:release(source)
		source:Destroy()
	end

	table.clear(self.sources)
	self.previewed = nil
end

function SoundLibraryKind:preview(library, item): boolean
	local playing = self:isPreviewing(item)

	self:stopPreview()

	if playing then
		return false
	end

	local success, roots = pcall(function()
		return library.specs:buildEncoded(item.data, CFrame.identity)
	end)

	if not success then
		return false
	end

	local host = SoundHost.get()
	local started = false

	for _, root in roots do
		if soundCue.isHost(root) and (root :: Sound).SoundId ~= "" then
			table.insert(self.sources, root)
			started = host:play(root :: Sound, 0) ~= nil or started
		else
			root:Destroy()
		end
	end

	self.previewed = item

	return started
end

return SoundLibraryKind
]]></ProtectedString>
