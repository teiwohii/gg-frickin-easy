						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local Slider = {}
Slider.__index = Slider

function Slider.new(track: GuiObject)
	local self = setmetatable({}, Slider)

	self.track = track
	self.fill = track.Bar.Fill
	self.handle = track.Handle
	self.value = 0
	self.dragging = false
	self.changedHandler = nil
	self.connections = {}

	self:bind()
	self:render()

	return self
end

function Slider:connect(signal: RBXScriptSignal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function Slider:isPressInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

function Slider:isMoveInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

function Slider:bind()
	self:connect(self.track.InputBegan, function(input)
		if self:isPressInput(input) then
			self.dragging = true
			self:drag(input.Position.X)
		end
	end)

	self:connect(userInputService.InputChanged, function(input)
		if self.dragging and self:isMoveInput(input) then
			self:drag(input.Position.X)
		end
	end)

	self:connect(userInputService.InputEnded, function(input)
		if self:isPressInput(input) then
			self.dragging = false
		end
	end)
end

function Slider:setChangedHandler(handler: ((number) -> ())?)
	self.changedHandler = handler
end

function Slider:getValue(): number
	return self.value
end

function Slider:isDragging(): boolean
	return self.dragging
end

function Slider:getValueAt(x: number): number
	local width = self.track.AbsoluteSize.X

	if width <= 0 then
		return self.value
	end

	return math.clamp((x - self.track.AbsolutePosition.X) / width, 0, 1)
end

function Slider:render()
	self.fill.Size = UDim2.fromScale(self.value, 1)
	self.handle.Position = UDim2.fromScale(self.value, 0.5)
end

function Slider:setValue(value: number, silent: boolean?)
	local clamped = math.clamp(value, 0, 1)

	if clamped == self.value then
		return
	end

	self.value = clamped
	self:render()

	if not silent and self.changedHandler then
		self.changedHandler(clamped)
	end
end

function Slider:drag(x: number)
	self:setValue(self:getValueAt(x))
end

function Slider:stop()
	self.dragging = false
end

function Slider:destroy()
	self.dragging = false
	self.changedHandler = nil

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
end

return Slider
]]></ProtectedString>
							<string name="ScriptGuid">{47C0AEEC-B9BF-45BF-B42E-B39761934C55}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Slider</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
