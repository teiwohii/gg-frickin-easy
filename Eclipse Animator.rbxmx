					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local objects = require("objects")
local organization = require("organization")
local EffectPreview = {}
EffectPreview.__index = EffectPreview

function EffectPreview.new(viewport, gate)
	local root = Instance.new("Frame")
	root.Name = "CameraEffects"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ClipsDescendants = true
	root.Active = false
	root.ZIndex = viewport.ZIndex + 1
	root.Parent = viewport
	return setmetatable({ root = root, rows = {}, gate = gate }, EffectPreview)
end

function EffectPreview:destroy()
	self.root:Destroy()
	table.clear(self.rows)
end

 
 
function EffectPreview:step(rigs, selectedCamera, effects, cf, fov, render)
	local size = self.root.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then
		return
	end
	local aspect = size.X / size.Y
	local gateSize = self.gate and self.gate.AbsoluteSize or size
	local gateScale = Vector2.new(gateSize.X / size.X, gateSize.Y / size.Y)
	local tangent = math.tan(math.rad(fov) * 0.5)
	local function project(point)
		local p = cf:PointToObjectSpace(point)
		if p.Z >= -0.001 then
			return nil
		end
		return Vector2.new(
			0.5 + p.X / (-p.Z * 2 * tangent * aspect),
			0.5 - p.Y / (-p.Z * 2 * tangent)
		)
	end
	local used = {}
	for _, model in rigs do
		if not objects.is(model) or not model.Parent then
			continue
		end
		local kind = objects.kind(model)
		local letterbox = kind == "Letterbox"
		local solid = letterbox and model:GetAttribute("EffectStyle") == "Solid"
		local overlay = kind == "Screen Cover" or kind == "Vignette" or kind == "Impact Frames"
		if not letterbox and not overlay then
			continue
		end
		local visible = objects.read(model, "Enabled") and organization.isEnabled(model)
		if letterbox then
			local camera = effects and effects.resolveCamera(model:GetAttribute("EffectCameraId"))
			visible = visible
				and camera ~= nil
				and camera.enabled ~= false
				and camera.rig == selectedCamera
		end
		if not visible then
			continue
		end
		used[model] = true
		local row = self.rows[model]
		if not row then
			row = {}
			self.rows[model] = row
			if overlay then
				local host = Instance.new("Frame")
				host.AnchorPoint = Vector2.new(0.5, 0.5)
				host.Position = UDim2.fromScale(0.5, 0.5)
				host.BackgroundTransparency = 1
				host.BorderSizePixel = 0
				host.ClipsDescendants = true
				host.Parent = self.root
				row.host = host
				row.overlay = objects.overlay(model, host)
			end
		end
		if overlay then
			row.host.Size = UDim2.fromScale(gateScale.X, gateScale.Y)
			row.host.ZIndex = math.clamp(objects.read(model, "ZIndex") + 101, 1, 201)
			objects.paintOverlay(model, row.overlay, true)
		else
			for _, name in solid and { "Top", "Bottom" } or { "VFX" } do
				local part = model:FindFirstChild(name, true)
				if not part or not part:IsA("BasePart") then
					if row[name] then
						row[name].Visible = false
					end
					continue
				end
				local bar = row[name]
				if not bar then
					bar = Instance.new("Frame")
					bar.Name = name
					bar.AnchorPoint = Vector2.new(0.5, 0.5)
					bar.BorderSizePixel = 0
					bar.Active = false
					bar.Parent = self.root
					local gradient = Instance.new("UIGradient")
					gradient.Parent = bar
					row[name] = bar
				end
				local frame, dimensions = part.CFrame, part.Size
				if render then
					local reference = model:GetAttribute("EffectReferenceAspect")
					frame, dimensions = require("layer").project(
						frame,
						dimensions,
						cf,
						objects.read(model, "ZIndex"),
						render.view,
						render.fov,
						render.renderFov,
						true,
						nil,
						solid and reference
							and math.max(1, gateSize.X / math.max(1, gateSize.Y) / reference)
							or 1
					)
				end
				if not frame then
					bar.Visible = false
					continue
				end
				local center = project(frame.Position)
				local left = project(frame * Vector3.new(-dimensions.X * 0.5, 0, 0))
				local right = project(frame * Vector3.new(dimensions.X * 0.5, 0, 0))
				local top = project(frame * Vector3.new(0, dimensions.Y * 0.5, 0))
				local bottom = project(frame * Vector3.new(0, -dimensions.Y * 0.5, 0))
				bar.Visible = center ~= nil
					and left ~= nil
					and right ~= nil
					and top ~= nil
					and bottom ~= nil
				if bar.Visible then
					local x = (right - left) * size
					local y = (bottom - top) * size
					bar.Position = UDim2.fromScale(center.X, center.Y)
					bar.Size = UDim2.fromOffset(math.round(x.Magnitude), math.round(y.Magnitude))
					bar.Rotation = math.deg(math.atan2(x.Y, x.X))
					bar.BackgroundTransparency =
						solid and math.clamp(objects.read(model, "Transparency"), 0, 1) or 1
					local gradient = objects.read(model, "Gradient")
					local color = objects.read(model, "Color")
					bar.BackgroundColor3 = gradient and Color3.new(1, 1, 1) or color
					bar.UIGradient.Enabled = solid and gradient
					bar.UIGradient.Color = ColorSequence.new(color, objects.read(model, "Color2"))
					bar.UIGradient.Rotation = objects.read(model, "GradientRotation")
					bar.ZIndex = math.clamp(objects.read(model, "ZIndex") + 101, 1, 201)
					if not solid then
						objects.previewVFX(model, part, bar, render and render.time or 0)
					end
				end
			end
		end
	end
	for model, row in self.rows do
		if not used[model] then
			for _, object in row do
				object:Destroy()
			end
			self.rows[model] = nil
		end
	end
end

return EffectPreview
]]></ProtectedString>
