				<Item class="ModuleScript" referent="RBX8C65A1F55F394FF1A55766A3F556ED85">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local config = require("smearConfig")
local tool = require("tool")
local input = require("userInputService")
local editor = {}
local window
local font = require("chrome").FONT

function editor.close()
	if window then window:close(true) end
end

function editor.open(refs, explicit, keyFrame)
	editor.close()
	local smears, binding = require("smearFrames"), require("smearBinding")
	local target = explicit or binding.selected(refs.State)
	local editing = binding.is(target) and target or nil
	if not editing and target then
		for _, model in refs.State.getAllRigs() do
			if binding.is(model) and binding.resolve(model, refs.State.getAllRigs()) == target then editing = model; break end
		end
	end
	if editing then target = binding.resolve(editing, refs.State.getAllRigs()) end
	if not target then
		require("notification").show("SMEAR FRAMES", "Select a bone or part in the timeline first.", 5)
		return false
	end
	local raw = refs.State.Timeline:GetState()
	if raw.Exporting then return false end
	local values = editing and config.read(editing) or table.clone(config.defaults)
	local initial = editing and smears.range(editing) or {whole = true, start = math.round(raw.CurrentTime * raw.FPS), finish = math.round(require("rawState").Config.Length * raw.FPS)}
	initial.finish = math.max(initial.start, initial.finish)
	local whole, rangeChanged = initial.whole, false
	local mode = values.MatchColor and "Bone" or "Custom"
	local ramp, current, refresh, commit
	window = tool.new(refs, "EclipseSmearFrames", "SMEAR FRAMES", Vector2.new(360, 288), false, function()
		if ramp and require("picker").isOpen(ramp) then require("picker").close(true) end
		window = nil
	end, {Scrollable = true, FitToViewport = true, Resizable = false})
	current = window
	local frame, body = current.frame, current.content
	local scroll = body.Parent
	scroll.AnchorPoint, body.AnchorPoint = Vector2.zero, Vector2.zero
	scroll.Position, body.Position = UDim2.fromOffset(14, 34), UDim2.new()
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	body.Size = UDim2.new(1, -6, 0, 220)
	local function label(parent, name, text, x, y, width, height)
		local value = tool.label(parent, name, text, UDim2.fromOffset(x, y), UDim2.fromOffset(width, height or 28))
		value.FontFace, value.TextSize = font, 16
		return value
	end
	local function button(parent, name, text, x, y, width, action)
		local value, title = tool.button(parent, name, text, UDim2.fromOffset(x, y), UDim2.fromOffset(width, 28), action)
		title.FontFace, title.TextSize = font, 15
		return value
	end
	local function field(parent, name, value, x, y, width, options)
		local box = tool.field(parent, name, value, UDim2.fromOffset(x, y), UDim2.fromOffset(width, 28), options)
		box.FontFace, box.TextSize, box.TextXAlignment = font, 17, Enum.TextXAlignment.Center
		return box
	end
	local targetLabel = label(body, "Target", target.Name, 0, 0, 320, 25)
	targetLabel.TextWrapped = false
	targetLabel.TextTruncate = Enum.TextTruncate.AtEnd
	local tabs = tool.make("Frame", body, "TimingTabs", {Position = UDim2.fromOffset(0, 32), Size = UDim2.fromOffset(320, 30), BorderSizePixel = 0})
	tabs:SetAttribute("ThemeBg", "Pnl")
	tabs:SetAttribute("EclipseTabBar", true)
	tool.make("UICorner", tabs, "Corner", {CornerRadius = UDim.new(0, 5)})
	local outline = tool.make("UIStroke", tabs, "Outline", {Transparency = .35, Thickness = 1})
	outline:SetAttribute("ThemeStrk", "Strk")
	local allButton = button(tabs, "Whole", "Whole animation", 2, 2, 156, function() whole = true; rangeChanged = true; commit() end)
	local rangeButton = button(tabs, "Range", "Frame range", 162, 2, 156, function() whole = false; rangeChanged = true; commit() end)
	allButton.Size, rangeButton.Size = UDim2.fromOffset(156, 26), UDim2.fromOffset(156, 26)
	allButton.TextLabel.TextSize, rangeButton.TextLabel.TextSize = 11, 11
	local rangeRow = tool.make("Frame", body, "RangeFields", {BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 76), Size = UDim2.fromOffset(320, 28)})
	label(rangeRow, "From", "From", 0, 0, 44)
	local startField = field(rangeRow, "StartFrame", initial.start, 48, 0, 88, {min = 0, max = 1000000, step = 1})
	label(rangeRow, "To", "to", 148, 0, 24)
	local endField = field(rangeRow, "EndFrame", initial.finish, 180, 0, 88, {min = 0, max = 1000000, step = 1})
	label(rangeRow, "Units", "frames", 274, 0, 48).TextSize = 13
	local pathInitialized = values.Path == "Connect"
	local pathRow = tool.make("Frame", body, "Path", {BackgroundTransparency = 1, Size = UDim2.fromOffset(320, 30)})
	label(pathRow, "Label", "Path", 0, 0, 88)
	local pathTabs = tool.make("Frame", pathRow, "Choices", {Position = UDim2.fromOffset(90, 0), Size = UDim2.fromOffset(230, 30), BorderSizePixel = 0})
	pathTabs:SetAttribute("ThemeBg", "Pnl")
	pathTabs:SetAttribute("EclipseTabBar", true)
	tool.make("UICorner", pathTabs, "Corner", {CornerRadius = UDim.new(0, 5)})
	local pathOutline = tool.make("UIStroke", pathTabs, "Outline", {Transparency = .35, Thickness = 1})
	pathOutline:SetAttribute("ThemeStrk", "Strk")
	local pathFields = tool.make("Frame", body, "PathFields", {BackgroundTransparency = 1, Size = UDim2.fromOffset(320, 64)})
	label(pathFields, "From", "From", 0, 0, 44)
	local pathStart = field(pathFields, "PathStart", values.PathStart, 48, 0, 88, {min = 0, max = 1000000, step = 1})
	label(pathFields, "To", "to", 148, 0, 24)
	local pathEnd = field(pathFields, "PathEnd", values.PathEnd, 180, 0, 88, {min = 0, max = 1000000, step = 1})
	label(pathFields, "Units", "frames", 274, 0, 48).TextSize = 13
	local function useSpan(selectedOnly)
		local first, finish = binding.span(target, raw, selectedOnly)
		if not first then
			require("notification").show("SMEAR PATH", "Select two or more keys on this bone's track.", 4)
			return false
		end
		pathStart.Text, pathEnd.Text = tostring(first), tostring(finish)
		pathInitialized = true
		return true
	end
	button(pathFields, "SelectedKeys", "Use selected keys", 90, 36, 230, function() if useSpan(true) then commit() end end)
	local pathButtons = {}
	for index, spec in {{"Motion", "Follow motion"}, {"Connect", "Connect keys"}} do
		local item = button(pathTabs, spec[1], spec[2], 2 + (index - 1) * 114, 2, 112, function()
			if spec[1] == "Connect" and not pathInitialized then useSpan(false) end
			values.Path = spec[1]
			commit()
		end)
		item.Size = UDim2.fromOffset(112, 26)
		item.TextLabel.TextSize = 11
		pathButtons[spec[1]] = item
	end
	local fields, rows = {}, {}
	local styles = tool.make("Frame", body, "Styles", {BackgroundTransparency = 1, Size = UDim2.fromOffset(320, 68)})
	label(styles, "Label", "Style", 0, 20, 88)
	local choices = tool.make("Frame", styles, "Choices", {Position = UDim2.fromOffset(90, 0), Size = UDim2.fromOffset(230, 68), BorderSizePixel = 0})
	choices:SetAttribute("ThemeBg", "Pnl")
	choices:SetAttribute("EclipseTabBar", true)
	tool.make("UICorner", choices, "Corner", {CornerRadius = UDim.new(0, 5)})
	local border = tool.make("UIStroke", choices, "Outline", {Transparency = .35, Thickness = 1})
	border:SetAttribute("ThemeStrk", "Strk")
	local styleButtons = {}
	for index, name in {"Classic", "Brush", "Slashes", "Crescent"} do
		local item = button(choices, name, name, 4 + (index - 1) % 2 * 114, 4 + math.floor((index - 1) / 2) * 32, 108, function()
			values.Style = name
			commit()
		end)
		local edge = tool.make("UIStroke", item, "StyleOutline", {Transparency = .65, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
		edge:SetAttribute("ThemeStrk", "Strk")
		styleButtons[name] = item
	end
	for _, spec in {{"Strength", "Amount", .1, 3}, {"Width", "Width", .1, 2}, {"Opacity", "Opacity", 0, 1}} do
		local id, low, high = spec[1], spec[3], spec[4]
		local row = tool.make("Frame", body, id .. "Row", {BackgroundTransparency = 1, Size = UDim2.fromOffset(320, 28)})
		table.insert(rows, row)
		label(row, "Label", spec[2], 0, 0, 96)
		local box = field(row, id, values[id], 256, 0, 64, {min = low, max = high, step = .05})
		fields[id] = box
		local slider = tool.make("TextButton", row, "Slider", {Text = "", BackgroundTransparency = 1, Position = UDim2.fromOffset(104, 0), Size = UDim2.fromOffset(138, 28)})
		local track = tool.make("Frame", slider, "Track", {BackgroundColor3 = Color3.fromRGB(70, 79, 87), BorderSizePixel = 0, Position = UDim2.new(0, 0, .5, -2), Size = UDim2.new(1, 0, 0, 4)})
		track:SetAttribute("ThemeBg", "TopBtn")
		local fill = tool.make("Frame", track, "Fill", {BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(168, 140, 220), Size = UDim2.fromScale(0, 1)})
		fill:SetAttribute("ThemeBg", "Strk")
		local thumb = tool.make("Frame", slider, "Thumb", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(8, 16), BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1)})
		thumb:SetAttribute("ThemeBg", "Txt")
		tool.make("UICorner", thumb, "Corner", {CornerRadius = UDim.new(0, 3)})
		local function paint()
			local n = tonumber(box.Text) or values[id]
			local fraction = math.clamp((n - low) / (high - low), 0, 1)
			fill.Size, thumb.Position = UDim2.fromScale(fraction, 1), UDim2.fromScale(fraction, .5)
		end
		box:GetPropertyChangedSignal("Text"):Connect(paint)
		paint()
		local dragging = false
		local function drag()
			local fraction = math.clamp((input:GetMouseLocation().X - slider.AbsolutePosition.X) / math.max(1, slider.AbsoluteSize.X), 0, 1)
			box.Text = tostring(math.round((low + fraction * (high - low)) * 100) / 100)
		end
		slider.InputBegan:Connect(function(event)
			if event.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; drag() end
		end)
		table.insert(current.connections, input.InputChanged:Connect(function(event)
			if dragging and event.UserInputType == Enum.UserInputType.MouseMovement then drag() end
		end))
		table.insert(current.connections, input.InputEnded:Connect(function(event)
			if event.UserInputType == Enum.UserInputType.MouseButton1 and dragging then dragging = false; commit() end
		end))
		table.insert(current.connections, input.WindowFocusReleased:Connect(function() if dragging then dragging = false; commit() end end))
	end
	local colors = tool.make("Frame", body, "Colors", {BackgroundTransparency = 1, Size = UDim2.fromOffset(320, 28)})
	colors:SetAttribute("EclipseTabBar", true)
	label(colors, "Label", "Color", 0, 0, 88)
	local colorButtons = {}
	for index, name in {"Bone", "Custom"} do
		colorButtons[name] = button(colors, name, name, 90 + (index - 1) * 118, 0, 112, function()
			mode = name
			values.MatchColor = name == "Bone"
			commit()
		end)
	end
	local rampRow = tool.make("Frame", body, "RampRow", {BackgroundTransparency = 1, Size = UDim2.fromOffset(320, 32)})
	label(rampRow, "RampLabel", "Edit color", 0, 0, 88).TextSize = 14
	ramp = button(rampRow, "ColorRamp", "", 90, 0, 230, function()
		if values.MatchColor then
			local _, _, color = binding.pose(target, raw.MotorByPart)
			values.Color, values.Color2 = color, color
			values.MatchColor, values.Gradient, values.ColorRamp = false, false, ""
			mode = "Custom"
			if not commit() then return end
		end
		local stops = config.stops(values) or {{at = 0, color = values.Color, alpha = 1}}
		local value = {stops = {}, positions = {}, alphas = {}}
		for _, stop in stops do
			table.insert(value.stops, stop.color); table.insert(value.positions, stop.at); table.insert(value.alphas, stop.alpha)
		end
		require("picker").open(refs, ramp, value, function(result)
			local saved = {}
			for i, color in result.stops do
				table.insert(saved, {at = result.positions[i], alpha = result.alphas[i], color = {color.R, color.G, color.B}})
			end
			values.Color, values.Color2 = result.stops[1], result.stops[#result.stops]
			values.ColorRamp = game:GetService("HttpService"):JSONEncode(saved)
			values.Gradient = #result.stops > 1
			values.MatchColor = false
			mode = "Custom"
			commit()
		end, {drawing = true, temporal = true, solid = false, commitOnDone = true, alive = function() return window == current end})
	end)
	ramp:SetAttribute("ThemeBg", nil)
	ramp.BackgroundColor3 = Color3.new(1, 1, 1)
	for _, child in ramp:GetChildren() do if child:IsA("UIGradient") then child:Destroy() end end
 local swatch = tool.make("Frame", ramp, "Swatch", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = ramp.ZIndex + 3})
	tool.make("UICorner", swatch, "Corner", {CornerRadius = UDim.new(0, 3)})
	local rampGradient = tool.make("UIGradient", swatch, "Gradient", {})
	local errorLabel = label(frame, "Error", "", 14, 0, 332, 24)
	errorLabel.TextSize = 13
	errorLabel.Visible = false
	local footer = tool.make("Frame", frame, "Footer", {BackgroundTransparency = 1, Position = UDim2.new(0, 14, 1, -40), Size = UDim2.fromOffset(332, 28)})
	do
		button(footer, "Delete", "Delete", 0, 0, 70, function()
			local ok, issue = pcall(function() smears.remove(editing) end)
			if ok then current:close() else errorLabel.Text = tostring(issue):gsub("^.-:%d+: ", ""); errorLabel.Visible = true; refresh() end
		end)
	end
	button(footer, "Done", "Done", 232, 0, 100, function() if commit() then current:close() end end)
	local committing = false
	commit = function()
		if committing or window ~= current then return end
		committing = true
		local ok, issue = pcall(function()
			local pending = table.clone(values)
			for id, box in fields do pending[id] = tonumber(box.Text); assert(pending[id], "Check " .. id:lower()) end
			pending.PathStart, pending.PathEnd = tonumber(pathStart.Text), tonumber(pathEnd.Text)
			assert(pending.PathStart and pending.PathEnd, "Check the path frames")
			local normalized = config.normalize(pending)
			local range = {whole = whole, start = tonumber(startField.Text), finish = tonumber(endField.Text)}
			assert(range.start and range.finish and range.start >= 0 and range.finish >= range.start and range.start % 1 == 0 and range.finish % 1 == 0 and range.finish <= 1000000, "Check the start and end frames")
			if editing then
				local changed = rangeChanged or range.start ~= initial.start or range.finish ~= initial.finish
				local previous = config.read(editing)
				for id, value in normalized do if previous[id] ~= value then changed = true; break end end
				if changed then smears.update(editing, normalized, (rangeChanged or range.start ~= initial.start or range.finish ~= initial.finish) and range or nil) end
			else
				editing = require("effects").create({kind = "Smear Frames", target = target, settings = normalized, range = range})
				assert(editing, "Could not create smear frames")
			end
			values, initial, rangeChanged = normalized, range, false
			for id, box in fields do box.Text = tostring(values[id]) end
		end)
		committing = false
		errorLabel.Text = ok and "" or tostring(issue):gsub("^.-:%d+: ", "")
		errorLabel.Visible = not ok
		refresh()
		return ok
	end
	for _, box in fields do box.FocusLost:Connect(commit) end
	pathStart.FocusLost:Connect(commit)
	pathEnd.FocusLost:Connect(commit)
	startField.FocusLost:Connect(commit)
	endField.FocusLost:Connect(commit)
	local function selected(buttonValue, on)
		buttonValue:SetAttribute("ThemeBg", "TopBtn")
		buttonValue:SetAttribute("ThemeBgTransparency", on and 0 or 1)
		buttonValue.BackgroundTransparency = on and 0 or 1
		buttonValue.TextLabel:SetAttribute("ThemeTxtTransparency", 0)
		buttonValue.TextLabel.TextTransparency = 0
	end
	refresh = function()
		rangeRow.Visible = not whole
		selected(allButton, whole); selected(rangeButton, not whole)
		local y = whole and 78 or 112
		pathRow.Position = UDim2.fromOffset(0, y); y += 38
		for name, item in pathButtons do selected(item, values.Path == name) end
		pathFields.Visible = values.Path == "Connect"
		if pathFields.Visible then pathFields.Position = UDim2.fromOffset(0, y); y += 76 end
		styles.Position = UDim2.fromOffset(0, y)
		y += 78
		for name, item in styleButtons do
			local active = values.Style == name
			selected(item, active)
			item:SetAttribute("ThemeBgTransparency", active and 0 or .55)
			item.BackgroundTransparency = active and 0 or .55
			item.StyleOutline:SetAttribute("ThemeStrkTransparency", active and .1 or .65)
			item.StyleOutline.Transparency = active and .1 or .65
		end
		for _, row in rows do row.Position = UDim2.fromOffset(0, y); y += 34 end
		colors.Position = UDim2.fromOffset(0, y + 4); y += 38
		for name, item in colorButtons do selected(item, name == mode) end
		rampRow.Visible = true
		rampRow.Position = UDim2.fromOffset(0, y); y += 36
		local color = values.Color
		if values.MatchColor then local _, _, boneColor = binding.pose(target, raw.MotorByPart); color = boneColor end
		local stops = config.stops(values) or {{at = 0, color = color, alpha = 1}, {at = 1, color = color, alpha = 1}}
		local colorKeys, alphaKeys = {}, {}
		for _, stop in stops do
			table.insert(colorKeys, ColorSequenceKeypoint.new(stop.at, stop.color))
			table.insert(alphaKeys, NumberSequenceKeypoint.new(stop.at, 1 - stop.alpha))
		end
		if colorKeys[1].Time > 0 then table.insert(colorKeys, 1, ColorSequenceKeypoint.new(0, colorKeys[1].Value)); table.insert(alphaKeys, 1, NumberSequenceKeypoint.new(0, alphaKeys[1].Value)) end
		if colorKeys[#colorKeys].Time < 1 then table.insert(colorKeys, ColorSequenceKeypoint.new(1, colorKeys[#colorKeys].Value)); table.insert(alphaKeys, NumberSequenceKeypoint.new(1, alphaKeys[#alphaKeys].Value)) end
		rampGradient.Color, rampGradient.Transparency = ColorSequence.new(colorKeys), NumberSequence.new(alphaKeys)
		rampRow.RampLabel.Text = not values.MatchColor and values.Gradient and "Tail > tip" or "Edit color"
		local errorHeight = errorLabel.Visible and 26 or 0
		current:setSize(Vector2.new(360, 34 + y + 50 + errorHeight))
		scroll.Size = UDim2.new(1, -28, 1, -84 - errorHeight)
		scroll.CanvasSize = UDim2.fromOffset(0, y)
		body.Size = UDim2.new(1, -6, 0, y)
		errorLabel.Position = UDim2.new(0, 14, 1, -66)
		require("theme").applyTree(frame)
	end
	refresh()
	if not editing then commit() end
	return current
end
return editor
