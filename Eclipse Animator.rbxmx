							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local CameraTools = {}
CameraTools.__index = CameraTools

CameraTools.minimumRadius = 3
CameraTools.padding = 1.35
CameraTools.emitterRadius = 4

CameraTools.views = {
	{ name = "Perspective", direction = Vector3.new(1, 0.7, 1), distance = 1 },
	{ name = "Front", direction = Vector3.new(0, 0, -1), distance = 1 },
	{ name = "Side", direction = Vector3.new(1, 0, 0), distance = 1 },
	{ name = "Top", direction = Vector3.new(0, 1, 0.001), distance = 1 },
	{ name = "Close", direction = Vector3.new(1, 0.5, 1), distance = 0.55 },
	{ name = "Impact", direction = Vector3.new(1, 0.12, 0.4), distance = 0.8 },
}

function CameraTools.new()
	return setmetatable({}, CameraTools)
end

function CameraTools:include(bounds, position: Vector3, radius: number)
	local extent = Vector3.one * radius

	bounds.minimum = if bounds.minimum then bounds.minimum:Min(position - extent) else position - extent
	bounds.maximum = if bounds.maximum then bounds.maximum:Max(position + extent) else position + extent
end

function CameraTools:includePart(bounds, part: BasePart)
	local half = part.Size / 2
	local cframe = part.CFrame
	local extent = (cframe.RightVector * half.X):Abs() + (cframe.UpVector * half.Y):Abs() + (cframe.LookVector * half.Z):Abs()

	bounds.minimum = if bounds.minimum then bounds.minimum:Min(cframe.Position - extent) else cframe.Position - extent
	bounds.maximum = if bounds.maximum then bounds.maximum:Max(cframe.Position + extent) else cframe.Position + extent
end

function CameraTools:includeInstance(bounds, instance: Instance)
	if instance:IsA("BasePart") then
		self:includePart(bounds, instance)
	elseif instance:IsA("Attachment") then
		self:include(bounds, instance.WorldPosition, 0.5)
	elseif instance:IsA("ParticleEmitter") or instance:IsA("Light") then
		local parent = instance.Parent

		if parent and parent:IsA("Attachment") then
			self:include(bounds, parent.WorldPosition, CameraTools.emitterRadius)
		elseif parent and parent:IsA("BasePart") then
			self:include(bounds, parent.Position, CameraTools.emitterRadius)
		end
	elseif instance:IsA("Beam") or instance:IsA("Trail") then
		for _, name in { "Attachment0", "Attachment1" } do
			local attachment = (instance :: any)[name]

			if attachment then
				self:include(bounds, attachment.WorldPosition, 0.5)
			end
		end
	end
end

function CameraTools:getBounds(instances: { Instance }): (Vector3?, number)
	local bounds = {}

	for _, instance in instances do
		self:includeInstance(bounds, instance)

		for _, descendant in instance:GetDescendants() do
			self:includeInstance(bounds, descendant)
		end
	end

	if not bounds.minimum then
		return nil, 0
	end

	local center = (bounds.minimum + bounds.maximum) / 2
	local radius = math.max((bounds.maximum - bounds.minimum).Magnitude / 2, CameraTools.minimumRadius)

	return center, radius
end

function CameraTools:getView(name: string)
	for _, view in CameraTools.views do
		if view.name == name then
			return view
		end
	end

	return nil
end

function CameraTools:frame(instances: { Instance }, viewName: string?): boolean
	local camera = workspace.CurrentCamera
	local center, radius = self:getBounds(instances)

	if not camera or not center then
		return false
	end

	local view = if viewName then self:getView(viewName) else nil
	local direction = if view then view.direction.Unit else -camera.CFrame.LookVector
	local factor = if view then view.distance else 1
	local fieldOfView = math.rad(math.clamp(camera.FieldOfView, 10, 120))
	local distance = radius * CameraTools.padding / math.sin(fieldOfView / 2) * factor

	camera.CFrame = CFrame.lookAt(center + direction * distance, center)
	camera.Focus = CFrame.new(center)

	return true
end

return CameraTools
]]></ProtectedString>
