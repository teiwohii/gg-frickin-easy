						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local decoder = require("gifDecoder")
local data = require("projectData")
local encoding = game:GetService("EncodingService")
local assets = game:GetService("AssetService")
local localValue = {}
local cache = {}

local function parts(id)
	if type(id) ~= "string" then
		return nil
	end
	return id:match("^rbxasset://EclipseLocalGif/([%w%-]+)/(%d+)$")
end

function localValue.is(id)
	return parts(id) ~= nil
end

local function load(id)
	local key, index = parts(id)
	if not key then
		return nil
	end
	if not cache[key] then
		local encoded = data.getSetting("EclipseLocalGif_" .. key)
		assert(
			type(encoded) == "string",
			"This saved local GIF is unavailable on this computer. Use Roblox image IDs instead."
		)
		cache[key] =
			decoder.decode(buffer.tostring(encoding:Base64Decode(buffer.fromstring(encoded))))
	end
	local gif = cache[key]
	local frame = gif.frames[tonumber(index)]
	assert(frame, "Local GIF frame is missing")
	return gif, frame
end

function localValue.ready(id)
	if not localValue.is(id) then
		return false
	end
	return pcall(load, id)
end

function localValue.apply(label, id)
	if not localValue.is(id) then
		label.Image = id or ""
		return
	end
	local gif, frame = load(id)
	if not frame.editable then
		local editable = assert(
			assets:CreateEditableImage({ Size = Vector2.new(gif.width, gif.height) }),
			"Not enough image memory for this GIF"
		)
		local ok, err =
			pcall(editable.WritePixelsBuffer, editable, Vector2.zero, editable.Size, frame.pixels)
		if not ok then
			editable:Destroy()
			error(err, 0)
		end
		frame.editable = editable
	end
	label.ImageContent = Content.fromObject(frame.editable)
end

function localValue.clear()
	for _, gif in cache do
		for _, frame in gif.frames do
			if frame.editable then
				frame.editable:Destroy()
			end
		end
	end
	table.clear(cache)
end

return localValue
]]></ProtectedString>
