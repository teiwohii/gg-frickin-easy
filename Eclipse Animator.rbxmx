					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!native
--!strict
-- riftkuro
 
local configValue = {}

configValue.MAX_VISIBLE = 255
configValue.WARNING_COUNT = 20
configValue.defaults = {
	Enabled = true,
	StartFrame = 0,
	Amount = 20,
	MaxVisible = 12,
	IntervalFrames = 6,
	HoldFrames = 42,
	FadeFrames = 60,
	Opacity = 0.78,
	FillOpacity = 0.5,
	OutlineOpacity = 0.1,
	Color = Color3.fromRGB(100, 30, 220),
	Color2 = Color3.fromRGB(0, 220, 255),
	OutlineColor = Color3.fromRGB(20, 0, 60),
	Rainbow = true,
	LegacyRainbow = true,
	RainbowPeriodFrames = 240,
	RainbowSaturation = 1,
	RainbowValue = 0.45,
	ColorRamp = "",
	Gradient = false,
	GradientOverLifetime = false,
	TintBody = false,
	AlwaysOnTop = true,
}

 
configValue.timing = {
	StartFrame = true,
	Amount = true,
	MaxVisible = true,
	IntervalFrames = true,
	HoldFrames = true,
	FadeFrames = true,
}

local ranges = {
	StartFrame = { 0, 1000000, true },
	Amount = { 1, 255, true },
	MaxVisible = { 1, 255, true },
	IntervalFrames = { 1, 1000000, true },
	HoldFrames = { 0, 1000000, true },
	FadeFrames = { 0, 1000000, true },
	Opacity = { 0, 1 },
	FillOpacity = { 0, 1 },
	OutlineOpacity = { 0, 1 },
	RainbowPeriodFrames = { 1, 1000000 },
	RainbowSaturation = { 0, 1 },
	RainbowValue = { 0, 1 },
}

local rampText, rampCache
local function decodeRamp(text)
	if text == "" then
		return {}
	end
	if text == rampText then
		return rampCache
	end
	local ok, data = pcall(function()
		return game:GetService("HttpService"):JSONDecode(text)
	end)
	if not ok or type(data) ~= "table" or #data < 1 or #data > 32 then
		return nil
	end
	local previous = -1
	local function unit(v)
		return type(v) == "number" and v == v and v >= 0 and v <= 1
	end
	for _, stop in data do
		if
			type(stop) ~= "table"
			or not unit(stop.at)
			or stop.at <= previous
			or not unit(stop.alpha)
			or type(stop.color) ~= "table"
			or #stop.color ~= 3
		then
			return nil
		end
		for _, value in stop.color do
			if not unit(value) then
				return nil
			end
		end
		previous = stop.at
	end
	rampText, rampCache = text, data
	return data
end

function configValue.stops(config)
	local saved = decodeRamp(config.ColorRamp or "")
	local result = {}
	for _, stop in saved or {} do
		table.insert(
			result,
			{ at = stop.at, alpha = stop.alpha, color = Color3.new(unpack(stop.color)) }
		)
	end
	if #result == 0 then
		result = { { at = 0, alpha = 1, color = config.Color } }
		if config.Gradient then
			table.insert(result, { at = 1, alpha = 1, color = config.Color2 })
		end
	else
		result[1].color = config.Color
		if #result > 1 then
			result[#result].color = config.Color2
		end
	end
	return result
end

function configValue.valid(id, value)
	local default = configValue.defaults[id]
	if default == nil or typeof(default) ~= typeof(value) then
		return false
	end
	if typeof(value) == "Color3" then
		return value.R == value.R
			and value.G == value.G
			and value.B == value.B
			and math.min(value.R, value.G, value.B) >= 0
			and math.max(value.R, value.G, value.B) <= 1
	end
	if id == "ColorRamp" then
		return decodeRamp(value) ~= nil
	end
	if type(value) ~= "number" then
		return true
	end
	local bounds = ranges[id]
	return value == value
		and math.abs(value) < math.huge
		and bounds ~= nil
		and value >= bounds[1]
		and value <= bounds[2]
		and (not bounds[3] or value % 1 == 0)
end

function configValue.normalize(input)
	local result = {}
	for id, default in configValue.defaults do
		local value = input[id]
		if value == nil then
			value = default
		end
		assert(configValue.valid(id, value), "Invalid afterimage setting: " .. id)
		result[id] = value
	end
	assert(result.HoldFrames + result.FadeFrames > 0, "Afterimage lifetime must be positive")
	return result
end

function configValue.read(model)
	local result = {}
	for id, default in configValue.defaults do
		local value = model:GetAttribute("Effect" .. id)
		result[id] = value == nil and default or value
	end
	return configValue.normalize(result)
end

function configValue.catalog()
	local result = {}
	for _, id in
		{
			"Enabled",
			"Opacity",
			"FillOpacity",
			"OutlineOpacity",
			"Color",
			"Color2",
			"OutlineColor",
			"Rainbow",
			"LegacyRainbow",
			"RainbowPeriodFrames",
			"RainbowSaturation",
			"RainbowValue",
			"Gradient",
			"GradientOverLifetime",
			"TintBody",
			"AlwaysOnTop",
		}
	do
		table.insert(result, {
			id = id,
			label = id:gsub("(%l)(%u)", "%1 %2"),
			kind = typeof(configValue.defaults[id]),
			optional = id ~= "Enabled",
		})
	end
	return result
end

function configValue.warning(config)
	if config.MaxVisible > configValue.WARNING_COUNT then
		return "More than 20 afterimages at once may cause lag. The maximum is 255; available Highlight slots are shared with the scene."
	end
	return nil
end

 
function configValue.window(config, frame, budget)
	if not config.Enabled or frame < config.StartFrame then
		return 1, 0
	end
	local last =
		math.min(config.Amount, math.floor((frame - config.StartFrame) / config.IntervalFrames) + 1)
	local lifetime = config.HoldFrames + config.FadeFrames
	local first = math.floor((frame - config.StartFrame - lifetime) / config.IntervalFrames) + 2
	first = math.max(1, first, last - math.min(config.MaxVisible, budget or 255) + 1)
	return first, last
end

function configValue.birth(config, index)
	return config.StartFrame + (index - 1) * config.IntervalFrames
end

function configValue.alpha(config, age, lifetime)
	lifetime = math.min(lifetime or math.huge, config.HoldFrames + config.FadeFrames)
	if age < 0 or age >= lifetime then
		return 0
	end
	local fade = math.min(config.FadeFrames, lifetime)
	local hold = math.min(config.HoldFrames, lifetime - fade)
	if age <= hold then
		return 1
	end
	local t = math.clamp((age - hold) / fade, 0, 1)
	return 1 - t * t * (3 - 2 * t)
end

 
 
function configValue.visible(config, frame, poses, budget, poolSize)
	local capacity = math.min(config.MaxVisible, budget or 255, poolSize or 255)
	if not config.Enabled or capacity <= 0 then
		return {}
	end
	local emissions = {}
	for index = 1, math.min(config.Amount, #poses) do
		if poses[index].moving ~= false then
			table.insert(emissions, index)
		end
	end
	local result = {}
	for rank, index in emissions do
		local birth = configValue.birth(config, index)
		if birth > frame then
			break
		end
		local nextIndex = emissions[rank + capacity]
		local lifetime = nextIndex and configValue.birth(config, nextIndex) - birth or nil
		local alpha = configValue.alpha(config, frame - birth, lifetime)
		if alpha > 0 then
			table.insert(result, {
				index = index,
				slot = (rank - 1) % (poolSize or capacity) + 1,
				birth = birth,
				alpha = alpha,
			})
		end
	end
	return result
end

function configValue.color(config, index, birth, age)
	if config.Rainbow then
		local phase = (birth / config.RainbowPeriodFrames) % 1
		local hue = phase
		if config.LegacyRainbow then
			hue = phase < 0.65 and (0.7 + phase / 0.65 * 0.4) % 1
				or 0.1 + (phase - 0.65) / 0.35 * 0.6
		end
		return Color3.fromHSV(hue, config.RainbowSaturation, config.RainbowValue)
	end
	if config.Gradient then
		local fraction = config.GradientOverLifetime
				and math.clamp(age / (config.HoldFrames + config.FadeFrames), 0, 1)
			or (index - 1) / math.max(1, config.Amount - 1)
		local stops = configValue.stops(config)
		local a = stops[1]
		if fraction <= a.at then
			return a.color, a.alpha
		end
		for i = 2, #stops do
			local b = stops[i]
			if fraction <= b.at then
				local t = (fraction - a.at) / (b.at - a.at)
				return a.color:Lerp(b.color, t), a.alpha + (b.alpha - a.alpha) * t
			end
			a = b
		end
		return a.color, a.alpha
	end
	local stops = configValue.stops(config)
	return config.Color, stops[1].alpha
end

return configValue
]]></ProtectedString>
