								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local spatial = require(script.Parent.Parent.spatial)
local Tool = require(script.Parent.Tool)

local RadialTool = Tool.extend()

RadialTool.id = "Radial"
RadialTool.title = "Radial Array"
RadialTool.keywords = "radial circle ring array duplicate copies around spikes"
RadialTool.groupName = "Radial Array"
RadialTool.maximumCount = 128
RadialTool.references = {
	X = Vector3.yAxis,
	Y = Vector3.xAxis,
	Z = Vector3.xAxis,
}

function RadialTool.new(context)
	local self = setmetatable({}, RadialTool)

	Tool.init(self, context, {
		Count = 8,
		Radius = 4,
		Axis = "Y",
		StartAngle = 0,
		Arc = 360,
		FaceOutward = true,
		RandomRotation = 0,
		RandomScale = 0,
		RandomOffset = 0,
		Seed = 1,
		Group = true,
	})

	return self
end

function RadialTool:getFields()
	return {
		self:field("Count", "Count", "number", { integer = true, minimum = 1, maximum = RadialTool.maximumCount, clamp = true, range = { min = 1, max = 32 } }),
		self:field("Radius", "Radius", "number", { minimum = 0, range = { min = 0, max = 20 }, tip = "Distance from the centre. The centre is where the selected object is now." }),
		self:choice("Axis", "Axis", spatial.axisNames, { tip = "The world axis the copies go around." }),
		self:field("StartAngle", "Start Angle", "number", { range = { min = -180, max = 180 } }),
		self:field("Arc", "Arc", "number", { minimum = 1, maximum = 360, clamp = true, range = { min = 1, max = 360 }, tip = "360 spreads the copies around a full circle." }),
		self:field("FaceOutward", "Turn With Circle", "toggle", { tip = "Rotate each copy so it keeps facing the same way relative to the centre." }),
		self:field("RandomRotation", "Random Rotation", "number", { minimum = 0, range = { min = 0, max = 180 }, tip = "Degrees." }),
		self:field("RandomScale", "Random Scale", "number", { minimum = 0, maximum = 0.95, clamp = true, range = { min = 0, max = 0.95 }, tip = "0.2 makes each copy up to 20% bigger or smaller." }),
		self:field("RandomOffset", "Random Offset", "number", { minimum = 0, range = { min = 0, max = 5 }, tip = "Studs." }),
		self:field("Seed", "Seed", "number", { integer = true, minimum = 1, range = { min = 1, max = 100 } }),
		self:field("Group", "Group Result", "toggle", { tip = "Put the copies in one model so they move together." }),
		self:action("Apply", "Create Radial Array", function()
			self:apply()
		end, nil, true),
	}
end

function RadialTool:jitter(random: Random, amount: number): number
	return if amount > 0 then random:NextNumber(-amount, amount) else 0
end

function RadialTool:build(root: Instance, random: Random, created: { Instance })
	local params = self.params
	local pivot = spatial.getPivot(root)

	if not pivot then
		return
	end

	local count = math.clamp(math.round(params.Count), 1, RadialTool.maximumCount)
	local axis = spatial.axes[params.Axis]
	local reference = RadialTool.references[params.Axis]
	local arc = math.rad(math.clamp(params.Arc, 1, 360))
	local step = if params.Arc >= 359.99 then arc / count else arc / math.max(count - 1, 1)
	local parent = root.Parent
	local container = parent

	if params.Group and root:IsA("PVInstance") then
		local group = Instance.new("Model")

		group.Name = RadialTool.groupName
		group.WorldPivot = pivot
		group.Parent = parent
		container = group
		table.insert(created, group)
	end

	local spin = math.rad(params.RandomRotation)
	local copies = { root }

	for index = 2, count do
		copies[index] = root:Clone()
	end

	for index = 0, count - 1 do
		local copy = copies[index + 1]
		local rotation = CFrame.fromAxisAngle(axis, math.rad(params.StartAngle) + step * index)
		local offset = rotation * (reference * params.Radius)
		local wobble = Vector3.new(self:jitter(random, params.RandomOffset), self:jitter(random, params.RandomOffset), self:jitter(random, params.RandomOffset))
		local orientation = if params.FaceOutward then rotation * pivot.Rotation else pivot.Rotation
		local twist = CFrame.Angles(self:jitter(random, spin), self:jitter(random, spin), self:jitter(random, spin))
		local target = (orientation * twist) + (pivot.Position + offset + wobble)

		copy.Parent = container
		spatial.setPivot(copy, target)
		spatial.scale(copy, 1 + self:jitter(random, params.RandomScale), target.Position)

		if container == parent then
			table.insert(created, copy)
		end
	end
end

function RadialTool:apply()
	local roots = self:requireRoots(true)

	if not roots then
		return
	end

	local random = Random.new(math.floor(self.params.Seed))

	local created = self:run("Radial Array", function()
		local results = {}

		for _, root in roots do
			self:build(root, random, results)
		end

		return results
	end)

	if created and #created > 0 then
		self.selection:set(created)
	end
end

return RadialTool
]]></ProtectedString>
								<string name="ScriptGuid">{A9FA353E-1B61-4819-86C0-F52E4FBD3705}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<string name="Name">RadialTool</string>
								<BinaryString name="SerializedOverrides"></BinaryString>
								<int64 name="SourceAssetId">-1</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
