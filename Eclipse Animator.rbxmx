						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local dataModule = require("projectData")
local tool = require("tool")
local properties = require("properties")
local curves = require("graphCurves")
local http = game:GetService("HttpService")
local grid = {}
local setting = "EclipseMovementGridV2"
local refs, connection, plane, window
local enabled = false
local lines = {}
local previousTime
local settings
local owner, ownerSettings, distanceCache

local function number(value, default, low, high)
	return type(value) == "number"
			and value == value
			and math.round(math.clamp(value, low, high) * 100) / 100
		or default
end

function grid.normalize(value)
	value = type(value) == "table" and value or {}
	local out = {
		x = number(value.x, 0, -100000, 100000),
		y = number(value.y, 0.03, -100000, 100000),
		z = number(value.z, 0, -100000, 100000),
		rx = number(value.rx, 0, -360, 360),
		ry = number(value.ry, 0, -360, 360),
		rz = number(value.rz, 0, -360, 360),
		width = number(value.width, 12, 1, 512),
		depth = number(value.depth, 12, 1, 512),
		spacing = number(value.spacing, 2, 0.25, 128),
		speed = number(value.speed, 12, -1000, 1000),
		direction = number(value.direction, 0, -360, 360),
		opacity = number(value.opacity, 0.55, 0, 1),
		color = type(value.color) == "string"
				and value.color:match("^%x%x%x%x%x%x$")
				and value.color
			or "FFFFFF",
		keys = {},
	}
	out.spacing = math.max(out.spacing, out.width / 64, out.depth / 64)
	local seen = {}
	for _, key in type(value.keys) == "table" and value.keys or {} do
		if #out.keys >= 256 then
			break
		end
		if
			type(key) == "table"
			and type(key.time) == "number"
			and key.time == key.time
			and key.time >= 0
			and key.time <= 86400
		then
			if not seen[key.time] then
				seen[key.time] = true
				table.insert(
					out.keys,
					{ time = key.time, speed = number(key.speed, out.speed, -1000, 1000) }
				)
			end
		end
	end
	table.sort(out.keys, function(a, b)
		return a.time < b.time
	end)
	return out
end

local function clear()
	if plane then
		plane:Destroy()
		plane = nil
	end
	table.clear(lines)
	previousTime = nil
end

function grid.configuration()
	return grid.normalize(settings)
end

function grid.configure(value)
	settings = grid.normalize(value)
	local encoded = http:JSONEncode(settings)
	dataModule.setSetting(setting, encoded)
	if owner and owner.Parent then
		local object, before = owner, owner:GetAttribute("EclipseGridSettings")
		local function apply(text)
			object:SetAttribute("EclipseGridSettings", text)
			refs.State.currentProjectSaved = false
			ownerSettings = nil
		end
		apply(encoded)
		if before ~= encoded then
			require("history").record(function()
				apply(before)
			end, function()
				apply(encoded)
			end, "Movement grid settings")
		end
	end
	clear()
end

local function decode(value)
	if type(value) == "string" then
		local ok, data = pcall(http.JSONDecode, http, value)
		value = ok and data or nil
	end
	return grid.normalize(value)
end

function grid.restore(entry, scope)
	local object = Instance.new("NumberValue")
	object.Name = entry:GetAttribute("RigName") or "Movement Grid"
	object:SetAttribute("EclipseMovementGrid", true)
	object:SetAttribute(
		"EclipseGridSettings",
		http:JSONEncode(decode(entry:GetAttribute("EclipseGridSettings")))
	)
	object:SetAttribute("EclipseTrackId", entry:GetAttribute("RigId"))
	object.Value = decode(object:GetAttribute("EclipseGridSettings")).speed
	object.Parent = scope or workspace
	return object
end

local function track()
	for _, object in refs and refs.State.getAllRigs() or {} do
		if object:IsA("NumberValue") and object:GetAttribute("EclipseMovementGrid") == true then
			return object
		end
	end
end

function grid.align(value, rig)
	local config = grid.normalize(value)
	if rig and rig:IsA("Model") then
		local cf, size = rig:GetBoundingBox()
		local root = rig:FindFirstChild("HumanoidRootPart") or rig.PrimaryPart
		local forward = (root and root.CFrame or rig:GetPivot()).LookVector
		config.x, config.y, config.z = cf.X, cf.Y - size.Y / 2 + 0.03, cf.Z
		config.rx, config.ry, config.rz = 0, math.deg(math.atan2(-forward.X, -forward.Z)), 0
		config.direction = 0
	end
	return grid.normalize(config)
end

function grid.ensureTrack()
	local existing = track()
	if existing then
		return existing
	end
	if not refs or not refs.Active() then
		return nil
	end
	settings = grid.align(settings, refs.State.currentRig)
	local object = Instance.new("NumberValue")
	object.Name = "Movement Grid"
	object.Value = settings.speed
	object:SetAttribute("EclipseMovementGrid", true)
	object:SetAttribute("EclipseGridSettings", http:JSONEncode(settings))
	object.Parent = workspace
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local motor
	local ok, issue = pcall(function()
		motor = properties.enable(object, "Value", true, raw)
		for _, key in { { time = 0, speed = settings.speed }, table.unpack(settings.keys) } do
			timeline:RecordKeyframeForMotorAtCurrentTime(
				motor.Part1,
				motor,
				properties.encode(key.speed),
				{
					Frame = math.round(key.time * raw.FPS),
					ImportRaw = true,
					PropertyValue = key.speed,
				},
				refs.State.UIHelpers.SanitizeName
			)
			local point = raw.Keyframes[motor][math.round(key.time * raw.FPS)]
			point.EasingStyle = "Constant"
		end
		assert(
			require("project").addRigToTimeline(object),
			"Could not add movement grid to the timeline"
		)
	end)
	if not ok then
		if motor then
			raw.Keyframes[motor], raw.DefaultPose[motor] = nil, nil
		end
		object:Destroy()
		error(issue, 0)
	end
	settings.keys = {}
	object:SetAttribute("EclipseGridSettings", http:JSONEncode(settings))
	dataModule.setSetting(setting, http:JSONEncode(settings))
	return object
end

function grid.travel(motor, bucket, time)
	local token = curves.compile(bucket)
	if not distanceCache or distanceCache.motor ~= motor or distanceCache.token ~= token then
		distanceCache = { motor = motor, token = token, times = { 0 }, distances = { 0 } }
		for _, key in bucket or {} do
			if not key.Disabled and key.Time > 0 then
				table.insert(distanceCache.times, key.Time)
			end
		end
		table.sort(distanceCache.times)
	end
	local function integrate(a, b)
		local sum = 0
		for i = 1, 16 do
			local speed = properties.evaluate(motor, bucket, a + (b - a) * (i - 0.5) / 16)
			sum += math.clamp(speed, -1000, 1000)
		end
		return sum * (b - a) / 16
	end
	local times, distances = distanceCache.times, distanceCache.distances
	time = math.max(0, time)
	local index, last = 1, #times
	while index < last do
		local middle = math.ceil((index + last) / 2)
		if times[middle] <= time then
			index = middle
		else
			last = middle - 1
		end
	end
	for i = #distances + 1, index do
		distances[i] = distances[i - 1] + integrate(times[i - 1], times[i])
	end
	return distances[index] + integrate(times[index], time)
end

local function build(camera)
	plane = Instance.new("Part")
	plane.Name = "EclipseMovementGrid"
	plane.Anchored, plane.Locked, plane.Transparency = true, true, 1
	plane.CanCollide, plane.CanTouch, plane.CanQuery, plane.CastShadow = false, false, false, false
	plane.Size = Vector3.new(settings.width, 0.01, settings.depth)
	plane.CFrame = CFrame.new(settings.x, settings.y, settings.z)
		* CFrame.Angles(math.rad(settings.rx), math.rad(settings.ry), math.rad(settings.rz))
	require("recovery").mark(plane)
	for axis, length in { settings.width, settings.depth } do
		for index = -1, math.ceil(length / settings.spacing) do
			local line = Instance.new("LineHandleAdornment")
			line.Name, line.Adornee = "GridLine", plane
			line.AlwaysOnTop = false
			line.Color3, line.Transparency = Color3.fromHex(settings.color), 1 - settings.opacity
			line.Thickness = 3
			line.Length = axis == 1 and settings.depth or settings.width
			line.Parent = plane
			table.insert(lines, { line = line, axis = axis, index = index, length = length })
		end
	end
	plane.Parent = camera
end

function grid.refresh()
	local camera = workspace.CurrentCamera
	if
		not enabled
		or not refs
		or not refs.ScreenGui.Parent
		or not refs.ScreenGui.Enabled
		or not refs.Active()
		or not camera
	then
		if plane then
			clear()
		end
		return
	end
	local object = track()
	if not object then
		clear()
		owner = nil
		return
	end
	local encoded = object:GetAttribute("EclipseGridSettings")
	if owner ~= object or ownerSettings ~= encoded then
		owner, ownerSettings = object, encoded
		settings = decode(encoded)
		clear()
	end
	if plane and plane.Parent ~= camera then
		clear()
	end
	if not plane then
		build(camera)
	end
	local raw = refs.State.Timeline:GetState()
	local time = raw.CurrentTime or 0
	local motor = properties.list(object)[1]
	if not motor or motor:GetAttribute("EclipseDisabled") then
		clear()
		return
	end
	local bucket = raw.Keyframes[motor]
	local token = curves.compile(bucket)
	if time == previousTime and distanceCache and distanceCache.token == token then
		return
	end
	previousTime = time
	local distance = grid.travel(motor, bucket, time)
	local angle = math.rad(settings.direction)
	local x, z =
		distance * math.sin(angle) % settings.spacing,
		-distance * math.cos(angle) % settings.spacing
	for _, row in lines do
		local position = row.index * settings.spacing + (row.axis == 1 and x or z) - row.length / 2
		row.line.Visible = math.abs(position) <= row.length / 2
		row.line.CFrame = row.axis == 1 and CFrame.new(position, 0.01, settings.depth / 2)
			or CFrame.new(-settings.width / 2, 0.01, position)
				* CFrame.Angles(0, -math.pi / 2, 0)
	end
end

function grid.isEnabled()
	return enabled
end

function grid.toggle()
	if not enabled and not grid.ensureTrack() then
		return false
	end
	enabled = not enabled
	grid.refresh()
	return enabled
end

function grid.closeSettings()
	if window then
		local previous = window
		window = nil
		previous:close(true)
	end
end

function grid.toggleSettings()
	if window then
		grid.closeSettings()
		return
	end
	if not refs then
		return
	end
	local object = track()
	if object then
		owner, ownerSettings = object, object:GetAttribute("EclipseGridSettings")
		settings = decode(ownerSettings)
	end
	local view = tool.new(
		refs,
		"EclipseMovementGridSettingsCompact",
		"MOVEMENT GRID SETTINGS",
		Vector2.new(398, 306),
		false,
		function()
			window = nil
		end,
		{ Resizable = false }
	)
	window = view
	local draft = grid.configuration()
	local fields = {}
	local function sync()
		for id, box in fields do
			box.Text = tostring(draft[id])
		end
	end
	local function apply()
		grid.configure(draft)
		draft = grid.configuration()
		sync()
		grid.refresh()
	end
	local function row(label, ids, y)
		tool.label(view.frame, label, label, UDim2.fromOffset(10, y), UDim2.fromOffset(122, 24))
		local width = 254 / #ids
		for i, id in ids do
			local box = tool.field(
				view.frame,
				id,
				draft[id],
				UDim2.fromOffset(136 + (i - 1) * width, y),
				UDim2.fromOffset(width - 4, 24)
			)
			fields[id] = box
			box.FocusLost:Connect(function()
				local value = id == "color" and box.Text:gsub("#", "") or tonumber(box.Text)
				if
					value == nil
					or type(value) == "number" and (value ~= value or math.abs(value) == math.huge)
					or id == "color" and not value:match("^%x%x%x%x%x%x$")
				then
					box.Text = tostring(draft[id])
					return
				end
				draft[id] = value
				apply()
			end)
		end
	end
	row("Position X / Y / Z", { "x", "y", "z" }, 38)
	row("Rotation X / Y / Z", { "rx", "ry", "rz" }, 70)
	row("Width / depth", { "width", "depth" }, 102)
	row("Spacing (studs)", { "spacing" }, 134)
	row("Direction (degrees)", { "direction" }, 166)
	row("Opacity (0-1)", { "opacity" }, 198)
	row("Color (hex)", { "color" }, 230)
	tool.button(
		view.frame,
		"Floor",
		"FLOOR",
		UDim2.fromOffset(10, 270),
		UDim2.fromOffset(74, 24),
		function()
			draft.rx, draft.rz = 0, 0
			apply()
		end
	)
	tool.button(
		view.frame,
		"Wall",
		"WALL",
		UDim2.fromOffset(90, 270),
		UDim2.fromOffset(74, 24),
		function()
			draft.rx, draft.rz = 90, 0
			apply()
		end
	)
	tool.button(
		view.frame,
		"Center",
		"ALIGN TO RIG",
		UDim2.fromOffset(170, 270),
		UDim2.fromOffset(218, 24),
		function()
			draft = grid.align(draft, refs.State.currentRig)
			apply()
		end
	)
	sync()
	require("theme").applyTree(view.frame)
end

function grid.destroy()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	grid.closeSettings()
	clear()
	enabled, refs = false, nil
	owner, ownerSettings, distanceCache = nil, nil, nil
end

function grid.init(options)
	grid.destroy()
	refs = options
	local saved = dataModule.getSetting(setting)
	settings = decode(saved or dataModule.getSetting("EclipseMovementGridV1"))
	if not saved then
		if settings.width == 40 and settings.depth == 40 then
			settings.width, settings.depth = 12, 12
		end
		settings.direction = 0
	end
	connection = game:GetService("RunService").RenderStepped:Connect(grid.refresh)
	options.ScreenGui.Destroying:Once(grid.destroy)
	options.Plugin.Unloading:Once(grid.destroy)
end

return grid
]]></ProtectedString>
