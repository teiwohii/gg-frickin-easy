							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local boltShape = require(script.Parent.Parent.Parent.Animation.boltShape)
local ShapeKit = require(script.Parent.ShapeKit)

local lightning = {}

lightning.id = "Lightning"
lightning.title = "Lightning"
lightning.root = "Model"
lightning.strike = true

lightning.params = ShapeKit.join({
	{ name = "Length", kind = "number", default = 20, min = 0.5, max = 500 },
	{ name = "Segments", kind = "number", default = 12, min = 2, max = 64, integer = true },
	{ name = "Jitter", kind = "number", default = 2, min = 0, max = 50, tip = "How far the bolt strays from a straight line." },
	{ name = "Thickness", kind = "number", default = 0.4, min = 0.02, max = 20 },
	{ name = "Taper", kind = "number", default = 0.6, min = 0, max = 1, tip = "How much thinner the bolt is at its far end." },
	{ name = "Branches", kind = "number", default = 3, min = 0, max = 16, integer = true },
	{ name = "BranchLength", label = "Branch Length", kind = "number", default = 0.35, min = 0.05, max = 1, tip = "Branch length as a share of the bolt length." },
	{ name = "BranchAngle", label = "Branch Angle", kind = "number", default = 35, min = 0, max = 90 },
	{ name = "Seed", kind = "number", default = 1, min = 1, max = 9999, integer = true },
}, ShapeKit.solidParams())

function lightning.build(kit, params)
	local shape = boltShape.normalize(params)

	for index, segment in boltShape.rest(shape) do
		local part = kit:part(segment.name, segment.cframe, segment.size)

		part:SetAttribute(boltShape.indexAttribute, index)
	end
end

return lightning
]]></ProtectedString>
								<string name="ScriptGuid">{1C15F94E-5C7B-4D1D-8256-11F145F695C0}</string>
