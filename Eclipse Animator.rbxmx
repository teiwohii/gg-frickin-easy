						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local runService = game:GetService("RunService")
local utilities = require(script.Parent.utilities)

local playback = {}

function playback.Create(root, options)
    options = options or {}

    local handle = {
        Cancelled = false,
        Completed = false,
        Errors = {},
        Stats = {
            Particles = 0,
            Meshes = 0,
            Custom = 0,
            Properties = 0,
            Trails = 0,
            Fragments = 0,
        },
        _propertyCopies = {},
    }

    local scheduled = {}
    local animations = {}
    local ownedInstances = {}
    local elapsed = 0
    local speed = math.max(options.Speed or 1, 0.001)
    local durationScale = 1 / speed
    local connection
    local startedAt

    local function own(instance)
        instance.Archivable = false
        instance:SetAttribute(utilities.runtimeAttribute, true)
        table.insert(ownedInstances, instance)
        return instance
    end

    local container = own(Instance.new("Folder"))
    container.Name = "EclipseEmit_Playback"
    container.Parent = options.Parent or workspace

    local function reportError(instance, message)
        local description = instance:GetFullName() .. ": " .. tostring(message)
        table.insert(handle.Errors, description)
        warn("[EclipseEmit] " .. description)
    end

    local function schedule(delay, callback, instance)
        table.insert(scheduled, {
            Time = elapsed + math.max(delay, 0) * durationScale,
            Callback = callback,
            Instance = instance or root,
        })
    end

    local function animate(lifetime, update, finish, instance, timeScale)
        table.insert(animations, {
            Age = 0,
            Elapsed = 0,
            Lifetime = math.max(lifetime, 0.001),
            Update = update,
            Finish = finish,
            Instance = instance or root,
            TimeScale = timeScale,
        })

        update(0, 0, 0)
    end

    local function cleanup()
        if connection then
            connection:Disconnect()
            connection = nil
        end

        for index = #ownedInstances, 1, -1 do
            ownedInstances[index]:Destroy()
        end

        table.clear(ownedInstances)
        table.clear(scheduled)
        table.clear(animations)
    end

    function handle:Cancel()
        if self.Completed or self.Cancelled then
            return
        end

        self.Cancelled = true
        cleanup()
    end

    handle.Destroy = handle.Cancel

    local function updateScheduled()
        for index = #scheduled, 1, -1 do
            local job = scheduled[index]

            if elapsed >= job.Time then
                table.remove(scheduled, index)

                local success, message = pcall(job.Callback)

                if not success then
                    reportError(job.Instance, message)
                end
            end
        end
    end

    local function updateAnimations(deltaTime)
        for index = #animations, 1, -1 do
            local animation = animations[index]
            local progress = math.clamp(animation.Age / animation.Lifetime, 0, 1)
            animation.Elapsed += deltaTime / durationScale
            local timeScale = math.max(0, type(animation.TimeScale) == "function"
                and animation.TimeScale(progress, animation.Elapsed) or utilities.sequence(animation.TimeScale, progress, 1))
            local scaledDelta = deltaTime / durationScale * timeScale

            animation.Age += scaledDelta
            progress = math.clamp(animation.Age / animation.Lifetime, 0, 1)

            local success, message = pcall(
                animation.Update,
                progress,
                scaledDelta,
                animation.Age
            )

            if not success then
                reportError(animation.Instance, message)
            end

            if not success or animation.Age >= animation.Lifetime then
                table.remove(animations, index)

                if animation.Finish then
                    local finished, finishMessage = pcall(animation.Finish)

                    if not finished then
                        reportError(animation.Instance, finishMessage)
                    end
                end
            end
        end
    end

    local function step(deltaTime)
        if startedAt then
            deltaTime = math.min(deltaTime, math.max(0, os.clock() - startedAt))
            startedAt = nil
        end
        elapsed += deltaTime
        updateScheduled()
        updateAnimations(deltaTime)

        if #scheduled == 0 and #animations == 0 then
            handle.Completed = true
            cleanup()
        end
    end

    local function start()
        if options.Manual == true then
            return
        end
        if not connection and not handle.Cancelled and not handle.Completed then
            startedAt = os.clock()
            connection = runService.Heartbeat:Connect(step)
        end
    end

    function handle:Advance(deltaTime)
        if options.Manual ~= true or self.Cancelled or self.Completed then
            return false
        end
        if type(deltaTime) ~= "number" or deltaTime ~= deltaTime or deltaTime < 0 or deltaTime == math.huge then
            return false
        end
        updateScheduled()
        updateAnimations(0)
        local remaining = deltaTime
        while remaining > 0 and (#scheduled > 0 or #animations > 0) do
            local amount = remaining
            for _, job in scheduled do
                if job.Time > elapsed then
                    amount = math.min(amount, job.Time - elapsed)
                end
            end
            elapsed += amount
            remaining -= amount
            updateAnimations(amount)
            updateScheduled()
        end
        if #scheduled == 0 and #animations == 0 then
            self.Completed = true
            cleanup()
        end
        return true
    end

    return {
        Handle = handle,
        Own = own,
        Schedule = schedule,
        Animate = animate,
        Container = container,
        Root = root,
        Random = type(options.Seed) == "number" and Random.new(options.Seed) or nil,
        Speed = speed,
        ReportError = reportError,
        Start = start,
    }
end

return playback

]]></ProtectedString>
