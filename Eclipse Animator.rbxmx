					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local sampler = {}

local function smooth(value)
	value = math.clamp(value, 0, 1)
	return value * value * (3 - 2 * value)
end

function sampler.envelope(raw, model, frame, lastFrame)
	local first, finish = 0, lastFrame
	if model then
		for _, motor in require("properties").list(model) do
			if motor.PropertyId ~= "Enabled" then continue end
			local keys = {}
			for at, key in raw.Keyframes[motor] or {} do table.insert(keys, {at, key.PropertyValue}) end
			table.sort(keys, function(a, b) return a[1] < b[1] end)
			local enabled = true
			for _, key in keys do
				if key[1] <= frame then
					if key[2] and not enabled then first = key[1] end
					enabled = key[2]
				elseif not key[2] then finish = math.min(finish, key[1]); break end
			end
			if not enabled then return 0 end
		end
	end
	local duration = math.min(raw.FPS / 30, math.max(.5, (finish - first) * .5))
	return smooth((frame - first) / duration) * smooth((finish - frame) / duration)
end

function sampler.capture(state, target, owner, frame, settings, model, lastFrame)
	settings = require("smearConfig").normalize(settings or {})
	local strength = settings.Strength * (2 / 3)
	local timeline = state.Timeline
	local raw = timeline:GetState()
	local time, clock = raw.CurrentTime, raw.LastPoseApplyClock
	local last = state.lastCFrames and table.clone(state.lastCFrames)
	local restoreTargets = require("target").previewSnapshot()
	local snapshot, result
	local rigs = state.getAllRigs()
	local ok, issue = xpcall(function()
		snapshot = require("snapshot").new(rigs, raw, workspace.CurrentCamera and {workspace.CurrentCamera} or {})
		local function capture(index)
			if index <= #rigs then
				return require("armatureRuntime").withSampling(rigs[index], function() return capture(index + 1) end)
			end
			local binding = require("smearBinding")
			local function poseAt(seconds)
				raw.CurrentTime = math.max(0, seconds)
				timeline:ApplyPoseAtTime(owner, raw.CurrentTime, {SkipControls = true})
				return binding.pose(target, raw.MotorByPart)
			end
			local pathFade = 1
			if settings.Path == "Connect" then
				local first, finish = settings.PathStart / raw.FPS, settings.PathEnd / raw.FPS
				local a, sizeA, colorA = poseAt(first)
				local pivotA = binding.pivot(target, raw.MotorByPart, a)
				local b, sizeB, colorB = poseAt(finish)
				local pivotB = binding.pivot(target, raw.MotorByPart, b)
				local offsetA, offsetB = a:PointToObjectSpace(pivotA), b:PointToObjectSpace(pivotB)
				poseAt = function(seconds)
					local alpha = math.clamp((seconds - first) / (finish - first), 0, 1)
					local rotation = a.Rotation:Lerp(b.Rotation, alpha)
					local center = pivotA:Lerp(pivotB, alpha) - rotation:VectorToWorldSpace(offsetA:Lerp(offsetB, alpha))
					return rotation + center, sizeA:Lerp(sizeB, alpha), colorA:Lerp(colorB, alpha)
				end
				local fade = math.min(raw.FPS / 30, (settings.PathEnd - settings.PathStart) * .5)
				pathFade = smooth((frame - settings.PathStart) / fade) * smooth((settings.PathEnd + fade - frame) / fade)
			end
			result = {Style = settings.Style, Poses = {}, Width = settings.Width, Strength = strength, Opacity = settings.Opacity, Ramp = require("smearConfig").stops(settings)}
			for _, age in {1 / 12, 1 / 20, 1 / 40, 1 / 120, 0} do
				local exposure = age > 1 / 120 and 1 / 120 + (age - 1 / 120) * strength or age
				local cf, size, color = poseAt(frame / raw.FPS - exposure)
				table.insert(result.Poses, cf)
				result.Size, result.Color = size, settings.MatchColor and color or settings.Color
			end
			local previous, moving = nil, 0
			local size = result.Size
			local scale = math.max(size.X, size.Y, size.Z, .01)
			for index = 0, 3 do
				local cf = poseAt(frame / raw.FPS - (3 - index) / 60)
				if previous then
					local distance = 0
					for _, point in {Vector3.zero, Vector3.xAxis * size.X * .5, Vector3.yAxis * size.Y * .5, Vector3.zAxis * size.Z * .5, -Vector3.yAxis * size.Y * .5} do
						distance = math.max(distance, (cf:PointToWorldSpace(point) - previous:PointToWorldSpace(point)).Magnitude)
					end
					moving += smooth((distance / scale - .004) / .055) / 3
				end
				previous = cf
			end
			result.Visibility = moving * pathFade * sampler.envelope(raw, model, frame, lastFrame or require("rawState").Config.Length * raw.FPS)
		end
		capture(1)
	end, debug.traceback)
	raw.CurrentTime = time
	local restored, restoreIssue = pcall(function() if snapshot then snapshot:restore() end end)
	if last then
		table.clear(state.lastCFrames)
		for key, value in last do state.lastCFrames[key] = value end
	end
	raw.LastPoseApplyClock = clock
	local targetsOk, targetsIssue = pcall(restoreTargets)
	assert(ok and restored and targetsOk, not ok and issue or not restored and restoreIssue or targetsIssue)
	return result
end

return sampler
]]></ProtectedString>
