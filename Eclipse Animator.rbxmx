			end

		end



		local ok, applied = pcall(apply, track, part, find, false)

		if not ok then

			storage.noteIssue(

				"track",

				rig.Name

					.. ": a saved track could not be read and is kept unchanged: "

					.. tostring(applied)

			)

			retain(track)

		elseif not applied then

			table.insert(deferred, track)

		end

	end



