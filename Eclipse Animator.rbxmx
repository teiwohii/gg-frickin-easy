							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = {}

configuration.Colors = require(script.colors)
configuration.Style = require(script.style)
configuration.Hovers = require(script.hovers)
configuration.Classes = require(script.classes)
configuration.Properties = require(script.classes.properties)
configuration.Layout = require(script.layout)
configuration.Timeline = require(script.timeline)
configuration.Gizmo = require(script.gizmo)
configuration.Scale = require(script.scale)
configuration.Keyframes = require(script.keyframes)
configuration.PropertyRanges = require(script.propertyRanges)
configuration.Settings = require(script.settings)
configuration.Effects = require(script.effects)
configuration.Version = require(script.version)
configuration.Create = require(script.create)
configuration.Premium = require(script.premium)

return configuration
