						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local codec = require("codec")
local sourcesModule = require("sources")
local bake = require("bake")
local subtitleData = require("subtitleData")
local theme = require("theme")
local packageValue = {}
local editor = game:GetService("ScriptEditorService")
local header = "-- riftkuro | Eclipse Animator"
local runtimeName = "EclipseCutsceneRuntime"
local runtimeEntry = "Runtime/Cutscene"
local runtimeVersion

local function module(parent, name, source, class)
	if not source:match("^%-%-") then
		source = header .. "\n\n" .. source
	end

	local object = Instance.new(class or "ModuleScript")
	object.Name = name
	local ok, err = pcall(function()
		editor:UpdateSourceAsync(object, function()
			return source
		end)
	end)
	if not ok then
		object:Destroy()
		error(err)
	end

	assert(object.Source == source, "Could not write export source " .. name)
	object.Parent = parent
	return object
end

local function unique(parent, name)
	name = tostring(name):gsub("[^%w_ %-]", "_"):sub(1, 72)
	if name == "" then
		name = "Item"
	end

	local result = name
	local index = 2
	while parent:FindFirstChild(result) do
		result = name .. "_" .. index
		index += 1
	end

	return result
end

local keywords = {
	["and"] = true,
	["break"] = true,
	["do"] = true,
	["else"] = true,
	["elseif"] = true,
	["end"] = true,
	["false"] = true,
	["for"] = true,
	["function"] = true,
	["if"] = true,
	["in"] = true,
	["local"] = true,
	["nil"] = true,
	["not"] = true,
	["or"] = true,
	["repeat"] = true,
	["return"] = true,
	["then"] = true,
	["true"] = true,
	["until"] = true,
	["while"] = true,
	["const"] = true,
}

local function field(key)
	if type(key) == "string" and key:match("^[%a_][%w_]*$") and not keywords[key] then
		return key
	end

	return "[" .. codec.encode(key) .. "]"
end

local function scalar(value)
	if type(value) == "number" then
		for precision = 6, 17 do
			local text = string.format("%." .. precision .. "g", value)
			if tonumber(text) == value then
				return text
			end
		end
	elseif typeof(value) == "Color3" then
		local r, g, b = value.R * 255, value.G * 255, value.B * 255
		if
			math.abs(r - math.round(r)) < 1e-3
			and math.abs(g - math.round(g)) < 1e-3
			and math.abs(b - math.round(b)) < 1e-3
		then
			return string.format(
				"Color3.fromRGB(%d, %d, %d)",
				math.round(r),
				math.round(g),
				math.round(b)
			)
		end
	end

	return codec.encode(value)
end

local function pretty(value, depth)
	if type(value) ~= "table" then
		return scalar(value)
	end

	depth = depth or 0
	local keys = {}
	local flat = true
	for key, item in value do
		table.insert(keys, key)
		if type(item) == "table" then
			flat = false
		end
	end

	if #keys == 0 then
		return "{}"
	end

	local array = #value == #keys
	table.sort(keys, function(a, b)
		if type(a) == type(b) and (type(a) == "number" or type(a) == "string") then
			return a < b
		end

		return codec.encode(a) < codec.encode(b)
	end)
	if flat and (array or #keys <= 4) then
		local parts = {}
		for _, key in keys do
			table.insert(
				parts,
				array and scalar(value[key]) or field(key) .. " = " .. scalar(value[key])
			)
		end

		local line = "{ " .. table.concat(parts, ", ") .. " }"
		if #line <= 100 then
			return line
		end
	end

	local indent = string.rep("\t", depth + 1)
	local rows = {}
	for _, key in keys do
		local item = pretty(value[key], depth + 1)
		table.insert(rows, indent .. (array and item or field(key) .. " = " .. item) .. ",")
	end

	return "{\n" .. table.concat(rows, "\n") .. "\n" .. string.rep("\t", depth) .. "}"
end

local function indented(source, depth)
	source = source:gsub("\r\n", "\n"):gsub("\r", "\n"):gsub("%s+$", "")
	if source == "" or source:find("%[=*%[") then
		return source
	end

	local indent = string.rep("\t", depth)
	return indent .. source:gsub("\n", "\n" .. indent):gsub("\n" .. indent .. "\n", "\n\n")
end

local function storeData(folder, value, label)
	label = label or "Layout"

	local function write(source, final)
		local name = unique(folder, final and label or label .. "_Part")
		module(folder, name, source)
		return name
	end

	local literal = pretty(value)
	if #literal <= 80000 then
		return write("return " .. literal, true)
	end

	assert(type(value) == "table", "An individual export value is too large")
	local parts, rows, size = {}, {}, 0

	local function flush()
		if #rows > 0 then
			table.insert(parts, write("return {\n\t" .. table.concat(rows, ",\n\t") .. ",\n}\n"))
			rows = {}
			size = 0
		end
	end

	for key, entry in value do
		local encoded = codec.encode(entry, nil, 1)
		if #encoded > 20000 and type(entry) == "table" then
			encoded = "require("
				.. string.format(
					"%q",
					"./" .. storeData(folder, entry, label .. "_" .. tostring(key))
				)
				.. ")"
		end

		local row = "[" .. codec.encode(key) .. "] = " .. encoded
		if size + #row > 80000 then
			flush()
		end

		table.insert(rows, row)
		size += #row
	end

	flush()
	if #parts == 1 then
		return parts[1]
	end

	return write(
		"local value = {}\nlocal parts = "
			.. codec.encode(parts)
			.. "\n\nfor _, name in parts do\n\tlocal chunk = require(`./{name}`)\n\n\tfor key, item in chunk do\n\t\tvalue[key] = item\n\tend\nend\n\nreturn value\n",
		true
	)
end

local function scan(line, long)
	local i, n = 1, #line
	while i <= n do
		if long then
			local s, e = line:find("]" .. string.rep("=", long) .. "]", i, true)
			if not s then
				return long
			end

			long = nil
			i = e + 1
		else
			local c = line:sub(i, i)
			if c == '"' or c == "'" or c == "`" then
				local j = i + 1
				while j <= n do
					local d = line:sub(j, j)
					if d == "\\" then
						j += 2
					elseif d == c then
						break
					else
						j += 1
					end
				end

				i = j + 1
			elseif c == "-" and line:sub(i + 1, i + 1) == "-" then
				local eq = line:match("^%[(=*)%[", i + 2)
				if eq then
					long = #eq
					i = i + 4 + #eq
				else
					return long
				end
			elseif c == "[" then
				local eq = line:match("^%[(=*)%[", i)
				if eq then
					long = #eq
					i = i + 2 + #eq
				else
					i += 1
				end
			else
				i += 1
			end
		end
	end

	return long
end

local function split(source)
	local lines = {}
	for line in (source .. "\n"):gmatch("([^\n]*)\n") do
		table.insert(lines, line)
	end

	if lines[#lines] == "" then
		table.remove(lines)
	end

	return lines
end

local function mark(lines)
	local inside = {}
	local long = nil
	for index, line in lines do
		inside[index] = long ~= nil
		long = scan(line, long)
	end

	return inside
end

local function dedent(source)
	local lines = split(source)
	local inside = mark(lines)
	for index, line in lines do
		if not inside[index] and line:sub(1, 1) == "\t" then
			lines[index] = line:sub(2)
		end
	end

	return table.concat(lines, "\n")
end

local function trim(line)
	return line:match("^%s*(.-)%s*$")
end

local function indentOf(line)
	return #line:match("^\t*")
end

local closers = {
	["end"] = true,
	["else"] = true,
	["elseif"] = true,
	["until"] = true,
	["}"] = true,
	[")"] = true,
	["]"] = true,
}

local function opensBlock(text)
	return text:match("[{(,]$")
		or text:match("then$")
		or text:match("do$")
		or text:match("else$")
		or text:find("function", 1, true)
		or text:match("^%-%-")
end

local function startsClose(text)
	return closers[text:match("^[%w_]+") or ""] or closers[text:sub(1, 1)]
end

local function space(source)
	local lines = split(source)
	local inside = mark(lines)
	local out = {}
	for index, line in lines do
		local text = trim(line)
		local previous = out[#out]
		local prevText = previous and trim(previous) or ""
		if not inside[index] and previous ~= nil and prevText ~= "" then
			local wantBlank = false
			if text:match("^function[%s(]") or text:match("^local function[%s(]") then
				wantBlank = not opensBlock(prevText)
			elseif
				prevText == "end"
				and not startsClose(text)
				and indentOf(line) <= indentOf(previous)
			then
				wantBlank = true
			elseif
				prevText:match("^local [%w_]+ = Instance%.new%(") and not text:match("^%-%-")
			then
				wantBlank = true
			elseif text:match("^return ") and indentOf(line) == 0 then
				wantBlank = true
			end

			if wantBlank then
				table.insert(out, "")
			end
		end

		table.insert(out, line)
	end

	local result = {}
	local blank = false
	local marks = mark(out)
	for index, line in out do
		if line == "" and not marks[index] then
			if not blank then
				table.insert(result, line)
			end

			blank = true
		else
			table.insert(result, line)
			blank = false
		end
	end

	return table.concat(result, "\n")
end

local function json(text)
	local out = {}
	local depth = 0
	local i, n = 1, #text

	local function newline()
		table.insert(out, "\n" .. string.rep("\t", depth))
	end

	while i <= n do
		local c = text:sub(i, i)
		if c == '"' then
			local j = i + 1
			while j <= n do
				local d = text:sub(j, j)
				if d == "\\" then
					j += 2
				elseif d == '"' then
					break
				else
					j += 1
				end
			end

			table.insert(out, text:sub(i, j))
			i = j + 1
		elseif c == "{" or c == "[" then
			local close = c == "{" and "}" or "]"
			if text:sub(i + 1, i + 1) == close then
				table.insert(out, c .. close)
				i += 2
			else
				table.insert(out, c)
				depth += 1
				newline()
				i += 1
			end
		elseif c == "}" or c == "]" then
			depth -= 1
			newline()
			table.insert(out, c)
			i += 1
		elseif c == "," then
			table.insert(out, ",")
			newline()
			i += 1
		elseif c == ":" then
			table.insert(out, ": ")
			i += 1
		elseif c:match("%s") then
			i += 1
		else
			table.insert(out, c)
			i += 1
		end
	end

	return table.concat(out)
end

local function unwrap(name, source)
	local body = source:match("^%s*return function%(require%)\n(.*)\nend%s*$")
		or source:match("^%-%-[^\n]*\n\nreturn function%(require%)\n(.*)\nend\n?$")
	assert(body, "Unexpected runtime module shape: " .. name)
	body = space(dedent(body))
	if name == "Resources/EffectAssets" then
		local a, b = body:find("%[==%[.-%]==%]")
		if a then
			body = body:sub(1, a + 3) .. json(body:sub(a + 4, b - 4)) .. body:sub(b - 3)
		end
	end

	return header .. "\n\n" .. body .. "\n"
end

local function version()
	if runtimeVersion then
		return runtimeVersion
	end

	local names = {}
	for name in sourcesModule do
		table.insert(names, name)
	end

	table.sort(names)
	local hash = 7
	for _, name in names do
		local source = name .. "\0" .. sourcesModule[name]
		for index = 1, #source do
			hash = (hash * 31 + source:byte(index)) % 4294967296
		end
	end

	runtimeVersion = string.format("2.%08x", hash)
	return runtimeVersion
end

local retiredRuntimes = {
	["08d331ad6821068d"] = true,
	["2ed587a0d4a6ceac"] = true,
	["5a3c473e98b6710e"] = true,
	["63aa105a81a2957a"] = true,
	["64dad7292c4ba33d"] = true,
	["693bb3a4a3482a34"] = true,
	["7d3b8ca5f4c04331"] = true,
	["7e9770fb261bfbfb"] = true,
	["804973c7e2cd5f9b"] = true,
	["8cc86fab95aee5cb"] = true,
	["a685e139a1c13389"] = true,
	["c3d26ea898234130"] = true,
	["c5cc30276c2b36ab"] = true,
	["c913bd411b77c961"] = true,
	["d43b1ce65d07500e"] = true,
	["fc6dd476d5d8fc32"] = true,
	["fc9a35dbb2a2ddc3"] = true,
}

local function runtimeFingerprint(root)
	if not root:IsA("ModuleScript") or root.Name ~= runtimeName then
		return nil
	end

	local nodes = {}
	local function visit(object, path)
		if object.Name == "TheFix" or nodes[path] then
			return false
		end
		if not object:IsA("ModuleScript") and not object:IsA("Folder") then
			return false
		end
		if #object:GetTags() > 0 then
			return false
		end
		for name in object:GetAttributes() do
			if object ~= root or name ~= "EclipseRuntime" then
				return false
			end
		end
		if object:IsA("ModuleScript") then
			local ok, source = pcall(editor.GetEditorSource, editor, object)
			if not ok or source ~= object.Source then
				return false
			end
		end
		nodes[path] = object
		for _, child in object:GetChildren() do
			if not visit(child, path == "" and child.Name or path .. "/" .. child.Name) then
				return false
			end
		end
		return true
	end
	if not visit(root, "") then
		return nil
	end

	local paths = {}
	for path in nodes do
		table.insert(paths, path)
	end
	table.sort(paths)
	local first, second = 7, 11
	local function hash(value)
		local text = tostring(#value) .. ":" .. value
		for index = 1, #text do
			local byte = text:byte(index)
			first = (first * 31 + byte) % 4294967296
			second = (second * 131 + byte) % 4294967296
		end
	end
	for _, path in paths do
		local object = nodes[path]
		hash(path)
		hash(object.ClassName)
		hash(object:IsA("ModuleScript") and object.Source:gsub("\r\n", "\n") or "")
	end
	return string.format("%08x%08x", first, second)
end

local function cleanRuntimeBackups()
	local removed, retained = 0, {}
	for _, folder in game:GetService("ServerStorage"):GetChildren() do
		if folder:IsA("Folder") and folder:GetAttribute("EclipseRuntimeBackup") == true then
			for _, child in folder:GetChildren() do
				local fingerprint = runtimeFingerprint(child)
				if child:GetAttribute("EclipseRuntime") and fingerprint and retiredRuntimes[fingerprint] then
					child:Destroy()
					removed += 1
				else
					table.insert(retained, child:GetFullName())
				end
			end
			local plain = #folder:GetTags() == 0
			for name in folder:GetAttributes() do
				if name ~= "EclipseRuntimeBackup" then
					plain = false
				end
			end
			if plain and #folder:GetChildren() == 0 then
				folder:Destroy()
			end
		end
	end
	local message = removed > 0 and string.format("Removed %d old runtime backup(s).", removed) or ""
	if #retained > 0 then
		local notice = "Old runtime backups with edits or unrecognized contents were kept. Review them in ServerStorage before deleting them: " .. table.concat(retained, ", ")
		warn("Eclipse: " .. notice)
		message ..= (message ~= "" and " " or "") .. "Edited or unrecognized runtime backups were kept; see Output."
	end
	return message
end

local function finishRuntimeCleanup()
	local ok, message = pcall(cleanRuntimeBackups)
	if ok then
		return message
	end
	warn("Eclipse: The cutscene was exported, but old runtime backup cleanup could not finish: " .. tostring(message))
	return "Old runtime backup cleanup could not finish; see Output."
end

local function stageRuntime(folder)
	local current = version()
	local existing = folder:FindFirstChild(runtimeName)
	if existing and existing:IsA("ModuleScript") and existing:GetAttribute("EclipseRuntime") == current then
		return existing, false, function() end, function() end
	end
	local existingFingerprint
	if existing then
		existingFingerprint = runtimeFingerprint(existing)
		assert(
			existing:GetAttribute("EclipseRuntime") and existingFingerprint and retiredRuntimes[existingFingerprint],
			"EclipseCutsceneRuntime has edits or an unknown build. Save it outside this place, remove it from EclipseCutscenes, then export again. Nothing was replaced."
		)
	end
	assert(sourcesModule[runtimeEntry], "The runtime entry module is missing")
	local entry = module(nil, runtimeName, unwrap(runtimeEntry, sourcesModule[runtimeEntry]))
	local detached = false
	local ok, message = xpcall(function()
		for name, source in sourcesModule do
			if name == runtimeEntry then
				continue
			end
			local pieces = string.split(name, "/")
			local parent = entry
			for index = 1, #pieces - 1 do
				local child = parent:FindFirstChild(pieces[index])
				if not child then
					child = Instance.new("Folder")
					child.Name = pieces[index]
					child.Parent = parent
				end
				parent = child
			end
			module(parent, pieces[#pieces], unwrap(name, source))
		end
		entry:SetAttribute("EclipseRuntime", current)
		assert(folder:FindFirstChild(runtimeName) == existing, "The runtime changed during export. Try exporting again.")
		if existing then
			assert(runtimeFingerprint(existing) == existingFingerprint, "The runtime was edited during export. Export cancelled to preserve the edits.")
			existing.Parent = nil
			detached = true
		end
		entry.Parent = folder
	end, debug.traceback)
	local function rollback()
		entry:Destroy()
		if existing and detached then
			existing.Parent = folder
		end
	end
	if not ok then
		rollback()
		error(message, 2)
	end
	local function commit()
		if existing then
			if runtimeFingerprint(existing) == existingFingerprint then
				existing:Destroy()
			else
				local storage = game:GetService("ServerStorage")
				local backup = Instance.new("Folder")
				backup.Name = unique(storage, "Eclipse Runtime Backups")
				backup:SetAttribute("EclipseRuntimeBackup", true)
				existing.Parent = backup
				backup.Parent = storage
			end
		end
	end
	return entry, true, commit, rollback
end

function packageValue.installRuntime(folder)
	local entry, changed, commit = stageRuntime(folder)
	commit()
	return entry, changed, finishRuntimeCleanup()
end

local codeBindings = [==[
local plugin, loadstring, getfenv, setfenv
local game = environment.game
local workspace = environment.workspace
local Game = environment.Game
local Workspace = environment.Workspace
local Instance = environment.Instance
local task = environment.task
local wait = environment.wait
local spawn = environment.spawn
local delay = environment.delay
local coroutine = environment.coroutine
local os = environment.os
local time = environment.time
local tick = environment.tick
local DateTime = environment.DateTime
local math = environment.math
local Random = environment.Random
local RaycastParams = environment.RaycastParams
local OverlapParams = environment.OverlapParams
local typeof = environment.typeof
local type = environment.type
local shared = environment.shared
local require = environment.require
local script = environment.script
local warn = environment.warn
]==]

local handlerTemplate = script.Parent.sources.exportCutsceneHandler

local function handler()
	local object = handlerTemplate:Clone()
	object.Name = "EclipseCutsceneHandler"
	object.Enabled = true
	return object
end

local subtitleDefaults =
	{ Entrance = "Fade", Exit = "Fade", InFrames = 12, OutFrames = 12, Order = 0, Preset = "Clean" }

local function style(base, reference)
	local out = {}
	for key, default in subtitleData.defaults do
		if key == "Words" then
			continue
		end

		if key == "Text" or key == "Speaker" then
			if reference and base[key] ~= reference[key] then
				out[key] = base[key]
			end

			continue
		end

		if base[key] ~= default then
			out[key] = base[key]
		end
	end

	if next(base.Words or {}) then
		out.Words = base.Words
	end

	return out
end

local function subtitleRows(entries)
	local rows = {}
	for _, entry in entries do
		local cue = subtitleData.copy(entry.event.Subtitle)
		local row = {
			{ "Frame", entry.event.Frame },
			{ "Duration", cue.Duration },
		}
		if cue.Base.Speaker ~= "" then
			table.insert(row, { "Speaker", cue.Base.Speaker })
		end

		table.insert(row, { "Text", cue.Base.Text })
		local look = style(cue.Base)
		if next(look) then
			table.insert(row, { "Style", look })
		end

		for _, key in { "Entrance", "Exit", "InFrames", "OutFrames", "Order", "Preset" } do
			if cue[key] ~= subtitleDefaults[key] then
				table.insert(row, { key, cue[key] })
			end
		end

		if #cue.Keys > 0 then
			local keys = {}
			for _, key in cue.Keys do
				table.insert(
					keys,
					{ Frame = key.Frame, Ease = key.Ease, Value = style(key.Value, cue.Base) }
				)
			end

			table.insert(row, { "Keys", keys })
		end

		table.insert(rows, row)
	end

	return rows
end

local function eventRows(events, rigNames, sources)
	local rows = {}
	for _, event in events do
		local data = event.Data
		local row = {}
		if data.Name and data.Name ~= "" then
			table.insert(row, { "Name", data.Name })
		end

		table.insert(row, { "Frame", event.Frame })
		if event.Rig then
			table.insert(row, { "Rig", rigNames[event.Rig] })
		end

		if (data.Duration or 0) > 0 then
			table.insert(row, { "Duration", data.Duration })
		end

		if event.Speed and event.Speed ~= 1 then
			table.insert(row, { "Speed", event.Speed })
		end

		if data.Parameter and data.Parameter ~= "" then
			table.insert(row, { "Parameter", data.Parameter })
		end

		if #(data.Sounds or {}) > 0 then
			table.insert(row, { "Sounds", data.Sounds })
		end

		if #(event.Markers or {}) > 0 then
			table.insert(row, { "Markers", event.Markers })
		end

		local extra = {}
		for key, value in data do
			if
				key ~= "Id"
				and key ~= "Name"
				and key ~= "Frame"
				and key ~= "Duration"
				and key ~= "Speed"
				and key ~= "Parameter"
				and key ~= "Sounds"
				and key ~= "Emits"
				and key ~= "Markers"
				and key ~= "Enabled"
			then
				extra[key] = value
			end
		end

		if next(extra) then
			table.insert(row, { "Data", extra })
		end

		for _, phase in { "Begin", "End" } do
			local id = event[phase]
			if id then
				local source = sources[id]
				assert(source, "Missing event code " .. tostring(id))
				table.insert(row, { phase, { code = source } })
			end
		end

		table.insert(rows, row)
	end

	return rows
end

local function renderRows(rows)
	local out = {}
	for _, row in rows do
		local lines = { "\t{" }
		for _, pair in row do
			local key, value = pair[1], pair[2]
			if type(value) == "table" and value.code then
				table.insert(lines, "\t\t" .. key .. " = { factory = function(environment)")
				table.insert(lines, indented(codeBindings, 3))
				table.insert(lines, "\t\t\treturn function(rig, event, parameter, context)")
				local body = indented(value.code, 4)
				if body ~= "" then
					table.insert(lines, body)
				end

				table.insert(lines, "\t\t\tend\n\t\tend },")
			else
				table.insert(lines, "\t\t" .. key .. " = " .. pretty(value, 2) .. ",")
			end
		end

		table.insert(lines, "\t},")
		table.insert(out, table.concat(lines, "\n"))
	end

	if #out == 0 then
		return "{}"
	end

	return "{\n" .. table.concat(out, "\n") .. "\n}"
end

local function cutsceneSource(options, data, subtitles, events, rigNames, sources)
	local lines = {
		header,
		"",
		'local Eclipse = require("./' .. runtimeName .. '")',
		"",
		"local Cutscene = {}",
		"",
		"Cutscene.FPS = " .. scalar(data.FPS),
		"Cutscene.LastFrame = " .. scalar(data.LastFrame),
		"Cutscene.Camera = " .. codec.encode(data.CameraMode),
		"Cutscene.Loop = false",
		"Cutscene.Interpolate = true",
		"Cutscene.HideOriginals = true",
		"",
	}
	if options.Mode == "Button" then
		table.insert(lines, "Cutscene.Button = " .. pretty({
			Label = options.ButtonLabel,
			Theme = {
				Background = theme.get("TopBtn", Color3.fromRGB(28, 30, 35)),
				Foreground = theme.get("TopT", Color3.new(1, 1, 1)),
			},
		}))
		table.insert(lines, "")
	end

	table.insert(lines, "Cutscene.Subtitles = " .. renderRows(subtitleRows(subtitles)))
	table.insert(lines, "")
	table.insert(lines, "Cutscene.Events = " .. renderRows(eventRows(events, rigNames, sources)))
	table.insert(lines, "")
	table.insert(lines, "return Eclipse.build(script, Cutscene)")
	table.insert(lines, "")
	return table.concat(lines, "\n")
end
local guide = [====[
Eclipse cutscene

You can edit the cutscene module like any other script. Leave Baked alone; re-export if you change the animation.

Run this from a LocalScript:
local Cutscene = require("./%s")
local player = Cutscene.new()
player:Play()

player:Pause() pauses it. player:Play() resumes it.
player:Seek(1.5) jumps to 1.5 seconds. player:Stop() stops it and resets the scene.
Call player:Destroy() when you're done with the player.

Pass options to Cutscene.new({ ... }):
Loop = true repeats it. CameraMode = "Game" keeps the player's camera; "Authored" uses the exported camera.
HideOriginals hides the original actors during playback. Interpolate smooths between samples. ParentGui sets the UI parent.
Use MarkerReached(name, parameter, frame), Completed(), Stopped(reason) or Failed(message) with :Connect() for callbacks.

Editing the module:
- Events: Begin runs at Frame, End at Frame + Duration. Delete an event or set Enabled = false to skip it.
- Subtitles: edit Text, Speaker, Frame, Duration and Style. Only changed settings are included.
- LastFrame: where the cutscene ends. Frame values use Cutscene.FPS; Seek uses seconds.
- Button: edit Label and Theme, or remove Button if you don't want one.

Keep EclipseCutsceneRuntime beside your cutscenes. If you move it, update the require at the top of the module.
Leave scripts in Scene disabled. Keep ProjectArchive if you want to import the cutscene back into Eclipse.

For another place, copy EclipseCutscenes into ReplicatedStorage, including EclipseCutsceneRuntime.
If you use buttons, also copy EclipseCutsceneHandler into StarterPlayerScripts.
The scene copies come with the export. Originals still points to the old actors, so HideOriginals won't hide actors in the new place.
Your experience needs permission to use the exported assets. Editable meshes also need Mesh & Image APIs enabled.
Restart Play after editing exported modules.

To remove all exported cutscenes, delete ReplicatedStorage.EclipseCutscenes and StarterPlayer.StarterPlayerScripts.EclipseCutsceneHandler.
]====]

function packageValue.build(refs, options, progress)
	assert(options.Mode == "Button" or options.Mode == "Scripting", "Choose Buttons or Scripting")
	assert(
		options.Name ~= runtimeName,
		runtimeName .. " is reserved for the shared runtime. Choose another export name."
	)
	require("humanoidScale").warnExport(refs.State.Timeline:GetState())
	local root, data, code = bake.build(refs, options, progress)
	local launcherObject
	local ok, message = xpcall(function()
		if progress then
			progress("Packaging cutscene, baked data and launch controls...")
		end

		local sources = {}
		local assets, seenAssets = {}, {}
		for _, entry in code do
			sources[entry.Id] = entry.Source
			local codeFolder = root:FindFirstChild("Code") or Instance.new("Folder")
			codeFolder.Name = "Code"
			codeFolder.Parent = root
			module(
				codeFolder,
				entry.Id,
				"return function(environment)\n"
					.. codeBindings
					.. "return function(...)\n"
					.. entry.Source
					.. "\nend\nend"
			)
			for asset in entry.Source:gmatch("rbxassetid://%d+") do
				if not seenAssets[asset] then
					seenAssets[asset] = true
					table.insert(assets, asset)
				end
			end
		end

		local names = {}
		for _, object in root.Scene:GetDescendants() do
			local id = object:GetAttribute("EclipseExportId")
			if id then
				names[id] = object.Name
			end
		end

		for _, global in data.Globals do
			names[global.Id] = names[global.Id] or global.Path[#global.Path]
		end

		local rigNames, rigs, taken = {}, {}, {}

		local function label(id)
			if rigNames[id] then
				return
			end

			local base = tostring(names[id] or ("Rig" .. id)):gsub("^%s+", ""):gsub("%s+$", "")
			if base == "" then
				base = "Rig" .. id
			end

			local name = base
			local index = 2
			while taken[name] do
				name = base .. " " .. index
				index += 1
			end

			taken[name] = true
			rigNames[id] = name
			rigs[name] = id
		end

		for _, record in data.Roots do
			if record.Kind == "Actor" or record.Kind == "Camera" then
				label(record.Id)
			end
		end

		for _, event in data.Events do
			if event.Rig then
				label(event.Rig)
			end
		end

		local baked = module(root, "Baked", "return {}")
		local chunkNames = {}
		local rows = {}
		local size = 0

		local function flush()
			if #rows == 0 then
				return
			end

			local name = string.format("Chunk_%03d", #chunkNames + 1)
			module(baked, name, "return {\n\t" .. table.concat(rows, ",\n\t") .. ",\n}\n")
			table.insert(chunkNames, name)
			rows = {}
			size = 0
		end

		for _, track in data.Tracks do
			local batch = {}
			local bytes = 0

			local function part()
				local copy = table.clone(track)
				copy.Samples = batch
				local source = codec.encode(copy, nil, 1, true)
				if size + #source > 180000 then
					flush()
				end

				table.insert(rows, source)
				size += #source
				batch = {}
				bytes = 0
			end

			for _, sample in track.Samples do
				local encoded = codec.encode(sample, nil, nil, true)
				if bytes + #encoded > 90000 and #batch > 0 then
					part()
				end

				table.insert(batch, sample)
				bytes += #encoded
			end

			if #batch > 0 then
				part()
			end
		end

		flush()
		local layout = storeData(baked, {
			Bindings = data.Bindings,
			Roots = data.Roots,
			Globals = data.Globals,
			Effects = data.Effects,
			EffectCameras = data.EffectCameras,
			Afterimages = data.Afterimages,
			Smears = data.Smears,
			Geometry = data.Geometry,
			Rigs = rigs,
			Assets = assets,
			Authored = data.CameraMode ~= "Game",
			ContentLastFrame = data.ContentLastFrame,
			SkipFrames = data.SkipFrames or 0,
			GreaseDrawings = data.GreaseDrawings,
		}, "Layout")
		editor:UpdateSourceAsync(baked, function()
			return string.format(
				[====[%s

local baked = require(%q)
local chunks = %s
local tracks = {}

baked.Tracks = {}

for _, name in chunks do
	for _, track in require(`@self/{name}`) do
		local key = `{track.Target}:{track.Kind}:{track.Property}`
		local previous = tracks[key]

		if previous then
			for _, sample in track.Samples do
				table.insert(previous.Samples, sample)
			end
		else
			tracks[key] = track
			table.insert(baked.Tracks, track)
		end
	end
end

return baked
]====],
				header,
				"@self/" .. layout,
				pretty(chunkNames)
			)
		end)
		local source = cutsceneSource(options, data, data.Subtitles, data.Events, rigNames, sources)
		editor:UpdateSourceAsync(root, function()
			return source
		end)
		assert(root.Source == source, "Cannot write cutscene entry point")
		root:SetAttribute("EclipseCutscene", 2)
		root:SetAttribute("FPS", data.FPS)
		root:SetAttribute("EndFrame", data.LastFrame)
		root:SetAttribute(
			"RequiresEditableMesh",
			next(data.Geometry) ~= nil
				or data.Afterimages and next(data.Afterimages.Geometry) ~= nil
		)
		local text = string.format(guide, options.Name)
		local fence = "="
		while text:find("]" .. fence .. "]", 1, true) do
			fence ..= "="
		end

		module(
			root,
			"README",
			header .. "\n\n--[" .. fence .. "[\n" .. text .. "]" .. fence .. "]\n\nreturn {}\n"
		)
		if options.Mode == "Button" then
			root:SetAttribute("EclipseLaunchMode", options.Mode)
			launcherObject = handler()
			launcherObject:SetAttribute("EclipseCutsceneHandler", 1)
			launcherObject:SetAttribute("Cutscene", options.Name)
			launcherObject:SetAttribute("Mode", options.Mode)
			launcherObject:SetAttribute("ButtonLabel", options.ButtonLabel)
			launcherObject:SetAttribute("EclipseHandlerVersion", 5)
		end
	end, debug.traceback)
	if not ok then
		root:Destroy()
		if launcherObject then
			launcherObject:Destroy()
		end

		error(message, 2)
	end

	return root, launcherObject
end

local function fingerprint(text)
	local a, b = 7, 11
	for index = 1, #text do
		local byte = text:byte(index)
		a = (a * 31 + byte) % 4294967296
		b = (b * 131 + byte) % 4294967296
	end

	return string.format("%08x%08x", a, b)
end

local generatedHandlers = {
	["3a5ef365a9e42dbd"] = true,
	["c606d6ddd69c8f5d"] = true,
	["c4fa40b91bd3be65"] = true,
	["21019d6f55159673"] = true,
}

local replacedHandlers = {
	["2385fc3ce22c2b60"] = true,
	["96cccde649fe6596"] = true,
	["8f83073bbcd7000b"] = true,
	["98d9c1cd71a93c8d"] = true,
	["78b505c570beeae9"] = true,
	["d56cbb750e927ad9"] = true,
	["3b97cf45da39e009"] = true,
}

local function isGenerated(source)
	return generatedHandlers[fingerprint(source)] == true
end

local function isReplaceable(source)
	return replacedHandlers[fingerprint(source)] == true
end

function packageValue.refreshHandlers()
	local starter = game:GetService("StarterPlayer"):FindFirstChildOfClass("StarterPlayerScripts")
	if not starter then
		return 0
	end

	local source = handlerTemplate.Source
	local count = 0
	for _, object in starter:GetChildren() do
		if
			object:IsA("LocalScript")
			and object:GetAttribute("EclipseCutsceneHandler") == 1
			and object.Source ~= source
			and isReplaceable(object.Source)
		then
			local ok = pcall(function()
				editor:UpdateSourceAsync(object, function()
					return source
				end)
			end)
			if ok and object.Source == source then
				count += 1
			end
		end
	end

	return count
end
function packageValue.installHandler(proposed)
	local starter = game:GetService("StarterPlayer"):FindFirstChildOfClass("StarterPlayerScripts")
	assert(starter, "StarterPlayerScripts is missing")
	local storage = game:GetService("ReplicatedStorage"):FindFirstChild("EclipseCutscenes")
	assert(storage and storage:IsA("Folder"), "EclipseCutscenes is missing")

	local existing
	local legacy = {}

	for _, object in starter:GetChildren() do
		if object:GetAttribute("EclipseCutsceneHandler") == 1 then
			assert(object:IsA("LocalScript") and not existing, "Multiple Eclipse handlers found")
			existing = object
		elseif object:IsA("LocalScript") and object:GetAttribute("EclipseCutsceneLauncher") then
			local package = storage:FindFirstChild(tostring(object:GetAttribute("Cutscene")))
			if
				package
				and package:IsA("ModuleScript")
				and package:GetAttribute("EclipseCutscene") == 1
			then
				assert(
					isGenerated(object.Source),
					"The handler "
						.. object.Name
						.. " has custom edits. Keep a copy and remove it from StarterPlayerScripts before consolidating."
				)
				table.insert(legacy, {
					script = object,
					package = package,
					source = object.Source,
					enabled = object.Enabled,
				})
			end
		end
	end

	local replaced = existing and isReplaceable(existing.Source) and existing or nil
	local replacedEnabled = replaced and replaced.Enabled
	if replaced then
		existing = nil
	end

	local target = existing or proposed or handler()
	if not existing then
		target.Name = "EclipseCutsceneHandler"
		target:SetAttribute("EclipseCutsceneHandler", 1)
		target:SetAttribute("EclipseHandlerVersion", 5)
		target:SetAttribute("Cutscene", nil)
		target:SetAttribute("Mode", nil)
		target:SetAttribute("Command", nil)
		target:SetAttribute("ButtonLabel", nil)
	end

	local backup
	local configs = {}
	local attributes = {}
	local moved = {}
	local ok, message = xpcall(function()
		for _, record in legacy do
			local object = record.script
			assert(
				object.Source == record.source and object.Parent == starter,
				"Legacy handler changed during migration"
			)
			if not record.package:FindFirstChild("Launch") then
				local config = module(record.package, "Launch", "return " .. codec.encode({
					Mode = object:GetAttribute("Mode"),
					ButtonLabel = object:GetAttribute("ButtonLabel"),
					Command = object:GetAttribute("Command"),
				}))
				table.insert(configs, config)
				table.insert(attributes, {
					package = record.package,
					mode = record.package:GetAttribute("EclipseLaunchMode"),
					command = record.package:GetAttribute("EclipseCommand"),
				})
				record.package:SetAttribute("EclipseLaunchMode", object:GetAttribute("Mode"))
				record.package:SetAttribute("EclipseCommand", object:GetAttribute("Command"))
			end
		end

		if #legacy > 0 or replaced then
			backup = Instance.new("Folder")

			backup.Name =
				unique(game:GetService("ServerStorage"), "Eclipse Cutscene Handler Backups")
			backup:SetAttribute("EclipseHandlerBackup", true)
			backup.Parent = game:GetService("ServerStorage")
		end

		for _, record in legacy do
			table.insert(moved, record)
			record.script.Enabled = false
			record.script.Parent = backup
		end

		if replaced then
			assert(
				replaced.Parent == starter and isReplaceable(replaced.Source),
				"Shared handler changed during upgrade"
			)
			replaced.Enabled = false
			replaced.Parent = backup
		end

		if not existing then
			target.Parent = starter
		end
	end, debug.traceback)

	if not ok then
		if replaced and replaced.Parent == backup then
			replaced.Parent = starter
			replaced.Enabled = replacedEnabled
		end

		for _, record in moved do
			record.script.Parent = starter
			record.script.Enabled = record.enabled
		end

		for _, config in configs do
			config:Destroy()
		end

		for _, record in attributes do
			record.package:SetAttribute("EclipseLaunchMode", record.mode)
			record.package:SetAttribute("EclipseCommand", record.command)
		end

		if backup then
			backup:Destroy()
		end

		if not existing then
			target:Destroy()
		end

		error(message, 2)
	end

	if proposed and proposed ~= target then
		proposed:Destroy()
	end

	return target, #moved
end

function packageValue.install(root, proposed)
	local storage = game:GetService("ReplicatedStorage")
	local folder = storage:FindFirstChild("EclipseCutscenes")
	assert(
		not folder or folder:IsA("Folder"),
		"ReplicatedStorage.EclipseCutscenes must be a Folder"
	)
	assert(
		not folder or not folder:FindFirstChild(root.Name),
		"An export named " .. root.Name .. " already exists. Choose another name to preserve it."
	)

	local created
	local handler
	local commit, rollback
	local ok, message = xpcall(function()
		if not folder then
			folder = Instance.new("Folder")

			folder.Name = "EclipseCutscenes"
			folder.Parent = storage
			created = folder
		end

		commit, rollback = select(3, stageRuntime(folder))
		root.Parent = folder
		if proposed then
			handler = packageValue.installHandler(proposed)
		end
	end, debug.traceback)

	if not ok then
		root.Parent = nil
		if rollback then
			rollback()
		end
		if created then
			created:Destroy()
		end

		error(message, 2)
	end

	commit()
	return root, handler, finishRuntimeCleanup()
end

return packageValue
]]></ProtectedString>
						<string name="ScriptGuid">{6095F1AD-98A6-4451-8153-A3A583CCF0E4}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">package</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX20289109804C4EB683701B241CA72974">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local chrome = require("chrome")
local imageUpload = require("upload")
local localGif = require("localGif")
local theme = require("theme")
local sequence = require("sequence")
local windowFx = require("windowFx")
local confirm = require("confirm")

local editor = {}
local session
local font = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)

local function make(class, parent, name, props)
	local object = Instance.new(class)

	object.Name = name
	for key, value in pairs(props) do
		object[key] = value
	end

	object.Parent = parent
	return object
end

local function round(object, radius)
	make("UICorner", object, "Corner", { CornerRadius = UDim.new(0, radius) })
end

local function surface(object, key)
	object.BorderSizePixel = 0
	object:SetAttribute("ThemeBg", key)
	round(object, 5)
	local stroke = make("UIStroke", object, "Outline", {
		Color = Color3.fromRGB(78, 57, 95),
		Thickness = 1,
		StrokeSizingMode = Enum.StrokeSizingMode.FixedSize,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	stroke:SetAttribute("ThemeStrk", "Strk")
end

local function text(parent, name, value, pos, size, fontSize)
	local object = make("TextLabel", parent, name, {
		Text = value,
		Position = pos,
		Size = size,
		TextSize = fontSize or 12,
		FontFace = font,
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(233, 228, 239),
		ZIndex = 82,
	})
	object:SetAttribute("ThemeTxt", "Txt")
	return object
end

local function button(parent, name, value, pos, size)
	local object = make("TextButton", parent, name, {
		Text = value,
		Position = pos,
		Size = size,
		TextSize = 12,
		FontFace = font,
		BackgroundColor3 = Color3.fromRGB(42, 28, 53),
		TextColor3 = Color3.fromRGB(233, 228, 239),
		AutoButtonColor = true,
		ZIndex = 83,
	})
	surface(object, "TopBtn")
	object:SetAttribute("ThemeTxt", "Txt")
	return object
end

local function field(parent, name, value, pos, size)
	local object = make("TextBox", parent, name, {
		Text = value,
		Position = pos,
		Size = size,
		TextSize = 12,
		FontFace = font,
		BackgroundColor3 = Color3.fromRGB(17, 10, 24),
		TextColor3 = Color3.fromRGB(233, 228, 239),
		ClearTextOnFocus = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 83,
	})
	surface(object, "Pnl")
	object:SetAttribute("ThemeShade", -0.3)
	object:SetAttribute("ThemeTxt", "Txt")
	return object
end

local function number(value)
	return string.format("%.2f", value):gsub("0+$", ""):gsub("%.$", "")
end

local function collect()
	local frames = {}
	for _, row in ipairs(session.rows) do
		table.insert(frames, {
			image = row.id.Text,
			delay = row.delay.Text == row.initialDelayText and row.exactDelay or tonumber(
				row.delay.Text
			) or 0,
		})
	end

	return frames
end

local function snapshot(frames)
	local out = {}
	for _, frame in ipairs(frames) do
		table.insert(out, tostring(frame.image) .. ":" .. tostring(frame.delay))
	end

	return table.concat(out, "|")
end

local function info()
	if not session or session.uploading then
		return
	end

	local frames = collect()
	local total = sequence.duration(frames)
	session.duration.Text = number(total)
	session.fps.Text = total > 0 and number(#frames * 1000 / total) or "0"
	session.lastFPS, session.lastDuration = session.fps.Text, session.duration.Text
	session.summary.Text = #frames
		.. " images  .  "
		.. math.floor(total / 1000)
		.. "s "
		.. number(total % 1000)
		.. "ms"
end

local rebuild

local function dashed(tile)
	local function paint()
		if not tile.Parent or not session then
			return
		end

		for _, child in ipairs(tile:GetChildren()) do
			if child.Name == "Dash" then
				child:Destroy()
			end
		end

		local scale = session.root:FindFirstChildOfClass("UIScale")
		local width, height = tile.AbsoluteSize.X / (scale and scale.Scale or 1), 80
		for x = 6, width - 6, 12 do
			for _, y in ipairs({ 0, height - 1 }) do
				local dot = make("Frame", tile, "Dash", {
					Position = UDim2.fromOffset(x, y),
					Size = UDim2.fromOffset(math.min(6, width - x - 4), 1),
					BackgroundColor3 = Color3.fromRGB(113, 87, 130),
					BorderSizePixel = 0,
					ZIndex = 82,
				})
				dot:SetAttribute("ThemeBg", "Strk")
			end
		end

		for y = 6, height - 6, 12 do
			for _, x in ipairs({ 0, width - 1 }) do
				local dot = make("Frame", tile, "Dash", {
					Position = UDim2.fromOffset(x, y),
					Size = UDim2.fromOffset(1, 6),
					BackgroundColor3 = Color3.fromRGB(113, 87, 130),
					BorderSizePixel = 0,
					ZIndex = 82,
				})
				dot:SetAttribute("ThemeBg", "Strk")
			end
		end
	end

	tile:GetPropertyChangedSignal("AbsoluteSize"):Connect(paint)
	task.defer(paint)
end

function editor.addFrame()
	if not session or session.uploading then
		return
	end

	local frames = collect()
	if #frames >= sequence.MAX_FRAMES then
		session.status.Text = "Maximum 300 images."
		return
	end

	table.insert(frames, { image = "", delay = frames[#frames].delay })
	rebuild(frames)
end

rebuild = function(frames)
	local current = session
	for _, child in ipairs(current.scroll:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	current.rows = {}
	for index, frame in ipairs(frames) do
		local card = make(
			"Frame",
			current.scroll,
			"Image" .. index,
			{ LayoutOrder = index, BackgroundColor3 = Color3.fromRGB(26, 18, 34), ZIndex = 81 }
		)
		surface(card, "Pnl")
		local thumbnail = make("ImageLabel", card, "Preview", {
			Position = UDim2.fromOffset(36, 6),
			Size = UDim2.fromOffset(26, 22),
			Image = localGif.is(frame.image) and "" or sequence.asset(frame.image) or "",
			ScaleType = Enum.ScaleType.Crop,
			BackgroundTransparency = 1,
			ZIndex = 82,
		})
		if localGif.is(frame.image) then
			pcall(localGif.apply, thumbnail, frame.image)
		end
		round(thumbnail, 3)
		local label = text(
			card,
			"Label",
			"Image " .. index,
			UDim2.fromOffset(68, 5),
			UDim2.new(1, -100, 0, 24),
			12
		)
		label.TextXAlignment = Enum.TextXAlignment.Left
		local remove =
			button(card, "Remove", "x", UDim2.new(1, -28, 0, 5), UDim2.fromOffset(22, 22))
		remove.TextSize = 17
		local id =
			field(card, "AssetId", frame.image, UDim2.fromOffset(8, 40), UDim2.new(1, -86, 0, 26))
		id.PlaceholderText = "rbxassetid://..."
		local delay = field(
			card,
			"Delay",
			number(frame.delay),
			UDim2.new(1, -70, 0, 40),
			UDim2.fromOffset(62, 26)
		)
		text(card, "DelayLabel", "ms", UDim2.new(1, -70, 0, 24), UDim2.fromOffset(62, 14), 10).TextTransparency =
			0.35
		table.insert(
			current.rows,
			{ id = id, delay = delay, initialDelayText = delay.Text, exactDelay = frame.delay }
		)
		local upload = button(card, "Upload", "", UDim2.fromOffset(8, 5), UDim2.fromOffset(22, 22))
		local uploadIcon = make("ImageLabel", upload, "Icon", {
			Image = chrome.UPLOAD_ICON,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(3, 3),
			Size = UDim2.fromOffset(16, 16),
			ZIndex = 84,
		})
		uploadIcon:SetAttribute("ThemeImg", "Txt")
		upload.Activated:Connect(function()
			if current.uploading then
				return
			end

			current.uploading = true
			upload.Interactable = false
			uploadIcon.Visible = false
			upload.Text = "..."
			current.status.Text = "Choose a local image frame."
			local asset, err = imageUpload.promptLocal()
			current.uploading = false
			if session ~= current or not card.Parent then
				return
			end

			upload.Interactable = true
			uploadIcon.Visible = true
			upload.Text = ""
			if asset then
				id.Text = asset
				localGif.apply(thumbnail, asset)
			end

			info()
			current.status.Text = err or (asset and "Local image loaded." or "")
		end)
		id.FocusLost:Connect(function()
			local asset = sequence.asset(id.Text)
			if asset then
				id.Text = asset
				localGif.apply(thumbnail, asset)
			end

			current.status.Text = asset and "" or "Enter an image ID or rbxasset:// path."
		end)
		require("numericInput").connect(delay, { step = 1, min = 1, integer = true }, function()
			info()
		end)
		remove.Activated:Connect(function()
			if current.uploading then
				return
			end

			local nextFrames = collect()
			table.remove(nextFrames, index)
			if #nextFrames == 0 then
				nextFrames = { { image = "", delay = 1000 / 30 } }
			end

			rebuild(nextFrames)
		end)
	end

	local add = make("TextButton", current.scroll, "AddImage", {
		LayoutOrder = #frames + 1,
		Text = "+",
		TextSize = 32,
		FontFace = font,
		TextColor3 = Color3.fromRGB(205, 191, 217),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		ZIndex = 81,
	})
	add:SetAttribute("ThemeTxt", "Txt")
	dashed(add)
	add.Activated:Connect(editor.addFrame)
	info()
	for _, object in ipairs(current.scroll:GetDescendants()) do
		theme.applyInstance(object)
	end
end

function editor.setDuration(duration)
	if not session or session.uploading then
		return false
	end

	local frames, err = sequence.retime(collect(), tonumber(duration))
	if not frames then
		session.status.Text = err
		info()
		return false
	end

	rebuild(frames)
	session.status.Text = ""
	return true
end

function editor.close(force)
	local current = session
	if not current or current.closing then
		return
	end

	if current.uploading and not force then
		current.status.Text = "Please wait for the images to finish loading."
		return
	end

	local frames = collect()
	local dirty = snapshot(frames) ~= current.original
	local hasContent = frames[1].image:match("%S") or current.hadContent
	if not force and dirty and hasContent then
		confirm.open(
			current.root,
			nil,
			"DISCARD GIF CHANGES?",
			"Your frame and timing changes have not been applied.",
			"Discard",

			function()
				editor.close(true)
			end
		)
		return
	end

	current.closing = true
	windowFx.shrink(current.window, function()
		if session == current then
			session = nil
		end

		current.window:Destroy()
	end)
end

function editor.apply()
	if not session or session.uploading then
		return false
	end

	if session.presetRevision ~= theme.getPresetRevision() then
		session.status.Text = "The preset changed. Reopen GIF to edit the current preset."
		return false
	end

	if session.clearRequested and not collect()[1].image:match("%S") then
		local ok, applied = pcall(session.apply, nil)
		if not ok or applied == false then
			session.status.Text = "The background could not be applied. Your frames have been kept."
			return false
		end

		editor.close(true)
		return true
	end

	local frames, err = sequence.normalize(collect())
	if not frames then
		session.status.Text = err
		return false
	end

	local current = session
	local appliedOk, applied = pcall(current.apply, frames)
	if not appliedOk or applied == false then
		current.status.Text = "The background could not be applied. Your frames have been kept."
		return false
	end

	if session == current then
		editor.close(true)
	end
	require("notification").show(
		"SHARING",
		'Want to share this to friends? Make sure to make every image "Open Use"!',
		5
	)

	return true
end

function editor.open(root, value, onApply)
	if session and (session.closing or session.presetRevision ~= theme.getPresetRevision()) then
		windowFx.clear(session.window)
		session.window:Destroy()
		session = nil
	end

	if session and session.window.Parent then
		return session.window
	end

	local scaleObject = root:FindFirstChildOfClass("UIScale")
	local scale = scaleObject and scaleObject.Scale or 1
	local view = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
		or Vector2.new(1280, 720)
	local window = make("Frame", root, "EclipseGifEditor", {
		Size = UDim2.fromOffset(
			math.min(620, view.X / scale - 36),
			math.min(490, view.Y / scale - 36)
		),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(18, 10, 26),
		Active = true,
		ZIndex = 80,
	})
	surface(window, "Bg")
	local header, title, drag = chrome.header(window, "GIF BACKGROUND", 81, 126)
	local apply = chrome.menuButton(
		header,
		"Apply",
		"APPLY",
		UDim2.new(1, -110, 0, 4),
		UDim2.fromOffset(72, 20),
		84
	)
	local exit = chrome.close(header, nil, 84)
	chrome.bindDrag(window, drag)
	local backdrop = make("Frame", window, "Backdrop", {
		Position = UDim2.fromOffset(4, chrome.HEIGHT),
		Size = UDim2.new(1, -8, 1, -chrome.HEIGHT - 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 80,
	})
	surface(backdrop, "Bg")
	backdrop.Outline:Destroy()
	backdrop:SetAttribute("ThemeBgImage", 1)

	text(window, "FPSLabel", "FPS", UDim2.fromOffset(14, 38), UDim2.fromOffset(90, 20), 12)
	local fps = field(window, "FPS", "30", UDim2.fromOffset(14, 65), UDim2.fromOffset(90, 26))
	text(
		window,
		"DurationLabel",
		"Duration (ms)",
		UDim2.fromOffset(118, 38),
		UDim2.fromOffset(122, 20),
		12
	)
	local duration =
		field(window, "Duration", "", UDim2.fromOffset(118, 65), UDim2.fromOffset(122, 26))
	local summary =
		text(window, "Summary", "", UDim2.fromOffset(254, 38), UDim2.new(1, -268, 0, 20), 12)
	summary.TextXAlignment = Enum.TextXAlignment.Right
	summary.TextTransparency = 0.3
	local divider = make("Frame", window, "Divider", {
		Position = UDim2.fromOffset(14, 97),
		Size = UDim2.new(1, -28, 0, 1),
		BackgroundColor3 = Color3.fromRGB(78, 57, 95),
		BorderSizePixel = 0,
		ZIndex = 81,
	})
	divider:SetAttribute("ThemeBg", "Div")
	local scroll = make("ScrollingFrame", window, "Frames", {
		Position = UDim2.fromOffset(12, 107),
		Size = UDim2.new(1, -24, 1, -137),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 81,
	})
	scroll:SetAttribute("ThemeScr", "Scr")
	make("UIGridLayout", scroll, "Grid", {
		CellSize = UDim2.new(0.5, -10, 0, 80),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	make("UIPadding", scroll, "Padding", {
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 4),
	})
	local clear =
		button(window, "ClearGif", "CLEAR GIF", UDim2.new(0, 14, 1, -25), UDim2.fromOffset(90, 19))
	clear.TextSize = 10
	local status =
		text(window, "Status", "", UDim2.new(0, 114, 1, -26), UDim2.new(1, -128, 0, 20), 11)
	status.TextXAlignment = Enum.TextXAlignment.Left
	local frames = value and value.frames and sequence.normalize(value.frames)
		or { { image = value and value.image or "", delay = 1000 / 30 } }
	session = {
		root = root,
		window = window,
		scroll = scroll,
		fps = fps,
		duration = duration,
		summary = summary,
		status = status,
		rows = {},
		apply = onApply,
		hadContent = frames[1].image ~= "",
		presetRevision = theme.getPresetRevision(),
	}
	rebuild(frames)
	session.original = snapshot(collect())
	clear.Activated:Connect(function()
		if session.uploading then
			return
		end

		session.clearRequested = true
		rebuild({ { image = "", delay = 1000 / 30 } })
		session.status.Text = "Apply to remove this GIF."
	end)
	require("numericInput").connect(fps, { step = 1, min = 1, integer = true }, function()
		if not session or fps.Text == session.lastFPS then
			return
		end

		local value = tonumber(fps.Text)
		if value and value > 0 then
			editor.setDuration(#session.rows * 1000 / value)
		else
			info()
		end
	end)
	require("numericInput").connect(duration, { step = 0.1, min = 0.01 }, function()
		if session and duration.Text ~= session.lastDuration then
			editor.setDuration(tonumber(duration.Text))
		end
	end)
	apply.Activated:Connect(editor.apply)
	exit.Activated:Connect(function()
		editor.close()
	end)
	theme.applyInstance(window)
	for _, object in ipairs(window:GetDescendants()) do
		theme.applyInstance(object)
	end

	windowFx.pop(window)
	return window
end

return editor
