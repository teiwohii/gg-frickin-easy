					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local marketplace = game:GetService("MarketplaceService")
local notification = require("notification")
local noticeValue = {}
local assetId = 86116556258301

function noticeValue.version(text)
	if type(text) ~= "string" then
		return nil
	end
	local version = text:match("^%s*[vV](%d+%.%d+[%.%d]*)%s*$")
	if not version or version:find("%.%.") or version:sub(-1) == "." then
		return nil
	end
	local parts = {}
	for part in version:gmatch("%d+") do
		local value = tonumber(#parts == 1 and "0." .. part or part)
		if not value or value == math.huge then
			return nil
		end
		table.insert(parts, value)
	end
	return parts
end

function noticeValue.newer(current, info)
	local installed = noticeValue.version(current)
	if
		not installed
		or type(info) ~= "table"
		or info.AssetId ~= assetId
		or info.AssetTypeId ~= 38
	then
		return false
	end
	if type(info.Description) ~= "string" then
		return false
	end
	local published
	for line in info.Description:gmatch("[^\r\n]+") do
		local candidate = noticeValue.version(line)
		if candidate then
			if published then
				return false
			end
			published = candidate
		end
	end
	if not published then
		return false
	end
	for i = 1, math.max(#installed, #published) do
		local a, b = installed[i] or 0, published[i] or 0
		if a ~= b then
			return b > a
		end
	end
	return false
end

function noticeValue.start(screen, source)
	local current = require("pluginShell").ReleaseVersion
	if not noticeValue.version(current) then
		return
	end
	local alive, checking = true, false
	local opened, shown = 1, nil
	local last = -math.huge
	local connection
	local function check(force)
		if
			not alive
			or not screen.Enabled
			or checking
			or shown == opened
			or not force and os.clock() - last < 900
		then
			return
		end
		checking, last = true, os.clock()
		task.spawn(function()
			local ok, info =
				pcall(marketplace.GetProductInfoAsync, marketplace, assetId, Enum.InfoType.Asset)
			checking = false
			if not alive or not screen.Enabled or not ok or not noticeValue.newer(current, info) then
				return
			end
			local notice = notification.show(
				"NEW UPDATE AVAILABLE!",
				'Go to Plugins > Manage Plugins > find "Eclipse Animator" > Update',
				7,
				"UpdateAvailable"
			)
			if notice then
				shown = opened
			end
		end)
	end
	connection = screen:GetPropertyChangedSignal("Enabled"):Connect(function()
		if screen.Enabled then
			opened += 1
			check(true)
		end
	end)
	screen.Destroying:Once(function()
		alive = false
		connection:Disconnect()
	end)
	task.defer(check)
	task.spawn(function()
		while alive do
			task.wait(60)
			if alive and screen.Enabled then
				check()
			end
		end
	end)
end

return noticeValue
]]></ProtectedString>
						<string name="ScriptGuid">{BD9838C1-1E55-4F6B-B6B7-A56DA3F8985E}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">updateNotice</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX4804171BDF3449AEA4399D483CD1B2B2">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local tool = require("tool")
local theme = require("theme")
local tracks = require("properties")
local history = require("history")
local inputModule = require("userInputService")
local edit = require("blenderEdit")
local sliders = {}
local refs, window, faceWindow, drag
local connections = {}
local chosen = setmetatable({}, { __mode = "k" })
local resetValue = "rbxassetid://110138249483014"

local function owner(motor)
	return tracks.is(motor) and motor.Rig or require("layers").owner(motor)
end

local componentNames = {
	number = { "Value" },
	boolean = { "Value" },
	string = { "Value" },
	EnumItem = { "Value" },
	Vector2 = { "X", "Y" },
	Vector3 = { "X", "Y", "Z" },
	Color3 = { "R", "G", "B" },
	CFrame = { "X", "Y", "Z", "RX", "RY", "RZ" },
	NumberRange = { "Min", "Max" },
	UDim = { "Scale", "Offset" },
	UDim2 = { "X Scale", "X Offset", "Y Scale", "Y Offset" },
	Rect = { "Min X", "Min Y", "Max X", "Max Y" },
	BrickColor = { "Color number" },
	NumberSequence = { "Keypoints" },
	ColorSequence = { "Keypoints" },
}

local function definition(motor)
	return tracks.is(motor) and motor.Definition or { kind = "CFrame" }
end

function sliders.channels(motor)
	return componentNames[definition(motor).kind] or {}
end

function sliders.value(motor, channel, original)
	local value = original
	if value == nil then
		value = (
			if tracks.is(motor) then tracks.readValue(motor.Rig, motor.PropertyId) else motor.C0
		)
	end
	local components = require("propertyValues").components(definition(motor).kind, value)
	return components[table.find(sliders.channels(motor), channel)]
end

function sliders.pose(motor, channel, value, original)
	local def = definition(motor)
	if original == nil then
		original = (
			if tracks.is(motor) then tracks.readValue(motor.Rig, motor.PropertyId) else motor.C0
		)
	end
	local components = require("propertyValues").components(def.kind, original)
	components[assert(table.find(sliders.channels(motor), channel), "Unknown slider component")] =
		value
	local result = require("propertyValues").compose(def, components)
	return tracks.encode(result), (if tracks.is(motor) then result else nil)
end

local function apply(motor, bucket, time)
	if not motor.Parent then
		return
	end
	local timeline = refs.State.Timeline
	timeline:_restoreMotorBucket(motor, bucket)
	for _, rig in refs.State.getAllRigs() do
		timeline:ApplyPoseAtTime(rig, time, { OnlyRig = true })
	end
	refs.State.currentProjectSaved = false
end

function sliders.begin(motor, channel)
	if not refs or not refs.Active() or edit.blocked() or drag then
		return false
	end
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	if raw.Playing or not motor.Parent or motor:GetAttribute("EclipseDisabled") then
		return false
	end
	if not table.find(sliders.channels(motor), channel) then
		return false
	end
	if require("layers").active(raw, motor).locked then
		return false
	end
	refs.Finalize()
	drag = {
		motor = motor,
		channel = channel,
		before = timeline:_snapshotMotorBucket(motor),
		time = raw.CurrentTime,
		frame = timeline:TimeToFrame(raw.CurrentTime),
		original = (if tracks.is(motor)
			then tracks.readValue(motor.Rig, motor.PropertyId)
			else motor.C0),
		changed = false,
	}
	return true
end

function sliders.change(value)
	if not drag or value == nil then
		return false
	end
	if typeof(value) == "number" and (value ~= value or math.abs(value) == math.huge) then
		return false
	end
	local d = drag
	if not d.motor.Parent then
		sliders.finish(true)
		return false
	end
	local ok, cf, property = pcall(sliders.pose, d.motor, d.channel, value, d.original)
	if not ok then
		return false
	end
	if tracks.is(d.motor) and not tracks.validate(d.motor, property) then
		return false
	end
	local timeline = refs.State.Timeline
	timeline:RecordKeyframeForMotorAtCurrentTime(
		d.motor.Part1,
		d.motor,
		cf,
		{ Frame = d.frame, PropertyValue = property },
		refs.State.UIHelpers.SanitizeName
	)
	for _, rig in refs.State.getAllRigs() do
		timeline:ApplyPoseAtTime(rig, d.time, { OnlyRig = true })
	end
	d.changed = true
	return true
end

function sliders.finish(cancel)
	local d = drag
	if not d then
		return
	end
	drag = nil
	if cancel or not d.changed then
		apply(d.motor, d.before, d.time)
		return
	end
	local after = refs.State.Timeline:_snapshotMotorBucket(d.motor)
	history.record(function()
		apply(d.motor, d.before, d.time)
	end, function()
		apply(d.motor, after, d.time)
	end, "Pose slider " .. d.channel, d.frame)
	refs.State.currentProjectSaved = false
end

function sliders.isEditing()
	return drag ~= nil
end

function sliders.set(motor, channel, value)
	if not sliders.begin(motor, channel) then
		return false
	end
	local ok, result = pcall(sliders.change, value)
	sliders.finish(not ok or not result)
	if not ok then
		error(result, 0)
	end
	return result
end

local function available(rig)
	local out, seen = {}, {}
	for _, item in refs.State.Rig._orderedItems or {} do
		local motor = item:fetchMotor()
		if
			motor
			and motor.Parent
			and not seen[motor]
			and (not rig or owner(motor) == rig)
			and #sliders.channels(motor) > 0
		then
			seen[motor] = true
			table.insert(out, { motor = motor, label = item.centerDiv.Title.Text })
		end
	end
	for _, object in refs.State.getAllRigs() do
		if not rig or rig == object then
			local existing = {}
			for _, motor in tracks.list(object, true) do
				existing[motor.PropertyId] = motor
				if
					not seen[motor]
					and #sliders.channels(motor) > 0
					and not motor:GetAttribute("EclipseDisabled")
				then
					seen[motor] = true
					table.insert(
						out,
						{ motor = motor, label = object.Name .. " . " .. motor.Definition.label }
					)
				end
			end
			for _, def in tracks.catalog(object) do
				if
					componentNames[def.kind]
					and (not existing[def.id] or existing[def.id]:GetAttribute("EclipseDisabled"))
				then
					table.insert(
						out,
						{
							object = object,
							property = def.id,
							label = object.Name .. " . " .. def.label,
						}
					)
				end
			end
		end
	end
	table.sort(out, function(a, b)
		return a.label < b.label
	end)
	return out
end

sliders.available = available

function sliders.add(motor)
	local project = refs and refs.State.currentRig
	if not project then
		return false
	end
	for _, entry in available() do
		if
			entry.motor == motor
			or typeof(motor) == "table"
				and motor.object == entry.object
				and motor.property == entry.property
				and entry.object
		then
			if entry.object then
				motor = tracks.enable(
					entry.object,
					entry.property,
					true,
					refs.State.Timeline:GetState()
				)
				refs.State.currentProjectSaved = false
				if refs.RefreshStructure then
					refs.RefreshStructure()
				end
			end
			chosen[project] = chosen[project] or {}
			chosen[project][motor] = true
			return true
		end
	end
	return false
end

function sliders.members()
	return refs and table.clone(chosen[refs.State.currentRig] or {}) or {}
end

function sliders.removeAll()
	local project = refs and refs.State.currentRig
	if not project then
		return
	end
	sliders.finish(true)
	table.clear(chosen[project] or {})
	if window and window.rebuild then
		window.rebuild()
	end
end

function sliders.focus(motor)
	for _, view in { pose = window, face = faceWindow } do
		if view and view.focus then
			view.focus(motor)
		end
	end
end

function sliders.open(rig)
	if not refs or not refs.Active() then
		return
	end
	local facial = rig ~= nil
	if not facial then
		require("viewportSelection").apply({}, "replace")
		game:GetService("Selection"):Set({})
	end
	if facial and not tracks.faceControls(rig) then
		return
	end
	local previous = facial and faceWindow or window
	if facial and previous and previous.rig == rig then
		return previous
	end
	if previous then
		previous:close(true)
	end
	local view
	view = tool.new(
		refs,
		facial and "EclipseFaceControls" or "EclipsePoseSliders",
		facial and "DYNAMIC HEAD" or "POSE SLIDERS",
		Vector2.new(480, 440),
		true,
		function()
			sliders.finish(true)
			if facial then
				faceWindow = nil
			else
				window = nil
			end
		end,
		{ Resizable = true, MinSize = Vector2.new(390, 240) }
	)
	view.rig = rig
	if facial then
		faceWindow = view
	else
		window = view
	end
	local frame = view.frame
	frame.MinimumSize.MinSize = Vector2.new(390, 240)
	local project = refs.State.currentRig
	if not project then
		view:close(true)
		return
	end
	chosen[project] = chosen[project] or {}
	local members = chosen[project]
	local filter =
		tool.field(frame, "Filter", "", UDim2.fromOffset(12, 36), UDim2.new(1, -24, 0, 25))
	filter.PlaceholderText = facial and "Filter expressions" or "Filter pose sliders"
	local top = facial and 70 or 104
	local list = tool.make(
		"ScrollingFrame",
		frame,
		"Controls",
		{
			Position = UDim2.fromOffset(12, top),
			Size = UDim2.new(1, -24, 1, -top - 12),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 4,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}
	)
	local rows, picker = {}, nil
	local function selectMotor(motor)
		for _, item in refs.State.Rig._orderedItems or {} do
			if item:fetchMotor() == motor then
				require("viewportSelection").apply({ item }, "replace")
				return
			end
		end
	end
	local function updateFilter()
		local query = filter.Text:lower():gsub("%s", "")
		for _, row in rows do
			row.frame.Visible = query == "" or row.search:find(query, 1, true) ~= nil
		end
	end
	local function refresh()
		for _, row in rows do
			if row.motor.Parent and not row.field:IsFocused() then
				local value = sliders.value(row.motor, row.channel)
				row.field.Text = typeof(value) == "number" and string.format("%.3f", value)
					or tostring(value)
				if typeof(value) ~= "number" then
					continue
				end
				local t = math.clamp((value - row.low) / (row.high - row.low), 0, 1)
				row.knob.Position = UDim2.fromScale(t, 0.5)
				row.fill.Size = UDim2.fromScale(t, 1)
			end
		end
	end
	local rebuild
	rebuild = function()
		if picker then
			picker:Destroy()
			picker = nil
		end
		sliders.finish(true)
		list:ClearAllChildren()
		table.clear(rows)
		tool.make(
			"UIListLayout",
			list,
			"Rows",
			{ Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }
		)
		local entries = {}
		if facial then
			for _, motor in tracks.list(rig) do
				if motor.Definition.facial then
					table.insert(entries, { motor = motor, label = motor.Definition.label })
				end
			end
		else
			for _, entry in available() do
				if members[entry.motor] then
					table.insert(entries, entry)
				end
			end
		end
		if #entries == 0 then
			tool.label(
				list,
				"Empty",
				"Add a bone or property to begin.",
				UDim2.new(),
				UDim2.new(1, 0, 0, 30)
			)
		end
		for _, entry in entries do
			local motor = entry.motor
			for _, channel in sliders.channels(motor) do
				local row = tool.make(
					"Frame",
					list,
					"Slider",
					{
						Size = UDim2.new(1, -7, 0, 26),
						BackgroundTransparency = 1,
						LayoutOrder = #rows * 2 + 1,
					}
				)
				local text = facial and entry.label:gsub("(%l)(%u)", "%1 %2")
					or channel == "Value" and entry.label
					or (entry.label .. " . " .. channel)
				local name = tool.make(
					"TextButton",
					row,
					"Name",
					{
						Text = text,
						Size = UDim2.new(0.4, -5, 1, 0),
						BackgroundTransparency = 1,
						TextSize = 11,
						FontFace = require("chrome").FONT,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
					}
				)
				name:SetAttribute("ThemeTxt", "Txt")
				name.Activated:Connect(function()
					selectMotor(motor)
				end)
				local right = facial and 0 or 24
				local field = tool.field(
					row,
					"Number",
					"0",
					UDim2.new(1, -65 - right, 0, 1),
					UDim2.fromOffset(65, 24)
				)
				local reset = tool.make(
					"ImageButton",
					row,
					"Reset",
					{
						Position = UDim2.new(1, -89 - right, 0, 4),
						Size = UDim2.fromOffset(18, 18),
						Image = resetValue,
						BackgroundTransparency = 1,
					}
				)
				reset:SetAttribute("ThemeImg", "Txt")
				if not facial then
					local remove = tool.make(
						"ImageButton",
						row,
						"Remove",
						{
							Position = UDim2.new(1, -20, 0, 4),
							Size = UDim2.fromOffset(18, 18),
							Image = "",
							BackgroundTransparency = 1,
						}
					)
					require("libraryIcons").dynamic(remove, "trash")
					remove.Activated:Connect(function()
						members[motor] = nil
						rebuild()
					end)
				end
				local slider = tool.make(
					"TextButton",
					row,
					"Slider",
					{
						Text = "",
						Position = UDim2.new(0.4, 0, 0, 0),
						Size = UDim2.new(0.6, -103 - right, 1, 0),
						BackgroundTransparency = 1,
						AutoButtonColor = false,
					}
				)
				local rail = tool.make(
					"Frame",
					slider,
					"Rail",
					{
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromScale(0.5, 0.5),
						Size = UDim2.new(1, -16, 0, 3),
						BorderSizePixel = 0,
					}
				)
				rail:SetAttribute("ThemeBg", "Strk")
				local fill = tool.make(
					"Frame",
					rail,
					"Fill",
					{ Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }
				)
				fill:SetAttribute("ThemeBg", "KeySel")
				local knob = tool.make(
					"Frame",
					rail,
					"Handle",
					{
						AnchorPoint = Vector2.new(0.5, 0.5),
						Size = UDim2.fromOffset(6, 12),
						Position = UDim2.fromScale(0, 0.5),
						BorderSizePixel = 0,
					}
				)
				knob:SetAttribute("ThemeBg", "Txt")
				tool.make("UICorner", knob, "Round", { CornerRadius = UDim.new(0, 2) })
				local value = sliders.value(motor, channel)
				local face = tracks.is(motor) and motor.Definition.facial
				local width = channel:sub(1, 1) == "R" and 180 or 10
				local numeric = typeof(value) == "number"
				local color = definition(motor).kind == "Color3"
				local low, high =
					face and 0 or color and 0 or numeric and value - width or 0,
					face and 1 or color and 255 or numeric and value + width or 1
				if not numeric then
					slider.Visible = false
					field.Position = UDim2.new(0.4, 0, 0, 1)
					field.Size = UDim2.new(0.6, -30 - right, 0, 24)
					reset.Position = UDim2.new(1, -24 - right, 0, 4)
				end
				local data = {
					frame = row,
					field = field,
					motor = motor,
					channel = channel,
					search = (entry.label .. channel):lower():gsub("%s", ""),
					low = low,
					high = high,
					knob = knob,
					fill = fill,
				}
				table.insert(rows, data)
				local function commit(v)
					local ok, err = pcall(sliders.set, motor, channel, v)
					if not ok then
						require("notification").show("POSE SLIDERS", tostring(err))
					end
					refresh()
				end
				if numeric then
					require("numericInput").connect(
						field,
						{
							step = face and 0.01 or color and 1 or 0.1,
							min = (face or color) and 0 or nil,
							max = face and 1 or color and 255 or nil,
						},
						function()
							commit(tonumber(field.Text))
						end
					)
				else
					field.FocusLost:Connect(function()
						local text = field.Text
						if definition(motor).kind == "boolean" then
							if text:lower() == "true" or text == "1" then
								commit(true)
							elseif text:lower() == "false" or text == "0" then
								commit(false)
							else
								refresh()
							end
						else
							commit(text)
						end
					end)
				end
				reset.Activated:Connect(function()
					local rest = refs.State.Timeline:GetState().DefaultPose[motor] or motor.C0
					if face then
						commit(0)
					else
						commit(
							sliders.value(
								motor,
								channel,
								(if tracks.is(motor) then motor.DefaultValue else rest)
							)
						)
					end
				end)
				local function move(x)
					sliders.change(
						low
							+ math.clamp(
									(x - rail.AbsolutePosition.X) / math.max(1, rail.AbsoluteSize.X),
									0,
									1
								)
								* (high - low)
					)
					refresh()
				end
				slider.InputBegan:Connect(function(input)
					if
						input.UserInputType == Enum.UserInputType.MouseButton1
						and sliders.begin(motor, channel)
					then
						drag.move = move
						move(input.Position.X)
					end
				end)
			end
		end
		theme.applyTree(frame)
		updateFilter()
		refresh()
	end
	if not facial then
		tool.button(
			frame,
			"Add",
			"+ ADD",
			UDim2.fromOffset(12, 69),
			UDim2.new(1 / 3, -12, 0, 26),
			function()
				if picker then
					picker:Destroy()
					picker = nil
					return
				end
				picker = tool.make(
					"Frame",
					frame,
					"ChooseTrack",
					{
						Position = UDim2.fromOffset(12, 101),
						Size = UDim2.new(1, -24, 1, -113),
						BackgroundTransparency = 0,
						BorderSizePixel = 0,
						ZIndex = 30,
					}
				)
				picker:SetAttribute("ThemeBg", "Bg")
				local search = tool.field(
					picker,
					"Search",
					"",
					UDim2.fromOffset(6, 6),
					UDim2.new(1, -12, 0, 26)
				)
				search.PlaceholderText = "Search bones and properties"
				local choices = tool.make(
					"ScrollingFrame",
					picker,
					"Tracks",
					{
						Position = UDim2.fromOffset(6, 38),
						Size = UDim2.new(1, -12, 1, -44),
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						ScrollBarThickness = 4,
						CanvasSize = UDim2.new(),
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						ZIndex = 31,
					}
				)
				tool.make(
					"UIListLayout",
					choices,
					"Rows",
					{ Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }
				)
				local buttons = {}
				for index, entry in available() do
					if members[entry.motor] then
						continue
					end
					local b = tool.button(
						choices,
						"Track",
						entry.label,
						UDim2.new(),
						UDim2.new(1, -6, 0, 26),
						function()
							sliders.add(entry.motor or entry)
							picker:Destroy()
							picker = nil
							rebuild()
						end
					)
					b.LayoutOrder = index
					buttons[b] = entry.label:lower():gsub("%s", "")
				end
				search:GetPropertyChangedSignal("Text"):Connect(function()
					local query = search.Text:lower():gsub("%s", "")
					for button, label in buttons do
						button.Visible = label:find(query, 1, true) ~= nil
					end
					choices.CanvasPosition = Vector2.zero
				end)
				theme.applyTree(picker)
				search:CaptureFocus()
			end
		)
		tool.button(
			frame,
			"AddAll",
			"ADD ALL",
			UDim2.new(1 / 3, 6, 0, 69),
			UDim2.new(1 / 3, -12, 0, 26),
			function()
				for _, entry in available() do
					sliders.add(entry.motor or entry)
				end
				rebuild()
			end
		)
	end
	if not facial then
		tool.button(
			frame,
			"RemoveAll",
			"REMOVE ALL",
			UDim2.new(2 / 3, 0, 0, 69),
			UDim2.new(1 / 3, -12, 0, 26),
			sliders.removeAll
		)
	end
	view.rebuild = rebuild
	view.focus = function(motor)
		for _, row in rows do
			if row.motor == motor then
				if not row.frame.Visible then
					filter.Text = ""
					updateFilter()
				end
				task.defer(function()
					if not row.frame.Parent or not list.Parent then
						return
					end
					local scale = math.max(0.01, row.frame.AbsoluteSize.Y / row.frame.Size.Y.Offset)
					local y = (row.frame.AbsolutePosition.Y - list.AbsolutePosition.Y) / scale
						+ list.CanvasPosition.Y
					list.CanvasPosition = Vector2.new(
						0,
						math.clamp(
							y,
							0,
							math.max(
								0,
								(list.AbsoluteCanvasSize.Y - list.AbsoluteWindowSize.Y) / scale
							)
						)
					)
				end)
				return true
			end
		end
		return false
	end
	local lastSelected
	filter:GetPropertyChangedSignal("Text"):Connect(updateFilter)
	local elapsed = 0
	table.insert(
		view.connections,
		game:GetService("RunService").Heartbeat:Connect(function(dt)
			if
				not refs.Active()
				or refs.State.currentRig ~= project
				or facial and not rig.Parent
			then
				view:close(true)
				return
			end
			elapsed += dt
			if elapsed > 0.1 then
				elapsed = 0
				refresh()
				local item = refs.State.Rig._lastClickedItem
				if item ~= lastSelected then
					lastSelected = item
					if item then
						view.focus(item:fetchMotor())
					end
				end
			end
		end)
	)
	rebuild()
	return view
end

function sliders.toggleFace(rig)
	if faceWindow and faceWindow.rig == rig then
		faceWindow:close()
	else
		return sliders.open(rig)
	end
end

function sliders.toggle()
	if window then
		window:close()
	else
		sliders.open()
	end
end

function sliders.close()
	sliders.finish(true)
	if window then
		window:close(true)
	end
	if faceWindow then
		faceWindow:close(true)
	end
end

function sliders.init(options)
	sliders.close()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	refs = options
	options.State.PoseSliders = sliders
	local function connect(signal, callback)
		table.insert(connections, signal:Connect(callback))
	end
	local function destroy()
		sliders.close()
		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)
	end
	connect(inputModule.InputChanged, function(input)
		if drag and drag.move and input.UserInputType == Enum.UserInputType.MouseMovement then
			drag.move(input.Position.X)
		end
	end)
	connect(inputModule.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			sliders.finish(false)
		end
	end)
	connect(inputModule.InputBegan, function(input)
		if input.KeyCode == Enum.KeyCode.Escape then
			sliders.finish(true)
		end
	end)
	connect(game:GetService("UserInputService").WindowFocusReleased, function()
		sliders.finish(false)
	end)
	connect(options.Plugin.Unloading, destroy)
	connect(options.ScreenGui.Destroying, destroy)
end

return sliders
]]></ProtectedString>
						<string name="ScriptGuid">{DEEC86A3-1D2E-4644-923C-1995E30913FD}</string>
