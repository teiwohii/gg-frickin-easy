				<Item class="ModuleScript" referent="RBXA198AFFB8D3A48FE8519175F51547A81">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local tracks, theme, tool = require("properties"), require("theme"), require("tool")
local handles = {}
local refs, folder, connection
local rigs = {}
local clear
local groups = { "Brows", "Eyes", "Mouth", "Jaw", "Tongue", "Other" }

function handles.group(motor)
	local name = motor.Definition.label:lower()
	if name:find("brow") or name:find("corrugator") then
		return "Brows"
	end
	if name:find("eye") or name:find("lid") then
		return "Eyes"
	end
	if name:find("tongue") then
		return "Tongue"
	end
	if name:find("jaw") or name:find("chin") then
		return "Jaw"
	end
	if
		name:find("lip")
		or name:find("mouth")
		or name:find("smile")
		or name:find("frown")
		or name:find("pucker")
		or name:find("dimpler")
	then
		return "Mouth"
	end
	return "Other"
end

function handles.enabled(rig)
	local found = false
	for _, motor in tracks.list(rig, true) do
		if motor.Definition.facial then
			found = true
			if
				motor:GetAttribute("EclipseDisabled")
				or not require("organization").getOwnEnabled(motor.Part1, true)
			then
				return false
			end
		end
	end
	return found
end

function handles.setEnabled(rig, value)
	local keys = {}
	for _, motor in tracks.list(rig, true) do
		if motor.Definition.facial then
			table.insert(keys, motor.Part1)
		end
	end
	require("organization").setOwnEnabled(keys, value)
end

function handles.visible(rig)
	return rig:GetAttribute("EclipseFaceHandlesVisible") ~= false
end
function handles.setVisible(rig, value)
	rig:SetAttribute("EclipseFaceHandlesVisible", value)
	if not value then
		clear(rig, false)
	else
		handles.refresh()
	end
end

function handles.select(motor)
	if not refs or not motor.Parent or require("blenderEdit").blocked() then
		return false
	end
	for _, item in refs.State.Rig._orderedItems or {} do
		if item:fetchMotor() == motor then
			require("viewportSelection").apply({ item }, "replace")
			if refs.State.PoseSliders then
				refs.State.PoseSliders.focus(motor)
			end
			return true
		end
	end
	return false
end

function handles.hit(point)
	if typeof(point) ~= "Vector2" then
		return
	end
	for _, record in rigs do
		if not record.gui.Enabled then
			continue
		end
		for _, handle in record.handles do
			local button = handle.visual
			local p, size = button.AbsolutePosition, button.AbsoluteSize
			local a, b = record.list.AbsolutePosition, record.list.AbsoluteSize
			if
				button.Visible
				and point.X >= p.X
				and point.X <= p.X + size.X
				and point.Y >= p.Y
				and point.Y <= p.Y + size.Y
				and point.Y >= a.Y
				and point.Y <= a.Y + b.Y
			then
				return handle
			end
		end
	end
end

function handles.input()
	return false
end

clear = function(rig, immediate)
	local record = rigs[rig]
	if record then
		rigs[rig] = nil
		record.window:close(immediate ~= false)
	end
end

function handles.chooseGroup(rig, group)
	local record = rigs[rig]
	if not record or not table.find(groups, group) then
		return false
	end
	record.group = group
	for _, handle in record.handles do
		handle.visual.Visible = handles.group(handle.motor) == group
	end
	for name, button in record.buttons do
		button:SetAttribute("ThemeBg", name == group and "MenuSel" or "TopBtn")
	end
	record.list.CanvasPosition = Vector2.zero
	theme.applyTree(record.gui)
	return true
end

function handles.refresh()
	if not refs or not refs.State.Rig then
		return
	end
	local active = refs.Active() and not refs.State.PresentationHidden
	local item = refs.State.Rig._lastClickedItem
	local selected = item and item:fetchMotor()
	local present = {}
	for _, rig in refs.State.getAllRigs() do
		present[rig] = true
		local face = tracks.faceControls(rig)
		local head = face and face:FindFirstAncestorWhichIsA("BasePart")
		local record = rigs[rig]
		if
			record
			and (
				not active
				or not handles.visible(rig)
				or record.face ~= face
				or record.head ~= head
			)
		then
			clear(rig)
			record = nil
		end
		if head and not record and active and handles.visible(rig) then
			local window = tool.new(
				refs,
				"DynamicHeadControls",
				"FACE CONTROLS",
				Vector2.new(260, 350),
				false,
				function()
					if rigs[rig] then
						rigs[rig] = nil
						rig:SetAttribute("EclipseFaceHandlesVisible", false)
					end
				end,
				{
					BeforeOpen = function(panel, gui)
						local animator = refs.AnimatorFrame
						if not animator then
							return
						end
						local scale = require("motion").scale(panel)
						local origin = panel.Parent:IsA("GuiBase2d")
								and panel.Parent.AbsolutePosition
							or Vector2.zero
						local position, bounds = animator.AbsolutePosition, animator.AbsoluteSize
						local size = panel.AbsoluteSize
						local viewport = gui.AbsoluteSize
						local x, y = position.X + bounds.X + 12 * scale, position.Y
						if x + size.X > viewport.X then
							x = position.X - size.X - 12 * scale
						end
						if x < 0 then
							x, y = position.X, position.Y - size.Y - 12 * scale
						end
						x = math.clamp(x, 8, math.max(8, viewport.X - size.X - 8))
						y = math.clamp(y, 8, math.max(8, viewport.Y - size.Y - 8))
						panel.AnchorPoint = Vector2.new(0.5, 0.5)
						panel.Position = UDim2.fromOffset(
							(x + size.X * 0.5 - origin.X) / scale,
							(y + size.Y * 0.5 - origin.Y) / scale
						)
					end,
				}
			)
			local gui, panel = window.gui, window.frame
			local divider = tool.make(
				"Frame",
				panel,
				"Divider",
				{
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, 0, 0, 108),
					Size = UDim2.new(1, -12, 0, 1),
					BorderSizePixel = 0,
				}
			)
			divider:SetAttribute("ThemeBg", "Div")
			local list = tool.make(
				"ScrollingFrame",
				panel,
				"Expressions",
				{
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, 0, 0.5, 54),
					Size = UDim2.new(1, -12, 1, -120),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ScrollBarThickness = 4,
					CanvasSize = UDim2.new(),
					AutomaticCanvasSize = Enum.AutomaticSize.Y,
				}
			)
			tool.make(
				"UIListLayout",
				list,
				"Rows",
				{ Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }
			)
			record = {
				window = window,
				face = face,
				head = head,
				gui = gui,
				list = list,
				handles = {},
				buttons = {},
			}
			rigs[rig] = record
			for index, group in groups do
				local b = tool.button(
					panel,
					group,
					group,
					UDim2.new(
						(index - 1) % 2 * 0.5,
						(index - 1) % 2 == 0 and 6 or 3,
						0,
						29 + math.floor((index - 1) / 2) * 26
					),
					UDim2.new(0.5, -9, 0, 23),
					function()
						handles.chooseGroup(rig, group)
					end
				)
				record.buttons[group] = b
			end
			for _, motor in tracks.list(rig) do
				if not motor.Definition.facial then
					continue
				end
				local b, text = tool.button(
					list,
					motor.Definition.label,
					motor.Definition.label:gsub("(%l)(%u)", "%1 %2"),
					UDim2.new(),
					UDim2.new(1, -6, 0, 24),
					function()
						handles.select(motor)
					end
				)
				text.TextXAlignment = Enum.TextXAlignment.Left
				text.AnchorPoint = Vector2.new(0.5, 0.5)
				text.Position = UDim2.new(0.5, 5, 0.5, 0)
				text.Size = UDim2.new(1, -22, 1, 0)
				b.BackgroundTransparency = 1
				b:SetAttribute("ThemeBgTransparency", 1)
				local accent = tool.make(
					"Frame",
					b,
					"SelectionMark",
					{
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.new(0, 3, 0.5, 0),
						Size = UDim2.fromOffset(2, 14),
						BorderSizePixel = 0,
						Visible = false,
					}
				)
				accent:SetAttribute("ThemeBg", "Txt")
				local line = tool.make(
					"Frame",
					b,
					"Divider",
					{
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.new(0.5, 0, 1, 0),
						Size = UDim2.new(1, -10, 0, 1),
						BorderSizePixel = 0,
						BackgroundTransparency = 0.65,
					}
				)
				line:SetAttribute("ThemeBg", "Div")
				line:SetAttribute("ThemeBgTransparency", 0.65)
				b.LayoutOrder = #record.handles
				table.insert(record.handles, { motor = motor, visual = b })
			end
			handles.chooseGroup(rig, "Eyes")
			require("userInputService").attachSurface(gui, { panel })
			if refs.RefreshStructure and not refs.State.LoadingProject then
				local found = false
				for _, row in refs.State.Rig._orderedItems or {} do
					if row.linkedRigInstance == face then
						found = true
						break
					end
				end
				if not found then
					task.defer(refs.RefreshStructure)
				end
			end
		end
		if record then
			record.gui.Enabled = active and handles.visible(rig)
			if record.selected ~= selected then
				record.selected = selected
				for _, handle in record.handles do
					local chosen = handle.motor == selected
					if chosen then
						handles.chooseGroup(rig, handles.group(handle.motor))
					end
					handle.visual:SetAttribute("ThemeBg", chosen and "MenuSel" or "TopBtn")
					handle.visual:SetAttribute("ThemeBgTransparency", chosen and 0.15 or 1)
					handle.visual.SelectionMark.Visible = chosen
					require("windowFx").setRestingProperty(
						handle.visual,
						"BackgroundTransparency",
						chosen and 0.15 or 1
					)
				end
				theme.applyTree(record.gui)
			end
		end
	end
	for rig in rigs do
		if not present[rig] then
			clear(rig)
		end
	end
end

function handles.destroy()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	for rig in rigs do
		clear(rig)
	end
	if folder then
		folder:Destroy()
		folder = nil
	end
	table.clear(rigs)
end

function handles.init(options)
	handles.destroy()
	refs = options
	refs.State.FaceHandles = handles
	folder = Instance.new("Folder")
	folder.Name = "EclipseDynamicHeadHandles"
	folder.Parent = game:GetService("CoreGui")
	local elapsed = 0
	connection = game:GetService("RunService").Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= 0.05 then
			elapsed = 0
			handles.refresh()
		end
	end)
	options.Plugin.Unloading:Once(handles.destroy)
	options.ScreenGui.Destroying:Once(handles.destroy)
end

return handles
]]></ProtectedString>
						<string name="ScriptGuid">{2DDCC749-F66D-4703-B78E-087400C7ACE6}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">faceHandles</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX80398DA701B042D6A61DB6D0905BC106">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local tracks = require("properties")
local layers = require("layers")
local history = require("history")
local api = {}
local refs, endpoint, registry
local connections = {}
local busy = false
local version = 7
local actions = {
	"Add",
	"AddObject",
	"ListTracks",
	"ListProperties",
	"Select",
	"SetKeyframe",
	"SetEasing",
	"GetCurrentFrame",
	"GetCurrentTime",
	"GetFPS",
	"SetCurrentFrame",
	"SetCurrentTime",
	"Batch",
	"BeginBatch",
	"EndBatch",
	"HistoryRecord",
	"RevertChanges",
	"CreateFolder",
	"RenameFolder",
	"GetFolder",
	"ListFolders",
	"MoveToFolder",
	"MoveToParent",
	"GetTimelineParent",
	"ListTimelineChildren",
	"Undo",
	"Redo",
	"GetHistoryState",
	"SetExpanded",
	"ForwardInput",
}
local edits = {
	Add = true,
	AddObject = true,
	SetKeyframe = true,
	SetEasing = true,
	CreateFolder = true,
	RenameFolder = true,
	MoveToFolder = true,
	MoveToParent = true,
	Batch = true,
}
local changeLimit = 256
local pending = {}
local pendingOrder = {}
local batch = nil
local refreshDepth = 0
local refreshPending = false

local function owner(motor)
	return tracks.is(motor) and motor.Rig or layers.owner(motor)
end

local function identity(motor)
	return tracks.is(motor) and motor.Rig or typeof(motor) == "Instance" and motor or motor.Part1
end

local function target(value)
	assert(
		typeof(value) == "Instance" and value ~= workspace and value:IsDescendantOf(workspace),
		"Target must be an instance in Workspace"
	)
	return value
end

local function rows(request)
	local found, seen = {}, {}
	request = table.clone(request)
	if request.Target then
		request.Target = require("rigPreview").localOf(request.Target)
	end
	for _, item in refs.State.Rig._orderedItems or {} do
		local motor = item:fetchMotor()
		if motor and motor.Parent and not seen[motor] then
			local property = tracks.is(motor) and motor.PropertyId or nil
			local match = not request.Target
				or identity(motor) == request.Target
				or motor.Part1 == request.Target
				or item.linkedRigInstance == request.Target
				or not request.Property and owner(motor) == request.Target
			if match and (not request.Property or property == request.Property) then
				seen[motor] = true
				table.insert(found, { item = item, motor = motor, property = property })
			end
		end
	end
	return found
end

local function easing(value)
	assert(typeof(value) == "table", "Easing must contain Style and optional Direction")
	local style = typeof(value.Style) == "EnumItem" and value.Style.Name or value.Style
	style = require("easing").styleName(style)
	local direction = typeof(value.Direction) == "EnumItem" and value.Direction.Name
		or value.Direction
		or "InOut"
	local found = style == "Bezier"
	for _, entry in require("easingStyles") do
		if require("easing").styleName(entry.Name) == style then
			found = true
		end
	end
	assert(found, "Unsupported easing style")
	assert(
		direction == "In" or direction == "Out" or direction == "InOut" or direction == "OutIn",
		"Unsupported easing direction"
	)
	return { EasingStyle = style, EasingDirection = direction }
end

local function refresh()
	if refreshDepth > 0 then
		refreshPending = true
		return
	end
	refreshPending = false
	local state = refs.State
	for _, rig in state.getAllRigs() do
		state.Timeline:ApplyPoseAtTime(
			rig,
			state.Timeline:GetState().CurrentTime,
			{ OnlyRig = true }
		)
	end
	state.Timeline:RefreshAllKeyframeVisuals()
	state.currentProjectSaved = false
end

local function edit(request, onlyEasing)
	target(request.Target)
	local found = rows(request)
	assert(#found == 1, "Choose one track from ListTracks; specify Property for property tracks")
	local motor = found[1].motor
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local frame = request.Frame
	assert(
		typeof(frame) == "number"
			and frame == frame
			and frame >= 0
			and frame <= 1000000
			and frame % 1 == 0,
		"Frame must be an integer from 0 to 1000000"
	)
	assert(not motor:GetAttribute("EclipseDisabled"), "Track is disabled")
	local layer = layers.active(raw, motor)
	assert(not layer.locked, "Active layer is locked")
	local curve = request.Easing and easing(request.Easing)
	assert(not onlyEasing or curve, "Easing is required")
	local value, cf = request.Value
	local valueSpace = request.ValueSpace or "LocalPose"
	assert(
		valueSpace == "LocalPose" or valueSpace == "BoneTransform",
		"ValueSpace must be LocalPose or BoneTransform"
	)
	local bone = typeof(motor) == "table" and rawget(motor, "_bone")
	assert(
		valueSpace ~= "BoneTransform" or bone and bone:IsA("Bone") and not motor.IsEclipseR6Control,
		"BoneTransform requires a native Bone track"
	)
	if not onlyEasing then
		if value == nil then
			value = valueSpace == "BoneTransform" and bone.Transform
				or tracks.is(motor) and tracks.readValue(motor.Rig, motor.PropertyId)
				or motor.C0
		end
		if tracks.is(motor) then
			assert(tracks.validate(motor, value), "Invalid value for this property")
			local keyframes = raw.Keyframes
			tracks.prepare(motor, value)
			assert(
				refs.State.Timeline == timeline
					and raw.Keyframes == keyframes
					and motor.Parent
					and layers.active(raw, motor) == layer
					and not layer.locked
					and not motor:GetAttribute("EclipseDisabled"),
				"Timeline changed while preparing the property; retry the request"
			)
			cf = tracks.encode(value)
		else
			assert(typeof(value) == "CFrame", "Transform track Value must be a local CFrame")
			for _, component in { value:GetComponents() } do
				assert(
					component == component and math.abs(component) < math.huge,
					"CFrame must contain finite numbers"
				)
			end
			cf = valueSpace == "BoneTransform" and bone.CFrame * value or value
		end
	end
	local bucket = timeline:GetMotorKeyframeBucket(motor)
	assert(not onlyEasing or bucket and bucket[frame], "No keyframe at the requested frame")
	refs.Finalize()
	local before = timeline:_snapshotMotorBucket(motor)
	local function restore(snapshot)
		layers.history(layer.id, function()
			timeline:_restoreMotorBucket(motor, snapshot)
			refresh()
		end)
	end
	local ok, issue = xpcall(function()
		if not onlyEasing then
			timeline:RecordKeyframeForMotorAtCurrentTime(
				motor.Part1,
				motor,
				cf,
				{ Frame = frame, PropertyValue = tracks.is(motor) and value or nil },
				refs.State.UIHelpers.SanitizeName
			)
		end
		bucket = timeline:GetMotorKeyframeBucket(motor)
		local key = bucket and bucket[frame]
		assert(key, "Keyframe could not be created")
		if curve then
			require("channelEasing").editAll(key, function(draft)
				draft.EasingStyle, draft.EasingDirection = curve.EasingStyle, curve.EasingDirection
				draft.MoonEasing = nil
			end, bucket)
			require("graphCurves").invalidate(bucket)
		end
		refresh()
	end, debug.traceback)
	if not ok then
		restore(before)
		error(issue, 0)
	end
	local after = timeline:_snapshotMotorBucket(motor)
	history.record(function()
		restore(before)
	end, function()
		restore(after)
	end, onlyEasing and "API easing" or "API keyframe", frame)
	return { Target = identity(motor), Property = found[1].property, Frame = frame }
end

local function clean(message)
	return (tostring(message):gsub("^.-:%d+: ", ""))
end

local function label(value, fallback)
	if value == nil then
		return fallback
	end
	assert(
		typeof(value) == "string" and #value > 0 and #value <= 100,
		"Name must be a string of 1 to 100 characters"
	)
	return value
end

local function placed(object)
	return require("rigPreview").localOf(object)
end

local function onTimeline(object)
	return table.find(refs.State.getAllRigs(), object) ~= nil
end

local function captured(fn)
	local entries = {}
	local ok, result = pcall(history.capture, entries, fn)
	if not ok then
		local reverted, issue = pcall(history.revertGroup, entries)
		if not reverted then
			warn("Eclipse API could not roll back a failed request:", issue)
		end
		error(result, 0)
	end
	return entries, result
end

local function commit(name, entries)
	local entry = history.commitGroup(name, entries)
	if batch and entry then
		table.insert(batch.entries, entry)
	end
end

local function remember(entries)
	if #entries == 0 then
		return nil
	end
	local id = game:GetService("HttpService"):GenerateGUID(false)
	pending[id] = { entries = entries, generation = history.generation() }
	table.insert(pendingOrder, id)
	while #pendingOrder > changeLimit do
		pending[table.remove(pendingOrder, 1)] = nil
	end
	return id
end

local function take(request)
	local ids = request.Changes or { request.Change }
	assert(
		typeof(ids) == "table" and #ids > 0,
		"Changes must list Change ids returned by edits made with Record = false"
	)
	local found, seen = {}, {}
	for _, id in ids do
		local change = pending[id]
		assert(change and not seen[id], "Unknown or already used Change id: " .. tostring(id))
		assert(
			change.generation == history.generation(),
			"Change " .. tostring(id) .. " belongs to a project that is no longer open"
		)
		seen[id] = true
		table.insert(found, change)
	end
	for id in seen do
		pending[id] = nil
		table.remove(pendingOrder, table.find(pendingOrder, id))
	end
	return found
end

local function property(object, name)
	assert(typeof(name) == "string" and name ~= "", "Property names must be non-empty strings")
	if tracks.definition(object, name) then
		return name
	end
	local hint = ""
	for _, def in tracks.catalog(object) do
		if def.id:lower() == name:lower() then
			hint = ' Did you mean "' .. def.id .. '"?'
			break
		end
	end
	error(
		object.ClassName
			.. ' does not support a "'
			.. name
			.. '" property track.'
			.. hint
			.. " Use ListProperties to see supported properties.",
		0
	)
end

local function addObject(request)
	local object = target(request.Target)
	local names = request.Properties or {}
	assert(
		typeof(names) == "table" and #names <= 200,
		"Properties must be a list of property names"
	)
	assert(
		object:IsA("Model") or object:IsA("BasePart") or #tracks.catalog(object) > 0,
		"Unsupported timeline object"
	)
	local wanted, list = {}, {}
	for _, name in names do
		if not wanted[property(object, name)] then
			wanted[name] = true
			table.insert(list, name)
		end
	end
	local fresh = tracks.propertyOnly(object) and #tracks.list(placed(object), true, true) == 0
	local entries, result = captured(function()
		local rig = placed(object)
		local added = false
		if not onTimeline(rig) then
			assert(
				refs.AddRig(object, { AllowDuplicateName = true }),
				"Object could not be added to the timeline"
			)
			rig = placed(object)
			assert(onTimeline(rig), "Object could not be added to the timeline")
			added = true
		end
		local settings = require("propertySettings")
		for _, name in list do
			if not tracks.enabled(rig, name) then
				settings.setEnabled(rig, name, true)
			end
		end
		local first = added and fresh and #list > 0 and tracks.catalog(rig)[1]
		if first and not wanted[first.id] and tracks.enabled(rig, first.id) then
			settings.setEnabled(rig, first.id, false)
		end
		return { Target = rig, Added = added, Properties = list }
	end)
	history.commitGroup("API add object", entries)
	return result
end

local function organizationKey(value, allowRoot)
	if allowRoot and (value == nil or value == false) then
		return nil
	end
	local organization = require("organization")
	if typeof(value) == "string" then
		assert(organization.isFolder(value), "Unknown timeline folder Id")
		return value
	end
	local object = placed(target(value))
	for _, children in organization.childIndex() do
		if table.find(children, object) then
			return object
		end
	end
	error("Target is not an available timeline item; add it to the timeline first", 0)
end

local function folderId(value)
	assert(
		typeof(value) == "string" and require("organization").isFolder(value),
		"Folder must be an existing timeline folder Id"
	)
	return value
end

local function folderName(value)
	local name = label(value, nil)
	assert(name, "Name is required")
	local trimmed = name:match("^%s*(.-)%s*$")
	assert(trimmed ~= "", "Folder Name cannot be blank")
	return trimmed
end

local function folderInfo(id)
	local organization = require("organization")
	local folder = organization.get(id)
	local children = {}
	for _, key in organization.children(id) do
		table.insert(
			children,
			organization.isFolder(key)
					and { Type = "Folder", Id = key, Name = organization.get(key).name }
				or { Type = "Object", Target = key, Name = key.Name }
		)
	end
	return {
		Id = id,
		Name = folder.name,
		Parent = organization.parent(id) or false,
		Enabled = folder.enabled ~= false,
		Children = children,
	}
end

local function timelineQuery(action, request)
	local organization = require("organization")
	if action == "GetTimelineParent" then
		local key = organizationKey(request.Target, false)
		return { Target = key, Parent = organization.parent(key) or false }
	end
	local parent = organizationKey(request.Parent, true)
	local children = {}
	for index, key in organization.children(parent) do
		table.insert(children, organization.isFolder(key) and {
			Type = "Folder",
			Id = key,
			Name = organization.get(key).name,
			Index = index,
		} or { Type = "Object", Target = key, Name = key.Name, Index = index })
	end
	return children
end

local function historyState()
	local stats = history.getStats()
	local count = 0
	for _, change in pending do
		if change.generation == history.generation() then
			count += 1
		end
	end
	return {
		CanUndo = history.canUndo(),
		CanRedo = history.canRedo(),
		UndoCount = stats.undo,
		RedoCount = stats.redo,
		PendingChanges = count,
		Batching = batch ~= nil and batch.generation == history.generation(),
	}
end

local function folderAction(action, request)
	local organization = require("organization")
	if action == "GetFolder" then
		return folderInfo(folderId(request.Folder))
	elseif action == "ListFolders" then
		local parent = request.Parent ~= nil and organizationKey(request.Parent, true) or nil
		local result = {}
		for id in organization.snapshot().folders do
			if request.Parent == nil or organization.parent(id) == parent then
				table.insert(result, folderInfo(id))
			end
		end
		table.sort(result, function(a, b)
			return a.Name == b.Name and a.Id < b.Id or a.Name < b.Name
		end)
		return result
	end
	local parent, name, id, keys, index
	if action == "CreateFolder" then
		parent = organizationKey(request.Parent, true)
		name = request.Name ~= nil and folderName(request.Name) or nil
	elseif action == "RenameFolder" then
		id, name = folderId(request.Folder), folderName(request.Name)
	else
		if action == "MoveToParent" then
			assert(request.Parent ~= nil, "Parent is required; use false for the timeline root")
			parent = organizationKey(request.Parent, true)
		else
			parent = request.Folder ~= nil and request.Folder ~= false and folderId(request.Folder)
				or nil
		end
		local values = request.Targets or { request.Target }
		assert(
			typeof(values) == "table" and #values > 0 and #values <= 1000,
			"Targets must contain 1 to 1000 timeline objects or folder Ids"
		)
		index = request.Index
		assert(
			index == nil
				or typeof(index) == "number"
					and index == index
					and index >= 1
					and index <= 1000000
					and index % 1 == 0,
			"Index must be a positive integer"
		)
		keys = {}
		local seen = {}
		for _, value in values do
			local key = organizationKey(value, false)
			if not seen[key] then
				seen[key] = true
				table.insert(keys, key)
			end
			local ancestor = parent
			while ancestor do
				assert(
					ancestor ~= key,
					"A timeline item cannot be moved into itself or its descendants"
				)
				ancestor = organization.parent(ancestor)
			end
		end
		local top = {}
		for _, key in keys do
			local ancestor, carried = organization.parent(key), false
			while ancestor do
				if seen[ancestor] then
					carried = true
					break
				end
				ancestor = organization.parent(ancestor)
			end
			if not carried then
				table.insert(top, key)
			end
		end
		keys = top
	end
	refs.Finalize()
	local entries, result = captured(function()
		if action == "CreateFolder" then
			id = organization.create(parent)
			assert(id, "Folder could not be created here")
			if name then
				organization.rename(id, name)
			end
			return folderInfo(id)
		elseif action == "RenameFolder" then
			local changed = organization.rename(id, name)
			local info = folderInfo(id)
			info.Changed = changed
			return info
		end
		local changed = organization.move(keys, parent, index)
		for _, key in keys do
			assert(
				organization.parent(key) == parent,
				"Tracks could not be moved to this timeline parent"
			)
		end
		local result = { Targets = table.clone(keys), Parent = parent or false, Changed = changed }
		if action == "MoveToFolder" then
			result.Folder = parent or false
		end
		return result
	end)
	history.commitGroup("API " .. action, entries)
	if #entries > 0 then
		refs.State.currentProjectSaved = false
	end
	return result
end

local function perform(action, request)
	if
		action == "CreateFolder"
		or action == "RenameFolder"
		or action == "GetFolder"
		or action == "ListFolders"
		or action == "MoveToFolder"
		or action == "MoveToParent"
	then
		return folderAction(action, request)
	elseif action == "Add" then
		local object = target(request.Target)
		assert(
			object:IsA("Model") or object:IsA("BasePart") or #tracks.catalog(object) > 0,
			"Unsupported timeline object"
		)
		for _, rig in refs.State.getAllRigs() do
			if rig == object then
				return { Target = object }
			end
		end
		assert(
			refs.AddRig(object, { AllowDuplicateName = true }),
			"Object could not be added to the timeline"
		)
		return { Target = object }
	elseif action == "AddObject" then
		return addObject(request)
	elseif action == "ListTracks" then
		if request.Target then
			target(request.Target)
		end
		local result = {}
		for _, row in rows(request) do
			table.insert(result, {
				Target = identity(row.motor),
				Property = row.property,
				Name = row.item.centerDiv.Title.Text,
				Rig = owner(row.motor),
			})
		end
		return result
	elseif action == "ListProperties" then
		local rig = placed(target(request.Target))
		local enabled = {}
		if onTimeline(rig) then
			for _, motor in tracks.list(rig) do
				enabled[motor.PropertyId] = true
			end
		end
		local result = {}
		for _, def in tracks.catalog(rig) do
			table.insert(result, {
				Property = def.id,
				Label = def.label,
				Kind = def.kind,
				Enabled = enabled[def.id] == true,
			})
		end
		return result
	elseif action == "Select" then
		target(request.Target)
		local found = rows(request)
		assert(#found > 0, "Target has no timeline tracks")
		local selected = {}
		for _, row in found do
			table.insert(selected, row.item)
		end
		require("viewportSelection").apply(selected, "replace")
		return { Count = #selected }
	elseif action == "SetKeyframe" then
		return edit(request, false)
	elseif action == "SetEasing" then
		return edit(request, true)
	elseif action == "Batch" then
		local name = label(request.Name, "API batch")
		local steps = request.Actions
		assert(
			typeof(steps) == "table" and #steps > 0 and #steps <= 1000,
			"Actions must be a list of 1 to 1000 { Action = string, Request = table } steps"
		)
		refreshDepth += 1
		local completed, entries, results = pcall(captured, function()
			local out = {}
			local function runStep(index)
				local step = steps[index]
				assert(
					typeof(step) == "table" and edits[step.Action] and step.Action ~= "Batch",
					"Batch step "
						.. tostring(index)
						.. " must be an edit action (Add, AddObject, SetKeyframe, SetEasing, CreateFolder, RenameFolder, MoveToFolder or MoveToParent)"
				)
				assert(
					step.Request == nil or typeof(step.Request) == "table",
					"Batch step " .. tostring(index) .. " Request must be a table"
				)
				local ok, value = pcall(perform, step.Action, step.Request or {})
				if not ok then
					error(
						"Batch step "
							.. tostring(index)
							.. " ("
							.. step.Action
							.. ") failed: "
							.. clean(value),
						0
					)
				end
				out[index] = value
			end
			local index = 1
			local function addsObject(step)
				return typeof(step) == "table" and (step.Action == "Add" or step.Action == "AddObject")
			end
			while index <= #steps do
				if addsObject(steps[index]) then
					-- Rebuild before the next edit so newly added tracks can be resolved.
					require("project").batchStructure(function()
						repeat
							runStep(index)
							index += 1
						until not addsObject(steps[index])
					end)
				else
					runStep(index)
					index += 1
				end
			end
			return out
		end)
		refreshDepth -= 1
		if refreshPending then
			refresh()
		end
		if not completed then
			error(entries, 0)
		end
		history.commitGroup(name, entries)
		return { Name = name, Results = results }
	end
	error("Unknown API action: " .. tostring(action), 0)
end

local function dispatch(action, request)
	assert(refs, "Eclipse API is closed")
	if action == "GetInfo" then
		return {
			Version = version,
			Build = require("pluginShell").ReleaseVersion,
			Active = refs.Active(),
			Actions = table.clone(actions),
			ValueSpaces = { "LocalPose", "BoneTransform" },
			Batching = batch ~= nil,
		}
	end
	assert(typeof(request) == "table", "Request must be a table")
	if action == "EndBatch" then
		assert(batch, "No batch is open; call BeginBatch first")
		local open = batch
		batch = nil
		local merged = open.generation == history.generation()
			and history.merge(open.name, open.entries)
		return { Name = open.name, Edits = #open.entries, UndoSteps = merged and 1 or #open.entries }
	end
	assert(
		refs.Active() and refs.State.Rig and refs.State.Timeline,
		"Open an animation in Eclipse first"
	)
	if action == "GetCurrentFrame" or action == "GetCurrentTime" or action == "GetFPS" then
		local timeline = refs.State.Timeline
		local raw = timeline:GetState()
		return {
			Frame = timeline:TimeToFrame(raw.CurrentTime),
			Time = raw.CurrentTime,
			FPS = raw.FPS,
		}
	end
	if action == "GetHistoryState" then
		return historyState()
	end
	if action == "GetTimelineParent" or action == "ListTimelineChildren" then
		return timelineQuery(action, request)
	end
	if action == "GetFolder" or action == "ListFolders" then
		return perform(action, request)
	end
	if batch and batch.generation ~= history.generation() then
		batch = nil
	end
	assert(
		not require("blenderEdit").blocked() and not refs.State.Timeline:IsExportLocked(),
		"Eclipse is busy"
	)
	if action == "SetExpanded" then
		assert(typeof(request.Expanded) == "boolean", "Expanded must be true or false")
		assert(
			request.Recursive == nil or typeof(request.Recursive) == "boolean",
			"Recursive must be true or false"
		)
		local key = organizationKey(request.Target or request.Folder, false)
		local row
		for _, item in refs.State.Rig._organizationItems or {} do
			if
				(item.organizationKey or item.linkedRigInstance) == key
				and item:hasExpandableChildren()
			then
				row = item
				break
			end
		end
		assert(row, "Target has no expandable timeline row")
		local count = 0
		local function apply(item)
			if item:hasExpandableChildren() then
				item:setOpenState(request.Expanded)
				count += 1
			end
			if request.Recursive then
				for _, child in item.childItems or {} do
					apply(child)
				end
			end
		end
		apply(row)
		return { Target = key, Expanded = row.openedState, Count = count }
	elseif action == "ForwardInput" then
		assert(not batch, "Call EndBatch before forwarding input")
		local key = typeof(request.Key) == "EnumItem" and request.Key
			or Enum.KeyCode[request.Key or "Unknown"]
		assert(
			key and key.EnumType == Enum.KeyCode and key ~= Enum.KeyCode.Unknown,
			"Key must be a keyboard KeyCode name"
		)
		local modifiers = {}
		assert(
			request.Modifiers == nil or typeof(request.Modifiers) == "table",
			"Modifiers must be a list"
		)
		for _, name in request.Modifiers or {} do
			assert(
				name == "Ctrl" or name == "Shift" or name == "Alt" or name == "Meta",
				"Unknown modifier"
			)
			modifiers[name] = true
		end
		local input = { KeyCode = key, UserInputType = Enum.UserInputType.Keyboard }
		function input:IsModifierKeyDown(modifier)
			return modifiers[modifier.Name] == true
		end
		return { Handled = require("keybinds").forwardInput(input) }
	end
	if action == "Undo" or action == "Redo" then
		assert(not batch, "Call EndBatch before Undo or Redo")
		assert(
			historyState().PendingChanges == 0,
			"Call HistoryRecord or RevertChanges for pending Record = false edits before Undo or Redo"
		)
		refs.Finalize()
		local changed, description = (action == "Undo" and history.undo or history.redo)()
		local result = historyState()
		result.Changed, result.Description = changed == true, description
		result.Delegated = changed == nil
		return result
	end
	assert(not refs.State.Timeline:GetState().Playing, "Pause playback before editing")
	if action == "SetCurrentFrame" or action == "SetCurrentTime" then
		local timeline = refs.State.Timeline
		local value = if action == "SetCurrentFrame" then request.Frame else request.Time
		assert(typeof(value) == "number" and value == value and value >= 0 and value < math.huge,
			"Frame or Time must be a finite, non-negative number")
		if action == "SetCurrentFrame" then
			assert(value % 1 == 0 and value <= 1000000, "Frame must be an integer from 0 to 1000000")
			value = timeline:FrameToTime(value)
		else
			assert(value <= timeline:FrameToTime(1000000), "Time exceeds 1000000 frames")
		end
		refs.Finalize()
		timeline:SeekToTime(value, function() return refs.State.currentRig end)
		local raw = timeline:GetState()
		return { Frame = timeline:TimeToFrame(raw.CurrentTime), Time = raw.CurrentTime, FPS = raw.FPS }
	end
	if action == "BeginBatch" then
		assert(
			not batch or batch.generation ~= history.generation(),
			"A batch is already open; call EndBatch first"
		)
		batch = {
			name = label(request.Name, "API batch"),
			entries = {},
			generation = history.generation(),
		}
		return { Name = batch.name }
	elseif action == "HistoryRecord" then
		local name = label(request.Name, "API edit")
		local changes = take(request)
		local entries = {}
		for _, change in changes do
			table.move(change.entries, 1, #change.entries, #entries + 1, entries)
		end
		commit(name, entries)
		return { Name = name, Count = #changes }
	elseif action == "RevertChanges" then
		local changes = take(request)
		for index = #changes, 1, -1 do
			history.revertGroup(changes[index].entries)
		end
		return { Count = #changes }
	end
	if edits[action] then
		assert(
			request.Record == nil or typeof(request.Record) == "boolean",
			"Record must be true or false"
		)
		if request.Record == false or batch then
			local entries, result = captured(function()
				return perform(action, request)
			end)
			if request.Record == false then
				result.Change = remember(entries)
			else
				commit(
					typeof(request.Name) == "string" and request.Name or "API " .. action,
					entries
				)
			end
			return result
		end
	end
	return perform(action, request)
end

function api.invoke(action, request)
	if busy then
		return { ok = false, error = "An Eclipse API request is already running" }
	end
	busy = true
	local ok, result = pcall(dispatch, action, request or {})
	busy = false
	return ok and { ok = true, result = result }
		or { ok = false, error = tostring(result):gsub("^.-:%d+: ", "") }
end

function api.destroy()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	if endpoint then
		endpoint:Destroy()
		endpoint = nil
	end
	batch = nil
	table.clear(pending)
	table.clear(pendingOrder)
	if registry and registry.Parent and #registry:GetChildren() == 0 then
		registry:Destroy()
	end
	registry, refs = nil, nil
end

function api.init(options)
	api.destroy()
	refs = options
	local core = game:GetService("CoreGui")
	registry = core:FindFirstChild("EclipseAnimatorAPI")
	if not registry then
		registry = Instance.new("Folder")
		registry.Name = "EclipseAnimatorAPI"
		registry.Parent = core
	end
	endpoint = Instance.new("BindableFunction")
	endpoint.Name = "Session-"
		.. tostring(
			options.ScreenGui:GetAttribute("EclipseInstance")
				or game:GetService("HttpService"):GenerateGUID(false)
		)
	endpoint:SetAttribute("APIVersion", version)
	endpoint.OnInvoke = api.invoke
	endpoint.Parent = registry
	table.insert(connections, options.ScreenGui.Destroying:Connect(api.destroy))
	table.insert(connections, options.Plugin.Unloading:Connect(api.destroy))
end

return api
]]></ProtectedString>
