							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)
local Drawer = require(script.Parent.Drawer)
local TextureSprite = require(script.Parent.TextureSprite)

local TextureDrawer = Drawer.extend()

TextureDrawer.title = "Texture"
TextureDrawer.titles = { Mesh = "Mesh Flipbook" }
TextureDrawer.backdropText = "Backdrop: %s"
TextureDrawer.favouriteText = "Favourite"
TextureDrawer.favouritedText = "Favourited"
TextureDrawer.insertText = "Insert"
TextureDrawer.replaceText = "Replace"
TextureDrawer.backdrops = {
	{ name = "Dark", color = Color3.fromRGB(0, 0, 0), transparency = 0.5 },
	{ name = "Grey", color = Color3.fromRGB(128, 128, 128), transparency = 0 },
	{ name = "Light", color = Color3.fromRGB(236, 236, 236), transparency = 0 },
}

function TextureDrawer.new(frame: Frame, root: GuiObject, group: { any }, parts)
	local self = setmetatable({}, TextureDrawer)

	Drawer.init(self, frame, root, group, frame.Header.CloseTexture)

	self.catalog = parts.catalog
	self.marks = parts.marks
	self.inserters = parts.inserters
	self.player = parts.player
	self.preview = frame.Preview
	self.sprite = TextureSprite.new(frame.Preview)
	self.titleLabel = frame.Header.Title
	self.nameLabel = frame.TextureName
	self.kindLabel = frame.Kind
	self.infoLabel = frame.Info
	self.idBox = frame.AssetId
	self.targetLabel = frame.Target
	self.backdropButton = frame.Options.TextureBackdrop
	self.favouriteButton = frame.Options.FavouriteTexture
	self.insertButton = frame.Actions.InsertTexture
	self.insertNewButton = frame.Actions.InsertNewTexture
	self.entry = nil
	self.backdrop = 1
	self.actions = {}

	self:bind()
	self:applyBackdrop()

	return self
end

function TextureDrawer:bind()
	self:connect(self.insertButton.Activated, function()
		self:run("activate")
	end)

	self:connect(self.insertNewButton.Activated, function()
		self:run("insert")
	end)

	self:connect(self.favouriteButton.Activated, function()
		self:run("favourite")
	end)

	self:connect(self.backdropButton.Activated, function()
		self.backdrop = self.backdrop % #TextureDrawer.backdrops + 1
		self:applyBackdrop()
	end)

	self:connect(self.idBox.Focused, function()
		self.idBox.SelectionStart = 1
		self.idBox.CursorPosition = #self.idBox.Text + 1
	end)
end

function TextureDrawer:setActions(actions)
	self.actions = actions
end

function TextureDrawer:run(name: string)
	local action = self.actions[name]

	if action and self.entry then
		action(self.entry)
	end
end

function TextureDrawer:getEntry()
	return self.entry
end

function TextureDrawer:getInserter()
	return if self.entry then self.inserters[self.entry.kind] else nil
end

function TextureDrawer:getSprite()
	return self.sprite
end

function TextureDrawer:getBackdrop()
	return TextureDrawer.backdrops[self.backdrop]
end

function TextureDrawer:applyBackdrop()
	local backdrop = self:getBackdrop()

	self.preview.BackgroundColor3 = backdrop.color
	self.preview.BackgroundTransparency = backdrop.transparency
	self.backdropButton.Label.Text = string.format(TextureDrawer.backdropText, backdrop.name)
end

function TextureDrawer:refreshDetails()
	local entry = self.entry

	if not entry then
		return
	end

	local catalog = self.catalog
	local colors = configuration.Colors

	self.titleLabel.Text = TextureDrawer.titles[entry.kind] or TextureDrawer.title
	self.nameLabel.Text = entry.name
	self.kindLabel.Text = string.upper(catalog:describe(entry))
	self.kindLabel:SetAttribute("ThemeBg", if entry.frames > 1 then "MenuSel" else "Pnl")
	self.kindLabel.BackgroundColor3 = if entry.frames > 1 then colors.Light else colors.Tertiary
	self.infoLabel.Text = table.concat(catalog:getDetails(entry), "\n")
	self.idBox.Text = catalog:getIdText(entry)
end

function TextureDrawer:refresh()
	local entry = self.entry

	if not entry or not self:isOpen() then
		return
	end

	local colors = configuration.Colors
	local favourite = self.marks:isFavourite(entry.key)
	local inserter = self:getInserter()
	local replacing = inserter:isReplacing()

	self.favouriteButton:SetAttribute("ThemeBg", if favourite then "MenuSel" else "TopBtn")
	self.favouriteButton.BackgroundColor3 = if favourite then colors.Light else colors.Dark
	self.favouriteButton.Label.Text = if favourite then TextureDrawer.favouritedText else TextureDrawer.favouriteText
	self.insertButton.Label.Text = if replacing then TextureDrawer.replaceText else TextureDrawer.insertText
	self.insertNewButton.Visible = replacing
	self.targetLabel.Text = inserter:getTargetText()
end

function TextureDrawer:open(entry)
	self.entry = entry
	self:show(entry.key)
	self.sprite:setEntry(entry)
	self.player:play(self.sprite)
	self:refreshDetails()
	self:refresh()
end

function TextureDrawer:close()
	self.player:stop(self.sprite)
	self:hide()
end

function TextureDrawer:destroy()
	self.actions = {}
	Drawer.destroy(self)
	self.sprite:setEntry(nil)
	self.entry = nil
end

return TextureDrawer
]]></ProtectedString>
							<string name="ScriptGuid">{7DA0EF10-47A4-445B-B2DC-64AC436A6F25}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">TextureDrawer</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX36FD85912CE24B149227A1DB178FB6EC">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)
local TextureSprite = require(script.Parent.TextureSprite)

local TextureBrowser = {}
TextureBrowser.__index = TextureBrowser

TextureBrowser.tabName = "Textures"
TextureBrowser.columns = 5
TextureBrowser.cellWidth = 65
TextureBrowser.cellHeight = 80
TextureBrowser.thumbHeight = 65
TextureBrowser.gap = 4
TextureBrowser.overscanRows = 1
TextureBrowser.fallbackRows = 5
TextureBrowser.maximumLabel = 13
TextureBrowser.ellipsis = "..."
TextureBrowser.allGroups = "All Groups"
TextureBrowser.menuWidth = 160
TextureBrowser.groupMenuHeight = 320
TextureBrowser.tipText = "%s  (%s)"
TextureBrowser.insertText = "Insert"
TextureBrowser.insertNewText = "Insert New"
TextureBrowser.badgeText = "> %s"
TextureBrowser.badgeWidth = 34
TextureBrowser.badgeHeight = 11
TextureBrowser.badgeWidths = { Mesh = 40 }
TextureBrowser.searchText = "Search %d textures"
TextureBrowser.defaultFilter = "All"
TextureBrowser.favouritesFilter = "Favourites"
TextureBrowser.recentFilter = "Recent"

TextureBrowser.filters = {
	{ id = "All", button = "ShowAll" },
	{ id = "Static", button = "ShowStatic", kind = "Static" },
	{ id = "Flipbook", button = "ShowFlipbooks", kind = "Flipbook" },
	{ id = "Mesh", button = "ShowMesh", kind = "Mesh" },
	{ id = "Favourites", button = "ShowFavourites" },
	{ id = "Recent", button = "ShowRecent" },
}

TextureBrowser.emptyTexts = {
	none = "No textures match.",
	Favourites = "No favourites yet. Right-click a texture, or press Favourite in its preview.",
	Recent = "Textures you insert are listed here.",
}

function TextureBrowser.new(page: Frame, templates: Instance, context, parts)
	local self = setmetatable({}, TextureBrowser)

	self.page = page
	self.search = page.Search
	self.countLabel = page.Count
	self.groupButton = page.TextureGroup
	self.filterBar = page.Filters
	self.grid = page.Grid
	self.empty = page.Empty
	self.cellTemplate = templates.TextureCell
	self.context = context
	self.catalog = parts.catalog
	self.marks = parts.marks
	self.inserters = parts.inserters
	self.player = parts.player
	self.drawer = parts.drawer
	self.cells = {}
	self.results = {}
	self.connections = {}
	self.filterId = TextureBrowser.defaultFilter
	self.group = nil
	self.query = ""
	self.selectedKey = nil
	self.hovered = nil
	self.lastKey = nil
	self.lastClickTime = 0
	self.shown = false
	self.tabActive = false

	self.search.PlaceholderText = string.format(TextureBrowser.searchText, self.catalog:getCount())

	self:bind()
	self:refresh()

	return self
end

function TextureBrowser:connect(signal: RBXScriptSignal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function TextureBrowser:bind()
	self:connect(self.search:GetPropertyChangedSignal("Text"), function()
		local query = string.gsub(self.search.Text, "^%s*(.-)%s*$", "%1")

		if query ~= self.query then
			self.query = query
			self:refresh()
		end
	end)

	self:connect(self.groupButton.Activated, function()
		self:openGroupMenu()
	end)

	for _, definition in TextureBrowser.filters do
		self:connect(self.filterBar[definition.button].Activated, function()
			self:setFilter(definition.id)
		end)
	end

	self:connect(self.grid:GetPropertyChangedSignal("CanvasPosition"), function()
		self:layout()
	end)

	self:connect(self.grid:GetPropertyChangedSignal("AbsoluteWindowSize"), function()
		self:layout()
	end)

	self.marks:addChangedHandler(function(change)
		self:onMarksChanged(change)
	end)

	self.drawer:setActions({
		activate = function(entry)
			self:activate(entry)
		end,
		insert = function(entry)
			self:insert(entry)
		end,
		favourite = function(entry)
			self.marks:toggleFavourite(entry.key)
		end,
	})
end

function TextureBrowser:getFilter(id: string)
	for _, definition in TextureBrowser.filters do
		if definition.id == id then
			return definition
		end
	end

	return TextureBrowser.filters[1]
end

function TextureBrowser:getInserter(entry)
	return self.inserters[entry.kind]
end

function TextureBrowser:getResults()
	return self.results
end

function TextureBrowser:getSelected()
	return if self.selectedKey then self.catalog:get(self.selectedKey) else nil
end

function TextureBrowser:setFilter(id: string)
	local definition = self:getFilter(id)

	if self.filterId == definition.id then
		return
	end

	self.filterId = definition.id
	self:refresh()
end

function TextureBrowser:setGroup(group: string?)
	if self.group == group then
		return
	end

	self.group = group
	self:refresh()
end

function TextureBrowser:setQuery(query: string)
	self.search.Text = query
end

function TextureBrowser:openGroupMenu()
	local items = {
		{
			text = TextureBrowser.allGroups,
			checked = self.group == nil,
			callback = function()
				self:setGroup(nil)
			end,
		},
		{ separator = true },
	}

	for _, group in self.catalog:getGroups() do
		table.insert(items, {
			text = group,
			checked = self.group == group,
			callback = function()
				self:setGroup(group)
			end,
		})
	end

	self.context.menu:toggle({
		anchor = self.groupButton,
		items = items,
		width = TextureBrowser.menuWidth,
		maximumHeight = TextureBrowser.groupMenuHeight,
		search = false,
	})
end

function TextureBrowser:openContextMenu(entry)
	local inserter = self:getInserter(entry)
	local replacing = inserter:isReplacing()
	local items = {
		{
			text = if replacing then inserter.menuTexts.replace else TextureBrowser.insertText,
			callback = function()
				self:activate(entry)
			end,
		},
	}

	if replacing then
		table.insert(items, {
			text = TextureBrowser.insertNewText,
			callback = function()
				self:insert(entry)
			end,
		})
	end

	table.insert(items, { separator = true })

	table.insert(items, {
		text = "Favourite",
		checked = self.marks:isFavourite(entry.key),
		callback = function()
			self.marks:toggleFavourite(entry.key)
		end,
	})

	table.insert(items, {
		text = "Show " .. entry.group,
		callback = function()
			self:setGroup(entry.group)
		end,
	})

	self.context.menu:open({
		position = userInputService:GetMouseLocation(),
		width = TextureBrowser.menuWidth,
		search = false,
		items = items,
	})
end

function TextureBrowser:buildResults()
	local definition = self:getFilter(self.filterId)
	local filter = {
		kind = definition.kind,
		group = self.group,
		tokens = self.catalog:tokenize(self.query),
	}

	if definition.id == TextureBrowser.recentFilter then
		return self.catalog:filter(filter, self.catalog:resolve(self.marks:getRecent()))
	elseif definition.id == TextureBrowser.favouritesFilter then
		filter.keys = self.marks:getFavourites()
	end

	return self.catalog:filter(filter)
end

function TextureBrowser:getEmptyText(): string
	local texts = TextureBrowser.emptyTexts

	if self.query == "" and self.group == nil and texts[self.filterId] then
		return texts[self.filterId]
	end

	return texts.none
end

function TextureBrowser:refresh()
	local colors = configuration.Colors

	self.results = self:buildResults()

	for _, definition in TextureBrowser.filters do
		local button = self.filterBar[definition.button]

		button:SetAttribute("ThemeBg", if definition.id == self.filterId then "MenuSel" else "TopBtn")
		button.BackgroundColor3 = if definition.id == self.filterId then colors.Light else colors.Dark
	end

	local rows = math.ceil(#self.results / self:getColumns())
	local height = math.max(0, rows * (self:getCellWidth() + 15 + TextureBrowser.gap) - TextureBrowser.gap)

	self.groupButton.Label.Text = self.group or TextureBrowser.allGroups
	self.countLabel.Text = tostring(#self.results)
	self.empty.Text = self:getEmptyText()
	self.empty.Visible = #self.results == 0
	self.grid.CanvasSize = UDim2.fromOffset(0, height)
	self.grid.CanvasPosition = Vector2.zero
	self:layout()
end

function TextureBrowser:getLabel(entry): string
	local limit = TextureBrowser.maximumLabel

	if #entry.name <= limit then
		return entry.name
	end

	if entry.number <= 0 then
		local start = string.gsub(string.sub(entry.name, 1, limit - 1), "%s+$", "")

		return start .. TextureBrowser.ellipsis
	end

	local suffix = " " .. entry.number
	local head = string.gsub(string.sub(entry.family, 1, math.max(1, limit - #suffix - 1)), "%s+$", "")

	return head .. TextureBrowser.ellipsis .. suffix
end

function TextureBrowser:createCell()
	local button = self.cellTemplate:Clone()
	local cell = {
		button = button,
		sprite = TextureSprite.new(button.Thumb, true),
		entry = nil,
		connections = {},
	}

	button.Visible = false
	button.Parent = self.grid

	table.insert(cell.connections, button.Activated:Connect(function()
		self:onActivated(cell)
	end))

	table.insert(cell.connections, button.MouseButton2Click:Connect(function()
		if cell.entry then
			self:select(cell.entry, false)
			self:openContextMenu(cell.entry)
		end
	end))

	table.insert(cell.connections, button.MouseEnter:Connect(function()
		self:setHovered(cell)
	end))

	table.insert(cell.connections, button.MouseLeave:Connect(function()
		if self.hovered == cell then
			self:setHovered(nil)
		end
	end))

	table.insert(self.cells, cell)

	return cell
end

function TextureBrowser:getCellWidth(): number
	local columns = self:getColumns()
	return math.max(1, (self.grid.AbsoluteWindowSize.X / math.max(self.context.getScale(), 0.001) - TextureBrowser.gap * (columns - 1)) / columns)
end

function TextureBrowser:getColumns(): number
	local width = self.grid.AbsoluteWindowSize.X / math.max(self.context.getScale(), 0.001)
	return math.clamp(math.floor((width + TextureBrowser.gap) / (TextureBrowser.cellWidth + TextureBrowser.gap)), 1, TextureBrowser.columns)
end

function TextureBrowser:getVisibleRows(): number
	local scale = self.context.getScale()
	local view = self.grid.AbsoluteWindowSize.Y / scale

	if view <= 0 then
		return TextureBrowser.fallbackRows
	end

	return math.ceil(view / (self:getCellWidth() + 15 + TextureBrowser.gap)) + TextureBrowser.overscanRows
end

function TextureBrowser:ensureCells(count: number)
	while #self.cells < count do
		self:createCell()
	end
end

function TextureBrowser:styleCell(cell)
	local entry = cell.entry
	local button = cell.button

	if not entry then
		return
	end

	button.Star.Visible = self.marks:isFavourite(entry.key)
	button.SelectedOutline.Visible = entry.key == self.selectedKey
	button.HoverOutline.Visible = self.hovered == cell and entry.key ~= self.selectedKey
end

function TextureBrowser:isActive(): boolean
	return self.shown and self.tabActive
end

function TextureBrowser:setPlaying(cell, playing: boolean)
	local sprite = cell.sprite

	if playing and sprite:isAnimated() then
		if not self.player:isPlaying(sprite) then
			self.player:play(sprite)
		end
	else
		self.player:stop(sprite)
	end
end

function TextureBrowser:assign(cell, entry, index: number, playing: boolean)
	local button = cell.button
	local columns = self:getColumns()
	local width = self:getCellWidth()
	button.Size = UDim2.fromOffset(width, width + 15)
	for _, name in { "Thumb", "HoverOutline", "SelectedOutline" } do
		local thumb = button:FindFirstChild(name)
		if thumb then thumb.Size = UDim2.fromOffset(width, width) end
	end
	button.Label.Position = UDim2.fromOffset(0, width + 1)
	local column = (index - 1) % columns
	local row = math.floor((index - 1) / columns)

	button.Position = UDim2.fromOffset(
		column * (width + TextureBrowser.gap),
		row * (self:getCellWidth() + 15 + TextureBrowser.gap)
	)

	if cell.entry ~= entry then
		self.player:stop(cell.sprite)
		cell.entry = entry
		cell.sprite:setEntry(entry)
		button.Label.Text = self:getLabel(entry)
		button.Badge.Visible = entry.frames > 1
		button.Badge.Text = string.format(TextureBrowser.badgeText, self.catalog:getBadgeText(entry))
		button.Badge.Size = UDim2.fromOffset(TextureBrowser.badgeWidths[entry.kind] or TextureBrowser.badgeWidth, TextureBrowser.badgeHeight)

		if self.hovered == cell then
			self:showHover(cell)
		end
	end

	self:styleCell(cell)
	self:setPlaying(cell, playing)
	button.Visible = true
end

function TextureBrowser:release(cell)
	if not cell.button.Visible and not cell.entry then
		return
	end

	if self.hovered == cell then
		self:setHovered(nil)
	end

	self.player:stop(cell.sprite)
	cell.button.Visible = false
	cell.entry = nil
	cell.sprite:setEntry(nil)
end

function TextureBrowser:layout()
	local columns = self:getColumns()
	local stride = self:getCellWidth() + 15 + TextureBrowser.gap
	local height = math.max(0, math.ceil(#self.results / columns) * stride - TextureBrowser.gap)
	local canvas = UDim2.fromOffset(0, height)
	if self.grid.CanvasSize ~= canvas then
		self.grid.CanvasSize = canvas
	end
	local scale = self.context.getScale()
	local visibleRows = self:getVisibleRows()
	local scroll = self.grid.CanvasPosition.Y / scale
	local view = self.grid.AbsoluteWindowSize.Y / scale
	local active = self:isActive()
	local firstRow = math.max(0, math.floor(scroll / stride))
	local first = firstRow * columns + 1
	local last = math.min(#self.results, (firstRow + visibleRows) * columns)

	self:ensureCells(visibleRows * columns)

	local pool = #self.cells
	local used = {}

	for index = first, last do
		local cell = self.cells[(index - 1) % pool + 1]

		local top = math.floor((index - 1) / columns) * stride
		local onScreen = active and top < scroll + view and top + self:getCellWidth() > scroll

		used[cell] = true
		self:assign(cell, self.results[index], index, onScreen)
	end

	for _, cell in self.cells do
		if not used[cell] then
			self:release(cell)
		end
	end
end

function TextureBrowser:restyle()
	for _, cell in self.cells do
		self:styleCell(cell)
	end
end

function TextureBrowser:showHover(cell)
	local entry = cell.entry
	local hover = self.context.hover

	if not entry then
		return
	end

	if hover then
		hover:showText(cell.button, string.format(TextureBrowser.tipText, entry.name, self.catalog:describe(entry)))
	end
end

function TextureBrowser:setDetail(cell, detailed: boolean)
	local sprite = cell.sprite

	if sprite:isLight() ~= detailed then
		return
	end

	sprite:setLight(not detailed)

	if self.player:isPlaying(sprite) then
		self.player:play(sprite)
	end
end

function TextureBrowser:setHovered(cell)
	local previous = self.hovered
	local hover = self.context.hover

	if previous == cell then
		return
	end

	self.hovered = cell

	if previous then
		self:setDetail(previous, false)
		self:styleCell(previous)

		if hover and hover.current == previous.button then
			hover:hide()
		end
	end

	if cell then
		self:setDetail(cell, true)
		self:showHover(cell)
		self:styleCell(cell)
	end
end

function TextureBrowser:select(entry, openDrawer: boolean?)
	self.selectedKey = entry.key
	self:restyle()

	if openDrawer ~= false or self.drawer:isOpen() then
		self.drawer:open(entry)
	end
end

function TextureBrowser:onActivated(cell)
	local entry = cell.entry

	if not entry then
		return
	end

	local now = os.clock()
	local isDouble = self.lastKey == entry.key and now - self.lastClickTime <= configuration.Create.doubleClickTime

	self.lastKey = entry.key
	self.lastClickTime = if isDouble then 0 else now
	self:select(entry)

	if isDouble then
		self:activate(entry)
	end
end

function TextureBrowser:insert(entry): { Instance }
	return self:getInserter(entry):insert(entry)
end

function TextureBrowser:activate(entry): number
	return self:getInserter(entry):activate(entry)
end

function TextureBrowser:onMarksChanged(change: string)
	if (change == self.marks.favouritesChanged and self.filterId == TextureBrowser.favouritesFilter)
		or (change == self.marks.recentChanged and self.filterId == TextureBrowser.recentFilter)
	then
		self:refresh()
	else
		self:restyle()
	end

	self.drawer:refresh()
end

function TextureBrowser:onSelectionChanged()
	self.drawer:refresh()
end

function TextureBrowser:onTabChanged(name: string)
	self.tabActive = name == TextureBrowser.tabName

	if not self.tabActive then
		self:setHovered(nil)
		self.drawer:close()
	end

	self:layout()
end

function TextureBrowser:start()
	self.shown = true
	self:layout()
end

function TextureBrowser:stop()
	self.shown = false
	self:setHovered(nil)
	self.player:stopAll()
end

function TextureBrowser:destroy()
	self:stop()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)

	for _, cell in self.cells do
		for _, connection in cell.connections do
			connection:Disconnect()
		end

		cell.button:Destroy()
	end

	table.clear(self.cells)
	table.clear(self.results)
end

return TextureBrowser
]]></ProtectedString>
