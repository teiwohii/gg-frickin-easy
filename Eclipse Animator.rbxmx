							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local studioService = game:GetService("StudioService")

local configuration = require(script.Parent.Parent.Utility.configuration)

local IconProvider = {}
IconProvider.__index = IconProvider

IconProvider.fallbackClass = "Part"

function IconProvider.new()
	local self = setmetatable({}, IconProvider)

	self.cache = {}

	return self
end

function IconProvider:getClassIcon(className: string)
	local cached = self.cache[className]

	if cached ~= nil then
		return cached or nil
	end

	local success, icon = pcall(function()
		return studioService:GetClassIcon(className)
	end)

	self.cache[className] = if success and icon then icon else false

	return if success then icon else nil
end

function IconProvider:applyClass(image: ImageLabel | ImageButton, className: string)
	local icon = self:getClassIcon(className) or self:getClassIcon(IconProvider.fallbackClass)

	if not icon then
		return
	end

	image.Image = icon.Image
	image.ImageRectOffset = icon.ImageRectOffset
	image.ImageRectSize = icon.ImageRectSize
end

function IconProvider:apply(image: ImageLabel | ImageButton, key: string?)
	if not key or key == "" then
		image.Image = ""
		return
	end

	local entry = configuration.Create.Icons[key]

	if entry and entry.image then
		image.Image = entry.image
		image.ImageRectOffset = Vector2.zero
		image.ImageRectSize = Vector2.zero
		return
	end

	self:applyClass(image, if entry and entry.class then entry.class else key)
end

function IconProvider:applyInstance(image: ImageLabel | ImageButton, instance: Instance)
	self:applyClass(image, instance.ClassName)
end

return IconProvider
]]></ProtectedString>
