					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local export = {}

function export.build(state, rigs, ids, current, lastFrame)
	local result = {Effects = {}}
	local yielded = os.clock()
	for _, model in rigs do
		if model:GetAttribute("EffectKind") ~= "Smear Frames" or not ids[model]
			or not require("organization").isEnabled(model) then continue end
		local target, owner = require("smearBinding").resolve(model, rigs)
		assert(target and owner, "Smear source is missing: " .. model.Name)
		local row = {Target = ids[model], Frames = {}}
		local settings = require("smearConfig").read(model)
		for frame = 0, lastFrame do
			current()
			local pose = require("smearSampler").capture(state, target, owner, frame, settings, model, lastFrame)
			if pose.Visibility > 0 and #require("smearGeometry").triangles(pose.Poses, pose.Size, pose.Width, pose.Strength, pose.Style) > 0 then
				row.Frames[tostring(frame)] = pose
			end
			if os.clock() - yielded > 0.008 then task.wait(); yielded = os.clock() end
			current()
		end
		table.insert(result.Effects, row)
	end
	return result
end

return export
]]></ProtectedString>
