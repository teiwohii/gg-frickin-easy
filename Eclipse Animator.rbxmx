						<Item class="ModuleScript" referent="RBX145AEC62A15148E7A06CF871B2B6C5FC">
							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
return {
	NewProject = "Click to start a new empty project, then add VFX with Effects > Presets or the + button. Select a project folder first to open it instead.",
	Setup = "Select VFX in Workspace, then click to set it up and create a project.",
	Export = "Export your VFX as a module to use in your game.",
	Save = "Save your project to continue working on it later.",
	Loop = "Loop the VFX animation.",
	Add = "Add new VFX to this project. Use this if you made or brought in more VFX after the project was created.",
	Reference = "Add a rig and use their animation to the timeline to act as a reference.",
	Effects = "Add screen and camera effects such as Lighting, Flash, Camera or Camera Shake to the timeline, or add a Sound.",
	Help = "Learn how Arc works and what every part of the plugin does.",
	Premium = "See your Arc Premium status and what Premium includes.",
	Tools = "Animation tools, grouped by kind: motion, keyframe tools, events, and import and sync.",
	ViewMenu = "Viewing and timeline tools: motion trails, the graph editor, markers, the loop region, pinning and project history.",
	LightingCategory = "Lighting, Color Correction and Blur.",
	ScreenCategory = "Effects drawn on the screen: Flash, Vignette and Impact Frames.",
	CameraCategory = "Camera moves and Camera Shake.",
	WorldCategory = "Debris and Sound.",
	MotionCategory = "Tools that write movement: paths, orbits, random motion and spins.",
	KeyframesCategory = "Tools that change existing keyframes: stagger, reverse, mirror, wiggle and fades.",
	ImportCategory = "Work with Moon Animator 2 and Forge projects.",
	SplinePath = "Premium. Move the selected objects through as many points as you like along one smooth curve. Set a point, move the scrubber and the object, and choose it again for each next point.",
	Orbit = "Premium. Send the selected objects around in a circle or spiral from the scrubber onwards, with radius, turns, rise and tilt you choose.",
	Stagger = "Premium. Offset the keyframes of the selected objects so each one starts a few frames after the last, for cascades and ripples.",
	ReverseMirror = "Premium. Play the selected keyframes backwards in time, or mirror their movement across the X, Y or Z axis.",
	Wiggle = "Premium. Add smooth or jittery random variation to any number property of the selection, such as Brightness, Transparency or Size.",
	MatchTiming = "Give the selected objects the same keyframe timing and easing as one of them, so they speed up and slow down together. Each keeps its own values.",
	ExplodeParts = "Premium. Blast the selected parts or models outward with gravity, spin, bouncing and collisions. Preview it, try other seeds, then bake it into keyframes.",
	Flicker = "Premium. Make the selected parts flicker: every few seconds their transparency changes to a set amount or a random one, snapping or easing with the style you pick.",
	CloneOverTime = "Premium. Spawn copies of the selected objects every few frames while they move, each fading out, like afterimages. The copies are made as children of the object.",
	SimplifyKeys = "Premium. Select a run of keyframes, such as one on every frame, and Arc removes the ones it does not need while the movement stays the same.",
	MotionTrails = "Premium. Show the path the selected objects travel as dots in the viewport. Larger white dots are keyframes. Choose it again to turn it off.",
	GraphEditor = "Premium. See the selected track's values as curves over time, and drag the keyframe points to change their value or timing.",
	AddMarker = "Premium. Put a named marker on the timeline at the scrubber. Click a marker to jump to it, right-click it to edit it, and press [ or ] to jump between markers.",
	LoopRegion = "Premium. Set a start and end frame so playback loops only that part of the timeline.",
	ProjectHistory = "Premium. Open earlier saved versions of this project and restore one. Versions are kept each time you save.",
	Origin = "VFX Origin\nThis is where your VFX spawns.",
	Blur = "Blur the whole screen. Key the Blur Size to fade it in and out.",
	MoonSync = "Link this project's timeline with the file open in Moon Animator 2. Play, stop and the scrubber stay in sync both ways. Click again to stop syncing.",
	ForgeConvert = "Convert a Forge project into an Arc project",
	Spin = "Spin the selected objects from the scrubber onwards. Writes the rotation keyframes for any number of turns, so the spin always goes the right way round.",
	Transparency = "Fade the selected objects in or out from the scrubber onwards. Writes the transparency keyframes for parts, particles, beams, trails, decals and highlights.",
	PointPath = "Premium. Move the selected objects from Point A to Point B along a smooth curve. Set Point A, move the scrubber and the object, then choose it again to set Point B.",
	RandomMotion = "Premium. Give the selected objects controlled random movement and rotation for a set length, using only two keyframes.",
	Pin = "Premium. Keep the selected objects at the top of the list so they are always within reach. Nothing is copied or moved in your VFX. Choose it again to unpin.",
	Events = "Add events to your animation that you can edit later in the exported module.",
	AssetMenu = "The asset you are building. Click to start a new one, open another, rename it or close it.",
	Animate = "Open this asset in the Animator to keyframe it. Nothing is rebuilt or converted.",
	CreateSettings = "Create settings: interface size, snapping and increments.",
	PresetsCategory = "Premium. Ready-made VFX from Arc. Pick one to add it at the project's origin, with emit keyframes on the current frame.",
	PlayerParticle = "Adds a particle emitter to this part of the Player.",
	PlayerAttachment = "Adds an attachment to this part of the Player. Use its + to put effects on it.",
	PlayerLight = "Adds a point light to this part of the Player.",
	PlayerTrail = "Adds a trail with two attachments to this part of the Player.",
	Player = "Select a character in the Workspace and click to copy it into the project as the Player. Then use the + on its body parts to add effects, and the animation button on the Player row to give it a reference animation (not exported).",
	Duplicate = "Copy the selected objects inside the project, right next to the originals, with all their keyframes. Change the copies however you like. Shortcut: Ctrl + D.",
	Dock = "Dock Create into a Studio panel you can move, resize and snap next to the Explorer or under the viewport. Press it again to float it over the viewport.",
	EmitModule = "Add the Arc emit module to Workspace. Require it in your game and call ArcEmit.emitOnce(effect) or ArcEmit.emitAt(effect, cframe) to play a VFX exactly like Create's Emit button.",
	CreateExit = "Close Create.",
	Group = "Put the selected objects in a folder.",
	NewAsset = "Start a new, empty VFX asset in front of the camera.",
	OpenAsset = "Open the selected Arc project, or turn the selected VFX into an asset.",
	InspectTab = "Edit the selected objects.",
	AddTab = "Add objects, procedural shapes and building blocks.",
	ToolsTab = "Tools that act on the selection: transform, align, array, randomize, resize, retime and recolor.",
	LibraryTab = "Your own library: VFX and sounds you saved, kept across every place and project.",
	LibraryCategory = "Show one of your categories, or add, rename and delete them. New items are saved into the category shown here.",
	TexturesTab = "Browse, preview and insert the built-in VFX textures.",
	TextureGroup = "Only show one group of textures.",
	MeshesTab = "Browse, preview and insert the built-in VFX meshes.",
	MeshGroup = "Only show one group of meshes.",
	ZoomTrack = "Drag to zoom the preview in or out.",
	ResetMeshView = "Put the preview back to its starting angle and zoom.",
	InsertMesh = "Add this mesh to the open asset, ready for VFX: anchored, no collisions, no shadow. Double-clicking a mesh in the list does the same.",
	ShowStatic = "Single image textures.",
	ShowFlipbooks = "Animated sprite sheets. They play in the list while they are on screen.",
	ShowMesh = "Mesh flipbooks: image sequences that play on a ready-made mesh. They play in the list, and in full when you hover one.",
	ShowFavourites = "Textures you marked as favourites.",
	ShowRecent = "Textures you inserted lately.",
	InsertTexture = "Insert adds a new ParticleEmitter with this texture to the selected Part, MeshPart, Model or Attachment. With a ParticleEmitter selected it becomes Replace and changes only that emitter's texture. Double-clicking a texture does the same. A mesh flipbook inserts a new mesh into the open asset instead, and with a decal or a flipbook mesh selected Replace swaps only its frames.",
	InsertNewTexture = "Add a new emitter or mesh with this texture instead of replacing the selected one.",
	FavouriteTexture = "Keep this texture in Favourites.",
	TextureBackdrop = "Change the colour behind the preview.",
	Emit = "Emit the burst emitters once, and play the flipbooks, lightning and sounds in scope.",
	Repeat = "Keep emitting on a timer.",
	ClearParticles = "Remove every live particle and stop repeating.",
	Scope = "What Emit and Clear act on.",
	Isolate = "Hide everything in the asset except the selection. Click again to show it all.",
	View = "Move the camera to a preset view of the selection.",
	SavePreset = "Save the selection to your library. A selection of only sounds is saved as a sound, anything else as VFX.",
	FitCurve = "Fit the graph height to the curve.",
	SmoothCurve = "Add points so the curve eases between its keys.",
	LinearCurve = "Remove points that barely change the curve.",
	SpreadGradient = "Space the colours evenly.",
}]]></ProtectedString>
