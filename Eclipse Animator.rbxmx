					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local blenderEdit = require("blenderEdit")
local timelineState = require("rawState").Timeline
local limbIk = require("limbIk")
local history = require("history")
local parenting = require("parenting")
local r6Controls = require("r6Controls")
local empty = table.freeze({})

return function(Timeline)
	function Timeline:GetIKEndKeys()
		return empty
	end

	function Timeline:GetIKEndMarkerButtons()
		return empty
	end

	function Timeline:RefreshIKEndMarkerPositions() end

	function Timeline:RefreshIKEndMarkers()
		for _, buttons in self._ikEndMarkers or {} do
			for _, button in buttons do
				button:Destroy()
			end
		end

		for key in self._ikEndCoveredKeys or {} do
			if key.Button then
				key.Button.Visible = true
			end
		end

		self._ikEndMarkers, self._ikEndCoveredKeys = nil, nil
	end

	function Timeline:RegisterIKControl(button, motor, refresh)
		self._ikControls = self._ikControls or setmetatable({}, { __mode = "k" })
		local enabled = limbIk.isEnabled(motor, timelineState.CurrentTime)
		self._ikControls[button] = { motor = motor, refresh = refresh, enabled = enabled }
		refresh(enabled)
	end

	function Timeline:RefreshIKControls(time)
		for button, control in self._ikControls or {} do
			if button.Parent then
				local enabled = limbIk.isEnabled(control.motor, time)
				if control.enabled ~= enabled then
					control.enabled = enabled
					control.refresh(enabled)
				end
			else
				self._ikControls[button] = nil
			end
		end
	end

	function Timeline:SwitchIKAtCurrentTime(motor, rig, parentingChange)
		if blenderEdit.blocked() then
			return
		end

		local chain = limbIk.chain(rig, motor)
		if not chain or motor:GetAttribute("EclipseDisabled") then
			return
		end

		local axis = self.refs.Axis
		if
			axis
			and (axis:IsHoldingAxis() or axis:IsBlenderGrabMode() or axis:IsBlenderRotateMode())
		then
			return
		end

		timelineState.Playing = false
		local before, after, spaces, worlds = {}, {}, {}, {}
		for _, member in chain.motors do
			before[member] = self:_snapshotMotorBucket(member)
		end

		for _, control in r6Controls.forOwner(motor) do
			before[control] = self:_snapshotMotorBucket(control)
		end

		local controls = limbIk.prepare(chain)
		self:CaptureDefaultPoseAdditive(rig)
		local frame = self:TimeToFrame(timelineState.CurrentTime)
		timelineState.CurrentTime = self:FrameToTime(frame)
		self:ApplyPoseAtTime(rig, timelineState.CurrentTime)
		local enabled = not limbIk.isEnabled(motor, timelineState.CurrentTime)
		local target, pole, baseC0, baseWorld, rootControl = limbIk.capturePose(chain)
		local dependents = {}
		if chain.kind == "Torso" then
			for _, other in chain.entry.chains do
				local state = other.kind == "R6" and limbIk.state(other)
				if state then
					before[other.owner] = self:_snapshotMotorBucket(other.owner)
					dependents[other] = table.clone(state)
				end
			end
		end

		for _, control in controls do
			if not before[control] then
				before[control] = {}
			end
		end

		for _, member in chain.motors do
			spaces[member] = if enabled
				then self:IsParentedAtTime(member, timelineState.CurrentTime)
				else limbIk.restoreParented(chain, member, timelineState.CurrentTime)
			worlds[member] = parenting.worldOf(member, timelineState.MotorByPart)
		end

		for _, member in chain.motors do
			self:RecordKeyframeForMotorAtCurrentTime(
				member.Part1,
				member,
				member.C0,
				nil,
				self.refs.UIHelpers.SanitizeName
			)
			local memberKey = timelineState.Keyframes[member][frame]
			memberKey.Parented = if parentingChange and parentingChange.motor == member
				then parentingChange.parented
				else enabled or spaces[member]
			memberKey.WorldCFrame = not memberKey.Parented and worlds[member] or nil
			memberKey.MasterWorld = memberKey.WorldCFrame
					and require("masterControl").worldDelta(member)
				or nil
			memberKey.IKRestoreParented = if enabled then spaces[member] else nil
			memberKey.PathTangentIn, memberKey.PathTangentOut = nil, nil
		end

		local key = timelineState.Keyframes[motor][frame]
		key.IK = enabled
		key.IKRoot = enabled and rootControl or nil
		key.IKPoleFollowsTarget = enabled
				and chain.kind == "R15"
				and require("preferences").get("R15PoleFollowsIK") == true
			or nil
		key.IKAnchor = enabled and limbIk.anchor(chain) or nil
		key.IKRigWorld = enabled and limbIk.rigFrame(chain) or nil
		key.IKTarget, key.IKPole = enabled and target or nil, enabled and pole or nil
		key.IKBaseC0, key.IKBaseWorld = enabled and baseC0 or nil, enabled and baseWorld or nil
		if enabled then
			local anchor = limbIk.anchor(chain)
			for _, control in controls do
				local kind = control.Bone:GetAttribute("EclipseR6Control")
				local world = kind == "upper" and target or rootControl
				if chain.kind == "R15" then
					world = ({ root = rootControl, target = target, pole = pole, roll = target })[kind]
				end

				local controlAnchor = anchor
				if chain.points then
					controlAnchor = limbIk.controlAnchorWorld(chain, kind)
				end

				if chain.kind == "R6" and kind == "pole" then
					world = limbIk.defaultLegPole(chain, target)
					controlAnchor = target
				end

				if chain.kind == "R15" then
					local parent = chain.entry.map[control.RealPart0]
					controlAnchor = parent and parenting.worldOf(parent, chain.entry.map)
						or control.Part0.CFrame
				end

				control.C0 = (chain.kind == "R15" and kind == "roll")
						and (timelineState.DefaultPose[control] or control.Bone.CFrame)
					or controlAnchor:ToObjectSpace(world)
				self:RecordKeyframeForMotorAtCurrentTime(
					control.Part1,
					control,
					control.C0,
					nil,
					self.refs.UIHelpers.SanitizeName
				)
			end
		end

		if chain.kind == "Torso" then
			chain.entry.torsoBaseWorld = enabled and baseWorld or nil
			for other, state in dependents do
				local owner = other.owner
				self:RecordKeyframeForMotorAtCurrentTime(
					owner.Part1,
					owner,
					owner.C0,
					nil,
					self.refs.UIHelpers.SanitizeName
				)
				local childKey = timelineState.Keyframes[owner][frame]
				childKey.IK, childKey.Parented, childKey.WorldCFrame = true, true, nil
				childKey.IKTarget, childKey.IKPole, childKey.IKRoot =
					state.target, state.pole, state.root
				childKey.IKBaseC0, childKey.IKBaseWorld = state.baseC0, state.baseWorld
				childKey.IKAnchor = limbIk.anchor(other)
				childKey.IKRigWorld = limbIk.rigFrame(other)
				after[owner] = self:_snapshotMotorBucket(owner)
			end
		end

		for _, control in controls do
			after[control] = self:_snapshotMotorBucket(control)
		end

		for _, member in chain.motors do
			after[member] = self:_snapshotMotorBucket(member)
		end

		local function refresh(snapshot)
			if snapshot then
				for member, bucket in snapshot do
					self:_restoreMotorBucket(member, bucket, true)
				end

				for member in snapshot do
					self:RefreshAllChannelDiamondsForMotor(member)
				end
			end

			for member in snapshot or after do
				require("policy").invalidate(timelineState.Keyframes[member])
				timelineState._motorUniform[member] = nil
			end

			timelineState.LastPlaybackFrame = nil
			limbIk.clearLive()
			self:ApplyPoseAtTime(rig, timelineState.CurrentTime)
			self:RefreshAllKeyframeVisuals()
			self:RefreshIKControls(timelineState.CurrentTime)
			if self.refs.RefreshIKHierarchy then
				self.refs.RefreshIKHierarchy()
			end

			if axis then
				axis:InvalidateAxisCache()
				axis:RefreshAxis()
			end

			if self.refs.SetCurrentRigUnsaved then
				self.refs.SetCurrentRigUnsaved()
			end
		end

		history.record(function()
			refresh(before)
		end, function()
			refresh(after)
		end, "Switch " .. motor.Part1.Name .. " to " .. (enabled and "IK" or "FK"), frame)
		refresh()
	end

	function Timeline:SwitchPoleFollowAtCurrentTime(motor, rig)
		if self:IsExportLocked() or blenderEdit.blocked() then
			return
		end

		local chain = limbIk.chain(rig, motor)
		if not chain or chain.kind ~= "R15" or motor:GetAttribute("EclipseDisabled") then
			return
		end

		local axis = self.refs.Axis
		if
			axis
			and (axis:IsHoldingAxis() or axis:IsBlenderGrabMode() or axis:IsBlenderRotateMode())
		then
			return
		end

		timelineState.Playing = false
		local frame = self:TimeToFrame(timelineState.CurrentTime)
		timelineState.CurrentTime = self:FrameToTime(frame)
		self:ApplyPoseAtTime(rig, timelineState.CurrentTime)
		local state = limbIk.state(chain)
		if not state then
			return
		end

		local before = self:_snapshotMotorBucket(motor)
		state.poleFollowsTarget = not state.poleFollowsTarget
		self:RecordKeyframeForMotorAtCurrentTime(
			motor.Part1,
			motor,
			motor.C0,
			nil,
			self.refs.UIHelpers.SanitizeName
		)
		limbIk.captureKey(motor, timelineState.Keyframes[motor][frame])
		local after = self:_snapshotMotorBucket(motor)

		local function restore(bucket)
			if bucket then
				self:_restoreMotorBucket(motor, bucket)
			end

			require("policy").invalidate(timelineState.Keyframes[motor])
			limbIk.clearLive()
			self:ApplyPoseAtTime(rig, timelineState.CurrentTime)
			self:RefreshAllKeyframeVisuals()
			require("motionPath").markDirty()
			if axis then
				axis:InvalidateAxisCache()
				axis:RefreshAxis()
			end

			if self.refs.SetCurrentRigUnsaved then
				self.refs.SetCurrentRigUnsaved()
			end
		end

		history.record(function()
			restore(before)
		end, function()
			restore(after)
		end, "Switch pole follows IK", frame)
		restore()
	end
end
]]></ProtectedString>
						<string name="ScriptGuid">{6E799875-FD3A-4BB0-8158-80FC7C034805}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">ikKeyframing</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX2F105430B0584C53A6733F1F6D5E8749">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local blenderEdit = require("blenderEdit")
local timelineState = require("rawState").Timeline
local parenting = require("parenting")
local graphCurves = require("graphCurves")
local limbIk = require("limbIk")
local headStabilizer = require("headStabilizer")
local history = require("history")

return function(Timeline)
	function Timeline:IsParentedAtTime(motor, time)
		local link = require("target").childAt(motor, time)
		if link then
			return not link.world
		end

		return limbIk.isDriven(motor, time)
			or parenting.isParentedAt(
				motor,
				timelineState.Keyframes[motor],
				time,
				timelineState.ParentingDefaults[motor]
			)
	end

	function Timeline:CaptureKeyframeParenting(motor, keyData, c0, skipChildCapture)
		if typeof(keyData.Parented) ~= "boolean" then
			local previous = nil
			for _, candidate in pairs(timelineState.Keyframes[motor] or {}) do
				if
					candidate ~= keyData
					and not candidate.GraphOnly
					and not candidate.Disabled
					and candidate.Time <= keyData.Time
					and (not previous or candidate.Time > previous.Time)
				then
					previous = candidate
				end
			end

			keyData.Parented =
				parenting.keyIsParented(motor, previous, timelineState.ParentingDefaults[motor])
		end

		if keyData.Parented then
			keyData.WorldCFrame = nil
		else
			local parentMotor = timelineState.MotorByPart[parenting.realPart0(motor)]
			local parentWorld = parentMotor
					and parenting.worldOf(parentMotor, timelineState.MotorByPart)
				or motor.Part0.CFrame
			keyData.WorldCFrame = parentWorld * c0 * motor.C1:Inverse()
		end

		limbIk.captureKey(motor, keyData)
		headStabilizer.captureKey(motor, keyData, c0)
		if not skipChildCapture then
			require("target").capture(motor, keyData, c0)
		end

		keyData.MasterWorld = keyData.WorldCFrame and require("masterControl").worldDelta(motor)
			or nil
		graphCurves.invalidate(timelineState.Keyframes[motor])
	end

	function Timeline:RefreshParentingControls(time, isParentedAt, childAt)
		time = time or timelineState.CurrentTime
		for button, entry in pairs(self._parentingControls or {}) do
			if not button.Parent then
				self._parentingControls[button] = nil
			else
				local parented
				if isParentedAt then
					parented = isParentedAt(entry.motor, time)
				end

				if parented == nil then
					parented = self:IsParentedAtTime(entry.motor, time)
				end

				local link = require("target").childAt(entry.motor, time)
				if link then
					parented = not link.world
				end

				local driven = limbIk.isDriven(entry.motor, time)
					or headStabilizer.isEnabled(entry.motor, time)
				local child = (not childAt or childAt(entry.motor, time))
					and require("target").childAt(entry.motor, time) ~= nil
				if entry.parented ~= parented or entry.driven ~= driven or entry.child ~= child then
					entry.parented, entry.driven, entry.child = parented, driven, child
					entry.refresh(parented, driven, child)
				end
			end
		end
	end

	function Timeline:RegisterParentingControl(button, motor, refresh, rig)
		self._parentingControls = self._parentingControls or setmetatable({}, { __mode = "k" })
		local parented = self:IsParentedAtTime(motor, timelineState.CurrentTime)
		limbIk.getRig(rig)
		local driven = limbIk.isDriven(motor, timelineState.CurrentTime)
			or headStabilizer.isEnabled(motor, timelineState.CurrentTime)
		local child = require("target").childAt(motor, timelineState.CurrentTime) ~= nil
		self._parentingControls[button] = {
			motor = motor,
			refresh = refresh,
			parented = parented,
			driven = driven,
			child = child,
			rig = rig,
		}
		refresh(parented, driven, child)
	end

	local function selectedParentingKeys(self, motor)
		local controls = {}
		for _, entry in self._parentingControls or {} do
			if entry.rig then
				controls[entry.motor] = entry.rig
			end
		end

		if not controls[motor] then
			return nil
		end

		local target = require("target")
		local keys = {}
		local includesMotor = false
		for key in timelineState.SelectedKeyframes or {} do
			local keyMotor = key.Motor
			local bucket = keyMotor and timelineState.Keyframes[keyMotor]
			if
				controls[keyMotor]
				and bucket
				and bucket[key.Frame] == key
				and not key.GraphOnly
				and keyMotor.Part1
				and (typeof(keyMotor) ~= "Instance" or keyMotor.Parent and not keyMotor:GetAttribute(
					"EclipseDisabled"
				))
				and not limbIk.isDriven(keyMotor, key.Time)
				and not headStabilizer.isEnabled(keyMotor, key.Time)
				and not target.childAt(keyMotor, key.Time)
			then
				table.insert(keys, key)
				includesMotor = includesMotor or keyMotor == motor
			end
		end

		if
			not includesMotor
			or #keys == 1 and keys[1].Frame == self:TimeToFrame(timelineState.CurrentTime)
		then
			return nil
		end

		return keys, controls
	end

	function Timeline:SwitchParentingForKeys(keys, controls)
		local allParented = true
		for _, key in keys do
			if
				not parenting.keyIsParented(
					key.Motor,
					key,
					timelineState.ParentingDefaults[key.Motor]
				)
			then
				allParented = false
				break
			end
		end

		local parented = not allParented
		local startTime = timelineState.CurrentTime
		local rigs, frames, motors, before = {}, {}, {}, {}
		timelineState.Playing = false
		for _, key in keys do
			rigs[controls[key.Motor]] = true
			frames[key.Frame] = frames[key.Frame] or {}
			table.insert(frames[key.Frame], key)
			if not motors[key.Motor] then
				motors[key.Motor] = true
				before[key.Motor] = self:_snapshotMotorBucket(key.Motor)
			end
		end

		for rig in rigs do
			self:CaptureDefaultPoseAdditive(rig)
		end

		local masterControl = require("masterControl")
		local captured = {}
		for frame, list in frames do
			local time = self:FrameToTime(frame)
			timelineState.CurrentTime = time
			for rig in rigs do
				self:ApplyPoseAtTime(rig, time)
			end

			for _, key in list do
				local keyMotor = key.Motor
				captured[key] = {
					c0 = keyMotor.C0,
					world = parenting.worldOf(keyMotor, timelineState.MotorByPart),
					master = masterControl.worldDelta(keyMotor),
				}
			end
		end

		local sanitize = self.refs.UIHelpers.SanitizeName
		local ok, err = pcall(function()
			for frame, list in frames do
				local time = self:FrameToTime(frame)
				timelineState.CurrentTime = time
				for rig in rigs do
					self:ApplyPoseAtTime(rig, time)
				end

				for _, key in list do
					local keyMotor, capture = key.Motor, captured[key]
					self:RecordKeyframeForMotorAtCurrentTime(
						keyMotor.Part1,
						keyMotor,
						capture.c0,
						nil,
						sanitize
					)
					local bucket = timelineState.Keyframes[keyMotor]
					local current = bucket and bucket[frame]
					if current then
						current.Parented = parented
						current.WorldCFrame = not parented and capture.world or nil
						current.MasterWorld = not parented and capture.master or nil
						current.PathTangentIn = nil
						current.PathTangentOut = nil
					end
				end
			end
		end)

		timelineState.CurrentTime = startTime

		local function refresh()
			for rig in rigs do
				self:ApplyPoseAtTime(rig, timelineState.CurrentTime)
			end

			self:RefreshAllKeyframeVisuals()
			self:RefreshAllChannelDiamondColors()
			if self.refs.SetCurrentRigUnsaved then
				self.refs.SetCurrentRigUnsaved()
			end
		end

		local function restore(snapshots)
			for keyMotor, snap in snapshots do
				self:_restoreMotorBucket(keyMotor, snap)
			end

			refresh()
		end

		if not ok then
			restore(before)
			error(err, 0)
		end

		local after = {}
		for keyMotor in motors do
			graphCurves.invalidate(timelineState.Keyframes[keyMotor])
			after[keyMotor] = self:_snapshotMotorBucket(keyMotor)
		end

		history.record(
			function()
				restore(before)
			end,
			function()
				restore(after)
			end,
			"Switch " .. #keys .. " keyframes to " .. (parented and "Parent" or "World"),
			self:TimeToFrame(startTime)
		)
		refresh()
	end

	function Timeline:SwitchParentingAtCurrentTime(motor, rig)
		if blenderEdit.blocked() then
			return
		end

		if not motor or not motor.Parent or not rig or motor:GetAttribute("EclipseDisabled") then
			return
		end

		if require("targets").switchSpace(motor, rig) then
			return
		end

		local driven = limbIk.drivingChain(motor, timelineState.CurrentTime)
		if driven then
			return self:SwitchIKAtCurrentTime(
				driven.owner,
				rig,
				{ motor = motor, parented = false }
			)
		end

		if headStabilizer.isEnabled(motor, timelineState.CurrentTime) then
			return
		end

		local selectedKeys, controls = selectedParentingKeys(self, motor)
		if selectedKeys then
			return self:SwitchParentingForKeys(selectedKeys, controls)
		end

		timelineState.Playing = false
		self:CaptureDefaultPoseAdditive(rig)
		local frame = self:TimeToFrame(timelineState.CurrentTime)
		local time = self:FrameToTime(frame)
		timelineState.CurrentTime = time
		self:ApplyPoseAtTime(rig, time)
		local parented = not self:IsParentedAtTime(motor, time)
		local before = self:_snapshotMotorBucket(motor)
		local c0 = motor.C0
		local world = parenting.worldOf(motor, timelineState.MotorByPart)
		local sanitize = self.refs.UIHelpers.SanitizeName
		self:RecordKeyframeForMotorAtCurrentTime(motor.Part1, motor, c0, nil, sanitize)
		local key = timelineState.Keyframes[motor][frame]
		key.Parented = parented
		key.WorldCFrame = not parented and world or nil
		key.MasterWorld = not parented and require("masterControl").worldDelta(motor) or nil
		key.PathTangentIn = nil
		key.PathTangentOut = nil
		graphCurves.invalidate(timelineState.Keyframes[motor])
		local after = self:_snapshotMotorBucket(motor)

		local function refresh()
			self:ApplyPoseAtTime(rig, timelineState.CurrentTime)
			self:RefreshAllKeyframeVisuals()
			self:RefreshAllChannelDiamondColors()
			if self.refs.SetCurrentRigUnsaved then
				self.refs.SetCurrentRigUnsaved()
			end
		end

		history.record(function()
			self:_restoreMotorBucket(motor, before)
			refresh()
		end, function()
			self:_restoreMotorBucket(motor, after)
			refresh()
		end, "Switch " .. motor.Part1.Name .. " to " .. (parented and "Parent" or "World"), frame)
		refresh()
	end
end
]]></ProtectedString>
						<string name="ScriptGuid">{AEAB66AF-8A89-464B-BCEE-1A7E7C64CF1F}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">parentingKeyframes</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1F8C320119A3412E8AEA57EB004F0E7F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local state = require("state")
local mode = require("poseCache")
local ikModule = require("limbIk")
local tool = require("tool")
local theme = require("theme")
local panel = {}
local window
local rowCache = setmetatable({}, { __mode = "k" })

function panel.selection()
	local rigModule = state.Rig
	if not rigModule then
		return
	end

	local bone = state.Axis and state.Axis:GetSelectedBone()
	local rig = state.currentRig
	local source = bone and bone.Parent and bone.Parent:FindFirstChild("EclipseSourceRig")
	if source and source.Value then
		rig = source.Value
	end

	local part = bone and rig and rigModule:GetPartFromBone(rig, bone)
	local motor = part and rigModule:GetMotorForPart(rig, part)
	local cached = motor and rowCache[motor]
	local row = cached
			and cached.rigModule == rigModule
			and cached.row.uiElement
			and cached.row.uiElement.Parent
			and cached.row
		or nil
	if not row and motor then
		for _, candidate in rigModule._orderedItems or {} do
			if
				candidate.itemKind ~= "channel"
				and candidate.fetchMotor
				and candidate:fetchMotor() == motor
			then
				row = candidate
				rowCache[motor] = { rigModule = rigModule, row = row }
				break
			end
		end
	end

	if not motor then
		local selected = rigModule._lastClickedItem
		if selected and (rigModule._selectedItems or {})[selected] then
			row = selected.parentBoneItem or selected
			motor = row.fetchMotor and row:fetchMotor()
			rig = row.grandpa and row.grandpa.linkedRigInstance or rig
		end
	end

	return motor, rig, row
end

function panel.close()
	if window then
		window:close(true)
	end
end

function panel.open()
	panel.close()
	local timeline = state.Timeline
	local ui = require("ui")
	if
		not timeline
		or not ui.EclipseGUI
		or not ui.AnimatorFrame
		or not ui.AnimatorFrame.Visible
		or not ui.EclipseGUI.Enabled
	then
		return
	end

	local refs = { ScreenGui = ui.EclipseGUI, Plugin = require("projectData").getPlugin() }
	local session
	session = tool.new(
		refs,
		"EclipseBoneSettings",
		"BONE SETTINGS",
		Vector2.new(350, 284),
		false,
		function()
			if window == session then
				window = nil
			end
		end
	)
	window = session
	local title = tool.label(
		session.frame,
		"SelectedBone",
		"Select a bone",
		UDim2.fromOffset(16, 42),
		UDim2.fromOffset(318, 28)
	)
	local controls = {}
	local selection = panel.selection

	local function alive()
		return state.Timeline == timeline
			and refs.ScreenGui.Parent ~= nil
			and refs.ScreenGui.Enabled
			and ui.AnimatorFrame.Parent ~= nil
			and ui.AnimatorFrame.Visible
			and (not ui.PluginActiveBool or ui.PluginActiveBool.Value)
	end

	local refresh

	local function checkbox(name, text, action)
		local button = tool.make("TextButton", session.frame, name, {
			Text = "",
			Size = UDim2.fromOffset(318, 26),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			ZIndex = session.frame.ZIndex + 3,
		})
		local label =
			tool.label(button, "Title", text, UDim2.fromOffset(26, 0), UDim2.fromOffset(292, 26))
		label.ZIndex = button.ZIndex + 1
		local box = tool.make("Frame", button, "Check", {
			Position = UDim2.fromOffset(0, 5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			ZIndex = button.ZIndex + 1,
		})
		box:SetAttribute("ThemeBg", "TopBtn")
		local fill = tool.make("Frame", box, "Fill", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(8, 8),
			BorderSizePixel = 0,
			ZIndex = box.ZIndex + 1,
		})
		fill:SetAttribute("ThemeBg", "Txt")
		for _, object in { box, fill } do
			tool.make("UICorner", object, "Corner", { CornerRadius = UDim.new(0, 2) })
		end

		local border = tool.make("UIStroke", box, "Outline", { Thickness = 1 })
		border:SetAttribute("ThemeStrk", "Strk")
		local control =
			{ button = button, label = label, fill = fill, border = border, enabled = false }
		controls[name] = control
		table.insert(
			session.connections,
			button.Activated:Connect(function()
				if not alive() then
					panel.close()
					return
				end

				if timeline:IsExportLocked() or require("blenderEdit").blocked() then
					return
				end

				refresh()
				if not control.enabled then
					return
				end

				local motor, rig, row = selection()
				if motor and rig then
					action(motor, rig, row)
					refresh()
				end
			end)
		)
		return button
	end

	local function chainFor(motor, rig)
		if not motor or not rig then
			return
		end

		local owner = typeof(motor) == "table" and motor.IsEclipseR6Control and motor.Owner or motor
		local entry = ikModule.getRig(rig)
		return entry and entry.members[owner]
	end

	checkbox("TrackEnabled", "Track Enabled", function(motor, rig, row)
		local disabled = not row:isDisabled()
		row:setDisabled(disabled, false)
	end)
	checkbox("MotionPath", "Motion Path", function(_, _, row)
		row:setMotionPath(not row:isMotionPathEnabled(), false)
	end)
	checkbox("InverseKinematics", "Inverse Kinematics (IK)", function(motor, rig)
		local chain = chainFor(motor, rig)
		if chain then
			timeline:SwitchIKAtCurrentTime(chain.owner, rig)
		end
	end)
	local parent = checkbox("FollowParent", "Follow Parent (P / W)", function(motor, rig)
		timeline:SwitchParentingAtCurrentTime(motor, rig)
	end)
	table.insert(
		session.connections,
		parent.MouseButton2Click:Connect(function()
			if not alive() or timeline:IsExportLocked() or require("blenderEdit").blocked() then
				return
			end

			local motor, rig = selection()
			if motor and controls.FollowParent.button.Visible and controls.FollowParent.enabled then
				require("targets").openChild(motor, rig)
			end
		end)
	)
	checkbox("InheritRotation", "Inherit Rotation (IR)", function(motor, rig)
		timeline:SwitchHeadStabilizerAtCurrentTime(motor, rig)
	end)
	checkbox("PoleFollowsIK", "Pole Follows IK", function(motor, rig)
		local chain = chainFor(motor, rig)
		if chain then
			timeline:SwitchPoleFollowAtCurrentTime(chain.owner, rig)
		end
	end)
	refresh = function()
		local motor, rig, row = selection()
		local time = timeline:GetState().CurrentTime
		local chain = chainFor(motor, rig)
		local disabled = motor and motor:GetAttribute("EclipseDisabled") == true
		local helper = motor and typeof(motor) == "table" and motor.IsEclipseIKHandle
		local rotation = mode.isEligible(motor)
			and not (typeof(motor) == "table" and motor.IsEclipseR6Control)
		local parenting = motor ~= nil and not helper and (not row or row.parentingButton ~= nil)
		local ik = chain and ikModule.isEnabled(chain.owner, time)
		local follow = ik and chain.kind == "R15" and ikModule.state(chain, time)
		title.Text = motor
				and (row and row.linkedRigInstance and row.linkedRigInstance.Name or motor.Part1.Name)
			or "Select a bone"
		local y = 78

		local function paint(name, visible, checked, enabled)
			local c = controls[name]
			c.button.Visible = visible == true
			c.enabled = visible == true and enabled == true
			c.button.Active = c.enabled
			c.button.Selectable = c.enabled
			c.fill.Visible = checked == true
			c.label.TextTransparency = c.enabled and 0 or 0.55
			c.fill.BackgroundTransparency = c.enabled and 0 or 0.55
			c.border.Transparency = c.enabled and 0 or 0.55
			if visible then
				c.button.Position = UDim2.fromOffset(16, y)
				y += 32
			end
		end

		paint(
			"TrackEnabled",
			row ~= nil and row.disableButton ~= nil,
			row ~= nil and not row:isDisabled(),
			true
		)
		paint(
			"MotionPath",
			row ~= nil and row.motionPathButton ~= nil,
			row ~= nil and row:isMotionPathEnabled(),
			true
		)
		paint(
			"InverseKinematics",
			chain ~= nil,
			ik == true,
			not disabled and chain ~= nil and not chain.owner:GetAttribute("EclipseDisabled")
		)
		paint(
			"FollowParent",
			parenting,
			parenting and timeline:IsParentedAtTime(motor, time),
			not disabled and (not rotation or mode.inherits(motor, time))
		)
		paint(
			"InheritRotation",
			rotation == true,
			rotation and mode.inherits(motor, time),
			not disabled
		)
		paint(
			"PoleFollowsIK",
			chain ~= nil and chain.kind == "R15",
			follow and follow.poleFollowsTarget == true,
			not disabled and follow ~= nil and follow ~= false
		)
		local height = math.max(110, y + 10)
		local minimum = session.frame:FindFirstChild("MinimumSize")
		if minimum then
			minimum.MinSize = Vector2.new(350, height)
		end

		session.frame.Size = UDim2.fromOffset(350, height)
	end

	local function closeWhenHidden()
		if not alive() then
			session:close(true)
		end
	end

	for _, pair in { { refs.ScreenGui, "Enabled" }, { ui.AnimatorFrame, "Visible" } } do
		table.insert(
			session.connections,
			pair[1]:GetPropertyChangedSignal(pair[2]):Connect(closeWhenHidden)
		)
	end

	if ui.PluginActiveBool then
		table.insert(session.connections, ui.PluginActiveBool.Changed:Connect(closeWhenHidden))
	end

	if ui.ClosingEvent then
		table.insert(
			session.connections,
			ui.ClosingEvent.Event:Connect(function()
				session:close(true)
			end)
		)
	end

	table.insert(
		session.connections,
		refs.ScreenGui.Destroying:Connect(function()
			session:close(true)
		end)
	)
	local elapsed = 0
	table.insert(
		session.connections,
		game:GetService("RunService").Heartbeat:Connect(function(dt)
			if not alive() then
				session:close(true)
				return
			end

			elapsed += dt
			if elapsed < 0.15 then
				return
			end

			elapsed = 0
			refresh()
		end)
	)
	refresh()
	theme.applyTree(session.frame)
end

return panel
]]></ProtectedString>
