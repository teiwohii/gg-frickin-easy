						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local state = require("state")
local edit = {}

function edit.blocked(allowDrawing)
	if state.LimbPointSetupActive then
		return true
	end
	if state.LoadingProject and state.ProjectLoadThread ~= coroutine.running() then
		return true
	end

	if not allowDrawing and state.GreasePencil and state.GreasePencil.isDrawing() then
		return true
	end

	local bridge = state.BlenderBridge
	return bridge and bridge.isLocked and bridge.isLocked() or false
end

return edit
]]></ProtectedString>
						<string name="ScriptGuid">{A40CD007-2A8D-4518-A251-CDB7C7379040}</string>
