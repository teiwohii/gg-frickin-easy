					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local contentProvider = game:GetService("ContentProvider")
local audio = {}
local preloadTimeout = 12
local widget

function audio.attach(plugin)
	if widget then
		return
	end

	local info =
		DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, true, 10, 10, 10, 10)
	local ok, result =
		pcall(plugin.CreateDockWidgetPluginGuiAsync, plugin, "EclipseAnimatorAudio", info)
	if not ok then
		warn("couldnt start eclipse audio: " .. tostring(result))
		return
	end

	widget = result
	widget.Name = "EclipseAnimatorAudio"
	widget.Title = "Eclipse Audio"
	widget.Enabled = false
	widget.Archivable = false
end

function audio.parent()
	return widget
end

function audio.preload(sounds, isCurrent, timeout)
	if not isCurrent() then
		return false
	end

	if #sounds == 0 then
		return true
	end

	local done, failure = false, nil
	task.spawn(function()
		local ok, err = pcall(contentProvider.PreloadAsync, contentProvider, sounds)
		if not ok then
			failure = err
		end

		done = true
	end)
	local deadline = os.clock() + (timeout or preloadTimeout)
	while not done and isCurrent() and os.clock() < deadline do
		task.wait()
	end

	if not isCurrent() then
		return false
	end

	if failure then
		warn("couldnt preload audio: " .. tostring(failure))
		return false
	end

	for _, sound in sounds do
		if not sound.IsLoaded then
			warn("couldnt preload audio " .. sound.SoundId)
			return false
		end
	end

	return true
end

function audio.destroy()
	require("localAudio").clear()
	local previous = widget
	widget = nil
	if not previous then
		return
	end

	for _, sound in previous:GetChildren() do
		if sound:IsA("Sound") then
			sound:Stop()
		end
	end

	previous:Destroy()
end

return audio
]]></ProtectedString>
						<string name="ScriptGuid">{872E0FFB-2AE4-495B-91F3-D9BE530C7D49}</string>
