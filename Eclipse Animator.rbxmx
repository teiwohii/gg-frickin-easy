						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local changeHistoryService = game:GetService("ChangeHistoryService")
local runService = game:GetService("RunService")

local UndoScope = {}
UndoScope.__index = UndoScope

UndoScope.guardInterval = 0.1

function UndoScope.new()
	local self = setmetatable({}, UndoScope)

	self.owner = nil
	self.generation = 0
	self.resets = 0
	self.guardConnection = nil
	self.guardElapsed = 0

	return self
end

function UndoScope:getOwner(): any
	return self.owner
end

function UndoScope:getResetCount(): number
	return self.resets
end

function UndoScope:clear(): boolean
	local success = pcall(function()
		changeHistoryService:ResetWaypoints()
	end)

	if success then
		self.resets += 1
	end

	return success
end

function UndoScope:hasStudioHistory(): boolean
	local success, pending = pcall(function()
		return changeHistoryService:GetCanUndo() or changeHistoryService:GetCanRedo()
	end)

	return success and pending == true
end

function UndoScope:isGuarding(): boolean
	return self.guardConnection ~= nil
end

function UndoScope:startGuard()
	if self.guardConnection then
		return
	end

	self.guardElapsed = 0
	self:clear()

	self.guardConnection = runService.Heartbeat:Connect(function(deltaTime)
		self.guardElapsed += deltaTime

		if self.guardElapsed >= UndoScope.guardInterval then
			self.guardElapsed = 0
			self:clear()
		elseif self:hasStudioHistory() then
			self:clear()
		end
	end)
end

function UndoScope:stopGuard()
	if self.guardConnection then
		self.guardConnection:Disconnect()
		self.guardConnection = nil
	end

	self:clear()
end

function UndoScope:clearSoon()
	self.generation += 1

	local generation = self.generation

	task.defer(function()
		if generation == self.generation then
			self:clear()
		end
	end)
end

function UndoScope:switch(owner: any, deferred: boolean?): boolean
	if owner == self.owner then
		return false
	end

	self.owner = owner

	if deferred then
		self:clearSoon()
	else
		self:clear()
		self:clearSoon()
	end

	return true
end

function UndoScope:destroy()
	self.generation += 1
	self.owner = nil

	if self.guardConnection then
		self.guardConnection:Disconnect()
		self.guardConnection = nil
	end
end

return UndoScope
]]></ProtectedString>
							<string name="ScriptGuid">{059DF15E-185D-45F3-B254-37693B33750E}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">UndoScope</string>
