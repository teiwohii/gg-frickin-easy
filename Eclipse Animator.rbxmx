local require = require(script:FindFirstAncestor("container").requireModule)

local function source(module)
	local text = module.Source
	local start = text:find("return function(require)", 1, true)
	assert(start, "Unexpected export module shape: " .. module.Name)
	return text:sub(start)
end

local sources = {
	["Runtime/Smears"] = source(script.exportSmears),
	["Subsystems/EventClock"] = source(script.exportEventClock),
	["Subsystems/EventParticles"] = source(script.exportEventParticles),
	["Subsystems/EventOrientation"] = source(script.exportEventOrientation),
	["Subsystems/EventFlipbook"] = source(script.exportEventFlipbook),
	["Subsystems/EventCleanup"] = source(script.exportEventCleanup),
	["Helpers/AfterimageConfig"] = source(script.exportAfterimageConfig),
	["Helpers/AfterimageVisual"] = source(script.exportAfterimageVisual),
	["Runtime/Afterimages"] = source(script.exportAfterimages),
	["Helpers/CameraProjection"] = source(script.exportCameraProjection),
	["Helpers/EffectLayer"] = source(script.exportEffectLayer),
	["Helpers/EffectObjects"] = source(script.exportEffectObjects),
	["Helpers/EffectVFXSurface"] = source(script.exportEffectVfxSurface),
	["Helpers/EmitData"] = source(script.exportEmitData),
	["Helpers/SubtitleData"] = source(script.exportSubtitleData),
	["Resources/EffectAssets"] = require(script.exportEffectAssets),
	["Runtime/Geometry"] = source(script.exportGeometry),
	["Runtime/Letterbox"] = source(script.exportLetterbox),
	["Runtime/Player"] = source(script.exportPlayer),
	["Runtime/Cutscene"] = source(script.exportCutscene),
	["Runtime/Preload"] = source(script.exportPreload),
	["Subsystems/SubtitleRenderer"] = source(script.exportSubtitleRenderer),
}

for name, libraryName in
	{
		SmearGeometry = "smearGeometry",
		EclipseShake = "shake",
		EclipseDrawing = "drawing",
		EclipseSoundTiming = "soundTiming",
	}
do
	local library = script:FindFirstAncestor("container").shared[libraryName]
	sources["Shared/" .. name] = "return function(require)\n" .. library.Source .. "\nend\n"
end

return sources
]]></ProtectedString>
