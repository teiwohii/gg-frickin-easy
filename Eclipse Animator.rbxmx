							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local SelectionValidator = {}
SelectionValidator.__index = SelectionValidator

SelectionValidator.Result = {
	valid = "Valid",
	empty = "Empty",
	invalid = "Invalid",
}

function SelectionValidator.new(allowedClasses: { string })
	local self = setmetatable({}, SelectionValidator)

	self.allowedClasses = {}

	for _, className in allowedClasses do
		self.allowedClasses[className] = true
	end

	return self
end

function SelectionValidator:isAllowedClass(instance: Instance): boolean
	return self.allowedClasses[instance.ClassName] == true
end

function SelectionValidator:containsHumanoid(instance: Instance): boolean
	return instance:FindFirstChildWhichIsA("Humanoid", true) ~= nil
end

function SelectionValidator:hasOnlyAllowedDescendants(instance: Instance): boolean
	for _, descendant in instance:GetDescendants() do
		if not self:isAllowedClass(descendant) then
			return false
		end
	end

	return true
end

function SelectionValidator:isAllowedModel(model: Model): boolean
	if self:containsHumanoid(model) then
		return false
	end

	return self:hasOnlyAllowedDescendants(model)
end

function SelectionValidator:isAllowed(instance: Instance): boolean
	if not self:isAllowedClass(instance) then
		return false
	end

	if instance:IsA("Model") then
		return self:isAllowedModel(instance)
	end

	return true
end

function SelectionValidator:validate(instances: { Instance }): (string, { Instance })
	if #instances == 0 then
		return SelectionValidator.Result.empty, {}
	end

	local rejected = {}

	for _, instance in instances do
		if not self:isAllowed(instance) then
			table.insert(rejected, instance)
		end
	end

	if #rejected > 0 then
		return SelectionValidator.Result.invalid, rejected
	end

	return SelectionValidator.Result.valid, rejected
end

return SelectionValidator
]]></ProtectedString>
