							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local modifiers = {}
modifiers.__index = modifiers

modifiers.groups = {
	shift = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift },
	ctrl = { Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl },
	alt = { Enum.KeyCode.LeftAlt, Enum.KeyCode.RightAlt },
}

modifiers.modifierKeys = {
	shift = Enum.ModifierKey.Shift,
	ctrl = Enum.ModifierKey.Ctrl,
	alt = Enum.ModifierKey.Alt,
}

modifiers.pressed = {}
modifiers.released = {}
modifiers.lastInput = nil
modifiers.connections = nil

function modifiers.start()
	if modifiers.connections then
		return
	end

	modifiers.connections = {
		userInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard then
				modifiers.pressed[input.KeyCode] = true
				modifiers.lastInput = input
			end
		end),
		userInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard then
				modifiers.pressed[input.KeyCode] = nil
				modifiers.released[input.KeyCode] = os.clock()
			end
		end),
		userInputService.WindowFocusReleased:Connect(function()
			table.clear(modifiers.pressed)
		end),
	}
end

function modifiers.stop()
	if not modifiers.connections then
		return
	end

	for _, connection in modifiers.connections do
		connection:Disconnect()
	end

	modifiers.connections = nil
	table.clear(modifiers.pressed)
	table.clear(modifiers.released)
end

function modifiers.isHeld(name: string, input: InputObject?): boolean
	local source = input

	if source then
		local success, held = pcall(function()
			return source:IsModifierKeyDown(modifiers.modifierKeys[name])
		end)

		if success and held then
			return true
		end
	end

	for _, keyCode in modifiers.groups[name] do
		if modifiers.pressed[keyCode] or userInputService:IsKeyDown(keyCode) then
			return true
		end
	end

	return false
end

function modifiers.wasHeld(name: string, input: InputObject?, grace: number): boolean
	if modifiers.isHeld(name, input) then
		return true
	end

	local now = os.clock()

	for _, keyCode in modifiers.groups[name] do
		local released = modifiers.released[keyCode]

		if released and now - released <= grace then
			return true
		end
	end

	return false
end

function modifiers.wasCtrl(input: InputObject?, grace: number): boolean
	return modifiers.wasHeld("ctrl", input, grace)
end

function modifiers.isShift(input: InputObject?): boolean
	return modifiers.isHeld("shift", input)
end

function modifiers.isCtrl(input: InputObject?): boolean
	return modifiers.isHeld("ctrl", input)
end

modifiers.start()

return modifiers
]]></ProtectedString>
