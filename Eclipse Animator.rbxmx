							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local LibraryKind = {}
LibraryKind.__index = LibraryKind

LibraryKind.id = "Effect"
LibraryKind.label = "VFX"
LibraryKind.plural = "VFX"
LibraryKind.order = 100
LibraryKind.fallbackIcon = "preset"
LibraryKind.singleText = "1 object"
LibraryKind.countText = "%d objects"
LibraryKind.tip = "Emitters, beams, meshes, models and anything else you build in Create."

function LibraryKind.new(definition)
	local self = setmetatable({}, LibraryKind)

	self:configure(definition)

	return self
end

function LibraryKind:configure(definition)
	for name, value in definition or {} do
		self[name] = value
	end
end

function LibraryKind:accepts(_roots: { Instance }): boolean
	return true
end

function LibraryKind:getIcon(roots: { Instance }): string
	local first = roots[1]

	return if first then first.ClassName else self.fallbackIcon
end

function LibraryKind:describe(item): string
	local count = if typeof(item.count) == "number" then item.count else 1

	return if count == 1 then self.singleText else string.format(self.countText, count)
end

function LibraryKind:place(library, root: Instance, container: Instance, placement: CFrame)
	local builder = library.builder
	local selected = builder:getSelected()

	if root:IsA("PVInstance") then
		root.Parent = container
	elseif root:IsA("Attachment") then
		root.Parent = builder:getPartOf(selected) or builder:createHolder(container, placement)
	elseif root:IsA("Sound") then
		root.Parent = builder:getPoint(selected) or container
	else
		root.Parent = builder:getPoint(selected) or builder:createAttachment(builder:createHolder(container, placement))
	end
end

function LibraryKind:canPreview(): boolean
	return false
end

function LibraryKind:isPreviewing(_item): boolean
	return false
end

function LibraryKind:preview(_library, _item) end

function LibraryKind:stopPreview() end

function LibraryKind:destroy()
	self:stopPreview()
end

return LibraryKind
]]></ProtectedString>
