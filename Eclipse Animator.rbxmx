						<ProtectedString name="Source"><![CDATA[-- riftkuro
 
 
local layers = {}
layers.names = { "Face", "Eyes", "Mouth" }
local defaults = {
	Face = { Enabled = true, X = 0, Y = 0, Width = 1, Height = 1 },
	Eyes = { Enabled = false, X = 0, Y = 0.12, Width = 1, Height = 0.48 },
	Mouth = { Enabled = false, X = 0.15, Y = 0.58, Width = 0.7, Height = 0.32 },
}
function layers.channel(key)
	return key and defaults[key.Channel] and key.Channel or "Face"
end
function layers.copy(source)
	local result = {}
	for _, name in layers.names do
		local base = defaults[name]
		local item = type(source) == "table" and source[name]
		local value = table.clone(base)
		if type(item) == "table" then
			if type(item.Enabled) == "boolean" then
				value.Enabled = item.Enabled
			end
			for _, field in { "X", "Y", "Width", "Height" } do
				local n = item[field]
				if type(n) == "number" and n == n and math.abs(n) < math.huge then
					value[field] = math.clamp(n, (field == "X" or field == "Y") and -1 or 0.01, 2)
				end
			end
		end
		result[name] = value
	end
	return result
end
return layers
]]></ProtectedString>
