					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local export = {}

 
function export.sampler(raw)
	local rows = {}
	local function objectOf(motor)
		return require("properties").is(motor) and motor.PropertyId == "CFrame" and motor.Rig
			or motor.Part1
	end
	for motor, bucket in require("layers").allTracks(raw) do
		local object = objectOf(motor)
		if not object then
			continue
		end
		local keys = {}
		for _, key in bucket do
			if not key.Disabled and not key.GraphOnly then
				table.insert(keys, key)
			end
		end
		table.sort(keys, function(a, b)
			return a.Time < b.Time
		end)
		rows[object] = rows[object] or {}
		table.insert(rows[object], { keys = keys })
	end
	for _, clip in require("simulationCache").list(raw) do
		if clip.settings.style ~= "Constant" then
			continue
		end
		for motor in clip.tracks do
			local object = objectOf(motor)
			if not object then
				continue
			end
			rows[object] = rows[object] or {}
			table.insert(rows[object], { clip = clip, bucket = raw.Keyframes[motor] })
		end
	end
	return function(object, property, frame)
		if property ~= "CFrame" and property ~= "Transform" then
			return false
		end
		local time = frame / raw.FPS
		for _, row in rows[object] or {} do
			if row.clip then
				if
					frame >= row.clip.first
					and frame < row.clip.last
					and require("simulationCache").contains(row.bucket, time)
				then
					return true
				end
			else
				local low, high, found = 1, #row.keys, 0
				while low <= high do
					local mid = (low + high) // 2
					if row.keys[mid].Time <= time then
						found = mid
						low = mid + 1
					else
						high = mid - 1
					end
				end
				local key = row.keys[found]
				 
				 
				if
					key
					and key.EasingStyle == "Constant"
					and key.Parented == false
					and key.IK == false
					and key.HS == false
				then
					local held = key.Channels and key.Channels.loc_x ~= nil
					for _, point in key.Channels or {} do
						held = held and point.Interpolation == "Constant"
					end
					if held then
						return true
					end
				end
			end
		end
		return false
	end
end

return export
]]></ProtectedString>
