local decoder = {}
decoder.MAX_BYTES = 10 * 1024 * 1024
local function pixels(data, minimum, count)
	assert(minimum >= 2 and minimum <= 8, "Invalid GIF compression")
	local clear = 2 ^ minimum
	local stop = clear + 1
	local size, nextCode, previous, dictionary
	local function reset()
		size, nextCode, previous, dictionary = minimum + 1, stop + 1, nil, {}
		for i = 0, clear - 1 do
			dictionary[i] = string.char(i)
		end
	end
	reset()
	local bit, written, steps = 0, 0, 0
	local out = buffer.create(count)
	while bit + size <= #data * 8 do
		local code = 0
		for i = 0, size - 1 do
			local at = bit + i
			code += bit32.band(bit32.rshift(data:byte(math.floor(at / 8) + 1), at % 8), 1) * 2 ^ i
		end
		bit += size
		if code == clear then
			reset()
		elseif code == stop then
			assert(written == count, "Incomplete GIF frame")
			return out
		else
			local entry = dictionary[code]
			if not entry and code == nextCode and previous then
				entry = previous .. previous:sub(1, 1)
			end
			assert(entry and written + #entry <= count, "Invalid GIF frame data")
			buffer.writestring(out, written, entry)
			written += #entry
			if previous and nextCode < 4096 then
				dictionary[nextCode] = previous .. entry:sub(1, 1)
				nextCode += 1
				if nextCode == 2 ^ size and size < 12 then
					size += 1
				end
			end
			previous = entry
		end
		steps += 1
		if steps % 16384 == 0 then
			task.wait()
		end
	end
	error("GIF frame has no end code")
end

function decoder.decode(data)
	assert(type(data) == "string" and #data <= decoder.MAX_BYTES, "Choose a GIF up to 10 MB")
	assert(data:sub(1, 6) == "GIF89a" or data:sub(1, 6) == "GIF87a", "This file is not a GIF")
	local at = 7
	local function take(n)
		assert(at + n - 1 <= #data, "Truncated GIF file")
		local value = data:sub(at, at + n - 1)
		at += n
		return value
	end
	local function byte()
		return take(1):byte()
	end
	local function word()
		local a, b = take(2):byte(1, 2)
		return a + b * 256
	end
	local function palette(n)
		local colors = {}
		for i = 0, n - 1 do
			local r, g, b = take(3):byte(1, 3)
			colors[i] = r + g * 256 + b * 65536 + 4278190080
		end
		return colors
	end
	local function blocks()
		local chunks = {}
		while true do
			local n = byte()
			if n == 0 then
				break
			end
			table.insert(chunks, take(n))
		end
		return table.concat(chunks)
	end
	local width, height = word(), word()
	assert(
		width > 0 and height > 0 and width <= 1024 and height <= 1024,
		"GIF dimensions must be 1-1024 pixels"
	)
	local flags, bg = byte(), byte()
	byte()
	local global = bit32.band(flags, 128) ~= 0 and palette(2 ^ (bit32.band(flags, 7) + 1)) or nil
	local bytes = width * height * 4
	local canvas = buffer.create(bytes)
	local frames = {}
	local delay, disposal, transparent = 100, 0, nil
	local initialized = false
	while true do
		local marker = byte()
		if marker == 59 then
			break
		end
		if marker == 33 then
			local kind = byte()
			if kind == 249 then
				assert(byte() == 4, "Invalid GIF control block")
				local control = byte()
				delay = word() * 10
				local index = byte()
				transparent = bit32.band(control, 1) ~= 0 and index or nil
				disposal = bit32.band(bit32.rshift(control, 2), 7)
				assert(disposal <= 3 and byte() == 0, "Unsupported GIF disposal")
				if delay == 0 then
					delay = 100
				end
			elseif kind == 1 then
				error("GIF text frames are not supported")
			else
				blocks()
			end
		elseif marker == 44 then
			assert(#frames < 300, "GIF contains more than 300 frames")
			assert(
				bytes * (#frames + 1) <= 64 * 1024 * 1024,
				"GIF is too large when decoded; reduce its dimensions or frame count"
			)
			local x, y, w, h = word(), word(), word(), word()
			assert(
				w > 0 and h > 0 and x + w <= width and y + h <= height,
				"Invalid GIF frame dimensions"
			)
			local packed = byte()
			local colors = bit32.band(packed, 128) ~= 0 and palette(2 ^ (bit32.band(packed, 7) + 1))
				or global
			assert(colors, "GIF color table is missing")
			local background = transparent ~= nil and 0 or global and global[bg] or 0
			if not initialized then
				for p = 0, width * height - 1 do
					buffer.writeu32(canvas, p * 4, background)
				end
				initialized = true
			end
			local prior
			if disposal == 3 then
				prior = buffer.create(bytes)
				buffer.copy(prior, 0, canvas)
			end
			local minimum = byte()
			local indices = pixels(blocks(), minimum, w * h)
			local rows = {}
			if bit32.band(packed, 64) ~= 0 then
				for _, pass in { { 0, 8 }, { 4, 8 }, { 2, 4 }, { 1, 2 } } do
					for row = pass[1], h - 1, pass[2] do
						table.insert(rows, row)
					end
				end
			else
				for row = 0, h - 1 do
					table.insert(rows, row)
				end
			end
			for rowIndex, row in rows do
				for column = 0, w - 1 do
					local index = buffer.readu8(indices, (rowIndex - 1) * w + column)
					if index ~= transparent then
						assert(colors[index], "Invalid GIF color index")
						buffer.writeu32(canvas, ((y + row) * width + x + column) * 4, colors[index])
					end
				end
				if rowIndex % 128 == 0 then
					task.wait()
				end
			end
			local frame = buffer.create(bytes)
			buffer.copy(frame, 0, canvas)
			table.insert(frames, { pixels = frame, delay = delay })
			if disposal == 2 then
				for row = y, y + h - 1 do
					for column = x, x + w - 1 do
						buffer.writeu32(canvas, (row * width + column) * 4, background)
					end
				end
			elseif disposal == 3 then
				canvas = prior
			end
			delay, disposal, transparent = 100, 0, nil
			task.wait()
		else
			error("Unsupported GIF block")
		end
	end
	assert(#frames > 0, "GIF has no image frames")
	return { width = width, height = height, frames = frames }
end

return decoder
]]></ProtectedString>
