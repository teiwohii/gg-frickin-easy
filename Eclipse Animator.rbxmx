					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local geometry = {}

local function classicTriangles(poses, size, widthScale, strength)
	local result = {}
	if #poses < 2 then return result end
	local scale = math.max(size.X, size.Y, size.Z, 0.01)
	local axis = size.Y >= size.X and size.Y >= size.Z and Vector3.yAxis
		or size.X >= size.Z and Vector3.xAxis or Vector3.zAxis
	local side = axis == Vector3.xAxis and Vector3.yAxis or Vector3.xAxis
	local last, previous = poses[#poses], poses[#poses - 1]
	local motion, largest = 0, 0
	for _, point in {Vector3.zero, axis * scale * 0.5, -axis * scale * 0.5, side * scale * 0.25} do
		motion = math.max(motion, (last:PointToWorldSpace(point) - previous:PointToWorldSpace(point)).Magnitude)
		for index = 2, #poses do
			largest = math.max(largest, (poses[index]:PointToWorldSpace(point) - poses[index - 1]:PointToWorldSpace(point)).Magnitude)
		end
	end
	if largest < scale * 0.001 or largest > scale * 3 then return result end
	motion = math.max(motion, largest)
	local extension = (strength or 1) ^ 1.4
	local travel = last.Position - poses[1].Position
	local tip = axis * scale * 0.5
	local axialMotion = math.max((last:PointToWorldSpace(tip) - previous:PointToWorldSpace(tip)).Magnitude,
		(last:PointToWorldSpace(-tip) - previous:PointToWorldSpace(-tip)).Magnitude)
	if axialMotion < motion * 0.1 or travel.Magnitude > 1e-5 and math.abs(travel.Unit:Dot(last:VectorToWorldSpace(axis))) > 0.85 then
		axis = side
		scale = math.max(math.abs(size:Dot(axis)), 0.01)
	end
	local function add(a, b, c, t0, t1, t2)
		if (b - a):Cross(c - a).Magnitude > 1e-7 then
			table.insert(result, {a, b, c, phase = {t0, t1, t2}})
		end
	end
	for lane = 1, 5 do
		local center = (lane - 3) * scale / 5
		local width = scale * 0.096 * (widthScale or 1)
		local laneMotion = 0
		for index = 2, #poses do
			laneMotion = math.max(laneMotion, (poses[index]:PointToWorldSpace(axis * center) - poses[index - 1]:PointToWorldSpace(axis * center)).Magnitude)
		end
		if laneMotion < motion * .28 then continue end
		local start = lane % 3 == 0 and 2 or 1
		local function edge(index, sign)
			local t = (index - start) / (#poses - start)
			local taper = 0.06 + 0.94 * math.sqrt(t)
			local shift = (lane % 2 == 0 and 1 or -1) * width * (1 - t) * 0.7
			local point = axis * math.clamp(center + shift + sign * width * taper, -scale * .48, scale * .48)
			local first, second = math.max(1, index - 1), math.min(#poses, index + 1)
			local velocity = poses[second]:PointToWorldSpace(point) - poses[first]:PointToWorldSpace(point)
			local localVelocity = poses[index]:VectorToObjectSpace(velocity)
			localVelocity -= axis * localVelocity:Dot(axis)
			if localVelocity.Magnitude > 1e-6 then
				local direction = localVelocity.Unit
				local radius = (math.abs(direction.X) * size.X + math.abs(direction.Y) * size.Y
					+ math.abs(direction.Z) * size.Z) * 0.5
				point -= direction * (radius + 0.01)
			end
			local current = last:PointToWorldSpace(point)
			return current + (poses[index]:PointToWorldSpace(point) - current) * extension
		end
		for index = start, #poses - 1 do
			local a, b = edge(index, -1), edge(index, 1)
			local c, d = edge(index + 1, -1), edge(index + 1, 1)
			local t0, t1 = (index - 1) / (#poses - 1), index / (#poses - 1)
			add(a, b, c, t0, t0, t1)
			add(b, d, c, t0, t1, t1)
		end
	end
	return result
end

function geometry.triangles(poses, size, widthScale, strength, style)
	if style == nil or style == "Classic" then return classicTriangles(poses, size, widthScale, strength) end
	assert(style == "Crescent" or style == "Slashes" or style == "Brush", "Unknown smear style")
	local result = {}
	if #poses < 2 then return result end
	local scale = math.max(size.X, size.Y, size.Z, .01)
	local axis = size.Y >= size.X and size.Y >= size.Z and Vector3.yAxis
		or size.X >= size.Z and Vector3.xAxis or Vector3.zAxis
	local side = axis == Vector3.xAxis and Vector3.yAxis or Vector3.xAxis
	local last = poses[#poses]
	local largest = 0
	for _, point in {Vector3.zero, axis * scale * .5, -axis * scale * .5, side * scale * .25} do
		for i = 2, #poses do
			largest = math.max(largest, (poses[i]:PointToWorldSpace(point) - poses[i - 1]:PointToWorldSpace(point)).Magnitude)
		end
	end
	if largest < scale * .001 or largest > scale * 3 then return result end
	local travel = last.Position - poses[1].Position
	local tip = axis * scale * .5
	local axialMotion = math.max((last:PointToWorldSpace(tip) - poses[#poses - 1]:PointToWorldSpace(tip)).Magnitude,
		(last:PointToWorldSpace(-tip) - poses[#poses - 1]:PointToWorldSpace(-tip)).Magnitude)
	if axialMotion < largest * .1 or travel.Magnitude > 1e-5 and math.abs(travel.Unit:Dot(last:VectorToWorldSpace(axis))) > .85 then
		axis = side
		scale = math.max(math.abs(size:Dot(axis)), .01)
	end
	local extension = (strength or 1) ^ 1.4
	local function poseAt(t)
		local at = math.clamp(t, 0, 1) * (#poses - 1)
		local i = math.min(math.floor(at) + 1, #poses - 1)
		return poses[i]:Lerp(poses[i + 1], at - i + 1)
	end
	local function add(a, b, c, ta, tb, tc)
		if (b - a):Cross(c - a).Magnitude > 1e-7 then
			table.insert(result, {a, b, c, phase = {ta, tb, tc}, smooth = true})
		end
	end
	local lanes = style == "Crescent" and {{0, .32, 0, 1}, {-.41, .025, .14, .92}, {.41, .018, .32, .96}}
		or style == "Slashes" and {{-.34, .105, .18, .98}, {0, .15, 0, 1}, {.35, .07, .34, .91}}
		or {}
	if style == "Brush" then
		for i = 1, 13 do
			local variation = ((i * 7) % 11) / 11
			table.insert(lanes, {(i - 7) * .069, .017 + variation * .016, variation * .3, .91 + (i % 3) * .045})
		end
	end
	for lane, spec in lanes do
		local center, halfWidth, begin, finish = spec[1] * scale, spec[2] * scale * (widthScale or 1), spec[3], spec[4]
		local moving = 0
		for i = 2, #poses do
			moving = math.max(moving, (poses[i]:PointToWorldSpace(axis * center) - poses[i - 1]:PointToWorldSpace(axis * center)).Magnitude)
		end
		if moving < largest * .28 then continue end
		local function edge(u, sign)
			local t = begin + (finish - begin) * u
			local cf = poseAt(t)
			local taper = math.sin(math.pi * u) ^ (style == "Brush" and .65 or .85)
			local sweep = (lane % 2 == 0 and -1 or 1) * halfWidth * .3 * math.sin(math.pi * u)
			local offset = math.clamp(center + sweep + sign * halfWidth * taper, -scale * .48, scale * .48)
			local point = axis * offset
			local velocity = poseAt(math.min(1, t + .015)):PointToWorldSpace(point) - poseAt(math.max(0, t - .015)):PointToWorldSpace(point)
			local localVelocity = cf:VectorToObjectSpace(velocity)
			localVelocity -= axis * localVelocity:Dot(axis)
			if localVelocity.Magnitude > 1e-6 then
				local direction = localVelocity.Unit
				local radius = (math.abs(direction.X) * size.X + math.abs(direction.Y) * size.Y + math.abs(direction.Z) * size.Z) * .5
				point -= direction * (radius + .012)
			end
			local current = last:PointToWorldSpace(point)
			return current + (cf:PointToWorldSpace(point) - current) * extension, t
		end
		local segments = style == "Brush" and 12 or 20
		for i = 0, segments - 1 do
			if style == "Brush" and lane % 4 == 0 and i == 3 + lane % 3 then continue end
			local a, ta = edge(i / segments, -1)
			local b, tb = edge(i / segments, 1)
			local c, tc = edge((i + 1) / segments, -1)
			local d, td = edge((i + 1) / segments, 1)
			add(a, b, c, ta, tb, tc)
			add(b, d, c, tb, td, tc)
		end
	end
	return result
end

function geometry.new(parent)
	local model = Instance.new("Model")
	model.Name = "Smear"
	model.Archivable = false
	model:SetAttribute("EclipseGeneratedVisual", true)
	return {model = model, parent = parent, parts = {}}
end

local function wedge(slot, index, size, cf, color)
	local part = slot.parts[index]
	if not part then
		part = Instance.new("WedgePart")
		part.Name = "Stroke"
		part.Anchored = true
		part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		part.CastShadow, part.Locked, part.Archivable = false, true, false
		part.Material = Enum.Material.SmoothPlastic
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part.Parent = slot.model
		slot.parts[index] = part
	end
	part.Size, part.CFrame, part.Color, part.Transparency = size, cf, color, 0
end

function geometry.ramp(stops, fraction)
 if fraction <= stops[1].at then return stops[1].color, stops[1].alpha end
 for index = 2, #stops do
  local a, b = stops[index - 1], stops[index]
  if fraction <= b.at then
   local t = math.clamp((fraction - a.at) / math.max(1e-6, b.at - a.at), 0, 1)
   return a.color:Lerp(b.color, t), a.alpha + (b.alpha - a.alpha) * t
  end
 end
 return stops[#stops].color, stops[#stops].alpha
end

function geometry.render(slot, triangles, color, opacity, ramp)
 if opacity and opacity <= 1e-5 then geometry.hide(slot); return 0 end
 if ramp and #ramp > 1 then
  local expanded = {}
  local function split(a, b, c, ta, tb, tc, depth)
   if depth == 0 then table.insert(expanded, {a, b, c, phase = {ta, tb, tc}}); return end
   local ab, ac, bc = a:Lerp(b, .5), a:Lerp(c, .5), b:Lerp(c, .5)
   local tab, tac, tbc = (ta + tb) * .5, (ta + tc) * .5, (tb + tc) * .5
   split(a, ab, ac, ta, tab, tac, depth - 1)
   split(ab, b, bc, tab, tb, tbc, depth - 1)
   split(ac, bc, c, tac, tbc, tc, depth - 1)
   split(ab, bc, ac, tab, tbc, tac, depth - 1)
  end
  for _, triangle in triangles do
   local phase = triangle.phase or {0, .5, 1}
   split(triangle[1], triangle[2], triangle[3], phase[1], phase[2], phase[3], triangle.smooth and 0 or 1)
  end
  triangles = expanded
 end
	local count = 0
	for _, triangle in triangles do
		local a, b, c = triangle[1], triangle[2], triangle[3]
		local paint, alpha = color, opacity or 1
		if ramp then
			local phase = triangle.phase
			local stopAlpha
			paint, stopAlpha = geometry.ramp(ramp, (phase[1] + phase[2] + phase[3]) / 3)
			alpha *= stopAlpha
		end
		local ab, ac, bc = b - a, c - a, c - b
		if ab:Dot(ab) > ac:Dot(ac) and ab:Dot(ab) > bc:Dot(bc) then a, c = c, a
		elseif ac:Dot(ac) > bc:Dot(bc) then a, b = b, a end
		ab, ac, bc = b - a, c - a, c - b
		local normal = ac:Cross(ab)
		if normal.Magnitude < 1e-7 or bc.Magnitude < 1e-5 then continue end
		local right, back = normal.Unit, bc.Unit
		local up = back:Cross(right)
		local height = math.abs(ab:Dot(up))
		local thickness = math.max(0.001, math.min(height * 0.01, 0.01))
		count += 1
		wedge(slot, count, Vector3.new(thickness, height, math.abs(ab:Dot(back))), CFrame.fromMatrix((a + b) * 0.5, right, up, back), paint)
		count += 1
		wedge(slot, count, Vector3.new(thickness, height, math.abs(ac:Dot(back))), CFrame.fromMatrix((a + c) * 0.5, -right, up, -back), paint)
		slot.parts[count - 1].Transparency, slot.parts[count].Transparency = 1 - alpha, 1 - alpha
	end
	for index = count + 1, #slot.parts do slot.parts[index].Transparency = 1 end
	slot.model.Parent = count > 0 and slot.parent or nil
	return count
end

function geometry.hide(slot)
	slot.model.Parent = nil
end

function geometry.destroy(slot)
	slot.model:Destroy()
	table.clear(slot.parts)
end

return geometry
]]></ProtectedString>
