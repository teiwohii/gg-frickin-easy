				<Item class="ModuleScript" referent="RBX63ACBA783C9B414BBB3B7A0F7630AA02">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local options = {}

local function number(value, low, high, label, integer)
	assert(
		type(value) == "number"
			and value == value
			and value >= low
			and value <= high
			and (not integer or value % 1 == 0),
		"Invalid " .. label
	)
	return value
end

local function vector(value, maximum, label)
	assert(typeof(value) == "Vector3", "Enter all three " .. label .. " values")
	for _, component in { value.X, value.Y, value.Z } do
		number(component, -maximum, maximum, label)
	end
	return value
end

function options.copy(settings)
	local copy = {}
	for _, name in { "pushSpace", "spinSpace", "angularVelocity", "style", "interval", "intervals" } do
		copy[name] = settings and settings[name]
	end
	copy.pushSpace = copy.pushSpace or "World"
	copy.spinSpace = copy.spinSpace or "World"
	copy.angularVelocity = copy.angularVelocity or Vector3.zero  
	copy.style = copy.style or "Default"
	copy.interval = copy.interval or 3
	copy.intervals = table.clone(copy.intervals or {})
	copy.events = {}
	for _, event in (settings and settings.events) or {} do
		table.insert(copy.events, table.clone(event))
	end
	return copy
end

function options.equal(a, b)
	local function same(left, right)
		if type(left) ~= "table" or type(right) ~= "table" then
			return left == right
		end
		for key, value in left do
			if not same(value, right[key]) then
				return false
			end
		end
		for key in right do
			if left[key] == nil then
				return false
			end
		end
		return true
	end
	return same(options.copy(a), options.copy(b))
end

function options.validate(settings, targets)
	for _, space in { settings.pushSpace or "World", settings.spinSpace or "World" } do
		assert(space == "World" or space == "Local", "Choose World or Local space")
	end
	vector(settings.angularVelocity or Vector3.zero, 10, "spin (turns/s)")
	assert(
		settings.style == nil or settings.style == "Default" or settings.style == "Constant",
		"Invalid physics style"
	)
	number(settings.interval or 3, 1, 2400, "sample interval", true)
	for target, interval in settings.intervals or {} do
		assert(type(target) == "string", "Invalid sampling target")
		number(interval, 1, 2400, "limb sample interval", true)
	end
	assert(#(settings.events or {}) <= 128, "Use up to 128 physics events per simulation")
	for _, event in settings.events or {} do
		number(event.frame, settings.first, settings.last, "event frame", true)
		assert(event.mode == "Set" or event.mode == "Add", "Choose Set or Add velocity")
		assert(
			event.space == "World" or event.space == "Local",
			"Choose event World or Local space"
		)
		assert(type(event.target) == "string", "Choose an event target")
		assert(
			not targets or event.target == "All" or targets[event.target],
			"A physics event target is missing; choose it again"
		)
		vector(event.velocity, 500, "event push")
		vector(event.angular, 10, "event spin (turns/s)")
	end
end

function options.identity(entry)
	local id = entry.rig:GetAttribute("EclipseTrackId")
	if not id then
		id = game:GetService("HttpService"):GenerateGUID(false)
		entry.rig:SetAttribute("EclipseTrackId", id)
	end
	assert(type(id) == "string", "The physics rig has no saved track identity")
	local part = require("scene").part(entry.motor)
	local path = require("paths").of(part, entry.rig)
	assert(path, "The physics part is outside its rig")
	return "Part:" .. id .. ":" .. path, "Rig:" .. id
end

function options.targets(entries)
	local result = { { id = "All", label = "All participants" } }
	local seen = { All = true }
	for _, entry in entries do
		local partId, rigId = options.identity(entry)
		if not seen[rigId] then
			table.insert(result, { id = rigId, label = entry.rig.Name .. " (rig)" })
			seen[rigId] = true
		end
		if not seen[partId] then
			table.insert(result, { id = partId, label = require("scene").name(entry.motor) })
			seen[partId] = true
		end
	end
	return result, seen
end

function options.world(value, space, basis)
	return space == "Local" and basis:VectorToWorldSpace(value) or value
end

function options.schedule(settings, bodies)
	local targets, schedule = {}, {}
	for _, body in bodies do
		if body.partId then
			targets[body.partId] = true
		end
		if body.rigId then
			targets[body.rigId] = true
		end
	end
	options.validate(settings, targets)
	for _, event in settings.events or {} do
		local frame = math.max(settings.first + 1, event.frame)
		schedule[frame] = schedule[frame] or {}
		table.insert(schedule[frame], event)
	end
	return schedule
end

local function matches(event, body)
	return event.target == "All" or event.target == body.partId or event.target == body.rigId
end

function options.release(events, bodies, bySource, retired, release)
	for _, event in events or {} do
		for _, body in bodies do
			local part = bySource[body.part]
			if part and not retired[part] and matches(event, body) then
				release(part)
			end
		end
	end
end

function options.apply(events, bodies, bySource, retired)
	for _, event in events or {} do
		local applied, rigFrames, priorities = {}, {}, {}
		 
		for _, body in bodies do
			local part = bySource[body.part]
			if
				part
				and not retired[part]
				and body.rigId
				and (
					not rigFrames[body.rigId]
					or (body.basisPriority or math.huge) < priorities[body.rigId]
				)
			then
				rigFrames[body.rigId] = part.CFrame
					* body.frame:ToObjectSpace(body.basis or body.frame)
				priorities[body.rigId] = body.basisPriority or math.huge
			end
		end
		for _, body in bodies do
			local part = bySource[body.part]
			if not part or retired[part] or not matches(event, body) then
				continue
			end
			local assembly = part.AssemblyRootPart or part
			if applied[assembly] then
				continue
			end
			applied[assembly] = true
			local basis = event.target == body.partId and part.CFrame
				or rigFrames[body.rigId]
				or part.CFrame
			local linear = options.world(event.velocity, event.space, basis)
			local angular = options.world(event.angular * (2 * math.pi), event.space, basis)
			if event.mode == "Add" then
				linear += part.AssemblyLinearVelocity
				angular += part.AssemblyAngularVelocity
			end
			part.AssemblyLinearVelocity, part.AssemblyAngularVelocity = linear, angular
		end
	end
end

function options.keep(settings, frame, partId, rigId)
	if settings.style ~= "Constant" then
		return true
	end
	local interval = (settings.intervals or {})[partId]
		or (settings.intervals or {})[rigId]
		or settings.interval
		or 3
	return frame == settings.first
		or frame == settings.last
		or (frame - settings.first) % interval == 0
end

function options.styleKey(settings, key)
	if settings.style ~= "Constant" then
		return
	end
	key.EasingStyle, key.EasingDirection = "Constant", "In"
	for _, points in { key.Channels or {}, key.GraphCurves or {} } do
		for _, point in points do
			point.Interpolation = "Constant"
			point.EasingStyle, point.EasingDirection = "Constant", "In"
			point.In, point.Out, point.BlenderHandles = nil, nil, nil
		end
	end
end

return options
]]></ProtectedString>
