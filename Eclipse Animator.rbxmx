						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local runService = game:GetService("RunService")
local tweenService = game:GetService("TweenService")
local theme = require("theme")
local chrome = require("chrome")
local windowFx = require("windowFx")
local inputModule = require("userInputService")
local rawState = require("rawState")
local fxKeys = require("fxKeys")
local fxEmit = require("fxEmit")
local shortcuts = require("shortcuts")
local preferences = require("preferences")
local FxLayout = require("FxLayout")

local KeyEditor = {}
KeyEditor.__index = KeyEditor

local pickerSize = Vector2.new(300, 360)
local headerHeight = 34
local footerHeight = 34
local rowHeight = 22
local indentWidth = 12
local margin = 12
local gap = 8
local zIndex = 160
local fadeInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local sceneFolderName = "Eclipse FX"
local white = Color3.new(1, 1, 1)
local emptyText = "Nothing to emit yet. Add particles, beams or meshes in the Scene, or put VFX inside your rig."

local function make(className, parent, name, props)
	local object = Instance.new(className)
	object.Name = name
	for key, value in props do
		object[key] = value
	end

	object.Parent = parent
	return object
end

local function tag(object, attribute, key)
	object:SetAttribute(attribute, key)
	return object
end

local function round(object, radius)
	make("UICorner", object, "Corner", { CornerRadius = UDim.new(0, radius) })
end

local function surface(object, z)
	object.BackgroundColor3 = white
	object.BorderSizePixel = 0
	round(object, 4)
	tag(
		make("UIGradient", object, "PanelGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(58, 33, 84)),
				ColorSequenceKeypoint.new(0.45, Color3.fromRGB(28, 10, 42)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(13, 4, 20)),
			}),
		}),
		"ThemeGrad",
		"Menu"
	)
	local inner = make("Frame", object, "InnerStroke", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -2, 1, -2),
		BackgroundTransparency = 1,
		Active = false,
		Interactable = false,
		ZIndex = z,
	})
	round(inner, 3)
	tag(
		make("UIStroke", inner, "UIStroke", {
			Color = Color3.fromRGB(107, 0, 139),
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		"ThemeStrk",
		"Strk"
	)
end

local function text(parent, name, props)
	local label = make("TextLabel", parent, name, {
		BackgroundTransparency = 1,
		FontFace = chrome.FONT,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(235, 228, 242),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Active = false,
		Interactable = false,
	})
	for key, value in props do
		label[key] = value
	end

	return tag(label, "ThemeTxt", "Txt")
end

function KeyEditor.new(options)
	local self = setmetatable({
		options = options,
		gui = options.gui,
		timeline = options.timeline,
		host = options.host,
		state = options.state,
		connections = {},
		watchers = {},
		selection = {},
		primary = nil,
		focused = false,
		picker = nil,
		lastFrame = nil,
		destroyed = false,
	}, KeyEditor)

	self.views = {}
	self.viewCallbacks = {}
	self:addView(self.timeline)

	local unsubscribe = fxKeys.subscribe(function()
		if not self.destroyed then
			self:sync()
		end
	end)
	table.insert(self.connections, { Disconnect = unsubscribe })

	self:connect(runService.Heartbeat, function()
		self:step()
	end)
	self:connect(inputModule.InputBegan, function(input)
		self:onInput(input)
	end)

	if self.state then
		self.focusApi = {
			hasFocus = function()
				return self:hasFocus()
			end,
			claims = function(input)
				return self:claims(input)
			end,
			advance = function(first, last, inclusive)
				return self:advance(first, last, inclusive)
			end,
			selectAll = function()
				self:selectAll()
			end,
		}
		self.state.EclipseFXKeys = self.focusApi
	end

	self:setupScrub()
	self.meshScrub = require("MeshScrub").new()
	self:sync()
	return self
end

function KeyEditor:callbacksFor(view)
	return {
		onAddKey = function(frame)
			self:addKey(frame)
		end,
		onSelectKey = function(id)
			self:selectOnly(id, false)
		end,
		onClickKey = function(id)
			self:selectOnly(id, true)
		end,
		onToggleKey = function(id)
			self:toggle(id)
		end,
		onDeselectKey = function()
			self:clearSelection()
		end,
		onMoveKeys = function(delta)
			self:moveSelected(delta)
		end,
		onBoxSelect = function(from, to, additive)
			self:boxSelect(from, to, additive)
		end,
		onOpenKey = function(id)
			self:selectOnly(id, false)
			self:openPicker(id, view)
		end,
		onSelectAll = function()
			self.focused = true
			self:selectAll()
		end,
		onFocus = function()
			self.focused = true
		end,
	}
end

function KeyEditor:addView(view)
	if not view or self.viewCallbacks[view] then
		return
	end

	local callbacks = self:callbacksFor(view)
	for name, callback in callbacks do
		view.options[name] = callback
	end

	self.viewCallbacks[view] = callbacks
	table.insert(self.views, view)
	view:setKeys(self:keyList(), self.selection)
end

function KeyEditor:removeView(view)
	local callbacks = self.viewCallbacks[view]
	if not callbacks then
		return
	end

	self.viewCallbacks[view] = nil
	for name, callback in callbacks do
		if view.options[name] == callback then
			view.options[name] = nil
		end
	end

	local index = table.find(self.views, view)
	if index then
		table.remove(self.views, index)
	end

	self:closePickerFor(view, true)
end

function KeyEditor:pushKeys()
	local keys = self:keyList()
	for _, view in self.views do
		view:setKeys(keys, self.selection)
	end
end

function KeyEditor:setupScrub()
	local host = self.host
	if not host or not host.requireArc then
		return
	end

	local okClock, ParticleClock = pcall(host.requireArc, host, "Animation", "ParticleClock")
	local okStyle, emitStyle = pcall(host.requireArc, host, "Utility", "emitStyle")
	if not okClock or not okStyle or not ParticleClock or not emitStyle then
		return
	end

	pcall(ParticleClock.recover, workspace)
	self.emitStyle = emitStyle
	self.scrubEmitters = {}
	self.scrubWatchers = {}
	self.nextScrubCheck = 0

	local clock = ParticleClock.new()
	clock:setTargetProvider(function()
		return rawState.Timeline.CurrentTime or 0
	end)
	clock:setPlayingProvider(function()
		return rawState.Timeline.Playing == true
	end)
	clock:setFrameDurationProvider(function()
		local fps = rawState.Timeline.FPS
		return if fps and fps > 0 then 1 / fps else 1 / 60
	end)
	clock:setEventsProvider(function()
		return self:scrubEvents()
	end)
	self.clock = clock
end

function KeyEditor:emitValue(emitter, name)
	local ok, value = pcall(self.emitStyle.getValue, emitter, name)
	return ok and tonumber(value) or 0
end

function KeyEditor:scrubEvents()
	local events = require("emitKeys").events(rawState.Timeline)
	local fps = rawState.Timeline.FPS or 60
	for _, key in fxKeys.list() do
		for _, emitter in fxEmit.nativeEmitters(fxKeys.targets(key.Id)) do
			local count = math.max(0, math.round(self:emitValue(emitter, "EmitCount")))
			if count > 0 then
				table.insert(events, {
					emitter = emitter,
					start = key.Frame / fps + math.max(0, self:emitValue(emitter, "EmitDelay")),
					duration = math.max(0, self:emitValue(emitter, "EmitDuration")),
					count = count,
				})
			end
		end
	end

	return events
end

function KeyEditor:previewMode()
	local timeline = rawState.Timeline
	if timeline.Playing then
		self.wasPlaying = true
		self.pausedAt = nil
		return "play"
	end

	if self.wasPlaying then
		self.wasPlaying = false
		self.pausedAt = timeline.CurrentTime
	end

	if self.pausedAt ~= nil and timeline.CurrentTime == self.pausedAt then
		return "pause"
	end

	self.pausedAt = nil
	return "seek"
end

function KeyEditor:previewAllowed()
	local mode = self:previewMode()
	if mode == "play" then
		return true
	end

	local key = if mode == "pause" then "VFXPausePreview" else "VFXScrubberPreview"
	local ok, enabled = pcall(preferences.get, key)
	return not ok or enabled ~= false
end

function KeyEditor:wantedScrubEmitters()
	if self.destroyed or self.scrubSuspended or not self:isActive() or not self:previewAllowed() then
		return {}
	end

	local seen, list = {}, {}
	for _, event in require("emitKeys").events(rawState.Timeline) do
		if not seen[event.emitter] then
			seen[event.emitter] = true
			table.insert(list, event.emitter)
		end
	end
	for _, key in fxKeys.list() do
		for _, emitter in fxEmit.nativeEmitters(fxKeys.targets(key.Id)) do
			if not seen[emitter] then
				seen[emitter] = true
				table.insert(list, emitter)
			end
		end
	end

	return list
end

function KeyEditor:unwatchScrub()
	for _, connection in self.scrubWatchers or {} do
		connection:Disconnect()
	end

	self.scrubWatchers = {}
end

function KeyEditor:refreshScrub(invalidate)
	if self.scrubSuspended or not self:isActive() then self:clearBeamScrub() end
	local clock = self.clock
	if not clock then
		return
	end
	local events = self:scrubEvents()
	local previous = self.scrubEventsSnapshot or {}
	if #events ~= #previous then
		invalidate = true
	else
		for index, event in events do
			local before = previous[index]
			if event.emitter ~= before.emitter or event.start ~= before.start
				or event.duration ~= before.duration or event.count ~= before.count
			then
				invalidate = true
				break
			end
		end
	end
	self.scrubEventsSnapshot = events

	local wanted = self:wantedScrubEmitters()
	local current = self.scrubEmitters
	local same = #wanted == #current
	if same then
		local lookup = {}
		for _, emitter in current do
			lookup[emitter] = true
		end

		for _, emitter in wanted do
			if not lookup[emitter] then
				same = false
				break
			end
		end
	end

	if same then
		if invalidate then
			clock:invalidate()
		end

		return
	end

	self:unwatchScrub()
	self.scrubEmitters = wanted
	if #wanted == 0 then
		clock:stop(true)
		return
	end

	clock:start(wanted)
	local function changed()
		if not rawState.Timeline.Playing then
			clock:invalidate()
		end
	end

	for _, emitter in wanted do
		table.insert(self.scrubWatchers, emitter.Changed:Connect(function(property)
			if property ~= "TimeScale" and property ~= "Enabled" then
				changed()
			end
		end))
		table.insert(self.scrubWatchers, emitter.AttributeChanged:Connect(function(name)
			if string.sub(name, 1, 8) ~= "ArcClock" then
				changed()
			end
		end))
	end
end

function KeyEditor:suspendScrub()
	if not self.clock then
		return
	end

	self.scrubSuspended = true
	self.suspendedAt = rawState.Timeline.CurrentTime
	self:refreshScrub()
end

function KeyEditor:isScrubbing(emitter)
	return self.clock ~= nil and self.clock:isControlling(emitter)
end

function KeyEditor:connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

function KeyEditor:isActive()
	local check = self.options.isActive
	return check == nil or check()
end

function KeyEditor:currentFrame()
	local timeline = rawState.Timeline
	local fps = timeline.FPS or 60
	return math.max(0, math.floor(timeline.CurrentTime * fps + 0.5))
end

function KeyEditor:keyList()
	local list = {}
	for _, key in fxKeys.list() do
		table.insert(list, { Id = key.Id, Frame = key.Frame, Count = #fxKeys.targets(key.Id) })
	end

	return list
end

function KeyEditor:selectedIds()
	local ids = {}
	for _, key in fxKeys.list() do
		if self.selection[key.Id] then
			table.insert(ids, key.Id)
		end
	end

	return ids
end

function KeyEditor:sync()
	for id in table.clone(self.selection) do
		if not fxKeys.get(id) then
			self.selection[id] = nil
		end
	end

	if self.primary and not fxKeys.get(self.primary) then
		self.primary = nil
	end

	self:pushKeys()
	local timeline = self.state and self.state.Timeline
	if timeline then
		timeline._playbackEndAt = nil
		local last = fxKeys.lastFrame()
		if last and timeline.EnsureTimelineEnd then timeline:EnsureTimelineEnd(last) end
	end
	self:refreshScrub(true)
	if self.picker then
		if not fxKeys.get(self.picker.id) then
			self:closePicker()
		else
			self:refreshPicker()
		end
	end
end

function KeyEditor:refreshKeys()
	self:pushKeys()
end

function KeyEditor:seek(frame)
	local state = self.state
	local timeline = state and state.Timeline
	local fps = rawState.Timeline.FPS
	if not timeline or not fps or fps <= 0 or rawState.Timeline.Playing then
		return
	end

	pcall(function()
		timeline:SeekToTime(frame / fps, function()
			return state.currentRig
		end)
	end)
end

function KeyEditor:selectOnly(id, seek)
	table.clear(self.selection)
	if id then
		self.selection[id] = true
	end

	self.primary = id
	self.focused = true
	self:refreshKeys()
	local key = id and fxKeys.get(id)
	if seek and key then
		self:seek(key.Frame)
	end
end

function KeyEditor:toggle(id)
	self.selection[id] = not self.selection[id] or nil
	self.primary = self.selection[id] and id or self.primary
	self.focused = true
	self:refreshKeys()
end

function KeyEditor:clearSelection()
	table.clear(self.selection)
	self.primary = nil
	self.focused = true
	self:refreshKeys()
end

function KeyEditor:selectAll()
	for _, key in fxKeys.list() do
		self.selection[key.Id] = true
	end

	self:refreshKeys()
end

function KeyEditor:boxSelect(from, to, additive)
	if not self.boxBase then
		self.boxBase = additive and table.clone(self.selection) or {}
	end

	table.clear(self.selection)
	for id in self.boxBase do
		self.selection[id] = true
	end

	for _, key in fxKeys.list() do
		if key.Frame >= from - 0.5 and key.Frame <= to + 0.5 then
			self.selection[key.Id] = true
		end
	end

	self.focused = true
	self:refreshKeys()
end

function KeyEditor:record(description, change)
	local before = fxKeys.snapshot()
	local result = change()
	local after = fxKeys.snapshot()
	local ok, history = pcall(require, "history")
	if ok and history and history.record then
		history.record(function()
			fxKeys.restore(before)
		end, function()
			fxKeys.restore(after)
		end, description)
	end

	return result
end

function KeyEditor:addKey(frame)
	frame = math.max(0, math.round(tonumber(frame) or self:currentFrame()))
	local key = self:record("Add emit keyframe", function()
		return (fxKeys.add(frame))
	end)
	self:selectOnly(key.Id, false)
end

function KeyEditor:moveSelected(delta)
	local ids = self:selectedIds()
	if #ids == 0 then
		return
	end

	self:record("Move emit keyframes", function()
		fxKeys.shift(ids, delta)
	end)
end

function KeyEditor:deleteSelected()
	local ids = self:selectedIds()
	if #ids == 0 then
		return false
	end

	if self.picker and table.find(ids, self.picker.id) then
		self:closePicker()
	end

	self:record(#ids == 1 and "Delete emit keyframe" or "Delete emit keyframes", function()
		fxKeys.removeMany(ids)
	end)
	table.clear(self.selection)
	self.primary = nil
	return true
end

function KeyEditor:deleteKey(id)
	table.clear(self.selection)
	self.selection[id] = true
	self:deleteSelected()
end

function KeyEditor:setTarget(id, instance, enabled)
	self:record(enabled and "Add emit target" or "Remove emit target", function()
		fxKeys.setTarget(id, instance, enabled)
	end)
end

function KeyEditor:copySelected()
	local ids = self:selectedIds()
	if #ids == 0 then
		return false
	end

	local first = math.huge
	for _, id in ids do
		first = math.min(first, fxKeys.get(id).Frame)
	end

	local entries = {}
	for _, id in ids do
		local key = fxKeys.get(id)
		table.insert(entries, { offset = key.Frame - first, targets = fxKeys.targets(id) })
	end

	KeyEditor.clipboard = entries
	return true
end

function KeyEditor:paste(flipped)
	local entries = KeyEditor.clipboard
	if not entries or #entries == 0 then
		return false
	end

	local span = 0
	for _, entry in entries do
		span = math.max(span, entry.offset)
	end

	local start = self:currentFrame()
	local created = self:record("Paste emit keyframes", function()
		local result = {}
		for _, entry in entries do
			local offset = if flipped then span - entry.offset else entry.offset
			local key = fxKeys.insert(start + offset, entry.targets)
			result[key.Id] = true
		end

		return result
	end)

	table.clear(self.selection)
	for id in created do
		self.selection[id] = true
	end

	self:refreshKeys()
	return true
end

function KeyEditor:jump(direction)
	local current = self:currentFrame()
	local target
	for _, key in fxKeys.list() do
		if direction < 0 and key.Frame < current then
			target = key.Frame
		elseif direction > 0 and key.Frame > current and not target then
			target = key.Frame
		end
	end

	if target then
		self:seek(target)
	end
end

function KeyEditor:pointerOver(frame)
	if not frame or not frame.Visible then
		return false
	end

	local pointer = inputModule:GetMouseLocation()
	local position, size = frame.AbsolutePosition, frame.AbsoluteSize
	return pointer.X >= position.X
		and pointer.X <= position.X + size.X
		and pointer.Y >= position.Y
		and pointer.Y <= position.Y + size.Y
end

function KeyEditor:pointerInside()
	for _, view in self.views do
		if view.pointerInside then
			if view:pointerInside() then
				return true
			end
		elseif view:isShown() and self:pointerOver(view.window) then
			return true
		end
	end

	return self.picker ~= nil and self:pointerOver(self.picker.frame)
end

function KeyEditor:anyViewShown()
	for _, view in self.views do
		if view:isShown() then
			return true
		end
	end

	return false
end

function KeyEditor:hasFocus()
	if self.destroyed or not self:isActive() or not self:anyViewShown() then
		return false
	end

	return self.focused or self:pointerInside()
end

local claimedActions = {
	"DeleteKeys",
	"CutKeyframes",
	"Copy",
	"CopyKeyframes",
	"Paste",
	"PasteKeyframes",
	"PasteFlipped",
	"SelectAll",
	"JumpKeyframeLeft",
	"JumpKeyframeRight",
	"JumpSingleKeyframeLeft",
	"JumpSingleKeyframeRight",
}

function KeyEditor:action(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return nil
	end

	if input.KeyCode == Enum.KeyCode.Delete or input.KeyCode == Enum.KeyCode.Backspace then
		return "DeleteKeys"
	end

	for _, name in claimedActions do
		if shortcuts.matches(name, input) then
			return name
		end
	end

	return nil
end

function KeyEditor:claims(input)
	return self:hasFocus() and self:action(input) ~= nil
end

function KeyEditor:notify(text)
	pcall(function()
		require("notification").show("NOTIFICATION", text, 1.5, "KeyframeAction")
	end)
end

function KeyEditor:onInput(input)
	if self.destroyed then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
		self.focused = self:pointerInside()
		self.boxBase = nil
		if not self.focused and input.UserInputType == Enum.UserInputType.MouseButton1 and next(self.selection) then
			table.clear(self.selection)
			self.primary = nil
			self:refreshKeys()
		end

		return
	end

	if inputModule:GetFocusedTextBox() or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end

	if input.KeyCode == Enum.KeyCode.Escape and self:hasFocus() then
		if self.picker then
			self:closePicker()
		else
			self:clearSelection()
		end

		return
	end

	if not self:hasFocus() then
		return
	end

	local action = self:action(input)
	if action == "DeleteKeys" then
		self:deleteSelected()
	elseif action == "CutKeyframes" then
		if self:copySelected() then
			self:deleteSelected()
			self:notify("Cut keyframes")
		end
	elseif action == "Copy" or action == "CopyKeyframes" then
		if self:copySelected() then
			self:notify("Copied keyframes")
		end
	elseif action == "Paste" or action == "PasteKeyframes" or action == "PasteFlipped" then
		if self:paste(action == "PasteFlipped") then
			self:notify("Pasted keyframes")
		end
	elseif action == "SelectAll" then
		self:selectAll()
	elseif action == "JumpKeyframeLeft" or action == "JumpSingleKeyframeLeft" then
		self:jump(-1)
	elseif action == "JumpKeyframeRight" or action == "JumpSingleKeyframeRight" then
		self:jump(1)
	end
end

function KeyEditor:fire(key)
	local targets = fxKeys.targets(key.Id)
	if #targets == 0 then
		return
	end

	local preview = self.host and self.host.suite and self.host.suite.preview
	fxEmit.fire(targets, preview, function(emitter)
		return self:isScrubbing(emitter) or self.beamSources and self.beamSources[emitter] == true
	end)
end

function KeyEditor:advance(first, last, inclusive)
	if self.destroyed or not self:isActive() then return 0 end
	local fps = rawState.Timeline.FPS
	local due = fxKeys.between(first * fps, last * fps + 1e-6, inclusive)
	self.pendingEmits = self.pendingEmits or {}
	for _, key in due do table.insert(self.pendingEmits, key.Id) end
	return #due
end

function KeyEditor:step()
	if self.destroyed then
		return
	end

	local timeline = rawState.Timeline
	local fps = timeline.FPS
	if not fps or fps <= 0 then
		return
	end

	local frame = timeline.CurrentTime * fps
	self:stepBeamScrub()
	self:stepMeshScrub()
	if self.clock then
		if self.scrubSuspended and (timeline.Playing or timeline.CurrentTime ~= self.suspendedAt) then
			self.scrubSuspended = false
			self.nextScrubCheck = 0
		end

		local allowed = self:previewAllowed()
		local now = os.clock()
		if allowed ~= self.lastAllowed or now >= (self.nextScrubCheck or 0) then
			self.lastAllowed = allowed
			self.nextScrubCheck = now + 0.5
			self:refreshScrub()
		end
	end

	local pending = self.pendingEmits or {}
	self.pendingEmits = nil
	if self:isActive() then
		for _, id in pending do
			local key = fxKeys.get(id)
			if key then self:fire(key) end
		end
	end
end

function KeyEditor:clearBeamScrub()
	for _, keyed in self.beamScrubs or {} do
		for _, record in keyed do
			record.handle:Cancel()
			record.changed:Disconnect()
			record.attributes:Disconnect()
		end
	end
	self.beamScrubs = {}
	self.beamSources = {}
end

function KeyEditor:stepBeamScrub()
	if self.scrubSuspended or not self:isActive() or not self:previewAllowed() then
		self:clearBeamScrub()
		return
	end
	local timeline = rawState.Timeline
	local now = timeline.CurrentTime
	local fps = timeline.FPS or 60
	local emit = require("eclipseEmit")
	local previous = self.beamScrubs or {}
	local wanted, sources = {}, {}
	for _, key in fxKeys.list() do
		local elapsed = now - key.Frame / fps
		for _, source in fxEmit.beamEffects(fxKeys.targets(key.Id)) do
			sources[source] = true
			if elapsed < 0 then continue end
			local record = previous[key.Id] and previous[key.Id][source]
			if record and (record.dirty or elapsed < record.elapsed) then
				record.handle:Cancel()
				record.changed:Disconnect()
				record.attributes:Disconnect()
				record = nil
			end
			if not record then
				local seed = 0
				for _, byte in { string.byte(tostring(key.Id) .. source:GetFullName(), 1, -1) } do
					seed = (seed * 31 + byte) % 2147483647
				end
				record = { handle = emit.Emit(source, { Manual = true, Seed = seed }), elapsed = 0 }
				local function changed() record.dirty = true end
				record.changed = source.Changed:Connect(changed)
				record.attributes = source.AttributeChanged:Connect(changed)
			end
			record.handle:Advance(elapsed - record.elapsed)
			record.elapsed = elapsed
			wanted[key.Id] = wanted[key.Id] or {}
			wanted[key.Id][source] = record
		end
	end
	for id, keyed in previous do
		for source, record in keyed do
			if not wanted[id] or wanted[id][source] ~= record then
				record.handle:Cancel()
				record.changed:Disconnect()
				record.attributes:Disconnect()
			end
		end
	end
	self.beamScrubs, self.beamSources = wanted, sources
end

function KeyEditor:meshEntries()
	local entries = {}
	local fps = rawState.Timeline.FPS or 60
	local now = rawState.Timeline.CurrentTime or 0

	for _, key in fxKeys.list() do
		local elapsed = now - key.Frame / fps
		if elapsed >= 0 then
			for _, source in fxEmit.meshEffects(fxKeys.targets(key.Id)) do
				table.insert(entries, { source = source, elapsed = elapsed, tag = key.Id })
			end
		end
	end

	return entries
end

function KeyEditor:stepMeshScrub()
	local scrub = self.meshScrub
	if not scrub then
		return
	end

	local timeline = rawState.Timeline
	if timeline.Playing or self.scrubSuspended or not self:isActive() or not self:previewAllowed() then
		if scrub.active then
			scrub:clear()
		end

		self.meshScrubTime = nil
		return
	end

	local now = os.clock()
	local moved = timeline.CurrentTime ~= self.meshScrubTime
	if not moved and now < (self.nextMeshScrub or 0) then
		return
	end

	self.meshScrubTime = timeline.CurrentTime
	self.nextMeshScrub = now + 0.25
	if not moved then
		scrub:refresh()
	end

	scrub:update(self:meshEntries())
end

function KeyEditor:screenRect()
	local scale = math.max(self.options.getScale and self.options.getScale() or 1, 0.001)
	return self.gui.AbsoluteSize / scale, scale
end

function KeyEditor:placePicker()
	local picker = self.picker
	if not picker then
		return
	end

	local screen, scale = self:screenRect()
	local view = self.pickerView or self.timeline
	local anchor = view.pickerAnchor and view:pickerAnchor(picker.id) or view.window
	local origin = self.gui.AbsolutePosition
	local position = (anchor.AbsolutePosition - origin) / scale
	local size = anchor.AbsoluteSize / scale
	local height = math.min(pickerSize.Y, screen.Y - margin * 2)
	local width = pickerSize.X
	local x, y

	if view.pickerAnchor then
		x = position.X + size.X / 2 - width / 2
		y = position.Y + size.Y + gap
		if y + height > screen.Y - margin then
			y = position.Y - gap - height
		end
	else
		x = position.X - gap - width
		y = position.Y
		if x < margin then
			x = position.X + size.X - width
			y = position.Y + size.Y + gap
		end
	end

	local saved = self.options.getPosition and self.options.getPosition()
	if saved then x, y = saved.X, saved.Y end
	x = math.clamp(x, margin, math.max(margin, screen.X - margin - width))
	y = math.clamp(y, margin, math.max(margin, screen.Y - margin - height))
	picker.frame.AnchorPoint = Vector2.new(0.5, 0.5)
	picker.frame.Size = UDim2.fromOffset(width, height)
	picker.frame.Position = UDim2.fromOffset(x + width / 2, y + height / 2)
end

function KeyEditor:buildPicker(id)
	local frame = make("Frame", self.gui, "EclipseFXEmitPicker", {
		Size = UDim2.fromOffset(pickerSize.X, pickerSize.Y),
		Active = true,
		ZIndex = zIndex,
	})
	surface(frame, zIndex + 1)

	local title = text(frame, "Title", {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -110, 0, headerHeight),
		TextSize = 14,
		ZIndex = zIndex + 2,
	})
	local summary = text(frame, "Summary", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -34, 0, 0),
		Size = UDim2.fromOffset(80, headerHeight),
		TextSize = 11,
		TextTransparency = 0.35,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = zIndex + 2,
	})

	local close = chrome.close(frame, nil, zIndex + 3)
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position = UDim2.new(1, -8, 0, headerHeight / 2)
	close.Size = UDim2.fromOffset(18, 18)
	local closeIcon = close:FindFirstChild("Icon")
	if closeIcon then
		closeIcon.Size = UDim2.fromOffset(12, 12)
	end

	local list = make("ScrollingFrame", frame, "List", {
		Position = UDim2.fromOffset(6, headerHeight),
		Size = UDim2.new(1, -12, 1, -headerHeight - footerHeight - 4),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = zIndex + 2,
	})
	make("UIListLayout", list, "Layout", {
		Padding = UDim.new(0, 1),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	make("UIPadding", list, "Padding", {
		PaddingRight = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 4),
	})

	local footer = make("Frame", frame, "Footer", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -6),
		Size = UDim2.new(1, -16, 0, footerHeight - 10),
		BackgroundTransparency = 1,
		ZIndex = zIndex + 2,
	})
	tag(
		make("Frame", frame, "FooterDivider", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -footerHeight),
			Size = UDim2.new(1, -16, 0, 1),
			BackgroundColor3 = Color3.fromRGB(69, 41, 93),
			BorderSizePixel = 0,
			ZIndex = zIndex + 2,
		}),
		"ThemeBg",
		"Strk"
	)

	local function footerButton(name, label, anchor)
		local button = tag(
			make("TextButton", footer, name, {
				AnchorPoint = Vector2.new(anchor, 0),
				Position = UDim2.fromScale(anchor, 0),
				Size = UDim2.new(1 / 3, -4, 1, 0),
				BackgroundColor3 = Color3.fromRGB(51, 0, 77),
				BorderSizePixel = 0,
				AutoButtonColor = true,
				Text = label,
				FontFace = chrome.FONT,
				TextSize = 12,
				TextColor3 = Color3.fromRGB(235, 228, 242),
				ZIndex = zIndex + 3,
			}),
			"ThemeBg",
			"TopBtn"
		)
		tag(button, "ThemeTxt", "Txt")
		round(button, 4)
		return button
	end

	local delete = footerButton("Delete", "Delete key", 0)
	local preview = footerButton("Preview", "Preview burst", 0.5)
	local done = footerButton("Done", "Done", 1)

	local picker = {
		id = id,
		frame = frame,
		title = title,
		summary = summary,
		list = list,
		rows = {},
		connections = {},
	}

	local function hook(signal, callback)
		table.insert(picker.connections, signal:Connect(callback))
	end

	local handle = make("TextButton", frame, "DragHandle", {
		Size = UDim2.new(1, -34, 0, headerHeight), Text = "", BackgroundTransparency = 1,
		AutoButtonColor = false, ZIndex = zIndex + 3,
	})
	if self.options.bindPosition then table.insert(picker.connections, self.options.bindPosition(frame, handle)) end
	hook(close.Activated, function()
		self:closePicker()
	end)
	hook(done.Activated, function()
		self:closePicker()
	end)
	hook(preview.Activated, function()
		local targets = fxKeys.targets(picker.id)
		if #targets == 0 then return end
		self:suspendScrub()
		fxEmit.stop()
		fxEmit.fire(targets, self.host and self.host.suite and self.host.suite.preview)
	end)
	hook(delete.Activated, function()
		self:deleteKey(picker.id)
	end)

	FxLayout.centerTree(frame)
	theme.applyTree(frame)
	return picker
end

function KeyEditor:rowsFor(root, includeRoot)
	if not includeRoot then
		return fxEmit.tree(root)
	end

	if not fxEmit.contains(root) then
		return {}
	end

	local rows = {
		{ instance = root, depth = 0, kind = fxEmit.kind(root) or "Group", count = fxEmit.count(root) },
	}
	for _, entry in fxEmit.tree(root) do
		entry.depth += 1
		table.insert(rows, entry)
	end

	return rows
end

function KeyEditor:sources()
	local sources = {}
	local scene = workspace:FindFirstChild(sceneFolderName)
	local sceneRows = {}
	local sceneRoots = {}
	if scene then
		table.insert(sceneRoots, scene)
		for _, entry in fxEmit.tree(scene) do
			table.insert(sceneRows, entry)
		end
	end

	local linked = self.options.getLinked and self.options.getLinked() or {}
	local covered = {}
	for _, root in linked do
		if root.Parent then
			covered[root] = true
			table.insert(sceneRoots, root)
			for _, entry in self:rowsFor(root, true) do
				table.insert(sceneRows, entry)
			end
		end
	end

	table.insert(sources, { title = "Scene", rows = sceneRows, roots = sceneRoots })

	local state = self.state
	local rigs = state and state.getProjectRigs and state.getProjectRigs() or {}
	for _, rig in rigs do
		if rig and rig.Parent and not covered[rig] and not (scene and rig:IsDescendantOf(scene)) then
			table.insert(sources, { title = rig.Name, rows = self:rowsFor(rig, false), roots = { rig } })
		end
	end

	return sources
end

function KeyEditor:makeSection(picker, title, order)
	local header = text(picker.list, "Section", {
		Size = UDim2.new(1, 0, 0, 20),
		Text = string.upper(title),
		TextSize = 10,
		TextTransparency = 0.45,
		LayoutOrder = order,
		ZIndex = zIndex + 3,
	})
	make("UIPadding", header, "Padding", { PaddingLeft = UDim.new(0, 6), PaddingTop = UDim.new(0, 4) })
	return header
end

function KeyEditor:makeRow(picker, entry, order)
	local row = tag(make("TextButton", picker.list, "Row", {
		Size = UDim2.new(1, 0, 0, rowHeight),
		BackgroundColor3 = Color3.fromRGB(100, 0, 151),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		ZIndex = zIndex + 3,
	}), "ThemeBg", "MenuSel")
	round(row, 3)

	local indent = 6 + entry.depth * indentWidth
	local box = make("Frame", row, "Box", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, indent, 0.5, 0),
		Size = UDim2.fromOffset(13, 13),
		BackgroundColor3 = theme.get("TopBtn", Color3.fromRGB(51, 0, 77)),
		BorderSizePixel = 0,
		Active = false,
		Interactable = false,
		ZIndex = zIndex + 4,
	})
	tag(box, "ThemeBg", "TopBtn")
	round(box, 3)
	tag(
		make("UIStroke", box, "Stroke", {
			Color = Color3.fromRGB(107, 0, 139),
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		"ThemeStrk",
		"Strk"
	)
	local mark = make("Frame", box, "Mark", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(7, 7),
		BackgroundColor3 = theme.get("Bg", Color3.fromRGB(22, 16, 28)):Lerp(Color3.new(), 0.35),
		BorderSizePixel = 0,
		Visible = false,
		Active = false,
		Interactable = false,
		ZIndex = zIndex + 5,
	})
	tag(mark, "ThemeBg", "MenuSel")
	round(mark, 2)

	local kindText = entry.kind
	if entry.kind == "Group" then
		kindText = entry.count .. (entry.count == 1 and " effect" or " effects")
	end

	text(row, "Name", {
		Position = UDim2.fromOffset(indent + 20, 0),
		Size = UDim2.new(1, -(indent + 20) - 78, 1, 0),
		Text = entry.instance.Name,
		ZIndex = zIndex + 4,
	})
	text(row, "Kind", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 0),
		Size = UDim2.fromOffset(72, rowHeight),
		Text = kindText,
		TextSize = 10,
		TextTransparency = 0.45,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = zIndex + 4,
	})

	FxLayout.centerTree(row)
	local item = { row = row, mark = mark, instance = entry.instance, hovering = false }
	table.insert(picker.connections, row.MouseEnter:Connect(function()
		item.hovering = true
		self:paintRow(item)
	end))
	table.insert(picker.connections, row.MouseLeave:Connect(function()
		item.hovering = false
		self:paintRow(item)
	end))
	table.insert(picker.connections, row.Activated:Connect(function()
		local id = picker.id
		self:setTarget(id, entry.instance, not fxKeys.has(id, entry.instance))
	end))

	table.insert(picker.rows, item)
	return item
end

function KeyEditor:paintRow(item)
	local picker = self.picker
	if not picker then
		return
	end

	local checked = fxKeys.has(picker.id, item.instance)
	local covered = false
	if not checked then
		for _, target in fxKeys.targets(picker.id) do
			if item.instance:IsDescendantOf(target) then
				covered = true
				break
			end
		end
	end

	item.mark.Visible = checked or covered
	item.mark.BackgroundTransparency = if covered then 0.55 else 0
	local transparency = if checked then 0.55 elseif item.hovering then 0.8 else 1
	tweenService:Create(item.row, fadeInfo, { BackgroundTransparency = transparency }):Play()
end

function KeyEditor:populate()
	local picker = self.picker
	for _, item in picker.rows do
		item.row:Destroy()
	end

	table.clear(picker.rows)
	for _, child in picker.list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local order = 0
	local any = false
	for _, source in self:sources() do
		local rows = source.rows
		if #rows == 0 then
			continue
		end

		any = true
		order += 1
		self:makeSection(picker, source.title, order)
		for _, entry in rows do
			order += 1
			self:makeRow(picker, entry, order)
		end
	end

	if not any then
		text(picker.list, "Empty", {
			Size = UDim2.new(1, 0, 0, 60),
			Text = emptyText,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextSize = 11,
			TextTransparency = 0.35,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = zIndex + 3,
		})
	end

	theme.applyTree(picker.list)
	self:refreshPicker()
end

function KeyEditor:refreshPicker()
	local picker = self.picker
	if not picker then
		return
	end

	local key = fxKeys.get(picker.id)
	if not key then
		return
	end

	local count = fxEmit.targetCount(fxKeys.targets(picker.id))
	picker.title.Text = "Emit at frame " .. key.Frame
	picker.summary.Text = count == 0 and "None picked" or (count .. (count == 1 and " effect" or " effects"))
	picker.frame.Footer.Preview.Interactable = count > 0
	picker.frame.Footer.Preview.TextTransparency = count > 0 and 0 or 0.5
	for _, item in picker.rows do
		self:paintRow(item)
	end
end

function KeyEditor:watchSources()
	self:unwatchSources()
	local function schedule()
		if self.rebuildPending then
			return
		end

		self.rebuildPending = true
		task.delay(0.15, function()
			self.rebuildPending = false
			if self.picker and not self.destroyed then
				self:populate()
			end
		end)
	end

	for _, source in self:sources() do
		for _, root in source.roots do
			table.insert(self.watchers, root.DescendantAdded:Connect(schedule))
			table.insert(self.watchers, root.DescendantRemoving:Connect(schedule))
		end
	end
end

function KeyEditor:unwatchSources()
	for _, connection in self.watchers do
		connection:Disconnect()
	end

	table.clear(self.watchers)
end

function KeyEditor:openPicker(id, view)
	if not fxKeys.get(id) then
		return
	end

	if self.picker then
		if self.picker.id == id then
			self.pickerView = view or self.pickerView
			self:placePicker()
			return
		end

		self:closePicker(true)
	end

	self.pickerView = view or self.timeline
	self.picker = self:buildPicker(id)
	self:populate()
	self:placePicker()
	self:watchSources()
	windowFx.pop(self.picker.frame, "batch")
end

function KeyEditor:closePickerFor(view, instant)
	if self.picker and (self.pickerView or self.timeline) == view then
		self:closePicker(instant)
	end
end

function KeyEditor:closePicker(instant)
	local picker = self.picker
	if not picker then
		return
	end

	self.picker = nil
	self.pickerView = nil
	self:unwatchSources()
	for _, connection in picker.connections do
		connection:Disconnect()
	end

	if instant then
		windowFx.clear(picker.frame)
		picker.frame:Destroy()
		return
	end

	windowFx.shrink(picker.frame, function()
		picker.frame:Destroy()
	end, "batch")
end

function KeyEditor:destroy()
	fxEmit.stop()
	if self.destroyed then
		return
	end

	self.destroyed = true
	self:clearBeamScrub()
	self:closePicker(true)
	self:unwatchScrub()
	if self.meshScrub then
		self.meshScrub:destroy()
		self.meshScrub = nil
	end

	if self.clock then
		pcall(function()
			self.clock:stop()
		end)
		self.clock = nil
	end
	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	for _, view in table.clone(self.views) do
		self:removeView(view)
	end

	if self.state and self.state.EclipseFXKeys == self.focusApi then
		self.state.EclipseFXKeys = nil
	end
end

return KeyEditor
