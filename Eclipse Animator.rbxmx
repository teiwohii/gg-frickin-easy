					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local normalTransport = {}

local function normalized(value, fallback)
	local length = value.Magnitude
	return length > 1e-12 and value / length or fallback
end

function normalTransport.bind(normal, center, previous, following)
	local records = {}
	normal = normalized(normal, Vector3.zAxis)
	for index, first in previous do
		local second = following[index]
		if not second then continue end
		local u, v = first - center, second - center
		local area = u:Cross(v)
		local size = area.Magnitude
		if size <= 1e-12 then continue end
		local height = math.sqrt(size)
		local depth = area / height
		table.insert(records, {
			index = index,
			coefficients = Vector3.new(normal:Dot(u), normal:Dot(v), normal:Dot(depth)),
			weight = math.atan2(size, u:Dot(v)),
		})
	end
	return { records = records, normal = normal }
end

function normalTransport.evaluate(binding, center, previous, following)
	local sum = Vector3.zero
	for _, record in binding.records do
		local u = previous[record.index] - center
		local v = following[record.index] - center
		local area = u:Cross(v)
		local size = area.Magnitude
		if size <= 1e-12 then continue end
		local height = math.sqrt(size)
		local depth = area / height
		local coordinates = record.coefficients
		local transformed = (v:Cross(depth) * coordinates.X + depth:Cross(u) * coordinates.Y + area * coordinates.Z) / (size * height)
		sum += normalized(transformed, binding.normal) * record.weight
	end
	return normalized(sum, binding.normal)
end

return normalTransport
]]></ProtectedString>
						<string name="ScriptGuid">{7BC36E17-8577-4A0E-87D8-A3D2F3A276DF}</string>
