							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local configuration = require(script.Parent.Parent.Utility.configuration)
local emitStyle = require(script.Parent.Parent.Utility.emitStyle)

local Preview = {}
Preview.__index = Preview

Preview.scopes = { "Selection", "Asset" }
Preview.intervals = { 0.5, 1, 1.5, 2, 3, 5 }
Preview.trailDuration = 2.4
Preview.trailRadius = 4
Preview.trailSpeed = 5
Preview.minimumInterval = 0.2

Preview.messages = {
	nothing = "There are no particle emitters, mesh flipbooks, lightning or sounds to play. Select some, or switch the scope to Asset.",
	noTrailPart = "This trail needs both attachments on a part before it can be previewed.",
	noIsolate = "Select the objects you want to keep visible first.",
}

function Preview.new(bar: Frame, context)
	local self = setmetatable({}, Preview)

	self.bar = bar
	self.context = context
	self.asset = context.asset
	self.selection = context.selection
	self.settings = context.settings
	self.emitButton = bar.Emit
	self.repeatButton = bar.Repeat
	self.clearButton = bar.ClearParticles
	self.scopeButton = bar.Scope
	self.isolateButton = bar.Isolate
	self.viewButton = bar.View
	self.status = bar.Status
	self.scope = Preview.scopes[1]
	self.token = 0
	self.repeating = false
	self.isolated = false
	self.restores = {}
	self.trail = nil
	self.active = false
	self.pendingStatus = false
	self.connections = {}

	self:bind()
	self:refreshButtons()

	return self
end

function Preview:connect(signal: RBXScriptSignal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function Preview:bind()
	self:connect(self.emitButton.Activated, function()
		self:emit()
	end)

	self:connect(self.repeatButton.Activated, function()
		self:setRepeating(not self.repeating)
	end)

	self:connect(self.repeatButton.MouseButton2Click, function()
		self:openIntervalMenu()
	end)

	self:connect(self.clearButton.Activated, function()
		self:clear()
	end)

	self:connect(self.scopeButton.Activated, function()
		self:openScopeMenu()
	end)

	self:connect(self.isolateButton.Activated, function()
		self:setIsolated(not self.isolated)
	end)

	self:connect(self.viewButton.Activated, function()
		self:openViewMenu()
	end)
end

function Preview:start()
	self.active = true
	self:updateStatus()
end

function Preview:stop()
	self.active = false
	self:cancel()
	self:stopTrail()
	self.repeating = false
	self.isolated = false
	self:refreshButtons()
end

function Preview:refreshButtons()
	local colors = configuration.Colors

	self.repeatButton:SetAttribute("ThemeBg", if self.repeating then "MenuSel" else "TopBtn")
	self.repeatButton.BackgroundColor3 = if self.repeating then colors.Light else colors.Dark
	self.isolateButton:SetAttribute("ThemeBg", if self.isolated then "MenuSel" else "TopBtn")
	self.isolateButton.BackgroundColor3 = if self.isolated then colors.Light else colors.Dark
	self.scopeButton.Label.Text = self.scope
end

function Preview:getRoots(): { Instance }
	local effects = self.asset:getEffects()

	if self.scope == "Selection" then
		local roots = self.selection:getRoots()

		if #roots > 0 then
			return roots
		end
	end

	return if effects then { effects } else {}
end

function Preview:collect(className: string, roots: { Instance }?): { Instance }
	local found = {}
	local seen = {}

	local function include(instance: Instance)
		if instance:IsA(className) and not seen[instance] then
			seen[instance] = true
			table.insert(found, instance)
		end
	end

	for _, root in roots or self:getRoots() do
		include(root)

		for _, descendant in root:GetDescendants() do
			include(descendant)
		end
	end

	return found
end

function Preview:getEmitValue(emitter: Instance, name: string): number
	return emitStyle.getValue(emitter, name)
end

function Preview:isBurst(emitter: ParticleEmitter): boolean
	return typeof(emitter:GetAttribute("EmitCount")) == "number" or not emitter.Enabled
end

function Preview:restoreEmitters()
	for emitter, enabled in self.restores do
		if emitter.Parent then
			emitter.Enabled = enabled
		end
	end

	table.clear(self.restores)
end

function Preview:cancel()
	self.token += 1
	self:restoreEmitters()
end

function Preview:fire(emitter: ParticleEmitter, token: number)
	if token ~= self.token or not emitter.Parent then
		return
	end

	local duration = self:getEmitValue(emitter, "EmitDuration")
	local count = math.max(math.round(self:getEmitValue(emitter, "EmitCount")), 0)

	if duration > 0 then
		if self.restores[emitter] == nil then
			self.restores[emitter] = emitter.Enabled
		end

		emitter.Enabled = true

		task.delay(duration, function()
			if token == self.token and self.restores[emitter] ~= nil then
				if emitter.Parent then
					emitter.Enabled = self.restores[emitter]
				end

				self.restores[emitter] = nil
			end
		end)

		return
	end

	if count > 0 then
		emitter:Emit(count)
	end
end

function Preview:emitInstances(emitters: { Instance }): number
	local token = self.token
	local fired = 0

	for _, emitter in emitters do
		if emitter:IsA("ParticleEmitter") and self:isBurst(emitter) then
			local delay = self:getEmitValue(emitter, "EmitDelay")

			fired += 1

			if delay > 0 then
				task.delay(delay, function()
					self:fire(emitter, token)
				end)
			else
				self:fire(emitter, token)
			end
		end
	end

	return fired
end

function Preview:getFlipbooks(roots: { Instance }?): { Instance }
	local flipbooks = self.context.flipbooks

	return if flipbooks then flipbooks:collectHosts(roots or self:getRoots()) else {}
end

function Preview:getStrikes(roots: { Instance }?): { Instance }
	local strikes = self.context.strikes

	return if strikes then strikes:collectHosts(roots or self:getRoots()) else {}
end

function Preview:getSounds(roots: { Instance }?): { Instance }
	local sounds = self.context.sounds

	return if sounds then sounds:collectHosts(roots or self:getRoots()) else {}
end

function Preview:emit(silent: boolean?): number
	local fired = self:emitInstances(self:collect("ParticleEmitter"))
	local flipbooks = self.context.flipbooks
	local strikes = self.context.strikes
	local sounds = self.context.sounds

	if sounds then
		fired += sounds:play(self:getSounds())
	end

	if flipbooks then
		fired += flipbooks:play(self:getFlipbooks())
	end

	if strikes then
		fired += strikes:play(self:getStrikes())
	end

	if fired == 0 and not silent then
		self.context.notify(Preview.messages.nothing)
	end

	return fired
end

function Preview:getInterval(): number
	return math.max(self.settings:get("repeatInterval"), Preview.minimumInterval)
end

function Preview:setRepeating(repeating: boolean)
	if self.repeating == repeating then
		return
	end

	self.repeating = repeating
	self:refreshButtons()

	if not repeating then
		self:cancel()
		return
	end

	if self:emit() == 0 then
		self.repeating = false
		self:refreshButtons()
		return
	end

	local token = self.token

	task.spawn(function()
		while self.repeating and token == self.token and self.active do
			task.wait(self:getInterval())

			if not self.repeating or token ~= self.token or not self.active then
				break
			end

			self:emit(true)
		end
	end)
end

function Preview:clear()
	self.repeating = false
	self:cancel()
	self:refreshButtons()

	if self.context.flipbooks then
		self.context.flipbooks:stopPlayback()
	end

	if self.context.strikes then
		self.context.strikes:stopPlayback()
	end

	if self.context.sounds then
		self.context.sounds:stopPlayback()
	end

	for _, emitter in self:collect("ParticleEmitter") do
		(emitter :: ParticleEmitter):Clear()
	end

	for _, trail in self:collect("Trail") do
		(trail :: Trail):Clear()
	end
end

function Preview:stopTrail()
	local trail = self.trail

	if not trail then
		return
	end

	self.trail = nil
	trail.connection:Disconnect()

	if trail.part.Parent then
		trail.part.CFrame = trail.origin
	end
end

function Preview:previewTrail(trail: Trail)
	self:stopTrail()

	local first = trail.Attachment0
	local second = trail.Attachment1
	local part = first and first:FindFirstAncestorWhichIsA("BasePart")

	if not part or not second or second:FindFirstAncestorWhichIsA("BasePart") ~= part then
		self.context.notify(Preview.messages.noTrailPart)
		return
	end

	local origin = part.CFrame
	local started = os.clock()
	local state = { part = part, origin = origin }

	state.connection = runService.Heartbeat:Connect(function()
		local elapsed = os.clock() - started

		if elapsed >= Preview.trailDuration or not part.Parent then
			self:stopTrail()
			return
		end

		local angle = elapsed * Preview.trailSpeed
		local offset = Vector3.new(math.cos(angle) - 1, 0, math.sin(angle)) * Preview.trailRadius

		part.CFrame = origin * CFrame.new(offset)
	end)

	self.trail = state
end

function Preview:setIsolated(isolated: boolean)
	local hideManager = self.context.hideManager
	local effects = self.asset:getEffects()

	if not isolated or not effects then
		self.isolated = false
		hideManager:showAll()
		self:refreshButtons()
		self.context.hierarchyChanged()
		return
	end

	local selected = self.selection:get()
	local keep = {}

	for _, instance in selected do
		if instance:IsDescendantOf(effects) then
			table.insert(keep, instance)
		end
	end

	if #keep == 0 then
		self.context.notify(Preview.messages.noIsolate)
		return
	end

	hideManager:showAll()

	for _, child in effects:GetChildren() do
		local related = self.asset:isBase(child)

		for _, instance in keep do
			if instance == child or instance:IsDescendantOf(child) then
				related = true
				break
			end
		end

		if not related then
			hideManager:hide(child)
		end
	end

	self.isolated = true
	self:refreshButtons()
	self.context.hierarchyChanged()
end

function Preview:openScopeMenu()
	local items = {}

	for _, scope in Preview.scopes do
		table.insert(items, {
			text = scope,
			checked = scope == self.scope,
			callback = function()
				self.scope = scope
				self:refreshButtons()
				self:updateStatus()
			end,
		})
	end

	self.context.menu:toggle({ anchor = self.scopeButton, items = items, search = false })
end

function Preview:openIntervalMenu()
	local items = { { text = "Repeat Every", disabled = true } }
	local current = self.settings:get("repeatInterval")

	for _, interval in Preview.intervals do
		table.insert(items, {
			text = string.format("%.1f s", interval),
			checked = math.abs(current - interval) < 0.001,
			callback = function()
				self.settings:set("repeatInterval", interval)
			end,
		})
	end

	self.context.menu:open({ anchor = self.repeatButton, items = items, search = false })
end

function Preview:openViewMenu()
	local paths = self.context.paths
	local items = {
		{
			text = "Frame Selection",
			callback = function()
				self.context.frameSelection()
			end,
		},
		{
			text = "Particle Paths",
			checked = paths ~= nil and paths:isEnabled(),
			callback = function()
				if paths then
					paths:toggle()
				end
			end,
		},
		{ separator = true },
	}

	for _, view in self.context.camera.views do
		table.insert(items, {
			text = view.name,
			callback = function()
				self.context.frameSelection(view.name)
			end,
		})
	end

	self.context.menu:toggle({ anchor = self.viewButton, items = items, search = false })
end

function Preview:updateStatus()
	if not self.active then
		return
	end

	local roots = self:getRoots()

	if self.context.paths then
		self.context.paths:refresh()
	end

	if #roots == 0 then
		self.status.Text = ""
		return
	end

	local emitters = #self:collect("ParticleEmitter", roots)
	local beams = #self:collect("Beam", roots)
	local trails = #self:collect("Trail", roots)
	local flipbooks = #self:getFlipbooks(roots)
	local strikes = #self:getStrikes(roots)
	local sounds = #self:getSounds(roots)
	local parts = {}

	if emitters > 0 then
		table.insert(parts, string.format("%d emitter%s", emitters, if emitters == 1 then "" else "s"))
	end

	if beams > 0 then
		table.insert(parts, string.format("%d beam%s", beams, if beams == 1 then "" else "s"))
	end

	if trails > 0 then
		table.insert(parts, string.format("%d trail%s", trails, if trails == 1 then "" else "s"))
	end

	if flipbooks > 0 then
		table.insert(parts, string.format("%d flipbook%s", flipbooks, if flipbooks == 1 then "" else "s"))
	end

	if strikes > 0 then
		table.insert(parts, string.format("%d lightning", strikes))
	end

	if sounds > 0 then
		table.insert(parts, string.format("%d sound%s", sounds, if sounds == 1 then "" else "s"))
	end

	self.status.Text = table.concat(parts, "  ")
end

function Preview:scheduleStatus()
	if self.pendingStatus then
		return
	end

	self.pendingStatus = true

	task.defer(function()
		self.pendingStatus = false
		self:updateStatus()
	end)
end

function Preview:destroy()
	self:stop()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
end

return Preview
]]></ProtectedString>
