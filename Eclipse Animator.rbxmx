							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro
return function(require)
	local geometry = require("../Shared/SmearGeometry")
	local Smears = {}
	Smears.__index = Smears
	function Smears.new(data, objects)
		local self = setmetatable({rows = {}}, Smears)
		self.root = Instance.new("Folder")
		self.root.Name, self.root.Archivable = "EclipseCutsceneSmears", false
		self.root.Parent = workspace
		for _, row in data.Effects do
			table.insert(self.rows, {target = row.Target, frames = row.Frames, slot = geometry.new(self.root)})
		end
		self:bind(objects)
		return self
	end
	function Smears:bind(objects)
		for _, row in self.rows do row.object = assert(objects[row.target], "Missing smear track") end
	end
	function Smears:step(frame)
		local key = tostring(math.max(0, math.floor(frame + 1e-5)))
		for _, row in self.rows do
			local pose = row.frames[key]
			if pose and row.object:GetAttribute("EffectEnabled") ~= false then
				if row.rendered ~= pose then
					geometry.render(row.slot, geometry.triangles(pose.Poses, pose.Size, pose.Width, pose.Strength, pose.Style), pose.Color, pose.Opacity * (pose.Visibility or 1), pose.Ramp)
					row.rendered = pose
				end
			else geometry.hide(row.slot); row.rendered = nil end
		end
	end
	function Smears:hide()
		for _, row in self.rows do geometry.hide(row.slot); row.rendered = nil end
	end
	function Smears:destroy()
		for _, row in self.rows do geometry.destroy(row.slot) end
		self.root:Destroy()
		table.clear(self.rows)
	end
	return Smears
end
]]></ProtectedString>
