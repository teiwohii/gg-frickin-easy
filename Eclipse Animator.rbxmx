							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local Dragger = {}
Dragger.__index = Dragger

Dragger.lockProvider = nil

function Dragger.setLockProvider(provider: (() -> boolean)?)
	Dragger.lockProvider = provider
end

function Dragger.new(handle: GuiObject, target: GuiObject)
	local self = setmetatable({}, Dragger)

	self.handle = handle
	self.target = target
	self.dragging = false
	self.startInput = Vector2.zero
	self.startPosition = target.Position
	self.connections = {}
	self.blocker = nil

	self:bind()

	return self
end

function Dragger:setBlocker(blocker: ((Vector2) -> boolean)?)
	self.blocker = blocker
end

function Dragger:isBlocked(input: InputObject): boolean
	if Dragger.lockProvider and Dragger.lockProvider() then
		return true
	end

	return self.blocker ~= nil and self.blocker(Vector2.new(input.Position.X, input.Position.Y))
end

function Dragger:isPressInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

function Dragger:isMoveInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

function Dragger:bind()
	table.insert(self.connections, self.handle.InputBegan:Connect(function(input)
		if self:isPressInput(input) and not self:isBlocked(input) then
			self:beginDrag(input)
		end
	end))

	table.insert(self.connections, self.handle.InputEnded:Connect(function(input)
		if self:isPressInput(input) then
			self:endDrag()
		end
	end))

	table.insert(self.connections, userInputService.InputChanged:Connect(function(input)
		if self.dragging and self:isMoveInput(input) then
			self:updateDrag(input)
		end
	end))

	table.insert(self.connections, userInputService.InputEnded:Connect(function(input)
		if self:isPressInput(input) then
			self:endDrag()
		end
	end))
end

function Dragger:getContainerSize(): Vector2
	local container = self.target:FindFirstAncestorWhichIsA("GuiBase2d")

	if container then
		return container.AbsoluteSize
	end

	return workspace.CurrentCamera.ViewportSize
end

function Dragger:beginDrag(input: InputObject)
	self.dragging = true
	self.startInput = Vector2.new(input.Position.X, input.Position.Y)
	self.startPosition = self.target.Position
end

function Dragger:updateDrag(input: InputObject)
	local containerSize = self:getContainerSize()

	if containerSize.X <= 0 or containerSize.Y <= 0 then
		return
	end

	local delta = Vector2.new(input.Position.X, input.Position.Y) - self.startInput
	local startPosition = self.startPosition

	self.target.Position = UDim2.new(
		startPosition.X.Scale + delta.X / containerSize.X,
		startPosition.X.Offset,
		startPosition.Y.Scale + delta.Y / containerSize.Y,
		startPosition.Y.Offset
	)
end

function Dragger:endDrag()
	self.dragging = false
end

function Dragger:destroy()
	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	self.dragging = false
end

return Dragger
]]></ProtectedString>
