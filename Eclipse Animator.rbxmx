					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local binding = {}

function binding.is(target)
	return typeof(target) == "Instance" and target:GetAttribute("EclipseEffectObject") == 1 and target:GetAttribute("EffectKind") == "Smear Frames"
end

function binding.valid(target)
	return typeof(target) == "Instance" and (target:IsA("BasePart") or target:IsA("Bone"))
end

function binding.owner(target, rigs)
	for _, rig in rigs do
		if target == rig or target:IsDescendantOf(rig) then return rig end
	end
end

function binding.selected(state)
	local item = state.Rig and state.Rig._lastClickedItem
	if not item then return nil end
	if binding.is(item.linkedRigInstance) then return item.linkedRigInstance end
	local motor = item.fetchMotor and item:fetchMotor()
	if type(motor) == "table" and motor.IsEclipseR6Control and motor.Owner then motor = motor.Owner end
	local target = motor and (typeof(motor) == "Instance" and motor:IsA("Bone") and motor or motor.Part1)
		or item.organizationKey
	if binding.valid(target) and binding.owner(target, state.getAllRigs()) then return target end
end

function binding.save(model, target, rigs)
	local owner = assert(binding.owner(target, rigs), "Select a bone in this animation")
	local id = owner:GetAttribute("EclipseTrackId")
	if not id then
		id = game:GetService("HttpService"):GenerateGUID(false)
		owner:SetAttribute("EclipseTrackId", id)
	end
	model:SetAttribute("SmearOwnerId", id)
	model:SetAttribute("SmearTargetPath", require("paths").of(target, owner))
	local reference = Instance.new("ObjectValue")
	reference.Name, reference.Value, reference.Parent = "SmearTarget", target, model
end

function binding.resolve(model, rigs)
	local id, owner = model:GetAttribute("SmearOwnerId"), nil
	local reference = model:FindFirstChild("SmearTarget")
	if reference and binding.valid(reference.Value) then
		owner = binding.owner(reference.Value, rigs)
		if owner then return reference.Value, owner end
	end
	for _, rig in rigs do
		if rig:GetAttribute("EclipseTrackId") == id then
			if owner then return nil end
			owner = rig
		end
	end
	if owner then
		local ok, target = pcall(require("paths").resolve, owner, model:GetAttribute("SmearTargetPath"))
		if ok and binding.valid(target) then return target, owner end
	end
end

function binding.pose(target, motorByPart)
	if target:IsA("BasePart") then
		local reference = target:FindFirstChild("EclipseArmatureTarget")
		if reference and reference:IsA("ObjectValue") and reference.Value ~= target
			and binding.valid(reference.Value) and not reference.Value:GetAttribute("EclipseArmatureBoneId") then
			return binding.pose(reference.Value, motorByPart)
		end
		local cf = require("armatureRuntime").isAnchor(target) and require("armatureRuntime").worldCFrame(target) or target.CFrame
		local motor = motorByPart and motorByPart[target]
		if motor and not require("armatureRuntime").isAnchor(target) then
			cf = require("parenting").worldOf(motor, motorByPart)
		end
		return cf or target.CFrame, target.Size, target.Color
	end
	local cf = target.TransformedWorldCFrame
	local length, direction
	for _, child in target:GetChildren() do
		if child:IsA("Bone") then
			local delta = child.TransformedWorldCFrame.Position - cf.Position
			if delta.Magnitude > 1e-5 and (not length or delta.Magnitude < length) then
				length, direction = delta.Magnitude, delta.Unit
			end
		end
	end
	local part = target:FindFirstAncestorWhichIsA("BasePart")
	length = length or math.max(0.02, part and part.Size.Magnitude * 0.03 or 0.1)
	if direction then
		local right = direction:Cross(cf.LookVector)
		if right.Magnitude < 1e-5 then right = direction:Cross(cf.RightVector) end
		right = right.Unit
		cf = CFrame.fromMatrix(cf.Position + direction * length * 0.5, right, direction, right:Cross(direction))
	end
	return cf, Vector3.new(length * 0.25, length, length * 0.25), part and part.Color or Color3.new(1, 1, 1)
end

function binding.pivot(target, motorByPart, cf)
	if target:IsA("Bone") then return target.TransformedWorldCFrame.Position end
	local reference = target:FindFirstChild("EclipseArmatureTarget")
	if reference and reference:IsA("ObjectValue") and reference.Value ~= target
		and binding.valid(reference.Value) and not reference.Value:GetAttribute("EclipseArmatureBoneId") then
		return binding.pivot(reference.Value, motorByPart, cf)
	end
	local motor = motorByPart and motorByPart[target]
	if motor and typeof(motor.C1) == "CFrame" then return (cf * motor.C1).Position end
	return cf.Position
end

function binding.span(target, raw, selectedOnly)
	local motor = raw.MotorByPart[target] or target
	local frames, selected, seen, selectedFrames = {}, {}, {}, {}
	for track, bucket in raw.Keyframes do
		local related = track == motor or (type(track) == "table" and track.IsEclipseR6Control and track.Owner == motor)
		if not related then continue end
		for frame, key in bucket do
			if not seen[frame] then table.insert(frames, frame); seen[frame] = true end
			if not selectedFrames[frame] and (raw.SelectedKeyframes[key] or (raw.SelectedChannelKeyframes and raw.SelectedChannelKeyframes[key])) then
				table.insert(selected, frame); selectedFrames[frame] = true
			end
		end
	end
	table.sort(selected)
	if #selected >= 2 then return selected[1], selected[#selected] end
	if selectedOnly then return nil end
	table.sort(frames)
	local at = raw.CurrentTime * raw.FPS
	for i = 1, #frames - 1 do
		if frames[i + 1] > at then return frames[i], frames[i + 1] end
	end
	if #frames >= 2 then return frames[#frames - 1], frames[#frames] end
	local first = math.max(0, math.round(at))
	return first, first + math.max(1, math.round(raw.FPS / 4))
end

return binding
]]></ProtectedString>
						<string name="ScriptGuid">{100D506A-1690-4D5F-89FF-399289FBCC2F}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
