						<ProtectedString name="Source"><![CDATA[-- riftkuro
local reduction = {}
 
 
local require = require(script:FindFirstAncestor("container").requireModule)
local epsilon = 1
local positionErrorValue = 5e-4
local basisError = 1e-3
local nativePositionError = 0.0002
local nativeRotationDegrees = 0.02
local nativeRotationError = math.rad(nativeRotationDegrees)
local cameraPositionError = 0.002
local cameraRotationDegrees = 0.05
local cameraFovError = 0.05
reduction.NATIVE_POSITION_ERROR = nativePositionError
reduction.NATIVE_ROTATION_DEGREES = nativeRotationDegrees
reduction.CAMERA_POSITION_ERROR = cameraPositionError
reduction.CAMERA_ROTATION_DEGREES = cameraRotationDegrees
reduction.CAMERA_FOV_ERROR = cameraFovError
reduction.PROBE_FACTOR = 8
reduction.PROBE_DEPTH = 3
local function difference(a, b, scale)
	return math.max(
		(a.Position - b.Position).Magnitude * scale / positionErrorValue,
		(a.XVector - b.XVector).Magnitude / basisError,
		(a.YVector - b.YVector).Magnitude / basisError,
		(a.ZVector - b.ZVector).Magnitude / basisError
	)
end
function reduction.lerp(a, b, alpha)
	local axisA, angleA = a:ToAxisAngle()
	local axisB, angleB = b:ToAxisAngle()
	local vector = (axisA * angleA):Lerp(axisB * angleB, alpha)
	local angle = vector.Magnitude
	local position = a.Position:Lerp(b.Position, alpha)
	if angle < 1e-9 then
		return CFrame.new(position)
	end
	return CFrame.new(position) * CFrame.fromAxisAngle(vector / angle, angle)
end
local function curveOf(values, frames, scale, rest, post)
	local px, py, pz, rx, ry, rz = {}, {}, {}, {}, {}, {}
	local inverse = rest and rest:Inverse()
	for i, frame in frames do
		local value = values[frame]
		if value then
			local transform = inverse and inverse * value or value
			if post then
				transform = transform * post
			end
			local position = transform.Position
			px[i], py[i], pz[i] = position.X * scale, position.Y * scale, position.Z * scale
			local axis, angle = transform:ToAxisAngle()
			rx[i], ry[i], rz[i] = axis.X * angle, axis.Y * angle, axis.Z * angle
		end
	end
	return { px = px, py = py, pz = pz, rx = rx, ry = ry, rz = rz }
end
local function deviation(curve, a, b, i, alpha, positionError, rotationError)
	local px, py, pz = curve.px, curve.py, curve.pz
	local dx = px[a] + (px[b] - px[a]) * alpha - px[i]
	local dy = py[a] + (py[b] - py[a]) * alpha - py[i]
	local dz = pz[a] + (pz[b] - pz[a]) * alpha - pz[i]
	local error = math.sqrt(dx * dx + dy * dy + dz * dz) / positionError
	local rx, ry, rz = curve.rx, curve.ry, curve.rz
	local ex = rx[a] + (rx[b] - rx[a]) * alpha - rx[i]
	local ey = ry[a] + (ry[b] - ry[a]) * alpha - ry[i]
	local ez = rz[a] + (rz[b] - rz[a]) * alpha - rz[i]
	return math.max(error, math.sqrt(ex * ex + ey * ey + ez * ez) / rotationError)
end
local linear = Enum.PoseEasingStyle.Linear
local function enumNamed(enum, name)
	local ok, item = pcall(function()
		return enum[name]
	end)
	return ok and item or nil
end
local function nativeEasing(key)
	if key.Reversed then
		return nil
	end
	local defaults = require("defaults")
	local style = key.EasingStyle or defaults.EasingStyle
	local direction = key.EasingDirection or defaults.EasingDirection
	if typeof(direction) == "EnumItem" then
		direction = direction.Name
	end
	if type(direction) ~= "string" then
		return nil
	end
	local name = typeof(style) == "EnumItem" and style.Name or style
	if type(name) ~= "string" then
		return nil
	end
	if key.NativePose == true or typeof(style) == "EnumItem" and style.EnumType == Enum.PoseEasingStyle then
		local nativeStyle = enumNamed(Enum.PoseEasingStyle, name)
		local nativeDirection = enumNamed(Enum.PoseEasingDirection, direction)
		if nativeStyle and nativeDirection then
			return nativeStyle, nativeDirection
		end
		return nil
	end
	name = require("easing").styleName(name)
	if direction == "Automatic" then
		direction = (name == "Back" or name == "Bounce" or name == "Elastic") and "Out" or "In"
	end
	if name == "Linear" then
		return linear, Enum.PoseEasingDirection.In
	elseif name == "Constant" then
		return Enum.PoseEasingStyle.Constant, Enum.PoseEasingDirection.Out
	elseif name == "Cubic" then
		if direction == "In" then
			return Enum.PoseEasingStyle.Cubic, Enum.PoseEasingDirection.Out
		elseif direction == "Out" then
			return Enum.PoseEasingStyle.Cubic, Enum.PoseEasingDirection.In
		elseif direction == "InOut" then
			return Enum.PoseEasingStyle.Cubic, Enum.PoseEasingDirection.InOut
		end
	elseif name == "Bounce" then
		if direction == "In" or direction == "Out" then
			return Enum.PoseEasingStyle.Bounce, Enum.PoseEasingDirection[direction]
		end
	elseif name == "Elastic" then
		if
			(key.Amplitude == nil or key.Amplitude == 1)
			and (key.Period == nil or key.Period == (direction == "InOut" and 0.45 or 0.3))
			and (direction == "In" or direction == "Out" or direction == "InOut")
		then
			return Enum.PoseEasingStyle.Elastic, Enum.PoseEasingDirection[direction]
		end
	end
	return nil
end
function reduction.nativeEasing(key)
	return nativeEasing(key)
end
local function reduceNative(values, frames, authored, steps, world, scale, checkpoint, easings, model)
	local positionError = model.position or nativePositionError
	local rotationError = math.rad(model.rotation or nativeRotationDegrees)
	local keep = { [1] = true, [#frames] = true }
	for i, frame in frames do
		if authored and authored[frame] or steps[frame] then
			keep[i] = true
			if steps[frame] and frames[i + 1] then
				keep[i + 1] = true
			end
		end
		if world and i > 1 and (world[frames[i - 1]] ~= nil) ~= (world[frame] ~= nil) then
			keep[i] = true
			keep[i - 1] = true
		end
	end
	local boundaries = {}
	for i in keep do
		table.insert(boundaries, i)
	end
	table.sort(boundaries)
	checkpoint()
	local curve = curveOf(values, frames, scale, model.rest, model.post)
	local worldCurve = world and curveOf(world, frames, scale)
	checkpoint()
	local easing = require("easing")
	local pending = {}
	for index = 2, #boundaries do
		local a, b = boundaries[index - 1], boundaries[index]
		local first, last = frames[a], frames[b]
		local key = b > a + 1 and authored and authored[first] and authored[last] and authored[first]
		local style, direction = nil, nil
		if
			model.easing ~= false
			and key
			and type(key) == "table"
			and not steps[first]
			and not (world and (world[first] or world[last]))
		then
			style, direction = nativeEasing(key)
		end
		if style and style ~= linear then
			local native = { EasingStyle = style, EasingDirection = direction.Name, NativePose = true }
			local fits = true
			for i = a + 1, b - 1 do
				if i % 256 == 0 then
					checkpoint()
				end
				local alpha = easing.apply((frames[i] - first) / (last - first), native)
				if deviation(curve, a, b, i, alpha, positionError, rotationError) > epsilon then
					fits = false
					break
				end
			end
			if fits then
				easings[first] = { style = style, direction = direction }
				continue
			end
		end
		table.insert(pending, { a, b })
	end
	while #pending > 0 do
		checkpoint()
		local range = table.remove(pending)
		local a, b = range[1], range[2]
		if b <= a + 1 then
			continue
		end
		local first, last = frames[a], frames[b]
		local span = last - first
		local worldSpan = worldCurve and worldCurve.px[a] and worldCurve.px[b]
		local worst, index = epsilon, nil
		for i = a + 1, b - 1 do
			if i % 256 == 0 then
				checkpoint()
			end
			local alpha = (frames[i] - first) / span
			local error = deviation(curve, a, b, i, alpha, positionError, rotationError)
			if worldSpan and worldCurve.px[i] then
				error = math.max(
					error,
					deviation(worldCurve, a, b, i, alpha, positionError, rotationError)
				)
			end
			if error > worst then
				worst, index = error, i
			end
		end
		if index then
			keep[index] = true
			table.insert(pending, { a, index })
			table.insert(pending, { index, b })
		end
	end
	for i, frame in frames do
		if not keep[i] then
			values[frame] = nil
		end
	end
end
function reduction.reduce(values, frames, authored, steps, world, scale, checkpoint, easings, model)
	if #frames < 3 then
		return
	end
	if easings then
		return reduceNative(
			values,
			frames,
			authored,
			steps,
			world,
			scale,
			checkpoint,
			easings,
			model or {}
		)
	end
	local keep = { [1] = true, [#frames] = true }
	for i, frame in frames do
		if authored and authored[frame] or steps[frame] then
			keep[i] = true
			if steps[frame] and frames[i + 1] then
				keep[i + 1] = true
			end
		end
		 
		if world and i > 1 and (world[frames[i - 1]] ~= nil) ~= (world[frame] ~= nil) then
			keep[i] = true
			keep[i - 1] = true
		end
	end
	local boundaries = {}
	for i in keep do
		table.insert(boundaries, i)
	end
	table.sort(boundaries)
	local pending = {}
	for i = 2, #boundaries do
		table.insert(pending, { boundaries[i - 1], boundaries[i] })
	end
	while #pending > 0 do
		checkpoint()
		local range = table.remove(pending)
		local a, b = range[1], range[2]
		if b <= a + 1 then
			continue
		end
		local first, last = frames[a], frames[b]
		local worst, index = epsilon, nil
		for i = a + 1, b - 1 do
			if i % 256 == 0 then
				checkpoint()
			end
			local frame = frames[i]
			local alpha = (frame - first) / (last - first)
			local error = difference(values[first]:Lerp(values[last], alpha), values[frame], scale)
			if world and world[first] and world[last] and world[frame] then
				error = math.max(
					error,
					difference(world[first]:Lerp(world[last], alpha), world[frame], scale)
				)
			end
			if error > worst then
				worst, index = error, i
			end
		end
		if index then
			keep[index] = true
			table.insert(pending, { a, index })
			table.insert(pending, { index, b })
		end
	end
	for i, frame in frames do
		if not keep[i] then
			values[frame] = nil
		end
	end
end
return reduction
]]></ProtectedString>
