								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local Tool = require(script.Parent.Tool)

local RetimeTool = Tool.extend()

RetimeTool.id = "Retime"
RetimeTool.title = "Retime Effect"
RetimeTool.keywords = "speed slow fast duration time lifetime"
RetimeTool.attributes = { "EmitDelay", "EmitDuration" }

function RetimeTool.new(context)
	local self = setmetatable({}, RetimeTool)

	Tool.init(self, context, {
		Factor = 2,
	})

	return self
end

function RetimeTool:getFields()
	return {
		self:field("Factor", "Duration", "number", { minimum = 0.05, range = { min = 0.25, max = 4 }, tip = "2 makes the effect take twice as long. 0.5 makes it twice as fast. Particles still travel the same distance." }),
		self:action("Apply", "Retime Selection", function()
			self:apply()
		end, nil, true),
	}
end

function RetimeTool:scaleRange(range: NumberRange, factor: number): NumberRange
	return NumberRange.new(range.Min * factor, range.Max * factor)
end

function RetimeTool:retime(instance: Instance, factor: number)
	if instance:IsA("ParticleEmitter") then
		instance.Lifetime = self:scaleRange(instance.Lifetime, factor)
		instance.Speed = self:scaleRange(instance.Speed, 1 / factor)
		instance.RotSpeed = self:scaleRange(instance.RotSpeed, 1 / factor)
		instance.Acceleration /= factor * factor
		instance.Drag /= factor
		instance.Rate /= factor
		instance.FlipbookFramerate = self:scaleRange(instance.FlipbookFramerate, 1 / factor)

		for _, name in RetimeTool.attributes do
			local value = instance:GetAttribute(name)

			if typeof(value) == "number" then
				instance:SetAttribute(name, value * factor)
			end
		end
	elseif instance:IsA("Beam") then
		instance.TextureSpeed /= factor
	elseif instance:IsA("Trail") then
		instance.Lifetime *= factor
	end
end

function RetimeTool:apply()
	local roots = self:requireRoots(false)

	if not roots then
		return
	end

	local factor = math.max(self.params.Factor, 0.05)

	self:run("Retime", function()
		for _, instance in self:getAffected() do
			self:retime(instance, factor)
		end
	end)
end

return RetimeTool
]]></ProtectedString>
								<string name="ScriptGuid">{CB94D492-1488-4A6F-935D-9C859D7DAC81}</string>
