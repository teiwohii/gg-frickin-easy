						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local TextureSprite = {}
TextureSprite.__index = TextureSprite

TextureSprite.layerName = "Frame"
TextureSprite.white = Color3.new(1, 1, 1)

function TextureSprite.new(clip: GuiObject, light: boolean?)
	local self = setmetatable({}, TextureSprite)

	self.clip = clip
	self.image = clip.Image
	self.layers = { clip.Image }
	self.sequence = nil
	self.light = light == true
	self.entry = nil
	self.index = -1

	clip.ClipsDescendants = true

	return self
end

function TextureSprite:getEntry()
	return self.entry
end

function TextureSprite:getIndex(): number
	return self.index
end

function TextureSprite:isLight(): boolean
	return self.light
end

function TextureSprite:isSequence(): boolean
	return self.sequence ~= nil
end

function TextureSprite:getFrameCount(): number
	if self.sequence then
		return #self.sequence
	end

	return if self.entry then self.entry.frames else 0
end

function TextureSprite:getRate(): number?
	local entry = self.entry

	if not entry or not self.sequence then
		return nil
	end

	return if self.light then entry.keyFps else entry.fps
end

function TextureSprite:getPosterIndex(): number
	local entry = self.entry

	if not entry then
		return 0
	end

	return if self.sequence and self.light then entry.keyPoster else entry.poster
end

function TextureSprite:isAnimated(): boolean
	return self:getFrameCount() > 1
end

function TextureSprite:getLayer(index: number): ImageLabel
	local layer = self.layers[index]

	if not layer then
		layer = self.image:Clone()
		layer.Name = TextureSprite.layerName .. index
		layer.Parent = self.clip
		self.layers[index] = layer
	end

	return layer
end

function TextureSprite:buildSequence(): { string }?
	local entry = self.entry

	if not entry or not entry.images then
		return nil
	end

	if not self.light then
		return entry.images
	end

	local sequence = {}

	for _, key in entry.keys do
		table.insert(sequence, entry.images[key + 1])
	end

	return sequence
end

function TextureSprite:rebuild()
	local entry = self.entry
	local sequence = self:buildSequence()
	local count = if sequence then #sequence else 1
	local grid = if entry and not sequence then entry.grid else 1
	local tint = if entry and entry.tint then entry.tint else TextureSprite.white

	self.sequence = sequence
	self.index = -1

	for index = 1, math.max(count, #self.layers) do
		local layer = self:getLayer(index)
		local used = index <= count
		local image = ""

		if used and sequence then
			image = sequence[index]
		elseif used and entry then
			image = entry.image
		end

		layer.Visible = used
		layer.ImageTransparency = if sequence then 1 else 0
		layer.ImageColor3 = tint
		layer.Position = UDim2.fromScale(0, 0)
		layer.Size = UDim2.fromScale(grid, grid)
		layer.Image = image
	end
end

function TextureSprite:setEntry(entry)
	if self.entry == entry then
		return
	end

	self.entry = entry
	self:rebuild()
	self:showPoster()
end

function TextureSprite:setLight(light: boolean)
	if self.light == light then
		return
	end

	self.light = light

	if self.entry and self.entry.images then
		self:rebuild()
		self:showPoster()
	end
end

function TextureSprite:showFrame(index: number)
	local entry = self.entry

	if not entry then
		return
	end

	local frame = math.clamp(index, 0, math.max(self:getFrameCount() - 1, 0))
	local previous = self.index

	if frame == previous then
		return
	end

	self.index = frame

	if self.sequence then
		if previous >= 0 then
			self.layers[previous + 1].ImageTransparency = 1
		end

		self.layers[frame + 1].ImageTransparency = 0
	else
		self.image.Position = UDim2.fromScale(-(frame % entry.grid), -math.floor(frame / entry.grid))
	end
end

function TextureSprite:showPoster()
	if self.entry then
		self:showFrame(self:getPosterIndex())
	end
end

return TextureSprite
]]></ProtectedString>
							<string name="ScriptGuid">{F2EDA59A-6F25-458C-AD1B-722E3BD41471}</string>
