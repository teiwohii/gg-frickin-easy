						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local PremiumGate = require(script.Parent.Parent.Premium.PremiumGate)
local LibraryKind = require(script.Parent.LibraryKind)

local PresetLibraryKind = setmetatable({}, { __index = LibraryKind })
PresetLibraryKind.__index = PresetLibraryKind

PresetLibraryKind.id = "Preset"
PresetLibraryKind.label = "Preset"
PresetLibraryKind.plural = "Presets"
PresetLibraryKind.order = 5
PresetLibraryKind.fallbackIcon = "preset"
PresetLibraryKind.feature = "presets"
PresetLibraryKind.singleText = "1 effect"
PresetLibraryKind.countText = "%d effects"
PresetLibraryKind.lockedText = "Premium"
PresetLibraryKind.previewFailedText = "This preset has nothing to emit."
PresetLibraryKind.previewFolder = "ArcPresetPreview"
PresetLibraryKind.previewDistance = 18
PresetLibraryKind.previewMaxDistance = 60
PresetLibraryKind.previewSizeFactor = 1.1
PresetLibraryKind.previewPadding = 0.5
PresetLibraryKind.previewMinimum = 1
PresetLibraryKind.tip = "Ready-made VFX that come with Arc Premium. What you save yourself is kept under VFX and Sounds, and Arc updates never change it."

function PresetLibraryKind.new(definition)
	local self = setmetatable({}, PresetLibraryKind)

	self:configure(definition)
	self.folder = nil
	self.previewed = nil
	self.token = 0

	return self
end

function PresetLibraryKind:accepts(_roots: { Instance }): boolean
	return false
end

function PresetLibraryKind:isUnlocked(): boolean
	return PremiumGate.get():isUnlocked(PresetLibraryKind.feature)
end

function PresetLibraryKind:describe(item): string
	if not self:isUnlocked() then
		return PresetLibraryKind.lockedText
	end

	return LibraryKind.describe(self, item)
end

function PresetLibraryKind:canPreview(): boolean
	return true
end

function PresetLibraryKind:isPreviewing(item): boolean
	return self.previewed == item and self.folder ~= nil and self.folder.Parent ~= nil
end

function PresetLibraryKind:stopPreview()
	self.token += 1

	if self.folder then
		self.folder:Destroy()
		self.folder = nil
	end

	self.previewed = nil
end

function PresetLibraryKind:getPreviewSize(source: Instance): number
	local largest = 0

	for _, descendant in source:GetDescendants() do
		if descendant:IsA("ParticleEmitter") then
			for _, keypoint in descendant.Size.Keypoints do
				largest = math.max(largest, keypoint.Value + keypoint.Envelope)
			end
		end
	end

	return largest
end

function PresetLibraryKind:getPlacement(item): CFrame
	local camera = workspace.CurrentCamera
	local view = if camera then camera.CFrame else CFrame.identity
	local size = if item and item.source then self:getPreviewSize(item.source) else 0
	local distance = math.clamp(size * PresetLibraryKind.previewSizeFactor, PresetLibraryKind.previewDistance, PresetLibraryKind.previewMaxDistance)
	local position = view.Position + view.LookVector * distance
	local flat = Vector3.new(view.LookVector.X, 0, view.LookVector.Z)

	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end

	return CFrame.lookAt(position, position - flat.Unit)
end

function PresetLibraryKind:getLength(folder: Instance): number
	local length = PresetLibraryKind.previewMinimum

	for _, descendant in folder:GetDescendants() do
		if descendant:IsA("ParticleEmitter") then
			local delay = descendant:GetAttribute("EmitDelay")
			local duration = descendant:GetAttribute("EmitDuration")
			local start = if typeof(delay) == "number" then delay else 0
			local hold = if typeof(duration) == "number" then duration else 0

			length = math.max(length, start + hold + descendant.Lifetime.Max)
		end
	end

	return length
end

function PresetLibraryKind:preview(library, item): boolean
	local playing = self:isPreviewing(item)

	self:stopPreview()

	if playing or not library.catalog then
		return playing
	end

	local placement = self:getPlacement(item)
	local success, roots = pcall(function()
		return library.catalog:build(item, placement)
	end)

	if not success or #roots == 0 then
		return false
	end

	local folder = Instance.new("Folder")

	folder.Name = PresetLibraryKind.previewFolder
	folder.Archivable = false

	for _, root in roots do
		if root:IsA("PVInstance") then
			root.Parent = folder
		else
			local holder = Instance.new("Part")

			holder.Name = root.Name
			holder.Anchored = true
			holder.CanCollide = false
			holder.CanQuery = false
			holder.Transparency = 1
			holder.Size = Vector3.one
			holder.CFrame = placement
			holder.Parent = folder
			root.Parent = if root:IsA("Attachment") then holder else Instance.new("Attachment", holder)
		end
	end

	folder.Parent = workspace.CurrentCamera or workspace
	self.folder = folder
	self.previewed = item

	local suite = library.context.suite
	local scope = { folder }
	local fired = 0

	if suite and suite.preview then
		local preview = suite.preview

		fired += preview:emitInstances(preview:collect("ParticleEmitter", scope))

		if suite.flipbooks then
			fired += suite.flipbooks:play(preview:getFlipbooks(scope))
		end

		if suite.strikes then
			fired += suite.strikes:play(preview:getStrikes(scope))
		end

		if suite.sounds then
			fired += suite.sounds:play(preview:getSounds(scope))
		end
	end

	local token = self.token

	task.delay(self:getLength(folder) + PresetLibraryKind.previewPadding, function()
		if token == self.token then
			self:stopPreview()
		end
	end)

	if fired == 0 then
		self:stopPreview()
		return false
	end

	return true
end

return PresetLibraryKind
]]></ProtectedString>
