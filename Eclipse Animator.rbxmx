						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local MeshInserter = {}
MeshInserter.__index = MeshInserter

MeshInserter.messages = {
	failed = "The mesh could not be inserted.",
	inserted = "Added \"%s\" to %s.",
}

MeshInserter.targetTexts = {
	container = "Inserts into \"%s\".",
	newAsset = "No asset open: inserts into a new asset.",
}

function MeshInserter.new(context, builder)
	local self = setmetatable({}, MeshInserter)

	self.context = context
	self.builder = builder
	self.selection = context.selection
	self.history = context.history

	return self
end

function MeshInserter:getTargetText(): string
	local texts = MeshInserter.targetTexts
	local container = self.builder:getContainer()

	if not container then
		return texts.newAsset
	end

	return string.format(texts.container, container.Name)
end

function MeshInserter:prepare(instance: Instance)
	local parts = instance:GetDescendants()

	table.insert(parts, instance)

	for _, part in parts do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
		end
	end
end

function MeshInserter:place(instance: Instance, placement: CFrame)
	if instance:IsA("PVInstance") then
		instance:PivotTo(placement * instance:GetPivot().Rotation)
	end
end

function MeshInserter:insert(entry): { Instance }
	local messages = MeshInserter.messages
	local source = entry.source

	if not source or not source.Parent then
		self.context.notify(messages.failed)
		return {}
	end

	if not self.context.suite:ensureAsset() then
		return {}
	end

	local container = self.builder:getContainer()

	if not container then
		self.context.notify(messages.failed)
		return {}
	end

	local placement = self.builder:getPlacement(container)

	local created = self.history:run("Insert Mesh", function()
		local clone = source:Clone()

		clone.Name = entry.name
		self:prepare(clone)
		self:place(clone, placement)
		clone.Parent = container

		return { clone }
	end)

	if not created or #created == 0 then
		self.context.notify(messages.failed)
		return {}
	end

	self.selection:set(created)
	self.context.notify(string.format(messages.inserted, entry.name, container.Name))

	return created
end

return MeshInserter
]]></ProtectedString>
							<string name="ScriptGuid">{84C1C46B-FC4D-490E-91EB-413383606EBB}</string>
