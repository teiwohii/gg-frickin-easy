					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local sampler = {}

function sampler.capture(state, plan, frame, detectMotion)
	local timeline = state.Timeline
	local raw = timeline:GetState()
	local time, applyClock = raw.CurrentTime, raw.LastPoseApplyClock
	local last = state.lastCFrames and table.clone(state.lastCFrames)
	local restoreTargets = require("target").previewSnapshot()
	local snapshot, result, previous
	local rigs = state.getAllRigs()
	local ok, issue = xpcall(function()
		snapshot = require("snapshot").new(
			rigs,
			raw,
			workspace.CurrentCamera and { workspace.CurrentCamera } or {}
		)
		local function sample(index)
			if index <= #rigs then
				return require("armatureRuntime").withSampling(rigs[index], function()
					return sample(index + 1)
				end)
			end
			if detectMotion and frame > 0 then
				raw.CurrentTime = (frame - 1) / raw.FPS
				timeline:ApplyPoseAtTime(plan.owner, raw.CurrentTime, { SkipControls = true })
				previous = require("afterimageGeometry").capture(plan)
			end
			raw.CurrentTime = frame / raw.FPS
			timeline:ApplyPoseAtTime(plan.owner, raw.CurrentTime, { SkipControls = true })
			result = require("afterimageGeometry").capture(plan)
			if detectMotion then
				result.moving = previous ~= nil
					and require("afterimageGeometry").moved(plan, previous, result)
			end
		end
		sample(1)
	end, debug.traceback)
	raw.CurrentTime = time
	local restored, restoreIssue = pcall(function()
		if snapshot then
			snapshot:restore()
		end
	end)
	if last then
		table.clear(state.lastCFrames)
		for key, value in last do
			state.lastCFrames[key] = value
		end
	end
	raw.LastPoseApplyClock = applyClock
	local targetsOk, targetsIssue = pcall(restoreTargets)
	if previous then
		require("afterimageGeometry").destroyPose(previous)
	end
	if not ok or not restored or not targetsOk then
		if result then
			require("afterimageGeometry").destroyPose(result)
		end
		error(not ok and issue or not restored and restoreIssue or targetsIssue, 0)
	end
	return result
end

return sampler
]]></ProtectedString>
						<string name="ScriptGuid">{3E537C32-6050-4A36-9C43-BFA7334ADF2D}</string>
