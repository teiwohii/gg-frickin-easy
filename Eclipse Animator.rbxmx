		local ok, problem = pcall(readModifiers)

		if not ok then

			storage.keepRaw(rig, sequence:FindFirstChild("EclipseCurveModifiers"), problem)

			storage.noteIssue(

				"chunk",

				rig.Name

					.. ": saved curve modifiers could not be read and are kept as-is: "

					.. tostring(problem)

			)

		end

	end



