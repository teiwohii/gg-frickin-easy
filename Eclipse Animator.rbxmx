				</Item>
				<Item class="ModuleScript" referent="RBX8C084DA60FB64EBA9F869698F93B7852">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local preferences = require("preferences")
local targetModule = require("selectedRig")
local cameraRig = require("cameraRig")
local cameraDisplay = require("cameraDisplay")
local onionSkin = {}
local snapshotModule = require("keyframeCleanup")

local function ghostColor()
	return preferences.color("OnionSkinColor")
end

local function ghostTransparency()
	return preferences.get("OnionSkinTransparency") / 100
end

local ghostMaterial = Enum.Material.Neon
local ghostSizeScale = 1.005
local layerName = "_EclipseAnimator_OnionLayer"
local ghostNamePrefix = "_EclipseOnion_"

local state = nil
local ui = nil
local history = nil
local motorMath = nil

local captures = {}
local capturedRig
local lifetime = {}
local watcher
local partLockState = {}

local function selectedTarget()
	local selected = state.Axis and state.Axis:GetSelectedBone()
	if selected then
		local rig = targetModule.resolve({ Axis = state.Axis, getAllRigs = state.getAllRigs }, false)
		if rig then
			return rig
		end
	end

	return targetModule.resolve(state, false) or capturedRig or state.currentRig
end

local function getCamera()
	return workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera")
end

local function getSanitizeName()
	return (state and state.UIHelpers and state.UIHelpers.SanitizeName)
		or function(s)
			return tostring(s or ""):gsub("%s+", "")
		end
end

local function stripPartChildren(clone)
	for _, child in ipairs(clone:GetChildren()) do
		if child:IsA("Bone") then
			stripPartChildren(child)
		elseif child:IsA("DataModelMesh") then
			if child:IsA("FileMesh") then
				pcall(function()
					child.TextureId = ""
				end)
			end
		elseif child:IsA("HandleAdornment") then
			pcall(function()
				child:SetAttribute("EclipseOnionOriginalTransparency", child.Transparency)
				child.Color3 = ghostColor()
				if child.Transparency > 0 then
					child.Transparency = 1 - ((1 - child.Transparency) * (1 - ghostTransparency()))
				end

				child.ZIndex = math.max(child.ZIndex - 1, 0)
			end)
		else
			child:Destroy()
		end
	end
end

local function copyBones(source, parent)
	for _, child in source:GetChildren() do
		if child:IsA("Bone") then
			local bone = Instance.fromExisting(child)
			bone.Transform = child.Transform
			bone.Parent = parent
			copyBones(child, bone)
		end
	end
end

local function buildGhost(part, parent)
	local archivable = part.Archivable
	part.Archivable = true
	local ok, clone = pcall(function()
		return part:Clone()
	end)
	part.Archivable = archivable
	if not ok then
		error(clone, 0)
	end
	assert(clone, "Could not copy onion skin part")
	if clone:IsA("MeshPart") then
		pcall(function()
			clone.TextureID = ""
		end)
	end

	stripPartChildren(clone)
	for _, child in clone:GetChildren() do
		if child:IsA("Bone") then child:Destroy() end
	end
	copyBones(part, clone)
	pcall(function()
		clone.Size = clone.Size * ghostSizeScale
	end)
	for _, child in ipairs(clone:GetChildren()) do
		if child:IsA("DataModelMesh") then
			pcall(function()
				child.Scale = child.Scale * ghostSizeScale
			end)
		end
	end

	clone.Locked = false
	clone.Anchored = true
	clone.Massless = true
	clone.CanCollide = false
	clone.CanTouch = false
	clone.CanQuery = false
	clone.Archivable = false
	clone.Material = ghostMaterial
	clone.Transparency = ghostTransparency()
	clone.Color = ghostColor()
	clone.Parent = parent
	return clone
end

function onionSkin:Initialize(deps)
	self:Clear()
	for _, connection in lifetime do
		connection:Disconnect()
	end

	table.clear(lifetime)
	state = deps.State
	ui = deps.UI
	history = deps.History
	motorMath = deps.MotorMath
	self:InitializeAutomatic()
	local unsubscribeAppearance = preferences.subscribe(function(key)
		if
			key == "OnionSkinColor"
			or key == "OnionSkinTransparency"
			or key == "PoseGhostPreviousColor"
			or key == "PoseGhostNextColor"
			or key == "PoseGhostTransparency"
		then
			self:RefreshAppearance()
		end
	end)
	table.insert(lifetime, { Disconnect = unsubscribeAppearance })
	table.insert(
		lifetime,
		ui.AnimatorFrame:GetPropertyChangedSignal("Visible"):Connect(function()
			if not ui.AnimatorFrame.Visible then
				self:Clear()
			end
		end)
	)
	table.insert(
		lifetime,
		ui.EclipseGUI:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not ui.EclipseGUI.Enabled then
				self:Clear()
			end
		end)
	)
	table.insert(
		lifetime,
		ui.EclipseGUI.Destroying:Connect(function()
			self:Clear()
			for _, c in lifetime do
				c:Disconnect()
			end

			table.clear(lifetime)
		end)
	)
end

function onionSkin:IsActive()
	return next(captures) ~= nil
end

local function clearRig(rig)
	local capture = captures[rig]
	if not capture then
		return
	end

	captures[rig] = nil
	for part in capture.locks do
		local lock = partLockState[part]
		if lock then
			lock.count -= 1
			if lock.count == 0 then
				if part.Parent then
					pcall(function()
						part.Locked = lock.wasLocked
					end)
				end

				partLockState[part] = nil
			end
		end
	end

	capture.layer:Destroy()
	if capturedRig == rig then
		capturedRig = next(captures)
	end

	if next(captures) == nil and watcher then
		watcher:Disconnect()
		watcher = nil
	end
end

function onionSkin:Clear()
	self:ClearAutomatic()
	while next(captures) do
		clearRig(next(captures))
	end

	capturedRig = nil
end

function onionSkin:Toggle(recapture)
	if not state or not ui then
		return
	end

	if not state.currentRig or not ui.AnimatorFrame.Visible then
		return
	end

	local target = selectedTarget()
	if not target or not target.Parent then
		return
	end

	if captures[target] then
		clearRig(target)
		if not recapture then
			return
		end
	end

	capturedRig = target
	local capturedFov = cameraRig.isRig(target) and cameraRig.fov(target) or nil

	local parent = getCamera() or workspace

	local onionLayer = Instance.new("Folder")
	local motorGhosts = {}
	local capture = { layer = onionLayer, ghosts = motorGhosts, fov = capturedFov, locks = {} }
	captures[target] = capture
	onionLayer.Name = layerName
	require("recovery").mark(onionLayer)
	onionLayer.Parent = parent
	local source = Instance.new("ObjectValue")
	source.Name = "EclipseSourceRig"
	source.Value = target
	source.Parent = onionLayer

	for _, descendant in ipairs(target:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local lock = partLockState[descendant]
			if not lock then
				lock = { count = 0, wasLocked = descendant.Locked }
				partLockState[descendant] = lock
			end

			lock.count += 1
			capture.locks[descendant] = true
			descendant.Locked = true
		end
	end

	for _, descendant in ipairs(target:GetDescendants()) do
		if
			descendant:IsA("Motor6D")
			and descendant.Part1
			and descendant.Part0
			and not cameraRig.isFov(descendant)
		then
			local ghost = buildGhost(descendant.Part1, onionLayer)
			ghost.Name = ghostNamePrefix .. descendant.Part1.Name
			ghost.CFrame = descendant.Part1.CFrame
			motorGhosts[descendant] = ghost
			if cameraRig.isTransform(descendant) then
				ghost.Transparency = 1
				ghost.CFrame = cameraRig.displayFrame(target)
				for i, pair in cameraDisplay.segments(capturedFov) do
					local line = Instance.new("LineHandleAdornment")
					line.Name = "OnionCamera" .. i
					line.Adornee = ghost
					line.CFrame = CFrame.lookAt(pair[1], pair[2])
					line.Length = (pair[2] - pair[1]).Magnitude
					line.Color3 = ghostColor()
					line.Thickness = 3
					line.Transparency = ghostTransparency()
					line.AlwaysOnTop = true
					line.Parent = ghost
				end
			end
		end
	end

	if not watcher then
		local elapsed = 0
		watcher = game:GetService("RunService").Heartbeat:Connect(function(dt)
			elapsed += dt
			if elapsed < 0.1 then
				return
			end

			elapsed = 0
			local stale = {}
			for rig, capture in captures do
				if not rig.Parent or not capture.layer.Parent then
					table.insert(stale, rig)
				end
			end

			for _, rig in stale do
				clearRig(rig)
			end
		end)
	end
end

function onionSkin:Capture()
	if not state or not ui or not state.currentRig or not ui.AnimatorFrame.Visible then
		return
	end

	local target = selectedTarget()
	if not target or not target.Parent then
		return
	end

	self:Toggle(true)
end

function onionSkin:ApplyToRig()
	if not self:IsActive() then
		return
	end

	if not state or not ui or not history then
		return
	end

	if not state.currentRig or not ui.AnimatorFrame.Visible then
		return
	end

	if not state.Timeline then
		return
	end

	local target = selectedTarget()
	local capture = target and captures[target]
	if not capture then
		return
	end

	local motorGhosts, capturedFov = capture.ghosts, capture.fov
	if not target or not target.Parent then
		return
	end

	local timelineValue = state.Timeline
	local sanitizeName = getSanitizeName()
	local timeline = timelineValue:GetState()
	local frameNumber = timelineValue:TimeToFrame(timeline.CurrentTime)
	local records = {}

	local poses = {}
	local ghostParts = {}
	for motor, ghost in motorGhosts do
		if ghost and ghost.Parent and motor.Part1 then
			ghostParts[motor.Part1] = ghost.CFrame
		end
	end

	for motor, ghost in motorGhosts do
		if ghost and ghost.Parent and motor.Part0 then
			local parentPose = ghostParts[motor.Part0] or motor.Part0.CFrame
			poses[motor] = parentPose:Inverse() * ghost.CFrame * motor.C1
		end
	end

	local fovMotor = capturedFov and cameraRig.motor(target, "FovPart")
	if fovMotor then
		poses[fovMotor] = cameraRig.encode(fovMotor, capturedFov)
	end

	for motor, pose in pairs(poses) do
		if motor.Parent and motor.Part0 and motor.Part1 then
			local prevC0 = motor.C0
			local newC0 = pose

			local bucket = timelineValue:GetMotorKeyframeBucket(motor)
			local hadKeyframe = bucket and bucket[frameNumber] ~= nil
			local prevKeyframeC0 = hadKeyframe and bucket[frameNumber].C0 or nil
			local before = snapshotModule.copy(bucket or {})

			local locked = motorMath.collectTrackParentLockedDescendants(target, motor)
			motor.C0 = newC0
			motorMath.restoreTrackParentLockedDescendants(locked)

			timelineValue:RecordKeyframeForMotorAtCurrentTime(
				motor.Part1,
				motor,
				newC0,
				ui.TrackContainer,
				sanitizeName
			)

			table.insert(records, {
				part = motor.Part1,
				motor = motor,
				frame = frameNumber,
				newC0 = newC0,
				prevC0 = prevC0,
				hadKeyframe = hadKeyframe,
				prevKeyframeC0 = prevKeyframeC0,
				before = before,
				after = snapshotModule.copy(timelineValue:GetMotorKeyframeBucket(motor)),
			})
		end
	end

	if #records == 0 then
		return
	end

	state.currentProjectSaved = false

	local captured = records
	local capturedFrame = frameNumber

	local description
	if #records == 1 then
		description = "Onion skin apply (" .. records[1].part.Name .. ")"
	else
		description = "Onion skin apply (" .. #records .. " bones)"
	end

	history.record(function()
		for _, r in ipairs(captured) do
			if r.motor and r.motor.Parent then
				local locked = motorMath.collectTrackParentLockedDescendants(target, r.motor)
				r.motor.C0 = r.prevC0
				motorMath.restoreTrackParentLockedDescendants(locked)
			end
		end

		for _, r in captured do
			if r.motor and r.motor.Parent then
				timelineValue:_restoreMotorBucket(r.motor, r.before)
			end
		end

		if state.currentRig then
			timelineValue:ApplyPoseAtTime(target, timelineValue:GetState().CurrentTime)
		end

		if state.Axis and state.Axis:GetSelectedBone() then
			state.Axis:RefreshAxis()
			state.Axis:RefreshBoneFade()
		end
	end, function()
		for _, r in ipairs(captured) do
			if r.motor and r.motor.Parent then
				local locked = motorMath.collectTrackParentLockedDescendants(target, r.motor)
				r.motor.C0 = r.newC0
				motorMath.restoreTrackParentLockedDescendants(locked)
			end
		end

		for _, r in captured do
			if r.motor and r.motor.Parent then
				timelineValue:_restoreMotorBucket(r.motor, r.after)
			end
		end

		if state.currentRig then
			timelineValue:ApplyPoseAtTime(target, timelineValue:GetState().CurrentTime)
		end

		if state.Axis and state.Axis:GetSelectedBone() then
			state.Axis:RefreshAxis()
			state.Axis:RefreshBoneFade()
		end
	end, description, capturedFrame)

	if state.Axis and state.Axis:GetSelectedBone() then
		state.Axis:RefreshAxis()
		state.Axis:RefreshBoneFade()
	end
end

local automaticGhosts, automaticStamp, automaticRevision
local automaticUnsubscribe
local automaticFrames, automaticRetry = nil, 0
local automaticContext, automaticPending
local automaticCache, automaticUse = {}, 0

local function sameStamp(a, b)
	if not a or not b then
		return false
	end

	for i = 1, 8 do
		if a[i] ~= b[i] then
			return false
		end
	end

	return true
end

function onionSkin:ClearAutomatic()
	for _, entry in automaticCache do
		entry.model:Destroy()
	end

	table.clear(automaticCache)
	if automaticGhosts then
		automaticGhosts:Destroy()
		automaticGhosts = nil
	end

	automaticStamp, automaticContext, automaticPending = nil, nil, nil
end

function onionSkin:UpdateAutomatic(deferBuild)
	local timeline = state and state.Timeline
	local raw = timeline and timeline:GetState()
	if
		not raw
		or not require("preferences").get("AutomaticOnionSkin")
		or not ui.AnimatorFrame.Visible
		or not ui.EclipseGUI.Enabled
		or state.PresentationHidden
		or raw.Playing
	then
		self:ClearAutomatic()
		return
	end

	if
		state.LoadingProject
		or state.PhysicsSimulating
		or raw.Exporting
		or history.isApplying()
		or state.scoreDragStarted
		or state.PropertyGizmo and state.PropertyGizmo.isEditing()
	then
		return
	end

	local axis = state.Axis
	if
		axis and (axis:IsHoldingAxis() or axis:IsBlenderGrabMode() or axis:IsBlenderRotateMode())
	then
		return
	end

	local interaction = require("rawState")
	if interaction.KeyframeDrag.draggingKeyframe or interaction.KeyframeTransform.active then
		return
	end

	local rig = selectedTarget()
	if not rig or not rig.Parent then
		self:ClearAutomatic()
		return
	end

	if os.clock() < automaticRetry then
		return
	end

	local geometry = require("ghostGeometry")
	local scope = geometry.scope(rig)
	if not scope then
		self:ClearAutomatic()
		return
	end

	local transparency = require("preferences").get("PoseGhostTransparency") / 100
	local frame = raw.CurrentTime * raw.FPS
	local before, after
	if
		not automaticFrames
		or automaticFrames.rig ~= rig
		or automaticFrames.keys ~= raw.Keyframes
		or automaticFrames.revision ~= automaticRevision
	then
		local set = {}
		local owners = { rig }

		for _, other in state.getAllRigs() do
			if other ~= rig and (other == scope or other:IsDescendantOf(scope)) then
				table.insert(owners, other)
			end
		end

		for _, owner in owners do
			local motors = require("parenting").collectMotors(owner)
			for _, motor in require("properties").list(owner, true) do
				table.insert(motors, motor)
			end

			for _, motor in motors do
				for at, key in raw.Keyframes[motor] or {} do
					if not require("policy").isDisabled(key) then
						set[at] = true
					end
				end
			end
		end

		local frames = {}
		for at in set do
			table.insert(frames, at)
		end

		table.sort(frames)
		automaticFrames =
			{ rig = rig, keys = raw.Keyframes, revision = automaticRevision, frames = frames }
	end

	local frames = automaticFrames.frames
	local low, high = 1, #frames + 1
	while low < high do
		local mid = math.floor((low + high) / 2)
		if frames[mid] < frame - 1e-5 then
			low = mid + 1
		else
			high = mid
		end
	end

	before = frames[low - 1]
	while frames[low] and frames[low] <= frame + 1e-5 do
		low += 1
	end

	after = frames[low]
	if not before and not after then
		self:ClearAutomatic()
		return
	end

	local stamp = { rig, raw.Keyframes, before, after, raw.FPS, automaticRevision, 0, scope }
	if sameStamp(automaticStamp, stamp) and automaticGhosts and automaticGhosts.Parent then
		return
	end

	local context = { rig, raw.Keyframes, raw.FPS, automaticRevision, 0, scope }
	if not sameStamp(automaticContext, context) then
		self:ClearAutomatic()
		automaticContext = context
	end

	local missing = {}
	for _, at in { before or false, after or false } do
		if at ~= false and not automaticCache[at] then
			table.insert(missing, at)
		end
	end

	if #missing > 0 and deferBuild then
		if automaticGhosts then
			automaticGhosts.Parent = nil
		end

		if not automaticPending or not sameStamp(automaticPending.stamp, stamp) then
			automaticPending = { stamp = stamp, at = os.clock() }
			return
		end

		if os.clock() - automaticPending.at < 0.08 then
			return
		end
	end

	automaticPending = nil
	local root = automaticGhosts
	if not root then
		root = Instance.new("Folder")
		root.Name = "_EclipseAdjacentPoses"
		require("recovery").mark(root)
		automaticGhosts = root
	end

	local created = {}
	if #missing > 0 then
		local snapshot
		local resume = raw.CurrentTime
		local lastCFrames = state.lastCFrames and table.clone(state.lastCFrames)
		local lastApply = raw.LastPoseApplyClock
		local restoreTargets = require("target").previewSnapshot()
		local ok, message = xpcall(function()
			snapshot = require("snapshot").new(
				state.getAllRigs(),
				raw,
				getCamera() and { getCamera() } or {}
			)
			snapshot:capture(scope)
			for _, object in scope:GetDescendants() do
				snapshot:capture(object)
			end

			local rigs = state.getAllRigs()

			local function sample(index)
				if index <= #rigs then
					return require("armatureRuntime").withSampling(rigs[index], function()
						sample(index + 1)
					end)
				end

				for _, at in missing do
					raw.CurrentTime = at / raw.FPS

					timeline:ApplyPoseAtTime(rig, at / raw.FPS, { SkipControls = true })
					local clone = geometry.capture(rig, scope, Color3.new(1, 1, 1), transparency)
					created[at] = { model = clone }
				end
			end

			sample(1)
		end, debug.traceback)
		raw.CurrentTime = resume
		local restored, restoreError = pcall(function()
			if snapshot then
				snapshot:restore()
			end
		end)
		if lastCFrames then
			table.clear(state.lastCFrames)
			for motor, value in lastCFrames do
				state.lastCFrames[motor] = value
			end
		end

		raw.LastPoseApplyClock = lastApply
		restoreTargets()
		if not ok or not restored then
			for _, entry in created do
				entry.model:Destroy()
			end

			self:ClearAutomatic()
			automaticRetry = os.clock() + 5
			warn("[Eclipse pose ghosts] " .. tostring(not ok and message or restoreError))
			return
		end

		for at, entry in created do
			automaticCache[at] = entry
		end
	end

	for at, entry in automaticCache do
		if at ~= before and at ~= after then
			entry.model.Parent = nil
		end
	end

	for _, pose in
		{
			{ before, preferences.color("PoseGhostPreviousColor"), "Previous" },
			{ after, preferences.color("PoseGhostNextColor"), "Next" },
		}
	do
		if pose[1] == nil then
			continue
		end

		local entry = automaticCache[pose[1]]
		if entry.color ~= pose[2] then
			entry.tintTargets = geometry.tint(entry.model, pose[2], entry.tintTargets)
			entry.color = pose[2]
		end

		automaticUse += 1
		entry.used = automaticUse
		entry.model.Name = pose[3]
		entry.model.Parent = root
	end

	local count = 0
	for _ in automaticCache do
		count += 1
	end

	while count > 4 do
		local oldest, age
		for at, entry in automaticCache do
			if at ~= before and at ~= after and (not age or (entry.used or 0) < age) then
				oldest, age = at, entry.used or 0
			end
		end

		automaticCache[oldest].model:Destroy()
		automaticCache[oldest] = nil
		count -= 1
	end

	root.Parent = getCamera() or workspace
	automaticStamp = stamp
end

function onionSkin:RefreshAppearance()
	for _, capture in captures do
		for motor, ghost in capture.ghosts do
			ghost.Color = ghostColor()
			ghost.Transparency = cameraRig.isTransform(motor) and 1 or ghostTransparency()
			for _, child in ghost:GetChildren() do
				if child:IsA("HandleAdornment") then
					child.Color3 = ghostColor()
					local original = child:GetAttribute("EclipseOnionOriginalTransparency")
					child.Transparency = original and 1 - (1 - original) * (1 - ghostTransparency())
						or ghostTransparency()
				end
			end
		end
	end

	local geometry = require("ghostGeometry")
	for _, entry in automaticCache do
		local key = entry.model.Name == "Previous" and "PoseGhostPreviousColor"
			or "PoseGhostNextColor"
		entry.color = preferences.color(key)
		entry.tintTargets = geometry.tint(entry.model, entry.color, entry.tintTargets)
		geometry.opacity(entry.model, preferences.get("PoseGhostTransparency") / 100)
	end
end

function onionSkin:InitializeAutomatic()
	self:ClearAutomatic()
	if automaticUnsubscribe then
		automaticUnsubscribe()
	end

	automaticRevision = 0
	automaticFrames = nil
	automaticRetry = 0
	automaticUnsubscribe = history.subscribe(function()
		automaticRevision += 1
	end)
	local elapsed = 0
	table.insert(
		lifetime,
		game:GetService("RunService").Heartbeat:Connect(function(dt)
			elapsed += dt
			if elapsed < 0.03 then
				return
			end

			elapsed = 0
			self:UpdateAutomatic(true)
		end)
	)
	table.insert(
		lifetime,
		ui.EclipseGUI.Destroying:Connect(function()
			self:ClearAutomatic()
			if automaticUnsubscribe then
				automaticUnsubscribe()
				automaticUnsubscribe = nil
			end
		end)
	)
end

return onionSkin
]]></ProtectedString>
						<string name="ScriptGuid">{F4940E0C-0AEB-4EF7-BEBC-2D8959AA085B}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">onionSkinStatic</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0A20349065E54709BA8F940D5989150C">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local shake = require("shake")

local http = game:GetService("HttpService")
local run = game:GetService("RunService")
local modelModule = require("model")
local objectsModule = require("objects")
local cameraModule = require("cameraRig")
local properties = require("properties")
local organization = require("organization")
local history = require("history")
local rawModule = require("rawState")
local chunks = require("chunkStore")
local effects = {}
local fovButtons = setmetatable({}, { __mode = "k" })
local refs, connection, gui
local lifetime = {}
local suspended = false

local function presentationActive()
	return refs
		and refs.ScreenGui.Enabled
		and (
			refs.AnimatorFrame.Visible
			or refs.State.PresentationHidden and require("visibility").isPlaybackActive()
		)
end

local overlays = {}
local tracked = {}
local generation = 0
local parkedModels = setmetatable({}, { __mode = "k" })

local function folder()
	if refs.EffectsWorldParent then
		return refs.EffectsWorldParent
	end

	for _, v in workspace:GetChildren() do
		if v:IsA("Folder") and v:GetAttribute("EclipseEffectsFolder") then
			return v
		end
	end

	local f = Instance.new("Folder")
	f.Name = "Eclipse Effects"
	f:SetAttribute("EclipseEffectsFolder", true)
	f.Parent = workspace
	return f
end

local function parked()
	local parent = refs and refs.EffectsWorldParent or game:GetService("ServerStorage")
	local f = require("root").get("EclipseEffectStorage", true, parent)
	f:SetAttribute("EclipseEffectStorage", true)
	return f
end

local stepCount = 0

local function cleanFolders()
	local scope = refs and refs.EffectsWorldParent or workspace
	for _, f in scope:GetChildren() do
		if f:IsA("Folder") and f:GetAttribute("EclipseEffectsFolder") and #f:GetChildren() == 0 then
			f:Destroy()
		end
	end
end

local function park(model)
	if not objectsModule.is(model) or not model.Parent then
		return
	end

	local storage = parked()

	if parkedModels[model] and model.Parent == storage then
		return false
	end

	objectsModule.paint(model, false, 0)
	model.Parent = storage
	parkedModels[model] = true
	return true
end

local function loadStep()
	local state = refs and refs.State
	local step = state and state.ProjectWorkStep
	if step and state.LoadingProject and state.ProjectLoadThread == coroutine.running() then
		return step
	end

	return nil
end

function effects.parkAll()
	local targets = {}
	for model in tracked do
		targets[model] = true
	end

	local parent = refs and refs.EffectsWorldParent or workspace
	local step = loadStep()
	local storage = parked()
	for index, v in parent:GetDescendants() do
		if step and index % 4096 == 0 then
			step()
		end

		if objectsModule.is(v) and not v:IsDescendantOf(storage) then
			targets[v] = true
		end
	end

	for model in targets do
		park(model)
	end

	cleanFolders()
	if gui then
		gui:Destroy()
		gui = nil
	end

	overlays = {}
	tracked = {}
end

function effects.cameras()
	local result = {}
	if not refs then
		return result
	end

	for _, rig in refs.State.getAllRigs() do
		if rig.Parent and cameraModule.isRig(rig) then
			local id = rig:GetAttribute("EclipseTrackId")
			if not id then
				id = http:GenerateGUID(false)
				rig:SetAttribute("EclipseTrackId", id)
			end

			table.insert(
				result,
				{ id = id, rig = rig, name = rig.Name, enabled = organization.isEnabled(rig) }
			)
		end
	end

	return result
end

function effects.resolveCamera(id)
	for _, c in effects.cameras() do
		if c.id == id then
			return c
		end
	end
end

function effects.validateForProject(value)
	if value.kind == "Smear Frames" then return require("smearFrames").validate(value) end
	if value.kind == "Afterimage" then
		return require("afterimages").validate(value)
	end
	local v = modelModule.validate(value)
	if v.kind == "Camera Shake" then
		v.shakeEnvelope = value.shakeEnvelope == true
		v.strength = tonumber(value.strength)
		v.speed = tonumber(value.speed)
		assert(
			modelModule.finite(v.strength) and v.strength > 0 and v.strength <= 100,
			"Strength must be greater than zero, up to 100."
		)
		assert(
			modelModule.finite(v.speed) and v.speed > 0 and v.speed <= 60,
			"Speed must be greater than zero, up to 60."
		)
	end

	v.gradient = value.gradient == true
	v.color2 = table.clone(value.color2 or value.color)
	assert(#v.color2 == 3, "Choose a valid second color")
	for _, n in v.color2 do
		assert(modelModule.finite(n) and n >= 0 and n <= 1, "Choose a valid second color")
	end

	v.gradientRotation = value.gradientRotation or 90
	if v.kind == "Screen Cover" then
		v.cover = require("screenCovers").validate(value.cover)
	end
	assert(modelModule.finite(v.gradientRotation), "Enter a valid gradient angle")
	if v.kind == "Impact Frames" then
		v.frames = effects.validateImpactFrames(value.frames)
		local duration = 0
		for _, row in v.frames do
			duration += row.delay + row.hold
		end

		v.duration = duration
		v.fadeIn = 0
		v.fadeOut = 0
		assert(
			v.start + duration <= modelModule.MAX_FRAME,
			"The sequence ends beyond the timeline limit."
		)
	end

	if v.kind == "Letterbox" or v.kind == "Camera Shake" then
		local cameras = effects.cameras()
		assert(#cameras > 0, "Add a camera to this project first.")
		if not v.cameraId and #cameras == 1 then
			v.cameraId = cameras[1].id
		end

		assert(
			v.cameraId and effects.resolveCamera(v.cameraId),
			"Select the camera for this " .. v.kind:lower() .. "."
		)
	end

	for _, key in { "width", "heightScale", "depth" } do
		local n = value[key] or (key == "depth" and 1.2 or 1)
		assert(
			modelModule.finite(n) and n >= (key == "depth" and 0.55 or 0.01) and n <= 20,
			"Enter a valid " .. key
		)
		v[key] = n
	end

	v.images = {}
	for i, id in value.images or objectsModule.images do
		id = tostring(id):gsub("rbxassetid://", "")
		assert(id:match("^%d+$") and #id <= 20, "Enter a numeric image asset ID.")
		v.images[i] = id
	end

	assert(#v.images == 4, "Vignette needs four image tile IDs.")
	return v
end

local function uniqueName(name)
	local names = {}
	for _, r in refs.State.getAllRigs() do
		names[r.Name] = true
	end

	local n = 1
	local result = name
	while names[result] or folder():FindFirstChild(result) do
		n += 1
		result = name .. " " .. n
	end

	return result
end

local function makeKey(motor, value, frame, ease)
	local cf = properties.is(motor) and properties.encode(value) or value
	return {
		Motor = motor,
		Part = motor.Part1,
		Frame = frame,
		Time = frame / rawModule.Timeline.FPS,
		C0 = cf,
		Position = cf.Position,
		PropertyValue = if properties.is(motor) then value else nil,
		EasingStyle = ease and (ease.style == "Custom" and "Bezier" or ease.style) or "Constant",
		EasingDirection = ease and ease.direction or "Out",
		BezierPoints = ease and ease.curve or nil,
		Overshoot = ease and ease.Overshoot,
		Amplitude = ease and ease.Amplitude,
		Period = ease and ease.Period,
		Parented = true,
		SanitizeName = tostring,
	}
end

function effects.validateImpactFrames(rows)
	assert(
		type(rows) == "table" and #rows > 0 and #rows <= 256,
		"Add between 1 and 256 impact images."
	)
	local result = {}
	for _, row in rows do
		assert(type(row) == "table", "Invalid impact image.")
		local delay, hold = tonumber(row.delay), tonumber(row.hold)
		assert(
			modelModule.finite(delay) and delay >= 0 and delay % 1 == 0 and delay <= modelModule.MAX_FRAME,
			"Delay must be a whole number of frames, zero or more."
		)
		assert(
			modelModule.finite(hold) and hold >= 1 and hold % 1 == 0 and hold <= modelModule.MAX_FRAME,
			"Hold must be at least one whole frame."
		)
		local image = objectsModule.impactImage(row.image)
		assert(image ~= "", "Choose an image for every frame.")
		table.insert(result, { image = image, delay = delay, hold = hold })
	end

	return result
end

function effects.impactDraft()
	return {
		{ image = "builtin:White", delay = 0, hold = 1 },
		{ image = "builtin:Burst", delay = 0, hold = 1 },
		{ image = "builtin:Inverse", delay = 0, hold = 1 },
		{ image = "builtin:Black", delay = 1, hold = 1 },
	}
end

function effects.createImpact(rows, start)
	assert(not rawModule.Timeline.Exporting, "Wait for the module export to finish.")
	assert(not rawModule.Timeline.Playing, "Pause playback before adding impact frames.")
	local frames = effects.validateImpactFrames(rows)
	local duration = 0
	for _, row in frames do
		duration += row.delay + row.hold
	end

	local value = modelModule.defaults(
		"Impact Frames",
		start or math.round(rawModule.Timeline.CurrentTime * rawModule.Timeline.FPS),
		rawModule.Timeline.FPS
	)
	value.color = { 1, 1, 1 }
	value.duration = duration
	value.fadeIn = 0
	value.fadeOut = 0
	value.frames = frames
	return effects.create(value)
end

function effects.createShake(strength, speed, start, duration, cameraId, envelope)
	assert(not rawModule.Timeline.Exporting, "Wait for the module export to finish.")
	assert(not rawModule.Timeline.Playing, "Pause playback before adding camera shake.")
	local value = modelModule.defaults(
		"Camera Shake",
		start or math.round(rawModule.Timeline.CurrentTime * rawModule.Timeline.FPS),
		rawModule.Timeline.FPS
	)
	value.duration = duration or math.max(1, math.round(rawModule.Timeline.FPS * 0.5))
	value.fadeIn = 0
	value.fadeOut = 0
	value.cameraId = cameraId
	value.strength = strength or 1
	value.speed = speed or 12
	if envelope then
		value.shakeEnvelope = true
		value.fadeIn = envelope.fadeIn
		value.fadeOut = envelope.fadeOut
		value.easeIn = envelope.easeIn or value.easeIn
		value.easeOut = envelope.easeOut or value.easeOut
	end

	return effects.create(value)
end

local phaseCaches = setmetatable({}, { __mode = "k" })

local function shakeSpeed(value)
	return modelModule.finite(value) and math.clamp(value, 0, 60) or 12
end

function effects.shakePhase(motor, bucket, time, speed)
	time = math.max(0, time)
	if not motor or motor:GetAttribute("EclipseDisabled") or not bucket or not next(bucket) then
		return time * shakeSpeed(speed)
	end

	local revision = require("poseCache").revision()
	local cache = phaseCaches[motor]
	if
		not cache
		or cache.bucket ~= bucket
		or cache.revision ~= revision
		or cache.default ~= motor.DefaultValue
	then
		local times = { 0 }
		local seen = { [0] = true }
		for _, key in bucket do
			if
				not key.Disabled
				and modelModule.finite(key.Time)
				and key.Time > 0
				and not seen[key.Time]
			then
				seen[key.Time] = true
				table.insert(times, key.Time)
			end
		end

		table.sort(times)
		cache = {
			bucket = bucket,
			revision = revision,
			default = motor.DefaultValue,
			times = times,
			sums = { [1] = 0 },
			built = 1,
		}
		phaseCaches[motor] = cache
	end

	local function sample(t)
		return shakeSpeed(properties.evaluate(motor, bucket, t))
	end

	local function integral(a, b)
		if b <= a then
			return 0
		end

		local epsilon = math.min(1e-8, (b - a) * 1e-6)

		local function refine(lo, hi, fa, fm, fb, area, tolerance, depth)
			local mid = (lo + hi) * 0.5
			local left = sample((lo + mid) * 0.5)
			local right = sample((mid + hi) * 0.5)
			local aa = (mid - lo) * (fa + 4 * left + fm) / 6
			local bb = (hi - mid) * (fm + 4 * right + fb) / 6
			if depth == 0 or math.abs(aa + bb - area) <= 15 * tolerance then
				return aa + bb + (aa + bb - area) / 15
			end

			return refine(lo, mid, fa, left, fm, aa, tolerance * 0.5, depth - 1)
				+ refine(mid, hi, fm, right, fb, bb, tolerance * 0.5, depth - 1)
		end

		local fa, fm, fb = sample(a + epsilon), sample((a + b) * 0.5), sample(b - epsilon)
		return refine(a, b, fa, fm, fb, (b - a) * (fa + 4 * fm + fb) / 6, 1e-5, 10)
	end

	local times = cache.times
	local low, high, index = 1, #times, 1
	while low <= high do
		local mid = (low + high) // 2
		if times[mid] <= time then
			index = mid
			low = mid + 1
		else
			high = mid - 1
		end
	end

	for i = cache.built, index - 1 do
		cache.sums[i + 1] = cache.sums[i] + integral(times[i], times[i + 1])
		cache.built = i + 1
	end

	if index == #times then
		return cache.sums[index] + (time - times[index]) * sample(time)
	end

	return cache.sums[index] + integral(times[index], time)
end

function effects.shake(time, exporting, camera)
	if not camera or not cameraModule.isRig(camera) then
		return CFrame.identity
	end

	if not refs or suspended or not exporting and not presentationActive() then
		return CFrame.identity
	end

	time = time or rawModule.Timeline.CurrentTime
	local result = CFrame.identity
	for _, model in refs.State.getAllRigs() do
		if
			not model.Parent
			or objectsModule.kind(model) ~= "Camera Shake"
			or organization.cameraFor(model) ~= camera
			or not organization.isEnabled(model)
		then
			continue
		end

		local values = {
			Strength = objectsModule.read(model, "Strength"),
			Speed = objectsModule.read(model, "Speed"),
			Enabled = objectsModule.read(model, "Enabled"),
		}
		local speedMotor
		for _, motor in properties.list(model) do
			if motor.PropertyId == "Speed" then
				speedMotor = motor
			end

			values[motor.PropertyId] = motor:GetAttribute("EclipseDisabled") and motor.DefaultValue
				or properties.evaluate(motor, rawModule.Timeline.Keyframes[motor], time)
		end

		if values.Enabled == false then
			continue
		end

		local strength = modelModule.finite(values.Strength) and math.clamp(values.Strength, 0, 100) or 0
		local speed = modelModule.finite(values.Speed) and math.clamp(values.Speed, 0, 60) or 12
		if strength == 0 then
			continue
		end

		local seed = 0
		for i = 1, #model:GetAttribute("EclipseTrackId") do
			seed = (seed * 31 + model:GetAttribute("EclipseTrackId"):byte(i)) % 65521
		end

		local phase = effects.shakePhase(
			speedMotor,
			speedMotor and rawModule.Timeline.Keyframes[speedMotor],
			time,
			speed
		)

		result *= shake.offset(seed, phase, Vector3.one * (strength * 0.15), Vector3.one * math.rad(strength * 1.5))
	end

	return result
end

function effects.impactAssets()
	local result, seen = {}, {}

	local function add(value)
		if type(value) == "string" and value:match("^rbxassetid://%d+$") and not seen[value] then
			seen[value] = true
			table.insert(result, value)
		end
	end

	for _, model in refs.State.getAllRigs() do
		if objectsModule.kind(model) == "Impact Frames" then
			add(objectsModule.read(model, "Image"))
			for _, motor in properties.list(model) do
				if motor.PropertyId == "Image" then
					for _, key in rawModule.Timeline.Keyframes[motor] or {} do
						add(key.PropertyValue)
					end
				end
			end
		end
	end

	return result
end

local preparedImages = {}
local prepareWarning, prepareWarnedAt

function effects.prepare(isCurrent)
	if not require("afterimages").prepare(isCurrent) then
		return false
	end
	if not isCurrent() then
		return false
	end

	local assets = effects.impactAssets()
	if #assets == 0 then
		return true
	end

	local images = {}
	for _, asset in assets do
		if not preparedImages[asset] then
			local image = Instance.new("ImageLabel")
			image.Image = asset
			table.insert(images, image)
		end
	end

	if #images == 0 then
		return true
	end

	local provider = game:GetService("ContentProvider")
	local done, failed = false, false
	local worker = task.spawn(function()
		local ok = pcall(function()
			provider:PreloadAsync(images, function(_, status)
				if status ~= Enum.AssetFetchStatus.Success then
					failed = true
				end
			end)
		end)
		failed = failed or not ok
		done = true
	end)
	local deadline = os.clock() + 12
	while not done and isCurrent() and os.clock() < deadline do
		task.wait()
	end

	if not done then
		pcall(task.cancel, worker)
	end

	for _, image in images do
		image:Destroy()
	end

	if not isCurrent() then
		return false
	end

	if not done or failed then
		table.sort(assets)
		local signature = table.concat(assets, "|")
		if prepareWarning ~= signature or os.clock() - (prepareWarnedAt or 0) > 10 then
			prepareWarning, prepareWarnedAt = signature, os.clock()
			require("notification").show(
				"IMPACT FRAMES",
				"An impact image could not load. Use an image or decal ID and check its permissions, then try again.",
				4
			)
		end

		return false
	end

	for _, asset in assets do
		preparedImages[asset] = true
	end

	prepareWarning = nil
	return true
end

function effects.seed(model, value)
	if value.kind == "Smear Frames" and value.range and not value.range.whole then
		local motor = properties.enable(model, "Enabled", true, rawModule.Timeline)
		local range = value.range
		rawModule.Timeline.Keyframes[motor] = {[0] = makeKey(motor, false, 0), [range.start] = makeKey(motor, true, range.start), [range.finish + 1] = makeKey(motor, false, range.finish + 1)}
		return
	end
	if value.kind == "Afterimage" or value.kind == "Smear Frames" then
		local motor = properties.enable(model, "Enabled", true, rawModule.Timeline)
		rawModule.Timeline.Keyframes[motor] = { [0] = makeKey(motor, true, 0) }
		return
	end
	local raw = rawModule.Timeline
	local solid = value.kind == "Letterbox" and value.style == "Solid"
	if solid then
		objectsModule.write(model, "Transparency", 1 - value.opacity)
	end

	for _, definition in objectsModule.catalog(model) do
		if
			definition.legacy
			or definition.optional and (definition.id == "ZIndex" or not value.gradient)
		then
			continue
		end

		local motor = properties.enable(model, definition.id, true, raw)
		local keys = {}
		raw.Keyframes[motor] = keys
		if value.kind == "Camera Shake" and definition.id == "Strength" then
			if value.shakeEnvelope then
				local start, finish = value.start, value.start + value.duration
				keys[0] = makeKey(motor, 0, 0)
				keys[start] = makeKey(
					motor,
					value.fadeIn > 0 and 0 or value.strength,
					start,
					value.fadeIn > 0 and value.easeIn or nil
				)
				if value.fadeIn > 0 then
					keys[start + value.fadeIn] =
						makeKey(motor, value.strength, start + value.fadeIn)
				end

				if value.fadeOut > 0 then
					keys[finish - value.fadeOut] =
						makeKey(motor, value.strength, finish - value.fadeOut, value.easeOut)
				end

				keys[finish] = makeKey(motor, 0, finish)
				for _, key in keys do
					key.HandleType = "Vector"
				end
			else
				keys[0] = makeKey(motor, 0, 0)
				keys[value.start] = makeKey(
					motor,
					value.strength,
					value.start,
					{ style = "Linear", direction = "Out" }
				)
				keys[value.start + value.duration] = makeKey(motor, 0, value.start + value.duration)
			end
		elseif value.kind == "Camera Shake" and definition.id == "Speed" then
			keys[0] = makeKey(motor, value.speed, 0)
		elseif value.kind == "Impact Frames" and definition.id == "Image" then
			keys[0] = makeKey(motor, "", 0)
			local at = value.start
			for _, row in value.frames do
				at += row.delay
				keys[at] = makeKey(motor, row.image, at)
				at += row.hold
				keys[at] = makeKey(motor, "", at)
			end
		elseif value.kind == "Impact Frames" and definition.id == "Transparency" then
			keys[0] = makeKey(motor, 0, 0)
		elseif definition.id == "Progress" then
			keys[value.start] = makeKey(motor, 0, value.start, { style = "Linear", direction = "Out" })
			keys[value.start + value.duration] = makeKey(motor, 1, value.start + value.duration)
		elseif definition.id == "Transparency" and not solid then
			local start, finish = value.start, value.start + value.duration
			local level = 1 - value.opacity
			keys[0] = makeKey(motor, 1, 0)
			keys[start] = makeKey(
				motor,
				value.fadeIn > 0 and 1 or level,
				start,
				value.fadeIn > 0 and value.easeIn or nil
			)
			if value.fadeIn > 0 then
				keys[start + value.fadeIn] = makeKey(motor, level, start + value.fadeIn)
			end

			if value.fadeOut > 0 then
				keys[finish - value.fadeOut] =
					makeKey(motor, level, finish - value.fadeOut, value.easeOut)
			end

			keys[finish] = makeKey(motor, 1, finish)
		else
			keys[value.start] = makeKey(motor, objectsModule.read(model, definition.id), value.start)
		end
	end

	for _, joint in model:GetDescendants() do
		if joint:IsA("Motor6D") and joint:GetAttribute("EclipsePartRigJoint") then
			raw.DefaultPose[joint] = joint.C0
			raw.DefaultWorldPose[joint] = joint.Part1.CFrame
			raw.DefaultSize[joint.Part1] = joint.Part1.Size
			raw.ParentingDefaults[joint] = true
			raw.MotorByPart[joint.Part1] = joint
			local key = makeKey(joint, joint.C0, value.start)
			local defaults = require("savedDefaults").get()
			for id, v in defaults do
				key[id] = v
			end

			key.WholePoseScale = { scale_x = 1, scale_y = 1, scale_z = 1 }
			raw.Keyframes[joint] = { [value.start] = key }
		end
	end
end

function effects.create(value, options)
	options = options or {}
	value = effects.validateForProject(value)
	suspended = false
	local oldLength = rawModule.Config.Length
	if refs.Finalize and not options.loading then
		refs.Finalize()
	end

	local target = value.kind == "Letterbox" and effects.resolveCamera(value.cameraId) or nil
	local view = workspace.CurrentCamera
	local size = view and view.ViewportSize or Vector2.new(16, 9)
	local model = objectsModule.build(
		value,
		target and { cf = cameraModule.viewFrame(target.rig), fov = cameraModule.fov(target.rig) },
		size.X / math.max(1, size.Y)
	)
	model.Name = uniqueName(value.name)
	model:SetAttribute("EclipseLegacyEffectId", options.legacyId)
	local parent = folder()
	model.Parent = parent
	objectsModule.paint(model, false, 0)
	local original = model
	local originalParent = parent
	local ok, err = xpcall(function()
		for _, def in objectsModule.catalog(model) do
			if not def.legacy and (not def.optional or value.gradient and def.id ~= "ZIndex") then
				properties.enable(model, def.id, true)
			end
		end

		refs.AddRig(model, { Loading = true })
		if not table.find(refs.State.getAllRigs(), model) then
			for _, candidate in refs.State.getAllRigs() do
				if
					candidate:GetAttribute("EclipseTrackId")
					== model:GetAttribute("EclipseTrackId")
				then
					model = candidate
					parent = model.Parent
					break
				end
			end
		end

		assert(
			table.find(refs.State.getAllRigs(), model),
			"Could not add the effect to the timeline."
		)
		effects.seed(model, value)
		if value.kind ~= "Letterbox" or value.style ~= "Solid" then
			rawModule.Config.Length =
				math.max(rawModule.Config.Length, (value.start + value.duration) / rawModule.Timeline.FPS)
		end

		refs.RefreshStructure()
		refs.State.currentProjectSaved = false
	end, debug.traceback)
	if not ok then
		if table.find(refs.State.getAllRigs(), model) then
			refs.RemoveRig(model, { Loading = true })
		end

		model:Destroy()
		error(err, 0)
	end

	local epoch = generation
	local snapshot
	if not options.loading then
		history.record(function()
			if epoch ~= generation then
				return
			end

			local _, saved = refs.RemoveRig(model, { Loading = true })
			snapshot = saved
			model.Parent = nil
			if original ~= model then
				original.Parent = nil
			end

			rawModule.Config.Length = oldLength
			refs.RefreshStructure()
			effects.refresh()
		end, function()
			if epoch ~= generation or not snapshot then
				return
			end

			if original ~= model then
				original.Parent = folder()
			end

			model.Parent = folder()
			refs.RestoreRig(snapshot)
			rawModule.Config.Length = value.kind == "Letterbox" and value.style == "Solid" and oldLength
				or math.max(oldLength, (value.start + value.duration) / rawModule.Timeline.FPS)
			refs.RefreshStructure()
			effects.refresh()
		end, "Add " .. value.kind)
	end

	properties.apply(model, rawModule.Timeline, rawModule.Timeline.CurrentTime)
	effects.refresh()
	return model
end

function effects.refresh()
	if not refs then
		return
	end

	local nextTracked = {}
	for _, model in refs.State.getAllRigs() do
		if objectsModule.is(model) then
			nextTracked[model] = true
		end
	end

	for model in tracked do
		if not nextTracked[model] then
			park(model)
		end
	end

	tracked = nextTracked
	cleanFolders()
	effects.step()
end

function effects.updateFovRows()
	for button, model in fovButtons do
		if not button.Parent or not model.Parent then
			fovButtons[button] = nil
			continue
		end

		local follow = objectsModule.read(model, "FollowFOV") ~= false
		button.Text = follow and "F" or "W"
		button.TextColor3 = follow and Color3.fromRGB(97, 255, 197) or Color3.fromRGB(255, 198, 103)
		button.Active = not rawModule.Timeline.Playing
		button.AutoButtonColor = not rawModule.Timeline.Playing
	end
end

function effects.setFovFollow(model, value)
	assert(refs and objectsModule.kind(model) == "Letterbox", "Select a letterbox")
	assert(not require("blenderEdit").blocked(), "Finish the current edit first")
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	assert(not raw.Playing, "Pause playback before changing FOV follow")
	if refs.Finalize then
		refs.Finalize()
	end

	local motor = properties.enable(model, "FollowFOV", true, raw)
	local before = timeline:_snapshotMotorBucket(motor)
	local frame = timeline:TimeToFrame(raw.CurrentTime)
	local camera = effects.resolveCamera(model:GetAttribute("EffectCameraId"))
	assert(camera, "Letterbox camera is unavailable")
	local fov = cameraModule.fov(camera.rig)
	objectsModule.follow(model, { cf = cameraModule.viewFrame(camera.rig), fov = fov }, raw)
	local anchor = Vector3.new(objectsModule.followRatio(model), fov, 0)
	timeline:RecordKeyframeForMotorAtCurrentTime(
		motor.Part1,
		motor,
		properties.encode(value),
		{ Frame = frame, PropertyValue = value },
		refs.State.UIHelpers.SanitizeName
	)
	raw.Keyframes[motor][frame].FovFollowAnchor = anchor
	local after = timeline:_snapshotMotorBucket(motor)

	local function apply(bucket)
		if not model.Parent then
			return
		end

		timeline:_restoreMotorBucket(motor, bucket)
		properties.apply(model, raw, raw.CurrentTime)
		refs.State.currentProjectSaved = false
		refs.RefreshStructure()
		effects.step()
	end

	apply(after)
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Letterbox FOV follow")
	return raw.Keyframes[motor][frame]
end

function effects.bindFovRow(item)
	local model = item.linkedRigInstance
	if objectsModule.kind(model) ~= "Letterbox" or item.fovFollowButton then
		return
	end

	local button =
		require("parentingUi").modeButton(item.appearDetails.RightDiv, "LetterboxFollowFOV")
	button.AnchorPoint = Vector2.new(0.5, 0.5)
	button.LayoutOrder = -2
	item.fovFollowButton = button
	fovButtons[button] = model
	local hover = item.rigModule.refs.UIHelpers.hoverDialog
	if hover then
		hover:latchToInstance(
			button,
			"F: follow camera FOV / W: fixed world sizing. Key at current frame."
		)
	end

	table.insert(
		item.connections,
		button.MouseButton1Click:Connect(function()
			effects.setFovFollow(model, objectsModule.read(model, "FollowFOV") == false)
		end)
	)
	effects.updateFovRows()
end

function effects.step()
	effects.updateFovRows()
	if not refs then
		return
	end

	local active = not suspended and presentationActive()
	local present = {}
	for _, model in refs.State.getAllRigs() do
		if objectsModule.is(model) and model.Parent then
			present[model] = true
		end
	end

	local parkedAny = false
	for model in tracked do
		if not present[model] then
			parkedAny = park(model) or parkedAny
		end
	end

	tracked = present
	require("afterimages").step(present, active, rawModule.Timeline.CurrentTime * rawModule.Timeline.FPS)
	require("smearFrames").step(present, active, rawModule.Timeline.CurrentTime * rawModule.Timeline.FPS)
	for model in present do
		if not active then
			parkedAny = park(model) or parkedAny
			if overlays[model] then
				overlays[model]:Destroy()
				overlays[model] = nil
			end

			continue
		end

		parkedModels[model] = nil
		if model.Parent == parked() then
			model.Parent = folder()
		end

		local enabled = active and organization.isEnabled(model) and objectsModule.read(model, "Enabled")
		if objectsModule.kind(model) == "Camera Shake" or objectsModule.kind(model) == "Afterimage" or objectsModule.kind(model) == "Smear Frames" then
			continue
		end

		if objectsModule.kind(model) == "Letterbox" then
			local camera = effects.resolveCamera(model:GetAttribute("EffectCameraId"))
			if camera then
				objectsModule.follow(model, {
					cf = cameraModule.viewFrame(
						camera.rig,
						nil,
						refs.State.Timeline:GetPoseTime(rawModule.Timeline.CurrentTime)
					) * effects.shake(nil, false, camera.rig),
					fov = cameraModule.fov(
						camera.rig,
						refs.State.Timeline:GetPoseTime(rawModule.Timeline.CurrentTime)
					),
				}, rawModule.Timeline)
			end

			objectsModule.paint(
				model,
				enabled and camera ~= nil and camera.enabled,
				rawModule.Timeline.CurrentTime
			)
		else
			local frame = overlays[model]
			if not frame then
				if not gui then
					gui = Instance.new("ScreenGui")
					gui.Name = "EclipseEffectOverlays"
					gui:SetAttribute("EclipseOwnedUI", true)
					gui.IgnoreGuiInset = true
					gui.ResetOnSpawn = false
					gui.DisplayOrder = refs.ScreenGui.DisplayOrder - 1
					gui.Parent = refs.ScreenGui.Parent
				end

				frame = objectsModule.overlay(model, gui)
				overlays[model] = frame
			end

			objectsModule.paintOverlay(model, frame, enabled)
		end
	end

	for model, frame in overlays do
		if not present[model] then
			frame:Destroy()
			overlays[model] = nil
		end
	end

	stepCount += 1
	if parkedAny or stepCount % 60 == 0 then
		cleanFolders()
	end
end

function effects.write(save)
	for _, model in refs.State.getAllRigs() do
		if require("afterimageBinding").is(model) then
			local target = require("afterimageBinding").target(model)
			if target then
				require("afterimageBinding").save(model, target, refs.State.getAllRigs())
			end
		end
	end
	if next(rawModule.Timeline.ScreenEffects or {}) then
		chunks.write(save, "EclipseScreenEffects", http:JSONEncode(rawModule.Timeline.ScreenEffects))
	end

	local objects = Instance.new("Folder")
	objects.Name = "EclipseEffectObjects"
	for _, model in refs.State.getAllRigs() do
		if objectsModule.is(model) then
			local clone = model:Clone()
			for _, node in clone:GetDescendants() do
				if node:IsA("LuaSourceContainer") then
					node:Destroy()
				end
			end

			clone.Parent = objects
		end
	end

	if #objects:GetChildren() > 0 then
		objects.Parent = save
	else
		objects:Destroy()
	end
end

function effects.restoreObjects(save)
	local saved = save and save:FindFirstChild("EclipseEffectObjects")
	if not saved then
		return
	end

	local existing = {}
	local step = loadStep()
	for _, scope in { refs.EffectsWorldParent or workspace, parked() } do
		for index, v in scope:GetDescendants() do
			if step and index % 4096 == 0 then
				step()
			end

			if objectsModule.is(v) and v:GetAttribute("EclipseTrackId") then
				existing[v:GetAttribute("EclipseTrackId")] = v
			end
		end
	end

	for _, model in saved:GetChildren() do
		if objectsModule.is(model) then
			local current = existing[model:GetAttribute("EclipseTrackId")]
			if current then
				if current.Parent == parked() then
					current.Parent = folder()
				end

				continue
			end

			local clone = model:Clone()
			for _, node in clone:GetDescendants() do
				if node:IsA("LuaSourceContainer") then
					node:Destroy()
				end
			end

			clone.Parent = folder()
		end
	end
end

function effects.load(save)
	require("smearEditor").close()
	require("afterimages").clear()
	require("smearFrames").clear()
	generation += 1
	if refs and refs.State.EffectsWindow then
		refs.State.EffectsWindow.close(true)
	end

	suspended = save == nil
	if suspended then
		effects.parkAll()
		rawModule.Timeline.ScreenEffects = {}
		return
	end

	rawModule.Timeline.ScreenEffects = {}
	local old = save and save:FindFirstChild("EclipseScreenEffects")
	if old then
		local legacy = modelModule.validateAll(http:JSONDecode(chunks.read(old)))
		for id, value in legacy do
			local exists = false
			for _, r in refs.State.getAllRigs() do
				if r:GetAttribute("EclipseLegacyEffectId") == id then
					exists = true
				end
			end

			if not exists then
				local ok, err = pcall(effects.create, value, { loading = true, legacyId = id })
				if not ok then
					rawModule.Timeline.ScreenEffects[id] = value
					warn("Effect migration: " .. tostring(err))
				end
			end
		end
	end

	effects.refresh()
end

function effects.setPreview() end

function effects.destroy()
	require("afterimages").destroy()
	require("smearFrames").destroy()
	phaseCaches = setmetatable({}, { __mode = "k" })
	cameraModule.viewOffset = nil
	if connection then
		connection:Disconnect()
		connection = nil
	end

	for _, listener in lifetime do
		listener:Disconnect()
	end

	table.clear(lifetime)
	if refs then
		effects.parkAll()
	end

	if gui then
		gui:Destroy()
		gui = nil
	end
end

function effects.init(options)
	effects.destroy()
	refs = options
	require("afterimages").init(options)
	require("smearFrames").init(options)
	refs.State.ScreenEffects = effects
	cameraModule.viewOffset = function(camera, time)
		return effects.shake(time, false, camera)
	end

	if not options.EffectsWorldParent then
		require("layer").cleanupStale()
	end

	suspended = false
	effects.parkAll()
	connection = run.RenderStepped:Connect(function()
		if suspended or not presentationActive() then
			effects.step()
		end
	end)
	table.insert(lifetime, refs.ScreenGui.Destroying:Once(effects.destroy))
	table.insert(lifetime, refs.Plugin.Unloading:Once(effects.destroy))
	effects.refresh()
end

return effects
