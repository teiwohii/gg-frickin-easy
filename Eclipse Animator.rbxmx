						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local state = require("rawState")
local history = require("history")
local eventPlayback = require("eventPlayback")
local preferences = require("preferences")
local motionPath = require("motionPath")
local graphCurves = require("graphCurves")
local mainState = require("state")

local timelineState = state.Timeline
local timelineConfig = state.Config

local function validFps(value)
	return typeof(value) == "number"
		and value == value
		and value >= 1
		and value <= 1000
		and value % 1 == 0
end

local function playbackFailure(self, issue)
	self._playbackPreparation = nil
	self._playbackReadyAt = nil
	timelineState.Playing = false
	timelineState.LastPlaybackFrame = nil
	pcall(eventPlayback.stop)
	local message = tostring(issue)
	if self._lastPlaybackFailure ~= message then
		self._lastPlaybackFailure = message
		warn("[Eclipse Playback] " .. message)
		pcall(function()
			require("notification").show(
				"PLAYBACK STOPPED",
				"Playback could not continue. Your animation is still open. See Output for details.",
				6
			)
		end)
	end

	return false, issue
end

return function(Timeline)
	function Timeline:GetPlaybackStartTime()
		return math.clamp(
			timelineState.PlaybackStartFrame or 0,
			0,
			math.max(0, self:GetPlaybackEndTime() * timelineState.FPS - 1)
		) / timelineState.FPS
	end

	function Timeline:GetPoseTime(time, continuous)
		local skip = timelineState.SkipFrames or 0
		if continuous ~= false and skip <= 0 then
			return math.max(0, time)
		end
		local step = math.max(0, skip) + 1
		return math.floor((math.max(0, time) * timelineState.FPS + 1e-7) / step)
			* step
			/ timelineState.FPS
	end

	function Timeline:IsExportLocked()
		local live = mainState.LiveSession
		return timelineState.Exporting ~= nil
			or (live and live.isExporting and live.isExporting())
			or false
	end

	function Timeline:SetFPS(value, loading)
		if not validFps(value) then
			return false
		end

		local previous = timelineState.FPS
		if previous == value then
			return true
		end

		local function apply(fps)
			local oldFps = timelineState.FPS
			local frame = self:TimeToFrame(timelineState.CurrentTime)
			local lastFrame = self:GetMaxFrame()
			timelineState.Playing = false
			timelineState.FPS = fps
			eventPlayback.clear()
			timelineState.CurrentTime = frame / fps
			timelineState.LastPlaybackFrame = nil
			timelineConfig.Length = lastFrame / fps
			for _, bucket in require("layers").buckets(timelineState) do
				for frameNumber, key in pairs(bucket) do
					key.Time = frameNumber / fps
					for _, point in pairs(key.GraphCurves or {}) do
						if point.In then
							point.In[1] *= oldFps / fps
						end

						if point.Out then
							point.Out[1] *= oldFps / fps
						end
					end
				end

				graphCurves.invalidate(bucket)
			end

			self:RefreshTimelineScale()
			if mainState.GraphEditor then
				mainState.GraphEditor.invalidate()
			end

			local rig = self.refs.GetCurrentRig and self.refs.GetCurrentRig()
			if rig then
				self:ApplyPoseAtTime(rig, timelineState.CurrentTime)
			end

			motionPath.markDirty()
			if not loading then
				if self.refs.SetSetting then
					self.refs.SetSetting("TimelineFPS", fps)
				end

				if self.refs.SetCurrentRigUnsaved then
					self.refs.SetCurrentRigUnsaved()
				end
			end
		end

		apply(value)
		if not loading then
			history.record(function()
				apply(previous)
			end, function()
				apply(value)
			end, "Change FPS")
		end

		return true
	end

	function Timeline:LoadProjectSettings(sequence, settings)
		local priority = settings and settings:GetAttribute("AnimationPriority")
			or sequence and sequence.Priority.Name
		timelineState.AnimationPriority = Enum.AnimationPriority.Action
		if type(priority) == "string" then
			pcall(function()
				timelineState.AnimationPriority = Enum.AnimationPriority[priority]
			end)
		end

		local fps = settings and settings:GetAttribute("FPS")
			or sequence and sequence:GetAttribute("FPS")
		if not validFps(fps) then
			fps = not sequence and not settings and preferences.get("DefaultFPS") or 60
		end

		timelineState.FPS = validFps(fps) and fps or 60
		local skip = settings and settings:GetAttribute("EclipseSkipFrames")
			or sequence and sequence:GetAttribute("EclipseSkipFrames")
		timelineState.SkipFrames = type(skip) == "number"
				and skip == skip
				and skip >= 0
				and skip <= 120
				and skip % 1 == 0
				and skip
			or 0
		local start = settings and settings:GetAttribute("EclipsePlaybackStartFrame")
			or sequence and sequence:GetAttribute("EclipsePlaybackStartFrame")
		timelineState.PlaybackStartFrame = type(start) == "number"
				and start == start
				and start >= 0
				and start <= 1000000
				and start % 1 == 0
				and start
			or 0
		timelineState.CurrentTime = 0
		timelineState.Playing = false
		timelineState.LastPlaybackFrame = nil
		timelineState.ScrollOffset = 0
		local lastFrame = settings and settings:GetAttribute("EclipseTimelineEnd")
			or sequence and sequence:GetAttribute("EclipseTimelineEnd")
		if
			typeof(lastFrame) ~= "number"
			or lastFrame ~= lastFrame
			or math.abs(lastFrame) == math.huge
			or lastFrame < 1
		then
			lastFrame = not sequence and not settings and preferences.get("DefaultTrackLength")
				or timelineConfig.DefaultFrames
		end

		lastFrame = math.max(1, math.floor(lastFrame))
		if sequence then
			for _, key in ipairs(sequence:GetKeyframes()) do
				lastFrame = math.max(lastFrame, self:TimeToFrame(key.Time))
			end
		end

		timelineState.PlaybackStartFrame = math.min(timelineState.PlaybackStartFrame, lastFrame - 1)
		timelineConfig.Length = lastFrame / timelineState.FPS
		if self.timelineZoom then
			self.timelineZoom.zoomScale = 1
		end

		require("origin").read(settings or sequence, self)
		self:RefreshTimelineScale()
	end

	function Timeline:WriteProjectSettings(target)
		local priority = timelineState.AnimationPriority or Enum.AnimationPriority.Action
		target:SetAttribute("AnimationPriority", priority.Name)
		if target:IsA("KeyframeSequence") then
			target.Priority = priority
		end

		target:SetAttribute("FPS", timelineState.FPS)
		target:SetAttribute("EclipseSkipFrames", timelineState.SkipFrames or 0)
		target:SetAttribute("EclipsePlaybackStartFrame", timelineState.PlaybackStartFrame or 0)
		target:SetAttribute("EclipseTimelineEnd", self:GetMaxFrame())
		if not target:IsA("KeyframeSequence") then
			require("origin").write(target, self)
		end
	end

	function Timeline:EnsureTimelineEnd(frame)
		if frame <= self:GetMaxFrame() then
			return
		end

		timelineConfig.Length = math.ceil(frame) / timelineState.FPS
		self:RefreshTimelineScale()
	end

	function Timeline:CaptureTimelineEnd()
		return {
			frame = self:GetMaxFrame(),
			time = timelineState.CurrentTime,
			scroll = timelineState.ScrollOffset,
		}
	end

	function Timeline:ApplyTimelineEnd(value, dirty)
		timelineState.Playing = false
		eventPlayback.clear()
		timelineConfig.Length = value.frame / timelineState.FPS
		timelineState.CurrentTime = value.time
		timelineState.LastPlaybackFrame = nil
		self._playbackEndAt = nil
		self:RefreshTimelineScale()
		self:SetTimelineScroll(value.scroll)
		self:UpdatePlayhead()
		local rig = self.refs.GetCurrentRig and self.refs.GetCurrentRig()
		if rig then
			self:ApplyPoseAtTime(rig, value.time)
		end

		if dirty and self.refs.SetCurrentRigUnsaved then
			self.refs.SetCurrentRigUnsaved()
		end
	end

	function Timeline:SetTimelineEnd(frame, before, preview, followEnd)
		if self:IsExportLocked() then
			return false
		end

		frame = tonumber(frame)
		if not frame or frame ~= frame or math.abs(frame) == math.huge then
			return false
		end

		frame = math.max(1, math.floor(frame + 0.5))
		before = before or self:CaptureTimelineEnd()
		local after = {
			frame = frame,
			time = math.min(before.time, frame / timelineState.FPS),
			scroll = before.scroll,
		}
		if followEnd then
			local viewport = self:GetTimelineViewportWidth()
			local width = viewport
				* math.max(1, frame / timelineConfig.DefaultFrames)
				* self:GetZoomScale()
			after.scroll = math.max(0, math.floor(width + 0.5) - viewport)
		end

		if preview then
			if frame ~= self:GetMaxFrame() or after.time ~= timelineState.CurrentTime then
				self:ApplyTimelineEnd(after, false)
			end

			return true
		end

		if frame == before.frame then
			self:ApplyTimelineEnd(before, false)
			return false
		end

		local function apply(value)
			self:ApplyTimelineEnd(value, true)
		end

		apply(after)
		history.record(function()
			apply(before)
		end, function()
			apply(after)
		end, "Animation length")
		return true
	end

	function Timeline:FitTimeline()
		if self:IsExportLocked() then
			return false
		end

		local last = self:GetLastKeyframeFrame()
		if last == nil then
			return false
		end

		local target = math.max(1, math.ceil(last))
		local before = {
			frame = self:GetMaxFrame(),
			time = timelineState.CurrentTime,
			scroll = timelineState.ScrollOffset,
		}
		if target == before.frame then
			return false
		end

		local after = {
			frame = target,
			time = math.min(before.time, target / timelineState.FPS),
			scroll = before.scroll,
		}

		local function apply(snapshot)
			timelineState.Playing = false
			eventPlayback.clear()
			timelineConfig.Length = snapshot.frame / timelineState.FPS
			timelineState.CurrentTime = snapshot.time
			timelineState.LastPlaybackFrame = nil
			self:RefreshTimelineScale()
			self:SetTimelineScroll(snapshot.scroll)
			self:UpdatePlayhead()
			local rig = self.refs.GetCurrentRig and self.refs.GetCurrentRig()
			if rig then
				self:ApplyPoseAtTime(rig, timelineState.CurrentTime)
			end

			if self.refs.SetCurrentRigUnsaved then
				self.refs.SetCurrentRigUnsaved()
			end
		end

		apply(after)
		history.record(function()
			apply(before)
		end, function()
			apply(after)
		end, "Fit timeline")
		return true
	end

	function Timeline:ExtendTimeline()
		if self:IsExportLocked() then
			return false
		end

		local previous = self:GetMaxFrame()
		local nextFrame = previous + timelineState.FPS

		local function apply(frame)
			timelineConfig.Length = math.max(frame, self:GetLastKeyframeFrame() or 0)
				/ timelineState.FPS
			timelineState.CurrentTime = math.min(timelineState.CurrentTime, timelineConfig.Length)
			self:RefreshTimelineScale()
			self:SetTimelineScroll(self:GetTimelineScrollLimit())
			if self.refs.SetCurrentRigUnsaved then
				self.refs.SetCurrentRigUnsaved()
			end
		end

		apply(nextFrame)
		history.record(function()
			apply(previous)
		end, function()
			apply(nextFrame)
		end, "Extend timeline")
	end

	function Timeline:StartPlayback(restartAtEnd)
		if mainState.LimbPointSetupActive then
			return false
		end
		if mainState.LoadingProject and mainState.ProjectLoadThread ~= coroutine.running() then
			return false
		end

		if self:IsExportLocked() then
			timelineState.Playing = false
			return false
		end

		if mainState.BlenderBridge and mainState.BlenderBridge.isFollowing() then
			return false
		end

		if timelineState.Playing then
			return false
		end

		self:SetDraggingPlayhead(false)
		if self.refs.BeforePlayback then
			self.refs.BeforePlayback()
		end

		if
			timelineState.CurrentTime < self:GetPlaybackStartTime()
			or restartAtEnd and timelineState.CurrentTime >= self:GetPlaybackEndTime()
		then
			timelineState.CurrentTime = self:GetPlaybackStartTime()
			self:UpdatePlayhead()
		end

		local time = timelineState.CurrentTime
		local token = {}
		self._playbackPreparation = token
		self._playbackReadyAt = nil
		self._videoSampleAt = nil
		timelineState.Playing = true
		local ok, result = xpcall(function()
			local revision = require("poseCache").revision()
			local tracks = timelineState.Keyframes
			local function current()
				return self._playbackPreparation == token
					and timelineState.Playing
					and timelineState.CurrentTime == time
					and timelineState.Keyframes == tracks
					and require("poseCache").revision() == revision
			end
			local slice = os.clock()
			local function checkpoint()
				if not current() then
					return false
				end
				if os.clock() - slice >= 0.002 then
					task.wait()
					slice = os.clock()
				end
				return current()
			end
			local finish = self:IsLooping() and self:GetPlaybackEndTime() or nil
			for _, bucket in tracks do
				if
					not require("interp").prepare(
						require("policy").activeBucket(bucket),
						finish,
						checkpoint
					)
				then
					if self._playbackPreparation == token then
						self._playbackPreparation = nil
						timelineState.Playing = false
					end
					return false
				end
			end
			local rig = self.refs.GetCurrentRig and self.refs.GetCurrentRig()
			if rig then
				self:ApplyPoseAtTime(rig, time)
			end

			if mainState.ScreenEffects and mainState.ScreenEffects.prepare then
				local loaded = mainState.ScreenEffects.prepare(function()
					return self._playbackPreparation == token
						and timelineState.Playing
						and timelineState.CurrentTime == time
				end)
				if self._playbackPreparation ~= token then
					return false
				end

				if not loaded then
					self._playbackPreparation = nil
					timelineState.Playing = false
					return false
				end
			end

			local ready = eventPlayback.prepare(self, time, rig, time, function()
				return self._playbackPreparation == token
					and timelineState.Playing
					and timelineState.CurrentTime == time
			end)
			if self._playbackPreparation ~= token then
				return false
			end

			if not ready then
				self._playbackPreparation = nil
				timelineState.Playing = false
				return false
			end

			local deadline
			if mainState.VideoBridge then
				deadline = mainState.VideoBridge.prepare(self, time, function()
					return timelineState.Playing
						and timelineState.CurrentTime == time
						and self._playbackPreparation == token
				end)
			end

			if
				self._playbackPreparation ~= token
				or not timelineState.Playing
				or timelineState.CurrentTime ~= time
			then
				if self._playbackPreparation == token then
					self._playbackPreparation = nil
				end

				return false
			end

			self._playbackPreparation = nil
			self._playbackReadyAt = deadline or os.clock()
			self._lastPlaybackFailure = nil
			return true
		end, debug.traceback)
		if not ok then
			if self._playbackPreparation == token then
				return playbackFailure(self, result)
			end

			return false, result
		end

		return result
	end

	function Timeline:AdvanceLocalPlayback(dt)
		if self:IsExportLocked() then
			timelineState.Playing = false
			return false
		end

		if
			mainState.BlenderSampling
			or (mainState.BlenderBridge and mainState.BlenderBridge.advance(dt))
		then
			return
		end

		if self._playbackPreparation then
			return
		end

		if not timelineState.Playing then
			self._playbackReadyAt = nil
			if mainState.VideoBridge then
				mainState.VideoBridge.push(true)
			end

			eventPlayback.pause()
			eventPlayback.preview(self, timelineState.CurrentTime, false)
			timelineState.LastPlaybackFrame = nil
			return
		end

		if self._playbackReadyAt then
			local now = os.clock()
			if now < self._playbackReadyAt then
				return
			end

			dt = math.min(dt, now - self._playbackReadyAt)
			self._playbackReadyAt = nil
		end

		local finish = self:GetPlaybackEndTime()
		eventPlayback.advance(
			self,
			timelineState.CurrentTime,
			dt,
			finish,
			self:IsLooping(),
			self:GetPlaybackStartTime()
		)
		local previousTime = timelineState.CurrentTime
		local time = previousTime + dt
		if time >= finish then
			if self:IsLooping() and finish > 0 then
				local first = self:GetPlaybackStartTime()
				time = first + (time - first) % (finish - first)
			else
				time = finish
				timelineState.Playing = false
			end
		end

		timelineState.CurrentTime = time
		self._videoSampleAt = os.clock()
		local frame = math.floor(time * timelineState.FPS + 1e-6)
		local frameChanged = frame ~= timelineState.LastPlaybackFrame
		if
			time ~= previousTime
			or frameChanged
			or not timelineState.Playing
			or eventPlayback.didFire
		then
			timelineState.LastPlaybackFrame = frame
			local rig = self.refs.GetCurrentRig and self.refs.GetCurrentRig()
			if rig then
				self:ApplyPoseAtTime(rig, time)
			end

			if frameChanged or not timelineState.Playing then
				self:UpdatePlayhead()
			end
		end

		eventPlayback.preview(
			self,
			time,
			timelineState.Playing,
			true,
			self.refs.GetCurrentRig and self.refs.GetCurrentRig(),
			time
		)
	end

	function Timeline:ApplyLivePlayhead(
		frame,
		playing,
		dt,
		looping,
		finish,
		commandChanged,
		startFrame
	)
		if self:IsExportLocked() then
			timelineState.Playing = false
			return false
		end

		local time = math.clamp(frame, 0, self:GetMaxFrame()) / timelineState.FPS
		local previous = timelineState.CurrentTime
		playing = playing == true and (looping == true or frame < finish)
		if timelineState.Playing and not playing and not commandChanged and time >= previous then
			eventPlayback.advance(
				self,
				previous,
				time - previous,
				finish / timelineState.FPS,
				false,
				(startFrame or 0) / timelineState.FPS
			)
		end
		if commandChanged or timelineState.Playing and not playing then
			eventPlayback.pause()
			eventPlayback.preview(self, time, false)
			if playing then
				eventPlayback.advance(
					self,
					time,
					0,
					finish / timelineState.FPS,
					looping == true,
					(startFrame or 0) / timelineState.FPS
				)
			end
		end

		if playing and not commandChanged then
			eventPlayback.advance(
				self,
				previous,
				math.max(0, dt),
				finish / timelineState.FPS,
				looping == true,
				(startFrame or 0) / timelineState.FPS
			)
		end

		timelineState.CurrentTime = time
		timelineState.Playing = playing == true
		local poseFrame = math.floor(time * timelineState.FPS + 1e-6)
		if
			time ~= previous
			or poseFrame ~= timelineState.LastPlaybackFrame
			or commandChanged
			or eventPlayback.didFire
		then
			timelineState.LastPlaybackFrame = poseFrame
			local rig = self.refs.GetCurrentRig and self.refs.GetCurrentRig()
			if rig then
				self:ApplyPoseAtTime(rig, time)
			end
		end

		self:UpdatePlayhead()
		self._videoSampleAt = os.clock()
		eventPlayback.preview(
			self,
			time,
			playing == true,
			true,
			self.refs.GetCurrentRig and self.refs.GetCurrentRig(),
			time
		)
	end

	function Timeline:AdvancePlayback(dt)
		if mainState.LoadingProject and mainState.ProjectLoadThread ~= coroutine.running() then
			return
		end

		if timelineState.Exporting then
			timelineState.Playing = false
			return
		end

		if self._playbackAdvancing then
			return
		end

		self._playbackAdvancing = true
		local ok, issue = xpcall(function()
			local live = mainState.LiveSession
			if not (live and live.advance and live.advance(dt)) then
				self:AdvanceLocalPlayback(dt)
			end

			if live and live.afterAdvance then
				live.afterAdvance()
			end
		end, debug.traceback)
		self._playbackAdvancing = nil
		if not ok then
			return playbackFailure(self, issue)
		end
	end
end
]]></ProtectedString>
						<string name="ScriptGuid">{BF9511F2-BD0A-47E6-B58E-75287D920A6B}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">motionPathKeyframes</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX5375FD0150A74F3C9F196B7BC050441A">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local model = require("model")
local recovery = require("recovery")
local NodeRenderer = {}
NodeRenderer.__index = NodeRenderer

local function decode(v, nodes)
	if type(v) ~= "table" then
		return v
	end

	local t, a = v.t, v.v
	if t == "Vector3" then
		return Vector3.new(table.unpack(a))
	elseif t == "Vector2" then
		return Vector2.new(table.unpack(a))
	elseif t == "CFrame" then
		return CFrame.new(table.unpack(a))
	elseif t == "Color3" then
		return Color3.new(table.unpack(a))
	elseif t == "NumberRange" then
		return NumberRange.new(table.unpack(a))
	elseif t == "EnumItem" then
		return Enum[v.e][a]
	elseif t == "Ref" then
		return nodes[a]
	elseif t == "NumberSequence" then
		local k = {}
		for _, p in a do
			table.insert(k, NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0))
		end

		return NumberSequence.new(k)
	elseif t == "ColorSequence" then
		local k = {}
		for _, p in a do
			table.insert(k, ColorSequenceKeypoint.new(p[1], decode(p[2])))
		end

		return ColorSequence.new(k)
	end

	error("Unsupported effect asset value: " .. tostring(t))
end

local function sequence(sequence, fn)
	local result = {}
	for _, k in sequence.Keypoints do
		table.insert(result, NumberSequenceKeypoint.new(k.Time, fn(k.Value), 0))
	end

	return NumberSequence.new(result)
end

local function sample(seq, t)
	local keys = seq.Keypoints
	local left = keys[1]
	for i = 2, #keys do
		local right = keys[i]
		if t <= right.Time then
			local f = (t - left.Time) / math.max(0.000001, right.Time - left.Time)
			if typeof(left.Value) == "Color3" then
				return left.Value:Lerp(right.Value, f)
			end

			return left.Value + (right.Value - left.Value) * f
		end

		left = right
	end

	return left.Value
end

local function tint(c, t)
	return Color3.new(c.R * t.R, c.G * t.G, c.B * t.B)
end

local function part(parent, name)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Locked = true
	p.Material = Enum.Material.Neon
	p.Size = Vector3.one
	p.Transparency = 1
	p.Parent = parent
	return p
end

function NodeRenderer.new(guiParent, displayOrder, worldParent)
	return setmetatable({
		guiParent = guiParent,
		displayOrder = displayOrder or -5,
		worldParent = worldParent,
		visuals = {},
	}, NodeRenderer)
end

function NodeRenderer:clear()
	for _, v in self.visuals do
		v.root:Destroy()
	end

	table.clear(self.visuals)
	if self.gui then
		self.gui:Destroy()
		self.gui = nil
	end

	if self.world then
		self.world:Destroy()
		self.world = nil
	end
end

function NodeRenderer:roots()
	if not self.gui then
		local gui = Instance.new("ScreenGui")
		gui.Name = "EclipseScreenEffects"
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = self.displayOrder
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui:SetAttribute("EclipseOwnedUI", true)
		recovery.mark(gui)
		gui.Parent = self.guiParent
		self.gui = gui
	end

	local parent = self.worldParent or workspace.CurrentCamera
	if not self.world then
		local folder = Instance.new("Folder")
		folder.Name = "EclipseLetterboxEffects"
		recovery.mark(folder)
		self.world = folder
	end

	self.world.Parent = parent
end

function NodeRenderer:create(effect)
	self:roots()
	if effect.kind ~= "Letterbox" then
		local frame = Instance.new("Frame")
		frame.Name = effect.kind
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.Active = false
		frame.Interactable = false
		frame.Parent = self.gui
		local visual = { root = frame, kind = effect.kind, style = effect.style, images = {} }
		if effect.kind == "Vignette" then
			for i = 1, 96 do
				local strip = Instance.new("Frame")
				strip.Name = "Mask" .. i
				strip.BorderSizePixel = 0
				strip.Position = UDim2.fromScale((i - 1) / 96, 0)
				strip.Size = UDim2.fromScale(1 / 96, 1)
				strip.Active = false
				strip.Interactable = false
				local x = (i - 0.5) / 96 * 2 - 1
				local keys = {}
				for j = 0, 19 do
					local y = j / 19 * 2 - 1
					local opacity = math.clamp((math.sqrt(x * x + y * y) - 0.35) / 0.9, 0, 1) ^ 1.7
					table.insert(keys, NumberSequenceKeypoint.new(j / 19, 1 - opacity))
				end

				local gradient = Instance.new("UIGradient")
				gradient.Rotation = 90
				gradient.Transparency = NumberSequence.new(keys)
				gradient.Parent = strip
				strip.Parent = frame
				table.insert(visual.images, strip)
			end
		end

		return visual
	end

	local folder = Instance.new("Folder")
	folder.Name = "Letterbox"
	folder.Parent = self.world
	local visual = {
		root = folder,
		kind = effect.kind,
		style = effect.style,
		beams = {},
		attachments = {},
		flares = {},
	}
	if effect.style == "Solid" then
		visual.top = part(folder, "Top")
		visual.bottom = part(folder, "Bottom")
		return visual
	end

	local asset = assert(model.catalog[effect.style])
	local nodes = {}
	for i, row in asset.nodes do
		nodes[i] = Instance.new(row.class)
		nodes[i].Name = row.name
	end

	for i, row in asset.nodes do
		local object = nodes[i]
		for key, value in row.properties do
			object[key] = decode(value, nodes)
		end

		if object:IsA("BasePart") then
			object.Anchored = true
			object.CanCollide = false
			object.CanTouch = false
			object.CanQuery = false
			object.CastShadow = false
			object.Locked = true
			object.Transparency = 1
			visual.part = object
			visual.originalSize = object.Size
		end

		if object:IsA("Attachment") then
			table.insert(visual.attachments, { object = object, cf = object.CFrame })
		end

		if object:IsA("Beam") then
			table.insert(visual.beams, {
				object = object,
				alpha = object.Transparency,
				color = object.Color,
				width0 = object.Width0,
				width1 = object.Width1,
				curve0 = object.CurveSize0,
				curve1 = object.CurveSize1,
				speed = object.TextureSpeed,
				enabled = object.Enabled,
			})
			object.TextureSpeed = 0
		end

		object.Parent = row.parent and nodes[row.parent] or folder
	end

	for _, object in nodes do
		if object:IsA("ParticleEmitter") then
			object.Enabled = false
			local attachment = object.Parent
			if not attachment:IsA("Attachment") then
				local a = Instance.new("Attachment")
				a.Parent = attachment
				attachment = a
			end

			local gui = Instance.new("BillboardGui")
			gui.Name = "ScrubbableFlare"
			gui.Adornee = attachment
			gui.AlwaysOnTop = false
			gui.LightInfluence = 0
			gui.Parent = attachment
			local image = Instance.new("ImageLabel")
			image.Size = UDim2.fromScale(1, 1)
			image.BackgroundTransparency = 1
			image.Image = object.Texture
			image.Parent = gui
			table.insert(visual.flares, { source = object, gui = gui, image = image })
		end
	end

	return visual
end

function NodeRenderer:update(entries, frame, fps, cameraFor)
	if self.world and not self.world.Parent or self.gui and not self.gui.Parent then
		self:clear()
	end

	local used = {}
	for order, entry in entries do
		local effect, id = entry.value, entry.id
		local alpha = model.alpha(effect, frame)
		local camera = effect.kind == "Letterbox" and cameraFor(effect.cameraId) or nil
		if alpha <= 0 or effect.kind == "Letterbox" and not camera then
			continue
		end

		used[id] = true
		local v = self.visuals[id]
		if v and (v.kind ~= effect.kind or v.style ~= effect.style) then
			v.root:Destroy()
			v = nil
		end

		if not v then
			v = self:create(effect)
			self.visuals[id] = v
		end

		local color = Color3.new(table.unpack(effect.color))
		if effect.kind ~= "Letterbox" then
			v.root.ZIndex = order
			if effect.kind == "Screen Cover" then
				v.root.BackgroundColor3 = color
				v.root.BackgroundTransparency = 1 - alpha
			else
				if v.lastColor ~= color then
					for _, strip in v.images do
						strip.BackgroundColor3 = color
					end

					v.lastColor = color
				end

				if v.lastAlpha ~= alpha then
					for _, strip in v.images do
						strip.BackgroundTransparency = 1 - alpha
					end

					v.lastAlpha = alpha
				end
			end
		else
			local depth = 1.2 + order * 0.002
			local h = 2 * depth * math.tan(math.rad(camera.fov) * 0.5)
			local w = h * camera.aspect
			local cf = camera.cf * CFrame.new(0, 0, -depth)
			if v.top then
				local height = h * effect.height
				for sign, p in { [1] = v.top, [-1] = v.bottom } do
					p.Size = Vector3.new(w * 1.01, height, 0.005)
					p.CFrame = cf * CFrame.new(0, sign * (h - height) * 0.5, 0)
					p.Color = color
					p.Transparency = 1 - alpha
				end
			else
				v.part.CFrame = cf
				local sx, sy = w / v.originalSize.X, h / v.originalSize.Y
				v.part.Size = Vector3.new(w, h, 0.01)
				for _, a in v.attachments do
					local p = a.cf.Position
					a.object.CFrame = CFrame.new(p.X * sx, p.Y * sy, p.Z * sy) * a.cf.Rotation
				end

				for _, b in v.beams do
					local o = b.object
					o.Width0 = b.width0 * sy * effect.scale
					o.Width1 = b.width1 * sy * effect.scale
					o.CurveSize0 = b.curve0 * sy
					o.CurveSize1 = b.curve1 * sy
					o.Enabled = b.enabled
					if b.lastAlpha ~= alpha then
						o.Transparency = sequence(b.alpha, function(x)
							return 1 - (1 - x) * alpha
						end)
						b.lastAlpha = alpha
					end

					if b.lastColor ~= color then
						local keys = {}
						for _, k in b.color.Keypoints do
							table.insert(
								keys,
								ColorSequenceKeypoint.new(k.Time, tint(k.Value, color))
							)
						end

						o.Color = ColorSequence.new(keys)
						b.lastColor = color
					end

					o:SetTextureOffset(((frame - effect.start) / fps * b.speed) % 1)
				end

				local time = (frame - effect.start) / fps
				for _, f in v.flares do
					local e = f.source
					local life = (e.Lifetime.Min + e.Lifetime.Max) * 0.5
					local age = (time * e.TimeScale % math.max(0.001, life)) / math.max(0.001, life)
					local size = math.max(0.001, sample(e.Size, age) * sy * effect.scale)
					local squash = sample(e.Squash, age)
					f.gui.Size = UDim2.fromScale(
						size * math.max(0.05, 1 + squash),
						size / math.max(0.05, 1 + squash)
					)
					f.image.Rotation = (e.Rotation.Min + e.Rotation.Max) * 0.5
						+ (e.RotSpeed.Min + e.RotSpeed.Max) * 0.5 * time
					f.image.ImageColor3 = tint(sample(e.Color, age), color)
					f.image.ImageTransparency = 1 - (1 - sample(e.Transparency, age)) * alpha
				end
			end
		end
	end

	for id, v in self.visuals do
		if not used[id] then
			v.root:Destroy()
			self.visuals[id] = nil
		end
	end

	if not next(used) then
		self:clear()
	elseif self.world then
		self.world.Parent = self.worldParent or workspace.CurrentCamera
	end
end

return NodeRenderer
]]></ProtectedString>
