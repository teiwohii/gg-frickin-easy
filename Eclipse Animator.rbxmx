					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!native
-- riftkuro

local bezier = {}

function bezier.cubic(a, b, c, d, fraction)
	local ab, bc, cd = a + (b - a) * fraction, b + (c - b) * fraction, c + (d - c) * fraction
	local first, second = ab + (bc - ab) * fraction, bc + (cd - bc) * fraction
	return first + (second - first) * fraction
end

function bezier.parameter(position, first, second)
	if position <= 0 then return 0 end
	if position >= 1 then return 1 end
	first, second = math.clamp(first, 0, 1), math.clamp(second, 0, 1)
	if math.abs(first - 1 / 3) + math.abs(second - 2 / 3) < 1e-9 then return position end
	local lower, upper = 0, 1
	local lowerValue, upperValue = -position, 1 - position
	local previousLower
	for _ = 1, 32 do
		local fraction = (lower * upperValue - upper * lowerValue) / (upperValue - lowerValue)
		if fraction <= lower or fraction >= upper then fraction = (lower + upper) / 2 end
		local error = bezier.cubic(0, first, second, 1, fraction) - position
		if math.abs(error) < 1e-9 then return fraction end
		if error < 0 then
			lower, lowerValue = fraction, error
			if previousLower == true then upperValue *= 0.5 end
			previousLower = true
		else
			upper, upperValue = fraction, error
			if previousLower == false then lowerValue *= 0.5 end
			previousLower = false
		end
	end
	return (lower + upper) / 2
end

function bezier.lengths(previousTime, time, nextTime, _mode)
	local before = math.max(0, previousTime and time - previousTime or nextTime and nextTime - time or 1)
	local after = math.max(0, nextTime and nextTime - time or before)
	if _mode == "Automatic" or _mode == "AutoClamped" then
		return math.min(before, 5 * after) / 2.5614, math.min(after, 5 * before) / 2.5614
	end
	return before / 3, after / 3
end

function bezier.handles(previous, value, following, previousTime, time, nextTime, leftLength, rightLength, mode)
	local before = previousTime and time - previousTime or 0
	local after = nextTime and nextTime - time or 0
	local incoming = before > 0 and (value - previous) / before or nil
	local outgoing = after > 0 and (following - value) / after or nil
	if mode == "Vector" then
		return value - (incoming or outgoing or 0) * leftLength, value + (outgoing or incoming or 0) * rightLength
	end
	local slope = 0
	if incoming and outgoing then
		slope = (incoming + outgoing) / 2
		if mode == "AutoClamped" then
			if incoming * outgoing <= 0 then
				slope = 0
			else
				slope = math.sign(slope) * math.min(math.abs(slope), math.abs(value - previous) / math.max(leftLength, 1e-12), math.abs(following - value) / math.max(rightLength, 1e-12))
			end
		end
	end

	return value - slope * leftLength, value + slope * rightLength
end

local function solveTridiagonal(lower, diagonal, upper, values)
	local count = #diagonal
	local factors, result = table.create(count), table.create(count)
	for i = 1, count do
		local pivot = diagonal[i] - (i > 1 and lower[i] * factors[i - 1] or 0)
		factors[i] = upper[i] / pivot
		result[i] = (values[i] - (i > 1 and lower[i] * result[i - 1] or 0)) / pivot
	end
	for i = count - 1, 1, -1 do result[i] -= factors[i] * result[i + 1] end
	return result
end

local function solveSystem(lower, diagonal, upper, values, firstCorner, lastCorner)
	local result = solveTridiagonal(lower, diagonal, upper, values)
	if firstCorner == 0 and lastCorner == 0 then return result end
	local count = #diagonal
	local first, last = table.create(count, 0), table.create(count, 0)
	first[1], last[count] = firstCorner, lastCorner
	first = solveTridiagonal(lower, diagonal, upper, first)
	last = solveTridiagonal(lower, diagonal, upper, last)
	local a, b, c, d = 1 + first[count], last[count], first[1], 1 + last[1]
	local determinant = a * d - b * c
	local x = (result[count] * d - b * result[1]) / determinant
	local y = (a * result[1] - c * result[count]) / determinant
	for i = 1, count do result[i] -= first[i] * x + last[i] * y end
	return result
end

function bezier.smoothSlopes(times, values, limits, firstSlope, lastSlope, period, offset, checkpoint)
	local count = #times
	local lower, diagonal, upper, rhs = {}, {}, {}, {}
	local fixed, active = {}, {}
	local firstCorner, lastCorner = 0, 0
	for i = 1, count do
		if checkpoint and i % 256 == 0 then checkpoint() end
		local previous, following = i - 1, i + 1
		local before = previous >= 1 and times[i] - times[previous] or period and times[i] - (times[count] - period)
		local after = following <= count and times[following] - times[i] or period and times[1] + period - times[i]
		local incoming = before and (values[i] - (previous >= 1 and values[previous] or values[count] - offset)) / before
		local outgoing = after and ((following <= count and values[following] or values[1] + offset) - values[i]) / after
		lower[i], upper[i] = before and 1 / before or 0, after and 1 / after or 0
		diagonal[i] = 2 * (lower[i] + upper[i])
		rhs[i] = 3 * ((incoming or 0) * lower[i] + (outgoing or 0) * upper[i])
		if i == 1 and not period then fixed[i] = type(firstSlope) == "table" and firstSlope.slope or firstSlope end
		if i == count and not period then fixed[i] = type(lastSlope) == "table" and lastSlope.slope or lastSlope end
		local limit = limits[i]
		if limit and limit[1] == limit[2] then fixed[i] = limit[1] end
	end
	if type(firstSlope) == "table" and count > 2 then
		local span = times[2] - times[1]
		local adjustment = (3 * firstSlope.span - span) / (span * span)
		lower[2] += adjustment
		diagonal[2] -= adjustment
	end
	if type(lastSlope) == "table" and count > 2 then
		local span = times[count] - times[count - 1]
		local adjustment = (3 * lastSlope.span - span) / (span * span)
		upper[count - 1] += adjustment
		diagonal[count - 1] -= adjustment
	end
	if period then
		if count == 2 then
			upper[1] += lower[1]
			lower[2] += upper[2]
		else
			firstCorner, lastCorner = lower[1], upper[count]
		end
		lower[1], upper[count] = 0, 0
	end
	local result
	for iteration = 1, count * 4 + 8 do
		if checkpoint then checkpoint() end
		local a, b, c, d = table.clone(lower), table.clone(diagonal), table.clone(upper), table.clone(rhs)
		local top, bottom = firstCorner, lastCorner
		for i = 1, count do
			local value = fixed[i]
			if value == nil then value = active[i] end
			if value ~= nil then
				a[i], b[i], c[i], d[i] = 0, 1, 0, value
				if i == 1 then top = 0 end
				if i == count then bottom = 0 end
			end
		end
		result = solveSystem(a, b, c, d, top, bottom)
		local changed = false
		for i, limit in pairs(limits) do
			if fixed[i] == nil and active[i] == nil then
				local value = math.clamp(result[i], limit[1], limit[2])
				if math.abs(value - result[i]) > 1e-10 then active[i], changed = value, true end
			end
		end
		if not changed then
			local release, worst = nil, 1e-10
			for i, value in pairs(active) do
				local residual = diagonal[i] * value - rhs[i]
					+ (i > 1 and lower[i] * result[i - 1] or firstCorner * result[count])
					+ (i < count and upper[i] * result[i + 1] or lastCorner * result[1])
				local violation = value == limits[i][1] and -residual or residual
				if violation > worst then release, worst = i, violation end
			end
			if not release then return result end
			active[release] = nil
		end
	end
	return result
end

return bezier
]]></ProtectedString>
