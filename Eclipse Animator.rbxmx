							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)
local InstanceFactory = require(script.Parent.Parent.Utility.InstanceFactory)

local ColorPicker = {}
ColorPicker.__index = ColorPicker

ColorPicker.width = 210
ColorPicker.height = 262
ColorPicker.padding = 10
ColorPicker.headerHeight = 26
ColorPicker.areaHeight = 150
ColorPicker.hueHeight = 14
ColorPicker.knobSize = 14
ColorPicker.fieldHeight = 22
ColorPicker.gap = 8
ColorPicker.zIndex = 30

function ColorPicker.new(gui: ScreenGui)
	local self = setmetatable({}, ColorPicker)

	self.gui = gui
	self.factory = InstanceFactory.new()
	self.connections = {}
	self.frame = nil
	self.area = nil
	self.knob = nil
	self.hueBar = nil
	self.hueMarker = nil
	self.preview = nil
	self.hexBox = nil
	self.rgbBox = nil
	self.hue = 0
	self.saturation = 0
	self.value = 1
	self.dragging = nil
	self.headerDrag = nil
	self.changedHandler = nil
	self.owner = nil

	return self
end

function ColorPicker:isOpen(): boolean
	return self.frame ~= nil
end

function ColorPicker:getOwner()
	return self.owner
end

function ColorPicker:getFrame(): GuiObject?
	return self.frame
end

function ColorPicker:create(className: string, properties)
	return self.factory:create(className, properties)
end

function ColorPicker:connect(signal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function ColorPicker:containsPoint(point: Vector2): boolean
	if not self.frame then
		return false
	end

	return self:isInside(self.frame, point)
end

function ColorPicker:isInside(guiObject: GuiObject, point: Vector2): boolean
	local position = guiObject.AbsolutePosition
	local size = guiObject.AbsoluteSize

	return point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y
end

function ColorPicker:getColor(): Color3
	return Color3.fromHSV(self.hue, self.saturation, self.value)
end

function ColorPicker:getPlacement(anchor: GuiObject?): Vector2
	local screen = userInputService:getSurfaceSize(self.gui)
	local x, y = 100, 100

	if anchor then
		local position = anchor.AbsolutePosition
		local size = anchor.AbsoluteSize

		x = position.X + size.X + ColorPicker.gap
		y = position.Y

		if x + ColorPicker.width > screen.X - 8 then
			x = position.X - ColorPicker.width - ColorPicker.gap
		end
	end

	return Vector2.new(math.clamp(x, 8, math.max(8, screen.X - ColorPicker.width - 8)), math.clamp(y, 8, math.max(8, screen.Y - ColorPicker.height - 8)))
end

function ColorPicker:open(options)
	self:close()

	self.owner = options.owner
	self.changedHandler = options.onChanged

	local color = options.color or Color3.new(1, 1, 1)
	local hue, saturation, value = color:ToHSV()

	self.hue = hue
	self.saturation = saturation
	self.value = value

	self:build(self:getPlacement(options.anchor), options.title)
	self:bindInput()
	self:refresh(false)

	if options.decorator then
		options.decorator(self.frame)
	end
end

function ColorPicker:build(position: Vector2, title: string?)
	local colors = configuration.Colors
	local padding = ColorPicker.padding
	local innerWidth = ColorPicker.width - padding * 2

	local frame = self:create("Frame", {
		Name = "ColorPicker",
		BackgroundColor3 = colors.Tertiary,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(position.X, position.Y),
		Size = UDim2.fromOffset(ColorPicker.width, ColorPicker.height),
		ZIndex = ColorPicker.zIndex,
		Active = true,
		Parent = self.gui,
	})

	local header = self:create("Frame", {
		Name = "Header",
		BackgroundColor3 = colors.Dark,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, ColorPicker.headerHeight),
		Active = true,
		Parent = frame,
	})

	self:create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(padding, 0),
		Size = UDim2.new(1, -padding * 2, 1, 0),
		FontFace = configuration.Style.boldFont,
		Text = title or "Color",
		TextColor3 = colors.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = header,
	})

	local top = ColorPicker.headerHeight + padding

	local area = self:create("Frame", {
		Name = "Area",
		BackgroundColor3 = Color3.fromHSV(self.hue, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(padding, top),
		Size = UDim2.fromOffset(innerWidth, ColorPicker.areaHeight),
		Active = true,
		ClipsDescendants = false,
		Parent = frame,
	})

	local saturationLayer = self:create("Frame", {
		Name = "Saturation",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = area,
	})

	self:create("UIGradient", {
		Transparency = NumberSequence.new(0, 1),
		Parent = saturationLayer,
	})

	local valueLayer = self:create("Frame", {
		Name = "Value",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = area,
	})

	self:create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new(1, 0),
		Parent = valueLayer,
	})

	self:addStroke(area, colors.Light)

	local knob = self:create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(ColorPicker.knobSize, ColorPicker.knobSize),
		ZIndex = 3,
		Parent = area,
	})

	self:create("UICorner", {
		CornerRadius = UDim.new(1, 0),
		Parent = knob,
	})

	self:create("UIStroke", {
		Color = Color3.fromRGB(25, 25, 25),
		Thickness = 2,
		Parent = knob,
	})

	top += ColorPicker.areaHeight + padding

	local hueBar = self:create("Frame", {
		Name = "Hue",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(padding, top),
		Size = UDim2.fromOffset(innerWidth, ColorPicker.hueHeight),
		Active = true,
		Parent = frame,
	})

	local keypoints = {}

	for index = 0, 6 do
		local alpha = index / 6
		table.insert(keypoints, ColorSequenceKeypoint.new(alpha, Color3.fromHSV(alpha % 1, 1, 1)))
	end

	self:create("UIGradient", {
		Color = ColorSequence.new(keypoints),
		Parent = hueBar,
	})

	self:addStroke(hueBar, colors.Light)

	local hueMarker = self:create("Frame", {
		Name = "Marker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 4, 1, 6),
		ZIndex = 3,
		Parent = hueBar,
	})

	self:addStroke(hueMarker, colors.Dark)

	top += ColorPicker.hueHeight + padding

	local preview = self:create("Frame", {
		Name = "Preview",
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(padding, top),
		Size = UDim2.fromOffset(ColorPicker.fieldHeight, ColorPicker.fieldHeight),
		Parent = frame,
	})

	self:addStroke(preview, colors.Light)

	local fieldLeft = padding + ColorPicker.fieldHeight + 6
	local hexWidth = 70

	self.hexBox = self:createField(frame, UDim2.fromOffset(fieldLeft, top), UDim2.fromOffset(hexWidth, ColorPicker.fieldHeight))
	self.rgbBox = self:createField(frame, UDim2.fromOffset(fieldLeft + hexWidth + 6, top), UDim2.fromOffset(ColorPicker.width - padding - (fieldLeft + hexWidth + 6), ColorPicker.fieldHeight))

	self.frame = frame
	self.area = area
	self.knob = knob
	self.hueBar = hueBar
	self.hueMarker = hueMarker
	self.preview = preview
	self.header = header
end

function ColorPicker:addStroke(parent: GuiObject, color: Color3)
	self:create("UIStroke", {
		Color = color,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function ColorPicker:createField(parent: GuiObject, position: UDim2, size: UDim2): TextBox
	local colors = configuration.Colors

	local box = self:create("TextBox", {
		Name = "Field",
		BackgroundColor3 = colors.Dark,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Position = position,
		Size = size,
		FontFace = configuration.Style.bodyFont,
		Text = "",
		TextColor3 = colors.Text,
		TextSize = 12,
		Parent = parent,
	})

	self:connect(box.FocusLost, function()
		self:applyText(box.Text)
	end)

	return box
end

function ColorPicker:parseText(text: string): Color3?
	local hex = string.match(text, "^%s*#?(%x%x%x%x%x%x)%s*$")

	if hex then
		local success, color = pcall(Color3.fromHex, hex)
		return if success then color else nil
	end

	local numbers = {}

	for number in string.gmatch(text, "%-?%d+%.?%d*") do
		table.insert(numbers, tonumber(number))
	end

	if #numbers >= 3 then
		return Color3.fromRGB(math.clamp(numbers[1], 0, 255), math.clamp(numbers[2], 0, 255), math.clamp(numbers[3], 0, 255))
	end

	return nil
end

function ColorPicker:applyText(text: string)
	local color = self:parseText(text)

	if color then
		local hue, saturation, value = color:ToHSV()

		if saturation > 0 and value > 0 then
			self.hue = hue
		end

		self.saturation = saturation
		self.value = value
		self:refresh(true)
	else
		self:refresh(false)
	end
end

function ColorPicker:bindInput()
	self:connect(self.area.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.dragging = "area"
			self:updateFromPoint(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)

	self:connect(self.hueBar.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.dragging = "hue"
			self:updateFromPoint(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)

	self:connect(self.header.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.headerDrag = {
				mouse = Vector2.new(input.Position.X, input.Position.Y),
				position = self.frame.Position,
			}
		end
	end)

	self:connect(userInputService.InputChanged, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local point = Vector2.new(input.Position.X, input.Position.Y)

		if self.dragging then
			self:updateFromPoint(point)
		elseif self.headerDrag then
			local delta = point - self.headerDrag.mouse
			local start = self.headerDrag.position
			self.frame.Position = UDim2.new(start.X.Scale, start.X.Offset + delta.X, start.Y.Scale, start.Y.Offset + delta.Y)
		end
	end)

	self:connect(userInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.dragging = nil
			self.headerDrag = nil
		end
	end)
end

function ColorPicker:updateFromPoint(point: Vector2)
	if self.dragging == "area" then
		local position = self.area.AbsolutePosition
		local size = self.area.AbsoluteSize

		self.saturation = math.clamp((point.X - position.X) / math.max(size.X, 1), 0, 1)
		self.value = 1 - math.clamp((point.Y - position.Y) / math.max(size.Y, 1), 0, 1)
	elseif self.dragging == "hue" then
		local position = self.hueBar.AbsolutePosition
		local size = self.hueBar.AbsoluteSize

		self.hue = math.clamp((point.X - position.X) / math.max(size.X, 1), 0, 0.9999)
	else
		return
	end

	self:refresh(true)
end

function ColorPicker:refresh(notify: boolean)
	if not self.frame then
		return
	end

	local color = self:getColor()

	self.area.BackgroundColor3 = Color3.fromHSV(self.hue, 1, 1)
	self.knob.Position = UDim2.fromScale(self.saturation, 1 - self.value)
	self.knob.BackgroundColor3 = color
	self.hueMarker.Position = UDim2.fromScale(self.hue, 0.5)
	self.preview.BackgroundColor3 = color

	if not self.hexBox:IsFocused() then
		self.hexBox.Text = "#" .. string.upper(color:ToHex())
	end

	if not self.rgbBox:IsFocused() then
		self.rgbBox.Text = string.format("%d, %d, %d", math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255))
	end

	if notify and self.changedHandler then
		self.changedHandler(color)
	end
end

function ColorPicker:close()
	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	self.factory:clear()
	self.frame = nil
	self.area = nil
	self.knob = nil
	self.hueBar = nil
	self.hueMarker = nil
	self.preview = nil
	self.hexBox = nil
	self.rgbBox = nil
	self.header = nil
	self.dragging = nil
	self.headerDrag = nil
	self.changedHandler = nil
	self.owner = nil
end

function ColorPicker:destroy()
	self:close()
end

return ColorPicker
]]></ProtectedString>
