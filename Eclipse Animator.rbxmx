					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local orientation = {}

local emissionFrames = {
	[Enum.NormalId.Front] = CFrame.identity,
	[Enum.NormalId.Back] = CFrame.Angles(0, -math.pi, 0),
	[Enum.NormalId.Left] = CFrame.Angles(0, math.pi / 2, 0),
	[Enum.NormalId.Right] = CFrame.Angles(0, -math.pi / 2, 0),
	[Enum.NormalId.Top] = CFrame.Angles(math.pi / 2, 0, 0),
	[Enum.NormalId.Bottom] = CFrame.Angles(-math.pi / 2, 0, 0),
}

function orientation.emissionFrame(direction)
	return emissionFrames[direction] or emissionFrames[Enum.NormalId.Top]
end

function orientation.direction(particle)
	local direction = particle.velocity.Magnitude > 0 and particle.velocity.Unit
		or particle.direction
	return direction
end

function orientation.frame(cf, direction, position)
	local normal = direction.Magnitude > 0 and direction.Unit or cf.UpVector.Unit
	local right = normal:Cross(Vector3.yAxis)
	if right.Magnitude == 0 then
		right = normal:Cross(cf.ZVector)
		if right.Magnitude == 0 then
			right = normal:Cross(cf.UpVector)
		end

		if right.Magnitude == 0 then
			right = normal:Cross(Vector3.xAxis)
		end
	end

	right = right.Unit
	return CFrame.fromMatrix(position, right, right:Cross(normal).Unit, -normal)
end

return orientation
]]></ProtectedString>
						<string name="ScriptGuid">{1F9273E5-C587-44BD-A9B8-815C6C87A0BF}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">orientation</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX52C82CCF6BB7493EB82C298A8B9E8C49">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local names = {}
local opposite = { l = "r", r = "l", L = "R", R = "L" }
local words = { { "left", "right" }, { "right", "left" } }

local function separator(char)
	return char == "" or char:match("[^%w]") ~= nil
end

local function replacement(word, value)
	if word == word:upper() then
		return value:upper()
	elseif word:sub(1, 1):match("%u") then
		return value:sub(1, 1):upper() .. value:sub(2)
	end
	return value
end

function names.flip(name)
	local base, suffix = name:match("^(.*)(%.%d+)$")
	base, suffix = base or name, suffix or ""
	local lower = base:lower()
	for index = #base, 1, -1 do
		local before = base:sub(index - 1, index - 1)
		local char = base:sub(index, index)
		local starts = index == 1 or separator(before)
			or char:match("%u") and before:match("[%l%d]")
		if starts then
			for _, pair in words do
				local last = index + #pair[1] - 1
				local after = base:sub(last + 1, last + 1)
				if lower:sub(index, last) == pair[1]
					and (separator(after) or after:match("[%u%d]") or index == 1) then
					return base:sub(1, index - 1) .. replacement(base:sub(index, last), pair[2])
						.. base:sub(last + 1) .. suffix
				end
			end
		end
	end
	for index = #base, 1, -1 do
		local before = base:sub(index - 1, index - 1)
		local char = base:sub(index, index)
		local after = base:sub(index + 1, index + 1)
		if opposite[char] and (
			(index == 1 or separator(before)) and (separator(after) or after:match("[%u%d]"))
			or char:match("%u") and before:match("%l") and separator(after)
		) then
			return base:sub(1, index - 1) .. opposite[char] .. base:sub(index + 1) .. suffix
		end
	end
	return name
end

return names
]]></ProtectedString>
						<string name="ScriptGuid">{F964BF3E-065A-46B1-BE0F-7DE4CBA02AD1}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">mirrorNames</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX48243E30176448F196E2F4B7D77561B7">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local runService = game:GetService("RunService")
local selectionService = game:GetService("Selection")
local collectionService = game:GetService("CollectionService")
local httpService = game:GetService("HttpService")
local nativeInput = game:GetService("UserInputService")
local state = require("state")
local cameraRig = require("cameraRig")
local history = require("history")
local tool = require("tool")
local theme = require("theme")

local cameraParts = {}

cameraParts.motorName = "AttachPart"
cameraParts.idAttribute = "EclipseAttachPartId"
cameraParts.restAttribute = "EclipseAttachPartRest"
cameraParts.drivenTag = "EclipseAttachPartDriven"
cameraParts.color = Color3.fromRGB(255, 208, 61)

local refs
local cache = setmetatable({}, { __mode = "k" })
local misses = {}
local driven = {}
local epsilon = 1e-4
local lastTime
local wasHeld = false
local releasedAt = -math.huge
local releaseWindow = 0.6

local function rawState()
	return state.Timeline and state.Timeline:GetState()
end

function cameraParts.isTrack(motor)
	return typeof(motor) == "Instance"
		and motor:IsA("Motor6D")
		and motor:GetAttribute("EclipseCameraPartsTrack") == true
end

function cameraParts.motor(rig)
	local root = rig and rig:FindFirstChild("RootPart")
	local motor = root and root:FindFirstChild(cameraParts.motorName)
	return cameraParts.isTrack(motor) and motor or nil
end

function cameraParts.ensureMotor(rig)
	local root = rig and rig:FindFirstChild("RootPart")
	if not root or not root:FindFirstChild("CamPart") or not root:FindFirstChild("FovPart") then
		return
	end

	local legacy = rig:FindFirstChild("EclipseAttachedParts")
	if legacy then
		legacy:Destroy()
	end

	local motor = root:FindFirstChild(cameraParts.motorName)
	if not motor or not motor:IsA("Motor6D") then
		local part = Instance.new("Part")
		part.Name = cameraParts.motorName
		part.Size = Vector3.one * 0.1
		part.Transparency = 1
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Anchored = false
		part.CFrame = root.CFrame
		part.Parent = rig
		motor = Instance.new("Motor6D")
		motor.Name = cameraParts.motorName
		motor.Part0 = root
		motor.Part1 = part
		motor.Parent = root
	end

	motor:SetAttribute("EclipseCameraAttachment", true)
	motor:SetAttribute("EclipseCameraAttachmentTrack", true)
	motor:SetAttribute("EclipseCameraPartsTrack", true)
	motor:SetAttribute("EclipseAnimatorDefaultC0", CFrame.identity)
	return motor
end

function cameraParts.register(rig)
	local motor = cameraParts.ensureMotor(rig)
	local raw = rawState()
	if motor and raw then
		raw.DefaultPose[motor] = raw.DefaultPose[motor] or CFrame.identity
		raw.MotorByPart[motor.Part1] = motor
		raw.ParentingDefaults[motor] = true
	end

	return motor
end

local function worldFrame(object)
	if object:IsA("BasePart") then
		return object.CFrame
	elseif object:IsA("Attachment") then
		return object.WorldCFrame
	elseif object:IsA("Model") then
		return object:GetPivot()
	end

	return nil
end

local function setWorldFrame(object, frame)
	if object:IsA("BasePart") then
		object.CFrame = frame
	elseif object:IsA("Attachment") then
		object.WorldCFrame = frame
	elseif object:IsA("Model") then
		object:PivotTo(frame)
	end
end

local function restFrame(object)
	return if object:IsA("Attachment") then object.CFrame else worldFrame(object)
end

local function applyRest(object, frame)
	if object:IsA("Attachment") then
		object.CFrame = frame
	else
		setWorldFrame(object, frame)
	end
end

function cameraParts.cameraFrame(rig)
	local ok, frame = pcall(cameraRig.viewFrame, rig)
	return if ok and typeof(frame) == "CFrame" then frame else nil
end

function cameraParts.canAttach(object)
	return typeof(object) == "Instance"
		and object:IsDescendantOf(workspace)
		and (object:IsA("BasePart") or object:IsA("Attachment") or object:IsA("Model"))
		and not object:IsA("Terrain")
		and not cameraRig.isRig(object)
		and cameraRig.owner(object) == nil
		and not object:GetAttribute("EclipseCameraProxy")
		and not object:GetAttribute("EclipseNavigationOrigin")
end

local function scenePath(object)
	local steps = {}
	while object and object ~= workspace do
		local parent = object.Parent
		if not parent then
			return nil
		end

		local index = 0
		for _, child in parent:GetChildren() do
			if child.Name == object.Name and child.ClassName == object.ClassName then
				index += 1
			end

			if child == object then
				break
			end
		end

		table.insert(steps, 1, { name = object.Name, class = object.ClassName, index = index })
		object = parent
	end

	return object == workspace and steps or nil
end

local function walk(steps)
	local node = workspace
	for _, step in steps or {} do
		local count, found = 0, nil
		for _, child in node:GetChildren() do
			if child.Name == step.name and child.ClassName == step.class then
				count += 1
				if count == step.index then
					found = child
					break
				end
			end
		end

		if not found then
			return nil
		end

		node = found
	end

	return node
end

function cameraParts.reference(object, camera)
	local id = object:GetAttribute(cameraParts.idAttribute)
	if type(id) ~= "string" then
		id = httpService:GenerateGUID(false)
		object:SetAttribute(cameraParts.idAttribute, id)
	end

	local link = {
		id = id,
		label = object.Name,
		class = object.ClassName,
		scene = scenePath(object),
		offset = camera:ToObjectSpace(worldFrame(object)),
	}
	cache[link] = object
	return link
end

function cameraParts.resolve(link)
	if type(link) ~= "table" or type(link.id) ~= "string" then
		return nil
	end

	local object = cache[link]
	if object and object:IsDescendantOf(workspace) and object:GetAttribute(cameraParts.idAttribute) == link.id then
		return object
	end

	object = walk(link.scene)
	if not (object and object:GetAttribute(cameraParts.idAttribute) == link.id) then
		object = nil
		if (misses[link.id] or 0) < os.clock() then
			for _, candidate in workspace:GetDescendants() do
				if candidate:GetAttribute(cameraParts.idAttribute) == link.id then
					object = candidate
					break
				end
			end

			if not object then
				misses[link.id] = os.clock() + 2
			end
		end
	end

	if object then
		cache[link] = object
	end

	return object
end

function cameraParts.selected()
	local list = {}
	for _, object in selectionService:Get() do
		if cameraParts.canAttach(object) and not table.find(list, object) then
			table.insert(list, object)
		end
	end

	return list
end

function cameraParts.capture(rig, objects)
	local camera = cameraParts.cameraFrame(rig)
	local value = { parts = {} }
	if not camera then
		return value
	end

	for _, object in objects or cameraParts.selected() do
		table.insert(value.parts, cameraParts.reference(object, camera))
	end

	return value
end

function cameraParts.activeKey(rig, time)
	local motor = cameraParts.motor(rig)
	local raw = rawState()
	if not motor or not raw or motor:GetAttribute("EclipseDisabled") then
		return nil
	end

	time = time or raw.CurrentTime
	local bucket = require("layers").metadataBucket(raw, motor, time, "CamAttachTarget")
	local key = require("target").previous(bucket, time)
	if key and key.Time <= time and key.CamAttachTarget ~= nil then
		return key, motor
	end

	return nil, motor
end

local function release(object)
	local entry = driven[object]
	driven[object] = nil
	if not entry then
		return
	end

	if object.Parent then
		pcall(applyRest, object, entry.rest)
	end

	object:SetAttribute(cameraParts.restAttribute, nil)
	collectionService:RemoveTag(object, cameraParts.drivenTag)
end

function cameraParts.releaseAll()
	for object in driven do
		release(object)
	end
end

function cameraParts.recover()
	for _, object in collectionService:GetTagged(cameraParts.drivenTag) do
		if not driven[object] then
			local rest = object:GetAttribute(cameraParts.restAttribute)
			if typeof(rest) == "CFrame" then
				pcall(applyRest, object, rest)
			end

			object:SetAttribute(cameraParts.restAttribute, nil)
			collectionService:RemoveTag(object, cameraParts.drivenTag)
		end
	end
end

local function isSelected(object)
	for _, picked in selectionService:Get() do
		if picked == object or object:IsDescendantOf(picked) or picked:IsDescendantOf(object) then
			return true
		end
	end

	return false
end

local function overEclipseUI()
	local ok, over = pcall(function()
		return require("userInputService").pointerOverUI()
	end)
	return ok and over == true
end

local function axisManipulating()
	local axis = state.Axis
	if not axis then
		return false
	end

	local ok, active = pcall(function()
		return axis:IsBlenderGrabMode() or axis:IsBlenderRotateMode() or axis:IsHoldingAxis()
	end)
	return ok and active == true
end

local wasManipulating = false

local function dragState()
	local held = nativeInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	if wasHeld and not held then
		releasedAt = os.clock()
	end

	if held and not wasHeld then
		wasHeld = not overEclipseUI() and "viewport" or "ui"
	elseif not held then
		wasHeld = false
	end

	local manipulating = axisManipulating() or wasHeld == "viewport"
	local started = manipulating and not wasManipulating
	if wasManipulating and not manipulating then
		releasedAt = os.clock()
	end

	wasManipulating = manipulating
	return manipulating, os.clock() - releasedAt < releaseWindow, started
end

local function userEdit(object, entry, current, dragging, settling)
	if restFrame(object):FuzzyEq(entry.rest, 1e-3) then
		return false
	end

	if dragging then
		return true
	end

	return not settling and isSelected(object)
end

function cameraParts.step()
	local raw = rawState()
	local wanted = {}
	local editing = raw ~= nil and not raw.Playing and raw.CurrentTime == lastTime
	lastTime = raw and raw.CurrentTime
	local dragging, settling, started = dragState()
	if started then
		for _, entry in driven do
			entry.startFrame = entry.applied
			entry.startOffset = entry.link and entry.link.offset
		end
	end

	if raw and not state.LoadingProject and (not refs or refs.Active()) then
		local ok, rigs = pcall(state.getAllRigs)
		for _, rig in ok and rigs or {} do
			if not cameraRig.isRig(rig) then
				continue
			end

			local found, key = pcall(cameraParts.activeKey, rig)
			local value = found and key and key.CamAttachTarget
			if type(value) ~= "table" or type(value.parts) ~= "table" or #value.parts == 0 then
				continue
			end

			local camera = cameraParts.cameraFrame(rig)
			if not camera then
				continue
			end

			for _, link in value.parts do
				local object = cameraParts.resolve(link)
				if object and not wanted[object] and cameraParts.canAttach(object) and typeof(link.offset) == "CFrame" then
					wanted[object] = { camera = camera, link = link }
				end
			end
		end
	end

	for object in driven do
		if not wanted[object] then
			release(object)
		end
	end

	for object, want in wanted do
		local entry = driven[object]
		if not entry then
			local rest = restFrame(object)
			entry = { rest = rest }
			driven[object] = entry
			object:SetAttribute(cameraParts.restAttribute, rest)
			collectionService:AddTag(object, cameraParts.drivenTag)
		end

		local current = worldFrame(object)
		if
			editing
			and entry.applied
			and entry.link == want.link
			and current
			and not current:FuzzyEq(entry.applied, epsilon)
			and userEdit(object, entry, current, dragging, settling)
		then
			want.link.offset = want.camera:ToObjectSpace(current)
			state.currentProjectSaved = false
		elseif
			settling
			and entry.startFrame
			and entry.startOffset
			and entry.link == want.link
			and current
			and current:FuzzyEq(entry.startFrame, 1e-3)
		then
			want.link.offset = entry.startOffset
			entry.startFrame, entry.startOffset = nil, nil
		end

		local frame = want.camera * want.link.offset
		if current and not current:FuzzyEq(frame, epsilon) then
			pcall(setWorldFrame, object, frame)
		end

		entry.applied = worldFrame(object)
		entry.link = want.link
	end
end

local lastError

function cameraParts.safeStep()
	local ok, err = pcall(cameraParts.step)
	if not ok and err ~= lastError then
		lastError = err
		warn("[ATTACHPART] " .. tostring(err))
	end
end

local function keyRig(key)
	return key and cameraRig.owner(key.Motor)
end

function cameraParts.isPartsKey(key)
	return type(key) == "table" and cameraParts.isTrack(key.Motor)
end

local function editKeys(keys, description, change)
	local timeline = state.Timeline
	local raw = rawState()
	if not timeline or not raw or #keys == 0 then
		return false
	end

	local motor = keys[1].Motor
	for _, key in keys do
		if key.Motor ~= motor or not raw.Keyframes[motor] or raw.Keyframes[motor][key.Frame] ~= key then
			return false
		end
	end

	local rig = keyRig(keys[1])
	local before = timeline:_snapshotMotorBucket(motor)
	for _, key in keys do
		change(key, rig)
	end
	local after = timeline:_snapshotMotorBucket(motor)

	local function apply(bucket)
		if motor.Parent then
			timeline:_restoreMotorBucket(motor, bucket)
			state.currentProjectSaved = false
			pcall(function()
				timeline:ApplyPoseAtTime(rig, rawState().CurrentTime)
			end)
		end
	end

	apply(after)
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, description)
	return true
end

local function partsOf(key)
	local value = key.CamAttachTarget
	return type(value) == "table" and type(value.parts) == "table" and value.parts or {}
end

function cameraParts.addSelected(keys)
	local objects = cameraParts.selected()
	assert(#objects > 0, "Select parts, models or attachments first")
	return editKeys(keys, "Attach parts to camera", function(key, rig)
		local value = require("graphCurves").clone(type(key.CamAttachTarget) == "table" and key.CamAttachTarget or { parts = {} })
		value.parts = value.parts or {}
		local fresh = cameraParts.capture(rig, objects)
		for _, link in fresh.parts do
			for index = #value.parts, 1, -1 do
				if value.parts[index].id == link.id then
					table.remove(value.parts, index)
				end
			end

			table.insert(value.parts, link)
		end

		key.CamAttachTarget = value
	end)
end

function cameraParts.remove(keys, id)
	return editKeys(keys, "Detach part from camera", function(key)
		local value = require("graphCurves").clone(type(key.CamAttachTarget) == "table" and key.CamAttachTarget or { parts = {} })
		value.parts = value.parts or {}
		for index = #value.parts, 1, -1 do
			if value.parts[index].id == id then
				table.remove(value.parts, index)
			end
		end

		key.CamAttachTarget = value
	end)
end

local function notify(text)
	pcall(function()
		require("notification").show("ATTACHPART", text)
	end)
end

local KeyPanel = {}
KeyPanel.__index = KeyPanel

function cameraParts.keyPanel(parent, zIndex, selection)
	local self = setmetatable({}, KeyPanel)
	self.selection = selection
	self.zIndex = zIndex
	self.frame = tool.make("Frame", parent, "AttachPartValues", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = zIndex,
		Visible = false,
	})
	self.heading = tool.label(self.frame, "Heading", "Attached at this key", UDim2.fromOffset(8, 4), UDim2.new(1, -16, 0, 18))
	self.list = tool.make("Frame", self.frame, "Parts", {
		Position = UDim2.fromOffset(8, 24),
		Size = UDim2.new(1, -16, 0, 20),
		BackgroundTransparency = 1,
	})
	tool.make("UIListLayout", self.list, "Rows", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })
	self.add = tool.button(self.frame, "AddSelected", "ATTACH SELECTED", UDim2.fromOffset(8, 48), UDim2.new(1, -16, 0, 24), function()
		local keys = self.selection()
		local ok, result = pcall(cameraParts.addSelected, keys)
		if not ok then
			notify((tostring(result):gsub("^.-:%d+: ", "")))
		end

		self:refresh(keys)
	end)
	self.hint = tool.label(self.frame, "Hint", "Keeps their offset to the camera", UDim2.fromOffset(8, 76), UDim2.new(1, -16, 0, 18))
	self.hint.TextTransparency = 0.35
	return self
end

function KeyPanel.accepts(keys)
	if #keys == 0 then
		return false
	end

	for _, key in keys do
		if not cameraParts.isPartsKey(key) then
			return false
		end
	end

	return true
end

function KeyPanel:refresh(keys)
	keys = keys or self.selection()
	for _, child in self.list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local single = #keys == 1
	local parts = single and partsOf(keys[1]) or {}
	local rows = math.max(1, #parts)
	self.heading.Text = single and "Attached at this key" or ("Editing " .. #keys .. " keys")

	if #parts == 0 then
		local empty = tool.label(self.list, "Empty", single and "Nothing attached" or "Adds to every key", UDim2.new(), UDim2.new(1, 0, 0, 20))
		empty.TextTransparency = 0.45
	end

	for index, link in parts do
		local object = cameraParts.resolve(link)
		local row = tool.make("Frame", self.list, "Part", {
			Size = UDim2.new(1, 0, 0, 20),
			BackgroundTransparency = 1,
			LayoutOrder = index,
		})
		local label = tool.label(row, "Label", object and object.Name or ("Missing: " .. tostring(link.label)), UDim2.new(), UDim2.new(1, -24, 1, 0))
		label.TextWrapped = false
		label.TextTruncate = Enum.TextTruncate.AtEnd
		label.TextTransparency = object and 0 or 0.45
		local remove = tool.button(row, "Remove", "X", UDim2.new(1, -20, 0, 1), UDim2.fromOffset(20, 18), function()
			local current = self.selection()
			cameraParts.remove(current, link.id)
			self:refresh(current)
		end)
		remove.ZIndex = self.zIndex + 1
	end

	local listHeight = rows * 20 + (rows - 1) * 2
	self.list.Size = UDim2.new(1, -16, 0, listHeight)
	self.add.Position = UDim2.fromOffset(8, 28 + listHeight)
	self.hint.Position = UDim2.fromOffset(8, 56 + listHeight)

	for _, object in self.frame:GetDescendants() do
		if object:IsA("GuiObject") then
			object.ZIndex = math.max(object.ZIndex, self.zIndex)
		end
	end

	theme.applyTree(self.frame)
	return 80 + listHeight
end

function cameraParts.init(options)
	if refs == options then
		return
	end

	refs = options
	pcall(cameraParts.recover)
	local connection = runService.RenderStepped:Connect(cameraParts.safeStep)

	local function shutdown()
		connection:Disconnect()
		cameraParts.releaseAll()
	end

	options.ScreenGui.Destroying:Once(shutdown)
	options.Plugin.Unloading:Once(shutdown)
end

return cameraParts
]]></ProtectedString>
