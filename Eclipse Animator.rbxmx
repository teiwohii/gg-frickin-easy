						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)

local TextureMarks = {}
TextureMarks.__index = TextureMarks

TextureMarks.version = 1
TextureMarks.maximumRecent = 40
TextureMarks.favouritesChanged = "favourites"
TextureMarks.recentChanged = "recent"

function TextureMarks.new(pluginObject: Plugin?)
	local self = setmetatable({}, TextureMarks)

	self.plugin = pluginObject
	self.favourites = {}
	self.recent = {}
	self.handlers = {}

	self:load()

	return self
end

function TextureMarks:load()
	if not self.plugin then
		return
	end

	local success, stored = pcall(function()
		return self.plugin:GetSetting(configuration.Create.textureKey)
	end)

	if not success or typeof(stored) ~= "table" then
		return
	end

	if typeof(stored.favourites) == "table" then
		for _, key in stored.favourites do
			if typeof(key) == "string" then
				self.favourites[key] = true
			end
		end
	end

	if typeof(stored.recent) == "table" then
		for _, key in stored.recent do
			if typeof(key) == "string" and not table.find(self.recent, key) and #self.recent < TextureMarks.maximumRecent then
				table.insert(self.recent, key)
			end
		end
	end
end

function TextureMarks:persist()
	if not self.plugin then
		return
	end

	local favourites = {}

	for key in self.favourites do
		table.insert(favourites, key)
	end

	table.sort(favourites)

	pcall(function()
		self.plugin:SetSetting(configuration.Create.textureKey, {
			version = TextureMarks.version,
			favourites = favourites,
			recent = self.recent,
		})
	end)
end

function TextureMarks:addChangedHandler(handler: (string) -> ())
	table.insert(self.handlers, handler)
end

function TextureMarks:notify(change: string)
	for _, handler in self.handlers do
		handler(change)
	end
end

function TextureMarks:isFavourite(key: string): boolean
	return self.favourites[key] == true
end

function TextureMarks:getFavourites(): { [string]: boolean }
	return self.favourites
end

function TextureMarks:setFavourite(key: string, favourite: boolean)
	if self:isFavourite(key) == favourite then
		return
	end

	self.favourites[key] = if favourite then true else nil
	self:persist()
	self:notify(TextureMarks.favouritesChanged)
end

function TextureMarks:toggleFavourite(key: string): boolean
	local favourite = not self:isFavourite(key)

	self:setFavourite(key, favourite)

	return favourite
end

function TextureMarks:getRecent(): { string }
	return self.recent
end

function TextureMarks:addRecent(key: string)
	if self.recent[1] == key then
		return
	end

	local existing = table.find(self.recent, key)

	if existing then
		table.remove(self.recent, existing)
	end

	table.insert(self.recent, 1, key)

	while #self.recent > TextureMarks.maximumRecent do
		table.remove(self.recent)
	end

	self:persist()
	self:notify(TextureMarks.recentChanged)
end

function TextureMarks:destroy()
	table.clear(self.handlers)
end

return TextureMarks
]]></ProtectedString>
							<string name="ScriptGuid">{5D52A1B4-D408-4A3F-9136-F1028C4D679A}</string>
