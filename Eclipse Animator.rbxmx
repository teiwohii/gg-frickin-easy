							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = {}
ShapeKit.__index = ShapeKit

ShapeKit.materials = { "Neon", "ForceField", "Glass", "SmoothPlastic", "Plastic", "Metal", "Foil", "Ice", "Marble", "Slate", "Rock", "Wood" }
ShapeKit.minimumSize = 0.02
ShapeKit.defaultColor = Color3.fromRGB(255, 255, 255)

function ShapeKit.join(...): { any }
	local result = {}

	for _, list in { ... } do
		for _, item in list do
			table.insert(result, item)
		end
	end

	return result
end

function ShapeKit.solidParams(defaults)
	defaults = defaults or {}

	return {
		{ name = "Material", kind = "choice", default = defaults.Material or "Neon", options = ShapeKit.materials },
		{ name = "Color", kind = "color", default = defaults.Color or ShapeKit.defaultColor },
		{ name = "Transparency", kind = "number", default = defaults.Transparency or 0, min = 0, max = 1 },
	}
end

function ShapeKit.beamParams(defaults)
	defaults = defaults or {}

	return {
		{ name = "Color", kind = "color", default = defaults.Color or ShapeKit.defaultColor },
		{ name = "Transparency", kind = "number", default = defaults.Transparency or 0, min = 0, max = 1 },
		{ name = "LightEmission", label = "Light Emission", kind = "number", default = 1, min = 0, max = 1 },
		{ name = "Texture", kind = "asset", default = defaults.Texture or "" },
		{ name = "TextureLength", label = "Texture Length", kind = "number", default = defaults.TextureLength or 1, min = 0.05, max = 100 },
		{ name = "TextureSpeed", label = "Texture Speed", kind = "number", default = defaults.TextureSpeed or 0, min = -20, max = 20 },
		{ name = "FaceCamera", label = "Face Camera", kind = "toggle", default = false },
	}
end

function ShapeKit.new(root: Instance, pivot: CFrame, params)
	local self = setmetatable({}, ShapeKit)

	self.root = root
	self.pivot = pivot
	self.params = params
	self.random = Random.new(math.floor(tonumber(params.Seed) or 1))
	self.count = 0

	return self
end

function ShapeKit:jitter(amount: number): number
	if amount <= 0 then
		return 0
	end

	return self.random:NextNumber(-amount, amount)
end

function ShapeKit:randomUnit(): Vector3
	return self.random:NextUnitVector()
end

function ShapeKit:getMaterial(): Enum.Material
	local success, material = pcall(function()
		return (Enum.Material :: any)[self.params.Material]
	end)

	return if success and material then material else Enum.Material.Neon
end

function ShapeKit:clampSize(size: Vector3): Vector3
	local minimum = ShapeKit.minimumSize

	return Vector3.new(math.max(size.X, minimum), math.max(size.Y, minimum), math.max(size.Z, minimum))
end

function ShapeKit:part(name: string, cframe: CFrame, size: Vector3): Part
	local params = self.params
	local part = Instance.new("Part")

	self.count += 1
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = self:getMaterial()
	part.Color = if typeof(params.Color) == "Color3" then params.Color else ShapeKit.defaultColor
	part.Transparency = math.clamp(tonumber(params.Transparency) or 0, 0, 1)
	part.Size = self:clampSize(size)
	part.CFrame = self.pivot * cframe
	part.Parent = self.root

	return part
end

function ShapeKit:attachment(name: string, cframe: CFrame, visible: boolean?): Attachment
	local attachment = Instance.new("Attachment")

	attachment.Name = name
	attachment.CFrame = cframe
	attachment.Visible = visible == true
	attachment.Parent = self.root

	return attachment
end

function ShapeKit:orient(position: Vector3, tangent: Vector3, normal: Vector3): CFrame
	local axis = if tangent.Magnitude > 1e-4 then tangent.Unit else Vector3.xAxis
	local up = normal - axis * normal:Dot(axis)

	if up.Magnitude < 1e-4 then
		up = axis:Cross(Vector3.zAxis)

		if up.Magnitude < 1e-4 then
			up = axis:Cross(Vector3.xAxis)
		end
	end

	return CFrame.fromMatrix(position, axis, up.Unit)
end

function ShapeKit:aim(position: Vector3, direction: Vector3): CFrame
	local unit = if direction.Magnitude > 1e-4 then direction.Unit else Vector3.zAxis
	local up = if math.abs(unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis

	return CFrame.lookAt(position, position + unit, up)
end

function ShapeKit:getBeamProperties()
	local params = self.params
	local color = if typeof(params.Color) == "Color3" then params.Color else ShapeKit.defaultColor

	return {
		Color = ColorSequence.new(color),
		LightEmission = math.clamp(tonumber(params.LightEmission) or 1, 0, 1),
		LightInfluence = 0,
		Texture = if typeof(params.Texture) == "string" then params.Texture else "",
		TextureLength = math.max(tonumber(params.TextureLength) or 1, 0.05),
		TextureSpeed = tonumber(params.TextureSpeed) or 0,
		TextureMode = Enum.TextureMode.Wrap,
		FaceCamera = params.FaceCamera == true,
		Segments = 16,
	}
end

function ShapeKit:path(samples, options)
	options = options or {}

	local count = #samples
	local attachments = {}
	local properties = self:getBeamProperties()
	local baseTransparency = math.clamp(tonumber(self.params.Transparency) or 0, 0, 1)
	local last = if options.closed then count else count - 1

	for index, sample in samples do
		attachments[index] = self:attachment("Point" .. index, self:orient(sample.position, sample.tangent, sample.normal))
	end

	for index = 1, last do
		local nextIndex = if index == count then 1 else index + 1
		local from = samples[index]
		local to = samples[nextIndex]
		local beam = Instance.new("Beam")

		beam.Name = "Beam" .. index

		for name, value in properties do
			(beam :: any)[name] = value
		end

		local fromFade = from.fade or 0
		local toFade = to.fade or 0

		beam.Transparency = NumberSequence.new(
			baseTransparency + (1 - baseTransparency) * fromFade,
			baseTransparency + (1 - baseTransparency) * toFade
		)
		beam.Width0 = math.max(from.width, 0)
		beam.Width1 = math.max(to.width, 0)
		beam.CurveSize0 = from.handle
		beam.CurveSize1 = to.handle
		beam.Attachment0 = attachments[index]
		beam.Attachment1 = attachments[nextIndex]
		beam.Parent = self.root
		self.count += 1
	end

	return attachments
end

return ShapeKit
]]></ProtectedString>
								<string name="ScriptGuid">{2EF651E8-1C72-4E95-AAC4-549313CC7ED7}</string>
