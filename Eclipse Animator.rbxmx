						<ProtectedString name="Source"><![CDATA[--!native
-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local rigTraversal = require("rigTraversal")
local httpService = game:GetService("HttpService")
local matrix = require("m")
local softIk = require("softIk")
local preferences = require("preferences")

local boneIk = {}

local function worldOf(inst)
	if inst:IsA("Bone") then
		return worldOf(inst.Parent) * inst.CFrame * inst.Transform
	end

	return inst.CFrame
end

local function rotationBetween(a, b)
	local dot = math.clamp(a:Dot(b), -1, 1)
	if dot > 0.9999 then
		return CFrame.identity
	end

	if dot < -0.9999 then
		local ortho = math.abs(a.X) < 0.9 and Vector3.xAxis or Vector3.yAxis
		local axis = a:Cross(ortho).Unit
		return CFrame.fromAxisAngle(axis, math.pi)
	end

	return CFrame.fromAxisAngle(a:Cross(b).Unit, math.acos(dot))
end

local descCountCache = setmetatable({}, { __mode = "k" })

local function boneDescendantCount(bone)
	local cached = descCountCache[bone]
	if cached then
		return cached
	end

	local count = 0
	for _, d in ipairs(bone:GetDescendants()) do
		if d:IsA("Bone") and not d:GetAttribute("EclipseArmatureSkinningHelper") then
			count += 1
		end
	end

	descCountCache[bone] = count
	return count
end

local function selectChain(effector)
	local eps = 0.02
	local endPos = worldOf(effector).Position
	local knee = effector.Parent
	while knee and knee:IsA("Bone") and (worldOf(knee).Position - endPos).Magnitude <= eps do
		knee = knee.Parent
	end

	if not (knee and knee:IsA("Bone")) then
		return nil, nil
	end

	if boneDescendantCount(knee) > 60 then
		return nil, nil
	end

	local hip = knee.Parent
	while
		hip
		and hip:IsA("Bone")
		and (worldOf(hip).Position - worldOf(knee).Position).Magnitude <= eps
	do
		hip = hip.Parent
	end

	if hip and hip:IsA("Bone") then
		if boneDescendantCount(hip) > 4 * boneDescendantCount(knee) + 4 then
			hip = nil
		end
	else
		hip = nil
	end

	return knee, hip
end

local function setWorldCFrame(bone, desired)
	local parent = bone.Parent
	if not parent then
		return
	end

	bone.Transform = (worldOf(parent) * bone.CFrame):Inverse() * desired
end

local function worldUnder(rootWorld, root, targetBone)
	local chainBones = {}
	local b = targetBone
	while b and b ~= root do
		table.insert(chainBones, 1, b)
		b = b.Parent
	end

	local w = rootWorld
	for _, bn in ipairs(chainBones) do
		w = w * bn.CFrame * bn.Transform
	end

	return w
end

local function fitJoints(chain, goals, parents, iterations, weights, stretches, pole, poleAngle)
	local count = #chain
	if count == 0 then
		return {}
	end
	local localRest, initial, turns, starts, lengths = {}, {}, {}, {}, {}
	local heads, rotations, tips, affected = {}, {}, {}, {}
	local root = chain[1].head
	local reach = 0
	for index, segment in ipairs(chain) do
		local parent = parents[index]
		local parentRotation = parent > 0 and chain[parent].rot or CFrame.identity
		local parentTip = parent > 0 and (chain[parent].head + parentRotation.UpVector * chain[parent].length) or root
		localRest[index] = segment.solverRestBasis or parentRotation:Inverse() * segment.rot
		initial[index] = segment.solverBasis or CFrame.identity
		turns[index] = CFrame.identity
		starts[index] = segment.solverStart or parentRotation:VectorToObjectSpace(segment.head - parentTip)
		lengths[index] = segment.length
		reach += segment.length + starts[index].Magnitude
		affected[index] = {}
	end
	for goalIndex, goal in ipairs(goals) do
		local index = goal.index
		while index > 0 do
			table.insert(affected[index], goalIndex)
			index = parents[index]
		end
	end
	local function update()
		for index = 1, count do
			local parent = parents[index]
			local orientation = parent > 0 and rotations[parent] or CFrame.identity
			local parentScale = parent > 0 and chain[parent].length > 0 and lengths[parent] / chain[parent].length or 1
			heads[index] = (parent > 0 and tips[parent] or root) + orientation * starts[index] * parentScale
			rotations[index] = orientation * localRest[index] * initial[index] * turns[index]
			tips[index] = heads[index] + rotations[index].UpVector * lengths[index]
		end
	end
	local function cost()
		local sum = 0
		for _, goal in ipairs(goals) do
			local difference = tips[goal.index] - goal.position
			sum += difference:Dot(difference)
		end
		return sum
	end
	local function mobility(index, axis)
		local hinge = chain[index].solverHinge
		if hinge and hinge ~= axis then
			return 0
		end
		return math.clamp(weights and weights[3 * (index - 1) + axis] or 1, 0, 1)
	end
	update()
	local bestError, bestTurns, bestLengths = cost(), table.clone(turns), table.clone(lengths)
	local tolerance = math.max(reach * 1e-5, 1e-6) ^ 2
	if bestError > tolerance and count > 1 then
		for _, axis in { 1, 3, 2 } do
			if mobility(2, axis) > 0 then
				turns[2] = CFrame.fromAxisAngle(matrix.axes[axis], 0.06 * mobility(2, axis))
				turns[1] = CFrame.fromAxisAngle(matrix.axes[axis], -0.06 * mobility(1, axis) * mobility(2, axis) * (reach - chain[1].length) / math.max(reach, 1e-7))
				break
			end
		end
	end
	update()
	for pass = 1, math.clamp(math.floor(iterations or 160), 1, 1000) do
		local before = cost()
		if before <= tolerance then
			break
		end
		for index = count, 1, -1 do
			for axis = 1, 3 do
				local freedom = mobility(index, axis)
				if freedom > 0 and #affected[index] > 0 then
					local rotation = rotations[index]
					local angle
					if matrix.isRigidCFrame(rotation) then
						local direction = rotation:VectorToWorldSpace(matrix.axes[axis])
						local sine, cosine = 0, 0
						for _, goalIndex in ipairs(affected[index]) do
							local goal = goals[goalIndex]
							local from = tips[goal.index] - heads[index]
							local to = goal.position - heads[index]
							from -= direction * from:Dot(direction)
							to -= direction * to:Dot(direction)
							sine += direction:Dot(from:Cross(to))
							cosine += from:Dot(to)
						end
						angle = math.abs(sine) + math.abs(cosine) > 1e-15 and math.clamp(math.atan2(sine, cosine), -0.6, 0.6) or 0
					else
						local inverse = matrix.inverse(matrix.fromCFrame(rotation))
						local direction = matrix.axes[axis]
						local aa, bb, ab, ac, bc = 0, 0, 0, 0, 0
						for _, goalIndex in ipairs(affected[index]) do
							local goal = goals[goalIndex]
							local offset = matrix.vector(inverse, tips[goal.index] - heads[index])
							local fixed = direction * offset:Dot(direction)
							local a = rotation * (offset - fixed)
							local b = rotation * direction:Cross(offset)
							local c = heads[index] + rotation * fixed - goal.position
							aa += a:Dot(a); bb += b:Dot(b); ab += a:Dot(b); ac += a:Dot(c); bc += b:Dot(c)
						end
						local function errorAt(value)
							local c, s = math.cos(value), math.sin(value)
							return aa * c * c + bb * s * s + 2 * (ab * c * s + ac * c + bc * s)
						end
						local lower, upper = -0.6, 0.6
						for _ = 1, 24 do
							local left, right = lower + (upper - lower) / 3, upper - (upper - lower) / 3
							if errorAt(left) < errorAt(right) then upper = right else lower = left end
						end
						angle = (lower + upper) / 2
						if errorAt(angle) >= errorAt(0) then angle = 0 end
					end
					if math.abs(angle) > 1e-10 then
						turns[index] = (turns[index] * CFrame.fromAxisAngle(matrix.axes[axis], angle * freedom)):Orthonormalize()
						update()
					end
				end
			end
			local stretch = stretches and stretches[index] or 0
			if stretch > 0 and #affected[index] > 0 then
				local correction = 0
				for _, goalIndex in ipairs(affected[index]) do
					local goal = goals[goalIndex]
					correction += (goal.position - tips[goal.index]):Dot(rotations[index].UpVector)
				end
				lengths[index] = math.max(chain[index].minStretchLength or 0.001,
					lengths[index] + correction * math.clamp(stretch, 0, 1) / #affected[index])
				update()
			end
		end
		local error = cost()
		if error < bestError then
			bestError, bestTurns, bestLengths = error, table.clone(turns), table.clone(lengths)
		end
		if math.abs(before - error) <= tolerance * 0.001 then
			break
		end
	end
	turns, lengths = bestTurns, bestLengths
	update()
	if pole and count > 1 and mobility(1, 1) > 0 and mobility(1, 2) > 0 and mobility(1, 3) > 0 then
		local line = tips[count] - root
		if line.Magnitude > 1e-7 then
			local axis = line.Unit
			local bend = heads[math.max(2, math.ceil(count / 2))] - root
			local target = pole - root
			bend -= axis * bend:Dot(axis)
			target -= axis * target:Dot(axis)
			if bend.Magnitude > 1e-7 and target.Magnitude > 1e-7 then
				local angle = math.atan2(axis:Dot(bend:Cross(target)), bend:Dot(target)) + (poleAngle or 0)
				local worldTurn = CFrame.fromAxisAngle(axis, angle)
				local base = localRest[1] * initial[1]
				if matrix.isRigidCFrame(base) then
					turns[1] = base:Inverse() * worldTurn * base * turns[1]
				else
					local raw = matrix.fromCFrame(base)
					local change = matrix.mul(matrix.mul(matrix.inverse(raw), matrix.fromCFrame(worldTurn)), raw)
					turns[1] = CFrame.new(0, 0, 0, change[1], change[2], change[3], change[5], change[6], change[7], change[9], change[10], change[11]) * turns[1]
				end
			end
		end
	end
	return turns, lengths
end

local function solveChain(chain, goal, pole, angle, iterations, weights, influence, stretches, softness)
	if #chain == 0 then
		return {}
	end
	local parents, length = {}, 0
	for index, segment in ipairs(chain) do
		parents[index] = index - 1
		length += segment.length
		if index > 1 then
			length += (segment.head - chain[index - 1].head - chain[index - 1].rot.UpVector * chain[index - 1].length).Magnitude
		end
	end
	local amount = math.clamp(influence or 1, 0, 1)
	local percent = softIk.percent(softness == nil and preferences.get("SoftIKPercent") or softness)
	if percent < 100 then goal = softIk.goal(chain[1].head, goal, length, percent) end
	local last = chain[#chain]
	local targetBlend = chain[1].solverBasis ~= nil and not pole
	if targetBlend then
		goal = (last.head + last.rot.UpVector * last.length):Lerp(goal, amount)
	end
	local turns, lengths = fitJoints(chain, { { index = #chain, position = goal } }, parents, iterations, weights, stretches, pole, angle)
	local result, orientation, tail = {}, CFrame.identity, chain[1].head
	local accumulatedScale, previousScale = 1, 1
	for index, segment in ipairs(chain) do
		local previous = chain[index - 1]
		local oldParent = previous and previous.rot or CFrame.identity
		local oldTip = previous and previous.head + previous.rot.UpVector * previous.length or segment.head
		local rest = segment.solverRestBasis or oldParent:Inverse() * segment.rot
		local start = segment.solverStart or oldParent:VectorToObjectSpace(segment.head - oldTip)
		local blend = targetBlend and 1 or amount
		local delta = blend >= 1 and turns[index] or CFrame.identity:Lerp(turns[index], blend)
		local head = tail + orientation * start * accumulatedScale
		orientation = orientation * rest * (segment.solverBasis or CFrame.identity) * delta
		local rawScale = segment.length > 0 and lengths[index] / segment.length or 1
		accumulatedScale *= 1 + (rawScale / previousScale - 1) * blend
		previousScale = rawScale
		local size = segment.length * accumulatedScale
		tail = head + orientation.UpVector * size
		result[index] = { head = head, rot = orientation, tail = tail, delta = delta,
			deltaMatrix = segment.solverBasis and matrix.fromCFrame(delta),
			stretch = segment.length > 0 and lengths[index] / segment.length or 1,
			resultInfluence = blend, length = size }
	end
	return result
end

local function solveTree(chain, goals, iterations, weights)
	if #chain == 0 then
		return {}
	end
	local parents = {}
	for index, segment in ipairs(chain) do
		parents[index] = segment.solverParent or 0
	end
	local turns = fitJoints(chain, goals, parents, iterations, weights)
	local result = {}
	for index, delta in ipairs(turns) do
		result[index] = { delta = delta, deltaMatrix = matrix.fromCFrame(delta), stretch = 1, resultInfluence = 1 }
	end
	return result
end

local function worldOfClean(inst, dirty)
	if inst:IsA("Bone") then
		local w = worldOfClean(inst.Parent, dirty) * inst.CFrame
		if dirty[inst] then
			return w
		end

		return w * inst.Transform
	end

	return inst.CFrame
end

local function boneDepth(inst)
	local d = 0
	local cur = inst.Parent
	while cur and cur:IsA("Bone") do
		d += 1
		cur = cur.Parent
	end

	return d
end

function boneIk.solveChainBones(effector, chainBones, followerSets, opts)
	local n = #chainBones
	if n == 0 then
		return false
	end

	local dirty = { [effector] = true }
	for _, b in ipairs(chainBones) do
		dirty[b] = true
	end

	local followerList = {}
	local followerSeg = {}
	if followerSets then
		for i, set in ipairs(followerSets) do
			for _, fb in ipairs(set) do
				if not dirty[fb] then
					dirty[fb] = true
					followerSeg[fb] = i
					table.insert(followerList, fb)
				end
			end
		end
	end

	local pre = table.create(n)
	for i, b in ipairs(chainBones) do
		pre[i] = worldOfClean(b, dirty)
	end

	local tipPre = worldOfClean(effector, dirty).Position
	local chain = table.create(n)
	for i = 1, n do
		local headPos = pre[i].Position
		local nextPos = i < n and pre[i + 1].Position or tipPre
		local len = (nextPos - headPos).Magnitude
		if len < 1e-5 then
			return false
		end

		chain[i] = { head = headPos, rot = pre[i].Rotation, length = len }
	end

	local fPre = {}
	for _, fb in ipairs(followerList) do
		fPre[fb] = worldOfClean(fb, dirty)
	end

	local res = solveChain(
		chain,
		opts.goal,
		opts.pole,
		opts.poleAngle or 0,
		opts.iterations,
		opts.weights,
		opts.influence,
		nil,
		opts.softPercent
	)
	for i, b in ipairs(chainBones) do
		local desired = CFrame.new(res[i].head) * res[i].rot
		b.Transform = (worldOf(b.Parent) * b.CFrame):Inverse() * desired
	end

	table.sort(followerList, function(x, y)
		return boneDepth(x) < boneDepth(y)
	end)
	for _, fb in ipairs(followerList) do
		local i = followerSeg[fb]
		local desired = (CFrame.new(res[i].head) * res[i].rot) * pre[i]:Inverse() * fPre[fb]
		fb.Transform = (worldOf(fb.Parent) * fb.CFrame):Inverse() * desired
	end

	local tipPos = res[n].tail
	local effAttach = worldOf(effector.Parent) * effector.CFrame
	local endRot = typeof(opts.endCF) == "CFrame" and opts.endCF.Rotation or effAttach.Rotation
	effector.Transform = effAttach:Inverse() * (CFrame.new(tipPos) * endRot)
	return true
end

function boneIk.aimEffector(effector, targetPos, rotationDelta)
	local parentWorld = worldOf(effector.Parent)
	local rest = parentWorld * effector.CFrame
	local want = targetPos - rest.Position
	if want.Magnitude < 1e-4 and not rotationDelta then
		return false
	end

	local rValue = want.Magnitude >= 1e-4 and rotationBetween(rest.UpVector, want.Unit)
		or CFrame.identity
	if rotationDelta then
		rValue = rotationDelta * rValue
	end

	effector.Transform = rest:Inverse() * (CFrame.new(rest.Position) * (rValue * rest.Rotation))
	return true
end

function boneIk.solve(effector, targetPos, polePos, endCf, fullPin)
	local knee, hip = selectChain(effector)
	if not knee then
		return false
	end

	local chainBones = hip and { hip, knee } or { knee }
	local goal = (fullPin and typeof(endCf) == "CFrame") and endCf.Position or targetPos
	return boneIk.solveChainBones(effector, chainBones, nil, {
		goal = goal,
		pole = polePos,
		endCF = endCf,
	})
end

function boneIk.chain(effector)
	local out = { effector }
	local knee, hip = selectChain(effector)
	if knee then
		table.insert(out, knee)
	end

	if hip then
		table.insert(out, hip)
	end

	return out
end

local boneLookupCache = setmetatable({}, { __mode = "k" })

local function findBone(rig, name)
	local map = boneLookupCache[rig]
	if not map then
		map = {}
		boneLookupCache[rig] = map
	end

	local cached = map[name]
	if cached and cached.Parent and cached.Name == name then
		return cached
	end

	for _, d in ipairs(rigTraversal.rigDescendants(rig)) do
		if
			d:IsA("Bone")
			and not d:GetAttribute("EclipseArmatureSkinningHelper")
			and d.Name == name
		then
			map[name] = d
			return d
		end
	end

	map[name] = nil
	return nil
end

local function restAttach(bone)
	return worldOf(bone.Parent) * bone.CFrame
end

function boneIk.solveAbsolute(effector, knee, hip, targetPos, polePos, endCf, fullPin)
	local chainBones = hip and { hip, knee } or { knee }
	local goal = (fullPin and typeof(endCf) == "CFrame") and endCf.Position or targetPos
	return boneIk.solveChainBones(effector, chainBones, nil, {
		goal = goal,
		pole = polePos,
		endCF = endCf,
	})
end

local effCache = setmetatable({}, { __mode = "k" })

local function ikPoint(part)
	local size = part.Size
	local stored = part:GetAttribute("EclipseIKPoint")
	if typeof(stored) ~= "Vector3" then
		stored = part.PivotOffset.Position / size
		part:SetAttribute("EclipseIKPoint", stored)
	end

	return part.CFrame:PointToWorldSpace(stored * size)
end

function boneIk.prepareAnchor(anchor, rig)
	if not anchor or not rig then
		return nil
	end

	local name = anchor:GetAttribute("EclipseIKEffector")
	if typeof(name) ~= "string" then
		return nil
	end

	local effector = effCache[anchor]
	if not (effector and effector.Parent and effector.Name == name) then
		effector = findBone(rig, name)
		effCache[anchor] = effector
	end

	if not effector then
		return nil
	end

	if
		typeof(anchor:GetAttribute("EclipseIKEndOffset")) ~= "CFrame"
		and typeof(anchor:GetAttribute("EclipseIKEndRot")) ~= "CFrame"
	then
		anchor:SetAttribute(
			"EclipseIKEndRot",
			anchor.CFrame.Rotation:Inverse() * worldOf(effector).Rotation
		)
	end

	if
		anchor:GetAttribute("EclipseIKChainCount") == 1
		and typeof(anchor:GetAttribute("EclipseIKChainBones")) ~= "string"
		and typeof(anchor:GetAttribute("EclipseIKAimParentRotation")) ~= "CFrame"
	then
		anchor:SetAttribute(
			"EclipseIKAimParentRotation",
			worldOf(effector.Parent).Rotation:Inverse() * anchor.CFrame.Rotation
		)
	end

	return effector
end

function boneIk.solveForAnchor(anchor, rig)
	local effName = anchor:GetAttribute("EclipseIKEffector")
	if typeof(effName) ~= "string" or not rig then
		return false
	end

	local effector = effCache[anchor]
	if not (effector and effector.Parent and effector.Name == effName) then
		effector = nil
		for _, d in ipairs(rigTraversal.rigDescendants(rig)) do
			if
				d:IsA("Bone")
				and not d:GetAttribute("EclipseArmatureSkinningHelper")
				and d.Name == effName
			then
				effector = d
				break
			end
		end

		effCache[anchor] = effector
	end

	if not effector then
		return false
	end

	boneIk.prepareAnchor(anchor, rig)
	local target = ikPoint(anchor)
	local chainCount = anchor:GetAttribute("EclipseIKChainCount")
	local chainNamesAttr = anchor:GetAttribute("EclipseIKChainBones")
	if chainCount == 1 and typeof(chainNamesAttr) ~= "string" then
		local reference = anchor:GetAttribute("EclipseIKAimParentRotation")
		local delta = anchor.CFrame.Rotation
			* (worldOf(effector.Parent).Rotation * reference):Inverse()
		delta = delta:Orthonormalize()
		local _, angle = delta:ToAxisAngle()
		return boneIk.aimEffector(effector, target, math.abs(angle) > 1e-6 and delta or nil)
	end

	local polePos = nil
	local poleName = anchor:GetAttribute("EclipseIKPole")
	if typeof(poleName) == "string" and anchor.Parent then
		local poleAnchor = anchor.Parent:FindFirstChild(poleName)
		if poleAnchor and poleAnchor:IsA("BasePart") then
			polePos = ikPoint(poleAnchor)
		end
	end

	local endCf = nil
	local fullPin = false
	local endOff = anchor:GetAttribute("EclipseIKEndOffset")
	if typeof(endOff) == "CFrame" then
		endCf = anchor.CFrame * endOff
		fullPin = true
	else
		local endRotOff = anchor:GetAttribute("EclipseIKEndRot")
		if typeof(endRotOff) == "CFrame" then
			endCf = anchor.CFrame.Rotation * endRotOff.Rotation
		end
	end

	local goal
	local goalOff = anchor:GetAttribute("EclipseIKGoalOffset")
	if typeof(goalOff) == "Vector3" then
		goal = anchor.CFrame:PointToWorldSpace(goalOff)
	elseif fullPin then
		goal = endCf.Position
	else
		goal = target
	end

	local chainBones = nil
	if typeof(chainNamesAttr) == "string" then
		chainBones = {}
		for _, nm in ipairs(string.split(chainNamesAttr, ",")) do
			local cb = findBone(rig, nm)
			if not cb then
				chainBones = nil
				break
			end

			table.insert(chainBones, cb)
		end
	end

	if not chainBones then
		local kneeName = anchor:GetAttribute("EclipseIKChainKnee")
		local knee = typeof(kneeName) == "string" and findBone(rig, kneeName) or nil
		if knee then
			local hipName = anchor:GetAttribute("EclipseIKChainHip")
			local hip = typeof(hipName) == "string" and findBone(rig, hipName) or nil
			chainBones = hip and { hip, knee } or { knee }
		else
			local sKnee, sHip = selectChain(effector)
			if not sKnee then
				return false
			end

			chainBones = sHip and { sHip, sKnee } or { sKnee }
		end
	end

	local followerSets = nil
	local folAttr = anchor:GetAttribute("EclipseIKFollowers")
	if typeof(folAttr) == "string" then
		local okF, decoded = pcall(httpService.JSONDecode, httpService, folAttr)
		if okF and typeof(decoded) == "table" then
			followerSets = {}
			for i = 1, #chainBones do
				local set = {}
				local src = decoded[i]
				if typeof(src) == "table" then
					for _, nm in ipairs(src) do
						local fb = findBone(rig, nm)
						if fb then
							table.insert(set, fb)
						end
					end
				end

				followerSets[i] = set
			end
		end
	end

	local weights = nil
	local stAttr = anchor:GetAttribute("EclipseIKStiffness")
	if typeof(stAttr) == "string" then
		local okS, st = pcall(httpService.JSONDecode, httpService, stAttr)
		if okS and typeof(st) == "table" then
			weights = {}
			for i = 1, #chainBones do
				local bs = st[i]
				for d = 1, 3 do
					local sv = typeof(bs) == "table" and tonumber(bs[d]) or 0
					if not sv or sv ~= sv or sv < 0 then
						sv = 0
					end

					if sv > 0.99 then
						sv = 0.99
					end

					weights[3 * (i - 1) + d] = 1 - sv
				end
			end
		end
	end

	local lockAttr = anchor:GetAttribute("EclipseIKLocks")
	if typeof(lockAttr) == "string" then
		local okL, locks = pcall(httpService.JSONDecode, httpService, lockAttr)
		if okL and typeof(locks) == "table" then
			if not weights then
				weights = table.create(3 * #chainBones, 1)
			end

			for i = 1, #chainBones do
				local bl = locks[i]
				if typeof(bl) == "table" then
					for d = 1, 3 do
						if bl[d] == true then
							weights[3 * (i - 1) + d] = 0
						end
					end
				end
			end
		end
	end

	return boneIk.solveChainBones(effector, chainBones, followerSets, {
		goal = goal,
		pole = polePos,
		poleAngle = tonumber(anchor:GetAttribute("EclipseIKPoleAngle")) or 0,
		iterations = tonumber(anchor:GetAttribute("EclipseIKIterations")) or 500,
		influence = tonumber(anchor:GetAttribute("EclipseIKInfluence")) or 1,
		weights = weights,
		endCF = endCf,
	})
end

local armCache = setmetatable({}, { __mode = "k" })

local function getRigEntry(rig)
	local entry = armCache[rig]
	if entry and entry.arm == false and os.clock() - entry.at < 2 then
		return nil
	end

	if not (entry and entry.arm and entry.arm.Parent) then
		entry = nil
		for _, d in ipairs(rigTraversal.rigDescendants(rig)) do
			if d:IsA("Model") and d:GetAttribute("EclipseArmature") then
				local list = {}
				for _, anchor in ipairs(d:GetChildren()) do
					if anchor:IsA("BasePart") and anchor:GetAttribute("EclipseIKEffector") then
						table.insert(list, anchor)
					end
				end

				entry = { arm = d, anchors = list }
				break
			end
		end

		armCache[rig] = entry or { arm = false, at = os.clock() }
	end

	return entry
end

function boneIk.solveAllForRig(rig)
	local entry = getRigEntry(rig)
	if not entry then
		return
	end

	for _, anchor in ipairs(entry.anchors) do
		if anchor.Parent then
			boneIk.solveForAnchor(anchor, rig)
		end
	end
end

function boneIk.gatherChainBones(rig)
	local out = {}
	local entry = getRigEntry(rig)
	if not entry then
		return out
	end

	local seen = {}
	for _, anchor in ipairs(entry.anchors) do
		if anchor.Parent then
			local effName = anchor:GetAttribute("EclipseIKEffector")
			if typeof(effName) == "string" then
				local effector = effCache[anchor]
				if not (effector and effector.Parent and effector.Name == effName) then
					effector = nil
					for _, d in ipairs(rigTraversal.rigDescendants(rig)) do
						if
							d:IsA("Bone")
							and not d:GetAttribute("EclipseArmatureSkinningHelper")
							and d.Name == effName
						then
							effector = d
							break
						end
					end

					effCache[anchor] = effector
				end

				if effector then
					if not seen[effector] then
						seen[effector] = true
						table.insert(out, effector)
					end

					local names = {}
					local chainNamesAttr = anchor:GetAttribute("EclipseIKChainBones")
					if typeof(chainNamesAttr) == "string" then
						for _, nm in ipairs(string.split(chainNamesAttr, ",")) do
							table.insert(names, nm)
						end
					end

					local folAttr = anchor:GetAttribute("EclipseIKFollowers")
					if typeof(folAttr) == "string" then
						local okF, decoded = pcall(httpService.JSONDecode, httpService, folAttr)
						if okF and typeof(decoded) == "table" then
							for _, set in ipairs(decoded) do
								if typeof(set) == "table" then
									for _, nm in ipairs(set) do
										table.insert(names, nm)
									end
								end
							end
						end
					end

					local kneeName = anchor:GetAttribute("EclipseIKChainKnee")
					if typeof(kneeName) == "string" then
						table.insert(names, kneeName)
					end

					local hipName = anchor:GetAttribute("EclipseIKChainHip")
					if typeof(hipName) == "string" then
						table.insert(names, hipName)
					end

					for _, cname in ipairs(names) do
						local cb = findBone(rig, cname)
						if cb and not seen[cb] then
							seen[cb] = true
							table.insert(out, cb)
						end
					end

					for _, b in ipairs(boneIk.chain(effector)) do
						if not seen[b] then
							seen[b] = true
							table.insert(out, b)
						end
					end
				end
			end
		end
	end

	for _, b in ipairs(boneIk.gatherSyncBones(rig)) do
		if not seen[b] then
			seen[b] = true
			table.insert(out, b)
		end
	end

	return out
end

function boneIk.syncDeform(rig)
	local entry = getRigEntry(rig)
	if not entry then
		return
	end

	if entry.arm:GetAttribute("EclipseHasDeformData") ~= true then
		return
	end

	local pairsList = entry.syncPairs
	if not pairsList then
		pairsList = {}
		for _, anchor in ipairs(entry.arm:GetChildren()) do
			if anchor:IsA("BasePart") then
				local fromName = anchor:GetAttribute("EclipseSyncFrom")
				local offset = anchor:GetAttribute("EclipseSyncOffset")
				if typeof(fromName) == "string" and typeof(offset) == "CFrame" then
					table.insert(
						pairsList,
						{ deform = anchor.Name, ctrl = fromName, offset = offset }
					)
				end
			end
		end

		entry.syncPairs = pairsList
	end

	for _, pair in ipairs(pairsList) do
		local deformBone = findBone(rig, pair.deform)
		local ctrlBone = findBone(rig, pair.ctrl)
		if deformBone and ctrlBone then
			local desired = worldOf(ctrlBone) * pair.offset
			local deformRest = worldOf(deformBone.Parent) * deformBone.CFrame
			deformBone.Transform = deformRest:Inverse() * desired
		end
	end
end

function boneIk.gatherSyncBones(rig)
	local out = {}
	local entry = getRigEntry(rig)
	if not entry then
		return out
	end

	if entry.arm:GetAttribute("EclipseHasDeformData") ~= true then
		return out
	end

	for _, anchor in ipairs(entry.arm:GetChildren()) do
		if
			anchor:IsA("BasePart")
			and typeof(anchor:GetAttribute("EclipseSyncFrom")) == "string"
		then
			local b = findBone(rig, anchor.Name)
			if b then
				table.insert(out, b)
			end
		end
	end

	return out
end

function boneIk.invalidateCache(rig)
	armCache[rig] = nil
end

boneIk.worldOf = worldOf
boneIk.solveRigidChain = solveChain
boneIk.solveRigidTree = solveTree
return boneIk
