							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Parent.Utility.configuration)
local Tool = require(script.Parent.Tool)

local ClipboardTool = Tool.extend()

ClipboardTool.id = "Clipboard"
ClipboardTool.title = "Copy Properties"
ClipboardTool.keywords = "copy paste properties clipboard transfer sequence"
ClipboardTool.modes = { "Everything", "Appearance", "Curves And Gradients" }
ClipboardTool.spatial = {
	Position = true,
	Orientation = true,
	Size = true,
}
ClipboardTool.excluded = {
	Attachment0 = true,
	Attachment1 = true,
	Adornee = true,
	PrimaryPart = true,
	MeshId = true,
	Scale = true,
}
ClipboardTool.sequenceKinds = {
	NumberSequence = true,
	ColorSequence = true,
}

ClipboardTool.messages = {
	copied = "Copied %d properties from %s.",
	nothingCopied = "Copy from an object first.",
	pasted = "Pasted onto %d object%s.",
	noMatch = "None of the copied properties fit the selection.",
}

function ClipboardTool.new(context)
	local self = setmetatable({}, ClipboardTool)

	Tool.init(self, context, {
		Mode = "Everything",
	})

	self.access = context.access
	self.copied = nil

	return self
end

function ClipboardTool:getFields()
	return {
		self:choice("Mode", "Paste", ClipboardTool.modes, { tip = "Which of the copied properties get pasted." }),
		self:action("Copy", "Copy From Selection", function()
			self:copy()
		end, "Remember the properties of the first selected object."),
		self:action("Paste", "Paste To Selection", function()
			self:paste()
		end, "Write the copied properties onto every selected object that has them.", true),
	}
end

function ClipboardTool:isSpatialValue(name: string, value): boolean
	return ClipboardTool.spatial[name] == true and typeof(value) == "Vector3"
end

function ClipboardTool:copy()
	local source = self.selection:getFirst()

	if not source then
		self.context.notify(Tool.messages.nothing)
		return
	end

	local values = {}
	local count = 0

	for _, name in self.access:getPropertyNames(source) do
		if not ClipboardTool.excluded[name] then
			local success, value = self.access:read(source, name)

			if success and value ~= nil and not self:isSpatialValue(name, value) then
				values[name] = value
				count += 1
			end
		end
	end

	self.copied = { values = values, name = source.Name }
	self.context.notify(string.format(ClipboardTool.messages.copied, count, source.Name))
end

function ClipboardTool:allows(name: string, value): boolean
	local mode = self.params.Mode

	if mode == "Appearance" then
		return table.find(configuration.Create.Schema.appearance, name) ~= nil
	elseif mode == "Curves And Gradients" then
		return ClipboardTool.sequenceKinds[typeof(value)] == true
	end

	return true
end

function ClipboardTool:paste()
	local copied = self.copied

	if not copied then
		self.context.notify(ClipboardTool.messages.nothingCopied)
		return
	end

	local targets = self.selection:get()

	if #targets == 0 then
		self.context.notify(Tool.messages.nothing)
		return
	end

	local changed = 0

	self:run("Paste Properties", function()
		for _, target in targets do
			local touched = false

			for name, value in copied.values do
				if self:allows(name, value) then
					local success, current = self.access:read(target, name)

					if success and typeof(current) == typeof(value) and self.access:write(target, name, value) then
						touched = true
					end
				end
			end

			if touched then
				changed += 1
			end
		end
	end)

	if changed == 0 then
		self.context.notify(ClipboardTool.messages.noMatch)
	else
		self.context.notify(string.format(ClipboardTool.messages.pasted, changed, if changed == 1 then "" else "s"))
	end
end

return ClipboardTool
]]></ProtectedString>
								<string name="ScriptGuid">{6576D609-E393-4EB8-B789-BB4A54D424DF}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<string name="Name">ClipboardTool</string>
								<BinaryString name="SerializedOverrides"></BinaryString>
								<int64 name="SourceAssetId">-1</int64>
