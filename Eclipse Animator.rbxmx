							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local assetService = game:GetService("AssetService")
local studioService = game:GetService("StudioService")

local FlipbookImporter = {}
FlipbookImporter.__index = FlipbookImporter

FlipbookImporter.fileTypes = { "png", "jpg", "jpeg" }
FlipbookImporter.maximumFrames = 256
FlipbookImporter.attempts = 3
FlipbookImporter.retryDelay = 1.5
FlipbookImporter.padding = 12
FlipbookImporter.description = "Mesh flipbook frame uploaded with Arc"
FlipbookImporter.deniedReason = "PermissionDenied"

FlipbookImporter.messages = {
	busy = "Images are still uploading. Wait for that to finish first.",
	promptFailed = "Studio could not open the file picker.",
	tooMany = "That is %d images. A flipbook can import up to %d at once.",
	confirmTitle = "Upload Images",
	confirm = "Upload %d image%s to your Roblox account and use them as this flipbook's frames, in file name order? Each one becomes an image in your inventory and goes through moderation like any upload.",
	agree = "Upload",
	disagree = "Cancel",
	started = "Uploading %d image%s. This can take a moment.",
	done = "%d image%s uploaded and set as the flipbook's frames.",
	partial = "%d of %d images uploaded before one failed (%s). The uploaded ones were set as frames.",
	failed = "The upload failed (%s). Nothing was changed.",
	denied = "Studio did not allow Arc to upload. Allow it when Studio asks, then try again.",
}

function FlipbookImporter.new(context)
	local self = setmetatable({}, FlipbookImporter)

	self.context = context
	self.busy = false

	self.promptFiles = function()
		return studioService:PromptImportFiles(FlipbookImporter.fileTypes)
	end

	self.uploadFile = function(file, name: string)
		return self:uploadImage(file, name)
	end

	return self
end

function FlipbookImporter:isBusy(): boolean
	return self.busy
end

function FlipbookImporter:plural(count: number): string
	return if count == 1 then "" else "s"
end

function FlipbookImporter:getSortKey(name: string): string
	local padding = FlipbookImporter.padding

	return (string.gsub(string.lower(name), "%d+", function(digits)
		return string.rep("0", math.max(padding - #digits, 0)) .. digits
	end))
end

function FlipbookImporter:sortFiles(files)
	local sorted = table.clone(files)

	table.sort(sorted, function(a, b)
		return self:getSortKey(a.Name) < self:getSortKey(b.Name)
	end)

	return sorted
end

function FlipbookImporter:readImage(file)
	local temporary = file:GetTemporaryId()
	local image = nil

	pcall(function()
		image = assetService:CreateEditableImageAsync(Content.fromUri(temporary))
	end)

	if not image then
		pcall(function()
			image = (assetService :: any):CreateEditableImageAsync(temporary)
		end)
	end

	return image
end

function FlipbookImporter:uploadImage(file, name: string): (string?, string?)
	local image = self:readImage(file)

	if not image then
		return nil, "the image could not be read"
	end

	local success, result, assetId = pcall(function()
		return assetService:CreateAssetAsync(image, Enum.AssetType.Image, {
			Name = name,
			Description = FlipbookImporter.description,
		})
	end)

	pcall(function()
		image:Destroy()
	end)

	if not success then
		return nil, tostring(result)
	end

	if result ~= Enum.CreateAssetResult.Success then
		return nil, result.Name
	end

	return string.format("%d", assetId), nil
end

function FlipbookImporter:uploadWithRetry(file, name: string): (string?, string?)
	local reason = nil

	for attempt = 1, FlipbookImporter.attempts do
		local id, problem = self.uploadFile(file, name)

		if id then
			return id, nil
		end

		reason = problem

		if problem == FlipbookImporter.deniedReason or attempt == FlipbookImporter.attempts then
			break
		end

		task.wait(FlipbookImporter.retryDelay * attempt)
	end

	return nil, reason
end

function FlipbookImporter:upload(files, baseName: string, callback: ({ string }) -> ())
	local messages = FlipbookImporter.messages
	local total = #files

	self.busy = true
	self.context.notify(string.format(messages.started, total, self:plural(total)))

	task.spawn(function()
		local ids = {}
		local problem = nil

		for index, file in files do
			local id, reason = self:uploadWithRetry(file, string.format("%s %03d", baseName, index))

			if not id then
				problem = reason or "unknown"
				break
			end

			table.insert(ids, id)
		end

		self.busy = false

		if problem == FlipbookImporter.deniedReason then
			self.context.notify(messages.denied)
		elseif problem and #ids == 0 then
			self.context.notify(string.format(messages.failed, problem))
		elseif problem then
			self.context.notify(string.format(messages.partial, #ids, total, problem))
		else
			self.context.notify(string.format(messages.done, total, self:plural(total)))
		end

		if #ids > 0 then
			callback(ids)
		end
	end)
end

function FlipbookImporter:import(baseName: string, callback: ({ string }) -> ())
	local messages = FlipbookImporter.messages

	if self.busy then
		self.context.notify(messages.busy)
		return
	end

	local success, files = pcall(self.promptFiles)

	if not success then
		self.context.notify(messages.promptFailed)
		return
	end

	if typeof(files) ~= "table" or #files == 0 then
		return
	end

	if #files > FlipbookImporter.maximumFrames then
		self.context.notify(string.format(messages.tooMany, #files, FlipbookImporter.maximumFrames))
		return
	end

	local sorted = self:sortFiles(files)

	self.context.confirm({
		title = messages.confirmTitle,
		description = string.format(messages.confirm, #sorted, self:plural(#sorted)),
		agreeText = messages.agree,
		disagreeText = messages.disagree,
		onAgree = function()
			self:upload(sorted, baseName, callback)
		end,
	})
end

return FlipbookImporter
]]></ProtectedString>
