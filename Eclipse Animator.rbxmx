							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local changeHistoryService = game:GetService("ChangeHistoryService")

local History = {}
History.__index = History

History.prefix = "Arc Create: "

function History.new()
	local self = setmetatable({}, History)

	self.recording = nil
	self.depth = 0

	return self
end

function History:isRecording(): boolean
	return self.depth > 0
end

function History:begin(name: string)
	self.depth += 1

	if self.depth > 1 then
		return
	end

	local success, recording = pcall(function()
		return changeHistoryService:TryBeginRecording(History.prefix .. name)
	end)

	self.recording = if success then recording else nil
end

function History:beginProperties(name, access, targets, names)
	local commit = self.depth == 0 and self.propertyRecorder and self.propertyRecorder(name)
	if not commit then
		self:begin(name)
		return
	end
	local entries = {}
	for _, target in targets do
		for _, property in names do
			local ok, value = access:read(target, property)
			if ok then
				table.insert(entries, { target = target, property = property, before = value })
			end
		end
	end
	self.depth = 1
	self.properties = { access = access, entries = entries, commit = commit }
end

function History:finish(cancel: boolean?)
	if self.depth == 0 then
		return
	end

	self.depth -= 1

	if self.depth > 0 then
		return
	end

	local properties = self.properties
	self.properties = nil
	if properties then
		local changes = {}
		for _, entry in properties.entries do
			local ok, value = properties.access:read(entry.target, entry.property)
			if ok and not properties.access:equals(entry.before, value) then
				entry.after = value
				table.insert(changes, entry)
			end
		end
		local function restore(field)
			for _, entry in changes do
				if entry.target.Parent then
					properties.access:write(entry.target, entry.property, entry[field])
				end
			end
		end
		if cancel then
			restore("before")
		elseif #changes > 0 then
			properties.commit(function() restore("before") end, function() restore("after") end)
		end
		return
	end

	local recording = self.recording

	self.recording = nil

	if not recording then
		return
	end

	pcall(function()
		local operation = if cancel then Enum.FinishRecordingOperation.Cancel else Enum.FinishRecordingOperation.Commit

		changeHistoryService:FinishRecording(recording, operation)
	end)
end

function History:run(name: string, action: () -> ...any): ...any
	self:begin(name)

	local results = table.pack(pcall(action))

	self:finish(not results[1])

	if not results[1] then
		warn(results[2])
		return nil
	end

	return table.unpack(results, 2, results.n)
end

function History:destroy()
	while self.depth > 0 do
		self:finish()
	end
end

return History
]]></ProtectedString>
