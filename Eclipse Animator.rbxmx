							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ScreenAttach = {}
ScreenAttach.__index = ScreenAttach

ScreenAttach.attributes = {
	enabled = "ArcScreenAttach",
	start = "ArcScreenStart",
	finish = "ArcScreenEnd",
	distance = "ArcScreenDistance",
	scale = "ArcScreenScale",
	offset = "ArcScreenOffset",
	rotation = "ArcScreenRotation",
}
ScreenAttach.degrees = math.pi / 180
ScreenAttach.tolerance = 1e-3

function ScreenAttach.isAttached(instance: Instance): boolean
	return instance:IsA("BasePart") and instance:GetAttribute(ScreenAttach.attributes.enabled) == true
end

function ScreenAttach.new()
	local self = setmetatable({}, ScreenAttach)

	self.parts = {}
	self.records = {}

	return self
end

function ScreenAttach:collect(root: Instance)
	self:restoreAll()
	table.clear(self.parts)
	table.clear(self.records)

	for _, descendant in root:GetDescendants() do
		if ScreenAttach.isAttached(descendant) then
			table.insert(self.parts, descendant)
		end
	end
end

function ScreenAttach:hasParts(): boolean
	return #self.parts > 0
end

function ScreenAttach:getNumber(part: Instance, name: string, default: number): number
	local value = part:GetAttribute(name)

	return if typeof(value) == "number" then value else default
end

function ScreenAttach:getVector(part: Instance, name: string, default: Vector3): Vector3
	local value = part:GetAttribute(name)

	return if typeof(value) == "Vector3" then value else default
end

function ScreenAttach:isActive(part: BasePart, time: number): boolean
	local names = ScreenAttach.attributes
	local start = self:getNumber(part, names.start, 0)
	local finish = self:getNumber(part, names.finish, math.huge)

	return time >= start and time <= finish
end

function ScreenAttach:getPlacement(part: BasePart, camera: Camera, restSize: Vector3): (CFrame, Vector3)
	local names = ScreenAttach.attributes
	local distance = self:getNumber(part, names.distance, 1.5)
	local scale = self:getVector(part, names.scale, Vector3.one)
	local offset = self:getVector(part, names.offset, Vector3.zero)
	local rotation = self:getVector(part, names.rotation, Vector3.zero) * ScreenAttach.degrees
	local viewport = camera.ViewportSize
	local height = math.tan(math.rad(camera.FieldOfView / 2)) * distance * 2
	local width = if viewport.Y > 0 then viewport.X / viewport.Y * height else height
	local cframe = camera.CFrame * CFrame.new(0, 0, -distance) * CFrame.new(offset) * CFrame.fromOrientation(rotation.X, rotation.Y, rotation.Z)

	return cframe, Vector3.new(width, height, restSize.Z) * scale
end

function ScreenAttach:isSame(a: CFrame?, b: CFrame?): boolean
	if not a or not b then
		return false
	end

	return (a.Position - b.Position).Magnitude < ScreenAttach.tolerance
		and a.LookVector:Dot(b.LookVector) > 1 - ScreenAttach.tolerance
		and a.UpVector:Dot(b.UpVector) > 1 - ScreenAttach.tolerance
end

function ScreenAttach:getRecord(part: BasePart)
	local record = self.records[part]

	if not record then
		record = { displaced = false, restCFrame = part.CFrame, restSize = part.Size, placed = nil }
		self.records[part] = record
	end

	return record
end

function ScreenAttach:update(time: number)
	local camera = workspace.CurrentCamera

	for _, part in self.parts do
		if not part.Parent then
			continue
		end

		local record = self:getRecord(part)
		local moved = not record.displaced or not self:isSame(part.CFrame, record.placed)

		if camera and self:isActive(part, time) then
			if moved then
				record.restCFrame = part.CFrame
				record.restSize = part.Size
			end

			local cframe, size = self:getPlacement(part, camera, record.restSize)

			part.CFrame = cframe
			part.Size = size
			record.placed = part.CFrame
			record.displaced = true
		elseif record.displaced then
			if not moved then
				part.CFrame = record.restCFrame
				part.Size = record.restSize
			end

			record.displaced = false
			record.placed = nil
		end
	end
end

function ScreenAttach:isDisplaced(part: Instance): boolean
	local record = self.records[part]

	return record ~= nil and record.displaced and self:isSame((part :: BasePart).CFrame, record.placed)
end

function ScreenAttach:captureTransform(source: Instance, state, getParentCFrame: (Instance) -> CFrame)
	if not state or not state.cframe or not self:isDisplaced(source) then
		return state
	end

	local record = self.records[source]
	local copy = table.clone(state)

	copy.cframe = getParentCFrame(source):ToObjectSpace(record.restCFrame)

	if copy.size then
		copy.size = record.restSize
	end

	return copy
end

function ScreenAttach:restoreAll()
	for part, record in self.records do
		if record.displaced and part.Parent and self:isSame(part.CFrame, record.placed) then
			part.CFrame = record.restCFrame
			part.Size = record.restSize
		end

		record.displaced = false
		record.placed = nil
	end
end

function ScreenAttach:clear()
	self:restoreAll()
	table.clear(self.parts)
	table.clear(self.records)
end

return ScreenAttach
]]></ProtectedString>
