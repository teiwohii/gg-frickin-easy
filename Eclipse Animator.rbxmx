					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local bound = {}
local drivers = setmetatable({}, { __mode = "k" })
 
function bound.apply(rig, pivot)
	local root = rig:IsA("BasePart") and rig or require("transaction").primary(rig)
	if not root then
		return false
	end
	local revision = require("poseCache").revision()
	local cached = drivers[rig]
	if not cached or cached.root ~= root or cached.revision ~= revision then
		local driver
		for _, joint in require("rigTraversal").joints(root) do
			if
				joint:IsA("Motor6D")
				and joint.Part1 == root
				and joint.Part0
				and joint.Part0 ~= rig
				and not joint.Part0:IsDescendantOf(rig)
			then
				if driver then
					driver = false
					break
				end
				driver = joint
			end
		end
		cached = { revision = revision, root = root, driver = driver }
		drivers[rig] = cached
	end
	local driver = cached.driver
	if not driver then
		return false
	end
	if not driver.Enabled or not driver.Part0 or driver.Part1 ~= root then
		return false
	end
	local old = rig:IsA("Model") and rig:GetPivot() or rig.CFrame
	local delta = pivot * old:Inverse()
	local target = delta * root.CFrame
	local c0 = driver.Part0.CFrame:ToObjectSpace(target) * driver.C1
	if driver.C0 ~= c0 then
		driver.C0 = c0
	end
	if driver.Transform ~= CFrame.identity then
		driver.Transform = CFrame.identity
	end
	if old:FuzzyEq(pivot, 1e-6) then
		return true
	end
	local parts, frames = {}, {}
	for _, part in rig:IsA("Model") and rig:GetDescendants() or { rig } do
		if part:IsA("BasePart") then
			table.insert(parts, part)
			table.insert(frames, delta * part.CFrame)
		end
	end
	 
	workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
	return true
end

function bound.prepare(record, object, anchor, owner, raw)
	local timeline = require("state").Timeline
	local motion, layers = require("propertyMotion"), require("layers")
	local before, after = {}, {}
	local oldParent = record.p0 and record.p0.CFrame or anchor.CFrame
	for _, bucket in motion.buckets(raw, record.motor) do
		before[bucket] = layers.clone(bucket)
		local copy = layers.clone(bucket)
		for _, key in copy do
			if typeof(key.C0) ~= "CFrame" then
				continue
			end
			local world = key.Parented == false and key.WorldCFrame
				or oldParent * key.C0 * record.c1:Inverse()
			local localPose = anchor.CFrame:ToObjectSpace(world) * record.nextC1
			motion.rebase(key, key.C0, localPose, timeline)
			key.Parented, key.WorldCFrame, key.MasterWorld = true, nil, nil
			key.CamTargetParent, key.CamTargetAnchor = nil, nil
		end
		after[bucket] = copy
	end
	local properties = require("properties")
	local link
	for _, motor in properties.list(object, false, true) do
		if motor.PropertyId ~= "CFrame" then
			continue
		end
		for _, bucket in motion.buckets(raw, motor) do
			before[bucket] = layers.clone(bucket)
			local copy = layers.clone(bucket)
			for _, key in copy do
				if key.CamTargetParent and typeof(key.CamTargetAnchor) == "CFrame" then
					local previous = require("target").linkWorld(
						key.CamTargetParent,
						raw.CurrentTime,
						key.CamTargetAnchor
					)
					if previous then
						motion.rebase(key, key.CamTargetAnchor, previous, timeline)
					end
				end
				link = link or require("target").reference(anchor, owner)
				key.CamTargetParent, key.CamTargetAnchor = link, anchor.CFrame
			end
			after[bucket] = copy
		end
	end
	local default, world, parented =
		raw.DefaultPose[record.motor],
		raw.DefaultWorldPose[record.motor],
		raw.ParentingDefaults[record.motor]
	local attribute = record.motor:GetAttribute("EclipseParentingDefault")
	local defaultAttribute = record.motor:GetAttribute("EclipseAnimatorDefaultC0")
	return function(enabled)
		motion.apply(enabled and after or before)
		record.motor:SetAttribute("EclipseParentingDefault", if enabled then true else attribute)
		record.motor:SetAttribute(
			"EclipseAnimatorDefaultC0",
			if enabled then record.c0 else defaultAttribute
		)
		if not record.register then
			raw.DefaultPose[record.motor] = enabled and record.c0 or default
			raw.DefaultWorldPose[record.motor] = enabled and record.world or world
			raw.ParentingDefaults[record.motor] = if enabled then true else parented
		end
	end
end

return bound
]]></ProtectedString>
