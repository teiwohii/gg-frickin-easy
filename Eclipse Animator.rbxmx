								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local spatial = require(script.Parent.Parent.spatial)
local Tool = require(script.Parent.Tool)

local AlignTool = Tool.extend()

AlignTool.id = "Align"
AlignTool.title = "Align & Distribute"
AlignTool.keywords = "align distribute space even edge centre center"
AlignTool.edges = { "Min", "Centre", "Max" }
AlignTool.targets = { "Selection", "First Selected", "Asset Origin" }

AlignTool.messages = {
	distribute = "Select at least three objects to distribute.",
}

function AlignTool.new(context)
	local self = setmetatable({}, AlignTool)

	Tool.init(self, context, {
		Axis = "Y",
		Edge = "Centre",
		Target = "Selection",
	})

	return self
end

function AlignTool:getFields()
	return {
		self:choice("Axis", "Axis", spatial.axisNames),
		self:choice("Edge", "Edge", AlignTool.edges, { tip = "Which side of each object is lined up." }),
		self:choice("Target", "Align To", AlignTool.targets),
		self:action("Align", "Align", function()
			self:align()
		end, nil, true),
		self:action("Distribute", "Distribute Evenly", function()
			self:distribute()
		end, "Space the selected objects evenly between the first and last along the axis."),
	}
end

function AlignTool:pick(low: Vector3, high: Vector3): number
	local axis = self.params.Axis
	local minimum = spatial.getComponent(low, axis)
	local maximum = spatial.getComponent(high, axis)

	if self.params.Edge == "Min" then
		return minimum
	elseif self.params.Edge == "Max" then
		return maximum
	end

	return (minimum + maximum) / 2
end

function AlignTool:getGoal(roots: { Instance }): number?
	local target = self.params.Target

	if target == "Asset Origin" then
		return spatial.getComponent(self:getOrigin(), self.params.Axis)
	end

	local low, high

	if target == "First Selected" then
		low, high = spatial.getExtents(roots[1])
	else
		low, high = spatial.getBounds(roots)
	end

	return if low and high then self:pick(low, high) else nil
end

function AlignTool:align()
	local roots = self:requireRoots(true)

	if not roots then
		return
	end

	local goal = self:getGoal(roots)

	if goal == nil then
		return
	end

	local axis = spatial.axes[self.params.Axis]

	self:run("Align", function()
		for _, root in roots do
			local low, high = spatial.getExtents(root)
			local pivot = spatial.getPivot(root)

			if low and high and pivot then
				spatial.setPivot(root, pivot + axis * (goal - self:pick(low, high)))
			end
		end
	end)
end

function AlignTool:distribute()
	local roots = self:requireRoots(true)

	if not roots then
		return
	end

	if #roots < 3 then
		self.context.notify(AlignTool.messages.distribute)
		return
	end

	local axisName = self.params.Axis
	local axis = spatial.axes[axisName]
	local entries = {}

	for _, root in roots do
		local pivot = spatial.getPivot(root)

		if pivot then
			table.insert(entries, { root = root, pivot = pivot, value = spatial.getComponent(pivot.Position, axisName) })
		end
	end

	table.sort(entries, function(a, b)
		return a.value < b.value
	end)

	local first = entries[1].value
	local step = (entries[#entries].value - first) / (#entries - 1)

	self:run("Distribute", function()
		for index, entry in entries do
			spatial.setPivot(entry.root, entry.pivot + axis * (first + step * (index - 1) - entry.value))
		end
	end)
end

return AlignTool
]]></ProtectedString>
								<string name="ScriptGuid">{AF8D6EA6-1F72-4DE3-9EE7-3D3BB9F9A494}</string>
