							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)

local Drawer = {}
Drawer.__index = Drawer

Drawer.gap = 6
Drawer.top = 36

function Drawer.extend()
	local Class = setmetatable({}, { __index = Drawer })

	Class.__index = Class

	return Class
end

function Drawer.init(self, frame: Frame, root: GuiObject, group: { any }, closeButton: GuiButton)
	self.frame = frame
	self.root = root
	self.group = group
	self.owner = nil
	self.connections = {}

	table.insert(group, self)

	table.insert(self.connections, closeButton.Activated:Connect(function()
		self:close()
	end))
end

function Drawer:connect(signal: RBXScriptSignal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function Drawer:isOpen(): boolean
	return self.frame.Visible
end

function Drawer:getOwner()
	return self.owner
end

function Drawer:getFrame(): Frame
	return self.frame
end

function Drawer:getScale(): number
	local scale = self.root:FindFirstChildOfClass("UIScale")

	return if scale and scale.Scale > 0 then scale.Scale else 1
end

function Drawer:contains(guiObject: GuiObject, point: Vector2): boolean
	local position = guiObject.AbsolutePosition
	local size = guiObject.AbsoluteSize

	return point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y
end

function Drawer:isInside(input: InputObject): boolean
	return self:contains(self.frame, Vector2.new(input.Position.X, input.Position.Y))
end

function Drawer:getDeleteKeyName(): string
	local key = configuration.Keyframes.deleteKeys[1]

	return if key then key.Name else "Delete"
end

function Drawer:isDeleteInput(input: InputObject): boolean
	if input.UserInputType ~= Enum.UserInputType.Keyboard or userInputService:GetFocusedTextBox() then
		return false
	end

	if userInputService:IsKeyDown(Enum.KeyCode.LeftControl) or userInputService:IsKeyDown(Enum.KeyCode.RightControl) then
		return false
	end

	return table.find(configuration.Keyframes.deleteKeys, input.KeyCode) ~= nil
end

function Drawer:place()
	if Drawer.placer and Drawer.placer(self) then
		return
	end

	local scale = self:getScale()
	local width = self.frame.Size.X.Offset
	local gui = self.root:FindFirstAncestorWhichIsA("LayerCollector")
	local screen = if gui then gui.AbsoluteSize.X else workspace.CurrentCamera.ViewportSize.X
	local right = self.root.AbsolutePosition.X + self.root.AbsoluteSize.X

	if right + (width + Drawer.gap) * scale > screen and self.root.AbsolutePosition.X - (width + Drawer.gap) * scale >= 0 then
		self.frame.Position = UDim2.new(0, -width - Drawer.gap, 0, Drawer.top)
	else
		self.frame.Position = UDim2.new(1, Drawer.gap, 0, Drawer.top)
	end
end

function Drawer:show(owner)
	for _, other in self.group do
		if other ~= self and other:isOpen() then
			other:close()
		end
	end

	self.owner = owner
	self:place()
	self.frame.Visible = true
end

function Drawer:hide()
	self.frame.Visible = false
	self.owner = nil
end

function Drawer:close()
	self:hide()
end

function Drawer:destroy()
	self:close()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
end

return Drawer
]]></ProtectedString>
