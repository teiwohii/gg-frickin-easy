						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local meshFlipbook = require(script.Parent.Parent.Animation.meshFlipbook)

local MeshFlipbookInserter = {}
MeshFlipbookInserter.__index = MeshFlipbookInserter

MeshFlipbookInserter.decalName = "Flipbook"
MeshFlipbookInserter.source = "Frames"
MeshFlipbookInserter.loop = "Once"
MeshFlipbookInserter.idle = "Hide"

MeshFlipbookInserter.menuTexts = {
	replace = "Replace Frames",
}

MeshFlipbookInserter.messages = {
	failed = "The mesh flipbook could not be inserted.",
	noTemplate = "The \"%s\" mesh template is missing from the plugin.",
	inserted = "Added \"%s\" to %s. Press Emit to play it.",
	replaced = "Replaced the frames of %s with \"%s\".",
	replacedMany = "Replaced the frames of %d flipbooks with \"%s\".",
}

MeshFlipbookInserter.targetTexts = {
	container = "Inserts a new mesh in \"%s\".",
	newAsset = "No asset open: inserts into a new asset.",
	replace = "Replaces the frames of \"%s\".",
	replaceMany = "Replaces the frames of %d flipbooks.",
}

function MeshFlipbookInserter.new(context, builder, templates: Instance?, marks)
	local self = setmetatable({}, MeshFlipbookInserter)

	self.context = context
	self.builder = builder
	self.asset = context.asset
	self.selection = context.selection
	self.history = context.history
	self.templates = templates
	self.marks = marks

	return self
end

function MeshFlipbookInserter:getTemplate(entry): BasePart?
	local template = if self.templates then self.templates:FindFirstChild(entry.shape) else nil

	return if template and template:IsA("BasePart") then template else nil
end

function MeshFlipbookInserter:createMesh(entry): (BasePart?, Decal?)
	local template = self:getTemplate(entry)

	if not template then
		return nil, nil
	end

	local part = template:Clone()
	local decal = part:FindFirstChildWhichIsA("Decal")

	if not decal then
		decal = Instance.new("Decal")
		decal.Name = MeshFlipbookInserter.decalName
		decal.Parent = part
	end

	if entry.color then
		decal.Color3 = entry.color
	end

	part.Name = entry.name

	return part, decal
end

function MeshFlipbookInserter:getConfig(entry)
	return {
		source = MeshFlipbookInserter.source,
		ids = table.clone(entry.ids),
		fps = entry.fps,
		loop = MeshFlipbookInserter.loop,
		idle = MeshFlipbookInserter.idle,
	}
end

function MeshFlipbookInserter:getDecals(): { Instance }
	local decals = {}
	local seen = {}

	local function include(decal: Instance)
		if not seen[decal] then
			seen[decal] = true
			table.insert(decals, decal)
		end
	end

	for _, instance in self.selection:get() do
		if instance:IsDescendantOf(workspace) then
			if meshFlipbook.isHost(instance) then
				include(instance)
			elseif instance:IsA("BasePart") then
				for _, host in meshFlipbook.getHosts(instance) do
					include(host)
				end
			end
		end
	end

	return decals
end

function MeshFlipbookInserter:isReplacing(): boolean
	return #self:getDecals() > 0
end

function MeshFlipbookInserter:getOwnerName(decal: Instance): string
	local owner = decal.Parent

	return if owner and owner:IsA("BasePart") then owner.Name else decal.Name
end

function MeshFlipbookInserter:getTargetText(): string
	local texts = MeshFlipbookInserter.targetTexts
	local decals = self:getDecals()

	if #decals == 1 then
		return string.format(texts.replace, self:getOwnerName(decals[1]))
	elseif #decals > 1 then
		return string.format(texts.replaceMany, #decals)
	end

	local container = self.builder:getContainer()

	if not container then
		return texts.newAsset
	end

	return string.format(texts.container, container.Name)
end

function MeshFlipbookInserter:record(entry)
	if self.marks then
		self.marks:addRecent(entry.key)
	end
end

function MeshFlipbookInserter:insert(entry): { Instance }
	local messages = MeshFlipbookInserter.messages

	if not self:getTemplate(entry) then
		self.context.notify(string.format(messages.noTemplate, entry.shape))
		return {}
	end

	if not self.context.suite:ensureAsset() then
		return {}
	end

	local container = self.builder:getContainer()

	if not container then
		self.context.notify(messages.failed)
		return {}
	end

	local placement = self.builder:getPlacement(container)

	local created = self.history:run("Insert Mesh Flipbook", function()
		local part, decal = self:createMesh(entry)

		if not part or not decal then
			return {}
		end

		part.CFrame = placement * part.CFrame.Rotation
		meshFlipbook.write(decal, self:getConfig(entry))
		meshFlipbook.applyRest(decal)
		part.Parent = container

		return { part }
	end)

	if not created or #created == 0 then
		self.context.notify(messages.failed)
		return {}
	end

	self:record(entry)
	self.selection:set(created)
	self.context.notify(string.format(messages.inserted, entry.name, container.Name))

	return created
end

function MeshFlipbookInserter:replace(entry): number
	local messages = MeshFlipbookInserter.messages
	local decals = self:getDecals()

	if #decals == 0 then
		return 0
	end

	self.context.flipbooks:setFrames(decals, entry.ids, "Replace Flipbook Frames", self:getConfig(entry))
	self:record(entry)

	if #decals == 1 then
		self.context.notify(string.format(messages.replaced, self:getOwnerName(decals[1]), entry.name))
	else
		self.context.notify(string.format(messages.replacedMany, #decals, entry.name))
	end

	return #decals
end

function MeshFlipbookInserter:activate(entry): number
	if self:isReplacing() then
		return self:replace(entry)
	end

	return #self:insert(entry)
end

return MeshFlipbookInserter
]]></ProtectedString>
							<string name="ScriptGuid">{71C286CC-69DB-4D32-9069-440CBC69C723}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">MeshFlipbookInserter</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
