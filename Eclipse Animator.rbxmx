								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local Tool = require(script.Parent.Tool)

local SnapTool = Tool.extend()

SnapTool.id = "Snap"
SnapTool.title = "Increments"
SnapTool.collapsed = false
SnapTool.keywords = "snap grid step move rotate scale"

SnapTool.entries = {
	{ name = "snap", label = "Snap", kind = "toggle", tip = "Round Position, Orientation and Size to the steps below when you edit them in the inspector." },
	{ name = "positionIncrement", label = "Move Step", kind = "number", range = { min = 0, max = 2 }, tip = "Studs." },
	{ name = "rotationIncrement", label = "Rotate Step", kind = "number", range = { min = 0, max = 90 }, tip = "Degrees." },
	{ name = "scaleIncrement", label = "Scale Step", kind = "number", range = { min = 0, max = 2 }, tip = "Studs." },
}

function SnapTool.new(context)
	local self = setmetatable({}, SnapTool)

	Tool.init(self, context)
	self.settings = context.settings

	return self
end

function SnapTool:getFields()
	local fields = {}

	for _, entry in SnapTool.entries do
		table.insert(fields, {
			id = self:getId(entry.name),
			label = entry.label,
			kind = entry.kind,
			value = self.settings:get(entry.name),
			range = entry.range,
			minimum = 0,
			tip = entry.tip,
			keywords = self.title .. " " .. self.keywords,
			read = function()
				return self.settings:get(entry.name)
			end,
			onChange = function(value, final)
				if final and value ~= nil then
					self.settings:set(entry.name, value)
				end
			end,
		})
	end

	return fields
end

return SnapTool
]]></ProtectedString>
