				</Item>
				<Item class="ModuleScript" referent="RBX367A5B1222D248CE848A8FB76F50E088">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)

local coreGui = game:GetService("CoreGui")
local runService = game:GetService("RunService")
local inputModule = require("userInputService")
local shortcuts = require("shortcuts")

local limbIk = require("limbIk")
local surface = require("surface")
local theme = require("theme")
local tool = require("tool")

local noticeTitle = "LIMB IK"
local pointAAttribute = "EclipseLimbIKPointA"
local pointBAttribute = "EclipseLimbIKPointB"
local pointColors = { Color3.fromRGB(100, 190, 255), Color3.fromRGB(145, 90, 255) }
local pointNames = { "ROOT", "TIP" }
local outlineColor = Color3.fromRGB(69, 41, 93)
local markerPixelRadius = 9
local selectedPixelRadius = 12

local function create(className, properties, children)
	local instance = Instance.new(className)
	for key, value in properties or {} do
		instance[key] = value
	end

	for _, child in children or {} do
		child.Parent = instance
	end

	return instance
end

local function notify(message, duration)
	require("notification").show(noticeTitle, message, duration or 4)
end

local function accentColor()
	return theme.get("MenuSel", Color3.fromRGB(196, 132, 255)):Lerp(Color3.new(1, 1, 1), 0.35)
end

local function addOutline(frame)
	local stroke = create("UIStroke", {
		Name = "Outline",
		Color = outlineColor,
		Transparency = 0.25,
		Thickness = 1,
	})
	stroke:SetAttribute("ThemeStrk", "Strk")
	stroke.Parent = frame
	return stroke
end

local function interfaceScale(screenGui)
	local scale = screenGui and screenGui:FindFirstChildOfClass("UIScale")
	return scale and scale.Scale > 0 and scale.Scale or 1
end

local function applyTheme(root)
	pcall(theme.addRoot, root)
	pcall(theme.applyTree, root)
end

local PointMarker = {}
PointMarker.__index = PointMarker

function PointMarker.new(session, index, worldPosition)
	local self = setmetatable({}, PointMarker)
	self.index = index
	self.color = pointColors[index]
	self.selected = false

	self.part = create("Part", {
		Name = "EclipseLimbIKPoint" .. index,
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * session.pointRadius * 2,
		Transparency = 1,
		Anchored = true,
		Locked = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
		Archivable = false,
		CFrame = CFrame.new(worldPosition),
	})
	self.part.Parent = session.sceneModel

	self.sphere = create("SphereHandleAdornment", {
		Name = "EclipseLimbIKPointMarker" .. index,
		Adornee = self.part,
		AlwaysOnTop = true,
		ZIndex = 1,
		Radius = session.pointRadius,
		Color3 = self.color,
		Transparency = 0.3,
	})
	self.sphere.Parent = session.guiFolder

	return self
end

function PointMarker:getPosition()
	return self.part.Position
end

function PointMarker:setPosition(worldPosition)
	self.part.CFrame = CFrame.new(worldPosition)
end

function PointMarker:setSelected(selected)
	self.selected = selected
	self.sphere.Transparency = selected and 0.1 or 0.35
end

function PointMarker:fitToScreen(camera)
	local depth = -camera.CFrame:PointToObjectSpace(self.part.Position).Z
	local pixels = self.selected and selectedPixelRadius or markerPixelRadius
	local radius = math.max(depth, 0.05)
		* math.tan(math.rad(camera.FieldOfView * 0.5))
		* pixels
		/ math.max(camera.ViewportSize.Y * 0.5, 1)
	self.sphere.Radius = radius
	self.part.Size = Vector3.one * radius * 2
end

function PointMarker:destroy()
	self.sphere:Destroy()
	self.part:Destroy()
end

local SetupSession = {}
SetupSession.__index = SetupSession

function SetupSession.new(controller, motor, rig)
	local self = setmetatable({}, SetupSession)
	self.controller = controller
	self.state = controller.refs.State
	self.timeline = self.state.Timeline
	self.motor = motor
	self.rig = rig
	self.part = motor.Part1
	self.part0 = motor.Part0
	self.activeRig = self.state.currentRig
	self.markers = {}
	self.connections = {}
	self.closed = false
	self.undoStack, self.redoStack = {}, {}
	return self
end

function SetupSession:start()
	self.wasPresentationHidden = self.state.PresentationHidden == true
	require("dockHost").setSuppressed(true)
	require("visibility").setHidden(true)
	local selection = game:GetService("Selection")
	self.studioSelection = selection:Get()
	table.insert(
		self.connections,
		selection.SelectionChanged:Connect(function()
			if not self.closed and #selection:Get() > 0 then
				selection:Set({})
			end
		end)
	)
	selection:Set({})
	local limbSize = self.part.Size
	self.pointRadius = math.clamp(math.min(limbSize.X, limbSize.Y, limbSize.Z) * 0.12, 0.03, 0.25)
	self.interfaceScale = interfaceScale(self.controller.refs.ScreenGui)
	self.partCFrame = self.part.CFrame
	self.sceneModel = create("Model", { Name = "EclipseLimbIKSetup", Archivable = false })

	self.guiFolder = create("Folder", { Name = "EclipseLimbIKSetupGui", Archivable = false })
	self:buildOverlay()
	self:buildHandles()

	local pointA, pointB = self:initialPoints()
	for index, localPoint in { pointA, pointB } do
		local worldPoint = self.part.CFrame:PointToWorldSpace(localPoint)
		self.markers[index] = PointMarker.new(self, index, worldPoint)
	end

	self:buildLink()
	self.sceneModel.Parent = workspace
	self.guiFolder.Parent = coreGui

	self:selectPoint(self.markers[1])
	self:refreshLink()

	table.insert(
		self.connections,
		runService.Heartbeat:Connect(function()
			if not self:isValid() then
				self:exit()
				return
			end

			self:syncPart()
			if self.grab then
				self:updateGrab(inputModule:GetViewportMouseLocation())
			end
			self:fitMarkers()
		end)
	)
	table.insert(
		self.connections,
		self.controller.refs.ScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not self.controller.refs.ScreenGui.Enabled then
				self:exit()
			end
		end)
	)
	table.insert(
		self.connections,
		inputModule.InputBegan:Connect(function(input)
			self:input(input)
		end)
	)
	table.insert(
		self.connections,
		inputModule.WindowFocusReleased:Connect(function()
			self:finishEdit(true)
		end)
	)
	table.insert(
		self.connections,
		inputModule.InputEnded:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				and self.editBefore
				and not self.grab
			then
				self:finishEdit(false)
			end
		end)
	)
	self:fitMarkers()

	return true
end

function SetupSession:fitMarkers()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	for _, marker in self.markers do
		marker:fitToScreen(camera)
	end
end

function SetupSession:syncPart()
	local current = self.part.CFrame
	if current == self.partCFrame then
		return
	end
	local delta = current * self.partCFrame:Inverse()
	for _, marker in self.markers do
		marker:setPosition(delta:PointToWorldSpace(marker:getPosition()))
	end
	self.dragOrigin = nil
	if self.grab then
		self.grab.origin = delta:PointToWorldSpace(self.grab.origin)
	end
	self.partCFrame = current
	self:refreshLink()
end

function SetupSession:buildPanel(screen, name, size, anchor, position)
	local panel = create("Frame", {
		Name = name,
		AnchorPoint = anchor,
		Position = position,
		Size = UDim2.fromOffset(size.X, size.Y),
		Active = true,
		ZIndex = 10,
	})
	surface.fill(panel)
	addOutline(panel)
	panel.Parent = screen
	return panel
end

function SetupSession:buildOverlay()
	local screenGui = self.controller.refs.ScreenGui
	local screen = create(
		"ScreenGui",
		{
			Name = "Overlay",
			DisplayOrder = (screenGui and screenGui.DisplayOrder or 0) + 20,
			IgnoreGuiInset = false,
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		}
	)
	create("UIScale", { Scale = self.interfaceScale }).Parent = screen
	local panel = self:buildPanel(
		screen,
		"SetupBar",
		Vector2.new(520, 76),
		Vector2.new(0.5, 1),
		UDim2.new(0.5, 0, 1, -16)
	)
	panel.Size = UDim2.new(1, -24, 0, 76)
	create("UISizeConstraint", { MaxSize = Vector2.new(520, 110) }).Parent = panel
	local title =
		tool.label(panel, "Title", "SET UP IK", UDim2.fromOffset(12, 7), UDim2.fromOffset(90, 20))
	title.TextSize = 12
	local name = tool.label(
		panel,
		"PartName",
		self.part.Name,
		UDim2.fromOffset(108, 7),
		UDim2.new(1, -120, 0, 20)
	)
	name.TextTruncate = Enum.TextTruncate.AtEnd
	name.TextTransparency = 0.25
	self.pointButtons = {}
	for index, text in pointNames do
		local button = tool.button(
			panel,
			text,
			text,
			UDim2.new((index - 1) * 0.24, 12, 0, 36),
			UDim2.new(0.24, -10, 0, 28),
			function()
				if self.markers[index] then
					self:selectPoint(self.markers[index])
				end
			end
		)
		self.pointButtons[index] = button
	end
	self.exitButton = tool.button(
		panel,
		"Cancel",
		"CANCEL",
		UDim2.new(0.5, 2, 0, 36),
		UDim2.new(0.24, -8, 0, 28),
		function()
			self:exit()
		end
	)
	self.finishButton = tool.button(
		panel,
		"Apply",
		"APPLY",
		UDim2.new(0.75, 0, 0, 36),
		UDim2.new(0.25, -12, 0, 28),
		function()
			self:finish()
		end
	)
	self.finishButton:SetAttribute("Primary", true)
	self.finishButton:SetAttribute("ThemeBg", "MenuSel")
	self.errorLabel =
		tool.label(panel, "Error", "", UDim2.fromOffset(12, 72), UDim2.new(1, -24, 0, 24))
	self.errorLabel.Visible = false
	self.errorLabel.TextSize = 11
	self.errorLabel.TextWrapped = true
	self.panel = panel
	screen.Parent = self.guiFolder
	self.overlay = screen
	applyTheme(screen)
end

function SetupSession:showError(message)
	self.errorLabel.Text = message
	self.errorLabel.Visible = true
	self.panel.Size = UDim2.new(1, -24, 0, 104)
end

function SetupSession:buildHandles()
	self.handles = create("Handles", {
		Name = "EclipseLimbIKPointHandles",
		Style = Enum.HandlesStyle.Movement,
		Color3 = accentColor(),
	})
	self.handles.Parent = self.guiFolder

	table.insert(
		self.connections,
		self.handles.MouseButton1Down:Connect(function()
			self:beginEdit()
			self.dragOrigin = self.selectedMarker and self.selectedMarker:getPosition()
		end)
	)
	table.insert(
		self.connections,
		self.handles.MouseDrag:Connect(function(face, distance)
			if not self.dragOrigin or not self.selectedMarker then
				return
			end

			local moved = self.dragOrigin + Vector3.FromNormalId(face) * distance
			self.selectedMarker:setPosition(moved)
			self:refreshLink()
		end)
	)
	table.insert(
		self.connections,
		self.handles.MouseButton1Up:Connect(function()
			self:finishEdit(false)
		end)
	)
end

function SetupSession:buildLink()
	self.link = create("LineHandleAdornment", {
		Name = "EclipseLimbIKPointLink",
		Adornee = self.markers[1].part,
		AlwaysOnTop = true,
		ZIndex = 0,
		Thickness = 1.5,
		Color3 = accentColor(),
		Transparency = 0.45,
	})
	self.link.Parent = self.guiFolder
end

function SetupSession:refreshLink()
	if not self.link then
		return
	end

	local offset = self.markers[2]:getPosition() - self.markers[1]:getPosition()
	self.link.Visible = offset.Magnitude > 1e-4
	if self.link.Visible then
		self.link.CFrame = CFrame.lookAt(Vector3.zero, offset)
		self.link.Length = offset.Magnitude
	end
end

function SetupSession:initialPoints()
	local saved = limbIk.customPoints(self.motor)
	if saved then
		return saved.a, saved.b
	end

	local size = self.part.Size
	local axis, length = Vector3.yAxis, size.Y
	if size.X > length then
		axis, length = Vector3.xAxis, size.X
	end

	if size.Z > length then
		axis, length = Vector3.zAxis, size.Z
	end

	local offset = axis * length * 0.45
	 
	local anchor = self.part0 and self.part0.Position
	if anchor then
		local a = self.part.CFrame:PointToWorldSpace(offset)
		local b = self.part.CFrame:PointToWorldSpace(-offset)
		if (a - anchor).Magnitude < (b - anchor).Magnitude then
			offset = -offset
		end
	end
	return offset, -offset
end

function SetupSession:selectPoint(marker)
	if self.closed then
		return
	end
	self:finishEdit(false)
	self.selectedMarker = marker
	self.dragOrigin = nil
	for index, button in self.pointButtons or {} do
		button:SetAttribute("Primary", self.markers[index] == marker)
	end
	for _, other in self.markers do
		other:setSelected(other == marker)
	end

	if self.handles then
		self.handles.Adornee = marker and marker.part or nil
		self.handles.Color3 = marker and marker.color or accentColor()
	end
end

function SetupSession:snapshot()
	local a, b = self:localPoints()
	return { a, b }
end

function SetupSession:restore(points)
	self:syncPart()
	for index, point in points do
		self.markers[index]:setPosition(self.part.CFrame:PointToWorldSpace(point))
	end
	self:refreshLink()
end

function SetupSession:beginEdit()
	self:finishEdit(false)
	self.editBefore = self:snapshot()
end

function SetupSession:finishEdit(cancel)
	local before = self.editBefore
	self.editBefore, self.grab, self.dragOrigin = nil, nil, nil
	if self.handles then
		self.handles.Visible = true
	end
	if not before then
		return false
	end
	if cancel then
		self:restore(before)
		return true
	end
	local after = self:snapshot()
	if (before[1] - after[1]).Magnitude < 1e-5 and (before[2] - after[2]).Magnitude < 1e-5 then
		return false
	end
	table.insert(self.undoStack, { before = before, after = after })
	if #self.undoStack > 100 then
		table.remove(self.undoStack, 1)
	end
	table.clear(self.redoStack)
	return true
end

function SetupSession:undo()
	if self.closed then
		return false
	end
	if self.editBefore then
		return self:finishEdit(true)
	end
	local entry = table.remove(self.undoStack)
	if not entry then
		return false
	end
	self:restore(entry.before)
	table.insert(self.redoStack, entry)
	return true
end

function SetupSession:redo()
	if self.closed or self.editBefore then
		return false
	end
	local entry = table.remove(self.redoStack)
	if not entry then
		return false
	end
	self:restore(entry.after)
	table.insert(self.undoStack, entry)
	return true
end

function SetupSession:startGrab(point)
	if self.closed or not self.selectedMarker or not point then
		return false
	end
	self:beginEdit()
	self.grab = {
		origin = self.selectedMarker:getPosition(),
		mouse = point,
		normal = workspace.CurrentCamera.CFrame.LookVector,
		marker = self.selectedMarker,
	}
	self.handles.Visible = false
	return true
end

function SetupSession:updateGrab(point)
	local grab, camera = self.grab, workspace.CurrentCamera
	if not grab or not point or not camera then
		return
	end
	local function projected(pixel)
		local ray = camera:ViewportPointToRay(pixel.X, pixel.Y)
		if grab.axis then
			local axis, offset = grab.axis, ray.Origin - grab.origin
			local dot = axis:Dot(ray.Direction)
			local denominator = 1 - dot * dot
			if denominator < 1e-6 then
				return grab.origin
			end
			return grab.origin
				+ axis * ((axis:Dot(offset) - dot * ray.Direction:Dot(offset)) / denominator)
		end
		local denominator = ray.Direction:Dot(grab.normal)
		if math.abs(denominator) < 1e-6 then
			return grab.origin
		end
		return ray.Origin
			+ ray.Direction * ((grab.origin - ray.Origin):Dot(grab.normal) / denominator)
	end
	grab.marker:setPosition(grab.origin + projected(point) - projected(grab.mouse))
	self:refreshLink()
end

function SetupSession:pointAt(point)
	local camera = workspace.CurrentCamera
	if self.closed or not point or not camera then
		return nil
	end
	local closest, bestDistance, bestDepth
	for _, marker in self.markers do
		local projected, visible = camera:WorldToViewportPoint(marker:getPosition())
		if not visible or projected.Z <= 0 then
			continue
		end
		local distance = (Vector2.new(projected.X, projected.Y) - point).Magnitude
		local radius = marker.selected and selectedPixelRadius or markerPixelRadius
		if
			distance <= radius
			and (
				not closest
				or distance < bestDistance - 0.01
				or math.abs(distance - bestDistance) <= 0.01 and projected.Z < bestDepth
			)
		then
			closest, bestDistance, bestDepth = marker, distance, projected.Z
		end
	end
	return closest
end

function SetupSession:input(input)
	if self.closed or inputModule:GetFocusedTextBox() or inputModule.isCapturingKeys() then
		return
	end
	if
		shortcuts.matches("Undo", input)
		or shortcuts.matches("UndoAlternate", input)
		or shortcuts.matches("Redo", input)
		or shortcuts.matches("RedoAlternate", input)
		or shortcuts.matches("RedoShift", input)
	then
		return
	end
	if self.grab then
		if
			input.UserInputType == Enum.UserInputType.MouseButton2
			or shortcuts.matches("Cancel", input)
		then
			self:finishEdit(true)
		elseif
			input.UserInputType == Enum.UserInputType.MouseButton1
			or shortcuts.matches("ConfirmTransform", input)
			or shortcuts.matches("ConfirmTransformAlternate", input)
		then
			self:finishEdit(false)
		elseif input.UserInputType == Enum.UserInputType.Keyboard then
			local axes = { X = Vector3.xAxis, Y = Vector3.yAxis, Z = Vector3.zAxis }
			local axis = axes[input.KeyCode.Name]
			if axis then
				self.grab.axis = self.grab.axis ~= axis and axis or nil
				self:updateGrab(inputModule:GetViewportMouseLocation())
			end
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not self.dragOrigin then
		local point = inputModule:GetViewportMouseLocation()
		if point and not inputModule.pointerOverUI(point) then
			local marker = self:pointAt(point)
			if marker then
				self:selectPoint(marker)
			end
		end
	elseif input.UserInputType == Enum.UserInputType.Keyboard then
		if shortcuts.matches("ToggleBlenderGrab", input) then
			self:startGrab(inputModule:GetViewportMouseLocation())
		elseif shortcuts.matches("Cancel", input) then
			self:exit()
		end
	end
end

function SetupSession:isValid()
	local screenGui = self.controller.refs.ScreenGui
	return not self.closed
		and self.state.LimbPointSetupActive == self
		and workspace.CurrentCamera ~= nil
		and self.motor.Parent ~= nil
		and self.motor.Part1 == self.part
		and self.motor.Part0 == self.part0
		and self.part0.Parent ~= nil
		and self.state.currentRig == self.activeRig
		and self.part.Parent ~= nil
		and self.rig.Parent ~= nil
		and self.motor:IsDescendantOf(self.rig)
		and self.state.Timeline == self.timeline
		and screenGui ~= nil
		and screenGui.Parent ~= nil
end

function SetupSession:localPoints()
	self:syncPart()
	local origin = self.part.CFrame
	return origin:PointToObjectSpace(self.markers[1]:getPosition()),
		origin:PointToObjectSpace(self.markers[2]:getPosition())
end

function SetupSession:finish()
	if self.closed then
		return
	end

	if not self:isValid() then
		self:close()
		return
	end
	self:finishEdit(false)
	local pointA, pointB = self:localPoints()
	if
		not (
			(pointB - pointA).Magnitude >= 0.01
			and pointA.Magnitude < math.huge
			and pointB.Magnitude < math.huge
		)
	then
		self:showError("Move the root and tip apart.")
		return
	end

	local motor, rig = self.motor, self.rig
	self:close()
	self.controller:applyPoints(motor, rig, pointA, pointB)
end

function SetupSession:exit()
	self:close()
end

function SetupSession:close()
	if self.closed then
		return
	end

	self.closed = true
	if self.state.LimbPointSetupActive == self then
		self.state.LimbPointSetupActive = nil
	end
	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)

	for _, marker in self.markers do
		marker:destroy()
	end

	table.clear(self.markers)
	if self.guiFolder then
		self.guiFolder:Destroy()
	end

	if self.sceneModel then
		self.sceneModel:Destroy()
	end

	if self.wasPresentationHidden ~= nil then
		require("visibility").setHidden(self.wasPresentationHidden)
		require("dockHost").setSuppressed(false)
	end
	if self.studioSelection then
		local selected = {}
		for _, item in self.studioSelection do
			if item.Parent then
				table.insert(selected, item)
			end
		end
		game:GetService("Selection"):Set(selected)
	end
	self.controller:sessionClosed(self)
end

local LimbPointSetup = {}
LimbPointSetup.__index = LimbPointSetup

local activeController

function LimbPointSetup.new(refs)
	local self = setmetatable({}, LimbPointSetup)
	self.refs = refs
	self.connections = {}

	if refs.ScreenGui then
		table.insert(
			self.connections,
			refs.ScreenGui.Destroying:Connect(function()
				self:destroy()
			end)
		)
	end

	if refs.Plugin then
		table.insert(
			self.connections,
			refs.Plugin.Unloading:Connect(function()
				self:destroy()
			end)
		)
	end

	return self
end

function LimbPointSetup:validateSelection()
	local state = self.refs.State
	local timeline = state.Timeline
	if not timeline or not state.currentRig or self.refs.Active and not self.refs.Active() then
		return nil, "Add a rig first."
	end

	if timeline:IsExportLocked() or require("blenderEdit").blocked() or state.PhysicsSimulating then
		return nil, "Finish the current operation before setting up IK."
	end

	if not workspace.CurrentCamera then
		return nil, "No viewport camera is available."
	end
	if state.CameraPreview and state.CameraPreview.isFull() then
		return nil, "Exit Camera View before setting up IK."
	end
	local motor, rig = require("ikPanel").selection()
	if not motor or not rig then
		return nil, "Select a part in the timeline."
	end

	if
		typeof(motor) ~= "Instance"
		or not motor:IsA("Motor6D")
		or not motor.Part0
		or not motor.Part1
		or not motor.Part1:IsA("BasePart")
	then
		return nil, "Select a part connected by a Motor6D."
	end

	local entry = limbIk.getRig(rig)
	local existing = entry and entry.members[motor]
	if existing and not existing.points then
		return nil, "This limb already has IK. Use its FK / IK toggle."
	end

	return motor, rig
end

function LimbPointSetup:beginSetup()
	if self.session then
		return
	end

	local motor, rigOrMessage = self:validateSelection()
	if not motor then
		notify(rigOrMessage, 3)
		return
	end

	require("project").finalizeCurrentManipulation()
	local timeline = self.refs.State.Timeline
	local timelineState = timeline:GetState()
	timelineState.Playing = false

	local session = SetupSession.new(self, motor, rigOrMessage)
	self.session = session
	self.refs.State.LimbPointSetupActive = session
	local ok, started = pcall(session.start, session)
	if not ok or not started then
		session:close()
		if not ok then
			notify("Could not start the IK setup: " .. tostring(started))
		end
	end
end

function LimbPointSetup:sessionClosed(session)
	if self.session == session then
		self.session = nil
	end
end

function LimbPointSetup:applyPoints(motor, rig, pointA, pointB)
	if
		not motor.Parent
		or not rig.Parent
		or not motor.Part1
		or not motor.Part1.Parent
		or not motor:IsDescendantOf(rig)
	then
		notify("The limb was removed before the setup finished.")
		return
	end

	local state = self.refs.State
	local previousA = motor:GetAttribute(pointAAttribute)
	local previousB = motor:GetAttribute(pointBAttribute)

	local function refresh()
		limbIk.invalidate(rig)
		limbIk.clearLive()
		require("project").refreshTimelineAfterStructureChange()
		local timeline = state.Timeline
		if timeline and rig.Parent then
			timeline:ApplyPoseAtTime(rig, timeline:GetState().CurrentTime)
		end

		state.currentProjectSaved = false
	end

	local function write(valueA, valueB)
		if not motor.Parent or not rig.Parent then
			return
		end
		motor:SetAttribute(pointAAttribute, valueA)
		motor:SetAttribute(pointBAttribute, valueB)
		refresh()
	end

	local timeline = state.Timeline
	if not timeline or timeline:IsExportLocked() or motor:GetAttribute("EclipseDisabled") then
		return
	end
	local changed = typeof(previousA) ~= "Vector3"
		or typeof(previousB) ~= "Vector3"
		or (previousA - pointA).Magnitude > 0.0001
		or (previousB - pointB).Magnitude > 0.0001
	if not changed and limbIk.isEnabled(motor, timeline:GetState().CurrentTime) then
		return true
	end
	local function redo()
		write(pointA, pointB)
	end

	local function undo()
		write(previousA, previousB)
	end

	local history = require("history")
	local entries = {}
	local ok, why = pcall(function()
		history.capture(entries, function()
			if changed then
				redo()
				history.record(undo, redo, "Set up limb IK")
			end
			assert(limbIk.chain(rig, motor), "Could not register IK for this limb")
			if not limbIk.isEnabled(motor, timeline:GetState().CurrentTime) then
				timeline:SwitchIKAtCurrentTime(motor, rig)
				assert(
					limbIk.isEnabled(motor, timeline:GetState().CurrentTime),
					"Could not enable IK for this limb"
				)
			end
		end)
	end)
	if not ok then
		pcall(history.revertGroup, entries)
		if changed then
			pcall(undo)
		end
		notify(tostring(why))
		return
	end
	history.commitGroup("Set up limb IK", entries)
	return true
end

function LimbPointSetup:destroy()
	if self.destroyed then
		return
	end

	self.destroyed = true
	if self.session then
		self.session:close()
	end

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	if activeController == self then
		activeController = nil
	end
end

function LimbPointSetup.init(refs)
	if activeController then
		activeController:destroy()
	end

	activeController = LimbPointSetup.new(refs)
end

function LimbPointSetup.open()
	if activeController then
		activeController:beginSetup()
	end
end

return LimbPointSetup
]]></ProtectedString>
