					</Item>
					<Item class="ModuleScript" referent="RBX2170ACA8A9494B37A1ACA49E0C748BCB">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local random = Random.new()
local curveCache = {}

local directions = {
    Top = Vector3.yAxis,
    Bottom = -Vector3.yAxis,
    Front = -Vector3.zAxis,
    Back = Vector3.zAxis,
    Left = -Vector3.xAxis,
    Right = Vector3.xAxis,
}

local function sample(value, default, fraction)
    if typeof(value) == "NumberRange" then
        return value.Min + (value.Max - value.Min) * (fraction or random:NextNumber())
    end

    return typeof(value) == "number" and value or default
end

local function sequence(value, progress, default, noise)
    local valueType = typeof(value)

    if valueType ~= "NumberSequence" and valueType ~= "ColorSequence" then
        return value ~= nil and value or default
    end

    local keypoints = value.Keypoints
    local previous, following = keypoints[1], keypoints[#keypoints]

    for index = 2, #keypoints do
        if progress <= keypoints[index].Time then
            previous, following = keypoints[index - 1], keypoints[index]
            break
        end
    end

    local interval = math.max(following.Time - previous.Time, 1e-8)
    local alpha = math.clamp((progress - previous.Time) / interval, 0, 1)

    if valueType == "ColorSequence" then
        return previous.Value:Lerp(following.Value, alpha)
    end

    local result = previous.Value + (following.Value - previous.Value) * alpha
    local envelope = (previous.Envelope or 0)
        + ((following.Envelope or 0) - (previous.Envelope or 0)) * alpha

    return result + envelope * (noise or 0)
end

local function decode(encoded)
    if typeof(encoded) ~= "string" or #encoded < 48 or #encoded % 24 ~= 0 then
        return nil
    end

    if curveCache[encoded] then
        return curveCache[encoded]
    end

    local data = buffer.fromstring(encoded)
    local nodes = {}

    for offset = 0, #encoded - 24, 24 do
        local node = {}

        for component = 0, 5 do
            node[component + 1] = buffer.readf32(data, offset + component * 4)
        end

        table.insert(nodes, node)
    end

    curveCache[encoded] = nodes
    return nodes
end

local function bezier(startValue, firstControl, secondControl, endValue, alpha)
    local inverse = 1 - alpha

    return inverse ^ 3 * startValue
        + 3 * inverse ^ 2 * alpha * firstControl
        + 3 * inverse * alpha ^ 2 * secondControl
        + alpha ^ 3 * endValue
end

local function curve(encoded, progress)
    local nodes = decode(encoded)

    if not nodes then
        return progress
    end

    for index = 1, #nodes - 1 do
        local previous, following = nodes[index], nodes[index + 1]

        if progress <= following[1] then
            local minimum, maximum = 0, 1

            for _ = 1, 20 do
                local midpoint = (minimum + maximum) / 2
                local position = bezier(previous[1], previous[3], previous[5], following[1], midpoint)

                if position < progress then
                    minimum = midpoint
                else
                    maximum = midpoint
                end
            end

            local alpha = (minimum + maximum) / 2
            return 1 - bezier(previous[2], previous[4], previous[6], following[2], alpha)
        end
    end

    return 1 - nodes[#nodes][2]
end

local function mix(startValue, endValue, alpha)
    local valueType = typeof(startValue)

    if (valueType == "NumberSequence" or valueType == "ColorSequence") and typeof(endValue) == valueType then
        if alpha == 0 then
            return startValue
        elseif alpha == 1 then
            return endValue
        end
        local times = { [0] = true, [1] = true }
        for _, graph in { startValue, endValue } do
            for _, point in graph.Keypoints do
                times[point.Time] = true
            end
        end
        local ordered = {}
        for time in times do
            table.insert(ordered, time)
        end
        table.sort(ordered)
        local points = {}
        for _, time in ordered do
            local first = sequence(startValue, time)
            local last = sequence(endValue, time)
            if valueType == "ColorSequence" then
                table.insert(points, ColorSequenceKeypoint.new(time, first:Lerp(last, alpha)))
            else
                local envelopeA = sequence(startValue, time, 0, 1) - first
                local envelopeB = sequence(endValue, time, 0, 1) - last
                table.insert(points, NumberSequenceKeypoint.new(time,
                    first * (1 - alpha) + last * alpha,
                    math.max(0, envelopeA * (1 - alpha) + envelopeB * alpha)))
            end
        end
        while #points > 20 do
            local discard = 2
            local leastError = math.huge
            for index = 2, #points - 1 do
                local left, point, right = points[index - 1], points[index], points[index + 1]
                local weight = (point.Time - left.Time) / (right.Time - left.Time)
                local error
                if valueType == "ColorSequence" then
                    local estimate = left.Value:Lerp(right.Value, weight)
                    error = math.abs(estimate.R - point.Value.R) + math.abs(estimate.G - point.Value.G)
                        + math.abs(estimate.B - point.Value.B)
                else
                    error = math.abs(left.Value * (1 - weight) + right.Value * weight - point.Value)
                        + math.abs(left.Envelope * (1 - weight) + right.Envelope * weight - point.Envelope)
                end
                if error < leastError then
                    leastError = error
                    discard = index
                end
            end
            table.remove(points, discard)
        end
        return valueType == "ColorSequence" and ColorSequence.new(points) or NumberSequence.new(points)
    end

    if valueType == "number" then
        return startValue + (endValue - startValue) * alpha
    end

    if valueType == "Vector3"
        or valueType == "Vector2"
        or valueType == "Color3"
        or valueType == "CFrame"
    then
        return startValue:Lerp(endValue, alpha)
    end

    return alpha < 1 and startValue or endValue
end

local function setProperty(instance, property, value)
    if value == nil then
        return
    end

    if property == "Transparency" and typeof(value) == "number" then
        value = math.clamp(value, 0, 1)
    elseif property == "Range" then
        value = math.clamp(value, 0, 60)
    elseif property == "Brightness" or property == "Width0" or property == "Width1" then
        value = math.max(value, 0)
    elseif property == "Segments" then
        value = math.clamp(math.floor(value + 0.5), 1, 100)
    elseif property == "Angle" then
        value = math.clamp(value, 0, 180)
    end

    instance[property] = value
end

local function getCFrame(instance)
    if instance and instance:IsA("Attachment") then
        return instance.WorldCFrame
    elseif instance and instance:IsA("BasePart") then
        return instance.CFrame
    elseif instance and instance:IsA("Model") then
        return instance:GetPivot()
    end

    return CFrame.identity
end

local function cleanClone(instance)
    for _, child in instance:GetChildren() do
        local name = child.Name
        local isMetadata = name == "RenderTemplate"
            or name == "PartIcleProperties"
            or name == "GraphBlender"

        if isMetadata or child:IsA("LuaSourceContainer") then
            child:Destroy()
        end
    end
end

local function vector(attributes, prefix, default, progress, noise)
    return Vector3.new(
        sequence(attributes[prefix .. "X"], progress, default, noise),
        sequence(attributes[prefix .. "Y"], progress, default, noise),
        sequence(attributes[prefix .. "Z"], progress, default, noise)
    )
end

local function randomVector(minimum, maximum)
    local low = minimum:Min(maximum)
    local high = minimum:Max(maximum)
    return Vector3.new(
        random:NextNumber(low.X, high.X),
        random:NextNumber(low.Y, high.Y),
        random:NextNumber(low.Z, high.Z)
    )
end

local function rotation(angles)
    return CFrame.fromEulerAnglesXYZ(
        math.rad(angles.X),
        math.rad(angles.Y),
        math.rad(angles.Z)
    )
end

local runtimeAttribute = "EclipseEmitRuntime"

local function hideGeometry(instance)
    if instance:IsA("BasePart") then
        instance.Transparency = 1
    end
    for _, child in instance:GetDescendants() do
        if child:IsA("BasePart") or child:IsA("Decal") then
            child.Transparency = 1
        end
    end
end

local function closeBranch(branch)
    branch.finished = true
    for _, finish in branch.after do
        finish()
    end
    table.clear(branch.after)
end

local function isRuntime(instance)
    while instance do
        if instance:GetAttribute(runtimeAttribute) == true then
            return true
        end
        instance = instance.Parent
    end
    return false
end

return {
    runtimeAttribute = runtimeAttribute,
    isRuntime = isRuntime,
    sample = sample,
    sequence = sequence,
    decode = decode,
    curve = curve,
    mix = mix,
    setProperty = setProperty,
    getCFrame = getCFrame,
    cleanClone = cleanClone,
    hideGeometry = hideGeometry,
    closeBranch = closeBranch,
    vector = vector,
    randomVector = randomVector,
    rotation = rotation,
    random = random,
    ZERO = Vector3.zero,
    directions = directions,
}

]]></ProtectedString>
							<string name="ScriptGuid">{5E1A49EC-7E4A-429E-9BDC-23B97623CBCE}</string>
