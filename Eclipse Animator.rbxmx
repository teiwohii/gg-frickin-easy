					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local data = require("subtitleData")
local events = require("events")
local Renderer = require("Renderer")
local raw = require("rawState")
local subtitles = {}
local refs, gui, renderer, cameraRenderer, cameraSurface
local connections = {}
local unsubscribe
local membership
local appliedOrder
local rebuilding = false
local refreshToken
local entryCache, entryTracks, entryStarts, entryMembership

local function sortedEntries()
	local tracks = events.all()
	local changed = not entryCache
	local count = 0
	for rig, track in tracks do
		count += 1
		local old = entryTracks and entryTracks[track]
		if
			not old
			or old.rig ~= rig
			or old.parent ~= rig.Parent
			or old.revision ~= track.Revision
			or old.events ~= track.Events
			or old.id ~= track.DocumentId
		then
			changed = true
		end
	end

	if entryTracks and count ~= entryTracks.count then
		changed = true
	end

	if changed then
		entryCache = {}
		entryTracks = { count = count }
		for rig, track in tracks do
			entryTracks[track] = {
				rig = rig,
				parent = rig.Parent,
				revision = track.Revision,
				events = track.Events,
				id = track.DocumentId,
			}
			if not rig.Parent then
				continue
			end

			for id, event in track.Events do
				if event.Subtitle then
					table.insert(entryCache, {
						id = track.DocumentId .. ":" .. id,
						track = track,
						event = event,
						rig = rig,
					})
				end
			end
		end

		table.sort(entryCache, function(a, b)
			if a.event.Subtitle.Order ~= b.event.Subtitle.Order then
				return a.event.Subtitle.Order < b.event.Subtitle.Order
			end

			if a.event.Frame ~= b.event.Frame then
				return a.event.Frame < b.event.Frame
			end

			return a.id < b.id
		end)
		local ids = {}
		entryStarts = {}
		for order, entry in entryCache do
			ids[order] = entry.id
			entryStarts[order] = {
				entry = entry,
				order = order,
				first = entry.event.Frame,
				last = entry.event.Frame + entry.event.Subtitle.Duration,
			}
		end

		table.sort(ids)
		entryMembership = table.concat(ids, "|")
		table.sort(entryStarts, function(a, b)
			return a.first < b.first
		end)
		local last = -math.huge
		for _, row in entryStarts do
			last = math.max(last, row.last)
			row.maxEnd = last
		end
	end

	return entryCache
end

local function activeEntries(frame)
	local low, high = 1, #entryStarts
	while low <= high do
		local mid = (low + high) // 2
		if entryStarts[mid].first <= frame then
			low = mid + 1
		else
			high = mid - 1
		end
	end

	local rows = {}
	local organization = require("organization")
	for i = high, 1, -1 do
		local row = entryStarts[i]
		if row.maxEnd <= frame then
			break
		end

		local entry = row.entry
		if
			row.last > frame
			and entry.event.Enabled ~= false
			and organization.isEnabled(entry.rig)
		then
			table.insert(rows, row)
		end
	end

	table.sort(rows, function(a, b)
		return a.order < b.order
	end)
	local entries = {}
	for i, row in rows do
		entries[i] = row.entry
	end

	return entries
end

function subtitles.entries(enabledOnly)
	local entries = {}
	for _, entry in sortedEntries() do
		if
			not enabledOnly
			or entry.event.Enabled ~= false and require("organization").isEnabled(entry.rig)
		then
			table.insert(entries, table.clone(entry))
		end
	end

	return entries
end

function subtitles.getRefs()
	return refs
end

function subtitles.buildRows(rig, baseItem)
	for _, track in table.clone(events.all()) do
		events.migrateSubtitles(track)
	end

	local items = {}
	for i, entry in subtitles.entries(false) do
		local row = rig.refs.Timeline:GetTrackTemplate():Clone()
		row.Name = "Subtitle_Track"
		local item = baseItem.initialize(
			rig.refs.RigItemTemplate:Clone(),
			"SUBTITLE",
			nil,
			row,
			false,
			entry.rig,
			"subtitles"
		)
		item.subtitleId = entry.event.Id
		item.subtitleIndex = i
		item.grandpa = item
		item.uiElement.Parent = rig.refs.RigListScroll
		item.uiElement.LayoutOrder = -1000 + i
		row.Parent = rig.refs.KeysRoot
		require("eventTrackList").bind(rig.refs.Timeline, item)
		table.insert(items, item)
	end

	rig._subtitleItems = items

	membership = entryMembership
	appliedOrder = entryCache
end

function subtitles.edit(track, id, callback, description, transient)
	local event = track and track.Events[id]
	if not event or not refs then
		return false
	end

	local before = events.snapshot(track)
	local draft = data.copy(event.Subtitle or {})
	callback(draft, event)
	event.Subtitle = data.copy(draft)
	if transient then
		track.Revision = (track.Revision or 0) + 1
		refs.State.currentProjectSaved = false
	else
		events.changed(track)
		refs.State.Timeline:RecordEventEdit(track, before, description or "Edit subtitle")
	end

	refs.State.Timeline:RefreshEventRows()
	subtitles.step()
	return true
end

function subtitles.add(rig, frame, preset)
	if not refs then
		return
	end

	if refs.Finalize then
		refs.Finalize()
	end

	local track = events.subtitleTrack()
	local before = events.snapshot(track)
	local event = events.create(track, frame)
	event.Name = "Subtitle"
	event.Markers = {}
	event.Subtitle = data.preset(preset or "Clean")
	event.Subtitle.Duration = raw.Timeline.FPS * 3
	track.Enabled = true
	events.changed(track)
	refs.State.Timeline:RecordEventEdit(track, before, "Add subtitle")
	if refs.RefreshStructure then
		refs.RefreshStructure()
	end

	refs.State.Timeline:RefreshEventRows()
	subtitles.step()
	return track, event
end

function subtitles.duplicate(track, id)
	local event = track.Events[id]
	if not event or not event.Subtitle then
		return
	end

	local before = events.snapshot(track)
	local new = events.create(track, event.Frame + event.Subtitle.Duration)
	new.Name = "Subtitle"
	new.Markers = {}
	new.Subtitle = data.copy(event.Subtitle)
	events.changed(track)
	refs.State.Timeline:RecordEventEdit(track, before, "Duplicate subtitle")
	if refs.RefreshStructure then
		refs.RefreshStructure()
	end

	refs.State.Timeline:RefreshEventRows()
	return new
end

function subtitles.remove(track, id)
	local event = track and track.Events[id]
	if not event or not refs then
		return
	end

	local only = #events.markers(event) == 0
		and #(event.Emits or {}) == 0
		and not require("soundData").has(event.Sounds)
		and event.CodeBegin == ""
		and event.CodeEnd == ""
	if only then
		refs.State.Timeline:DeleteEvent(track, id)
	else
		local before = events.snapshot(track)
		event.Subtitle = nil
		events.changed(track)
		refs.State.Timeline:RecordEventEdit(track, before, "Remove subtitle")
		refs.State.Timeline:RefreshEventRows()
	end

	subtitles.step()
end

function subtitles.commitInput(track, before)
	if not refs or events.all()[track.Rig] ~= track then
		return
	end

	events.changed(track)
	refs.State.Timeline:RecordEventEdit(track, before, "Edit subtitle")
end

function subtitles.jump(frame)
	if not refs then
		return
	end

	local timeline = refs.State.Timeline
	raw.Timeline.Playing = false
	raw.Timeline.CurrentTime = math.max(0, frame) / raw.Timeline.FPS
	if refs.State.currentRig then
		timeline:ApplyPoseAtTime(refs.State.currentRig, raw.Timeline.CurrentTime)
	end

	timeline:UpdatePlayhead()
	subtitles.step()
end

function subtitles.clear()
	if renderer then
		renderer:clear()
	end

	if cameraRenderer then
		cameraRenderer:clear()
	end
end

function subtitles.step()
	if not refs then
		return
	end

	local owner = refs
	local camera = require("cameraPreview")
	if refs ~= owner then
		return
	end
	local active = refs.ScreenGui.Parent
		and refs.ScreenGui.Enabled
		and (refs.Active() or camera.isFull())
	sortedEntries()
	local signature = entryMembership
	if active and membership == signature and refs.State.Rig and appliedOrder ~= entryCache then
		appliedOrder = entryCache
		local indices = {}
		for index, entry in sortedEntries() do
			indices[entry.id] = index
		end
		local changed = false
		for _, item in refs.State.Rig._subtitleItems or {} do
			local track = events.get(item.linkedRigInstance)
			local index = indices[track.DocumentId .. ":" .. item.subtitleId]
			if index and item.subtitleIndex ~= index then
				item.subtitleIndex = index
				item.uiElement.LayoutOrder = -1000 + index
				changed = true
			end
		end
		if changed then
			table.sort(refs.State.Rig._subtitleItems, function(a, b)
				return a.subtitleIndex < b.subtitleIndex
			end)
			require("hierarchy").refreshDynamic(refs.State.Rig)
		end
	end
	if
		active
		and membership ~= signature
		and not require("eventTrackList").isDragging()
		and not rebuilding
		and not refs.State.LoadingProject
		and refs.RefreshStructure
	then
		rebuilding = true
		local owner, token = refs, {}
		local project = owner.State.currentProjectSequence
		refreshToken = token
		task.defer(function()
			if refreshToken ~= token then
				return
			end

			local ok, issue = true, nil
			if
				refs == owner
				and owner.Active()
				and not require("eventTrackList").isDragging()
				and not owner.State.LoadingProject
				and owner.State.currentProjectSequence == project
			then
				sortedEntries()
				if membership ~= entryMembership then
					ok, issue = pcall(owner.RefreshStructure)
				end
			end

			if refreshToken == token then
				refreshToken = nil
				rebuilding = false
			end

			if not ok then
				warn("[Eclipse subtitles] " .. tostring(issue))
			end
		end)
	end

	local frame = raw.Timeline.CurrentTime * raw.Timeline.FPS
	local entries = active and activeEntries(frame) or {}
	if #entries == 0 then
		subtitles.clear()
		return
	end

	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = "EclipseSubtitleOverlay"
		gui:SetAttribute("EclipseOwnedUI", true)
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = refs.ScreenGui.DisplayOrder - 1
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = refs.ScreenGui.Parent
		renderer = Renderer.new(gui)
	end

	renderer:step(
		entries,
		frame,
		raw.Timeline.FPS,
		not raw.Timeline.Playing and require("subtitleEditor").isOpen() and os.clock() or nil
	)
	local surface = camera.subtitleSurface()
	if surface ~= cameraSurface then
		if cameraRenderer then
			cameraRenderer:destroy()
			cameraRenderer = nil
		end

		cameraSurface = surface
		if surface then
			cameraRenderer = Renderer.new(surface)
		end
	end

	if cameraRenderer then
		cameraRenderer:step(entries, frame, raw.Timeline.FPS)
	end
end

function subtitles.destroy()
	refreshToken = nil
	rebuilding = false
	require("eventTrackList").clear()
	require("subtitleEditor").close(true)
	for _, c in connections do
		c:Disconnect()
	end

	table.clear(connections)
	if unsubscribe then
		unsubscribe()
		unsubscribe = nil
	end

	if renderer then
		renderer:destroy()
		renderer = nil
	end

	if cameraRenderer then
		cameraRenderer:destroy()
		cameraRenderer = nil
	end

	if gui then
		gui:Destroy()
		gui = nil
	end

	cameraSurface = nil
	refs = nil
	membership = nil
	appliedOrder = nil
	entryCache = nil
	entryTracks = nil
	entryStarts = nil
	entryMembership = nil
end

function subtitles.init(options)
	subtitles.destroy()
	refs = options
	options.State.Subtitles = subtitles
	local inputModule = require("userInputService")
	table.insert(
		connections,
		inputModule.InputBegan:Connect(function(input)
			if input.KeyCode == Enum.KeyCode.Escape and not inputModule:GetFocusedTextBox() then
				require("eventTrackList").escape(options.State.Timeline)
			end
		end)
	)
	table.insert(connections, game:GetService("RunService").RenderStepped:Connect(subtitles.step))
	table.insert(connections, options.ScreenGui.Destroying:Once(subtitles.destroy))
	table.insert(connections, options.Plugin.Unloading:Once(subtitles.destroy))
	table.insert(
		connections,
		options.ScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not options.ScreenGui.Enabled then
				require("subtitleEditor").close(true)
				subtitles.clear()
			end
		end)
	)
	unsubscribe = events.subscribe(subtitles.step)
end

return subtitles
]]></ProtectedString>
						<string name="ScriptGuid">{7C6959F7-349B-4045-98B4-CDD78C25CDCD}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">subtitles</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX4837F4E5365448A7AE7E866E3710F84B">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local drawings = require(script:FindFirstAncestor("container").shared.drawing)
local motion = require("motion")
local userInputService = require("userInputService")
local httpService = game:GetService("HttpService")
local eventsModule = require("events")
local fxKeys = require("fxKeys")
local playbackModule = require("eventPlayback")
local editorModule = require("editor")
local icons = require("eventIcons")
local soundData = require("soundData")
local legacyEvents = require("legacyEvents")
local history = require("history")
local theme = require("theme")
local state = require("rawState")
local tl = state.Timeline
local selected, rows, clipboard = {}, {}, {}
local activeTimeline

local function inside(gui, point)
	if not gui or not gui.Parent then
		return false
	end

	if not userInputService.isGuiPointCompatible(gui) then
		return false
	end

	local current = gui
	while current do
		if current:IsA("GuiObject") and not current.Visible then
			return false
		end

		if current:IsA("LayerCollector") and not current.Enabled then
			return false
		end

		current = current.Parent
	end

	local p, s = gui.AbsolutePosition, gui.AbsoluteSize
	return point.X >= p.X and point.X <= p.X + s.X and point.Y >= p.Y and point.Y <= p.Y + s.Y
end

local function modified()
	return userInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or userInputService:IsKeyDown(Enum.KeyCode.RightControl)
		or userInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or userInputService:IsKeyDown(Enum.KeyCode.RightShift)
end

return function(Timeline)
	function Timeline:RecordEventEdit(track, before, description)
		local after = eventsModule.snapshot(track)

		local function apply(snapshot)
			editorModule.close(self)
			eventsModule.restore(track, snapshot)
			table.clear(selected)
			self:RefreshEventRows()
			self:UpdateDeleteButtonState()
		end

		history.record(function()
			apply(before)
		end, function()
			apply(after)
		end, description)
	end

	function Timeline:DeleteEvent(track, id)
		editorModule.close(self)
		local event = track and track.Events[id]
		if not event then
			return false
		end

		local before = eventsModule.snapshot(track)
		track.Events[id] = nil
		selected[event] = nil
		eventsModule.changed(track)
		self:RecordEventEdit(track, before, "Delete event")
		self:RefreshEventRows()
		self:UpdateDeleteButtonState()
		return true
	end

	function Timeline:GetSelectedEvents()
		local result = {}
		for event, track in selected do
			if track.Events[event.Id] == event then
				table.insert(result, { event = event, track = track })
			end
		end

		return result
	end

	function Timeline:SelectEvent(track, event, additive)
		if not additive then
			self:ClearSelectedKeyframes()
		end

		if additive and selected[event] then
			selected[event] = nil
		else
			selected[event] = track
		end

		self:RefreshEventRows()
		self:UpdateDeleteButtonState()
	end

	function Timeline:AddEvent(rig, frame, openEditor, anchor)
		editorModule.close(self)
		local track = eventsModule.get(rig)
		frame = math.max(0, math.round(frame))
		for _, existing in track.Events do
			if existing.Frame == frame then
				self:SelectEvent(track, existing, false)
				if openEditor then
					self:OpenEventEditor(track, existing.Id, anchor)
				end

				return existing
			end
		end

		local before = eventsModule.snapshot(track)
		local event = eventsModule.create(track, frame)
		self:RecordEventEdit(track, before, "Add event")
		self:SelectEvent(track, event, false)
		self:EnsureTimelineEnd(event.Frame)
		if openEditor then
			self:OpenEventEditor(track, event.Id, anchor)
		end

		return event
	end

	function Timeline:ImportLegacyEvents(source, rig)
		if legacyEvents.isEmitTrack(source) then
			eventsModule.vfxDisabled()
			return false
		end

		local entries = legacyEvents.read(source, self:GetState().FPS)
		if not entries or not rig or not rig.Parent then
			return false
		end

		editorModule.close(self)
		local track = eventsModule.get(rig)
		local before = eventsModule.snapshot(track)
		local existing = {}
		for _, event in track.Events do
			existing[legacyEvents.fingerprint(event)] = true
		end

		local imported = {}
		local lastFrame = 0
		for _, entry in entries do
			local fingerprint = legacyEvents.fingerprint(entry)
			if existing[fingerprint] then
				continue
			end

			local event = table.clone(entry)
			event.Id = httpService:GenerateGUID(false)
			event.Frame = eventsModule.nextFrame(track, event.Frame)
			track.Events[event.Id] = event
			existing[fingerprint] = true
			table.insert(imported, event)
			lastFrame = math.max(lastFrame, event.Frame + event.Duration)
		end

		if #imported == 0 then
			return true, 0
		end

		playbackModule.disable(rig)
		eventsModule.changed(track)
		self:RecordEventEdit(track, before, "Import Moon events")
		self:ClearSelectedKeyframes()
		for _, event in imported do
			selected[event] = track
		end

		self:EnsureTimelineEnd(lastFrame)
		self:RefreshEventRows()
		self:UpdateDeleteButtonState()
		return true, #imported
	end

	function Timeline:OpenEventEditor(track, id, anchor)
		tl.Playing = false
		playbackModule.pause()
		local row = rows[track.Rig]
		local button = row and row.buttons[id]
		return editorModule.open(self, track, id, anchor or button and button.AbsolutePosition)
	end

	function Timeline:CloseEventEditor()
		editorModule.close(self)
	end

	function Timeline:EventFrameAtPoint(point)
		local scale = self.refs.Scale
		if not scale then
			return 0
		end

		local width = self:GetVisibleTimelineWidth()
		local pixelScale = scale.AbsoluteSize.X / math.max(1, width + 40)
		local origin = scale.AbsolutePosition.X + 20 * pixelScale
		local maxFrame = math.max(0, self:GetMaxFrame())
		local frame =
			math.floor((point.X - origin) / math.max(width * pixelScale, 1) * maxFrame + 0.5)
		if frame ~= frame then
			return 0
		end

		return math.clamp(frame, 0, maxFrame)
	end

	function Timeline:IsPointOverEventUI(point, allowEmptyLane)
		if require("faces").contains(point, allowEmptyLane) then
			return true
		end

		local editor = require("state").GraphEditor
		if editor and (editor.isInteracting() or editor.containsPoint(point)) then
			return true
		end

		if self._eventEditor and inside(self._eventEditor.window, point) then
			return true
		end

		if self._eventDrag then
			return true
		end

		for _, row in rows do
			if inside(row.item.uiElement, point) then
				return true
			end

			if inside(row.hitbox, point) then
				if not allowEmptyLane then
					return true
				end

				for _, marker in row.buttons do
					if inside(marker, point) then
						return true
					end
				end
			end
		end

		return false
	end

	function Timeline:CaptureKeyframeEventDrag()
		local entries, snapshots, moving = self:GetSelectedEvents(), {}, {}
		for _, entry in entries do
			entry.frame = entry.event.Frame
			snapshots[entry.track] = snapshots[entry.track] or eventsModule.snapshot(entry.track)
			moving[entry.event] = true
		end
		self._keyEventDrag = #entries > 0 and {
			entries = entries,
			snapshots = snapshots,
			moving = moving,
			offset = 0,
		} or nil
	end

	function Timeline:PreviewKeyframeEventDrag(offset)
		local drag = self._keyEventDrag
		if not drag then
			return offset
		end
		local first, last = math.huge, -math.huge
		for _, entry in drag.entries do
			first, last = math.min(first, entry.frame), math.max(last, entry.frame)
		end
		offset = math.clamp(offset, -first, math.max(self:GetMaxFrame(), last) - last)
		for _, entry in drag.entries do
			for _, other in entry.track.Events do
				if not drag.moving[other] and other.Frame == entry.frame + offset then
					return nil
				end
			end
		end
		for track in drag.snapshots do
			eventsModule.move(track, drag.entries, offset)
		end
		drag.offset = offset
		playbackModule.disable()
		self:RefreshEventRows()
		return offset
	end

	function Timeline:FinishKeyframeEventDrag(commit)
		local drag = self._keyEventDrag
		self._keyEventDrag = nil
		if not drag then
			return
		end
		if commit and drag.offset ~= 0 then
			for track, before in drag.snapshots do
				eventsModule.changed(track)
				self:RecordEventEdit(track, before, "Move events and keyframes")
			end
		else
			for _, entry in drag.entries do
				entry.event.Frame = entry.frame
			end
		end
		self:RefreshEventRows()
	end

	for _, name in { "_initiateKeyframeDrag", "_initiateChannelKeyframeDrag" } do
		local begin = Timeline[name]
		Timeline[name] = function(self, ...)
			begin(self, ...)
			if state.KeyframeDrag.draggingKeyframe then
				self:CaptureKeyframeEventDrag()
			end
		end
	end
	local cancelKeyDrag = Timeline.CancelTimelineKeyframeDrag
	function Timeline:CancelTimelineKeyframeDrag(...)
		self:FinishKeyframeEventDrag(false)
		return cancelKeyDrag(self, ...)
	end

	function Timeline:MoveSelectedEvents(offset)
		local groups, entries = {}, self:GetSelectedEvents()
		local minimum = math.huge
		for _, entry in entries do
			minimum = math.min(minimum, entry.event.Frame)
			entry.frame = entry.event.Frame
		end

		offset = math.max(-minimum, math.floor(offset + 0.5))
		if offset == 0 or minimum == math.huge then
			return
		end

		for _, entry in entries do
			groups[entry.track] = groups[entry.track] or eventsModule.snapshot(entry.track)
		end

		for track, before in groups do
			eventsModule.move(track, entries, offset)
			eventsModule.changed(track)
			playbackModule.disable()
			self:RecordEventEdit(track, before, "Move events")
		end

		self:RefreshEventRows()
	end

	function Timeline:BindEventRow(item)
		activeTimeline = self
		local rig = item.grandpa.linkedRigInstance
		self:UnbindEventRow(rig)
		local track = eventsModule.get(rig)
		local container = self:GetTrackKeyframesContainer(item.trackElement)
		if not container then
			return
		end

		local template = container:FindFirstChild("KeyframeTemplate")
		if template then
			template.Visible = false
		end

		local hitbox = Instance.new("TextButton")
		hitbox.Name = "EventHitbox"
		hitbox.Text = ""
		hitbox.Size = UDim2.fromScale(1, 1)
		hitbox.BackgroundTransparency = 1
		hitbox.BorderSizePixel = 0
		hitbox.ZIndex = 2
		hitbox.Parent = container
		local row = {
			item = item,
			container = container,
			hitbox = hitbox,
			buttons = {},
			connections = {},
			lastClick = 0,
		}
		rows[rig] = row
		local right = item.appearDetails.RightDiv
		local enabled = right:FindFirstChild("Disable")
		for _, button in right:GetChildren() do
			if button:IsA("GuiButton") then
				button.Visible = button == enabled
			end
		end

		local add = Instance.new("TextButton")
		add.Name = "AddEvent"
		add.Text = "+"
		add.Font = Enum.Font.GothamMedium
		add.TextSize = 17
		add.TextColor3 = Color3.fromRGB(216, 200, 233)
		add.BackgroundTransparency = 1
		add.BorderSizePixel = 0
		add.Size = enabled and enabled.Size or UDim2.fromOffset(18, 18)
		add.LayoutOrder = -2
		add.Parent = right
		add:SetAttribute("ThemeTxt", "Txt")
		local square = Instance.new("UIAspectRatioConstraint")
		square.AspectRatio = 1
		square.Parent = add
		item.disableButton, item.addEventButton = enabled, add
		table.insert(
			row.connections,
			add.MouseButton1Click:Connect(function()
				self:AddEvent(rig, self:TimeToFrame(self:GetState().CurrentTime), true)
			end)
		)
		if enabled then
			table.insert(
				row.connections,
				enabled.MouseButton1Click:Connect(function()
					editorModule.close(self)
					local current = eventsModule.get(rig)
					local before = eventsModule.snapshot(current)
					current.Enabled = not current.Enabled
					if not current.Enabled then
						playbackModule.disable(rig)
					end

					eventsModule.changed(current)
					self:RecordEventEdit(current, before, "Toggle events")
					self:RefreshEventRows()
				end)
			)
		end

		table.insert(
			row.connections,
			hitbox.MouseButton1Click:Connect(function()
				if self._selectionDragConsumed then
					row.lastClick = 0
					return
				end

				local now = os.clock()
				local point = userInputService:GetMouseLocation()
				local frame = self:EventFrameAtPoint(point)
				if
					now - row.lastClick <= 0.32
					and math.abs(frame - (row.lastFrame or -100)) <= 1
				then
					row.lastClick = 0
					self:AddEvent(rig, frame, true, point)
				else
					row.lastClick, row.lastFrame = now, frame
					if not modified() then
						self:ClearSelectedKeyframes()
					end
				end
			end)
		)
		self:RefreshEventRows()
	end

	function Timeline:UnbindEventRow(rig)
		local row = rows[rig]
		if not row then
			return
		end

		for _, connection in row.connections do
			connection:Disconnect()
		end

		rows[rig] = nil
	end

	function Timeline:BeginEventDrag(track, event, point)
		local row = rows[track.Rig]
		local now = os.clock()
		local double = row and row.lastEvent == event.Id and now - (row.lastEventClick or 0) <= 0.32
		if row then
			row.lastEvent, row.lastEventClick = event.Id, now
		end

		if double then
			self:SelectEvent(track, event, false)
			self:OpenEventEditor(track, event.Id)
			return
		end

		if modified() or not selected[event] then
			self:SelectEvent(track, event, modified())
		end

		if not selected[event] then
			return
		end

		local keys = self:GetSelectedKeyframesList()
		if #keys > 0 then
			self:_initiateKeyframeDrag(keys[1], true)
			return
		end
		for key, channels in tl.SelectedChannelKeyframes do
			local channel = next(channels)
			if channel then
				self:_initiateChannelKeyframeDrag(key, channel, true)
				return
			end
		end

		local entries, snapshots = {}, {}
		for _, entry in self:GetSelectedEvents() do
			table.insert(
				entries,
				{ event = entry.event, track = entry.track, frame = entry.event.Frame }
			)
			snapshots[entry.track] = snapshots[entry.track] or eventsModule.snapshot(entry.track)
		end

		local minimum, maximum = math.huge, -math.huge
		for _, entry in entries do
			minimum = math.min(minimum, entry.frame)
			maximum = math.max(maximum, entry.frame)
		end

		local limit = math.max(self:GetMaxFrame(), maximum)
		local drag = { point = point, entries = entries, snapshots = snapshots, changed = false }
		self._eventDrag = drag
		local moveConnection, endConnection

		local function finish()
			moveConnection:Disconnect()
			endConnection:Disconnect()
			self._eventDrag = nil
			if drag.changed then
				for current, before in snapshots do
					eventsModule.changed(current)
					self:RecordEventEdit(current, before, "Move events")
				end

				self:RefreshEventRows()
			end
		end

		moveConnection = userInputService.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement then
				return
			end

			local currentPoint = userInputService:GetMouseLocation()
			if not drag.changed and (currentPoint - point).Magnitude < 3 then
				return
			end

			local scale = self.refs.Scale
			local width = self:GetVisibleTimelineWidth()
			local pixelScale = scale.AbsoluteSize.X / math.max(1, width + 40)
			local offset = math.floor(
				(currentPoint.X - point.X) / math.max(width * pixelScale, 1) * limit + 0.5
			)
			offset = math.max(-minimum, math.min(offset, limit - maximum))
			for current in snapshots do
				eventsModule.move(current, entries, offset)
			end

			playbackModule.disable()
			drag.changed = true
			self:RefreshEventRows()
		end)
		endConnection = userInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				finish()
			end
		end)
		drag.finish = finish
	end

	function Timeline:RefreshEventRows()
		require("eventTrackList").refresh(self)
		require("faces").refresh(self)
		local last = eventsModule.lastFrame(false)
		if last and last > self:GetMaxFrame() then
			self:EnsureTimelineEnd(last)
		end

		for rig, row in rows do
			local track = eventsModule.get(rig)
			local button = row.item.disableButton
			if button then
				row.item.disabled = track.Enabled == false
				row.item:_repaintDisable()
			end

			for id, marker in row.buttons do
				if not track.Events[id] then
					marker:Destroy()
					row.buttons[id] = nil
				end
			end

			for id, event in track.Events do
				if
					event.Subtitle
					and #eventsModule.markers(event) == 0
					and #(event.Emits or {}) == 0
					and not soundData.has(event.Sounds)
					and event.CodeBegin == ""
					and event.CodeEnd == ""
				then
					if row.buttons[id] then
						row.buttons[id]:Destroy()
						row.buttons[id] = nil
					end

					continue
				end

				local marker = row.buttons[id]
				if not marker then
					marker = Instance.new("ImageButton")
					marker.Name = "Event_" .. id
					marker.Image = ""
					marker.BackgroundTransparency = 1
					marker.Size = UDim2.fromOffset(16, 16)
					marker.AnchorPoint = Vector2.new(0.5, 0.5)
					marker.ZIndex = 4
					marker.AutoButtonColor = false
					icons.attach(marker, "event")
					marker.Parent = row.container
					row.buttons[id] = marker
					marker.InputBegan:Connect(function(input)
						if
							input.UserInputType == Enum.UserInputType.MouseButton1
							and inside(marker, userInputService:GetMouseLocation())
						then
							local current = eventsModule.get(rig)
							if current.Events[id] then
								self:BeginEventDrag(
									current,
									current.Events[id],
									userInputService:GetMouseLocation()
								)
							end
						end
					end)
					marker.MouseEnter:Connect(function()
						if not selected[track.Events[id]] then
							marker.ImageColor3 = theme.get("KfH", state.Colors.KEYFRAME_HOVER_COLOR)
						end
					end)
					marker.MouseLeave:Connect(function()
						self:RefreshEventRows()
					end)
				end

				marker.ZIndex = 10 + math.max(0, math.floor(event.Frame))
				marker.Position = UDim2.new(0, self:FrameToVisibleX(event.Frame), 0.5, 0)
				marker.ImageColor3 = selected[event]
						and theme.get("KfS", state.Colors.KEYFRAME_SELECTED_COLOR)
					or theme.get("KfD", state.Colors.KEYFRAME_DEFAULT_COLOR)
				marker.ImageTransparency = track.Enabled and event.Enabled ~= false and 0 or 0.6
			end
		end
	end

	local clearSelection = Timeline.ClearSelectedKeyframes

	function Timeline:ClearSelectedKeyframes()
		table.clear(selected)
		clearSelection(self)
		self:RefreshEventRows()
	end

	for _, name in { "SetSelectedKeyframe", "SetSelectedKeyframes", "SetSelectedChannelKeyframe" } do
		local original = Timeline[name]
		Timeline[name] = function(self, ...)
			if not self._keyEventDrag then
				table.clear(selected)
			end
			original(self, ...)
			self:RefreshEventRows()
		end
	end

	local selectAll = Timeline.SelectAllKeyframes

	function Timeline:SelectAllKeyframes()
		selectAll(self)
		table.clear(selected)
		for _, track in eventsModule.all() do
			for _, event in track.Events do
				selected[event] = track
			end
		end

		self:RefreshEventRows()
		self:UpdateDeleteButtonState()
	end

	local updateDelete = Timeline.UpdateDeleteButtonState

	function Timeline:UpdateDeleteButtonState()
		updateDelete(self)
		local button = self:GetDeleteButton()
		if button and next(selected) then
			button.Visible = true
		end
	end

	local deleteKeys = Timeline.DeleteSelectedKeyframes

	function Timeline:DeleteSelectedKeyframes()
		editorModule.close(self)
		local targets, snapshots = self:GetSelectedEvents(), {}
		local removed = deleteKeys(self)
		for _, entry in targets do
			local track = entry.track
			snapshots[track] = snapshots[track] or eventsModule.snapshot(track)
			playbackModule.disable(track.Rig)
			track.Events[entry.event.Id] = nil
		end

		table.clear(selected)
		for track, before in snapshots do
			eventsModule.changed(track)
			self:RecordEventEdit(track, before, "Delete events")
		end

		self:RefreshEventRows()
		self:UpdateDeleteButtonState()
		return removed
	end

	local copiedExtras = false

	local function storeEvents(entries, base)
		table.clear(clipboard)
		for _, entry in entries do
			table.insert(clipboard, {
				rig = entry.track.Rig,
				data = eventsModule.snapshot({ Events = { [entry.event.Id] = entry.event } }).Events[entry.event.Id],
				offset = entry.event.Frame - base,
			})
		end
	end

	local function copyEvents(timeline, entries, motorBase)
		table.clear(clipboard)
		local base = motorBase
		for _, entry in entries do
			base = math.min(base, entry.event.Frame)
		end

		if base == math.huge then
			return false
		end

		for _, copied in tl._KeyframeClipboard or {} do
			copied.offsetFrame += motorBase - base
		end

		storeEvents(entries, base)
		return #clipboard > 0, base
	end

	local copyAll = Timeline.CopyAllKeyframes

	function Timeline:CopyAllKeyframes()
		local minimum, entries = math.huge, {}
		for _, bucket in tl.Keyframes do
			for _, key in bucket do
				minimum = math.min(minimum, key.Frame)
			end
		end

		for _, track in eventsModule.all() do
			for _, event in track.Events do
				table.insert(entries, { track = track, event = event })
			end
		end

		local count = copyAll(self)
		if count == 0 and #entries == 0 then
			return 0
		end

		if count == 0 then
			tl._KeyframeClipboard = {}
		end

		copyEvents(self, entries, minimum)
		return count + #clipboard
	end

	local pasteKeys = Timeline.PasteKeyframes
	local pasteFlipped = Timeline.PasteKeyframesFlipped

	local function paste(self, flipped, reverse, selectedTarget)
		editorModule.close(self)
		local span = 0
		for _, entry in tl._KeyframeClipboard or {} do
			span = math.max(span, entry.offsetFrame)
		end
		for _, entry in clipboard do
			span = math.max(span, entry.offset + (entry.data.Duration or 0))
		end
		local result
		if #(tl._KeyframeClipboard or {}) == 0 then
			result = false
			if #clipboard == 0 and not copiedExtras then
				require("notification").show(
					"PASTE KEYS",
					"Nothing is copied yet. Select keys and press "
						.. require("shortcuts").format("Copy")
						.. " first.",
					3,
					"KeyframeAction"
				)
			end
		elseif flipped then
			result = pasteFlipped(self, selectedTarget)
		else
			result = pasteKeys(self, reverse, selectedTarget, #clipboard > 0 and span or nil)
		end
		local snapshots, pasted = {}, {}
		local anchor = self:TimeToFrame(tl.CurrentTime)
		for _, entry in clipboard do
			local track = eventsModule.all()[entry.rig]
			if not track then
				continue
			end

			snapshots[track] = snapshots[track] or eventsModule.snapshot(track)
			local event = table.clone(entry.data)
			event.Sounds = soundData.copy(entry.data.Sounds)
			event.Emits = require("clipboardRows").copy(entry.data.Emits)
			event.Subtitle = require("subtitleData").copy(entry.data.Subtitle)
			event.Markers = eventsModule.markers(entry.data)
			event.Id, event.Frame =
				httpService:GenerateGUID(false),
				eventsModule.nextFrame(
					track,
					anchor
						+ (reverse and span - entry.offset - (event.Duration or 0) or entry.offset)
				)
			track.Events[event.Id] = event
			pasted[event] = track
		end

		if next(pasted) then
			table.clear(selected)
			for event, track in pasted do
				selected[event] = track
			end

			for track, before in snapshots do
				eventsModule.changed(track)
				self:RecordEventEdit(track, before, "Paste events")
			end

			self:RefreshEventRows()
			self:UpdateDeleteButtonState()
			return true
		end

		return result
	end

	function Timeline:PasteKeyframes(reverse, selectedTarget)
		return history.batch(reverse and "Paste reversed" or "Paste keys", function()
			return paste(self, false, reverse, selectedTarget)
		end)
	end

	function Timeline:PasteKeyframesFlipped(selectedTarget)
		return history.batch("Paste flipped", function()
			return paste(self, true, false, selectedTarget)
		end)
	end

	local beginBox = Timeline.BeginKeyframeBoxSelection

	function Timeline:BeginKeyframeBoxSelection(additive)
		self._selectionBaseEvents = additive and table.clone(selected) or {}
		if not additive then
			table.clear(selected)
		end

		beginBox(self, additive)
		self:RefreshEventRows()
	end

	local boxSelect = Timeline.SelectKeyframesInSelectionBox

	function Timeline:SelectKeyframesInSelectionBox(point)
		local changed = boxSelect(self, point)
		local previous = selected
		selected = table.clone(self._selectionBaseEvents or {})
		local minX, minY, maxX, maxY = self:GetSelectionBounds(point)
		local scale = self.refs.Scale
		if minX and scale then
			for rig, row in rows do
				local track = eventsModule.get(rig)
				for id, marker in row.buttons do
					local center = marker.AbsolutePosition + marker.AbsoluteSize * 0.5
					local p = (center - scale.AbsolutePosition) / motion.scale(scale)
					if
						inside(marker, center)
						and p.X >= minX
						and p.X <= maxX
						and p.Y >= minY
						and p.Y <= maxY
					then
						selected[track.Events[id]] = track
					end
				end
			end
		end

		local eventChanged = false
		for event in selected do
			if not previous[event] then
				eventChanged = true
				break
			end
		end

		if not eventChanged then
			for event in previous do
				if not selected[event] then
					eventChanged = true
					break
				end
			end
		end

		if eventChanged then
			self:RefreshEventRows()
		end

		if changed or eventChanged then
			self:UpdateDeleteButtonState()
		end
	end

	for _, name in
		{
			"RefreshTimelineScale",
			"RebuildAllTimelineKeyframeButtons",
			"RefreshAllKeyframeVisuals",
		}
	do
		local original = Timeline[name]
		Timeline[name] = function(self, ...)
			local result = original(self, ...)
			self:RefreshEventRows()
			return result
		end
	end

	local hasKeys = Timeline.HasAnyKeyframes

	function Timeline:HasAnyKeyframes()
		return hasKeys(self)
			or fxKeys.lastFrame() ~= nil
			or eventsModule.lastFrame(false) ~= nil
			or tl.GreaseDrawings and #tl.GreaseDrawings.layers > 0
			or false
	end

	local lastFrame = Timeline.GetLastKeyframeFrame

	local function playableEventSpan()
		local organization = require("organization")
		local last
		for _, track in eventsModule.all() do
			local trackEnabled = eventsModule.isEnabled(track)
			local rigEnabled = trackEnabled or organization.isEnabled(track.Rig)
			for _, event in track.Events do
				if event.Enabled == false or not rigEnabled then
					continue
				end

				local span = event.Subtitle and event.Subtitle.Duration or 0
				if trackEnabled then
					span = math.max(span, event.Duration or 0)
				elseif not event.Subtitle then
					continue
				end

				last = math.max(last or 0, event.Frame + span)
			end
		end

		return last
	end

	function Timeline:GetLastKeyframeFrame(playback)
		local playable = playback == true
		local key, event = lastFrame(self), eventsModule.lastFrame(playable, false)
		local effect = fxKeys.lastFrame()
		if effect then key = math.max(key or 0, effect) end
		if playable then
			local span = playableEventSpan()
			if span then
				event = math.max(event or 0, span)
			end
		end
		if tl.GreaseDrawings and #tl.GreaseDrawings.layers > 0 then
			key = math.max(key or 0, drawings.lastFrame(tl.GreaseDrawings))
		end

		if key == nil then
			return event
		end

		return math.max(key, event or 0)
	end

	local allFrames = Timeline.GetAllKeyframeFrames

	function Timeline:GetAllKeyframeFrames()
		local result, included = allFrames(self), {}
		for _, frame in result do
			included[frame] = true
		end
		for _, key in fxKeys.list() do
			if not included[key.Frame] then
				table.insert(result, key.Frame)
				included[key.Frame] = true
			end
		end

		for _, track in eventsModule.all() do
			for _, event in track.Events do
				if not included[event.Frame] then
					table.insert(result, event.Frame)
					included[event.Frame] = true
				end

				for _, key in event.Subtitle and event.Subtitle.Keys or {} do
					local f = event.Frame + key.Frame
					if not included[f] then
						included[f] = true
						table.insert(result, f)
					end
				end
			end
		end

		table.sort(result)
		return result
	end

	local clear = Timeline.ClearTimelineData

	function Timeline:ClearTimelineData()
		self:FinishKeyframeEventDrag(false)
		require("eventTrackList").clear()
		require("faces").clear()
		editorModule.close(self)
		if self._eventDrag then
			self._eventDrag.finish()
		end

		playbackModule.clear()
		for rig in rows do
			self:UnbindEventRow(rig)
		end

		table.clear(selected)
		eventsModule.clear()
		clear(self)
	end

	local function groupHistory(action)
		return history.batch(nil, action)
	end

	for _, name in
		{
			"DeleteSelectedKeyframes",
			"CutSelectedKeyframes",
			"PasteKeyframes",
			"MoveSelectedEvents",
		}
	do
		local action = Timeline[name]
		Timeline[name] = function(self, ...)
			editorModule.close(self)
			local args = table.pack(...)
			return groupHistory(function()
				return action(self, table.unpack(args, 1, args.n))
			end)
		end
	end

	theme.onChanged(function()
		if next(rows) and activeTimeline then
			activeTimeline:RefreshEventRows()
		end
	end)

	require("faces").install(Timeline)
	require("eventTrackList").install(Timeline)

	function Timeline:CopySelectedKeyframes()
		local facesModule, tracks = require("faces"), require("eventTrackList")
		local keys, keyBase = self:CaptureSelectedKeyframes()
		local events = self:GetSelectedEvents()
		local faces = facesModule.captureCopy()
		local base = keys and keyBase or math.huge
		for _, entry in events do
			base = math.min(base, entry.event.Frame)
		end

		for _, entry in faces do
			base = math.min(base, entry.frame)
		end

		if base == math.huge then
			local subtitle = tracks.captureCopy()
			if not subtitle then
				require("notification").show(
					"COPY",
					"Nothing is selected to copy. Your previous copy is still on the clipboard.",
					2,
					"KeyframeAction"
				)
				return false
			end

			tl._KeyframeClipboard = nil
			table.clear(clipboard)
			facesModule.setClipboard(nil)
			tracks.setClipboard(subtitle)
			copiedExtras = true
			return true
		end

		for _, entry in keys or {} do
			entry.offsetFrame += keyBase - base
		end

		tracks.setClipboard(nil)
		tl._KeyframeClipboard = keys or {}
		storeEvents(events, base)
		facesModule.setClipboard(faces, base)
		copiedExtras = next(faces) ~= nil
		return true, base
	end
end
