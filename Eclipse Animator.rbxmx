							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local PremiumGate = require(script.Parent.Parent.Premium.PremiumGate)

local PropertyFavorites = {}
PropertyFavorites.__index = PropertyFavorites

PropertyFavorites.shared = nil
PropertyFavorites.settingKey = "ArcPropertyFavorites"
PropertyFavorites.feature = "propertyFavorites"
PropertyFavorites.sectionTitle = "Favorites"
PropertyFavorites.mark = "\u{2605} "
PropertyFavorites.limit = 60
PropertyFavorites.labels = {
	add = "Add to Favorites",
	remove = "Remove from Favorites",
}

function PropertyFavorites.new(pluginObject)
	local self = setmetatable({}, PropertyFavorites)

	self.plugin = pluginObject
	self.names = {}
	self.lookup = {}
	self.listeners = {}

	self:load()

	return self
end

function PropertyFavorites.install(pluginObject)
	PropertyFavorites.shared = PropertyFavorites.new(pluginObject)

	return PropertyFavorites.shared
end

function PropertyFavorites.get()
	if not PropertyFavorites.shared then
		PropertyFavorites.shared = PropertyFavorites.new(nil)
	end

	return PropertyFavorites.shared
end

function PropertyFavorites:load()
	if not self.plugin then
		return
	end

	local success, stored = pcall(function()
		return self.plugin:GetSetting(PropertyFavorites.settingKey)
	end)

	if not success or typeof(stored) ~= "table" then
		return
	end

	for _, name in stored do
		if typeof(name) == "string" and not self.lookup[name] and #self.names < PropertyFavorites.limit then
			self.lookup[name] = true
			table.insert(self.names, name)
		end
	end
end

function PropertyFavorites:persist()
	if not self.plugin then
		return
	end

	pcall(function()
		self.plugin:SetSetting(PropertyFavorites.settingKey, self.names)
	end)
end

function PropertyFavorites:isUnlocked(): boolean
	return PremiumGate.get():isUnlocked(PropertyFavorites.feature)
end

function PropertyFavorites:has(name: string): boolean
	return self.lookup[name] == true and self:isUnlocked()
end

function PropertyFavorites:list(): { string }
	return if self:isUnlocked() then table.clone(self.names) else {}
end

function PropertyFavorites:getLabel(name: string): string
	local text = if self.lookup[name] and self:isUnlocked() then PropertyFavorites.labels.remove else PropertyFavorites.labels.add

	return PremiumGate.get():label(PropertyFavorites.feature, text)
end

function PropertyFavorites:decorate(name: string, label: string): string
	return if self:has(name) then PropertyFavorites.mark .. label else label
end

function PropertyFavorites:onChanged(listener: () -> ()): () -> ()
	table.insert(self.listeners, listener)

	return function()
		local index = table.find(self.listeners, listener)

		if index then
			table.remove(self.listeners, index)
		end
	end
end

function PropertyFavorites:notify()
	for _, listener in table.clone(self.listeners) do
		task.spawn(listener)
	end
end

function PropertyFavorites:toggle(name: string): boolean
	if self.lookup[name] then
		self.lookup[name] = nil
		table.remove(self.names, table.find(self.names, name))
	elseif #self.names < PropertyFavorites.limit then
		self.lookup[name] = true
		table.insert(self.names, name)
	end

	self:persist()
	self:notify()

	return self.lookup[name] == true
end

function PropertyFavorites:request(name: string): boolean
	if not PremiumGate.get():request(PropertyFavorites.feature) then
		return false
	end

	return self:toggle(name)
end

function PropertyFavorites:prioritize(entries)
	if not self:isUnlocked() then
		return entries
	end

	local first = {}
	local rest = {}

	for _, entry in entries do
		table.insert(if self.lookup[entry.name] then first else rest, entry)
	end

	if #first == 0 then
		return entries
	end

	table.move(rest, 1, #rest, #first + 1, first)

	return first
end

return PropertyFavorites
]]></ProtectedString>
							<string name="ScriptGuid">{3853C765-0161-4407-8A57-67952E8226CA}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">PropertyFavorites</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
