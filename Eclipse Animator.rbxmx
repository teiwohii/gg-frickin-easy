					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local cursorValue = {}
local input = game:GetService("UserInputService")
local blank = "rbxasset://textures/Blank.png"
local owners = {}
local mice = {}
local previousVisible

function cursorValue.snapshot(mouse)
	local visible = previousVisible
	if visible == nil then
		visible = input.MouseIconEnabled
	end
	local entry = mouse and mice[mouse]
	local icon = entry and entry.icon or mouse and mouse.Icon
	return visible, icon
end

function cursorValue.hide(owner, mouse)
	if not owners[owner] then
		if next(owners) == nil then
			previousVisible = input.MouseIconEnabled
		end
		owners[owner] = { mouse = mouse }
		if mouse then
			local entry = mice[mouse]
			if not entry then
				entry = { icon = mouse.Icon, count = 0 }
				mice[mouse] = entry
			end
			entry.count += 1
		end
	end
	previousVisible = previousVisible or input.MouseIconEnabled
	local ok = pcall(function()
		input.MouseIconEnabled = false
		if mouse then
			mouse.Icon = blank
		end
	end)
	if not ok then
		cursorValue.release(owner)
	end
	return ok
end

function cursorValue.release(owner)
	local entry = owners[owner]
	if not entry then
		return
	end
	owners[owner] = nil
	local mouse = entry.mouse
	local saved = mouse and mice[mouse]
	if saved then
		saved.count -= 1
		if saved.count == 0 then
			mice[mouse] = nil
			pcall(function()
				if mouse.Icon == blank then
					mouse.Icon = saved.icon
				end
			end)
		end
	end
	if next(owners) == nil then
		local visible = previousVisible or input.MouseIconEnabled
		previousVisible = nil
		pcall(function()
			input.MouseIconEnabled = visible
		end)
	end
end

function cursorValue.isReady(cursor, pan)
	local image = pan and cursor.pan or cursor.orbit
	return image and (image.IsLoaded or cursor.fallback ~= nil)
end

local function icon(name, image, parent)
	local object = Instance.new("ImageLabel")
	object.Name = name
	object.BackgroundTransparency = 1
	object.BorderSizePixel = 0
	object.AnchorPoint = Vector2.new(0.5, 0.5)
	object.Size = UDim2.fromOffset(27, 27)
	object.Image = image
	object.ImageColor3 = Color3.new(1, 1, 1)
	object.ScaleType = Enum.ScaleType.Fit
	object.Active = false
	object.Interactable = false
	object.ZIndex = 4
	object.Parent = parent
	return object
end

function cursorValue.create(parent)
	local root = Instance.new("Frame")
	root.Name = "NavigationCursor"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = UDim2.fromOffset(0, 0)
	root.Active = false
	root.Interactable = false
	root.Parent = parent
	local orbit = icon("Orbit", "rbxassetid://85812029222497", root)
	local pan = icon("Pan", "rbxassetid://123202248396351", root)
	pan.Visible = false
	local fallback = Instance.new("Frame")
	fallback.Name = "Fallback"
	fallback.BackgroundTransparency = 1
	fallback.Size = UDim2.fromOffset(0, 0)
	fallback.Active = false
	fallback.Interactable = false
	fallback.Parent = root
	for _, size in { Vector2.new(3, 15), Vector2.new(15, 3) } do
		local bar = Instance.new("Frame")
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Size = UDim2.fromOffset(size.X, size.Y)
		bar.BackgroundColor3 = Color3.new(1, 1, 1)
		bar.BorderColor3 = Color3.new(0, 0, 0)
		bar.BorderSizePixel = 1
		bar.Active = false
		bar.Interactable = false
		bar.ZIndex = 4
		bar.Parent = fallback
	end
	local cursor = { root = root, pan = pan, orbit = orbit, fallback = fallback }
	cursorValue.setPan(cursor, false)
	return cursor
end

function cursorValue.setPan(cursor, pan)
	local image = pan and cursor.pan or cursor.orbit
	local ready = image.IsLoaded
	cursor.pan.Visible = pan and ready
	cursor.orbit.Visible = not pan and ready
	cursor.fallback.Visible = not ready
end

return cursorValue
]]></ProtectedString>
