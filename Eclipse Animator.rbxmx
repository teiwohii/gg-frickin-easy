							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)

local Builder = {}
Builder.__index = Builder

Builder.surfaceSize = Vector3.new(4, 0.2, 4)
Builder.attachmentName = "Point"
Builder.spawnDistance = 12

Builder.messages = {
	needsTarget = "Select a part or model first, then add the %s.",
	failed = "That could not be created.",
}

function Builder.new(context)
	local self = setmetatable({}, Builder)

	self.context = context
	self.asset = context.asset
	self.selection = context.selection
	self.history = context.history
	self.specs = context.specs
	self.palette = configuration.Create.Palette
	self.createdHandler = nil

	return self
end

function Builder:setCreatedHandler(handler: (({ Instance }) -> ())?)
	self.createdHandler = handler
end

function Builder:isGenerated(instance: Instance): boolean
	return instance:GetAttribute(configuration.Create.generatorAttribute) ~= nil
end

function Builder:getSelected(): Instance?
	local selected = self.selection:getFirst()

	if selected and selected:IsDescendantOf(workspace) and not self.asset:isBase(selected) then
		return selected
	end

	return nil
end

function Builder:getContainer(): Instance?
	local effects = self.asset:getEffects()
	local selected = self:getSelected()

	if not effects then
		return nil
	end

	if selected and selected ~= effects and selected:IsDescendantOf(effects) then
		local current = selected

		while current and current ~= effects do
			if current:IsA("Model") and not self:isGenerated(current) then
				return current
			end

			current = current.Parent
		end
	end

	return effects
end

function Builder:getPlacement(container: Instance?): CFrame
	local effects = self.asset:getEffects()

	if container and container ~= effects and container:IsA("Model") and container:FindFirstChildWhichIsA("BasePart", true) then
		return container:GetPivot()
	end

	return self:getSpawnPlacement()
end

function Builder:getSpawnPlacement(): CFrame
	local origin = self.asset:getOrigin()
	local camera = workspace.CurrentCamera

	if not camera then
		return origin
	end

	local view = camera.CFrame
	return CFrame.new(view.Position + view.LookVector * Builder.spawnDistance) * origin.Rotation
end

function Builder:getPartOf(instance: Instance?): BasePart?
	local current = instance

	while current and not current:IsA("BasePart") do
		if current:IsA("Model") or current == workspace then
			return nil
		end

		current = current.Parent
	end

	if current and current:IsA("BasePart") and not self.asset:isBase(current) then
		return current
	end

	return nil
end

function Builder:getPoint(instance: Instance?): Instance?
	if not instance then
		return nil
	end

	if instance:IsA("Attachment") or instance:IsA("BasePart") then
		return instance
	end

	local parent = instance.Parent

	if parent and (parent:IsA("Attachment") or parent:IsA("BasePart")) and not instance:IsA("Model") then
		return parent
	end

	return nil
end

function Builder:createHolder(container: Instance, cframe: CFrame, name: string?): BasePart
	local holder = Instance.new("Part")

	holder.Name = name or configuration.Create.holderName
	holder.Size = configuration.Create.holderSize
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.CastShadow = false
	holder.CFrame = cframe
	holder.Parent = container

	return holder
end

function Builder:createAttachment(parent: BasePart, name: string?, position: Vector3?): Attachment
	local attachment = Instance.new("Attachment")

	attachment.Name = name or Builder.attachmentName
	attachment.Position = position or Vector3.zero
	attachment.Parent = parent

	return attachment
end

function Builder:createSurface(container: Instance, cframe: CFrame): BasePart
	local part = Instance.new("Part")

	for name, value in self.palette.items.Part.properties do
		(part :: any)[name] = value
	end

	part.Name = "Surface"
	part.Material = Enum.Material.SmoothPlastic
	part.Size = Builder.surfaceSize
	part.CFrame = cframe
	part.Parent = container

	return part
end

function Builder:newInstance(item): Instance?
	local success, instance = pcall(Instance.new, item.className)

	if not success or not instance then
		return nil
	end

	instance.Name = item.name or item.className
	self.specs:setProperties(instance, item.properties)
	self.specs:setAttributes(instance, item.attributes)

	for _, childSpec in item.children or {} do
		local child = self.specs:build(childSpec)

		if child then
			child.Parent = instance
		end
	end

	return instance
end

function Builder:getSelectedAttachments(): { Attachment }
	local attachments = {}

	for _, instance in self.selection:get() do
		if instance:IsA("Attachment") then
			table.insert(attachments, instance)
		end
	end

	return attachments
end

function Builder:placePair(item, instance: Instance, container: Instance, placement: CFrame)
	local attachments = self:getSelectedAttachments()
	local first = attachments[1]
	local second = attachments[2]
	local host = nil

	if first and second then
		host = self:getPartOf(first) or first.Parent
	else
		local part = self:getPartOf(self:getSelected())

		if not part then
			part = self:createHolder(container, placement, item.name or item.className)
		end

		local offsets = item.offsets or { Vector3.new(0, 0, -2), Vector3.new(0, 0, 2) }

		first = self:createAttachment(part, "Start", offsets[1])
		second = self:createAttachment(part, "End", offsets[2])
		host = part
	end

	local target = instance :: any

	target.Attachment0 = first
	target.Attachment1 = second
	instance.Parent = host
end

function Builder:place(item, instance: Instance, container: Instance, placement: CFrame): boolean
	local selected = self:getSelected()
	local host = item.host

	if host == "world" then
		if instance:IsA("BasePart") then
			instance.CFrame = placement
		elseif instance:IsA("Model") then
			instance.WorldPivot = placement
		end

		instance.Parent = container

		return true
	elseif host == "point" then
		local point = self:getPoint(selected)

		if not point then
			point = self:createAttachment(self:createHolder(container, placement))
		end

		instance.Parent = point

		return true
	elseif host == "anywhere" then
		instance.Parent = self:getPoint(selected) or container

		return true
	elseif host == "part" then
		local part = self:getPartOf(selected) or self:createHolder(container, placement)

		instance.Parent = part

		return true
	elseif host == "basepart" then
		local part = self:getPartOf(selected)

		if not part then
			part = self:createSurface(container, placement)
			self.specs:setProperties(part, item.surface)
		end

		instance.Parent = part

		return true
	elseif host == "pair" then
		self:placePair(item, instance, container, placement)

		return true
	elseif host == "adornee" then
		if not selected or not selected:IsA("PVInstance") then
			return false
		end

		instance.Parent = selected

		return true
	end

	return false
end

function Builder:createInstance(item): Instance?
	local container = self:getContainer()

	if not container then
		return nil
	end

	local placement = self:getPlacement(container)
	local instance = self:newInstance(item)

	if not instance then
		self.context.notify(Builder.messages.failed)
		return nil
	end

	if not self:place(item, instance, container, placement) then
		instance:Destroy()
		self.context.notify(string.format(Builder.messages.needsTarget, item.label))
		return nil
	end

	if item.flipbook and self.context.flipbooks then
		self.context.flipbooks:initialize(instance, item.flipbook)
	end

	return instance
end

function Builder:createBlock(item): Instance?
	local container = self:getContainer()
	local spec = configuration.Create.Blocks.specs[item.block]

	if not container or not spec then
		return nil
	end

	local root = self.specs:build(spec)

	if not root then
		self.context.notify(Builder.messages.failed)
		return nil
	end

	if root:IsA("PVInstance") then
		root:PivotTo(self:getPlacement(container))
	end

	root.Parent = container

	return root
end

function Builder:createGenerator(item): Instance?
	local container = self:getContainer()
	local generators = self.context.generators

	if not container or not generators then
		return nil
	end

	return generators:create(item.generator, item.params, container, self:getPlacement(container), item.name)
end

function Builder:add(itemId: string): Instance?
	local item = self.palette.items[itemId]

	if not item or not self.context.suite:ensureAsset() then
		return nil
	end

	local created = self.history:run("Add " .. item.label, function()
		if item.kind == "instance" then
			return self:createInstance(item)
		elseif item.kind == "block" then
			return self:createBlock(item)
		elseif item.kind == "generator" then
			return self:createGenerator(item)
		end

		return nil
	end)

	if created then
		self.selection:set({ created })

		if self.createdHandler then
			self.createdHandler({ created })
		end
	end

	return created
end

function Builder:attachPair(target: Instance): boolean
	if not (target:IsA("Beam") or target:IsA("Trail")) then
		return false
	end

	local item = self.palette.items[target.ClassName]
	local part = self:getPartOf(target)

	if not part then
		self.context.notify("Put this on a part first, then create its points.")
		return false
	end

	self.history:run("Create Points", function()
		local offsets = item.offsets
		local beam = target :: any

		if not beam.Attachment0 then
			beam.Attachment0 = self:createAttachment(part, "Start", offsets[1])
		end

		if not beam.Attachment1 then
			beam.Attachment1 = self:createAttachment(part, "End", offsets[2])
		end
	end)

	return true
end

return Builder
]]></ProtectedString>
