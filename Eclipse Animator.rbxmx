						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local partPhysics = {}
partPhysics.__index = partPhysics

partPhysics.order = { "CanCollide", "CanQuery", "Anchored", "Massless" }
partPhysics.values = {
	CanCollide = false,
	CanQuery = false,
	Anchored = true,
	Massless = true,
}

function partPhysics.isLocked(name: any): boolean
	return partPhysics.values[name] ~= nil
end

function partPhysics.isPart(instance: any): boolean
	return typeof(instance) == "Instance" and instance:IsA("BasePart")
end

function partPhysics.owns(instance: any, name: any): boolean
	return partPhysics.values[name] ~= nil and partPhysics.isPart(instance)
end

function partPhysics.describe()
	return table.clone(partPhysics.values)
end

function partPhysics.resolve(rules: any)
	local resolved = table.clone(partPhysics.values)

	if typeof(rules) == "table" then
		for name in partPhysics.values do
			if typeof(rules[name]) == "boolean" then
				resolved[name] = rules[name]
			end
		end
	end

	return resolved
end

function partPhysics.apply(part: BasePart, rules): boolean
	local changed = false

	for _, name in partPhysics.order do
		local value = rules[name]

		if (part :: any)[name] ~= value then
			(part :: any)[name] = value
			changed = true
		end
	end

	return changed
end

function partPhysics.applyAll(root: Instance, rules: any): number
	local resolved = partPhysics.resolve(rules)
	local count = 0

	if partPhysics.isPart(root) and partPhysics.apply(root :: BasePart, resolved) then
		count += 1
	end

	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") and partPhysics.apply(descendant, resolved) then
			count += 1
		end
	end

	return count
end

function partPhysics.strip(instance: any, properties: any)
	if typeof(properties) ~= "table" or not partPhysics.isPart(instance) then
		return properties
	end

	local cleaned = nil

	for name in partPhysics.values do
		if properties[name] ~= nil then
			cleaned = cleaned or table.clone(properties)
			cleaned[name] = nil
		end
	end

	return cleaned or properties
end

return partPhysics
]]></ProtectedString>
							<string name="ScriptGuid">{57ECFF36-A326-4447-BAC9-E1147E8D7046}</string>
