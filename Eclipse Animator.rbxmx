									<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local rgb = Color3.fromRGB

local textures = {
	spark = "rbxasset://textures/particles/sparkles_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
	core = "rbxasset://textures/particles/explosion01_core_main.dds",
	implosion = "rbxasset://textures/particles/explosion01_implosion_main.dds",
	shockwave = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	puff = "rbxasset://textures/particles/explosion01_smoke_main.dds",
	glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	vortex = "rbxasset://textures/particles/forcefield_vortex_main.dds",
}

local function numbers(points)
	local keypoints = {}

	for _, point in points do
		table.insert(keypoints, NumberSequenceKeypoint.new(point[1], point[2], point[3] or 0))
	end

	return NumberSequence.new(keypoints)
end

local function colors(points)
	local keypoints = {}

	for _, point in points do
		table.insert(keypoints, ColorSequenceKeypoint.new(point[1], point[2]))
	end

	return ColorSequence.new(keypoints)
end

local function holder(name, children, size)
	return {
		class = "Part",
		name = name,
		properties = {
			Size = size or Vector3.new(1, 1, 1),
			Transparency = 1,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		},
		children = children,
	}
end

local function point(children, name)
	return { class = "Attachment", name = name or "Core", children = children }
end

local function emitter(name, properties, emitCount)
	local attributes = nil

	if emitCount then
		properties.Enabled = false
		attributes = { EmitCount = emitCount }
	end

	return { class = "ParticleEmitter", name = name, properties = properties, attributes = attributes }
end

local fadeOut = numbers({ { 0, 0 }, { 0.6, 0.2 }, { 1, 1 } })
local fadeInOut = numbers({ { 0, 1 }, { 0.2, 0.15 }, { 0.7, 0.4 }, { 1, 1 } })
local warm = colors({ { 0, rgb(255, 244, 196) }, { 0.4, rgb(255, 170, 40) }, { 1, rgb(230, 60, 20) } })
local cool = colors({ { 0, rgb(255, 255, 255) }, { 0.4, rgb(120, 200, 255) }, { 1, rgb(110, 60, 255) } })

local blocks = {}

blocks.textures = textures

blocks.textureList = {
	{ label = "Glow", image = textures.glow },
	{ label = "Spark", image = textures.spark },
	{ label = "Smoke", image = textures.smoke },
	{ label = "Puff", image = textures.puff },
	{ label = "Fire", image = textures.fire },
	{ label = "Core", image = textures.core },
	{ label = "Implosion", image = textures.implosion },
	{ label = "Shockwave", image = textures.shockwave },
	{ label = "Vortex", image = textures.vortex },
}

blocks.defaultEmitter = {
	Texture = textures.spark,
	Color = ColorSequence.new(rgb(255, 255, 255)),
	Size = numbers({ { 0, 0.4 }, { 0.3, 1 }, { 1, 0 } }),
	Transparency = fadeOut,
	Lifetime = NumberRange.new(0.6, 1),
	Speed = NumberRange.new(4, 8),
	SpreadAngle = Vector2.new(180, 180),
	Rotation = NumberRange.new(0, 360),
	Rate = 20,
	Drag = 2,
	LightEmission = 1,
	LightInfluence = 0,
}

blocks.defaultBeam = {
	Width0 = 1,
	Width1 = 1,
	Segments = 20,
	FaceCamera = true,
	LightEmission = 1,
	LightInfluence = 0,
	Color = ColorSequence.new(rgb(255, 255, 255)),
	Transparency = numbers({ { 0, 1 }, { 0.2, 0 }, { 0.8, 0 }, { 1, 1 } }),
}

blocks.defaultTrail = {
	Lifetime = 0.5,
	FaceCamera = true,
	LightEmission = 1,
	LightInfluence = 0,
	Color = ColorSequence.new(rgb(255, 255, 255)),
	Transparency = numbers({ { 0, 0 }, { 1, 1 } }),
	WidthScale = numbers({ { 0, 1 }, { 1, 0 } }),
}

blocks.specs = {
	Burst = holder("Burst", {
		point({
			emitter("Burst", {
				Texture = textures.spark,
				Color = warm,
				Size = numbers({ { 0, 0.7 }, { 1, 0 } }),
				Transparency = fadeOut,
				Lifetime = NumberRange.new(0.35, 0.6),
				Speed = NumberRange.new(12, 22),
				SpreadAngle = Vector2.new(180, 180),
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-180, 180),
				Drag = 4,
				LightEmission = 1,
				LightInfluence = 0,
				Rate = 0,
			}, 30),
		}),
	}),

	Glow = holder("Glow", {
		point({
			emitter("Glow", {
				Texture = textures.glow,
				Color = ColorSequence.new(rgb(140, 200, 255)),
				Size = numbers({ { 0, 0 }, { 0.15, 6 }, { 1, 5 } }),
				Transparency = fadeInOut,
				Lifetime = NumberRange.new(0.6, 0.6),
				Speed = NumberRange.new(0, 0),
				Rotation = NumberRange.new(0, 360),
				LockedToPart = true,
				LightEmission = 1,
				LightInfluence = 0,
				ZOffset = 1,
				Rate = 0,
			}, 1),
			{ class = "PointLight", name = "Light", properties = { Brightness = 3, Range = 14, Color = rgb(140, 200, 255), Shadows = false } },
		}),
	}),

	Sparks = holder("Sparks", {
		point({
			emitter("Sparks", {
				Texture = textures.spark,
				Color = colors({ { 0, rgb(255, 250, 210) }, { 1, rgb(255, 140, 40) } }),
				Size = numbers({ { 0, 0.3 }, { 1, 0 } }),
				Squash = numbers({ { 0, 1.5 }, { 1, 0.5 } }),
				Transparency = numbers({ { 0, 0 }, { 0.8, 0 }, { 1, 1 } }),
				Lifetime = NumberRange.new(0.4, 0.9),
				Speed = NumberRange.new(18, 30),
				SpreadAngle = Vector2.new(35, 35),
				Acceleration = Vector3.new(0, -40, 0),
				Drag = 1,
				EmissionDirection = Enum.NormalId.Top,
				Orientation = Enum.ParticleOrientation.VelocityParallel,
				LightEmission = 1,
				LightInfluence = 0,
				Rate = 0,
			}, 24),
		}),
	}),

	SmokePuff = holder("Smoke", {
		point({
			emitter("Smoke", {
				Texture = textures.puff,
				Color = colors({ { 0, rgb(200, 200, 200) }, { 1, rgb(60, 60, 66) } }),
				Size = numbers({ { 0, 2 }, { 1, 6 } }),
				Transparency = numbers({ { 0, 1 }, { 0.1, 0.4 }, { 1, 1 } }),
				Lifetime = NumberRange.new(1.2, 2),
				Speed = NumberRange.new(2, 5),
				SpreadAngle = Vector2.new(180, 180),
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-30, 30),
				Acceleration = Vector3.new(0, 2, 0),
				Drag = 2,
				LightEmission = 0,
				LightInfluence = 1,
				Rate = 0,
			}, 12),
		}),
	}),

	Aura = holder("Aura", {
		{
			class = "ParticleEmitter",
			name = "Aura",
			properties = {
				Texture = textures.glow,
				Color = cool,
				Size = numbers({ { 0, 0.9 }, { 1, 0 } }),
				Transparency = fadeInOut,
				Lifetime = NumberRange.new(1, 1.5),
				Speed = NumberRange.new(1.5, 3),
				SpreadAngle = Vector2.new(0, 0),
				EmissionDirection = Enum.NormalId.Top,
				Shape = Enum.ParticleEmitterShape.Cylinder,
				ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
				LockedToPart = true,
				LightEmission = 1,
				LightInfluence = 0,
				Rate = 24,
			},
		},
	}, Vector3.new(4, 0.5, 4)),

	Impact = holder("Impact", {
		point({
			emitter("Flash", {
				Texture = textures.glow,
				Color = ColorSequence.new(rgb(255, 240, 200)),
				Size = numbers({ { 0, 0 }, { 0.3, 10 }, { 1, 8 } }),
				Transparency = numbers({ { 0, 0.1 }, { 1, 1 } }),
				Lifetime = NumberRange.new(0.15, 0.15),
				Speed = NumberRange.new(0, 0),
				LockedToPart = true,
				LightEmission = 1,
				LightInfluence = 0,
				ZOffset = 1,
				Rate = 0,
			}, 1),
			emitter("Shockwave", {
				Texture = textures.shockwave,
				Color = ColorSequence.new(rgb(255, 255, 255)),
				Size = numbers({ { 0, 2 }, { 1, 14 } }),
				Transparency = numbers({ { 0, 0.2 }, { 1, 1 } }),
				Lifetime = NumberRange.new(0.35, 0.35),
				Speed = NumberRange.new(0.01, 0.01),
				EmissionDirection = Enum.NormalId.Top,
				Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
				LightEmission = 1,
				LightInfluence = 0,
				Rate = 0,
			}, 1),
			emitter("Sparks", {
				Texture = textures.spark,
				Color = warm,
				Size = numbers({ { 0, 0.35 }, { 1, 0 } }),
				Squash = numbers({ { 0, 1.5 }, { 1, 0.5 } }),
				Transparency = numbers({ { 0, 0 }, { 0.8, 0 }, { 1, 1 } }),
				Lifetime = NumberRange.new(0.3, 0.6),
				Speed = NumberRange.new(20, 34),
				SpreadAngle = Vector2.new(80, 80),
				Acceleration = Vector3.new(0, -50, 0),
				EmissionDirection = Enum.NormalId.Top,
				Orientation = Enum.ParticleOrientation.VelocityParallel,
				LightEmission = 1,
				LightInfluence = 0,
				Rate = 0,
			}, 20),
			emitter("Smoke", {
				Texture = textures.puff,
				Color = colors({ { 0, rgb(180, 180, 180) }, { 1, rgb(60, 60, 66) } }),
				Size = numbers({ { 0, 1.5 }, { 1, 5 } }),
				Transparency = numbers({ { 0, 1 }, { 0.1, 0.5 }, { 1, 1 } }),
				Lifetime = NumberRange.new(0.8, 1.4),
				Speed = NumberRange.new(3, 7),
				SpreadAngle = Vector2.new(90, 90),
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-40, 40),
				Drag = 3,
				EmissionDirection = Enum.NormalId.Top,
				LightEmission = 0,
				LightInfluence = 1,
				Rate = 0,
			}, 8),
		}),
	}),

	Energy = holder("Energy", {
		point({
			{
				class = "ParticleEmitter",
				name = "Vortex",
				properties = {
					Texture = textures.vortex,
					Color = cool,
					Size = numbers({ { 0, 3 }, { 1, 5 } }),
					Transparency = fadeInOut,
					Lifetime = NumberRange.new(1, 1),
					Speed = NumberRange.new(0, 0),
					Rotation = NumberRange.new(0, 360),
					RotSpeed = NumberRange.new(120, 200),
					LockedToPart = true,
					LightEmission = 1,
