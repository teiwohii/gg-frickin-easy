								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = require(script.Parent.ShapeKit)

local beamRing = {}

beamRing.id = "BeamRing"
beamRing.title = "Beam Ring"
beamRing.root = "Part"

beamRing.params = ShapeKit.join({
	{ name = "Radius", kind = "number", default = 5, min = 0.1, max = 200 },
	{ name = "Width", kind = "number", default = 1.5, min = 0, max = 50 },
	{ name = "Points", kind = "number", default = 4, min = 3, max = 16, integer = true, tip = "How many beams make up the ring. Four is already round." },
	{ name = "Upright", label = "Lay Flat", kind = "toggle", default = false, tip = "Off stands the ring up like a wall. On lays it flat like a disc." },
}, ShapeKit.beamParams())

function beamRing.build(kit, params)
	local points = math.clamp(math.round(params.Points), 3, 16)
	local step = math.pi * 2 / points
	local handle = 4 / 3 * math.tan(step / 4) * params.Radius
	local samples = {}

	for index = 1, points do
		local angle = (index - 1) * step
		local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))

		table.insert(samples, {
			position = radial * params.Radius,
			tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle)),
			normal = if params.Upright then radial else Vector3.yAxis,
			handle = handle,
			width = params.Width,
		})
	end

	kit:path(samples, { closed = true })
end

return beamRing
]]></ProtectedString>
								<string name="ScriptGuid">{00E794A2-05B2-4072-9262-2045804A47EC}</string>
