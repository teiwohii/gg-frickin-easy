					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local binding = {}

function binding.is(object)
	return typeof(object) == "Instance"
		and object:IsA("Model")
		and object:GetAttribute("EclipseEffectObject") == 1
		and object:GetAttribute("EffectKind") == "Afterimage"
end

function binding.validTarget(object)
	return typeof(object) == "Instance"
		and not binding.is(object)
		and (object:IsA("Model") or object:IsA("BasePart") or object:IsA("Bone") or object:IsA(
			"Motor6D"
		))
		and object:GetAttribute("EclipseEffectObject") ~= 1
end

function binding.owner(target, rigs)
	for _, owner in rigs do
		if binding.validTarget(owner) and (owner == target or target:IsDescendantOf(owner)) then
			return owner
		end
	end
end

function binding.selected(state)
	local item = state.Rig and state.Rig._lastClickedItem
	if item then
		local target = item.organizationKey or item.linkedRigInstance
		if binding.is(target) then
			return target
		end
		if binding.validTarget(target) and item.itemKind ~= "property" then
			return binding.owner(target, state.getAllRigs()) or target
		end
	end
	local target = require("selectedRig").resolve(state)
	return binding.validTarget(target) and (binding.owner(target, state.getAllRigs()) or target)
		or nil
end

function binding.save(model, target, rigs)
	assert(binding.validTarget(target), "Afterimage needs a rig or bone parent")
	local owner = binding.owner(target, rigs)
	assert(owner, "Afterimage target is not in this animation")
	local id = owner:GetAttribute("EclipseTrackId")
	if not id then
		id = game:GetService("HttpService"):GenerateGUID(false)
		owner:SetAttribute("EclipseTrackId", id)
	end
	model:SetAttribute("AfterimageOwnerId", id)
	model:SetAttribute("AfterimageTargetPath", require("paths").of(target, owner))
	local reference = model:FindFirstChild("AfterimageTarget")
	if not reference then
		reference = Instance.new("ObjectValue")
		reference.Name = "AfterimageTarget"
		reference.Parent = model
	end
	reference.Value = target
end

function binding.saved(model, rigs)
	local reference = model:FindFirstChild("AfterimageTarget")
	if
		reference
		and binding.validTarget(reference.Value)
		and binding.owner(reference.Value, rigs)
	then
		return reference.Value
	end
	local id, found = model:GetAttribute("AfterimageOwnerId"), nil
	for _, rig in rigs do
		if rig:GetAttribute("EclipseTrackId") == id then
			if found then
				return nil
			end  
			found = rig
		end
	end
	if found then
		local path = model:GetAttribute("AfterimageTargetPath")
		local ok, target = pcall(require("paths").resolve, found, path)
		if ok and binding.validTarget(target) then
			return target
		end
	end
end

function binding.target(model)
	 
	local parent = require("organization").parent(model)
	if binding.validTarget(parent) then
		return parent
	end
	return nil
end

function binding.naturalParent(model, entries, rigs)
	local target = binding.saved(model, rigs)
	return target and entries[target] and target or nil
end

function binding.validateMove(keys, parent, organization)
	for _, key in keys do
		if binding.is(key) and not binding.validTarget(parent) then
			return false, "Place afterimages directly under a rig or bone."
		end
	end
	return true
end

return binding
]]></ProtectedString>
