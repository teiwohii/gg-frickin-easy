						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local assetService = game:GetService("AssetService")

local configuration = require(script.Parent.Parent.Utility.configuration)
local valueCodec = require(script.Parent.Parent.Utility.valueCodec)
local assetId = require(script.Parent.Parent.Utility.assetId)
local emitStyle = require(script.Parent.Parent.Utility.emitStyle)

local PropertyAccess = {}
PropertyAccess.__index = PropertyAccess

PropertyAccess.assetPrefix = "rbxassetid://"
PropertyAccess.minimumScale = 0.01
PropertyAccess.tolerance = 0.0001

PropertyAccess.kinds = {
	number = "number",
	boolean = "toggle",
	string = "text",
	EnumItem = "choice",
	Color3 = "color",
	Vector3 = "vector3",
	Vector2 = "vector2",
	NumberRange = "range",
	NumberSequence = "sequence",
	ColorSequence = "gradient",
	UDim2 = "text",
}

local function isModel(instance: Instance): boolean
	return instance:IsA("Model")
end

local function isEmitter(instance: Instance): boolean
	return instance:IsA("ParticleEmitter")
end

local function emitAttribute(name: string)
	return {
		applies = isEmitter,
		get = function(instance: Instance)
			return emitStyle.getValue(instance, name)
		end,
		set = function(instance: Instance, value: number)
			local number = math.max(value, 0)

			instance:SetAttribute(name, if name == "EmitCount" then math.round(number) else number)
		end,
	}
end

local function isSound(instance: Instance): boolean
	return instance:IsA("Sound")
end

local function cueAttribute(name: string)
	return {
		applies = isSound,
		get = function(instance: Instance)
			local value = instance:GetAttribute(name)

			return if typeof(value) == "number" then value else 0
		end,
		set = function(instance: Instance, value: number)
			instance:SetAttribute(name, math.max(value, 0))
		end,
	}
end

PropertyAccess.virtual = {
	Position = {
		applies = isModel,
		get = function(instance: Model)
			return instance:GetPivot().Position
		end,
		set = function(instance: Model, value: Vector3)
			instance:PivotTo(CFrame.new(value) * instance:GetPivot().Rotation)
		end,
	},
	Orientation = {
		applies = isModel,
		get = function(instance: Model)
			local x, y, z = instance:GetPivot():ToOrientation()

			return Vector3.new(math.deg(x), math.deg(y), math.deg(z))
		end,
		set = function(instance: Model, value: Vector3)
			local rotation = CFrame.fromOrientation(math.rad(value.X), math.rad(value.Y), math.rad(value.Z))

			instance:PivotTo(CFrame.new(instance:GetPivot().Position) * rotation)
		end,
	},
	Scale = {
		applies = isModel,
		get = function(instance: Model)
			return instance:GetScale()
		end,
		set = function(instance: Model, value: number)
			instance:ScaleTo(math.max(value, PropertyAccess.minimumScale))
		end,
	},
	EmitCount = emitAttribute("EmitCount"),
	EmitDelay = emitAttribute("EmitDelay"),
	EmitDuration = emitAttribute("EmitDuration"),
	PlayDelay = cueAttribute("EmitDelay"),
	PlayLength = cueAttribute("EmitDuration"),
}

function PropertyAccess.new(history)
	local self = setmetatable({}, PropertyAccess)

	self.history = history
	self.schema = configuration.Create.Schema
	self.failedHandler = nil

	return self
end

function PropertyAccess:setFailedHandler(handler: ((string) -> ())?)
	self.failedHandler = handler
end

function PropertyAccess:getVirtual(instance: Instance, name: string)
	local entry = PropertyAccess.virtual[name]

	if entry and entry.applies(instance) then
		return entry
	end

	return nil
end

function PropertyAccess:read(instance: Instance, name: string): (boolean, any)
	local virtual = self:getVirtual(instance, name)

	if virtual then
		return pcall(virtual.get, instance)
	end

	return pcall(function()
		return (instance :: any)[name]
	end)
end

function PropertyAccess:normalizeAsset(text: string): string
	return assetId.normalize(text)
end

function PropertyAccess:applyMesh(meshPart: MeshPart, meshId: string)
	task.spawn(function()
		local success, result = pcall(function()
			return assetService:CreateMeshPartAsync(Content.fromUri(meshId))
		end)

		if not success or not result then
			if self.failedHandler then
				self.failedHandler("The mesh could not be loaded. Check the id and that you have access to it.")
			end

			return
		end

		if not meshPart.Parent then
			result:Destroy()
			return
		end

		self.history:run("Set Mesh", function()
			meshPart:ApplyMesh(result)
			meshPart.Size = result.Size
		end)

		result:Destroy()
	end)
end

function PropertyAccess:write(instance: Instance, name: string, value): boolean
	local virtual = self:getVirtual(instance, name)

	if virtual then
		return (pcall(virtual.set, instance, value))
	end

	if name == "MeshId" and instance:IsA("MeshPart") then
		if typeof(value) == "string" and value ~= "" and value ~= instance.MeshId then
			self:applyMesh(instance, value)
		end

		return true
	end

	return (pcall(function()
		(instance :: any)[name] = value
	end))
end

function PropertyAccess:getMeta(name: string)
	return self.schema.fields[name]
end

function PropertyAccess:getKind(name: string, value): string?
	local meta = self.schema.fields[name]

	if meta and meta.kind then
		if meta.kind == "instance" then
			return if value == nil or typeof(value) == "Instance" then "instance" else nil
		end

		return if typeof(value) == "string" then meta.kind else nil
	end

	return PropertyAccess.kinds[typeof(value)]
end

function PropertyAccess:getLabel(name: string): string
	local label = self.schema.labels[name]

	if label then
		return label
	end

	local spaced = string.gsub(name, "(%l)(%u)", "%1 %2")

	return spaced
end

function PropertyAccess:equals(a, b): boolean
	if typeof(a) ~= typeof(b) then
		return false
	end

	return valueCodec.equals(a, b, PropertyAccess.tolerance)
end

function PropertyAccess:getSections(instance: Instance)
	local schema = self.schema
	local sections = schema.classes[instance.ClassName]

	if not sections then
		for _, base in schema.bases do
			if instance:IsA(base) then
				sections = schema.classes[base]
				break
			end
		end
	end

	if not sections then
		return {}
	end

	local additions = schema.additions[instance.ClassName]

	if not additions then
		return sections
	end

	local merged = table.clone(sections)

	for _, addition in additions do
		local index = #merged + 1

		for position, section in merged do
			if section.title == addition.after then
				index = position + 1
				break
			end
		end

		table.insert(merged, index, addition)
	end

	return merged
end

function PropertyAccess:getPropertyNames(instance: Instance): { string }
	local names = {}

	for _, section in self:getSections(instance) do
		for _, name in section.properties do
			table.insert(names, name)
		end
	end

	return names
end

function PropertyAccess:withComponent(value, component: string, number: number)
	if typeof(value) == "Vector3" then
		return Vector3.new(
			if component == "X" then number else value.X,
			if component == "Y" then number else value.Y,
			if component == "Z" then number else value.Z
		)
	elseif typeof(value) == "Vector2" then
		return Vector2.new(if component == "X" then number else value.X, if component == "Y" then number else value.Y)
	elseif typeof(value) == "NumberRange" then
		local minimum = if component == "Min" then number else value.Min
		local maximum = if component == "Max" then number else value.Max

		if component == "Min" then
			maximum = math.max(maximum, minimum)
		else
			minimum = math.min(minimum, maximum)
		end

		return NumberRange.new(minimum, maximum)
	end

	return value
end

return PropertyAccess
]]></ProtectedString>
