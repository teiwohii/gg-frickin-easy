							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local ScreenAttach = require(script.Parent.Parent.Animation.ScreenAttach)

local ScreenEffects = {}
ScreenEffects.__index = ScreenEffects

ScreenEffects.sectionTitle = "Screen Effect"
ScreenEffects.previewText = "Preview"
ScreenEffects.stopText = "Stop"

ScreenEffects.defaults = {
	distance = 1.5,
	scale = Vector3.one,
	offset = Vector3.zero,
	rotation = Vector3.zero,
	start = 0,
	finish = 0,
}

ScreenEffects.tips = {
	attach = "Hold this part in front of the camera while the effect plays, so its particles and decals cover the screen.",
	distance = "How far in front of the camera the part sits, in studs.",
	scale = "1 fills the screen. Z keeps the part's own thickness.",
	offset = "Moves the part away from the middle of the screen, in studs.",
	rotation = "Turns the part in front of the camera, in degrees.",
	start = "Seconds into the animation when the part jumps to the screen.",
	finish = "Seconds into the animation when it goes back. 0 keeps it on screen until the end.",
	preview = "Hold the part in front of your camera now, to judge distance and scale. Click again to put it back.",
}

ScreenEffects.messages = {
	note = "The part is placed in front of the camera in the animator and in the exported effect.",
}

function ScreenEffects.new(context)
	local self = setmetatable({}, ScreenEffects)

	self.context = context
	self.history = context.history
	self.placer = ScreenAttach.new()
	self.records = {}
	self.connection = nil
	self.editing = false

	return self
end

function ScreenEffects:handles(instance: Instance): boolean
	return instance:IsA("BasePart") and not self.context.asset:isBase(instance)
end

function ScreenEffects:getSignature(instance: Instance): string
	return if ScreenAttach.isAttached(instance) then "screen" else ""
end

function ScreenEffects:finishEdit()
	if self.editing then
		self.editing = false
		self.history:finish()
	end
end

function ScreenEffects:set(targets: { Instance }, attribute: string, value, final: boolean)
	if not self.editing then
		self.editing = true
		self.history:begin("Edit Screen Effect")
	end

	for _, target in targets do
		if target.Parent then
			target:SetAttribute(attribute, value)
		end
	end

	if final then
		self:finishEdit()
	end
end

function ScreenEffects:setAttached(targets: { Instance }, attached: boolean)
	if not attached then
		self:stopPreview()
	end

	self:set(targets, ScreenAttach.attributes.enabled, if attached then true else nil, true)
end

function ScreenEffects:isPreviewing(): boolean
	return self.connection ~= nil
end

function ScreenEffects:stopPreview()
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end

	for part, record in self.records do
		if part.Parent then
			part.CFrame = record.cframe
			part.Size = record.size
		end
	end

	table.clear(self.records)
end

function ScreenEffects:place()
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	for part, record in self.records do
		if part.Parent and ScreenAttach.isAttached(part) then
			local cframe, size = self.placer:getPlacement(part, camera, record.size)

			part.CFrame = cframe
			part.Size = size
		end
	end
end

function ScreenEffects:startPreview(targets: { Instance })
	self:stopPreview()

	for _, target in targets do
		if target.Parent and ScreenAttach.isAttached(target) then
			local part = target :: BasePart

			self.records[part] = { cframe = part.CFrame, size = part.Size }
		end
	end

	if next(self.records) == nil then
		return
	end

	self.connection = runService.Heartbeat:Connect(function()
		self:place()
	end)

	self:place()
end

function ScreenEffects:togglePreview(targets: { Instance }, button: GuiObject?)
	if self:isPreviewing() then
		self:stopPreview()
	else
		self:startPreview(targets)
	end

	local label = button and button:FindFirstChild("Label")

	if label and label:IsA("TextLabel") then
		label.Text = if self:isPreviewing() then ScreenEffects.stopText else ScreenEffects.previewText
	end
end

function ScreenEffects:createField(targets: { Instance }, name: string, label: string, kind: string, attribute: string, default, tip: string, options)
	local first = targets[1]

	local function read()
		local value = first:GetAttribute(attribute)

		return if typeof(value) == typeof(default) then value else default
	end

	local field = {
		id = "Screen." .. name,
		label = label,
		kind = kind,
		keywords = "screen effect camera",
		tip = tip,
		value = read(),
		read = read,
		onChange = function(value, final, component)
			if value == nil then
				return
			end

			if component then
				value = self.context.access:withComponent(read(), component, value[component])
			end

			self:set(targets, attribute, value, final)
		end,
	}

	for key, value in options or {} do
		field[key] = value
	end

	return field
end

function ScreenEffects:getSections(targets: { Instance })
	local first = targets[1]

	if not first then
		return {}
	end

	for _, target in targets do
		if not self:handles(target) then
			return {}
		end
	end

	local names = ScreenAttach.attributes
	local defaults = ScreenEffects.defaults
	local tips = ScreenEffects.tips
	local attached = ScreenAttach.isAttached(first)

	local fields = {
		{
			id = "Screen.Attach",
			label = "Attach To Screen",
			kind = "toggle",
			keywords = "screen effect camera",
			tip = tips.attach,
			value = attached,
			read = function()
				return ScreenAttach.isAttached(first)
			end,
			onChange = function(value)
				self:setAttached(targets, value == true)
			end,
		},
	}

	if not attached then
		return {
			{ title = ScreenEffects.sectionTitle, key = "ScreenEffect.Off", after = true, collapsed = true, fields = fields },
		}
	end

	table.insert(fields, self:createField(targets, "Distance", "Distance", "number", names.distance, defaults.distance, tips.distance, { minimum = 0.1, range = { min = 0.2, max = 10 } }))
	table.insert(fields, self:createField(targets, "Scale", "Scale", "vector3", names.scale, defaults.scale, tips.scale))
	table.insert(fields, self:createField(targets, "Offset", "Offset", "vector3", names.offset, defaults.offset, tips.offset))
	table.insert(fields, self:createField(targets, "Rotation", "Rotation", "vector3", names.rotation, defaults.rotation, tips.rotation))
	table.insert(fields, self:createField(targets, "Start", "Start Time", "number", names.start, defaults.start, tips.start, { minimum = 0, range = { min = 0, max = 5 } }))

	local finish = self:createField(targets, "End", "End Time", "number", names.finish, defaults.finish, tips.finish, { minimum = 0, range = { min = 0, max = 5 } })

	finish.onChange = function(value, final)
		if value ~= nil then
			self:set(targets, names.finish, if value > 0 then value else nil, final)
		end
	end

	table.insert(fields, finish)
	table.insert(fields, { id = "Screen.Note", kind = "note", keywords = "screen effect camera", text = ScreenEffects.messages.note })

	return {
		{
			title = ScreenEffects.sectionTitle,
			key = "ScreenEffect",
			after = true,
			action = {
				text = if self:isPreviewing() then ScreenEffects.stopText else ScreenEffects.previewText,
				tip = tips.preview,
				callback = function(button)
					self:togglePreview(targets, button)
				end,
			},
			fields = fields,
		},
	}
end

function ScreenEffects:stop()
	self:finishEdit()
	self:stopPreview()
end

function ScreenEffects:destroy()
	self:stop()
end

return ScreenEffects
]]></ProtectedString>
