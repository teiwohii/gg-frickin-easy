						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local data = require("subtitleData")
local settings = require("projectData")
local presets = {}
local keyValue = "SubtitleCustomPresetsV1"
local function read()
	local value = settings.getSetting(keyValue)
	return type(value) == "table" and data.clone(value) or {}
end
function presets.isCustom(name)
	return type(name) == "string" and name:sub(1, 8) == "Custom: "
end
function presets.list()
	local list = {}
	local custom = read()
	local names = {}
	for name in custom do
		if presets.isCustom(name) then
			table.insert(names, name)
		end
	end
	table.sort(names)
	for _, name in names do
		table.insert(list, { Name = name })
	end
	for _, preset in data.presets do
		table.insert(list, preset)
	end
	return list
end
function presets.save(name, value)
	name = tostring(name):match("^%s*(.-)%s*$")
	assert(#name > 0 and #name <= 60, "Enter a preset name (1-60 characters).")
	local cue = data.copy(value)
	local style = data.clone(cue.Base)
	for _, key in { "Text", "Speaker", "Image", "Words" } do
		style[key] = nil
	end
	local all = read()
	local id = "Custom: " .. name
	all[id] = {
		Style = style,
		Entrance = cue.Entrance,
		Exit = cue.Exit,
		InFrames = cue.InFrames,
		OutFrames = cue.OutFrames,
	}
	settings.setSetting(keyValue, all)
	return id
end
function presets.remove(name)
	if not presets.isCustom(name) then
		return false
	end
	local all = read()
	if not all[name] then
		return false
	end
	all[name] = nil
	settings.setSetting(keyValue, all)
	return true
end
function presets.apply(name, previous)
	if not presets.isCustom(name) then
		return data.preset(name, previous)
	end
	local row = read()[name]
	local cue = data.copy(previous or {})
	if type(row) ~= "table" then
		return cue
	end
	local style = data.clone(row.Style)
	for _, key in { "Text", "Speaker", "Image", "Words" } do
		style[key] = data.clone(cue.Base[key])
	end
	cue.Base = data.style(style)
	cue.Preset = name
	cue.Entrance, cue.Exit = row.Entrance, row.Exit
	cue.InFrames, cue.OutFrames = row.InFrames, row.OutFrames
	return data.copy(cue)
end
return presets
]]></ProtectedString>
