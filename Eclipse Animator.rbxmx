						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)

local TextureCatalog = {}
TextureCatalog.__index = TextureCatalog

TextureCatalog.staticKind = "Static"
TextureCatalog.flipbookKind = "Flipbook"
TextureCatalog.meshKind = "Mesh"
TextureCatalog.kindOrder = { Static = 1, Flipbook = 2, Mesh = 3 }
TextureCatalog.meshText = "Mesh Flipbook"
TextureCatalog.framesText = "%d frames, %s grid."
TextureCatalog.meshFramesText = "%d frames at %d fps."
TextureCatalog.meshBehaviourText = "Plays once on a %s mesh each emit."
TextureCatalog.idSeparator = ", "
TextureCatalog.creditSeparator = ", "
TextureCatalog.keySeparator = "-"
TextureCatalog.tintSoftness = 0.55
TextureCatalog.white = Color3.new(1, 1, 1)
TextureCatalog.assetPrefix = "rbxassetid://"
TextureCatalog.otherGroup = "Other"
TextureCatalog.defaultBehaviour = "Once"
TextureCatalog.posterProgress = 0.35
TextureCatalog.minimumIdQuery = 5
TextureCatalog.layouts = {
	[1] = Enum.ParticleFlipbookLayout.None,
	[2] = Enum.ParticleFlipbookLayout.Grid2x2,
	[4] = Enum.ParticleFlipbookLayout.Grid4x4,
	[8] = Enum.ParticleFlipbookLayout.Grid8x8,
}
TextureCatalog.behaviourTexts = {
	Once = "Plays once over each particle's lifetime.",
	Loop = "Loops at %d frames per second.",
	Variants = "Each particle shows one random frame.",
}
TextureCatalog.staticText = "Single image."

function TextureCatalog.new(data, meshData, extras)
	local self = setmetatable({}, TextureCatalog)

	self.data = data or configuration.Create.Textures
	self.meshData = meshData or configuration.Create.MeshFlipbooks
	self.extras = extras or configuration.Create.TextureExtras
	self.entries = {}
	self.byKey = {}
	self.groups = {}
	self.familyGroups = {}
	self.counts = {
		[TextureCatalog.staticKind] = 0,
		[TextureCatalog.flipbookKind] = 0,
		[TextureCatalog.meshKind] = 0,
	}

	self:build()

	return self
end

function TextureCatalog:build()
	local data = self.data
	local groupOrder = {}

	for index, group in data.groups do
		groupOrder[group.name] = index

		for _, family in group.families do
			self.familyGroups[family] = group.name
		end
	end

	self:addPack(data)

	for _, pack in self.extras do
		for family, group in pack.families do
			self.familyGroups[family] = group
		end

		self:addPack(pack)
	end

	for _, record in self.meshData.entries do
		self:add(self:createMeshEntry(record))
	end

	table.sort(self.entries, function(first, second)
		if first.family ~= second.family then
			return first.family < second.family
		elseif first.kind ~= second.kind then
			return TextureCatalog.kindOrder[first.kind] < TextureCatalog.kindOrder[second.kind]
		end

		return first.number < second.number
	end)

	local used = {}

	for _, entry in self.entries do
		if not used[entry.group] then
			used[entry.group] = true
			table.insert(self.groups, entry.group)
		end
	end

	table.sort(self.groups, function(first, second)
		local firstOrder = groupOrder[first] or math.huge
		local secondOrder = groupOrder[second] or math.huge

		if firstOrder ~= secondOrder then
			return firstOrder < secondOrder
		end

		return first < second
	end)
end

function TextureCatalog:addPack(pack)
	for _, record in pack.static do
		self:add(self:createEntry(record, TextureCatalog.staticKind))
	end

	for _, record in pack.flipbooks do
		self:add(self:createEntry(record, TextureCatalog.flipbookKind))
	end
end

function TextureCatalog:createEntry(record, kind: string)
	local family = record[1]
	local number = record[2]
	local key = string.format("%d", record[3])
	local isFlipbook = kind == TextureCatalog.flipbookKind
	local grid = if isFlipbook then record[4] or 1 else 1
	local layout = TextureCatalog.layouts[grid]

	if not layout then
		grid = 1
		layout = TextureCatalog.layouts[1]
	end

	local behaviours = self.data.behaviours
	local behaviourName = if isFlipbook and behaviours[record[5]] then record[5] else TextureCatalog.defaultBehaviour
	local behaviour = behaviours[behaviourName]
	local frames = grid * grid
	local name = string.format("%s %d", family, number)
	local group = self.familyGroups[family] or TextureCatalog.otherGroup

	return {
		key = key,
		id = record[3],
		image = TextureCatalog.assetPrefix .. key,
		name = name,
		family = family,
		number = number,
		group = group,
		kind = kind,
		grid = grid,
		frames = frames,
		layout = layout,
		behaviour = behaviourName,
		mode = Enum.ParticleFlipbookMode[behaviour.mode],
		framerate = if isFlipbook and typeof(record[6]) == "number" then record[6] else behaviour.framerate,
		startRandom = behaviour.startRandom,
		poster = if frames > 1 and behaviourName == TextureCatalog.defaultBehaviour then math.floor(frames * TextureCatalog.posterProgress) else 0,
		search = string.lower(table.concat({ name, group, kind }, " ")),
	}
end

function TextureCatalog:pickKeys(frames: number, count: number): { number }
	local keys = {}
	local total = math.clamp(count, 1, math.max(frames, 1))

	for index = 0, total - 1 do
		table.insert(keys, math.floor(index * frames / total))
	end

	return keys
end

function TextureCatalog:claimKey(base: string): string
	local key = base
	local copy = 1

	while self.byKey[key] do
		copy += 1
		key = base .. TextureCatalog.keySeparator .. copy
	end

	return key
end

function TextureCatalog:toColor(value: any): Color3?
	if typeof(value) ~= "table" then
		return nil
	end

	return Color3.new(value[1], value[2], value[3])
end

function TextureCatalog:toTint(color: Color3?): Color3
	if not color then
		return TextureCatalog.white
	end

	local peak = math.max(color.R, color.G, color.B, 1)
	local flat = Color3.new(color.R / peak, color.G / peak, color.B / peak)

	return flat:Lerp(TextureCatalog.white, TextureCatalog.tintSoftness)
end

function TextureCatalog:createMeshEntry(record)
	local data = self.meshData
	local ids = {}
	local images = {}

	for _, id in record.ids do
		local text = string.format("%d", id)

		table.insert(ids, text)
		table.insert(images, TextureCatalog.assetPrefix .. text)
	end

	local frames = #ids
	local fps = record.fps or data.fps
	local keys = self:pickKeys(frames, data.keyFrames)
	local poster = math.min(math.floor(frames * TextureCatalog.posterProgress), frames - 1)
	local shape = record.shape or data.defaultShape
	local color = self:toColor(record.color)

	return {
		key = self:claimKey(ids[1]),
		id = record.ids[1],
		image = images[poster + 1],
		images = images,
		ids = ids,
		name = record.name,
		family = record.name,
		number = 0,
		group = record.group,
		kind = TextureCatalog.meshKind,
		grid = 1,
		frames = frames,
		layout = TextureCatalog.layouts[1],
		behaviour = TextureCatalog.defaultBehaviour,
		mode = Enum.ParticleFlipbookMode.OneShot,
		framerate = fps,
		fps = fps,
		startRandom = false,
		poster = poster,
		keys = keys,
		keyPoster = math.min(math.floor(#keys * TextureCatalog.posterProgress), #keys - 1),
		keyFps = #keys * fps / frames,
		shape = shape,
		shapeLabel = data.shapes[shape] or string.lower(shape),
		color = color,
		tint = self:toTint(color),
		search = string.lower(table.concat({ record.name, record.group, TextureCatalog.meshText }, " ")),
	}
end

function TextureCatalog:add(entry)
	if self.byKey[entry.key] then
		return
	end

	self.byKey[entry.key] = entry
	self.counts[entry.kind] += 1
	table.insert(self.entries, entry)
end

function TextureCatalog:getEntries()
	return self.entries
end

function TextureCatalog:get(key: string)
	return self.byKey[key]
end

function TextureCatalog:getGroups(): { string }
	return self.groups
end

function TextureCatalog:getCount(kind: string?): number
	if kind then
		return self.counts[kind] or 0
	end

	return #self.entries
end

function TextureCatalog:getCredit(): string
	local credits = { self.data.credit }

	for _, pack in self.extras do
		table.insert(credits, pack.credit)
	end

	table.insert(credits, self.meshData.credit)

	return table.concat(credits, TextureCatalog.creditSeparator)
end

function TextureCatalog:isFlipbook(entry): boolean
	return entry.kind == TextureCatalog.flipbookKind
end

function TextureCatalog:isMesh(entry): boolean
	return entry.kind == TextureCatalog.meshKind
end

function TextureCatalog:tokenize(query: string): { string }
	local tokens = {}

	for token in string.gmatch(string.lower(query), "%S+") do
		table.insert(tokens, token)
	end

	return tokens
end

function TextureCatalog:matchesToken(entry, token: string): boolean
	if string.find(entry.search, token, 1, true) then
		return true
	end

	return #token >= TextureCatalog.minimumIdQuery and string.match(token, "^%d+$") ~= nil and string.find(entry.key, token, 1, true) ~= nil
end

function TextureCatalog:matches(entry, filter): boolean
	if filter.kind and entry.kind ~= filter.kind then
		return false
	end

	if filter.group and entry.group ~= filter.group then
		return false
	end

	if filter.keys and not filter.keys[entry.key] then
		return false
	end

	if filter.tokens then
		for _, token in filter.tokens do
			if not self:matchesToken(entry, token) then
				return false
			end
		end
	end

	return true
end

function TextureCatalog:filter(filter, source)
	local results = {}

	for _, entry in source or self.entries do
		if self:matches(entry, filter) then
			table.insert(results, entry)
		end
	end

	return results
end

function TextureCatalog:resolve(keys: { string })
	local entries = {}

	for _, key in keys do
		local entry = self.byKey[key]

		if entry then
			table.insert(entries, entry)
		end
	end

	return entries
end

function TextureCatalog:getGridText(entry): string
	return string.format("%dx%d", entry.grid, entry.grid)
end

function TextureCatalog:getBadgeText(entry): string
	return if self:isMesh(entry) then TextureCatalog.meshKind else self:getGridText(entry)
end

function TextureCatalog:getIdText(entry): string
	return if entry.ids then table.concat(entry.ids, TextureCatalog.idSeparator) else entry.key
end

function TextureCatalog:getDetails(entry): { string }
	if self:isMesh(entry) then
		return {
			string.format(TextureCatalog.meshFramesText, entry.frames, entry.fps),
			string.format(TextureCatalog.meshBehaviourText, entry.shapeLabel),
			entry.group,
		}
	end

	local lines = {}

	if self:isFlipbook(entry) then
		table.insert(lines, string.format(TextureCatalog.framesText, entry.frames, self:getGridText(entry)))
	end

	table.insert(lines, self:getBehaviourText(entry))
	table.insert(lines, entry.group)

	return lines
end

function TextureCatalog:describe(entry): string
	if self:isMesh(entry) then
		return TextureCatalog.meshText
	end

	if not self:isFlipbook(entry) then
		return TextureCatalog.staticKind
	end

	return string.format("%s %s", TextureCatalog.flipbookKind, self:getGridText(entry))
end

function TextureCatalog:getBehaviourText(entry): string
	if not self:isFlipbook(entry) then
		return TextureCatalog.staticText
	end

	return string.format(TextureCatalog.behaviourTexts[entry.behaviour], entry.framerate)
end

return TextureCatalog
]]></ProtectedString>
							<string name="ScriptGuid">{52DD6458-31B5-4596-8A97-45E7808D9B38}</string>
