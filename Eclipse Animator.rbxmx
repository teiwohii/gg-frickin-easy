							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local assetService = game:GetService("AssetService")

local Serializer = require(script.Parent.Parent.Utility.Serializer)

local SpecBuilder = {}
SpecBuilder.__index = SpecBuilder

SpecBuilder.version = 1
SpecBuilder.referenceProperties = { "Attachment0", "Attachment1", "Adornee", "PrimaryPart" }
SpecBuilder.skippedProperties = { Position = true, Orientation = true, MeshId = true }
SpecBuilder.skippedAttributes = { ArcPreviewPivot = true }
SpecBuilder.skippedAttributePrefixes = { "ArcHideOriginal_", "ArcModern" }
SpecBuilder.unsupportedClasses = { UnionOperation = true, IntersectOperation = true, NegateOperation = true }

function SpecBuilder.new(access)
	local self = setmetatable({}, SpecBuilder)

	self.access = access
	self.serializer = Serializer.new(function()
		return nil
	end, function()
		return nil
	end)

	return self
end

function SpecBuilder:setProperties(instance: Instance, properties)
	for name, value in properties or {} do
		pcall(function()
			(instance :: any)[name] = value
		end)
	end
end

function SpecBuilder:setAttributes(instance: Instance, attributes)
	for name, value in attributes or {} do
		pcall(function()
			instance:SetAttribute(name, value)
		end)
	end
end

function SpecBuilder:createNode(spec): Instance?
	local success, instance = pcall(Instance.new, spec.class)

	if not success or not instance then
		return nil
	end

	instance.Name = spec.name or spec.class
	self:setProperties(instance, spec.properties)
	self:setAttributes(instance, spec.attributes)

	for _, child in spec.children or {} do
		local node = self:createNode(child)

		if node then
			node.Parent = instance
		end
	end

	return instance
end

function SpecBuilder:resolveNames(root: Instance, path: { string }): Instance?
	local current = root

	for _, name in path do
		current = current and current:FindFirstChild(name)
	end

	return current
end

function SpecBuilder:build(spec): Instance?
	local root = self:createNode(spec)

	if not root then
		return nil
	end

	for _, reference in spec.references or {} do
		local source = self:resolveNames(root, reference.path)
		local target = self:resolveNames(root, reference.target)

		if source and target then
			pcall(function()
				(source :: any)[reference.property] = target
			end)
		end
	end

	return root
end

function SpecBuilder:isSkippedAttribute(name: string): boolean
	if SpecBuilder.skippedAttributes[name] then
		return true
	end

	for _, prefix in SpecBuilder.skippedAttributePrefixes do
		if string.sub(name, 1, #prefix) == prefix then
			return true
		end
	end

	return false
end

function SpecBuilder:getIndexPath(root: Instance, target: Instance): { number }?
	if target ~= root and not target:IsDescendantOf(root) then
		return nil
	end

	local path = {}
	local current = target

	while current ~= root do
		local parent = current.Parent
		local index = table.find(parent:GetChildren(), current)

		table.insert(path, 1, index)
		current = parent
	end

	return path
end

function SpecBuilder:encodeNode(instance: Instance, root: Instance, origin: CFrame, report)
	if SpecBuilder.unsupportedClasses[instance.ClassName] then
		table.insert(report.skipped, instance)
		return nil
	end

	local node = { c = instance.ClassName, n = instance.Name, p = {}, a = {}, k = {}, r = {} }

	for _, name in self.access:getPropertyNames(instance) do
		if not SpecBuilder.skippedProperties[name] and not self.access:getVirtual(instance, name) and not table.find(SpecBuilder.referenceProperties, name) then
			local success, value = self.access:read(instance, name)

			if success and value ~= nil then
				local encoded = self.serializer:encode(value)

				if encoded then
					node.p[name] = encoded
				end
			end
		end
	end

	for name, value in instance:GetAttributes() do
		if not self:isSkippedAttribute(name) then
			local encoded = self.serializer:encode(value)

			if encoded then
				node.a[name] = encoded
			end
		end
	end

	if instance:IsA("BasePart") then
		node.o = { origin:ToObjectSpace(instance.CFrame):GetComponents() }
	elseif instance:IsA("Model") then
		node.o = { origin:ToObjectSpace(instance:GetPivot()):GetComponents() }
	elseif instance:IsA("Attachment") then
		node.o = { instance.CFrame:GetComponents() }
	end

	if instance:IsA("MeshPart") then
		node.m = instance.MeshId
	end

	for _, name in SpecBuilder.referenceProperties do
		local success, target = pcall(function()
			return (instance :: any)[name]
		end)

		if success and typeof(target) == "Instance" then
			local path = self:getIndexPath(root, target)

			if path then
				table.insert(node.r, { name, path })
			end
		end
	end

	for _, child in instance:GetChildren() do
		local childNode = self:encodeNode(child, root, origin, report)

		table.insert(node.k, childNode or false)
	end

	report.count += 1

	return node
end

function SpecBuilder:getPivot(instance: Instance): CFrame?
	if instance:IsA("PVInstance") then
		return instance:GetPivot()
	elseif instance:IsA("Attachment") then
		return instance.WorldCFrame
	end

	local ancestor = instance:FindFirstAncestorWhichIsA("PVInstance")

	if ancestor then
		return ancestor:GetPivot()
	end

	local parent = instance.Parent

	if parent and parent:IsA("Attachment") then
		return parent.WorldCFrame
	end

	return nil
end

function SpecBuilder:encode(roots: { Instance })
	local report = { skipped = {}, count = 0 }
	local origin = nil

	for _, root in roots do
		origin = origin or self:getPivot(root)
	end

	origin = origin or CFrame.identity

	local data = { v = SpecBuilder.version, roots = {} }

	for _, root in roots do
		local node = self:encodeNode(root, root, origin, report)

		if node then
			table.insert(data.roots, node)
		end
	end

	return data, report
end

function SpecBuilder:decodeCFrame(components): CFrame?
	if typeof(components) ~= "table" or #components < 12 then
		return nil
	end

	return CFrame.new(table.unpack(components))
end

function SpecBuilder:createEncoded(node): Instance?
	if node.c == "MeshPart" and typeof(node.m) == "string" and node.m ~= "" then
		local success, mesh = pcall(function()
			return assetService:CreateMeshPartAsync(Content.fromUri(node.m))
		end)

		if success and mesh then
			return mesh
		end
	end

	local success, instance = pcall(Instance.new, node.c)

	return if success then instance else nil
end

function SpecBuilder:buildNode(node, origin: CFrame, built): Instance?
	if typeof(node) ~= "table" or typeof(node.c) ~= "string" then
		return nil
	end

	local instance = self:createEncoded(node)

	if not instance then
		return nil
	end

	instance.Name = if typeof(node.n) == "string" then node.n else node.c

	for name, encoded in node.p or {} do
		local value = self.serializer:decode(encoded)

		if value ~= nil then
			pcall(function()
				(instance :: any)[name] = value
			end)
		end
	end

	for name, encoded in node.a or {} do
		local value = self.serializer:decode(encoded)

		if value ~= nil then
			pcall(function()
				instance:SetAttribute(name, value)
			end)
		end
	end

	local offset = self:decodeCFrame(node.o)

	if offset then
		if instance:IsA("BasePart") then
			instance.CFrame = origin * offset
		elseif instance:IsA("Attachment") then
			instance.CFrame = offset
		end
	end

	local children = {}

	for index, childNode in node.k or {} do
		local child = if childNode then self:buildNode(childNode, origin, built) else nil

		children[index] = child or false

		if child then
			child.Parent = instance
		end
	end

	if offset and instance:IsA("Model") then
		instance.WorldPivot = origin * offset
	end

	table.insert(built, { instance = instance, node = node, children = children })

	return instance
end

function SpecBuilder:followPath(entry, lookup, path): Instance?
	local current = entry

	for _, index in path do
		local child = current and current.children[index]

		current = if child then lookup[child] else nil
	end

	return if current then current.instance else nil
end

function SpecBuilder:buildEncoded(data, origin: CFrame): { Instance }
	local results = {}

	if typeof(data) ~= "table" or typeof(data.roots) ~= "table" then
		return results
	end

	for _, rootNode in data.roots do
		local built = {}
		local root = self:buildNode(rootNode, origin, built)

		if root then
			local lookup = {}

			for _, entry in built do
				lookup[entry.instance] = entry
			end

			local rootEntry = lookup[root]

			for _, entry in built do
				for _, reference in entry.node.r or {} do
					local target = self:followPath(rootEntry, lookup, reference[2])

					if target then
						pcall(function()
							(entry.instance :: any)[reference[1]] = target
						end)
					end
				end
			end

			table.insert(results, root)
		end
	end

	return results
end

return SpecBuilder
]]></ProtectedString>
