						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local MeshCatalog = {}
MeshCatalog.__index = MeshCatalog

MeshCatalog.otherGroup = "Other"
MeshCatalog.pathSeparator = " / "
MeshCatalog.infoSeparator = "  |  "
MeshCatalog.keySeparator = "-"
MeshCatalog.sortSeparator = "\n"
MeshCatalog.sizeText = "%s x %s x %s studs"
MeshCatalog.kinds = {
	MeshPart = "Mesh Part",
	SpecialMesh = "Special Mesh",
	Model = "Model",
	Part = "Part",
}

function MeshCatalog.new(root: Instance?)
	local self = setmetatable({}, MeshCatalog)

	self.root = root
	self.entries = {}
	self.byKey = {}
	self.groups = {}

	self:build()

	return self
end

function MeshCatalog:isAsset(instance: Instance): boolean
	if instance:IsA("BasePart") then
		return true
	end

	return instance:IsA("Model") and instance:FindFirstChildWhichIsA("BasePart", true) ~= nil
end

function MeshCatalog:formatName(raw: string): string
	local spaced = string.gsub(raw, "(%l)(%u)", "%1 %2")
	local numbered = string.gsub(spaced, "(%a)(%d)", "%1 %2")
	local trimmed = string.gsub(numbered, "^%s*(.-)%s*$", "%1")
	local name = string.gsub(trimmed, "^%l", string.upper)

	return if name == "" then raw else name
end

function MeshCatalog:formatNumber(value: number): string
	local text = string.gsub(string.format("%.1f", value), "%.0$", "")

	return text
end

function MeshCatalog:getKind(instance: Instance): string
	if instance:IsA("MeshPart") then
		return "MeshPart"
	elseif instance:IsA("Model") then
		return "Model"
	elseif instance:FindFirstChildWhichIsA("DataModelMesh") then
		return "SpecialMesh"
	end

	return "Part"
end

function MeshCatalog:getMeshId(instance: Instance): string
	local holder: any = instance

	if not instance:IsA("MeshPart") then
		holder = instance:FindFirstChildWhichIsA("SpecialMesh", true) or instance:FindFirstChildWhichIsA("MeshPart", true)
	end

	if not holder then
		return ""
	end

	return string.match(holder.MeshId, "%d+") or ""
end

function MeshCatalog:getExtents(instance: Instance): Vector3
	if instance:IsA("BasePart") then
		return instance.Size
	elseif instance:IsA("Model") then
		local _, size = instance:GetBoundingBox()

		return size
	end

	return Vector3.zero
end

function MeshCatalog:createRecord(source: Instance, group: string, path: string)
	local base = self:formatName(source.Name)
	local meshId = self:getMeshId(source)
	local separator = MeshCatalog.sortSeparator

	return {
		source = source,
		group = group,
		path = path,
		base = base,
		meshId = meshId,
		sortKey = string.lower(path) .. separator .. string.lower(base) .. separator .. meshId,
	}
end

function MeshCatalog:collect(container: Instance, group: string, path: string, records)
	for _, child in container:GetChildren() do
		if self:isAsset(child) then
			table.insert(records, self:createRecord(child, group, path))
		elseif child:IsA("Folder") then
			local childPath = if path == "" then child.Name else path .. MeshCatalog.pathSeparator .. child.Name

			self:collect(child, group, childPath, records)
		end
	end
end

function MeshCatalog:claimKey(base: string): string
	local key = base
	local copy = 1

	while self.byKey[key] do
		copy += 1
		key = base .. MeshCatalog.keySeparator .. copy
	end

	return key
end

function MeshCatalog:createEntry(record, number: number)
	local source = record.source
	local kind = self:getKind(source)
	local name = if number > 0 then string.format("%s %d", record.base, number) else record.base
	local location = if record.path == "" then record.group else record.group .. MeshCatalog.pathSeparator .. record.path
	local keyBase = if record.meshId ~= "" then record.meshId else location .. MeshCatalog.pathSeparator .. name

	return {
		key = self:claimKey(keyBase),
		name = name,
		base = record.base,
		number = number,
		group = record.group,
		path = record.path,
		location = location,
		source = source,
		kind = kind,
		kindLabel = MeshCatalog.kinds[kind],
		meshId = record.meshId,
		size = self:getExtents(source),
		search = string.lower(table.concat({ name, location, MeshCatalog.kinds[kind], record.meshId }, " ")),
	}
end

function MeshCatalog:add(entry)
	self.byKey[entry.key] = entry
	table.insert(self.entries, entry)
end

function MeshCatalog:build()
	local records = {}
	local root = self.root

	if root then
		for _, child in root:GetChildren() do
			if child:IsA("Folder") then
				self:collect(child, child.Name, "", records)
			elseif self:isAsset(child) then
				table.insert(records, self:createRecord(child, MeshCatalog.otherGroup, ""))
			end
		end
	end

	table.sort(records, function(first, second)
		if first.group ~= second.group then
			return first.group < second.group
		end

		return first.sortKey < second.sortKey
	end)

	local totals = {}
	local counters = {}
	local separator = MeshCatalog.sortSeparator

	for _, record in records do
		local id = record.group .. separator .. record.base

		totals[id] = (totals[id] or 0) + 1
	end

	local used = {}

	for _, record in records do
		local id = record.group .. separator .. record.base
		local number = 0

		if totals[id] > 1 then
			counters[id] = (counters[id] or 0) + 1
			number = counters[id]
		end

		self:add(self:createEntry(record, number))

		if not used[record.group] then
			used[record.group] = true
			table.insert(self.groups, record.group)
		end
	end
end

function MeshCatalog:getEntries()
	return self.entries
end

function MeshCatalog:get(key: string)
	return self.byKey[key]
end

function MeshCatalog:getGroups(): { string }
	return self.groups
end

function MeshCatalog:getCount(): number
	return #self.entries
end

function MeshCatalog:tokenize(query: string): { string }
	local tokens = {}

	for token in string.gmatch(string.lower(query), "%S+") do
		table.insert(tokens, token)
	end

	return tokens
end

function MeshCatalog:matches(entry, filter): boolean
	if filter.group and entry.group ~= filter.group then
		return false
	end

	if filter.tokens then
		for _, token in filter.tokens do
			if not string.find(entry.search, token, 1, true) then
				return false
			end
		end
	end

	return true
end

function MeshCatalog:filter(filter)
	local results = {}

	for _, entry in self.entries do
		if self:matches(entry, filter) then
			table.insert(results, entry)
		end
	end

	return results
end

function MeshCatalog:getSizeText(entry): string
	local size = entry.size

	return string.format(MeshCatalog.sizeText, self:formatNumber(size.X), self:formatNumber(size.Y), self:formatNumber(size.Z))
end

function MeshCatalog:describe(entry): string
	return table.concat({ entry.location, entry.kindLabel, self:getSizeText(entry) }, MeshCatalog.infoSeparator)
end

return MeshCatalog
]]></ProtectedString>
							<string name="ScriptGuid">{9A80B905-906B-4353-8A58-A296B2EC6FCD}</string>
