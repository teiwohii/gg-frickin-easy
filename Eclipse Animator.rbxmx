					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local runService = game:GetService("RunService")
local theme = require("theme")
local motion = require("motion")
local inputModule = require("userInputService")
local rawState = require("rawState")

local EffectsRow = {}
EffectsRow.__index = EffectsRow

local rowHeight = 19
local rowGap = 4
local iconImage = "rbxassetid://97682995973876"
local titleText = "EFFECTS"
local keySize = 16
local doubleClickTime = 0.32
local dragThreshold = 3
local retryInterval = 0.5
local center = Vector2.new(0.5, 0.5)

local function descend(root, names)
	local current = root
	for _, name in names do
		current = current and current:FindFirstChild(name)
	end

	return current
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
end

local function inside(object, point)
	if not object or not object.Parent or not object.Visible then
		return false
	end

	local position, size = object.AbsolutePosition, object.AbsoluteSize
	return point.X >= position.X
		and point.X <= position.X + size.X
		and point.Y >= position.Y
		and point.Y <= position.Y + size.Y
end

function EffectsRow.new(options)
	local self = setmetatable({
		options = options,
		connections = {},
		keys = {},
		keyWidgets = {},
		selection = {},
		enabled = false,
		destroyed = false,
		nextRetry = 0,
	}, EffectsRow)

	table.insert(
		self.connections,
		runService.Heartbeat:Connect(function()
			self:step()
		end)
	)
	return self
end

function EffectsRow:timeline()
	local state = self.options.state
	return state and state.Timeline
end

function EffectsRow:findUi()
	local content = descend(self.options.animatorFrame, { "Frames", "Main", "Content" })
	local container = descend(content, { "LeftDiv", "RigListContainer" })
	local scroll = container and container:FindFirstChild("RigContainerScroll")
	local scaleFrame = descend(content, { "RightDiv", "TimelineContainer", "Scale" })
	local keys = scaleFrame and scaleFrame:FindFirstChild("Keys")
	if not scroll or not keys then
		return nil
	end

	local itemTemplate = scroll:FindFirstChild("ItemTemplate") or content:FindFirstChild("ItemTemplate", true)
	local trackTemplate = keys:FindFirstChild("TrackTemplate", true)
	if not itemTemplate or not trackTemplate then
		return nil
	end

	return {
		container = container,
		scroll = scroll,
		scaleFrame = scaleFrame,
		keys = keys,
		itemTemplate = itemTemplate,
		trackTemplate = trackTemplate,
	}
end

function EffectsRow:setEnabled(enabled)
	enabled = enabled == true
	if self.destroyed or enabled == self.enabled then
		return
	end

	self.enabled = enabled
	if enabled then
		self.nextRetry = 0
		self:mount()
	else
		self:unmount()
	end
end

function EffectsRow:isShown()
	return self.enabled and self.row ~= nil and self.rowClip ~= nil and self.rowClip.Visible
end

function EffectsRow:alive()
	local ui = self.ui
	return ui ~= nil
		and self.row ~= nil
		and self.rowClip ~= nil
		and self.row.Parent == self.rowClip
		and self.rowClip.Parent == ui.container
		and self.anchor ~= nil
		and self.anchor.Parent == ui.scroll
		and self.track ~= nil
		and self.trackClip ~= nil
		and self.track.Parent == self.trackClip
		and self.trackClip.Parent == ui.scaleFrame
		and ui.scroll.Parent == ui.container
		and ui.keys.Parent == ui.scaleFrame
end

function EffectsRow:mount()
	if self.row or not self.enabled or self.destroyed then
		return
	end

	local ui = self:findUi()
	if not ui then
		return
	end

	self.ui = ui
	self:buildRow()
	self:buildTrack()
	self:shiftLayout()
	self:installEventGuard()
	self:bindRow(ui.scroll:GetPropertyChangedSignal("CanvasPosition"), function()
		self:update()
	end)
	self:bindRow(ui.keys:GetPropertyChangedSignal("CanvasPosition"), function()
		self:update()
	end)
	self.layoutKey = nil
	self:rebuildKeys()
	self:update()
end

function EffectsRow:unmount()
	self:endDrag()
	self:restoreLayout()
	self:removeEventGuard()
	for _, connection in self.rowConnections or {} do
		connection:Disconnect()
	end

	self.rowConnections = nil
	if self.row then
		self.row:Destroy()
	end

	if self.track then
		self.track:Destroy()
	end

	for _, object in { self.rowClip, self.trackClip, self.anchor } do
		object:Destroy()
	end

	if self.keyTemplate then
		self.keyTemplate:Destroy()
	end

	self.rowClip, self.trackClip, self.anchor = nil, nil, nil
	self.row, self.track, self.keyLayer, self.keyTemplate, self.selectBox = nil, nil, nil, nil, nil
	self.addButton = nil
	table.clear(self.keyWidgets)
	self.ui = nil
end

function EffectsRow:bindRow(signal, callback)
	self.rowConnections = self.rowConnections or {}
	local connection = signal:Connect(callback)
	table.insert(self.rowConnections, connection)
	return connection
end

function EffectsRow:buildRow()
	local ui = self.ui
	local row = ui.itemTemplate:Clone()
	row.Name = "EclipseFXEffectsRow"
	row.Visible = true
	row.AutomaticSize = Enum.AutomaticSize.None
	row.AnchorPoint = center
	row.Size = UDim2.new(1, -4, 0, rowHeight)
	row.ZIndex = ui.scroll.ZIndex + 1
	self.rowClip = self:makeClip("EclipseFXEffectsClip", ui.container, ui.scroll.ZIndex + 1)

	local anchor = Instance.new("Frame")
	anchor.Name = "EclipseFXEffectsAnchor"
	anchor.BackgroundTransparency = 1
	anchor.BorderSizePixel = 0
	anchor.Size = UDim2.new(1, 0, 0, 0)
	anchor.LayoutOrder = -1000000
	anchor.Active = false
	anchor.Interactable = false
	anchor.Parent = ui.scroll
	self.anchor = anchor

	local children = row:FindFirstChild("ChildrenContainer")
	if children then
		children:Destroy()
	end

	local details = row:WaitForChild("AppearDetails")
	details.BackgroundTransparency = 1
	details:SetAttribute("ThemeBgTransparency", 1)
	local expand = descend(details, { "LeftDiv", "More" })
	if expand then
		expand.Active = false
		expand.AutoButtonColor = false
		local arrow = expand:FindFirstChild("ActualImage")
		if arrow then
			arrow.ImageTransparency = 1
		end
	end

	local right = details:FindFirstChild("RightDiv")
	if right then
		for _, child in right:GetChildren() do
			if child:IsA("GuiButton") then
				child:Destroy()
			end
		end

		local add = Instance.new("TextButton")
		add.Name = "AddEmitKey"
		add.Text = "+"
		add.Font = Enum.Font.GothamMedium
		add.TextSize = 17
		add.TextColor3 = Color3.fromRGB(216, 200, 233)
		add.BackgroundTransparency = 1
		add.BorderSizePixel = 0
		add.AutoButtonColor = false
		add.Size = UDim2.fromScale(1, 1)
		add.LayoutOrder = -2
		add:SetAttribute("ThemeTxt", "Txt")
		local square = Instance.new("UIAspectRatioConstraint")
		square.AspectRatio = 1
		square.Parent = add
		add.Parent = right
		self.addButton = add
		self:bindRow(add.MouseButton1Click, function()
			if self.options.onAddKey then
				self.options.onAddKey()
			end
		end)
	end

	local centerDiv = details:FindFirstChild("CenterDiv")
	local title = centerDiv and centerDiv:FindFirstChild("Title")
	if title then
		title.Text = titleText
		title.TextTransparency = 0
	end

	local image = centerDiv and descend(centerDiv, { "ImgContainer", "Img" })
	if image then
		image.Image = iconImage
		image.ImageColor3 = Color3.new(1, 1, 1)
		image.ScaleType = Enum.ScaleType.Fit
		image.Active = false
		image.AutoButtonColor = false
		image:SetAttribute("ThemeImg", nil)
	end

	if centerDiv then
		self:bindRow(centerDiv.MouseButton1Click, function()
			local now = os.clock()
			if self.lastRowClick and now - self.lastRowClick <= doubleClickTime then
				self.lastRowClick = nil
				if self.options.onAddKey then self.options.onAddKey() end
				return
			end
			self.lastRowClick = now
			if self.options.onSelectAll then
				self.options.onSelectAll()
			end
		end)
	end

	pcall(theme.applyTree, row)
	row.Parent = self.rowClip
	self.row = row
end

function EffectsRow:makeClip(name, parent, zIndex)
	local clip = Instance.new("Frame")
	clip.Name = name
	clip.BackgroundTransparency = 1
	clip.BorderSizePixel = 0
	clip.ClipsDescendants = true
	clip.Active = false
	clip.ZIndex = zIndex
	clip.Parent = parent
	return clip
end

function EffectsRow:buildTrack()
	local ui = self.ui
	local track = ui.trackTemplate:Clone()
	track.Name = "EclipseFXEffectsTrack"
	track.Visible = true
	track.Active = true
	track.AutomaticSize = Enum.AutomaticSize.None
	track.AnchorPoint = center
	track.ZIndex = ui.keys.ZIndex
	self.trackClip = self:makeClip("EclipseFXEffectsTrackClip", ui.scaleFrame, ui.keys.ZIndex)

	for _, name in { "Line", "StartPoint", "EndPoint" } do
		local part = track:FindFirstChild(name, true)
		if part then
			part:SetAttribute("ThemeBg", "Trk")
			theme.applyInstance(part)
		end
	end

	local layer = descend(track, { "Content", "Keyframes" })
	local template = layer and layer:FindFirstChild("KeyframeTemplate")
	if template then
		template.Visible = false
		template.Parent = nil
	end

	self.keyLayer = layer
	self.keyTemplate = template
	self:bindRow(track.InputBegan, function(input)
		if not isPress(input) or self.keyDrag or self:keyAtPointer() then
			return
		end

		if self.options.onFocus then
			self.options.onFocus()
		end

		pcall(inputModule.trackGuiPress, input, track)
		self:boxSelect(input)
	end)

	track.Parent = self.trackClip
	self.track = track
end

function EffectsRow:shift()
	return rowHeight + rowGap
end

function EffectsRow:shiftLayout()
	if self.shifted then
		return
	end

	local scroll = self.ui.scroll
	local padding = scroll:FindFirstChildOfClass("UIPadding")
	local created = false
	if not padding then
		padding = Instance.new("UIPadding")
		padding.Parent = scroll
		created = true
	end

	self.shifted = { padding = padding, top = padding.PaddingTop, created = created }
	padding.PaddingTop = padding.PaddingTop + UDim.new(0, self:shift())
end

function EffectsRow:restoreLayout()
	local shifted = self.shifted
	if not shifted then
		return
	end

	self.shifted = nil
	if shifted.created then
		shifted.padding:Destroy()
	elseif shifted.padding.Parent then
		shifted.padding.PaddingTop = shifted.top
	end
end

function EffectsRow:containsPoint(point)
	if not self:isShown() or not self.track or not self.trackClip then
		return false
	end

	return inside(self.track, point) and inside(self.trackClip, point)
end

function EffectsRow:installEventGuard()
	local timeline = self:timeline()
	if not timeline or self.guard or type(timeline.IsPointOverEventUI) ~= "function" then
		return
	end

	local original = timeline.IsPointOverEventUI
	local own = rawget(timeline, "IsPointOverEventUI")
	local guard
	guard = function(target, point, ...)
		if self:containsPoint(point) then
			return true
		end

		return original(target, point, ...)
	end
	timeline.IsPointOverEventUI = guard
	self.guard = { timeline = timeline, guard = guard, own = own }
end

function EffectsRow:removeEventGuard()
	local guard = self.guard
	if not guard then
		return
	end

	self.guard = nil
	if rawget(guard.timeline, "IsPointOverEventUI") == guard.guard then
		guard.timeline.IsPointOverEventUI = guard.own
	end
end

function EffectsRow:scale()
	return math.max(motion.scale(self.ui.scaleFrame), 0.001)
end

local function mirror(clip, target)
	if clip.AnchorPoint ~= target.AnchorPoint then
		clip.AnchorPoint = target.AnchorPoint
	end

	if clip.Position ~= target.Position then
		clip.Position = target.Position
	end

	if clip.Size ~= target.Size then
		clip.Size = target.Size
	end
end

function EffectsRow:place()
	local ui, row, track, anchor = self.ui, self.row, self.track, self.anchor
	mirror(self.rowClip, ui.scroll)
	mirror(self.trackClip, ui.keys)

	local leftScale = math.max(motion.scale(ui.scroll), 0.001)
	local origin = self.rowClip.AbsolutePosition
	local x = (anchor.AbsolutePosition.X - origin.X) / leftScale
	local y = (anchor.AbsolutePosition.Y - origin.Y) / leftScale - self:shift()
	local width = math.max(anchor.AbsoluteSize.X / leftScale, 0)
	local rowPosition = UDim2.fromOffset(math.round(x + width / 2), math.round(y + rowHeight / 2))
	local rowSize = UDim2.fromOffset(math.round(width), rowHeight)
	if row.Position ~= rowPosition then
		row.Position = rowPosition
	end

	if row.Size ~= rowSize then
		row.Size = rowSize
	end

	local scale = self:scale()
	local top = (row.AbsolutePosition.Y - self.trackClip.AbsolutePosition.Y) / scale
	local trackPosition = UDim2.new(0.5, 0, 0, math.round(top + rowHeight / 2))
	local trackSize = UDim2.new(1, 0, 0, rowHeight)
	if track.Position ~= trackPosition then
		track.Position = trackPosition
	end

	if track.Size ~= trackSize then
		track.Size = trackSize
	end
end

function EffectsRow:step()
	if self.destroyed or not self.enabled then
		return
	end

	if not self.row then
		local now = os.clock()
		if now >= self.nextRetry then
			self.nextRetry = now + retryInterval
			self:mount()
		end

		return
	end

	if not self:alive() then
		self:unmount()
		self.nextRetry = 0
		return
	end

	self:update()
end

function EffectsRow:update()
	if not self.row then
		return
	end

	local ui = self.ui
	self.rowClip.Visible = ui.scroll.Visible
	self.trackClip.Visible = ui.keys.Visible and ui.scroll.Visible
	self:place()

	local timeline = self:timeline()
	local width = timeline and timeline.GetVisibleTimelineWidth and timeline:GetVisibleTimelineWidth() or 0
	local maxFrame = timeline and timeline.GetMaxFrame and timeline:GetMaxFrame() or 0
	local key = string.format("%d:%d:%d", width, maxFrame, self.track.AbsoluteSize.X)
	if key ~= self.layoutKey then
		self.layoutKey = key
		self:renderKeys()
	end
end

function EffectsRow:frameToX(frame)
	local timeline = self:timeline()
	if not timeline or not timeline.FrameToVisibleX then
		return 0
	end

	return timeline:FrameToVisibleX(frame)
end

function EffectsRow:xToFrame(x)
	local timeline = self:timeline()
	if not timeline or not timeline.VisibleXToFrame then
		return 0
	end

	return timeline:VisibleXToFrame(x)
end

function EffectsRow:maxFrame()
	local timeline = self:timeline()
	if timeline and timeline.GetMaxFrame then
		return timeline:GetMaxFrame()
	end

	return math.max(1, math.floor(rawState.Config.Length * rawState.Timeline.FPS + 0.5))
end

function EffectsRow:pointerX()
	local layer = self.keyLayer
	if not layer then
		return 0
	end

	return (inputModule:GetMouseLocation().X - layer.AbsolutePosition.X) / self:scale()
end

function EffectsRow:pointerInside()
	if not self:isShown() then
		return false
	end

	local pointer = inputModule:GetMouseLocation()
	return inside(self.row, pointer) and inside(self.rowClip, pointer) or self:containsPoint(pointer)
end

function EffectsRow:setKeys(keys, selection)
	self.keys = keys or {}
	self.selection = selection or {}
	self:rebuildKeys()
end

function EffectsRow:rebuildKeys()
	if not self.keyLayer then
		return
	end

	local alive = {}
	for _, key in self.keys do
		alive[key.Id] = true
		if not self.keyWidgets[key.Id] then
			self:makeKey(key.Id)
		end
	end

	for id, widget in self.keyWidgets do
		if not alive[id] then
			widget:Destroy()
			self.keyWidgets[id] = nil
		end
	end

	self:renderKeys()
end

function EffectsRow:keyImage(widget)
	local timeline = self:timeline()
	if timeline and timeline.GetKeyframeImageObject then
		local ok, image = pcall(timeline.GetKeyframeImageObject, timeline, widget)
		if ok and image then
			return image
		end
	end

	return widget
end

function EffectsRow:makeKey(id)
	local widget
	if self.keyTemplate then
		widget = self.keyTemplate:Clone()
	else
		widget = Instance.new("ImageButton")
		widget.BackgroundTransparency = 1
		widget.Image = require("assetIds").KeyframeShapes.Default
		local square = Instance.new("UIAspectRatioConstraint")
		square.Parent = widget
	end

	widget.Name = "EmitKey"
	widget.Visible = true
	widget.AutoButtonColor = false
	widget.Active = true
	widget.Selectable = false
	widget.AnchorPoint = center
	widget.Size = UDim2.fromOffset(keySize, keySize)
	widget.ZIndex = 13
	local image = self:keyImage(widget)
	if image:IsA("ImageLabel") or image:IsA("ImageButton") then
		image.ImageTransparency = 0
	end

	widget.Parent = self.keyLayer
	self.keyWidgets[id] = widget

	self:bindRow(widget.MouseEnter, function()
		self.hoverKey = id
		self:renderKeys()
	end)
	self:bindRow(widget.MouseLeave, function()
		if self.hoverKey == id then
			self.hoverKey = nil
		end

		self:renderKeys()
	end)
	self:bindRow(widget.InputBegan, function(input)
		if isPress(input) then
			pcall(inputModule.trackGuiPress, input, widget)
			self:pressKey(id, input)
		end
	end)

	return widget
end

function EffectsRow:keyColors()
	local colors = rawState.Colors or {}
	return theme.get("KfD", colors.KEYFRAME_DEFAULT_COLOR or Color3.fromRGB(255, 255, 255)),
		theme.get("KfS", colors.KEYFRAME_SELECTED_COLOR or Color3.fromRGB(145, 90, 255)),
		theme.get("KfH", colors.KEYFRAME_HOVER_COLOR or Color3.fromRGB(158, 158, 158))
end

function EffectsRow:previewFrame(key)
	local drag = self.keyDrag
	if drag and drag.delta ~= 0 and self.selection[key.Id] then
		return key.Frame + drag.delta
	end

	return key.Frame
end

function EffectsRow:renderKeys()
	if not self.keyLayer then
		return
	end

	local active = next(self.selection) ~= nil
	local details = self.row and self.row:FindFirstChild("AppearDetails")
	if details then
		local transparency = active and 0.15 or 1
		details:SetAttribute("ThemeBgTransparency", transparency)
		require("windowFx").setRestingProperty(details, "BackgroundTransparency", transparency)
		details.BackgroundTransparency = transparency
	end
	for _, name in { "Line", "StartPoint", "EndPoint" } do
		local part = self.track and self.track:FindFirstChild(name, true)
		if part then part:SetAttribute("ThemeBg", active and "KfS" or "Trk"); theme.applyInstance(part) end
	end
	local default, selected, hover = self:keyColors()
	for _, key in self.keys do
		local widget = self.keyWidgets[key.Id]
		if widget then
			local isSelected = self.selection[key.Id] == true
			local isHovered = self.hoverKey == key.Id
			local image = self:keyImage(widget)
			widget.Position = UDim2.new(0, self:frameToX(self:previewFrame(key)), 0.5, 0)
			widget.ZIndex = 13 + (isSelected and 1 or 0)
			if image:IsA("ImageLabel") or image:IsA("ImageButton") then
				image.ImageColor3 = isSelected and selected or isHovered and hover or default
			end
		end
	end
end

function EffectsRow:keyAtPointer()
	local pointer = inputModule:GetMouseLocation()
	for id, widget in self.keyWidgets do
		if widget.Visible and widget.Parent then
			local middle = widget.AbsolutePosition + widget.AbsoluteSize / 2
			local reach = math.max(widget.AbsoluteSize.X, 8) * 0.6
			if math.abs(pointer.X - middle.X) <= reach and math.abs(pointer.Y - middle.Y) <= reach then
				return id
			end
		end
	end

	return nil
end

function EffectsRow:pickerAnchor(id)
	return self.keyWidgets[id] or self.track
end

function EffectsRow:modifierDown()
	return inputModule:IsKeyDown(Enum.KeyCode.LeftShift)
		or inputModule:IsKeyDown(Enum.KeyCode.RightShift)
		or inputModule:IsKeyDown(Enum.KeyCode.LeftControl)
		or inputModule:IsKeyDown(Enum.KeyCode.RightControl)
end

function EffectsRow:dragBounds()
	local low, high = math.huge, -math.huge
	for _, key in self.keys do
		if self.selection[key.Id] then
			low = math.min(low, key.Frame)
			high = math.max(high, key.Frame)
		end
	end

	return low, high
end

function EffectsRow:pressKey(id, input)
	local options = self.options
	if options.onFocus then
		options.onFocus()
	end

	if self:modifierDown() then
		if options.onToggleKey then
			options.onToggleKey(id)
		end

		return
	end

	if not self.selection[id] and options.onSelectKey then
		options.onSelectKey(id, false)
	end

	local startX = self:pointerX()
	local startFrame = 0
	for _, key in self.keys do
		if key.Id == id then
			startFrame = key.Frame
		end
	end

	local grab = startX - self:frameToX(startFrame)
	local drag = { id = id, delta = 0, moved = false }
	self.keyDrag = drag

	self:beginDrag(input, function()
		local x = self:pointerX()
		if not drag.moved and math.abs(x - startX) < dragThreshold then
			return
		end

		drag.moved = true
		local low, high = self:dragBounds()
		local delta = self:xToFrame(x - grab) - startFrame
		if low ~= math.huge then
			delta = math.clamp(delta, -low, math.max(-low, self:maxFrame() - high))
		end

		drag.delta = delta
		self:renderKeys()
	end, function()
		if self.keyDrag == drag then
			self.keyDrag = nil
		end

		if drag.moved then
			if drag.delta ~= 0 and options.onMoveKeys then
				options.onMoveKeys(drag.delta)
			end

			self:renderKeys()
			return
		end

		local now = os.clock()
		local last = self.lastKeyClick
		local double = last and last.id == id and now - last.at <= doubleClickTime
		self.lastKeyClick = { id = id, at = now }
		if double then
			self.lastKeyClick = nil
			if options.onOpenKey then
				options.onOpenKey(id, self.keyWidgets[id])
			end
		elseif options.onClickKey then
			options.onClickKey(id)
		end
	end)
end

function EffectsRow:boxSelect(input)
	local options = self.options
	local track = self.track
	local startX = self:pointerX()
	local additive = self:modifierDown()
	local box = self.selectBox
	if not box or box.Parent ~= self.keyLayer then
		local _, selected = self:keyColors()
		box = Instance.new("Frame")
		box.Name = "SelectionBox"
		box.AnchorPoint = center
		box.BackgroundColor3 = selected
		box.BackgroundTransparency = 0.85
		box.BorderSizePixel = 0
		box.Visible = false
		box.Active = false
		box.Interactable = false
		box.ZIndex = 15
		local stroke = Instance.new("UIStroke")
		stroke.Color = selected
		stroke.Thickness = 1
		stroke.Transparency = 0.2
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = box
		box.Parent = self.keyLayer
		self.selectBox = box
	end

	local moved = false
	self:beginDrag(input, function()
		if not track.Parent then
			return
		end

		local x = self:pointerX()
		if not moved and math.abs(x - startX) < dragThreshold then
			return
		end

		moved = true
		local left, right = math.min(startX, x), math.max(startX, x)
		box.Position = UDim2.new(0, (left + right) / 2, 0.5, 0)
		box.Size = UDim2.new(0, right - left, 1, -2)
		box.Visible = true
		if options.onBoxSelect then
			local maxFrame = self:maxFrame()
			local width = math.max(self:frameToX(maxFrame), 1)
			options.onBoxSelect(left / width * maxFrame, right / width * maxFrame, additive)
		end
	end, function()
		box.Visible = false
		if moved then
			return
		end

		if not additive and options.onDeselectKey then
			options.onDeselectKey()
		end

		self:seekToPointer()
		local now = os.clock()
		local previous = self.lastTrackClick
		if previous and now - previous.at <= doubleClickTime and math.abs(startX - previous.x) <= dragThreshold then
			self.lastTrackClick = nil
			if options.onAddKey then options.onAddKey(self:xToFrame(startX)) end
		else
			self.lastTrackClick = { at = now, x = startX }
		end
	end)
end

function EffectsRow:seekToPointer()
	local timeline = self:timeline()
	local fps = rawState.Timeline.FPS
	if not timeline or not timeline.SeekToTime or not fps or fps <= 0 then
		return
	end

	if timeline.IsExportLocked and timeline:IsExportLocked() then
		return
	end

	rawState.Timeline.Playing = false
	local state = self.options.state
	pcall(timeline.SeekToTime, timeline, self:xToFrame(self:pointerX()) / fps, function()
		return state.currentRig
	end)
end

function EffectsRow:endDrag()
	if self.drag then
		self.drag.finish()
	end
end

function EffectsRow:beginDrag(input, onMove, onEnd)
	self:endDrag()
	local drag = { connections = {} }
	self.drag = drag

	function drag.finish()
		if self.drag ~= drag then
			return
		end

		self.drag = nil
		for _, connection in drag.connections do
			connection:Disconnect()
		end

		if onEnd then
			onEnd()
		end
	end

	table.insert(
		drag.connections,
		inputModule.InputChanged:Connect(function(changed)
			if changed.UserInputType == Enum.UserInputType.MouseMovement then
				onMove()
			end
		end)
	)
	table.insert(
		drag.connections,
		inputModule.InputEnded:Connect(function(ended)
			if ended.UserInputType == input.UserInputType then
				drag.finish()
			end
		end)
	)
	table.insert(drag.connections, inputModule.WindowFocusReleased:Connect(drag.finish))
end

function EffectsRow:destroy()
	if self.destroyed then
		return
	end

	self:unmount()
	self.destroyed = true
	self.enabled = false
	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
end

return EffectsRow
]]></ProtectedString>
