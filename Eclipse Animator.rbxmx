							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local FlipbookQuad = require(script.Parent.FlipbookQuad)

local FlipbookStrips = {}
FlipbookStrips.__index = FlipbookStrips

FlipbookStrips.instanceName = "_ArcParticleSnapshot"
FlipbookStrips.frameWindow = 0.12
FlipbookStrips.minimumWindow = 0.06
FlipbookStrips.warmTime = 2
FlipbookStrips.maxEmitters = 4096
FlipbookStrips.startBudget = 128
FlipbookStrips.spawnFrames = 3
FlipbookStrips.freezeLead = 1.5
FlipbookStrips.parkDistance = 8
FlipbookStrips.speed = 0.001
FlipbookStrips.hiddenTransparency = NumberSequence.new(1)
FlipbookStrips.hiddenSize = NumberSequence.new(0)
FlipbookStrips.warmSize = NumberSequence.new(0.05)
FlipbookStrips.stages = {
	queued = "Queued",
	warming = "Warming",
	ready = "Ready",
}
FlipbookStrips.appearance = {
	"Texture",
	"LightEmission",
	"LightInfluence",
	"Brightness",
	"Orientation",
	"ZOffset",
	"FlipbookLayout",
	"FlipbookSizeX",
	"FlipbookSizeY",
	"FlipbookBlendFrames",
}

function FlipbookStrips.new()
	local self = setmetatable({}, FlipbookStrips)

	self.sources = {}
	self.count = 0
	self.generation = 0
	self.queue = {}
	self.warming = {}
	self.shown = {}
	self.connection = nil
	self.readyFlag = false

	return self
end

function FlipbookStrips.supports(source: ParticleEmitter): boolean
	return FlipbookQuad.getGridSize(source) ~= nil
		and source.FlipbookMode == Enum.ParticleFlipbookMode.OneShot
		and not source.FlipbookStartRandom
end

function FlipbookStrips.getFrameCount(source: ParticleEmitter): number
	local x, y = FlipbookQuad.getGridDimensions(source)
	return (x or 1) * (y or 1)
end

function FlipbookStrips.getWindow(frames: number): number
	return math.clamp(FlipbookStrips.warmTime / math.max(frames, 1), FlipbookStrips.minimumWindow, FlipbookStrips.frameWindow)
end

function FlipbookStrips.constant(value: number, envelope: number?): NumberSequence
	if not envelope or envelope <= 0 then
		return NumberSequence.new(value)
	end

	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, value, envelope),
		NumberSequenceKeypoint.new(1, value, envelope),
	})
end

function FlipbookStrips:consumeReady(): boolean
	local ready = self.readyFlag

	self.readyFlag = false

	return ready
end

function FlipbookStrips:isBusy(): boolean
	return #self.queue > 0 or #self.warming > 0
end

function FlipbookStrips:getSignature(source: ParticleEmitter, life: number, rotation: number, rotSpeed: number): string
	local x, y = FlipbookQuad.getGridDimensions(source)
	return string.format("%s|%s|%s|%.3f|%.1f|%.1f", source.FlipbookLayout.Name, tostring(x), tostring(y), life, rotation, rotSpeed)
end

function FlipbookStrips:destroyStrip(strip)
	if not strip.alive then
		return
	end

	strip.alive = false
	self.shown[strip] = nil

	if strip.attachment then
		strip.attachment:Destroy()
		strip.attachment = nil
	end

	table.clear(strip.emitters)
	self.count -= strip.frames

	local owned = self.sources[strip.source]

	if owned and owned[strip.identity] == strip then
		owned[strip.identity] = nil

		if next(owned) == nil then
			self.sources[strip.source] = nil
		end
	end
end

function FlipbookStrips:evict(needed: number): boolean
	local candidates = {}

	for _, owned in self.sources do
		for _, strip in owned do
			if strip.used < self.generation and not self.shown[strip] then
				table.insert(candidates, strip)
			end
		end
	end

	table.sort(candidates, function(a, b)
		return a.used < b.used
	end)

	for _, strip in candidates do
		if self.count + needed <= FlipbookStrips.maxEmitters then
			break
		end

		self:destroyStrip(strip)
	end

	return self.count + needed <= FlipbookStrips.maxEmitters
end

function FlipbookStrips:request(source: ParticleEmitter, identity: number, life: number, rotation: number, rotSpeed: number, reserve: boolean?)
	local owned = self.sources[source]

	if not owned then
		owned = {}
		self.sources[source] = owned
	end

	local signature = self:getSignature(source, life, rotation, rotSpeed)
	local strip = owned[identity]

	if strip and strip.signature == signature then
		strip.used = self.generation
		return strip
	end

	if strip then
		self:destroyStrip(strip)
	end

	local frames = FlipbookStrips.getFrameCount(source)

	if self.count + frames > FlipbookStrips.maxEmitters and (reserve or not self:evict(frames)) then
		if self.sources[source] and next(self.sources[source]) == nil then
			self.sources[source] = nil
		end

		return nil
	end

	strip = {
		alive = true,
		source = source,
		identity = identity,
		signature = signature,
		frames = frames,
		life = life,
		rotation = rotation,
		rotSpeed = rotSpeed,
		stage = FlipbookStrips.stages.queued,
		attachment = nil,
		emitters = {},
		wait = 0,
		aged = 0,
		frozen = 0,
		active = nil,
		statics = nil,
		used = self.generation,
	}

	self.sources[source] = self.sources[source] or owned
	self.sources[source][identity] = strip
	self.count += frames
	table.insert(self.queue, strip)
	self:bind()

	return strip
end

function FlipbookStrips:copyAppearance(source: ParticleEmitter, emitter: ParticleEmitter)
	for _, name in FlipbookStrips.appearance do
		pcall(function()
			(emitter :: any)[name] = (source :: any)[name]
		end)
	end
end

function FlipbookStrips:spawn(strip, park: CFrame)
	local source = strip.source
	local attachment = Instance.new("Attachment")

	attachment.Name = FlipbookStrips.instanceName
	attachment.Archivable = false
	attachment.Parent = workspace.Terrain
	attachment.WorldCFrame = park

	local lifetime = NumberRange.new(strip.frames * FlipbookStrips.getWindow(strip.frames))

	for index = 1, strip.frames do
		local age = (index - 0.5) / strip.frames * strip.life
		local emitter = Instance.new("ParticleEmitter")

		emitter.Name = FlipbookStrips.instanceName
		emitter.Archivable = false
		emitter.Enabled = false
		emitter.Rate = 0
		emitter.SpreadAngle = Vector2.zero
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.LockedToPart = true
		emitter.VelocityInheritance = 0
		emitter.Acceleration = Vector3.zero
		emitter.Drag = 0
		emitter.TimeScale = 0
		emitter.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
		emitter.FlipbookStartRandom = false
		emitter.Lifetime = lifetime
		emitter.Speed = NumberRange.new(FlipbookStrips.speed)
		emitter.Rotation = NumberRange.new(strip.rotation + strip.rotSpeed * age)
		emitter.RotSpeed = NumberRange.new(0)
		emitter.Size = FlipbookStrips.warmSize
		emitter.Transparency = FlipbookStrips.hiddenTransparency
		self:copyAppearance(source, emitter)
		emitter.Parent = attachment
		emitter:Emit(1)
		strip.emitters[index] = emitter
	end

	strip.attachment = attachment
	strip.stage = FlipbookStrips.stages.warming
	strip.wait = FlipbookStrips.spawnFrames
	strip.aged = 0
	strip.frozen = 0
	table.insert(self.warming, strip)
end

function FlipbookStrips:advance(strip, deltaTime: number): boolean
	if strip.wait > 0 then
		strip.wait -= 1

		if strip.wait == 0 then
			for _, emitter in strip.emitters do
				emitter.TimeScale = 1
			end
		end

		return false
	end

	local window = FlipbookStrips.getWindow(strip.frames)

	local lead = deltaTime * FlipbookStrips.freezeLead

	while strip.frozen < strip.frames and strip.aged >= (strip.frozen + 0.5) * window - lead do
		strip.frozen += 1
		strip.emitters[strip.frozen].TimeScale = 0
	end

	if strip.frozen >= strip.frames then
		for _, emitter in strip.emitters do
			emitter.Size = FlipbookStrips.hiddenSize
		end

		strip.stage = FlipbookStrips.stages.ready

		return true
	end

	strip.aged += deltaTime

	return false
end

function FlipbookStrips:step(deltaTime: number)
	local camera = workspace.CurrentCamera
	local park = if camera then camera.CFrame * CFrame.new(0, 0, -FlipbookStrips.parkDistance) else CFrame.identity
	local budget = FlipbookStrips.startBudget

	while budget > 0 and #self.queue > 0 do
		local strip = table.remove(self.queue, 1)

		if strip.alive and strip.source.Parent then
			self:spawn(strip, park)
			budget -= strip.frames
		elseif strip.alive then
			self:destroyStrip(strip)
		end
	end

	for index = #self.warming, 1, -1 do
		local strip = self.warming[index]

		if not strip.alive then
			table.remove(self.warming, index)
		else
			strip.attachment.WorldCFrame = park

			if self:advance(strip, deltaTime) then
				table.remove(self.warming, index)
				self.readyFlag = true
			end
		end
	end

	if not self:isBusy() then
		self:unbind()
	end
end

function FlipbookStrips:bind()
	if self.connection then
		return
	end

	self.connection = runService.RenderStepped:Connect(function(deltaTime)
		self:step(deltaTime)
	end)
end

function FlipbookStrips:unbind()
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
end

function FlipbookStrips:beginFrame()
	self.generation += 1
end

function FlipbookStrips:hideStrip(strip)
	local emitter = strip.active and strip.emitters[strip.active]

	strip.active = nil
	self.shown[strip] = nil

	if emitter and emitter.Parent then
		emitter.Size = FlipbookStrips.hiddenSize
		emitter.Transparency = FlipbookStrips.hiddenTransparency
	end
end

function FlipbookStrips:endFrame()
	for strip in self.shown do
		if strip.shownGeneration ~= self.generation then
			self:hideStrip(strip)
		end
	end
end

function FlipbookStrips:hideAll()
	for strip in self.shown do
		self:hideStrip(strip)
	end
end

function FlipbookStrips:show(strip, look): boolean
	if not strip or not strip.alive or strip.stage ~= FlipbookStrips.stages.ready or not strip.attachment.Parent then
		return false
	end

	local source = strip.source
	local index = math.clamp(math.floor(look.progress * strip.frames) + 1, 1, strip.frames)
	local emitter = strip.emitters[index]

	if not emitter or not emitter.Parent then
		return false
	end

	if strip.statics ~= look.statics then
		for _, other in strip.emitters do
			self:copyAppearance(source, other)
		end

		strip.statics = look.statics
	end

	if strip.active and strip.active ~= index then
		local previous = strip.emitters[strip.active]

		if previous and previous.Parent then
			previous.Size = FlipbookStrips.hiddenSize
			previous.Transparency = FlipbookStrips.hiddenTransparency
		end
	end

	strip.attachment.WorldCFrame = look.cframe
	emitter.Color = look.color
	emitter.Squash = look.squash
	emitter.Size = look.size
	emitter.Transparency = look.transparency
	strip.active = index
	strip.used = self.generation
	strip.shownGeneration = self.generation
	self.shown[strip] = true

	return true
end

function FlipbookStrips:prune()
	for source, owned in self.sources do
		if not source.Parent then
			local strips = {}

			for _, strip in owned do
				table.insert(strips, strip)
			end

			for _, strip in strips do
				self:destroyStrip(strip)
			end
		end
	end
end

function FlipbookStrips:destroy()
	self:unbind()

	local strips = {}

	for _, owned in self.sources do
		for _, strip in owned do
			table.insert(strips, strip)
		end
	end

	for _, strip in strips do
		self:destroyStrip(strip)
	end

	table.clear(self.sources)
	table.clear(self.queue)
	table.clear(self.warming)
	table.clear(self.shown)
	self.count = 0
	self.readyFlag = false
end

return FlipbookStrips
]]></ProtectedString>
