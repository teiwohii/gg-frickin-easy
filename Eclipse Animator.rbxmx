					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local armatureData = require("chunkStore")
local httpService = game:GetService("HttpService")
local binding = require("binding")
local geometryModule = require("distance")
local visibilityModule = require("armatureVisibility")
local runtime = require("armatureRuntime")
local converter = {}

local function vector(value)
	return Vector3.new(value[1], value[2], value[3])
end

local function color(value, fallback)
	return value and Color3.new(value[1], value[2], value[3]) or fallback
end

local function geometry(bone)
	local display = bone.display
	if not display or not display.vertices then
		return bone.edges or {}, bone.tris or {}, false
	end

	local edges, triangles = {}, {}
	for _, edge in display.edges or {} do
		table.insert(edges, { display.vertices[edge[1] + 1], display.vertices[edge[2] + 1] })
	end

	for _, triangle in display.triangles or {} do
		table.insert(triangles, {
			display.vertices[triangle[1] + 1],
			display.vertices[triangle[2] + 1],
			display.vertices[triangle[3] + 1],
		})
	end

	return edges, triangles, true
end

local function storeRest(reference, target, plan)
	if target:IsA("JointInstance") then
		reference:SetAttribute(
			"EclipseArmatureRestC0",
			plan.restWorlds[target.Part0]:Inverse() * plan.restWorlds[target]
		)
	elseif target:IsA("Bone") then
		reference:SetAttribute("EclipseArmatureRestC0", target.CFrame)
	end
end

function converter.build(data, rig)
	local plan = binding.plan(data, rig)
	local visibility = visibilityModule.classify(data)
	local arm = Instance.new("Model")
	arm.Name = "Armature"
	arm:SetAttribute("EclipseArmature", true)
	arm:SetAttribute("EclipseArmatureVersion", 4)
	arm:SetAttribute("EclipseArmatureFit", plan.frame)
	arm:SetAttribute("EclipseArmatureScale", plan.scale)
	arm:SetAttribute("EclipseArmatureFitError", plan.errorDistance)
	local ok, message = xpcall(function()
		armatureData.write(arm, "EclipseArmatureGraph", httpService:JSONEncode(data))
		local lastYield = os.clock()

		local function point(value)
			return plan.frame * (value * plan.scale)
		end

		for _, bone in data.bones do
			local presentation = visibility[bone.id]
			local edges, triangles, rawDisplay = geometry(bone)
			local emptyDisplay = rawDisplay and #edges == 0 and #triangles == 0
			local entry = plan.entries[bone.id]
			local pose = plan.frame * binding.matrix(bone.pose_matrix, plan.scale)
			local minimum, maximum

			local function include(raw)
				local localPoint = rawDisplay and vector(raw)
					or pose:PointToObjectSpace(point(vector(raw)))
				minimum = minimum and minimum:Min(localPoint) or localPoint
				maximum = maximum and maximum:Max(localPoint) or localPoint
			end

			for _, edge in edges do
				include(edge[1])
				include(edge[2])
			end

			for _, triangle in triangles do
				for _, v in triangle do
					include(v)
				end
			end

			if not minimum then
				if rawDisplay then
					include({ 0, 0, 0 })
					include({ 0, bone.display.length or 0, 0 })
				else
					include(bone.head)
					include(bone.tail)
				end
			end

			local center, size = (minimum + maximum) * 0.5, maximum - minimum
			local anchor = Instance.new("Part")
			anchor.Name = bone.name
			anchor.Anchored, anchor.CanCollide, anchor.CanTouch, anchor.CanQuery, anchor.CastShadow =
				true, false, false, not presentation.hidden and not presentation.unselectable, false
			anchor.Transparency = 1
			anchor.Size =
				Vector3.new(math.max(0.05, size.X), math.max(0.05, size.Y), math.max(0.05, size.Z))
			anchor.CFrame = pose * CFrame.new(center)
			anchor:SetAttribute("EclipseArmatureVisualRest", anchor.CFrame)
			if rawDisplay then
				anchor:SetAttribute("EclipseArmatureRawDisplay", true)
				anchor:SetAttribute("EclipseArmatureRawCenter", center)
				anchor:SetAttribute("EclipseArmatureRawSize", size)
			end

			anchor.PivotOffset = CFrame.new(-center)
			anchor:SetAttribute("EclipseArmatureBone", true)
			anchor:SetAttribute("EclipseArmatureControl", presentation.control)
			if emptyDisplay then
				anchor:SetAttribute("EclipseArmatureEmptyDisplay", true)
			end

			anchor:SetAttribute("EclipseArmatureBoneId", bone.id)
			anchor:SetAttribute("EclipseArmatureVisualOffset", CFrame.new(center))
			anchor:SetAttribute("EclipseDesignRot", pose.Rotation)
			anchor:SetAttribute("ParentBone", bone.parent)
			anchor:SetAttribute("Head", point(vector(bone.head)))
			anchor:SetAttribute("Tail", point(vector(bone.tail)))
			anchor:SetAttribute("Hidden", presentation.hidden)
			anchor:SetAttribute("Solid", geometryModule.isSolid(bone))
			anchor:SetAttribute("EclipseDeform", bone.deform == true)
			anchor:SetAttribute("BoneColor", color(bone.color, Color3.new(0.5, 0.5, 0.5)))
			anchor:SetAttribute("SelectColor", color(bone.select, Color3.new(1, 1, 1)))
			anchor:SetAttribute("ActiveColor", color(bone.active, Color3.new(1, 1, 1)))
			anchor.Parent = arm
			if entry.targets then
				local rest = plan.frame * binding.matrix(bone.rest_matrix, plan.scale)
				local first = entry.targets[1]
				local target = Instance.new("ObjectValue")
				target.Name, target.Value, target.Parent = "EclipseArmatureTarget", first, anchor
				storeRest(target, first, plan)
				anchor:SetAttribute(
					"EclipseArmatureBindOffset",
					rest:Inverse() * plan.restWorlds[first]
				)
				if #entry.targets > 1 then
					local copies = Instance.new("Folder")
					copies.Name, copies.Parent = "EclipseArmatureTargets", anchor
					for index, object in entry.targets do
						local ref = Instance.new("ObjectValue")
						ref.Name, ref.Value, ref.Parent = tostring(index), object, copies
						ref:SetAttribute("BindOffset", rest:Inverse() * plan.restWorlds[object])
						storeRest(ref, object, plan)
					end
				end
			end

			if presentation.control then
				local lines = {}
				for _, edge in edges do
					table.insert(
						lines,
						rawDisplay and vector(edge[1])
							or anchor.CFrame:PointToObjectSpace(point(vector(edge[1])))
					)
					table.insert(
						lines,
						rawDisplay and vector(edge[2])
							or anchor.CFrame:PointToObjectSpace(point(vector(edge[2])))
					)
				end

				for _, selected in { false, true } do
					local wire = Instance.new("WireframeHandleAdornment")
					wire.Name = selected and "XRayEdgesSelect" or "XRayEdges"
					wire.Adornee, wire.AlwaysOnTop, wire.ZIndex, wire.Visible =
						anchor, presentation.inFront, 1, not selected
					wire.Color3 = anchor:GetAttribute(selected and "SelectColor" or "BoneColor")
					wire.Parent = anchor
				end

				geometryModule.setLines(anchor, lines)
				if geometryModule.isSolid(bone) and #triangles > 0 then
					geometryModule.solid(anchor, triangles, point, rawDisplay)
				end

				geometryModule.setVisible(anchor, not presentation.hidden)
			end

			if os.clock() - lastYield > 0.012 then
				task.wait()
				lastYield = os.clock()
			end
		end
	end, debug.traceback)
	if not ok then
		for _, anchor in arm:GetChildren() do
			if anchor:IsA("BasePart") then
				geometryModule.clear(anchor)
			end
		end

		arm:Destroy()
		error(message, 0)
	end

	return arm, plan
end

function converter.attach(arm, rig, data)
	data = data or httpService:JSONDecode(armatureData.read(arm.EclipseArmatureGraph))
	local needsRebind = false
	for _, anchor in arm:GetChildren() do
		local ref = anchor:FindFirstChild("EclipseArmatureTarget")
		if ref and (not ref.Value or not ref.Value:IsDescendantOf(rig)) then
			needsRebind = true
			break
		end
	end

	if needsRebind then
		local plan = binding.plan(data, rig)
		local ratio = plan.scale / (arm:GetAttribute("EclipseArmatureScale") or plan.scale)
		arm:SetAttribute("EclipseArmatureFit", plan.frame)
		arm:SetAttribute("EclipseArmatureScale", plan.scale)
		for _, anchor in arm:GetChildren() do
			local id = anchor:GetAttribute("EclipseArmatureBoneId")
			local entry = id and plan.entries[id]
			if entry then
				local offset = anchor:GetAttribute("EclipseArmatureVisualOffset")
				offset = CFrame.new(offset.Position * ratio) * offset.Rotation
				anchor:SetAttribute("EclipseArmatureVisualOffset", offset)
				anchor.Size *= ratio
				anchor.PivotOffset = CFrame.new(anchor.PivotOffset.Position * ratio)
					* anchor.PivotOffset.Rotation
				anchor.CFrame = plan.frame
					* binding.matrix(entry.data.pose_matrix, plan.scale)
					* offset
				anchor:SetAttribute("EclipseArmatureVisualRest", anchor.CFrame)
				geometryModule.clear(anchor)
				local old = anchor:FindFirstChild("EclipseArmatureTarget")
				if old then
					old:Destroy()
				end

				local copies = anchor:FindFirstChild("EclipseArmatureTargets")
				if copies then
					copies:Destroy()
				end

				if entry.targets then
					local rest = plan.frame * binding.matrix(entry.data.rest_matrix, plan.scale)
					local target = Instance.new("ObjectValue")
					target.Name, target.Value, target.Parent =
						"EclipseArmatureTarget", entry.targets[1], anchor
					storeRest(target, entry.targets[1], plan)
					anchor:SetAttribute(
						"EclipseArmatureBindOffset",
						rest:Inverse() * plan.restWorlds[entry.targets[1]]
					)
					if #entry.targets > 1 then
						copies = Instance.new("Folder")
						copies.Name, copies.Parent = "EclipseArmatureTargets", anchor
						for index, object in entry.targets do
							local ref = Instance.new("ObjectValue")
							ref.Name, ref.Value, ref.Parent = tostring(index), object, copies
							ref:SetAttribute("BindOffset", rest:Inverse() * plan.restWorlds[object])
							storeRest(ref, object, plan)
						end
					end
				end
			end
		end
	end

	converter.restoreShapes(arm, data)
	local entry = runtime.attach(arm, rig, data)
	assert(runtime.evaluate(rig, true), "The armature could not be evaluated")
	return entry
end

function converter.restoreShapes(arm, data)
	data = data or httpService:JSONDecode(armatureData.read(arm.EclipseArmatureGraph))
	local visibility = visibilityModule.classify(data)
	local fit, scale =
		arm:GetAttribute("EclipseArmatureFit"), arm:GetAttribute("EclipseArmatureScale")
	local byId = {}
	for _, anchor in arm:GetChildren() do
		local id = anchor:IsA("BasePart") and anchor:GetAttribute("EclipseArmatureBoneId")
		if id ~= nil then
			byId[id] = anchor
		end
	end

	local skipped = 0
	local function restoreBone(bone)
		local anchor = type(bone) == "table" and bone.id ~= nil and byId[bone.id]
		if anchor then
			local solid = geometryModule.isSolid(bone)
			if anchor:GetAttribute("Solid") ~= solid then
				geometryModule.clear(anchor)
				anchor:SetAttribute("Solid", solid)
			end

			local presentation = visibility[bone.id] or {}
			for _, name in { "XRayEdges", "XRayEdgesSelect" } do
				local wire = anchor:FindFirstChild(name)
				if wire then
					wire.AlwaysOnTop = presentation.inFront ~= false
				end
			end
			anchor:SetAttribute("EclipseArmatureControl", presentation.control)
			if not presentation.control then
				anchor:SetAttribute("Hidden", true)
				anchor.CanQuery = false
				geometryModule.clear(anchor)
				geometryModule.setVisible(anchor, false)
				return
			end

			local current = anchor.CFrame
			local original = anchor:GetAttribute("EclipseArmatureVisualRest")
				or fit
					* binding.matrix(bone.pose_matrix, scale)
					* anchor:GetAttribute("EclipseArmatureVisualOffset")
			if not geometryModule.has(anchor) then
				anchor:SetAttribute("Hidden", true)
				anchor.CanQuery = false
				geometryModule.setVisible(anchor, false)
				local edges, triangles, rawDisplay = geometry(bone)
				local lines = {}
				for _, edge in edges do
					table.insert(
						lines,
						rawDisplay and vector(edge[1])
							or original:PointToObjectSpace(fit * (vector(edge[1]) * scale))
					)
					table.insert(
						lines,
						rawDisplay and vector(edge[2])
							or original:PointToObjectSpace(fit * (vector(edge[2]) * scale))
					)
				end

				geometryModule.setLines(anchor, lines)
				if solid and #triangles > 0 then
					geometryModule.solid(anchor, triangles, function(point)
						return current * original:PointToObjectSpace(fit * (point * scale))
					end, rawDisplay)
				end
			end
		end
	end

	for _, bone in type(data.bones) == "table" and data.bones or {} do
		local ok, problem = pcall(restoreBone, bone)
		if not ok then
			skipped += 1
			if skipped == 1 then
				warn(
					"[Eclipse] Armature bone shape could not be restored for "
						.. tostring(type(bone) == "table" and bone.id or bone)
						.. ": "
						.. tostring(problem)
				)
			end
		end
	end

	return skipped
end

return converter
]]></ProtectedString>
						<string name="ScriptGuid">{DF5381F8-1868-47CD-997C-EEFB9DA92401}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">armatureConverter</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXEA4437D9B8AE4C69AA97FC029F90B069">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local binding = require("binding")
local plan = {}

local function build(data, rig, geometryFrames, preferExact)
	local byName, sourceByName, entries = {}, {}, {}
	local motorByPart, restCache, visiting = {}, {}, {}
	local descendants = require("rigTraversal").rigDescendants(rig)
	for _, item in descendants do
		if item:IsA("JointInstance") and item.Part0 and item.Part1 then
			local existing = motorByPart[item.Part1]
			if not existing or item:IsA("Motor6D") and not existing:IsA("Motor6D") then
				motorByPart[item.Part1] = item
			end
		end
	end

	local function restC0(motor)
		local value = motor:GetAttribute("EclipseAnimatorDefaultC0")
		return typeof(value) == "CFrame" and value or motor.C0
	end

	local function restWorld(target)
		if restCache[target] then
			return restCache[target]
		end

		assert(not visiting[target], "Cyclic native rig joints")
		visiting[target] = true
		local frame
		if target:IsA("Bone") then
			frame = restWorld(target.Parent) * target.CFrame
		elseif target:IsA("JointInstance") then
			frame = restWorld(target.Part0) * restC0(target)
		elseif motorByPart[target] then
			local motor = motorByPart[target]
			frame = restWorld(motor.Part0) * restC0(motor) * motor.C1:Inverse()
		else
			frame = target.CFrame
		end

		visiting[target] = nil
		restCache[target] = frame
		return frame
	end

	local function candidate(name, target, priority)
		local group = byName[name]
		if not group or group.priority < priority then
			group = { priority = priority, targets = {} }
			byName[name] = group
		end

		if group.priority == priority then
			table.insert(group.targets, target)
		end
	end

	for _, target in descendants do
		if target:GetAttribute("EclipseArmatureSkinningHelper") then
			continue
		end

		local cursor, generated = target.Parent, false
		while cursor and cursor ~= rig do
			if cursor:GetAttribute("EclipseArmature") == true then
				generated = true
				break
			end

			cursor = cursor.Parent
		end

		if generated then
			continue
		end

		if target:IsA("Bone") and target:GetAttribute("EclipseR6Control") == nil then
			candidate(target.Name, target, 3)
		elseif
			target:IsA("JointInstance")
			and target.Part0
			and target.Part1
			and motorByPart[target.Part1] == target
		then
			candidate(target.Part1.Name, target, 2)
		elseif target:IsA("BasePart") and not motorByPart[target] then
			candidate(target.Name, target, 2)
		end
	end

	for _, bone in data.bones do
		assert(
			typeof(bone.id) == "string" and not entries[bone.id],
			"Missing or duplicate armature bone identity"
		)
		entries[bone.id] = { data = bone }
		sourceByName[bone.name] = sourceByName[bone.name] or {}
		table.insert(sourceByName[bone.name], bone)
		binding.matrix(bone.rest_matrix)
		binding.matrix(bone.pose_matrix)
	end

	local geometryAncestors = {}
	for _, bone in data.bones do
		if bone.skinning == true or bone.geometry_binding == true then
			local cursor, seen = bone, {}
			while cursor and not seen[cursor.id] do
				seen[cursor.id] = true
				geometryAncestors[cursor.id] = true
				cursor = cursor.parent and entries[cursor.parent] and entries[cursor.parent].data
			end
		end
	end

	local function selectSource(name, sources)
		local candidates = {}
		for _, source in sources do
			if source.skinning == true or source.geometry_binding == true then
				table.insert(candidates, source)
			end
		end

		if #candidates == 0 then
			for _, source in sources do
				if geometryAncestors[source.id] then
					table.insert(candidates, source)
				end
			end
		end

		if #candidates == 0 then
			candidates = sources
		end

		local selected = #candidates == 1 and candidates[1] or nil
		if not selected and type(data.primary_armature) == "string" then
			for _, source in candidates do
				if source.armature == data.primary_armature then
					assert(not selected, "Ambiguous mesh bone in selected armature: " .. name)
					selected = source
				end
			end
		end

		assert(
			selected,
			"Ambiguous mesh bone: "
				.. name
				.. ". Select the armature that drives this rig and export its JSON again."
		)
		return selected
	end

	local pairs, deferred, claimed = {}, {}, {}
	local function fitWorld(source, target)
		if geometryFrames and source.geometry_binding == true and target:IsA("JointInstance") then
			return restWorld(target.Part1)
		end
		return restWorld(target)
	end
	local function fitPairs()
		for _, pair in pairs do
			pair.target = fitWorld(pair.data, pair.object)
		end
		return binding.fit(pairs)
	end

	local function attach(source, target)
		local entry = entries[source.id]
		entry.targets = entry.targets or {}
		table.insert(entry.targets, target)
		claimed[source.id] = true
	end

	local function bind(source, target)
		attach(source, target)
		table.insert(
			pairs,
			{
				source = binding.matrix(source.rest_matrix),
				target = restWorld(target),
				data = source,
				object = target,
			}
		)
	end

	for name, group in byName do
		local sources = sourceByName[name]
		if not sources then
			continue
		end

		local selected = selectSource(name, sources)
		local repeated = false
		if group.priority ~= 3 then
			for candidateName, candidates in sourceByName do
				local suffix = string.sub(candidateName, #name + 1)
				if
					string.sub(candidateName, 1, #name) == name
					and string.match(suffix, "^%.%d+$")
				then
					for _, candidate in candidates do
						if candidate.armature == selected.armature then
							repeated = true
						end
					end
				end
			end
		end
		if (#group.targets == 1 and (preferExact or not repeated)) or group.priority == 3 then
			for _, target in group.targets do
				bind(selected, target)
			end
		else
			table.insert(deferred, { name = name, group = group, selected = selected })
		end
	end

	local fit, scale, errorDistance, fitTolerance = fitPairs()
	local tolerance = math.max(fitTolerance, scale * 0.001, errorDistance * 4)
	table.sort(deferred, function(a, b)
		return a.name < b.name
	end)
	for _, item in deferred do
		local candidates = { item.selected }
		for name, sources in sourceByName do
			local suffix = string.sub(name, #item.name + 1)
			if
				string.sub(name, 1, #item.name) == item.name
				and (string.match(suffix, "^%d+%.?%d*$") or string.match(suffix, "^%.%d+$"))
			then
				local eligible = {}
				for _, source in sources do
					if source.armature == item.selected.armature and not claimed[source.id] then
						table.insert(eligible, source)
					end
				end

				if #eligible == 1 then
					table.insert(candidates, eligible[1])
				end
			end
		end

		for _, target in item.group.targets do
			local nearest, distance, second = nil, math.huge, math.huge
			if #item.group.targets == 1 then
				local position = fit * (binding.matrix(item.selected.rest_matrix).Position * scale)
				local delta = (position - fitWorld(item.selected, target).Position).Magnitude
				if delta <= tolerance then
					nearest, distance = item.selected, delta
				end
			end
			for _, source in candidates do
				if
					nearest == item.selected
					and #item.group.targets == 1
					and distance <= tolerance
				then
					break
				end
				if not claimed[source.id] or #candidates == 1 then
					local position = fit * (binding.matrix(source.rest_matrix).Position * scale)
					local delta = (position - fitWorld(source, target).Position).Magnitude
					if delta < distance then
						nearest, second, distance = source, distance, delta
					else
						second = math.min(second, delta)
					end
				end
			end

			assert(
				nearest and distance <= tolerance and second - distance > 0.0001,
				"Cannot uniquely match repeated rig part: "
					.. item.name
					.. ". The exported rest positions must match this rig."
			)
			bind(nearest, target)
		end
	end

	local follow, objects = binding.followers(data)
	local unmatched = {}
	for name, group in byName do
		if sourceByName[name] then
			continue
		end

		if not objects[name] then
			for _, target in group.targets do
				table.insert(unmatched, target)
			end

			continue
		end

		local boneId = follow(name)
		local source = boneId and entries[boneId] and entries[boneId].data
		if not source then
			continue
		end

		for _, target in group.targets do
			local carrier = target:IsA("JointInstance") and target.Part0
			if not (carrier and follow(carrier.Name) == boneId) then
				restWorld(target)
				attach(source, target)
			end
		end
	end

	local matches, uses = {}, {}
	for _, target in unmatched do
		local nearest, distance, second = nil, math.huge, math.huge
		for _, source in data.bones do
			if source.geometry_binding == true and not claimed[source.id] then
				local position = fit * (binding.matrix(source.rest_matrix).Position * scale)
				local delta = (position - fitWorld(source, target).Position).Magnitude
				if delta < distance then
					nearest, second, distance = source, distance, delta
				else
					second = math.min(second, delta)
				end
			end
		end

		if nearest and distance <= tolerance and second - distance > 0.0001 then
			matches[target] = nearest
			uses[nearest.id] = (uses[nearest.id] or 0) + 1
		end
	end

	for target, source in matches do
		if uses[source.id] == 1 then
			bind(source, target)
		end
	end

	fit, scale, errorDistance = fitPairs()
	for _, entry in entries do
		local parent, seen = entry.data.parent, { [entry.data.id] = true }
		while parent do
			assert(entries[parent] and not seen[parent], "Invalid exported bone hierarchy")
			seen[parent] = true
			parent = entries[parent].data.parent
		end
	end

	return {
		entries = entries,
		frame = fit,
		scale = scale,
		errorDistance = errorDistance,
		matched = #pairs,
		restWorlds = restCache,
	}
end

function plan.build(data, rig)
	local failure
	for _, geometryFrames in { true, false } do
		for _, preferExact in { true, false } do
			local ok, result = pcall(build, data, rig, geometryFrames, preferExact)
			if ok then
				return result
			end
			failure = failure or result
		end
	end
	error(failure, 0)
end

return plan
]]></ProtectedString>
