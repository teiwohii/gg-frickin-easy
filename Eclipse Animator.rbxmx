									<Content name="LinkedSource"><null></null></Content>
									<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local blocks = require(script.Parent.blocks)

local rgb = Color3.fromRGB

local solid = {
	Anchored = true,
	CanCollide = false,
	CanQuery = false,
	CanTouch = false,
	CastShadow = false,
	Material = Enum.Material.Neon,
	Color = rgb(255, 255, 255),
	Size = Vector3.new(2, 2, 2),
}

local function part(overrides)
	local properties = table.clone(solid)

	for name, value in overrides or {} do
		properties[name] = value
	end

	return properties
end

local image = {
	class = "ImageLabel",
	name = "Image",
	properties = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Image = blocks.textures.glow,
	},
}

local palette = {}

palette.categories = {
	{ title = "Effects", items = { "ParticleEmitter", "Beam", "Trail", "Attachment", "PointLight", "SpotLight", "SurfaceLight", "Highlight", "Fire", "Smoke", "Sparkles", "Sound" } },
	{ title = "Geometry", items = { "Part", "Ball", "Cylinder", "MeshPart", "SpecialMesh", "Model" } },
	{ title = "Visual", items = { "Decal", "Texture", "MeshFlipbook", "BillboardGui", "SurfaceGui" } },
	{ title = "Procedural Shapes", items = { "BeamRing", "PillarBeam", "SphereBeam", "EnergyBeam", "Slash", "Spiral", "Lightning", "Bezier" } },
	{ title = "Building Blocks", items = { "Burst", "Glow", "Sparks", "SmokePuff", "Aura", "Impact", "Energy", "Debris", "Projectile", "Flash" } },
}

palette.items = {
	ParticleEmitter = { label = "Particle Emitter", icon = "ParticleEmitter", kind = "instance", className = "ParticleEmitter", host = "point", properties = blocks.defaultEmitter, tip = "A particle emitter. Goes on the selected part or attachment, or gets its own emitter point." },
	Beam = { label = "Beam", icon = "Beam", kind = "instance", className = "Beam", host = "pair", properties = blocks.defaultBeam, offsets = { Vector3.new(0, 0, -3), Vector3.new(0, 0, 3) }, tip = "A beam between two attachments. Select two attachments to connect them, or get a new pair." },
	Trail = { label = "Trail", icon = "Trail", kind = "instance", className = "Trail", host = "pair", properties = blocks.defaultTrail, offsets = { Vector3.new(0, 0.5, 0), Vector3.new(0, -0.5, 0) }, tip = "A trail between two attachments. It draws when the part moves." },
	Attachment = { label = "Attachment", icon = "Attachment", kind = "instance", className = "Attachment", host = "part", tip = "A point on a part that emitters, beams, trails and lights can use." },
	PointLight = { label = "Point Light", icon = "PointLight", kind = "instance", className = "PointLight", host = "point", properties = { Brightness = 2, Range = 12, Shadows = false }, tip = "Light in every direction." },
	SpotLight = { label = "Spot Light", icon = "SpotLight", kind = "instance", className = "SpotLight", host = "point", properties = { Brightness = 2, Range = 16, Angle = 60, Shadows = false }, tip = "A cone of light." },
	SurfaceLight = { label = "Surface Light", icon = "SurfaceLight", kind = "instance", className = "SurfaceLight", host = "part", properties = { Brightness = 2, Range = 12, Shadows = false }, tip = "Light from one face of a part." },
	Highlight = { label = "Highlight", icon = "Highlight", kind = "instance", className = "Highlight", host = "adornee", properties = { FillTransparency = 0.5, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.Occluded }, tip = "An outline and fill around the selected part or model." },
	Fire = { label = "Fire", icon = "Fire", kind = "instance", className = "Fire", host = "point", tip = "Roblox's built-in fire." },
	Smoke = { label = "Smoke", icon = "Smoke", kind = "instance", className = "Smoke", host = "point", tip = "Roblox's built-in smoke." },
	Sparkles = { label = "Sparkles", icon = "Sparkles", kind = "instance", className = "Sparkles", host = "point", tip = "Roblox's built-in sparkles." },
	Sound = { label = "Sound", icon = "Sound", kind = "instance", className = "Sound", host = "anywhere", properties = { Volume = 0.5 }, tip = "A sound that plays on Emit and on its emit keyframes. On the selected part or attachment it is heard from there, otherwise it goes into the asset and is heard everywhere." },

	Part = { label = "Block", icon = "Part", kind = "instance", className = "Part", host = "world", properties = part(), tip = "A block part set up for VFX: anchored, no collisions, no shadow." },
	Ball = { label = "Ball", icon = "Part", kind = "instance", className = "Part", host = "world", name = "Ball", properties = part({ Shape = Enum.PartType.Ball }), tip = "A sphere part set up for VFX." },
	Cylinder = { label = "Cylinder", icon = "Part", kind = "instance", className = "Part", host = "world", name = "Cylinder", properties = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 4, 4) }), tip = "A cylinder part set up for VFX." },
	MeshPart = { label = "Mesh Part", icon = "MeshPart", kind = "instance", className = "MeshPart", host = "world", properties = part({ Material = Enum.Material.SmoothPlastic }), tip = "An empty mesh part. Paste a mesh id into Mesh in the inspector to load it." },
	SpecialMesh = { label = "Special Mesh", icon = "SpecialMesh", kind = "instance", className = "SpecialMesh", host = "basepart", properties = { MeshType = Enum.MeshType.FileMesh }, tip = "A mesh that sits on the selected part. Its mesh id and scale can be changed freely." },
	Model = { label = "Model", icon = "Model", kind = "instance", className = "Model", host = "world", tip = "An empty model to hold parts that move together." },

	Decal = { label = "Decal", icon = "Decal", kind = "instance", className = "Decal", host = "basepart", properties = { Texture = blocks.textures.glow, Face = Enum.NormalId.Top }, tip = "An image on one face of the selected part." },
	Texture = { label = "Texture", icon = "Texture", kind = "instance", className = "Texture", host = "basepart", properties = { Texture = blocks.textures.glow, Face = Enum.NormalId.Top }, tip = "A tiling image on one face of the selected part." },
	MeshFlipbook = { label = "Mesh Flipbook", icon = "Decal", kind = "instance", className = "Decal", host = "basepart", name = "Flipbook", properties = { Texture = blocks.textures.glow, Face = Enum.NormalId.Top }, surface = { Transparency = 1 }, flipbook = { source = "Sheet", columns = 1, rows = 1, count = 1 }, tip = "An image sequence that plays on the selected mesh or part. Give it a sprite sheet or a list of images in the inspector." },
	BillboardGui = { label = "Billboard", icon = "BillboardGui", kind = "instance", className = "BillboardGui", host = "point", properties = { Size = UDim2.fromScale(4, 4), LightInfluence = 0 }, children = { image }, tip = "An image that always faces the camera." },
	SurfaceGui = { label = "Surface Image", icon = "SurfaceGui", kind = "instance", className = "SurfaceGui", host = "basepart", properties = { Face = Enum.NormalId.Top, LightInfluence = 0 }, children = { image }, tip = "An image drawn on one face of the selected part." },

	BeamRing = { label = "Beam Ring", icon = "Beam", kind = "generator", generator = "BeamRing", tip = "A smooth textured ring made of curved beams." },
	Slash = { label = "Slash", icon = "Beam", kind = "generator", generator = "Slash", tip = "A crescent made of curved beams that taper at both ends." },
	Spiral = { label = "Spiral", icon = "Beam", kind = "generator", generator = "Spiral", tip = "A beam spiral with radius, height and turns." },
	Lightning = { label = "Lightning", icon = "Part", kind = "generator", generator = "Lightning", tip = "A jagged bolt with branches. Press Emit to make it strike, and change the seed for a new shape." },
	Bezier = { label = "Bezier Path", icon = "Beam", kind = "generator", generator = "Bezier", tip = "A curved beam path through four control points. Move the points, then rebuild." },

	Burst = { label = "Burst", icon = "ParticleEmitter", kind = "block", block = "Burst", tip = "Particles thrown out in every direction at once." },
	Glow = { label = "Glow", icon = "ParticleEmitter", kind = "block", block = "Glow", tip = "A soft glow with a light." },
	Sparks = { label = "Sparks", icon = "ParticleEmitter", kind = "block", block = "Sparks", tip = "Fast streaks that fall with gravity." },
	SmokePuff = { label = "Smoke Puff", icon = "ParticleEmitter", kind = "block", block = "SmokePuff", tip = "Slow smoke that grows and fades." },
	Aura = { label = "Aura", icon = "ParticleEmitter", kind = "block", block = "Aura", tip = "Particles rising from a circle." },
	Impact = { label = "Impact", icon = "ParticleEmitter", kind = "block", block = "Impact", tip = "Flash, shockwave, sparks and smoke in one hit." },
	Energy = { label = "Energy", icon = "ParticleEmitter", kind = "block", block = "Energy", tip = "A spinning core with particles pulled into it." },
	Debris = { label = "Debris", icon = "ParticleEmitter", kind = "block", block = "Debris", tip = "Chunks thrown up that fall back down." },
	Projectile = { label = "Projectile", icon = "Part", kind = "block", block = "Projectile", tip = "A glowing ball with a trail, a light and a particle wake." },
	Flash = { label = "Flash", icon = "PointLight", kind = "block", block = "Flash", tip = "A bright light with one large glow particle." },
	SphereBeam = { label = "Sphere Beam", icon = "Beam", kind = "generator", generator = "SphereBeam", tip = "A ball made of curved beams. Set its Radius, how many beams go around it and how many pieces each one has." },
	EnergyBeam = { label = "Energy Beam", icon = "Beam", kind = "generator", generator = "EnergyBeam", tip = "A long rounded beam that is thin at both tips and thick in the middle, with an optional bright core." },
	PillarBeam = { label = "Pillar Beam", icon = "Beam", kind = "generator", generator = "PillarBeam", tip = "A cylinder made of beams. Set its Height, and give its Bottom and Top their own radius, position, rotation and fade." },
}

return palette
]]></ProtectedString>
