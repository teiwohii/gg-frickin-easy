							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local changeHistoryService = game:GetService("ChangeHistoryService")

local ProjectFactory = {}
ProjectFactory.__index = ProjectFactory

ProjectFactory.projectAttribute = "ArcProject"
ProjectFactory.effectsName = "Effects"
ProjectFactory.baseName = "Base"

function ProjectFactory.new(template: Instance)
	local self = setmetatable({}, ProjectFactory)

	self.template = template
	self.lastOffset = Vector3.zero

	return self
end

function ProjectFactory:getLastOffset(): Vector3
	return self.lastOffset
end

function ProjectFactory:isFreeAttachment(instance: Instance): boolean
	local parent = instance.Parent

	return instance:IsA("Attachment") and (parent == nil or not (parent:IsA("BasePart") or parent:IsA("Attachment")))
end

function ProjectFactory:isProject(instance: Instance?): boolean
	if not instance or not instance:IsA("Folder") then
		return false
	end

	return instance:GetAttribute(ProjectFactory.projectAttribute) == true
end

function ProjectFactory:getEffects(project: Instance): Model?
	local effects = project:FindFirstChild(ProjectFactory.effectsName)

	if effects and effects:IsA("Model") then
		return effects
	end

	return nil
end

function ProjectFactory:isBasePart(instance: Instance): boolean
	return instance.Name == ProjectFactory.baseName and instance:IsA("BasePart")
end

function ProjectFactory:hasEffectsContent(effects: Model): boolean
	for _, child in effects:GetChildren() do
		if not self:isBasePart(child) then
			return true
		end
	end

	return false
end

function ProjectFactory:getOwningProject(instance: Instance): Instance?
	local current = instance

	while current do
		if self:isProject(current) then
			return current
		end

		current = current.Parent
	end

	return nil
end

function ProjectFactory:hasSelectedAncestor(instance: Instance, lookup: { [Instance]: boolean }): boolean
	local parent = instance.Parent

	while parent do
		if lookup[parent] then
			return true
		end

		parent = parent.Parent
	end

	return false
end

function ProjectFactory:getRootInstances(instances: { Instance }): { Instance }
	local lookup = {}

	for _, instance in instances do
		lookup[instance] = true
	end

	local roots = {}

	for _, instance in instances do
		if instance.Parent and not self:hasSelectedAncestor(instance, lookup) then
			table.insert(roots, instance)
		end
	end

	return roots
end

function ProjectFactory:getWorldBounds(instances: { Instance }): (Vector3?, Vector3?)
	local minimum = Vector3.one * math.huge
	local maximum = Vector3.one * -math.huge
	local found = false

	local function include(cframe: CFrame, size: Vector3)
		local half = size / 2

		for _, x in { -1, 1 } do
			for _, y in { -1, 1 } do
				for _, z in { -1, 1 } do
					local corner = cframe * Vector3.new(half.X * x, half.Y * y, half.Z * z)
					minimum = minimum:Min(corner)
					maximum = maximum:Max(corner)
				end
			end
		end

		found = true
	end

	for _, instance in instances do
		if instance:IsA("BasePart") then
			include(instance.CFrame, instance.Size)
		end

		for _, descendant in instance:GetDescendants() do
			if descendant:IsA("BasePart") then
				include(descendant.CFrame, descendant.Size)
			elseif self:isFreeAttachment(descendant) then
				include(descendant.WorldCFrame, Vector3.zero)
			end
		end

		if instance:IsA("Attachment") then
			include(instance.WorldCFrame, Vector3.zero)
		end
	end

	if not found then
		return nil, nil
	end

	return minimum, maximum
end

function ProjectFactory:translate(instances: { Instance }, offset: Vector3)
	local moved = {}

	local function moveInstance(instance: Instance)
		if moved[instance] then
			return
		end

		moved[instance] = true

		if instance:IsA("BasePart") then
			instance.CFrame += offset
		elseif self:isFreeAttachment(instance) then
			instance.CFrame += offset
		elseif instance:IsA("Model") and not instance.PrimaryPart then
			instance.WorldPivot += offset
		end
	end

	for _, instance in instances do
		moveInstance(instance)

		for _, descendant in instance:GetDescendants() do
			moveInstance(descendant)
		end
	end
end

function ProjectFactory:placeBase(effects: Model, instances: { Instance })
	local base = effects.PrimaryPart or effects:FindFirstChild(ProjectFactory.baseName)

	if not base or not base:IsA("BasePart") then
		return
	end

	effects.PrimaryPart = base

	local minimum, maximum = self:getWorldBounds(instances)

	if minimum and maximum then
		local center = (minimum + maximum) / 2

		base.CFrame = CFrame.new(center) * base.CFrame.Rotation
		self.lastOffset = Vector3.zero
	end
end

function ProjectFactory:createEmpty(name: string, pivot: CFrame?): Instance
	local project = self.template:Clone()

	project.Name = name
	project:SetAttribute(ProjectFactory.projectAttribute, true)

	local effects = project.Effects
	local base = effects:FindFirstChild(ProjectFactory.baseName)

	if base and base:IsA("BasePart") then
		effects.PrimaryPart = base
	end

	if pivot then
		effects:PivotTo(pivot)
	end

	self.lastOffset = Vector3.zero
	project.Parent = workspace

	return project
end

function ProjectFactory:create(name: string, instances: { Instance }): (Instance?, { Instance })
	local recording = changeHistoryService:TryBeginRecording("Arc: Create Project")

	local project = self.template:Clone()
	project.Name = name
	project:SetAttribute(ProjectFactory.projectAttribute, true)
	project.Parent = workspace

	local effects = project.Effects
	local failed = {}
	local roots = self:getRootInstances(instances)

	self.lastOffset = Vector3.zero
	self:placeBase(effects, roots)

	for _, instance in roots do
		local moved = pcall(function()
			instance.Parent = effects
		end)

		if not moved then
			table.insert(failed, instance)
		end
	end

	if recording then
		changeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
	end

	return project, failed
end

return ProjectFactory
]]></ProtectedString>
							<string name="ScriptGuid">{F8176EF4-98AB-46C1-A0F5-8EA9BD3ADD6D}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">ProjectFactory</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX7441A1927C9D415FAF0530D886FC5E81">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local Organizer = {}
Organizer.__index = Organizer

Organizer.containerName = "Organization"
Organizer.folderAttribute = "ArcFolder"
Organizer.anchorName = "Anchor"
Organizer.memberName = "Member"
Organizer.indexAttribute = "Index"
Organizer.defaultName = "Folder"
Organizer.particleGroupAttribute = "ArcParticleGroup"

function Organizer.new(project: Instance)
	local self = setmetatable({}, Organizer)

	self.project = project
	self.container = nil
	self.owners = {}
	self.members = {}
	self.anchors = {}

	self:load()

	return self
 end

function Organizer:getContainer(create: boolean): Folder?
	if self.container and self.container.Parent == self.project then
		return self.container
	end

	local container = self.project:FindFirstChild(Organizer.containerName)

	if not container and create then
		container = Instance.new("Folder")
		container.Name = Organizer.containerName
		container.Parent = self.project
	end

	self.container = container

	return container
end

function Organizer:isFolder(instance: Instance?): boolean
	return instance ~= nil and instance:IsA("Folder") and instance:GetAttribute(Organizer.folderAttribute) == true
end

function Organizer:isParticleGroup(instance: Instance?): boolean
	return self:isFolder(instance) and instance:GetAttribute(Organizer.particleGroupAttribute) == true
end

function Organizer:getParticleGroup(item: Instance): Folder?
	local record = self.owners[item]
	local guard = 0

	while record and guard < 64 do
		if self:isParticleGroup(record) then
			return record
		end

		record = self.owners[record]
		guard += 1
	end

	return nil
end

function Organizer:getParticleGroups(): { Folder }
	local groups = {}

	for record in self.members do
		if record.Parent and self:isParticleGroup(record) then
			table.insert(groups, record)
		end
	end

	return groups
end

function Organizer:isAlive(instance: Instance?): boolean
	if not instance or not instance.Parent then
		return false
	end

	return instance:IsDescendantOf(self.project)
end

function Organizer:getRecords(): { Folder }
	local container = self:getContainer(false)
	local records = {}

	if container then
		for _, child in container:GetChildren() do
			if self:isFolder(child) then
				table.insert(records, child)
			end
		end
	end

	return records
end

function Organizer:readMembers(record: Folder): { Instance }
	local values = {}

	for _, child in record:GetChildren() do
		if child:IsA("ObjectValue") and child.Name == Organizer.memberName then
			table.insert(values, child)
		end
	end

	table.sort(values, function(a, b)
		return (a:GetAttribute(Organizer.indexAttribute) or 0) < (b:GetAttribute(Organizer.indexAttribute) or 0)
	end)

	local members = {}

	for _, value in values do
		if self:isAlive(value.Value) then
			table.insert(members, value.Value)
		end
	end

	return members
end

function Organizer:readAnchor(record: Folder): Instance?
	local anchor = record:FindFirstChild(Organizer.anchorName)

	if anchor and anchor:IsA("ObjectValue") and self:isAlive(anchor.Value) then
		return anchor.Value
	end

	return nil
end

function Organizer:load()
	table.clear(self.owners)
	table.clear(self.members)
	table.clear(self.anchors)

	for _, record in self:getRecords() do
		self.members[record] = self:readMembers(record)
		self.anchors[record] = self:readAnchor(record)
	end

	for record, members in self.members do
		for _, member in members do
			if not self.owners[member] then
				self.owners[member] = record
			end
		end
	end
end

function Organizer:write(record: Folder)
	for _, child in record:GetChildren() do
		if child:IsA("ObjectValue") then
			child:Destroy()
		end
	end

	local anchor = self.anchors[record]

	if anchor then
		local value = Instance.new("ObjectValue")
		value.Name = Organizer.anchorName
		value.Value = anchor
		value.Parent = record
	end

	for index, member in self.members[record] or {} do
		local value = Instance.new("ObjectValue")
		value.Name = Organizer.memberName
		value.Value = member
		value:SetAttribute(Organizer.indexAttribute, index)
		value.Parent = record
	end
end

function Organizer:getOwner(item: Instance): Folder?
	return self.owners[item]
end

function Organizer:getMembers(record: Folder): { Instance }
	local members = {}

	for _, member in self.members[record] or {} do
		if self:isAlive(member) then
			table.insert(members, member)
		end
	end

	return members
end

function Organizer:getTopRecord(item: Instance): Folder?
	local record = self.owners[item]
	local guard = 0

	while record and self.owners[record] and guard < 64 do
		record = self.owners[record]
		guard += 1
	end

	return record
end

function Organizer:getDisplayChildren(parent: Instance): { Instance }
	if self:isFolder(parent) then
		return self:getMembers(parent)
	end

	local children = {}
	local emitted = {}

	for _, child in parent:GetChildren() do
		local top = self:getTopRecord(child)

		if not top then
			table.insert(children, child)
		elseif self.anchors[top] == parent and not emitted[top] then
			emitted[top] = true
			table.insert(children, top)
		end
	end

	for record, anchor in self.anchors do
		if anchor == parent and not emitted[record] and not self.owners[record] and record.Parent then
			emitted[record] = true
			table.insert(children, record)
		end
	end

	return children
end

function Organizer:getListParent(item: Instance): Instance?
	return self.owners[item] or item.Parent
end

function Organizer:containsRecord(record: Folder, target: Instance): boolean
	if record == target then
		return true
	end

	for _, member in self.members[record] or {} do
		if self:isFolder(member) and self:containsRecord(member, target) then
			return true
		end
	end

	return false
end

function Organizer:removeFromOwner(item: Instance)
	local owner = self.owners[item]

	if not owner then
		return
	end

	local members = self.members[owner]
	local index = members and table.find(members, item)

	if index then
		table.remove(members, index)
	end

	self.owners[item] = nil
	self:write(owner)
end

function Organizer:filterItems(items: { Instance }): { Instance }
	local filtered = {}
	local seen = {}

	for _, item in items do
		if not seen[item] and self:isAlive(item) then
			seen[item] = true
			table.insert(filtered, item)
		end
	end

	local result = {}

	for _, item in filtered do
		local covered = false

		for _, other in filtered do
			if other ~= item and not self:isFolder(other) and item:IsDescendantOf(other) and not self.owners[item] then
				covered = true
				break
			end
		end

		if not covered then
			table.insert(result, item)
		end
	end

	return result
end

function Organizer:createFolder(items: { Instance }, options): Folder?
	options = options or {}

	local members = self:filterItems(items)

	if #members == 0 then
		return nil
	end

	local first = members[1]
	local owner = self.owners[first]
	local container = self:getContainer(true)
	local record = Instance.new("Folder")

	record.Name = options.name or Organizer.defaultName
	record:SetAttribute(Organizer.folderAttribute, true)

	if options.particleGroup then
		record:SetAttribute(Organizer.particleGroupAttribute, true)
	end

	local insertIndex = nil

	if owner then
		insertIndex = table.find(self.members[owner], first)
	else
		self.anchors[record] = first.Parent
	end

	for _, member in members do
		self:removeFromOwner(member)
	end

	self.members[record] = members

	for _, member in members do
		self.owners[member] = record
	end

	record.Parent = container
	self:write(record)

	if owner then
		local ownerMembers = self.members[owner]
		table.insert(ownerMembers, math.clamp(insertIndex or #ownerMembers + 1, 1, #ownerMembers + 1), record)
		self.owners[record] = owner
		self:write(owner)
	end

	return record
end

function Organizer:ungroup(record: Folder): { Instance }?
	if not self:isFolder(record) or not self.members[record] then
		return nil
	end

	local members = self:getMembers(record)
	local owner = self.owners[record]
	local anchor = self.anchors[record]

	if owner then
		local ownerMembers = self.members[owner]
		local index = table.find(ownerMembers, record) or #ownerMembers + 1

		if ownerMembers[index] == record then
			table.remove(ownerMembers, index)
		end

		for offset, member in members do
			table.insert(ownerMembers, math.min(index + offset - 1, #ownerMembers + 1), member)
			self.owners[member] = owner
		end

		self:write(owner)
	else
		for _, member in members do
			self.owners[member] = nil

			if self:isFolder(member) then
				self.anchors[member] = anchor
				self:write(member)
			end
		end
	end

	self.owners[record] = nil
	self.members[record] = nil
	self.anchors[record] = nil
	record:Destroy()

	return members
end

function Organizer:canMoveInto(item: Instance, record: Folder): boolean
	if item == record or not self:isAlive(item) or self.owners[item] == record then
		return false
	end

	if self:isFolder(item) and self:containsRecord(item, record) then
		return false
	end

	if self:isParticleGroup(record) and not item:IsA("ParticleEmitter") then
		return false
	end

	return true
end

function Organizer:moveInto(items: { Instance }, record: Folder): boolean
	if not self:isFolder(record) or not self.members[record] then
		return false
	end

	local moved = false

	for _, item in items do
		if self:canMoveInto(item, record) then
			self:removeFromOwner(item)

			if self:isFolder(item) then
				self.anchors[item] = nil
			end

			table.insert(self.members[record], item)
			self.owners[item] = record

			if self:isFolder(item) then
				self:write(item)
			end

			moved = true
		end
	end

	if moved then
		self:write(record)
	end

	return moved
end

function Organizer:moveOut(items: { Instance }): boolean
	local moved = false

	for _, item in items do
		if self.owners[item] then
			local top = self:getTopRecord(item)
			local anchor = top and self.anchors[top]

			self:removeFromOwner(item)

			if self:isFolder(item) then
				self.anchors[item] = anchor
				self:write(item)
			end

			moved = true
		end
	end

	return moved
end

function Organizer:rename(record: Folder, name: string)
	local trimmed = string.gsub(name, "^%s+", "")
	trimmed = string.gsub(trimmed, "%s+$", "")

	if trimmed ~= "" and self:isFolder(record) then
		record.Name = trimmed
	end
end

function Organizer:collectInstances(record: Folder, into: { Instance }?): { Instance }
	local result = into or {}

	for _, member in self:getMembers(record) do
		if self:isFolder(member) then
			self:collectInstances(member, result)
		else
			table.insert(result, member)
		end
	end

	return result
end

return Organizer
]]></ProtectedString>
