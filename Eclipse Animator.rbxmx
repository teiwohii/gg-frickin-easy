						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local authored = {}

function authored.hasMotion(timeline, motor, bucket)
	local raw = timeline:GetState()
	local active = require("policy").activeBucket(bucket)
	if not active or not next(active) then
		return false
	end
	local first = active[0]
	if not first or first.Authored == true or first.Parented == false or first.WorldCFrame or first.MasterWorld then
		return true
	end
	for frame in active do
		if frame ~= 0 then
			return true
		end
	end
	for _, name in { "IK", "HeadStabilizer", "CamTrackTo", "CamTargetEnabled", "CamTargetParent", "CamAttachTarget", "BlenderCurve", "PhysicsClip" } do
		if first[name] ~= nil then
			return true
		end
	end
	if require("properties").is(motor) or require("cameraRig").isFov(motor) then
		return true
	end
	local rest = raw.DefaultPose[motor]
	if typeof(rest) ~= "CFrame" then
		return true
	end
	local pose = timeline:EvaluateMotorJointC0(motor, 0, active)
	if typeof(pose) ~= "CFrame" or not rest:FuzzyEq(pose, 1e-6) then
		return true
	end
	local scale = timeline:EvaluateMotorScale(motor, 0, active)
	for _, id in { "scale_x", "scale_y", "scale_z" } do
		if scale and math.abs((scale[id] or 1) - 1) > 1e-6 then
			return true
		end
	end
	return false
end

function authored.plan(timeline)
	local raw = timeline:GetState()
	local layers = require("layers")
	local result = {}
	for motor in raw.DefaultPose do
		result[motor] = false
	end
	for motor in raw.Keyframes do
		result[motor] = false
	end
	local function add(tracks)
		for motor, bucket in tracks do
			if not result[motor] then
				result[motor] = authored.hasMotion(timeline, motor, bucket)
			end
		end
	end
	if layers.has(raw) then
		for _, layer in layers.ensure(raw).layers do
			for motor in layer.keys do
				result[motor] = false
			end
		end
		for _, layer in layers.ensure(raw).layers do
			if not layer.muted then
				add(layer.keys)
			end
		end
	else
		add(raw.Keyframes)
	end
	return result
end

return authored
]]></ProtectedString>
