return function(require)
	local c = {}
	local visuals = setmetatable({}, { __mode = "k" })
	function c.new()
		return {
			own = function() end,
			remember = function() end,
			update = function() end,
			finish = function() end,
		}
	end
	function c.visual(o)
		visuals[o] = true
	end
	function c.isVisual(o)
		return visuals[o] ~= nil
	end
	return c
end
]]></ProtectedString>
