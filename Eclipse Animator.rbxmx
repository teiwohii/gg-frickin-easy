						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local tweenService = game:GetService("TweenService")
local theme = require("theme")
local windowFx = require("windowFx")
local motion = require("motion")
local chrome = require("chrome")
local inputModule = require("userInputService")
local FxLayout = require("FxLayout")

local FxWindow = {}
FxWindow.__index = FxWindow

local moveInfo = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local gripSize = 12
local cursors = {
	BottomLeft = "rbxasset://SystemCursors/SizeNESW",
	BottomRight = "rbxasset://SystemCursors/SizeNWSE",
	TopLeft = "rbxasset://SystemCursors/SizeNWSE",
	TopRight = "rbxasset://SystemCursors/SizeNESW",
}
local gripAnchors = {
	BottomLeft = Vector2.new(0, 1),
	BottomRight = Vector2.new(1, 1),
	TopLeft = Vector2.new(0, 0),
	TopRight = Vector2.new(1, 0),
}

local function make(className, parent, name, props)
	local object = Instance.new(className)
	object.Name = name
	for key, value in props do
		object[key] = value
	end

	object.Parent = parent
	return object
end

local function tag(object, attribute, key)
	object:SetAttribute(attribute, key)
	return object
end

local function round(object, radius)
	make("UICorner", object, "Corner", { CornerRadius = UDim.new(0, radius) })
end

local function outline(object, transparency)
	return tag(
		make("UIStroke", object, "Outline", {
			Color = theme.panelOutlineDefault(),
			Thickness = 1,
			Transparency = transparency or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
		"ThemeStrk",
		"Strk"
	)
end

function FxWindow.new(options)
	local self = setmetatable({
		options = options,
		name = options.name,
		size = options.size,
		preferred = options.size,
		minSize = options.minSize or Vector2.new(140, 80),
		position = Vector2.zero,
		zIndex = options.zIndex or 90,
		open = false,
		hidden = false,
		connections = {},
		destroyed = false,
	}, FxWindow)

	self:build()
	return self
end

function FxWindow:connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(self.connections, connection)
	return connection
end

function FxWindow:build()
	local options = self.options
	local z = self.zIndex
	local titleHeight = options.title and (options.titleHeight or 30) or 0
	local inset = options.inset or 8
	local window = tag(
		make("Frame", nil, options.name, {
			AnchorPoint = Vector2.zero,
			Size = UDim2.fromOffset(self.size.X, self.size.Y),
			BackgroundColor3 = Color3.fromRGB(22, 16, 28),
			BorderSizePixel = 0,
			Active = true,
			Visible = false,
			ZIndex = z,
		}),
		"ThemeBg",
		"Bg"
	)
	round(window, 6)
	outline(window)

	if options.title then
		self.titleLabel = tag(
			make("TextLabel", window, "Title", {
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(1, options.closable and -44 or -24, 0, titleHeight),
				BackgroundTransparency = 1,
				Text = options.title,
				FontFace = chrome.FONT,
				TextSize = options.titleSize or 15,
				TextColor3 = Color3.fromRGB(230, 223, 238),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = z + 2,
			}),
			"ThemeTxt",
			"Txt"
		)

		if options.draggable then
			self.dragHandle = make("TextButton", window, "DragHandle", {
				Position = UDim2.new(),
				Size = UDim2.new(1, options.closable and -36 or 0, 0, titleHeight),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Active = true,
				ZIndex = z + 3,
			})
		end

		if options.closable then
			self.closeButton = chrome.close(window, nil, z + 4)
			self.closeButton.AnchorPoint = Vector2.new(1, 0.5)
			self.closeButton.Position = UDim2.new(1, -8, 0, titleHeight / 2)
			self.closeButton.Size = UDim2.fromOffset(18, 18)
			local icon = self.closeButton:FindFirstChild("Icon")
			if icon then
				icon.Size = UDim2.fromOffset(12, 12)
			end
		end
	end

	local body = tag(
		make("Frame", window, "Body", {
			Position = UDim2.fromOffset(inset, titleHeight > 0 and titleHeight + 2 or inset),
			Size = UDim2.new(1, -inset * 2, 1, -(titleHeight > 0 and titleHeight + 2 or inset) - inset),
			BackgroundColor3 = Color3.fromRGB(15, 12, 19),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = z + 1,
		}),
		"ThemeBg",
		"Pnl"
	)
	round(body, 5)
	outline(body, 0.35)

	self.frame = window
	self.body = body
	self.grips = {}
	for _, corner in options.grips or {} do
		self:addGrip(corner)
	end

	FxLayout.centerTree(window, { [body] = true })
	theme.applyTree(window)
	window.Parent = options.parent
end

function FxWindow:setCursor(icon)
	local mouse = self.options.mouse
	if mouse then
		pcall(function()
			mouse.Icon = icon or ""
		end)
	end
end

function FxWindow:showGrips(corners)
	local wanted = {}
	for _, corner in corners do
		wanted[corner] = true
		if not self.grips[corner] then
			self:addGrip(corner)
		end
	end

	for corner, grip in self.grips do
		grip.Visible = wanted[corner] == true
	end
end

function FxWindow:addGrip(corner)
	local grip = make("TextButton", self.frame, "Resize" .. corner, {
		AnchorPoint = gripAnchors[corner],
		Position = UDim2.fromScale(gripAnchors[corner].X, gripAnchors[corner].Y),
		Size = UDim2.fromOffset(gripSize, gripSize),
		Text = "",
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Active = true,
		Selectable = false,
		ZIndex = self.zIndex + 10,
	})
	FxLayout.center(grip)
	self.grips[corner] = grip

	self:connect(grip.MouseEnter, function()
		self:setCursor(cursors[corner])
	end)
	self:connect(grip.MouseLeave, function()
		if not self.resizing then
			self:setCursor(nil)
		end
	end)
	self:connect(grip.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		inputModule.trackGuiPress(input, grip)
		local start = inputModule:GetMouseLocation()
		local startSize = self.size
		local growLeft = corner == "BottomLeft" or corner == "TopLeft"
		local growUp = corner == "TopLeft" or corner == "TopRight"
		self.resizing = true
		self:track(input, function()
			local delta = (inputModule:GetMouseLocation() - start) / motion.scale(self.frame)
			local width = growLeft and startSize.X - delta.X or startSize.X + delta.X
			local height = growUp and startSize.Y - delta.Y or startSize.Y + delta.Y
			self:resize(Vector2.new(width, height), true)
		end, function()
			self.resizing = false
			self:setCursor(nil)
			if self.options.onResizeEnded then
				self.options.onResizeEnded(self.size)
			end
		end)
	end)
end

function FxWindow:track(input, onMove, onEnd)
	if self.drag then
		self.drag.finish()
	end

	local drag = { connections = {} }
	self.drag = drag

	function drag.finish()
		if self.drag ~= drag then
			return
		end

		self.drag = nil
		for _, connection in drag.connections do
			connection:Disconnect()
		end

		if onEnd then
			onEnd()
		end
	end

	table.insert(
		drag.connections,
		inputModule.InputChanged:Connect(function(changed)
			if changed.UserInputType == Enum.UserInputType.MouseMovement then
				onMove()
			end
		end)
	)
	table.insert(
		drag.connections,
		inputModule.InputEnded:Connect(function(ended)
			if ended.UserInputType == input.UserInputType then
				drag.finish()
			end
		end)
	)
	table.insert(drag.connections, inputModule.WindowFocusReleased:Connect(drag.finish))
end

function FxWindow:clampSize(size)
	local maximum = self.maxSize or Vector2.new(4000, 4000)
	return Vector2.new(
		math.clamp(math.floor(size.X + 0.5), self.minSize.X, math.max(self.minSize.X, maximum.X)),
		math.clamp(math.floor(size.Y + 0.5), self.minSize.Y, math.max(self.minSize.Y, maximum.Y))
	)
end

function FxWindow:setMaxSize(size)
	self.maxSize = size
end

function FxWindow:setPreferred(size)
	self.preferred = self:clampSize(size)
end

function FxWindow:resize(size, byUser)
	size = self:clampSize(size)
	if size == self.size and size == self.preferred then
		return
	end

	self.preferred = size
	self.size = size
	self.frame.Size = UDim2.fromOffset(size.X, size.Y)
	self.frame.Position = FxLayout.centered(self.position, size)
	if self.options.onResize then
		self.options.onResize(size, byUser)
	end
end

function FxWindow:arrange(position, size, animated)
	position = Vector2.new(math.floor(position.X + 0.5), math.floor(position.Y + 0.5))
	size = Vector2.new(
		math.max(math.floor(size.X + 0.5), self.minSize.X),
		math.max(math.floor(size.Y + 0.5), self.minSize.Y)
	)
	local changed = position ~= self.position or size ~= self.size
	self.position = position
	self.size = size
	if self.freshShow then
		self.freshShow = false
		animated = false
	end

	if self.moveTween then
		self.moveTween:Cancel()
		self.moveTween = nil
	end

	local targetPosition = FxLayout.centered(position, size)
	local targetSize = UDim2.fromOffset(size.X, size.Y)
	if animated and changed and self.frame.Visible and not self.resizing then
		self.moveTween = tweenService:Create(self.frame, moveInfo, { Position = targetPosition, Size = targetSize })
		self.moveTween:Play()
	else
		self.frame.Position = targetPosition
		self.frame.Size = targetSize
	end
end

function FxWindow:place(position, animated)
	position = Vector2.new(math.floor(position.X + 0.5), math.floor(position.Y + 0.5))
	local target = FxLayout.centered(position, self.size)
	local moved = position ~= self.position
	self.position = position
	if self.freshShow then
		self.freshShow = false
		animated = false
	end

	if self.moveTween then
		self.moveTween:Cancel()
		self.moveTween = nil
	end

	if animated and moved and self.frame.Visible then
		self.moveTween = tweenService:Create(self.frame, moveInfo, { Position = target })
		self.moveTween:Play()
	else
		self.frame.Position = target
	end
end

function FxWindow:isShown()
	return self.open and not self.hidden
end

function FxWindow:apply(instant)
	local show = self:isShown()
	local frame = self.frame
	if show == self.applied and not instant then
		return
	end

	self.applied = show
	if show then
		self.freshShow = true
	end

	if instant then
		windowFx.clear(frame)
		frame.Visible = show
	elseif show then
		frame.Visible = true
		windowFx.pop(frame, "batch")
	else
		windowFx.shrink(frame, function()
			if not self:isShown() then
				frame.Visible = false
			end
		end, "batch")
	end

	if self.options.onShownChanged then
		self.options.onShownChanged(show)
	end
end

function FxWindow:setState(open, hidden, instant)
	if self.destroyed then
		return
	end

	self.open = open == true
	self.hidden = hidden == true
	self:apply(instant)
end

function FxWindow:setOpen(open, instant)
	if self.destroyed then
		return
	end

	self.open = open == true
	self:apply(instant)
end

function FxWindow:setHidden(hidden, instant)
	if self.destroyed then
		return
	end

	self.hidden = hidden == true
	self:apply(instant)
end

function FxWindow:setTitle(text)
	if self.titleLabel then
		self.titleLabel.Text = text
	end
end

function FxWindow:rect()
	return self.position, self.size
end

function FxWindow:destroy()
	if self.destroyed then
		return
	end

	self.destroyed = true
	if self.drag then
		self.drag.finish()
	end

	if self.moveTween then
		self.moveTween:Cancel()
	end

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	windowFx.clear(self.frame)
	self.frame:Destroy()
end

return FxWindow
]]></ProtectedString>
						<string name="ScriptGuid">{E4934498-B61F-4E9B-9A38-D72ACA7DEC3C}</string>
