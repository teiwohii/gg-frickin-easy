						<Item class="ModuleScript" referent="RBX2AB3E4B234FA43478D1EF56ED3832603">
							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local PremiumGate = require(script.Parent.Parent.Parent.Premium.PremiumGate)
local colorOps = require(script.Parent.Parent.colorOps)
local sequenceTools = require(script.Parent.Parent.sequenceTools)
local spatial = require(script.Parent.Parent.spatial)
local Tool = require(script.Parent.Tool)

local AdvancedRandomTool = Tool.extend()

AdvancedRandomTool.id = "AdvancedRandomize"
AdvancedRandomTool.title = "Advanced Randomization"
AdvancedRandomTool.keywords = "random range min max variation premium seed"
AdvancedRandomTool.feature = "advancedRandomize"
AdvancedRandomTool.maximumSeed = 9999
AdvancedRandomTool.axes = { "X", "Y", "Z" }
AdvancedRandomTool.emptyText = "Select objects to see which properties can be randomized."
AdvancedRandomTool.noneEnabled = "Tick at least one property to randomize."

AdvancedRandomTool.properties = {
	{
		id = "Size",
		label = "Size",
		default = NumberRange.new(0.8, 1.2),
		range = { min = 0.1, max = 3 },
		minimum = 0.01,
		tip = "Each object is scaled by a random amount between Min and Max. 1 keeps its size.",
	},
	{
		id = "Rotation",
		label = "Rotation",
		default = NumberRange.new(-45, 45),
		range = { min = -180, max = 180 },
		tip = "Each object turns by a random number of degrees between Min and Max around the axis below.",
	},
	{
		id = "Transparency",
		label = "Transparency",
		default = NumberRange.new(0, 0.5),
		range = { min = 0, max = 1 },
		minimum = 0,
		maximum = 1,
		tip = "Each object gets a random transparency between Min and Max. Particles, beams and trails keep their own fade shape.",
	},
	{
		id = "Color",
		label = "Color",
		tip = "Each object gets a random color between the two colors. Brightness and gradients are kept.",
	},
	{
		id = "Lifetime",
		label = "Lifetime",
		default = NumberRange.new(0.8, 1.2),
		range = { min = 0.1, max = 3 },
		minimum = 0.01,
		tip = "Particle and trail lifetime is multiplied by a random amount between Min and Max.",
	},
	{
		id = "Speed",
		label = "Speed",
		default = NumberRange.new(0.8, 1.2),
		range = { min = 0.1, max = 3 },
		minimum = 0,
		tip = "Particle speed and beam texture speed are multiplied by a random amount between Min and Max.",
	},
	{
		id = "Rate",
		label = "Rate",
		default = NumberRange.new(0.8, 1.2),
		range = { min = 0.1, max = 3 },
		minimum = 0,
		tip = "Particle rate and emit count are multiplied by a random amount between Min and Max.",
	},
	{
		id = "Brightness",
		label = "Brightness",
		default = NumberRange.new(0.8, 1.2),
		range = { min = 0, max = 3 },
		minimum = 0,
		tip = "Brightness of particles, beams, trails and lights is multiplied by a random amount between Min and Max.",
	},
}

function AdvancedRandomTool.new(context)
	local self = setmetatable({}, AdvancedRandomTool)
	local defaults = {
		RotationAxis = "Y",
		ColorFrom = Color3.fromRGB(255, 170, 60),
		ColorTo = Color3.fromRGB(255, 70, 40),
		Seed = 1,
	}

	for _, property in AdvancedRandomTool.properties do
		defaults["Use" .. property.id] = false

		if property.default then
			defaults[property.id] = property.default
		end
	end

	Tool.init(self, context, defaults)

	return self
end

function AdvancedRandomTool:isUnlocked(): boolean
	return PremiumGate.get():isUnlocked(AdvancedRandomTool.feature)
end

function AdvancedRandomTool:supports(id: string, instance: Instance, isRoot: boolean): boolean
	if id == "Size" then
		return isRoot
	elseif id == "Rotation" then
		return (isRoot and spatial.isSpatial(instance)) or instance:IsA("ParticleEmitter")
	elseif id == "Transparency" then
		return (instance:IsA("BasePart") and instance.Transparency < 1) or instance:IsA("Decal") or instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail")
	elseif id == "Color" then
		return colorOps.getNames(instance) ~= nil and not colorOps.isHolder(instance)
	elseif id == "Lifetime" then
		return instance:IsA("ParticleEmitter") or instance:IsA("Trail")
	elseif id == "Speed" then
		return instance:IsA("ParticleEmitter") or instance:IsA("Beam")
	elseif id == "Rate" then
		return instance:IsA("ParticleEmitter")
	elseif id == "Brightness" then
		return instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Light")
	end

	return false
end

function AdvancedRandomTool:getCompatible(): { [string]: boolean }
	local compatible = {}
	local roots = {}

	for _, root in self:getRoots() do
		roots[root] = true
	end

	for _, instance in self:getAffected() do
		for _, property in AdvancedRandomTool.properties do
			if not compatible[property.id] and self:supports(property.id, instance, roots[instance] == true) then
				compatible[property.id] = true
			end
		end
	end

	return compatible
end

function AdvancedRandomTool:getSignature(): string
	if not self:isUnlocked() then
		return "locked"
	end

	local compatible = self:getCompatible()
	local parts = {}

	for _, property in AdvancedRandomTool.properties do
		if compatible[property.id] then
			table.insert(parts, property.id .. (if self.params["Use" .. property.id] then "+" else "-"))
		end
	end

	return table.concat(parts, ",")
end

function AdvancedRandomTool:note(name: string, text: string)
	return {
		id = self:getId(name),
		kind = "note",
		text = text,
		keywords = self.title .. " " .. self.keywords,
	}
end

function AdvancedRandomTool:toggle(property)
	local name = "Use" .. property.id

	return self:field(name, property.label, "toggle", {
		tip = property.tip,
		onChange = function(value)
			if value ~= nil then
				self.params[name] = value == true
				task.defer(self.context.rebuildTools)
			end
		end,
	})
end

function AdvancedRandomTool:getFields()
	if not self:isUnlocked() then
		return { self:note("Locked", (PremiumGate.get():describe(AdvancedRandomTool.feature))) }
	end

	local compatible = self:getCompatible()
	local fields = {}

	for _, property in AdvancedRandomTool.properties do
		if compatible[property.id] then
			table.insert(fields, self:toggle(property))

			if self.params["Use" .. property.id] then
				if property.id == "Color" then
					table.insert(fields, self:field("ColorFrom", "From", "color"))
					table.insert(fields, self:field("ColorTo", "To", "color"))
				else
					table.insert(fields, self:field(property.id, "Min / Max", "range", {
						range = property.range,
						minimum = property.minimum,
						maximum = property.maximum,
						clamp = property.maximum ~= nil,
						tip = property.tip,
					}))
				end

				if property.id == "Rotation" then
					table.insert(fields, self:choice("RotationAxis", "Axis", AdvancedRandomTool.axes))
				end
			end
		end
	end

	if #fields == 0 then
		return { self:note("Empty", AdvancedRandomTool.emptyText) }
	end

	table.insert(fields, self:field("Seed", "Seed", "number", { integer = true, minimum = 1, range = { min = 1, max = 100 }, tip = "The same seed always gives the same result." }))
	table.insert(fields, self:action("Apply", "Randomize Selection", function()
		self:apply()
	end, nil, true))
	table.insert(fields, self:action("Reseed", "New Seed", function()
		self.params.Seed = Random.new():NextInteger(1, AdvancedRandomTool.maximumSeed)
		self.context.refreshTools()
	end))

	return fields
end

function AdvancedRandomTool:isUsed(id: string): boolean
	return self.params["Use" .. id] == true
end

function AdvancedRandomTool:pick(random: Random, id: string): number
	local range = self.params[id]
	local low = math.min(range.Min, range.Max)
	local high = math.max(range.Min, range.Max)

	return if high > low then random:NextNumber(low, high) else low
end

function AdvancedRandomTool:scaleRange(range: NumberRange, factor: number): NumberRange
	return NumberRange.new(range.Min * factor, range.Max * factor)
end

function AdvancedRandomTool:fadeSequence(sequence: NumberSequence, amount: number): NumberSequence
	local points = sequenceTools.toPoints(sequence)

	for _, point in points do
		point.value = 1 - (1 - math.clamp(point.value, 0, 1)) * (1 - amount)
	end

	return sequenceTools.fromPoints(points)
end

function AdvancedRandomTool:applyRoot(root: Instance, random: Random)
	local pivot = spatial.getPivot(root)

	if self:isUsed("Rotation") and pivot then
		local axis = spatial.axes[self.params.RotationAxis] or Vector3.yAxis

		spatial.setPivot(root, pivot * CFrame.fromAxisAngle(axis, math.rad(self:pick(random, "Rotation"))))
	end

	if self:isUsed("Size") then
		spatial.scale(root, math.max(self:pick(random, "Size"), 0.01), if pivot then pivot.Position else self:getOrigin())
	end
end

function AdvancedRandomTool:applyInstance(instance: Instance, random: Random)
	local target = instance :: any

	if self:isUsed("Transparency") and self:supports("Transparency", instance, false) then
		local amount = math.clamp(self:pick(random, "Transparency"), 0, 1)

		if instance:IsA("BasePart") or instance:IsA("Decal") then
			target.Transparency = amount
		else
			target.Transparency = self:fadeSequence(target.Transparency, amount)
		end
	end

	if self:isUsed("Color") and self:supports("Color", instance, false) then
		local color = self.params.ColorFrom:Lerp(self.params.ColorTo, random:NextNumber())

		colorOps.apply(instance, function(current)
			return colorOps.tint(current, color, true)
		end)
	end

	if self:isUsed("Brightness") and self:supports("Brightness", instance, false) then
		target.Brightness = math.max(target.Brightness * self:pick(random, "Brightness"), 0)
	end

	if self:isUsed("Lifetime") then
		if instance:IsA("ParticleEmitter") then
			instance.Lifetime = self:scaleRange(instance.Lifetime, math.max(self:pick(random, "Lifetime"), 0.01))
		elseif instance:IsA("Trail") then
			instance.Lifetime = math.max(instance.Lifetime * self:pick(random, "Lifetime"), 0.01)
		end
	end

	if self:isUsed("Speed") then
		if instance:IsA("ParticleEmitter") then
			instance.Speed = self:scaleRange(instance.Speed, self:pick(random, "Speed"))
		elseif instance:IsA("Beam") then
			instance.TextureSpeed *= self:pick(random, "Speed")
		end
	end

	if not instance:IsA("ParticleEmitter") then
		return
	end

	if self:isUsed("Rotation") then
		local turn = self:pick(random, "Rotation")

		instance.Rotation = NumberRange.new(turn)
	end

	if self:isUsed("Rate") then
		local factor = self:pick(random, "Rate")
		local count = instance:GetAttribute("EmitCount")

		instance.Rate *= factor

		if typeof(count) == "number" then
			instance:SetAttribute("EmitCount", math.max(math.round(count * factor), 1))
		end
	end
end

function AdvancedRandomTool:apply()
	local gate = PremiumGate.get()

	if not gate:isUnlocked(AdvancedRandomTool.feature) then
		self.context.notify((gate:describe(AdvancedRandomTool.feature)))
		return
	end

	local roots = self:requireRoots(false)

	if not roots then
		return
	end

	local compatible = self:getCompatible()
	local any = false

	for _, property in AdvancedRandomTool.properties do
		any = any or (compatible[property.id] and self:isUsed(property.id))
	end

	if not any then
		self.context.notify(AdvancedRandomTool.noneEnabled)
		return
	end

	local random = Random.new(math.floor(self.params.Seed))

	self:run("Advanced Randomize", function()
		for _, root in roots do
			self:applyRoot(root, random)
		end

		for _, instance in self:getAffected() do
			self:applyInstance(instance, random)
		end
	end)
end

return AdvancedRandomTool
]]></ProtectedString>
