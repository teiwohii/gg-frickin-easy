								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local spatial = require(script.Parent.Parent.spatial)
local Tool = require(script.Parent.Tool)

local MirrorTool = Tool.extend()

MirrorTool.id = "Mirror"
MirrorTool.title = "Mirror"
MirrorTool.keywords = "mirror flip symmetry duplicate"
MirrorTool.pivots = { "Asset Origin", "Selection Centre" }

function MirrorTool.new(context)
	local self = setmetatable({}, MirrorTool)

	Tool.init(self, context, {
		Axis = "X",
		Around = "Asset Origin",
		Copy = true,
	})

	return self
end

function MirrorTool:getFields()
	return {
		self:choice("Axis", "Axis", spatial.axisNames, { tip = "The world axis to flip across." }),
		self:choice("Around", "Around", MirrorTool.pivots),
		self:field("Copy", "Keep Original", "toggle", { tip = "On mirrors a copy. Off flips the selection itself." }),
		self:action("Apply", "Mirror", function()
			self:apply()
		end, nil, true),
	}
end

function MirrorTool:mirrorNode(node: Instance, isRoot: boolean, origin: Vector3, axis: string)
	if node:IsA("BasePart") then
		node.CFrame = spatial.mirrorCFrame(node.CFrame, origin, axis)
	elseif node:IsA("Attachment") then
		if isRoot then
			node.WorldCFrame = spatial.mirrorCFrame(node.WorldCFrame, origin, axis)
		else
			node.CFrame = spatial.mirrorCFrame(node.CFrame, Vector3.zero, axis)
		end
	elseif node:IsA("Model") then
		if not node.PrimaryPart then
			node.WorldPivot = spatial.mirrorCFrame(node.WorldPivot, origin, axis)
		end
	elseif node:IsA("ParticleEmitter") then
		node.Acceleration = spatial.mirrorVector(node.Acceleration, axis)
	end
end

function MirrorTool:mirror(root: Instance, origin: Vector3, axis: string)
	self:mirrorNode(root, true, origin, axis)

	for _, descendant in root:GetDescendants() do
		self:mirrorNode(descendant, false, origin, axis)
	end
end

function MirrorTool:apply()
	local roots = self:requireRoots(true)

	if not roots then
		return
	end

	local params = self.params
	local origin = if params.Around == "Selection Centre" then spatial.getCenter(roots) else self:getOrigin()

	local results = self:run("Mirror", function()
		local mirrored = {}

		for _, root in roots do
			local target = root

			if params.Copy then
				target = root:Clone()
				target.Parent = root.Parent
			end

			self:mirror(target, origin, params.Axis)
			table.insert(mirrored, target)
		end

		return mirrored
	end)

	if results then
		self.selection:set(results)
	end
end

return MirrorTool
]]></ProtectedString>
								<string name="ScriptGuid">{2605E13F-C30E-4C30-A49E-9446FDBB9A24}</string>
