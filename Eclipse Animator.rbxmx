							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = require(script.Parent.ShapeKit)

local ring = {}

ring.id = "Ring"
ring.title = "Ring"
ring.root = "Model"

ring.params = ShapeKit.join({
	{ name = "Radius", kind = "number", default = 5, min = 0.1, max = 200 },
	{ name = "Thickness", kind = "number", default = 0.6, min = 0.02, max = 50, tip = "How wide the ring band is, measured from the centre outwards." },
	{ name = "Height", kind = "number", default = 0.6, min = 0.02, max = 50 },
	{ name = "Segments", kind = "number", default = 28, min = 3, max = 96, integer = true, tip = "More segments make a rounder ring." },
	{ name = "Arc", kind = "number", default = 360, min = 5, max = 360, tip = "360 is a full ring. Lower values leave a gap." },
	{ name = "Taper", kind = "number", default = 0, min = 0, max = 1, tip = "Thins the ring towards its ends. Use it with an arc below 360 for a crescent." },
	{ name = "TaperMode", label = "Taper Mode", kind = "choice", default = "Both Ends", options = { "Both Ends", "One End" } },
	{ name = "Distortion", kind = "number", default = 0, min = 0, max = 10, tip = "Pushes each segment in or out by a random amount." },
	{ name = "Seed", kind = "number", default = 1, min = 1, max = 9999, integer = true },
}, ShapeKit.solidParams())

function ring.build(kit, params)
	local segments = math.clamp(math.round(params.Segments), 3, 96)
	local arc = math.rad(math.clamp(params.Arc, 1, 360))
	local step = arc / segments
	local start = -arc / 2

	for index = 1, segments do
		local fraction = (index - 0.5) / segments
		local angle = start + (index - 0.5) * step
		local scale = 1

		if params.Taper > 0 then
			if params.TaperMode == "One End" then
				scale = 1 - params.Taper * fraction
			else
				scale = 1 - params.Taper * (1 - math.sin(math.pi * fraction))
			end
		end

		local thickness = params.Thickness * scale
		local height = params.Height * scale
		local radius = math.max(params.Radius + kit:jitter(params.Distortion), 0.01)
		local lift = kit:jitter(params.Distortion * 0.5)
		local length = 2 * (radius + thickness / 2) * math.tan(step / 2)
		local position = Vector3.new(math.cos(angle) * radius, lift, math.sin(angle) * radius)

		kit:part("Segment", CFrame.new(position) * CFrame.Angles(0, -angle, 0), Vector3.new(thickness, height, length))
	end
end

return ring
]]></ProtectedString>
								<string name="ScriptGuid">{9B2247E2-A2FB-42AC-B546-70AED4B707E6}</string>
