							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local utilities = require(script.Parent.utilities)

local sequence = utilities.sequence

local meshParticle = {}

meshParticle.prefix = "MeshParticle_"
meshParticle.enabledAttribute = "MeshParticle_Enabled"
meshParticle.sceneFolderName = "Eclipse FX"
meshParticle.minimumSize = 0.001

meshParticle.defaults = {
	Enabled = true,
	Lifetime = NumberRange.new(1),
	Speed = NumberRange.new(0),
	SpreadAngle = Vector2.zero,
	EmissionDirection = "Top",
	EmitDelay = 0,
	Size = NumberSequence.new(1),
	Squash = NumberSequence.new(0),
	Orientation = "None",
	ZOffset = 0,
	Acceleration = Vector3.zero,
	Drag = 0,
	Rotation = NumberRange.new(0),
	RotSpeed = NumberRange.new(0),
	LockedToPart = false,
	TimeScale = 1,
	WindAffectsDrag = false,
	Shape = "Point",
	ShapeInOut = "Outward",
	ShapeStyle = "Volume",
	ShapePartial = 1,
}

meshParticle.normals = {
	Top = Vector3.yAxis,
	Bottom = -Vector3.yAxis,
	Front = -Vector3.zAxis,
	Back = Vector3.zAxis,
	Left = -Vector3.xAxis,
	Right = Vector3.xAxis,
}

local active = {}
local restKeys = {
	cframe = "MeshParticle_RestCFrame",
	size = "MeshParticle_RestSize",
	transparency = "MeshParticle_RestTransparency",
	color = "MeshParticle_RestColor",
	meshScale = "MeshParticle_RestMeshScale",
}

function meshParticle.isMesh(instance)
	return typeof(instance) == "Instance"
		and instance:IsA("BasePart")
		and (instance:IsA("MeshPart") or instance:FindFirstChildOfClass("SpecialMesh") ~= nil)
end

function meshParticle.isMeshParticle(instance)
	if not meshParticle.isMesh(instance) then
		return false
	end

	local enabled = instance:GetAttribute(meshParticle.enabledAttribute)

	if enabled ~= nil then
		return enabled == true
	end

	local scene = workspace:FindFirstChild(meshParticle.sceneFolderName)

	return scene ~= nil and instance:IsDescendantOf(scene)
end

function meshParticle.settings(source)
	local result = {}

	for name, default in meshParticle.defaults do
		local value = source:GetAttribute(meshParticle.prefix .. name)
		result[name] = if typeof(value) == typeof(default) then value else default
	end

	local transparency = source:GetAttribute(meshParticle.prefix .. "Transparency")
	result.Transparency = if typeof(transparency) == "NumberSequence" then transparency else nil

	local color = source:GetAttribute(meshParticle.prefix .. "Color")
	result.Color = if typeof(color) == "ColorSequence" then color else nil

	result.TimeScale = math.max(result.TimeScale, 0.001)

	return result
end

local function randomUnit(generator)
	local z = generator:NextNumber(-1, 1)
	local angle = generator:NextNumber(0, math.pi * 2)
	local radius = math.sqrt(1 - z * z)

	return Vector3.new(radius * math.cos(angle), z, radius * math.sin(angle))
end

local function ranged(generator, range)
	return range.Min + (range.Max - range.Min) * generator:NextNumber()
end

local function spreadDirection(direction, spread, generator)
	if spread.X <= 0 and spread.Y <= 0 then
		return direction
	end

	local helper = if math.abs(direction.Y) < 0.99 then Vector3.yAxis else Vector3.xAxis
	local first = direction:Cross(helper).Unit
	local second = first:Cross(direction).Unit
	local turn = CFrame.fromAxisAngle(first, math.rad(generator:NextNumber(-spread.X, spread.X)))
		* CFrame.fromAxisAngle(second, math.rad(generator:NextNumber(-spread.Y, spread.Y)))

	return turn:VectorToWorldSpace(direction).Unit
end

local function spawnPoint(settings, size, generator)
	local half = size / 2
	local shape = settings.Shape
	local surface = settings.ShapeStyle == "Surface"
	local partial = math.clamp(settings.ShapePartial, 0, 1)

	if shape == "Box" then
		if surface then
			local axis = generator:NextInteger(1, 3)
			local sign = if generator:NextNumber() < 0.5 then -1 else 1
			local point = Vector3.new(
				generator:NextNumber(-1, 1),
				generator:NextNumber(-1, 1),
				generator:NextNumber(-1, 1)
			)
			point = Vector3.new(
				if axis == 1 then sign else point.X,
				if axis == 2 then sign else point.Y,
				if axis == 3 then sign else point.Z
			)

			return point * half, nil
		end

		return Vector3.new(
			generator:NextNumber(-1, 1),
			generator:NextNumber(-1, 1),
			generator:NextNumber(-1, 1)
		) * half, nil
	elseif shape == "Sphere" then
		local cosine = 1 - 2 * partial * generator:NextNumber()
		local sine = math.sqrt(math.max(0, 1 - cosine * cosine))
		local angle = generator:NextNumber(0, math.pi * 2)
		local normal = Vector3.new(sine * math.cos(angle), cosine, sine * math.sin(angle))
		local radius = if surface then 1 else generator:NextNumber() ^ (1 / 3)

		return normal * half * radius, normal
	elseif shape == "Cylinder" then
		local angle = generator:NextNumber(0, math.pi * 2)
		local normal = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local inner = 1 - partial
		local radius = if surface then 1 else inner + (1 - inner) * math.sqrt(generator:NextNumber())

		return Vector3.new(normal.X * half.X * radius, generator:NextNumber(-1, 1) * half.Y, normal.Z * half.Z * radius), normal
	elseif shape == "Disc" then
		local angle = generator:NextNumber(0, math.pi * 2)
		local normal = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local inner = 1 - partial
		local radius = if surface then 1 else inner + (1 - inner) * math.sqrt(generator:NextNumber())

		return Vector3.new(normal.X * half.X * radius, 0, normal.Z * half.Z * radius), nil
	end

	return Vector3.zero, nil
end

function meshParticle.variant(settings, seed, size)
	local generator = Random.new(seed)
	local offset, normal = spawnPoint(settings, size, generator)
	local direction = meshParticle.normals[settings.EmissionDirection] or Vector3.yAxis

	if normal then
		local sign = 1

		if settings.ShapeInOut == "Inward" then
			sign = -1
		elseif settings.ShapeInOut == "InAndOut" then
			sign = if generator:NextNumber() < 0.5 then -1 else 1
		end

		direction = normal * sign
	end

	direction = spreadDirection(direction, settings.SpreadAngle, generator)

	return {
		seed = seed,
		lifetime = math.max(ranged(generator, settings.Lifetime), 0.01),
		speed = ranged(generator, settings.Speed),
		rotation = ranged(generator, settings.Rotation),
		rotSpeed = ranged(generator, settings.RotSpeed),
		offset = offset,
		direction = direction,
		noise = generator:NextNumber(-1, 1),
	}
end

function meshParticle.duration(settings, variant)
	return variant.lifetime / settings.TimeScale
end

local function motion(velocity, acceleration, drag, time)
	if drag > 0 then
		local terminal = acceleration / drag
		local decay = math.exp(-drag * time)

		return terminal * time + (velocity - terminal) * (1 - decay) / drag, terminal + (velocity - terminal) * decay
	end

	return velocity * time + acceleration * (0.5 * time * time), velocity + acceleration * time
end

local function squashScale(squash)
	local tall = if squash >= 0 then 1 + squash else 1 / (1 - squash)
	local wide = 1 / math.sqrt(tall)

	return Vector3.new(wide, tall, wide)
end

function meshParticle.state(settings, variant, age, frame, emitFrame, baseSize, camera)
	local time = age * settings.TimeScale
	local progress = math.clamp(time / variant.lifetime, 0, 1)
	local acceleration = settings.Acceleration

	if settings.WindAffectsDrag and settings.Drag > 0 then
		acceleration += workspace.GlobalWind * settings.Drag
	end

	local velocity = emitFrame:VectorToWorldSpace(variant.direction) * variant.speed
	local travelled, currentVelocity = motion(velocity, acceleration, settings.Drag, time)
	local position = emitFrame:PointToWorldSpace(variant.offset) + travelled

	if settings.LockedToPart then
		position = frame:PointToWorldSpace(emitFrame:PointToObjectSpace(position))
		currentVelocity = frame:VectorToWorldSpace(emitFrame:VectorToObjectSpace(currentVelocity))
	end

	local cameraPosition = camera and camera.CFrame.Position

	if cameraPosition and settings.ZOffset ~= 0 then
		local toward = cameraPosition - position

		if toward.Magnitude > 1e-4 then
			position += toward.Unit * settings.ZOffset
		end
	end

	local roll = math.rad(variant.rotation + variant.rotSpeed * time)
	local orientation = settings.Orientation
	local rotation

	if orientation == "FacingCamera" and cameraPosition then
		rotation = CFrame.lookAt(position, cameraPosition).Rotation * CFrame.Angles(0, 0, roll)
	elseif orientation == "FacingCameraWorldUp" and cameraPosition then
		local level = Vector3.new(cameraPosition.X, position.Y, cameraPosition.Z)
		rotation = if (level - position).Magnitude > 1e-4
			then CFrame.lookAt(position, level).Rotation * CFrame.Angles(0, 0, roll)
			else frame.Rotation
	elseif (orientation == "VelocityParallel" or orientation == "VelocityPerpendicular") and currentVelocity.Magnitude > 1e-4 then
		local facing = CFrame.lookAt(position, position + currentVelocity).Rotation

		if orientation == "VelocityParallel" then
			rotation = facing * CFrame.Angles(-math.pi / 2, 0, 0) * CFrame.Angles(0, roll, 0)
		else
			rotation = facing * CFrame.Angles(0, 0, roll)
		end
	else
		local base = if settings.LockedToPart then frame else emitFrame
		rotation = base.Rotation * CFrame.Angles(0, roll, 0)
	end

	local scale = math.max(sequence(settings.Size, progress, 1, variant.noise), 0)
	local squash = sequence(settings.Squash, progress, 0, variant.noise)
	local transparency = if settings.Transparency then sequence(settings.Transparency, progress, 0, variant.noise) else nil

	return {
		progress = progress,
		cframe = CFrame.new(position) * rotation,
		size = (baseSize * squashScale(squash) * scale):Max(Vector3.one * meshParticle.minimumSize),
		transparency = transparency,
		color = if settings.Color then sequence(settings.Color, progress) else nil,
	}
end

local function combine(base, extra)
	return 1 - (1 - base) * (1 - math.clamp(extra, 0, 1))
end

local function surfacesOf(source)
	local list = {}

	for _, child in source:GetChildren() do
		if child:IsA("Decal") then
			table.insert(list, child)
		end
	end

	return list
end

function meshParticle.capture(source)
	local mesh = source:FindFirstChildOfClass("SpecialMesh")
	local rest = {
		cframe = source.CFrame,
		size = source.Size,
		transparency = source.Transparency,
		color = source.Color,
		mesh = mesh,
		meshScale = mesh and mesh.Scale,
		surfaces = {},
	}

	source:SetAttribute(restKeys.cframe, rest.cframe)
	source:SetAttribute(restKeys.size, rest.size)
	source:SetAttribute(restKeys.transparency, rest.transparency)
	source:SetAttribute(restKeys.color, rest.color)

	if mesh then
		source:SetAttribute(restKeys.meshScale, rest.meshScale)
	end

	for _, surface in surfacesOf(source) do
		table.insert(rest.surfaces, { instance = surface, transparency = surface.Transparency, color = surface.Color3 })
		surface:SetAttribute(restKeys.transparency, surface.Transparency)
		surface:SetAttribute(restKeys.color, surface.Color3)
	end

	return rest
end

function meshParticle.adopt(source, rest)
	local applied = rest.applied

	if not applied then
		return
	end

	if source.CFrame ~= applied.cframe then
		rest.cframe = source.CFrame * applied.cframe:Inverse() * rest.cframe
		source:SetAttribute(restKeys.cframe, rest.cframe)
	end

	if source.Size ~= applied.size then
		rest.size = (rest.size * source.Size / applied.size):Max(Vector3.one * meshParticle.minimumSize)
		source:SetAttribute(restKeys.size, rest.size)
	end

	if source.Transparency ~= applied.transparency then
		rest.transparency = source.Transparency
		source:SetAttribute(restKeys.transparency, rest.transparency)
	end

	if source.Color ~= applied.color then
		rest.color = source.Color
		source:SetAttribute(restKeys.color, rest.color)
	end
end

function meshParticle.applyTo(source, rest, state)
	source.CFrame = state.cframe
	source.Size = state.size

	if rest.mesh and rest.mesh.Parent == source then
		rest.mesh.Scale = rest.meshScale * (state.size / rest.size)
	end

	source.Transparency = if state.transparency then combine(rest.transparency, state.transparency) else rest.transparency
	source.Color = state.color or rest.color

	for _, entry in rest.surfaces do
		if entry.instance.Parent == source then
			entry.instance.Transparency = if state.transparency then combine(entry.transparency, state.transparency) else entry.transparency
			entry.instance.Color3 = state.color or entry.color
		end
	end

	rest.applied = {
		cframe = source.CFrame,
		size = source.Size,
		transparency = source.Transparency,
		color = source.Color,
	}
end

local function clearRest(instance)
	for _, key in restKeys do
		instance:SetAttribute(key, nil)
	end
end

function meshParticle.restore(source, rest)
	meshParticle.adopt(source, rest)
	source.CFrame = rest.cframe
	source.Size = rest.size
	source.Transparency = rest.transparency
	source.Color = rest.color

	if rest.mesh and rest.mesh.Parent == source then
		rest.mesh.Scale = rest.meshScale
	end

	for _, entry in rest.surfaces do
		if entry.instance.Parent == source then
			entry.instance.Transparency = entry.transparency
			entry.instance.Color3 = entry.color
			clearRest(entry.instance)
		end
	end

	clearRest(source)
end

function meshParticle.restoreTree(root)
	local list = { root }

	for _, descendant in root:GetDescendants() do
		table.insert(list, descendant)
	end

	for _, instance in list do
		if active[instance] then
			continue
		end

		if instance:IsA("BasePart") then
			local cframe = instance:GetAttribute(restKeys.cframe)
			local size = instance:GetAttribute(restKeys.size)
			local transparency = instance:GetAttribute(restKeys.transparency)
			local color = instance:GetAttribute(restKeys.color)
			local meshScale = instance:GetAttribute(restKeys.meshScale)
			local mesh = instance:FindFirstChildOfClass("SpecialMesh")

			if typeof(cframe) == "CFrame" then
				instance.CFrame = cframe
			end

			if typeof(size) == "Vector3" then
				instance.Size = size
			end

			if typeof(transparency) == "number" then
				instance.Transparency = transparency
			end

			if typeof(color) == "Color3" then
				instance.Color = color
			end

			if mesh and typeof(meshScale) == "Vector3" then
				mesh.Scale = meshScale
			end

			clearRest(instance)
		elseif instance:IsA("Decal") then
			local transparency = instance:GetAttribute(restKeys.transparency)
			local color = instance:GetAttribute(restKeys.color)

			if typeof(transparency) == "number" then
				instance.Transparency = transparency
			end

			if typeof(color) == "Color3" then
				instance.Color3 = color
			end

			clearRest(instance)
		end
	end
end

function meshParticle.acquire(source, owner)
	local entry = active[source]

	if not entry then
		entry = { rest = meshParticle.capture(source), owners = {} }
		active[source] = entry
	end

	entry.owners[owner] = true
	return entry.rest
end

function meshParticle.release(source, owner)
	local entry = active[source]

	if not entry then
		return
	end

	entry.owners[owner] = nil

	if next(entry.owners) == nil then
		active[source] = nil

		if source.Parent then
			meshParticle.restore(source, entry.rest)
		end
	end
end

function meshParticle.isActive(source)
	return active[source] ~= nil
end

function meshParticle.frameFor(settings, source, rest, parentAtEmit)
	if settings.LockedToPart and parentAtEmit then
		local parent = source.Parent

		if parent and parent:IsA("BasePart") then
			return parent.CFrame * parentAtEmit:Inverse() * rest.cframe
		elseif parent and parent:IsA("Attachment") then
			return parent.WorldCFrame * parentAtEmit:Inverse() * rest.cframe
		end
	end

	return rest.cframe
end

local function parentFrame(source)
	local parent = source.Parent

	if parent and parent:IsA("BasePart") then
		return parent.CFrame
	elseif parent and parent:IsA("Attachment") then
		return parent.WorldCFrame
	end

	return nil
end

meshParticle.parentFrame = parentFrame

function meshParticle.spawns(settings)
	if not settings.Enabled then
		return {}
	end

	return { { time = settings.EmitDelay, index = 1 } }
end

function meshParticle.seedFor(index)
	return index * 104729 + 7919
end

local function deselect(source)
	pcall(function()
		local selection = game:GetService("Selection")
		local current = selection:Get()
		local index = table.find(current, source)

		if index then
			table.remove(current, index)
			selection:Set(current)
		end
	end)
end

function meshParticle.emit(context, source)
	local settings = meshParticle.settings(source)

	if settings.Enabled then
		deselect(source)
	end

	for _, entry in meshParticle.spawns(settings) do
		context.Schedule(entry.time, function()
			if not source.Parent then
				return
			end

			local owner = {}
			local rest = meshParticle.acquire(source, owner)
			local variant = meshParticle.variant(settings, meshParticle.seedFor(entry.index), rest.size)
			local parentAtEmit = parentFrame(source)
			local released = false

			local function release()
				if not released then
					released = true
					meshParticle.release(source, owner)
				end
			end

			local guard = context.Own(Instance.new("Folder"))
			guard.Name = "MeshParticleGuard"
			guard.Destroying:Connect(release)
			guard.Parent = context.Container
			context.Handle.Stats.Meshes += 1

			for _, child in source:GetChildren() do
				context.Walk(child)
			end

			context.Animate(meshParticle.duration(settings, variant), function(_, _, age)
				if not source.Parent then
					return
				end

				meshParticle.adopt(source, rest)
				local frame = meshParticle.frameFor(settings, source, rest, parentAtEmit)
				meshParticle.applyTo(source, rest, meshParticle.state(settings, variant, age, frame, rest.cframe, rest.size, workspace.CurrentCamera))
			end, release, source)
		end, source)
	end
end

function meshParticle.alive(source, elapsed, settings, size)
	settings = settings or meshParticle.settings(source)
	local result = {}

	for _, entry in meshParticle.spawns(settings) do
		local age = elapsed - entry.time

		if age >= 0 then
			local variant = meshParticle.variant(settings, meshParticle.seedFor(entry.index), size or source.Size)

			if age <= meshParticle.duration(settings, variant) then
				table.insert(result, { index = entry.index, age = age, variant = variant })
			end
		end
	end

	return result, settings
end

return meshParticle
]]></ProtectedString>
