							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local flipbookTiming = {}

flipbookTiming.grids = {
	None = 1,
	Grid2x2 = 2,
	Grid4x4 = 4,
	Grid8x8 = 8,
}
flipbookTiming.stillRate = 2
flipbookTiming.minimumLifetime = 0.05
flipbookTiming.defaultLifetime = 1

function flipbookTiming.getGrid(layout: Enum.ParticleFlipbookLayout): number
	return flipbookTiming.grids[layout.Name] or 1
end

function flipbookTiming.getAverage(range: NumberRange): number
	return (range.Min + range.Max) / 2
end

function flipbookTiming.getRate(frames: number, mode: Enum.ParticleFlipbookMode, framerate: number, lifetime: number): number
	if frames <= 1 then
		return 0
	end

	if mode == Enum.ParticleFlipbookMode.OneShot then
		return frames / math.max(lifetime, flipbookTiming.minimumLifetime)
	end

	return math.max(framerate, 0)
end

function flipbookTiming.getPreviewRate(rate: number): number
	return if rate > 0 then rate else flipbookTiming.stillRate
end

function flipbookTiming.getEmitterRate(emitter: ParticleEmitter): number
	local grid = flipbookTiming.getGrid(emitter.FlipbookLayout)

	return flipbookTiming.getRate(
		grid * grid,
		emitter.FlipbookMode,
		flipbookTiming.getAverage(emitter.FlipbookFramerate),
		flipbookTiming.getAverage(emitter.Lifetime)
	)
end

function flipbookTiming.getIndex(frames: number, mode: Enum.ParticleFlipbookMode, step: number): number
	if frames <= 1 then
		return 0
	end

	local whole = math.max(0, math.floor(step))

	if mode == Enum.ParticleFlipbookMode.PingPong then
		local period = 2 * (frames - 1)
		local position = whole % period

		return if position < frames then position else period - position
	elseif mode == Enum.ParticleFlipbookMode.Random then
		return Random.new(whole + 1):NextInteger(0, frames - 1)
	end

	return whole % frames
end

function flipbookTiming.getIndexAt(frames: number, mode: Enum.ParticleFlipbookMode, rate: number, elapsed: number): number
	return flipbookTiming.getIndex(frames, mode, elapsed * flipbookTiming.getPreviewRate(rate))
end

return flipbookTiming
]]></ProtectedString>
