						<ProtectedString name="Source"><![CDATA[--!native
-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local bezierModule = require("bezier")
local quaternion = require("quaternion")
local easing = require("easing")
local policy = require("policy")
local channelEasing = require("channelEasing")
local curvesValue = {}
local cache = setmetatable({}, { __mode = "k" })
local pointHandles
local empty = { channels = {}, legacy = {}, hasGraph = false }
local ids = {
	"loc_x",
	"loc_y",
	"loc_z",
	"qrot_w",
	"qrot_x",
	"qrot_y",
	"qrot_z",
	"rot_x",
	"rot_y",
	"rot_z",
	"scale_x",
	"scale_y",
	"scale_z",
}
curvesValue.ids = ids
curvesValue.orders = { "XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX" }
local validOrder = { XYZ = true, XZY = true, YXZ = true, YZX = true, ZXY = true, ZYX = true }

function curvesValue.validRotationOrder(order)
	return validOrder[order] == true
end

local function nativeOrder(order)
	return order and Enum.RotationOrder[order:reverse()] or Enum.RotationOrder.XYZ
end

function curvesValue.rotation(x, y, z, order)
	return CFrame.fromEulerAngles(math.rad(x), math.rad(y), math.rad(z), nativeOrder(order))
end

function curvesValue.euler(cf, order, reference)
	if not order then
		local x, y, z = cf:ToEulerAnglesXYZ()
		return math.deg(x), math.deg(y), math.deg(z)
	end

	local x, y, z = cf:ToEulerAngles(nativeOrder(order))
	local a = { math.deg(x), math.deg(y), math.deg(z) }
	local axisIndex = { X = 1, Y = 2, Z = 3 }
	local i, k = axisIndex[order:sub(1, 1)], axisIndex[order:sub(3, 3)]
	local cosine = math.abs(math.cos(math.rad(a[axisIndex[order:sub(2, 2)]])))
	if not reference then
		return a[1], a[2], a[3]
	end

	local axes = { X = 1, Y = 2, Z = 3 }
	local middle = axes[(order or "XYZ"):sub(2, 2)]
	local b = table.clone(a)
	for i = 1, 3 do
		b[i] = i == middle and 180 - b[i] or b[i] + 180
	end

	local function near(v)
		local distance = 0
		for i = 1, 3 do
			v[i] = reference[i] + ((v[i] - reference[i] + 180) % 360) - 180
			distance += (v[i] - reference[i]) ^ 2
		end

		return distance
	end

	local da, db = near(a), near(b)
	local v = db < da and b or a
	local best = math.min(da, db)
	if cosine < 1e-6 then
		for _, sign in { -1, 1 } do
			local candidate = table.clone(a)
			candidate[i] = a[i] + sign * (reference[k] - a[k])
			candidate[k] = reference[k]
			local distance = near(candidate)
			local rebuilt = curvesValue.rotation(candidate[1], candidate[2], candidate[3], order)
			if
				distance < best
				and (rebuilt.XVector - cf.XVector).Magnitude < 1e-5
				and (rebuilt.YVector - cf.YVector).Magnitude < 1e-5
			then
				v, best = candidate, distance
			end
		end
	end
	return v[1], v[2], v[3]
end

function curvesValue.rotationOrder(bucket)
	return curvesValue.compile(bucket).rotationOrder
end

function curvesValue.rotationChannelVisible(bucket, id)
	local order = curvesValue.rotationOrder(bucket)
	if order then
		return id:sub(1, 5) ~= "qrot_"
	end

	if id:sub(1, 4) == "rot_" then
		return curvesValue.compile(bucket).channels[id] ~= nil
	end

	return true
end

function curvesValue.clone(value, budget)
	if type(value) ~= "table" then
		return value
	end

	if budget then
		budget()
	end

	local out = {}
	for key, item in pairs(value) do
		out[key] = curvesValue.clone(item, budget)
	end

	return out
end

function curvesValue.newPoint(key, id)
	local inherited = id and key.Channels and key.Channels[id] and key.Channels[id].Easing
	key = channelEasing.merge(key, inherited)
	local style = key.EasingStyle or "Bezier"
	local name = typeof(style) == "EnumItem" and style.Name or style
	local points = key.BezierPoints
	local bezier = name == "Bezier"
		and (
			not points
			or math.abs((points[1] or 0.42) - 0.42) < 1e-7
				and math.abs(points[2] or 0) < 1e-7
				and math.abs((points[3] or 0.58) - 0.58) < 1e-7
				and math.abs((points[4] or 1) - 1) < 1e-7
		)
	local point = {
		Interpolation = (
			bezier
			or name == "Linear"
			or name == "Constant" and typeof(style) ~= "EnumItem"
		)
				and name
			or "Legacy",
		HandleType = key.HandleType or require("defaults").HandleType,
	}
	if point.Interpolation == "Legacy" then
		point.Easing = {
			EasingStyle = style,
			EasingDirection = key.EasingDirection,
			BezierPoints = curvesValue.clone(points),
			Amplitude = key.Amplitude,
			Period = key.Period,
			MoonEasing = key.MoonEasing,
			Overshoot = key.Overshoot,
		}
	end

	if inherited then
		point.ChannelEasing = curvesValue.clone(inherited)
	end

	return point
end

function curvesValue.resetAll()
	table.clear(cache)
end

function curvesValue.invalidate(bucket)
	policy.invalidate(bucket)
	if bucket then
		cache[bucket] = nil
	end
end

local handleTimeLimit = 1e5
local handleValueLimit = 1e7

local function finite(value, limit)
	return type(value) == "number" and value == value and math.abs(value) <= (limit or 1e15)
end

local function validHandle(handle)
	return type(handle) == "table"
		and finite(handle[1], handleTimeLimit)
		and finite(handle[2], handleValueLimit)
end

local function sanitizePoint(point)
	for _, side in { "In", "Out" } do
		if point[side] ~= nil and not validHandle(point[side]) then
			point[side] = nil
		end
	end

	local imported = point.BlenderHandles
	if imported ~= nil then
		local valid = type(imported) == "table"
		for _, side in { "incoming", "outgoing" } do
			if valid and imported[side] ~= nil and not validHandle(imported[side]) then
				valid = false
			end
		end

		if not valid then
			point.BlenderHandles = nil
		end
	end
end

local function unchangedRotation(row)
	local point = row.point
	local saved = point.LegacyRotation
	return not row.key.GraphOnly
		and type(saved) == "table"
		and typeof(saved[1]) == "CFrame"
		and typeof(row.key.C0) == "CFrame"
		and saved[1]:FuzzyEq(row.key.C0, 1e-6)
		and saved[2] == point.Value
		and saved[3] == point.Interpolation
		and saved[4] == point.HandleType
end

function curvesValue.preservesRotation(channel, time, loopEndTime)
	if not channel or not channel.hasLegacyRotation then
		return false
	end
	local first, last = channel[1], channel[#channel]
	if time <= first.time then
		return first.unchangedRotation and first.point.LegacyRotation[5] == false
	end
	if time >= last.time then
		if time > last.time and loopEndTime and loopEndTime > last.time then
			return first.unchangedRotation
				and last.unchangedRotation
				and first.point.LegacyRotation[5] == false
				and last.point.LegacyRotation[6] == false
		end
		return last.unchangedRotation and last.point.LegacyRotation[6] == false
	end
	local low, high = 1, #channel
	while high - low > 1 do
		local middle = (low + high) // 2
		if channel[middle].time <= time then
			low = middle
		else
			high = middle
		end
	end
	local a, b = channel[low], channel[high]
	if time == a.time then
		return a.unchangedRotation
	end
	return a.unchangedRotation
		and b.unchangedRotation
		and a.point.LegacyRotation[6] == b.point.Id
		and b.point.LegacyRotation[5] == a.point.Id
end

local function negatedPoint(point)
	local copy = table.clone(point)
	copy.Value = -point.Value
	for _, side in { "In", "Out" } do
		if type(point[side]) == "table" then
			copy[side] = { point[side][1], -point[side][2] }
		end
	end

	if type(point.BlenderHandles) == "table" then
		copy.BlenderHandles = table.clone(point.BlenderHandles)
		for _, side in { "incoming", "outgoing" } do
			local handle = point.BlenderHandles[side]
			if type(handle) == "table" then
				copy.BlenderHandles[side] = { handle[1], -handle[2] }
			end
		end
	end

	return copy
end

local function alignedQuaternions(channels)
	local rows = {}
	local order = {}
	for axis, id in { w = "qrot_w", x = "qrot_x", y = "qrot_y", z = "qrot_z" } do
		for index, row in ipairs(channels[id]) do
			local item = rows[row.key]
			if not item then
				item = { time = row.time, indexes = {}, values = {}, count = 0 }
				rows[row.key] = item
				table.insert(order, item)
			end

			item.indexes[id], item.values[axis] = index, row.point.Value
			item.count += 1
		end
	end

	table.sort(order, function(a, b)
		return a.time < b.time
	end)

	local flipped, previous = nil, nil
	for _, item in order do
		if item.count == 4 then
			local q = item.values
			if
				previous
				and previous.w * q.w
						+ previous.x * q.x
						+ previous.y * q.y
						+ previous.z * q.z
					< 0
			then
				q = { w = -q.w, x = -q.x, y = -q.y, z = -q.z }
				flipped = flipped or {}
				for id, index in item.indexes do
					flipped[id] = flipped[id] or {}
					flipped[id][index] = true
				end
			end

			previous = q
		end
	end

	if not flipped then
		return nil
	end

	local view = {}
	for id, indexes in flipped do
		local source = channels[id]
		local copy = { id = source.id, loopEntry = source.loopEntry }
		for index, row in source do
			if type(index) == "number" then
				copy[index] = indexes[index]
						and {
							key = row.key,
							point = negatedPoint(row.point),
							time = row.time,
							frame = row.frame,
						}
					or row
			end
		end

		view[id] = copy
	end

	return view
end

function curvesValue.compile(bucket)
	if not bucket then
		return empty
	end

	local saved = cache[bucket]
	if saved then
		return saved
	end

	local entry = { channels = {}, legacy = bucket, hasGraph = false }
	local hasOnly = false
	for _, key in pairs(bucket) do
		if type(key) == "table" then
			if key.EulerRotationOrder then
				entry.rotationOrder = key.EulerRotationOrder
				entry.hasGraph = true
			end

			hasOnly = hasOnly or key.GraphOnly == true
			local curves = type(key.GraphCurves) == "table" and finite(key.Time) and key.GraphCurves
			for id, point in curves or empty.channels do
				if type(point) == "table" and finite(point.Value) then
					sanitizePoint(point)
					if id:sub(1, 4) == "rot_" and point.RotationOrder then
						if
							not validOrder[point.RotationOrder]
							or entry.rotationOrder and entry.rotationOrder ~= point.RotationOrder
						then
							entry.rejected = (entry.rejected or 0) + 1
							continue
						end

						entry.rotationOrder = point.RotationOrder
					end

					entry.hasGraph = true
					entry.channels[id] = entry.channels[id] or {}
					table.insert(
						entry.channels[id],
						{ key = key, point = point, time = key.Time, frame = key.Frame }
					)
				end
			end
		end
	end

	if hasOnly then
		entry.legacy = {}
		for frame, key in pairs(bucket) do
			if not key.GraphOnly then
				entry.legacy[frame] = key
			end
		end
	end

	for id, channel in pairs(entry.channels) do
		table.sort(channel, function(a, b)
			return a.time < b.time
		end)
		channel.id = id
		if id:sub(1, 5) == "qrot_" then
			for _, row in ipairs(channel) do
				if type(row) == "table" and row.point then
					row.unchangedRotation = unchangedRotation(row)
					if row.unchangedRotation then
						channel.hasLegacyRotation = true
						channel.legacyEntry = entry
						entry.hasLegacyRotation = true
					end
				end
			end
		end
		local motor = channel[1].key.Motor
		local modifiers = motor and require("mods").get(motor, id)
		if modifiers and modifiers.Stack[1] and modifiers.Stack[1].SmoothSeam then
			channel.loopEntry = modifiers
		end
	end

	local channels = entry.channels
	entry.fullQuaternionTransform = channels.loc_x ~= nil
		and not entry.hasLegacyRotation
		and channels.loc_y ~= nil
		and channels.loc_z ~= nil
		and channels.qrot_w ~= nil
		and channels.qrot_x ~= nil
		and channels.qrot_y ~= nil
		and channels.qrot_z ~= nil
	if channels.qrot_w and channels.qrot_x and channels.qrot_y and channels.qrot_z then
		entry.alignedQuaternion = alignedQuaternions(channels)
	end

	cache[bucket] = entry
	return entry
end

function curvesValue.hasChannelEasing(bucket)
	local entry = curvesValue.compile(bucket)
	if entry.hasChannelEasing ~= nil then
		return entry.hasChannelEasing
	end

	entry.hasChannelEasing = false
	for _, key in bucket or {} do
		for _, channel in key.Channels or {} do
			if channel.Easing and next(channel.Easing) then
				entry.hasChannelEasing = true
				return true
			end
		end
	end

	return false
end

function curvesValue.hasVisibleKey(bucket, key)
	if key.PropertyValue ~= nil then
		return true
	end

	for _, point in pairs(key.GraphCurves or {}) do
		if not point.Empty then
			return true
		end
	end

	if key.GraphOnly then
		return false
	end

	local owned = curvesValue.compile(bucket).channels
	if key.Channels then
		for id in pairs(key.Channels) do
			if not owned[id] then
				return true
			end
		end
	elseif key.C0 then
		for _, id in ipairs(ids) do
			if id:sub(1, 4) ~= "rot_" and not owned[id] then
				return true
			end
		end
	end

	return false
end

function curvesValue.hasKeyContent(bucket, key)
	return curvesValue.hasVisibleKey(bucket, key)
end

function curvesValue.activateIncoming(bucket, key, id)
	local previous
	for _, entry in ipairs(curvesValue.compile(bucket).channels[id] or {}) do
		if entry.time < key.Time and (not previous or entry.time > previous.time) then
			previous = entry
		end
	end

	if previous then
		previous.point.Interpolation = "Bezier"
		channelEasing.graphChanged(previous.key, id)
	end
end

function curvesValue.syncEasing(key, handleOnly, bucket, channelId)
	for id, point in pairs(key.GraphCurves or {}) do
		if channelId and id ~= channelId then
			continue
		end

		if point.Empty then
			continue
		end

		point.LegacyRotation = nil
		local source = channelEasing.merge(key, point.ChannelEasing)
		local style = source.EasingStyle
		local name = typeof(style) == "EnumItem" and style.Name or style
		local native = typeof(style) == "EnumItem" and style.EnumType == Enum.PoseEasingStyle
		local incoming, outgoing
		if
			handleOnly
			and (source.HandleType == "Free" or source.HandleType == "Aligned")
			and bucket
		then
			for index, entry in curvesValue.compile(bucket).channels[id] or {} do
				if entry.key == key then
					local left, right = pointHandles(curvesValue.compile(bucket).channels[id], index)
					incoming = { left.time - key.Time, left.value - point.Value }
					outgoing = { right.time - key.Time, right.value - point.Value }
					if source.HandleType == "Aligned" and math.abs(outgoing[1]) > 1e-9 then
						incoming[2] = incoming[1] * outgoing[2] / outgoing[1]
					end

					break
				end
			end
		end

		if handleOnly then
			point.BlenderHandles = nil
		end

		if handleOnly then
			point.HandleType = source.HandleType
			point.Interpolation = "Bezier"
			point.In, point.Out = incoming, outgoing
			if bucket then
				curvesValue.activateIncoming(bucket, key, id)
			end
		else
			local points = source.BezierPoints
			local automaticBezier = name == "Bezier"
				and (
					not points
					or math.abs(points[1] - 0.42) < 1e-7
						and math.abs(points[2]) < 1e-7
						and math.abs(points[3] - 0.58) < 1e-7
						and math.abs(points[4] - 1) < 1e-7
				)
			point.Interpolation = (
				name == "Linear"
				or name == "Constant" and not native
				or automaticBezier
			)
					and name
				or "Legacy"
			point.Easing = {
				EasingStyle = name,
				EasingDirection = typeof(source.EasingDirection) == "EnumItem"
						and source.EasingDirection.Name
					or source.EasingDirection,
				NativePose = native,
				BezierPoints = curvesValue.clone(source.BezierPoints),
				Overshoot = source.Overshoot,
				Amplitude = source.Amplitude,
				Period = source.Period,
				MoonEasing = source.MoonEasing,
			}
		end
	end
end

function curvesValue.legacyBucket(bucket)
	return bucket and curvesValue.compile(bucket).legacy or nil
end

local function automatic(point)
	local mode = point.HandleType or "AutoClamped"
	return mode == "Automatic" or mode == "AutoClamped"
end

local function cycleOf(channel)
	if channel.cycle == nil then
		local kind = false
		local first = channel[1]
		local motor = first and first.key and first.key.Motor
		if
			motor
			and channel.id
			and #channel >= 2
			and automatic(first.point)
			and automatic(channel[#channel].point)
		then
			local mods = require("mods")
			kind = mods.cycleType(mods.get(motor, channel.id)) or false
		end

		channel.cycle = kind
	end

	return channel.cycle
end

local function loopChannel(channel, finish)
	if not channel or not finish or finish <= 0 or #channel < 3 or cycleOf(channel) then
		return channel
	end

	local first, last = channel[1], channel[#channel]
	if
		math.abs(first.time) > 1e-7
		or math.abs(last.time - finish) > 1e-7
		or not automatic(first.point)
		or not automatic(last.point)
		or first.point.BlenderHandles
		or last.point.BlenderHandles
		or math.abs(first.point.Value - last.point.Value)
			> 1e-6 * math.max(1, math.abs(first.point.Value), math.abs(last.point.Value))
	then
		return channel
	end

	if channel.loopEnd ~= finish then
		local view = table.clone(channel)
		view.cycle = "Repeat"
		view.smoothed = nil
		view.loopView = nil
		view.loopEnd = nil
		channel.loopEnd = finish
		channel.loopView = view
	end

	return channel.loopView
end

local function extendOf(channel)
	if channel.extend == nil then
		local kind = false
		local first = channel[1]
		local motor = first and first.key and first.key.Motor
		if motor and channel.id then
			local entry = require("mods").get(motor, channel.id)
			kind = entry ~= nil and entry.Extrapolation == "Linear" and "Linear" or false
		end

		channel.extend = kind
	end

	return channel.extend
end

local function keyHandles(channel, index, _smooth)
	local row, count = channel[index], #channel
	local point, time = row.point, row.time
	local value, mode = point.Value, point.HandleType or "AutoClamped"
	local previous, following = channel[index - 1], channel[index + 1]
	local cycle = (index == 1 or index == count) and cycleOf(channel)
	if cycle and count > 1 then
		local duration = channel[count].time - channel[1].time
		local shift = cycle == "Offset" and channel[count].point.Value - channel[1].point.Value or 0
		if index == 1 then
			local source = channel[count - 1]
			previous = { time = source.time - duration, point = { Value = source.point.Value - shift } }
		else
			local source = channel[2]
			following = { time = source.time + duration, point = { Value = source.point.Value + shift } }
		end
	end
	local extend = not cycle and extendOf(channel) == "Linear"
	if extend and count > 1 then
		if not previous then previous = { time = 2 * time - following.time, point = { Value = 2 * value - following.point.Value } } end
		if not following then following = { time = 2 * time - previous.time, point = { Value = 2 * value - previous.point.Value } } end
	end
	local leftTime, rightTime = bezierModule.lengths(previous and previous.time, time, following and following.time, mode)
	if _smooth and (mode == "Automatic" or mode == "AutoClamped" or mode == "Vector") then
		local before = previous and time - previous.time or following and following.time - time or 1
		local after = following and following.time - time or before
		leftTime, rightTime = before / 3, after / 3
	end
	local leftValue, rightValue = bezierModule.handles(previous and previous.point.Value, value, following and following.point.Value,
		previous and previous.time, time, following and following.time, leftTime, rightTime, mode)
	local left, right = { time = time - leftTime, value = leftValue }, { time = time + rightTime, value = rightValue }
	local auto = mode == "Automatic" or mode == "AutoClamped"
	local locked = auto and not cycle and not extend and (index == 1 or index == count)
	if mode == "AutoClamped" and previous and following then
		locked = locked or (value - previous.point.Value) * (following.point.Value - value) <= 0
	end
	if auto and cycle and count > 1 then
		local first, last = channel[1].point, channel[count].point
		local shift = cycle == "Offset" and last.Value - first.Value or 0
		local a, b = channel[count - 1].point.Value, channel[2].point.Value
		locked = locked or (first.HandleType or "AutoClamped") == "AutoClamped" and (first.Value - a + shift) * (b - first.Value) <= 0
			or (last.HandleType or "AutoClamped") == "AutoClamped" and (last.Value - a) * (b + shift - last.Value) <= 0
	end
	if locked then left.value, right.value = value, value end
	local imported = point.BlenderHandles
	local function unchanged(a, b)
		return a == b or a ~= nil and b ~= nil and a[1] == b[1] and a[2] == b[2]
	end
	local explicit = mode == "Free" or mode == "Aligned" or imported and imported.mode == mode
		and unchanged(point.In, imported.incoming) and unchanged(point.Out, imported.outgoing)
	if explicit then
		for side, handle in { In = left, Out = right } do
			local offset = point[side]
			if offset then handle.time, handle.value = time + offset[1], value + offset[2] end
		end
	end
	local kind = explicit and "fixed" or mode == "Automatic" and "auto" or mode == "AutoClamped" and "clamped" or mode == "Vector" and "vector" or "fixed"
	return left, right, locked, kind
end

local function smoothingEnabled(channel)
	if channel.smoothing == nil then
		local ok, preference = pcall(function()
			return require("preferences").get("GraphAutoSmoothing")
		end)
		channel.smoothing = not ok or preference ~= false
	end
	return channel.smoothing
end

local function smoothChannel(channel, checkpoint)
	local count = #channel
	local handles, kinds, locks, limits = {}, {}, {}, {}
	local cycle = cycleOf(channel)
	local duration = channel[count].time - channel[1].time
	local offset = cycle == "Offset" and channel[count].point.Value - channel[1].point.Value or 0
	for i, row in ipairs(channel) do
		if checkpoint and i % 256 == 0 then checkpoint() end
		local left, right, locked, kind = keyHandles(channel, i, true)
		handles[i], kinds[i], locks[i] = { left.time, left.value, right.time, right.value }, kind, locked
		if kind == "clamped" then
			local previous, following = channel[i - 1], channel[i + 1]
			local beforeTime, beforeValue = previous and previous.time, previous and previous.point.Value
			local afterTime, afterValue = following and following.time, following and following.point.Value
			if cycle then
				if not previous then beforeTime, beforeValue = channel[count - 1].time - duration, channel[count - 1].point.Value - offset end
				if not following then afterTime, afterValue = channel[2].time + duration, channel[2].point.Value + offset end
			end
			local incoming = beforeTime and (row.point.Value - beforeValue) / (row.time - beforeTime)
			local outgoing = afterTime and (afterValue - row.point.Value) / (afterTime - row.time)
			local sign = incoming or outgoing or 0
			local bound = 3 * math.min(math.abs(incoming or outgoing or 0), math.abs(outgoing or incoming or 0))
			limits[i] = locked and { 0, 0 } or sign >= 0 and { 0, bound } or { -bound, 0 }
		end
	end
	local function automaticIndex(i)
		return not locks[i] and (kinds[i] == "auto" or kinds[i] == "clamped")
	end
	local function apply(i, slope, incoming, outgoing)
		local row, h = channel[i], handles[i]
		if incoming then h[2] = row.point.Value - slope * (row.time - h[1]) end
		if outgoing then h[4] = row.point.Value + slope * (h[3] - row.time) end
	end
	local periodicCount = count - 1
	local start = 1
	local uninterrupted = cycle and periodicCount >= 2
	if uninterrupted then
		for i = 1, periodicCount do
			if not automaticIndex(i) then start, uninterrupted = i, false; break end
		end
	end
	if uninterrupted then
		local times, values, bounds = {}, {}, {}
		for i = 1, periodicCount do
			times[i], values[i], bounds[i] = channel[i].time, channel[i].point.Value, limits[i]
		end
		local slopes = bezierModule.smoothSlopes(times, values, bounds, nil, nil, duration, offset, checkpoint)
		for i = 1, periodicCount do apply(i, slopes[i], true, true) end
		apply(count, slopes[1], true, true)
		return handles
	end
	local sequence = {}
	for step = 0, count - 1 do
		local index = cycle and (start + step - 1) % periodicCount + 1 or step + 1
		local turn = cycle and math.floor((start + step - 1) / periodicCount) or 0
		table.insert(sequence, { index = index, time = channel[index].time + turn * duration, value = channel[index].point.Value + turn * offset })
	end
	local function boundarySlope(i, incoming, endpoint)
		if locks[i] and kinds[i] ~= "fixed" then return 0 end
		if kinds[i] == "vector" or endpoint and automaticIndex(i) then return nil end
		local row, h = channel[i], handles[i]
		local span = incoming and row.time - h[1] or h[3] - row.time
		local slope = span > 0 and (incoming and row.point.Value - h[2] or h[4] - row.point.Value) / span or 0
		return kinds[i] == "fixed" and { slope = slope, span = span } or slope
	end
	local beginning = 1
	for ending = 2, #sequence do
		local last = sequence[ending].index
		if ending < #sequence and automaticIndex(last) then continue end
		local times, values, bounds = {}, {}, {}
		local hasAutomatic = false
		for j = beginning, ending do
			local row = sequence[j]
			local i = j - beginning + 1
			times[i], values[i], bounds[i] = row.time, row.value, limits[row.index]
			hasAutomatic = hasAutomatic or kinds[row.index] == "auto" or kinds[row.index] == "clamped"
		end
		if hasAutomatic then
			local first = sequence[beginning].index
			local slopes = bezierModule.smoothSlopes(times, values, bounds,
				boundarySlope(first, false, beginning == 1 and not cycle),
				boundarySlope(last, true, ending == #sequence and not cycle), nil, 0, checkpoint)
			for j = beginning, ending do
				local i = sequence[j].index
				local both = kinds[i] == "auto" or kinds[i] == "clamped"
				apply(i, slopes[j - beginning + 1], both or j > beginning, both or j < ending)
				if cycle and i == 1 then apply(count, slopes[j - beginning + 1], both or j > beginning, both or j < ending) end
			end
		end
		beginning = ending
	end
	return handles
end

pointHandles = function(channel, index)
	if #channel >= 2 and smoothingEnabled(channel) then
		local cache = channel.smoothed
		if not cache then
			cache = smoothChannel(channel, nil)
			channel.smoothed = cache
		end

		local h = cache[index]
		return { time = h[1], value = h[2] }, { time = h[3], value = h[4] }
	end

	local left, right = keyHandles(channel, index, false)
	return left, right
end

local function segmentHandles(channel, index)
	local a, b = channel[index], channel[index + 1]
	local _, outgoing = pointHandles(channel, index)
	local incoming = pointHandles(channel, index + 1)
	local duration = b.time - a.time
	local rightLength = math.abs(outgoing.time - a.time)
	local leftLength = math.abs(b.time - incoming.time)
	if rightLength + leftLength > duration then
		local factor = duration / (rightLength + leftLength)
		outgoing.value = a.point.Value + (outgoing.value - a.point.Value) * factor
		incoming.value = b.point.Value + (incoming.value - b.point.Value) * factor
		rightLength *= factor
		leftLength *= factor
	end

	local x1, x2 = rightLength / duration, 1 - leftLength / duration
	outgoing.time, incoming.time = a.time + x1 * duration, a.time + x2 * duration
	return outgoing, incoming
end

curvesValue.segmentHandles = segmentHandles

local function handleValues(channel, index)
	if #channel >= 2 and smoothingEnabled(channel) then
		local cache = channel.smoothed
		if not cache then
			cache = smoothChannel(channel, nil)
			channel.smoothed = cache
		end

		local h = cache[index]
		return h[1], h[2], h[3], h[4]
	end

	local left, right = keyHandles(channel, index, false)
	return left.time, left.value, right.time, right.value
end

local function segmentValues(channel, index)
	local a, b = channel[index], channel[index + 1]
	local _, _, outgoingTime, outgoingValue = handleValues(channel, index)
	local incomingTime, incomingValue = handleValues(channel, index + 1)
	local duration = b.time - a.time
	local rightLength = math.abs(outgoingTime - a.time)
	local leftLength = math.abs(b.time - incomingTime)
	if rightLength + leftLength > duration then
		local factor = duration / (rightLength + leftLength)
		outgoingValue = a.point.Value + (outgoingValue - a.point.Value) * factor
		incomingValue = b.point.Value + (incomingValue - b.point.Value) * factor
		rightLength *= factor
		leftLength *= factor
	end

	local x1, x2 = rightLength / duration, 1 - leftLength / duration
	return a.time + x1 * duration, outgoingValue, a.time + x2 * duration, incomingValue
end

function curvesValue.pointHandles(channel, index, loopEndTime)
	return pointHandles(loopChannel(channel, loopEndTime), index)
end

local function extrapolate(channel, index, time)
	local key = channel[index]
	local value = key.point.Value
	local style = key.point.Interpolation or "Bezier"
	if style == "Constant" or style == "ConstantNext" then
		return value
	end

	if style == "Linear" then
		local neighbor = channel[index == 1 and 2 or #channel - 1]
		local span = neighbor.time - key.time
		if span == 0 then
			return value
		end

		return value - (neighbor.point.Value - value) / span * (key.time - time)
	end

	local left, right = pointHandles(channel, index)
	local handle = index == 1 and left or right
	local span = key.time - handle.time
	if span == 0 then
		return value
	end

	return value - (value - handle.value) / span * (key.time - time)
end

function curvesValue.loopModifier(channel, entry)
	if not channel or #channel < 3 or channel.loopModifierView then
		return channel
	end

	local mods = require("mods")
	local cycle = mods.cycleType(entry)
	local modifier = entry and entry.Stack and entry.Stack[1]
	if not cycle or not modifier.SmoothSeam then
		return channel
	end

	local a, b = channel[1], channel[#channel]

	if
		cycle == "Perfect"
		and math.abs(a.point.Value - b.point.Value)
			> 1e-6 * math.max(1, math.abs(a.point.Value), math.abs(b.point.Value))
	then
		return channel
	end

	if
		not channel.smoothLoop
		or channel.smoothLoopEntry ~= entry
		or channel.smoothLoop.cycle ~= cycle
	then
		local view = table.clone(channel)
		view.cycle = cycle
		view.smoothed = nil
		view.loopModifierView = true
		view.loopEntry = nil
		for i, key in channel do
			if type(i) == "number" then
				local row = table.clone(key)
				row.point = table.clone(key.point)
				row.point.HandleType = "Automatic"
				row.point.Interpolation = "Bezier"
				row.point.In = nil
				row.point.Out = nil
				row.point.BlenderHandles = nil
				view[i] = row
			end
		end

		channel.smoothLoop = view
		channel.smoothLoopEntry = entry
	end

	return channel.smoothLoop
end

function curvesValue.prepare(channel, finish, checkpoint)
	if channel and channel.loopEntry then
		channel = curvesValue.loopModifier(channel, channel.loopEntry)
	end
	channel = loopChannel(channel, finish)
	if channel and #channel >= 2 and smoothingEnabled(channel) and not channel.smoothed then
		local needsHandles = false
		for index = 1, #channel - 1 do
			if index % 256 == 0 then
				checkpoint()
			end
			local style = channel[index].point.Interpolation or "Bezier"
			if
				style ~= "Linear"
				and style ~= "Legacy"
				and style ~= "Constant"
				and style ~= "ConstantNext"
			then
				needsHandles = true
				break
			end
		end
		if not needsHandles then
			return
		end
		local result = smoothChannel(channel, checkpoint)
		checkpoint()
		channel.smoothed = result
	end
end

function curvesValue.value(channel, time, loopEndTime)
	if curvesValue.preservesRotation(channel, time, loopEndTime) and curvesValue.sampleLegacyRotation then
		local value = curvesValue.sampleLegacyRotation(channel, time, loopEndTime)
		if value ~= nil then
			return value
		end
	end

	if channel and channel.loopEntry then
		channel = curvesValue.loopModifier(channel, channel.loopEntry)
	end

	channel = loopChannel(channel, loopEndTime)
	if not channel or #channel == 0 then
		return nil
	end

	if time <= channel[1].time then
		if time < channel[1].time and #channel >= 2 and extendOf(channel) == "Linear" then
			return extrapolate(channel, 1, time)
		end

		return channel[1].point.Value
	end

	if time >= channel[#channel].time then
		if time > channel[#channel].time and #channel >= 2 and extendOf(channel) == "Linear" then
			return extrapolate(channel, #channel, time)
		end

		return channel[#channel].point.Value
	end

	local lo, hi = 1, #channel
	while hi - lo > 1 do
		local mid = math.floor((lo + hi) / 2)
		if channel[mid].time <= time then
			lo = mid
		else
			hi = mid
		end
	end

	local a, b = channel[lo], channel[hi]
	local duration = b.time - a.time
	if duration <= 0 then
		return b.point.Value
	end

	local alpha = math.clamp((time - a.time) / duration, 0, 1)
	local style = a.point.Interpolation or "Bezier"
	if style == "Constant" then
		return a.point.Value
	end

	if style == "ConstantNext" then
		return alpha == 0 and a.point.Value or b.point.Value
	end

	if style == "Linear" then
		return a.point.Value + (b.point.Value - a.point.Value) * alpha
	end

	if style == "Legacy" then
		return a.point.Value
			+ (b.point.Value - a.point.Value) * easing.apply(alpha, a.point.Easing or a.key)
	end

	if
		a.point.HandleType == "Vector"
		and b.point.HandleType == "Vector"
		and not a.point.BlenderHandles
		and not b.point.BlenderHandles
	then
		return a.point.Value + (b.point.Value - a.point.Value) * alpha
	end

	local outgoingTime, outgoingValue, incomingTime, incomingValue = segmentValues(channel, lo)
	local x1 = (outgoingTime - a.time) / duration
	local x2 = (incomingTime - a.time) / duration
	return bezierModule.cubic(
		a.point.Value,
		outgoingValue,
		incomingValue,
		b.point.Value,
		bezierModule.parameter(alpha, x1, x2)
	)
end

function curvesValue.quaternionReference(bucket, time)
	local entry = curvesValue.compile(bucket)
	if not entry.quaternionReferences then
		local points = {}
		for _, key in bucket or {} do
			if
				not key.Disabled
				and not key.GraphOnly
				and typeof(key.C0) == "CFrame"
				and type(key.Time) == "number"
			then
				local q, complete = {}, true
				for _, axis in { "w", "x", "y", "z" } do
					local channel = key.Channels and key.Channels["qrot_" .. axis]
					if not channel or channel.Disabled or type(channel.Value) ~= "number" then
						complete = false
						break
					end

					q[axis] = channel.Value
				end

				table.insert(points, {
					time = key.Time,
					q = complete and quaternion.normalize(q) or quaternion.fromCFrame(key.C0),
				})
			end
		end

		table.sort(points, function(a, b)
			return a.time < b.time
		end)
		for i = 2, #points do
			points[i].q = quaternion.alignSign(points[i - 1].q, points[i].q)
		end

		entry.quaternionReferences = points
	end

	local points = entry.quaternionReferences
	if #points == 0 then
		return nil
	end

	local low, high = 1, #points
	while low <= high do
		local mid = (low + high) // 2
		if points[mid].time <= time then
			low = mid + 1
		else
			high = mid - 1
		end
	end

	local a, b = points[math.max(1, high)], points[math.min(#points, high + 1)]
	if a == b or b.time <= a.time then
		return a.q
	end

	return quaternion.slerp(a.q, b.q, math.clamp((time - a.time) / (b.time - a.time), 0, 1))
end

local transformIds = { "loc_x", "loc_y", "loc_z", "rot_x", "rot_y", "rot_z" }
local quaternionIds = { "qrot_w", "qrot_x", "qrot_y", "qrot_z" }
local quaternionAxes = { "w", "x", "y", "z" }
local scaleIds = { "scale_x", "scale_y", "scale_z" }

 
 
function curvesValue.fullTransform(bucket, time, motor, loopEndTime)
	local entry = curvesValue.compile(bucket)
	if
		not entry.fullQuaternionTransform
		or motor and motor:GetAttribute("EclipseChannelDisabledAny") == true
	then
		return nil
	end

	local channels = entry.channels
	local rotation = entry.alignedQuaternion or channels
	local q = quaternion.normalize({
		w = curvesValue.value(rotation.qrot_w, time, loopEndTime),
		x = curvesValue.value(rotation.qrot_x, time, loopEndTime),
		y = curvesValue.value(rotation.qrot_y, time, loopEndTime),
		z = curvesValue.value(rotation.qrot_z, time, loopEndTime),
	})
	return CFrame.new(
		curvesValue.value(channels.loc_x, time, loopEndTime),
		curvesValue.value(channels.loc_y, time, loopEndTime),
		curvesValue.value(channels.loc_z, time, loopEndTime)
	) * CFrame.new(0, 0, 0, q.x, q.y, q.z, q.w)
end

function curvesValue.cframe(bucket, time, base, motor, loopEndTime, rest)
	local entry = curvesValue.compile(bucket)
	if not entry.hasGraph then
		return base
	end

	local p = base.Position
	local values = { loc_x = p.X, loc_y = p.Y, loc_z = p.Z }
	local ex, ey, ez = curvesValue.euler(base, entry.rotationOrder)
	local rx, ry, rz = math.rad(ex), math.rad(ey), math.rad(ez)
	values.rot_x, values.rot_y, values.rot_z = math.deg(rx), math.deg(ry), math.deg(rz)
	local hasPosition, hasRotation = false, false
	local anyDisabled = motor ~= nil and motor:GetAttribute("EclipseChannelDisabledAny") == true
	for _, id in transformIds do
		local channel = entry.channels[id]
		local disabled = anyDisabled
			and (motor:GetAttribute("EclipseChannelDisabled_" .. id) == true)
		if disabled and entry.rotationOrder and id:sub(1, 4) == "rot_" then
			local r = rest
				or motor and motor:GetAttribute("EclipseAnimatorDefaultC0")
				or CFrame.identity
			local x, y, z = curvesValue.euler(r, entry.rotationOrder)
			values[id] = ({ rot_x = x, rot_y = y, rot_z = z })[id]
			hasRotation = true
		elseif channel and not disabled then
			values[id] = curvesValue.value(channel, time, loopEndTime)
			if string.sub(id, 1, 3) == "rot" then
				hasRotation = true
			else
				hasPosition = true
			end
		end
	end

	local hasQuaternion = false
	for _, id in quaternionIds do
		if
			entry.channels[id]
			and not (anyDisabled and motor:GetAttribute("EclipseChannelDisabled_" .. id))
		then
			hasQuaternion = true
			break
		end
	end

	if not hasPosition and not hasRotation and not hasQuaternion then
		return base
	end

	local rotation = hasRotation
			and curvesValue.rotation(values.rot_x, values.rot_y, values.rot_z, entry.rotationOrder)
		or base.Rotation
	if hasQuaternion then
		local q = quaternion.fromCFrame(rotation)
		local reference = curvesValue.quaternionReference(bucket, time)
		if reference then
			q = quaternion.alignSign(reference, q)
		end

		local aligned = entry.alignedQuaternion
		for _, axis in quaternionAxes do
			local id = "qrot_" .. axis
			if
				entry.channels[id]
				and not (anyDisabled and motor:GetAttribute("EclipseChannelDisabled_" .. id))
				and not curvesValue.preservesRotation(entry.channels[id], time, loopEndTime)
			then
				q[axis] =
					curvesValue.value(aligned and aligned[id] or entry.channels[id], time, loopEndTime)
			end
		end

		q = quaternion.normalize(q)
		rotation = CFrame.new(0, 0, 0, q.x, q.y, q.z, q.w)
	end

	return CFrame.new(values.loc_x, values.loc_y, values.loc_z) * rotation
end

function curvesValue.scale(bucket, time, base, motor, loopEndTime)
	local entry = curvesValue.compile(bucket)
	local output = base
	local anyDisabled = motor ~= nil and motor:GetAttribute("EclipseChannelDisabledAny") == true
	for _, id in scaleIds do
		if
			entry.channels[id]
			and not (anyDisabled and motor:GetAttribute("EclipseChannelDisabled_" .. id))
		then
			if output == base then
				output = base and table.clone(base) or { scale_x = 1, scale_y = 1, scale_z = 1 }
			end

			output[id] = curvesValue.value(entry.channels[id], time, loopEndTime)
		end
	end

	return output
end

function curvesValue.recordPose(bucket, key, cframe, channelIds)
	local compiled = curvesValue.compile(bucket)
	key.GraphOnly = nil
	if not compiled.hasGraph then
		return
	end

	local chosen
	if channelIds then
		chosen = {}
		for _, id in ipairs(channelIds) do
			chosen[id] = true
		end
	end

	local order = compiled.rotationOrder
	local referenceEuler
	if order then
		referenceEuler = {}
		local rx, ry, rz = curvesValue.euler(cframe, order)
		local fallback = { rx, ry, rz }
		for i, id in { "rot_x", "rot_y", "rot_z" } do
			referenceEuler[i] = compiled.channels[id]
					and curvesValue.value(compiled.channels[id], key.Time)
				or fallback[i]
		end
	end

	local ex, ey, ez = curvesValue.euler(cframe, order, referenceEuler)
	local x, y, z = math.rad(ex), math.rad(ey), math.rad(ez)
	local q = quaternion.fromCFrame(cframe)
	local reference, at
	for _, candidate in bucket do
		if candidate.Time and candidate.Time < key.Time and (not at or candidate.Time > at) then
			local value = {}
			local complete = true
			for _, axis in { "w", "x", "y", "z" } do
				local id = "qrot_" .. axis
				local p = candidate.GraphCurves and candidate.GraphCurves[id]
				local c = candidate.Channels and candidate.Channels[id]
				value[axis] = p and not p.Empty and p.Value or c and not c.Disabled and c.Value
				if value[axis] == nil then
					complete = false
				end
			end

			if complete then
				reference, at = value, candidate.Time
			end
		end
	end

	if reference then
		q = quaternion.alignSign(reference, q)
	end

	local values = {
		qrot_w = q.w,
		qrot_x = q.x,
		qrot_y = q.y,
		qrot_z = q.z,
		loc_x = cframe.X,
		loc_y = cframe.Y,
		loc_z = cframe.Z,
		rot_x = math.deg(x),
		rot_y = math.deg(y),
		rot_z = math.deg(z),
	}
	for id in pairs(compiled.channels) do
		local rotation = string.sub(id, 1, 4) == "rot_"
		local include = not chosen or chosen[id]
		if rotation and chosen then
			include = chosen[id] or chosen.qrot_w or chosen.qrot_x or chosen.qrot_y or chosen.qrot_z
		end

		local scalar = key.Channels and key.Channels[id]
		local value = values[id] or (scalar and scalar.Value)
		if include and value ~= nil then
			key.GraphCurves = key.GraphCurves or {}
			local point = key.GraphCurves[id]
			if not point then
				point = curvesValue.newPoint(key, id)
				key.GraphCurves[id] = point
			end

			if rotation and point.Value then
				value = point.Value + ((value - point.Value + 180) % 360) - 180
			end

			point.Value, point.Empty = value, nil
			if rotation and order then
				point.RotationOrder = order
			end
		end
	end

	curvesValue.invalidate(bucket)
end

function curvesValue.filterRotation(bucket)
	local frames = {}
	for frame in bucket do
		table.insert(frames, frame)
	end

	table.sort(frames)
	local previousQ, previousEuler
	local previousAxis = {}
	local changed = false

	local function pointValue(key, id)
		local p = key.GraphCurves and key.GraphCurves[id]
		if p and not p.Empty then
			return p.Value
		end

		local c = key.Channels and key.Channels[id]
		return c and not c.Disabled and c.Value
	end

	local function remap(key, id, value, multiplier)
		local point = key.GraphCurves and key.GraphCurves[id]
		local channel = key.Channels and key.Channels[id]
		local old = pointValue(key, id)
		if old == nil or math.abs(value - old) < 1e-7 and multiplier ~= -1 then
			return
		end

		changed = true
		if channel then
			channel.Value = value
		end

		if point then
			point.Value = value
			for _, side in { "In", "Out" } do
				if point[side] then
					point[side][2] *= multiplier or 1
				end
			end

			if point.BlenderHandles then
				for _, handle in point.BlenderHandles do
					if type(handle) == "table" and type(handle[2]) == "number" then
						handle[2] = handle[2] * (multiplier or 1)
					end
				end
			end
		end
	end

	local function near(x, r)
		return r + (x - r + 180) % 360 - 180
	end

	for _, frame in frames do
		local key = bucket[frame]
		local q = {
			w = pointValue(key, "qrot_w"),
			x = pointValue(key, "qrot_x"),
			y = pointValue(key, "qrot_y"),
			z = pointValue(key, "qrot_z"),
		}
		if q.w and q.x and q.y and q.z then
			local aligned = previousQ and quaternion.alignSign(previousQ, q) or q
			if aligned ~= q then
				for _, axis in { "w", "x", "y", "z" } do
					remap(key, "qrot_" .. axis, aligned[axis], -1)
				end
			end

			previousQ = aligned
		end

		local x, y, z = pointValue(key, "rot_x"), pointValue(key, "rot_y"), pointValue(key, "rot_z")
		if x and y and z then
			local v = { x, y, z }
			if previousEuler then
				local a = {
					near(x, previousEuler[1]),
					near(y, previousEuler[2]),
					near(z, previousEuler[3]),
				}
				local order = curvesValue.rotationOrder(bucket) or "XYZ"
				local middle = ({ X = 1, Y = 2, Z = 3 })[order:sub(2, 2)]
				local b = { x, y, z }
				for i = 1, 3 do
					b[i] = near(i == middle and 180 - b[i] or b[i] + 180, previousEuler[i])
				end

				local function distance(p)
					local n = 0
					for i = 1, 3 do
						n += (p[i] - previousEuler[i]) ^ 2
					end

					return n
				end

				local alternate = distance(b) < distance(a)
				v = alternate and b or a
				for i, axis in { "x", "y", "z" } do
					remap(key, "rot_" .. axis, v[i], alternate and i == middle and -1 or 1)
				end
			end

			previousEuler = v
		end

		for _, axis in { "x", "y", "z" } do
			local id = "rot_" .. axis
			local value = pointValue(key, id)
			if value ~= nil then
				if previousAxis[id] then
					value = near(value, previousAxis[id])
					remap(key, id, value, 1)
				end

				previousAxis[id] = value
			end
		end
	end

	if changed then
		curvesValue.invalidate(bucket)
	end

	return changed
end

return curvesValue
]]></ProtectedString>
						<string name="ScriptGuid">{B2DD0037-AA79-4D92-8ABB-D8B849C30733}</string>
