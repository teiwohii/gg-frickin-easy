						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">nestedParts</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX046EB181C6DF44B883691F895759DC49">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local facial = {}

function facial.plan(rig, raw)
	local properties = require("properties")
	local controls = properties.faceControls(rig)
	if not controls or not controls.Parent or not controls.Parent:IsA("BasePart") then
		return nil
	end
	local tracks, last = {}, 0
	local owners = { rig }
	for _, owner in require("state").getAllRigs() do
		if
			owner ~= rig
			and owner:IsDescendantOf(rig)
			and properties.faceControls(owner) == controls
		then
			table.insert(owners, owner)
		end
	end
	for _, owner in owners do
		for _, motor in properties.list(owner, false, true) do
			local name = motor.PropertyId:match("^FaceControls%.(.+)$")
			if not name or motor:GetAttribute("EclipseDisabled") then
				continue
			end
			local bucket = require("policy").activeBucket(raw.Keyframes[motor])
			local authored = false
			for frame, key in bucket or {} do
				if require("graphCurves").hasVisibleKey(bucket, key) then
					authored = true
				end
			end
			if not authored then
				continue
			end
			local previous = tracks[name]
			if not previous or owner:IsDescendantOf(previous.motor.Rig) then
				tracks[name] = { motor = motor, bucket = bucket }
			end
		end
	end
	for _, row in tracks do
		for frame in row.bucket do
			last = math.max(last, frame)
		end
	end
	return next(tracks)
			and { controls = controls, head = controls.Parent, tracks = tracks, last = last }
		or nil
end

function facial.write(sequence, rig, raw, plan, timeline)
	if not plan then
		return
	end
	local properties = require("properties")
	local parents = {}
	for _, joint in require("parenting").collectMotors(rig) do
		if typeof(joint) == "Instance" and joint:IsA("Motor6D") and joint.Part0 and joint.Part1 then
			parents[joint.Part1] = joint.Part0
		end
	end
	local path, seen, part = {}, {}, plan.head
	while part do
		assert(not seen[part], "The facial animation joint hierarchy contains a cycle.")
		seen[part] = true
		table.insert(path, 1, part.Name)
		part = parents[part]
	end
	local frames, existing = {}, {}
	for _, keyframe in sequence:GetKeyframes() do
		existing[keyframe.Time] = keyframe
	end
	local subdivisions = math.max(1, math.floor(120 / raw.FPS))
	for tick = 0, math.floor(plan.last * subdivisions) do
		frames[tick / subdivisions] = true
	end
	frames[plan.last] = true
	for _, row in plan.tracks do
		row.ordered = {}
		for frame, key in row.bucket do
			frames[frame] = true
			table.insert(row.ordered, key)
		end
		table.sort(row.ordered, function(a, b)
			return a.Time < b.Time
		end)
		for index, key in row.ordered do
			local following = row.ordered[index + 1]
			if
				following
				and key.EasingStyle == Enum.PoseEasingStyle.Constant
				and key.EasingDirection == Enum.PoseEasingDirection.InOut
			then
				frames[(key.Time + following.Time) * raw.FPS * 0.5] = true
			end
		end
	end
	local ordered = {}
	for frame in frames do
		table.insert(ordered, frame)
	end
	table.sort(ordered)
	for index, frame in ordered do
		local time = frame / raw.FPS
		local keyframe = existing[time]
		if not keyframe then
			keyframe = Instance.new("Keyframe")
			keyframe.Time, keyframe.Name, keyframe.Parent = time, tostring(frame), sequence
			existing[time] = keyframe
		end
		local parent = keyframe
		for _, name in path do
			local pose
			for _, child in parent:GetChildren() do
				if child:IsA("Pose") and child.Name == name then
					pose = child
					break
				end
			end
			if not pose then
				pose = Instance.new("Pose")
				pose.Name, pose.Weight, pose.CFrame, pose.Parent = name, 0, CFrame.identity, parent
			end
			parent = pose
		end
		local folder = parent:FindFirstChild("FaceControls")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name, folder.Parent = "FaceControls", parent
		end
		local poseTime = timeline:GetPoseTime(time)
		for name, row in plan.tracks do
			local value = properties.evaluate(row.motor, row.bucket, poseTime)
			assert(
				type(value) == "number" and value == value and math.abs(value) < math.huge,
				"Invalid FaceControls value: " .. name
			)
			local pose = Instance.new("NumberPose")
			pose.Name, pose.Value, pose.Weight = name, math.clamp(value, 0, 1), 1
			pose.EasingStyle, pose.EasingDirection =
				Enum.PoseEasingStyle.Linear, Enum.PoseEasingDirection.In
			local first, last = 1, #row.ordered
			while first <= last do
				local middle = math.floor((first + last) / 2)
				if row.ordered[middle].Time <= poseTime then
					first = middle + 1
				else
					last = middle - 1
				end
			end
			local previous = row.ordered[last]
			local style = previous and previous.EasingStyle
			if
				style == "Constant"
				or style == Enum.PoseEasingStyle.Constant
				or (raw.SkipFrames or 0) > 0
			then
				pose.EasingStyle = Enum.PoseEasingStyle.Constant
				pose.EasingDirection = Enum.PoseEasingDirection.Out
				local nextFrame = ordered[index + 1]
				if nextFrame and (raw.SkipFrames or 0) == 0 and typeof(style) == "EnumItem" then
					local midpoint = (time + nextFrame / raw.FPS) * 0.5
					local middleValue = properties.evaluate(row.motor, row.bucket, midpoint)
					if math.abs(middleValue - value) > 1e-6 then
						pose.EasingDirection = Enum.PoseEasingDirection.In
					end
				end
			end
			pose.Parent = folder
		end
		if index % 120 == 0 then
			local step = require("state").ProjectWorkStep
			if step then
				step()
			else
				task.wait()
			end
		end
	end
end

function facial.read(sequence, rig, fps)
	local properties = require("properties")
	local controls = properties.faceControls(rig)
	if not controls or not controls.Parent then
		return {}
	end
	local rows = {}
	for _, keyframe in sequence:GetKeyframes() do
		for _, head in keyframe:GetDescendants() do
			if not head:IsA("Pose") or head.Name ~= controls.Parent.Name then
				continue
			end
			local folder = head:FindFirstChild("FaceControls")
			if not folder or not folder:IsA("Folder") then
				continue
			end
			for _, pose in folder:GetChildren() do
				local id = "FaceControls." .. pose.Name
				if
					not pose:IsA("NumberPose")
					or pose.Weight <= 0
					or not properties.definition(rig, id)
				then
					continue
				end
				local value = math.clamp(pose.Value, 0, 1)
				local row = rows[id]
				if not row then
					row = { id = id, default = controls[pose.Name], enabled = true, keys = {} }
					rows[id] = row
				end
				local frame = keyframe.Time * fps
				row.keys[frame] = {
					Time = keyframe.Time,
					Frame = frame,
					C0 = properties.encode(value),
					PropertyValue = value,
					EasingStyle = pose.EasingStyle,
					EasingDirection = pose.EasingDirection,
				}
			end
		end
	end
	local result = {}
	for _, row in rows do
		table.insert(result, row)
	end
	return result
end

function facial.preview(sequence, rig)
	if not rig then
		return nil
	end
	local properties = require("properties")
	local controls = properties.faceControls(rig)
	local rows = facial.read(sequence, rig, 60)
	if #rows == 0 then
		return nil
	end
	local original = {}
	for _, row in rows do
		original[row.id:sub(14)] = row.default
	end
	return {
		apply = function(time)
			if not controls.Parent then
				return
			end
			for _, row in rows do
				local motor = {
					Rig = rig,
					PropertyId = row.id,
					DefaultValue = row.default,
					Definition = properties.definition(rig, row.id),
				}
				controls[row.id:sub(14)] = properties.evaluate(motor, row.keys, time)
			end
		end,
		restore = function()
			if controls.Parent then
				for name, value in original do
					controls[name] = value
				end
			end
		end,
	}
end

return facial
]]></ProtectedString>
						<string name="ScriptGuid">{9215DEF0-A417-4B9E-A438-2E1DE169DC0F}</string>
