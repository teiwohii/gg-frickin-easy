							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local assetId = {}
assetId.__index = assetId

assetId.prefix = "rbxassetid://"
assetId.urlPatterns = { "[%?&]id=(%d+)", "/library/(%d+)", "/asset/(%d+)", "/catalog/(%d+)", "/store/asset/(%d+)", "/dashboard/creations/store/(%d+)" }

assetId.properties = {
	SoundId = true,
	Texture = true,
	TextureID = true,
	TextureId = true,
	MeshId = true,
	Image = true,
}

function assetId.normalize(text: string): string
	local trimmed = string.gsub(text, "^%s*(.-)%s*$", "%1")

	if trimmed == "" then
		return ""
	end

	if string.match(trimmed, "^%d+$") then
		return assetId.prefix .. trimmed
	end

	if string.match(trimmed, "^rbx") then
		return trimmed
	end

	for _, pattern in assetId.urlPatterns do
		local id = string.match(trimmed, pattern)

		if id then
			return assetId.prefix .. id
		end
	end

	return trimmed
end

function assetId.isProperty(name: string): boolean
	return assetId.properties[name] == true
end

function assetId.clean(name: string, value: any): any
	if typeof(value) == "string" and assetId.properties[name] then
		return assetId.normalize(value)
	end

	return value
end

return assetId
]]></ProtectedString>
							<string name="ScriptGuid">{9D1EC69F-C3A7-4319-994A-94AA24AC9F13}</string>
