						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local coreGui = game:GetService("CoreGui")

local configuration = require(script.Parent.Parent.Utility.configuration)

local ParticlePaths = {}
ParticlePaths.__index = ParticlePaths

ParticlePaths.folderName = "ArcParticlePaths"
ParticlePaths.pathsPerEmitter = 16
ParticlePaths.segments = 14
ParticlePaths.maximumEmitters = 30
ParticlePaths.maximumLifetime = 12
ParticlePaths.transparency = 0.3
ParticlePaths.thickness = 1.5
ParticlePaths.darkThreshold = 0.3
ParticlePaths.seed = 90210
ParticlePaths.halfLife = math.log(2)
ParticlePaths.dragTolerance = 1e-4

ParticlePaths.faces = {
	[Enum.NormalId.Top] = { normal = Vector3.yAxis, first = Vector3.xAxis, second = Vector3.zAxis },
	[Enum.NormalId.Bottom] = { normal = -Vector3.yAxis, first = Vector3.xAxis, second = Vector3.zAxis },
	[Enum.NormalId.Right] = { normal = Vector3.xAxis, first = Vector3.yAxis, second = Vector3.zAxis },
	[Enum.NormalId.Left] = { normal = -Vector3.xAxis, first = Vector3.yAxis, second = Vector3.zAxis },
	[Enum.NormalId.Back] = { normal = Vector3.zAxis, first = Vector3.xAxis, second = Vector3.yAxis },
	[Enum.NormalId.Front] = { normal = -Vector3.zAxis, first = Vector3.xAxis, second = Vector3.yAxis },
}

function ParticlePaths.new(context)
	local self = setmetatable({}, ParticlePaths)

	self.context = context
	self.enabled = false
	self.active = false
	self.folder = nil
	self.records = {}
	self.dirty = {}
	self.pending = false
	self.emitterProvider = nil
	self.changedHandler = nil

	return self
end

function ParticlePaths:setHidden(hidden: boolean)
	self.hidden = hidden

	for _, record in self.records do
		record.adornment.Visible = not hidden
	end
end

function ParticlePaths:setEmitterProvider(provider: () -> { Instance })
	self.emitterProvider = provider
end

function ParticlePaths:setChangedHandler(handler: ((boolean) -> ())?)
	self.changedHandler = handler
end

function ParticlePaths:isEnabled(): boolean
	return self.enabled
end

function ParticlePaths:getFolder(): Folder
	if self.folder and self.folder.Parent then
		return self.folder
	end

	local folder = Instance.new("Folder")

	folder.Name = ParticlePaths.folderName
	folder.Archivable = false
	folder.Parent = coreGui
	self.folder = folder

	return folder
end

function ParticlePaths:getHost(emitter: Instance): (CFrame?, Vector3?)
	local parent = emitter.Parent

	if not parent then
		return nil, nil
	end

	if parent:IsA("Attachment") then
		return parent.WorldCFrame, nil
	elseif parent:IsA("BasePart") then
		return parent.CFrame, parent.Size
	end

	return nil, nil
end

function ParticlePaths:getColor(emitter: ParticleEmitter): Color3
	local color = emitter.Color.Keypoints[1].Value
	local _, _, value = color:ToHSV()

	return if value < ParticlePaths.darkThreshold then configuration.Colors.Light else color
end

function ParticlePaths:getTravel(drag: number, time: number): number
	if math.abs(drag) < ParticlePaths.dragTolerance then
		return time
	end

	return (1 - 0.5 ^ (drag * time)) / (drag * ParticlePaths.halfLife)
end

function ParticlePaths:randomUnit(random: Random): Vector3
	local z = random:NextNumber(-1, 1)
	local angle = random:NextNumber(0, math.pi * 2)
	local radius = math.sqrt(math.max(1 - z * z, 0))

	return Vector3.new(radius * math.cos(angle), radius * math.sin(angle), z)
end

function ParticlePaths:getDirectionSign(emitter: ParticleEmitter, random: Random): number
	local mode = emitter.ShapeInOut

	if mode == Enum.ParticleEmitterShapeInOut.Inward then
		return -1
	elseif mode == Enum.ParticleEmitterShapeInOut.InAndOut then
		return if random:NextNumber() < 0.5 then -1 else 1
	end

	return 1
end

function ParticlePaths:getPerpendicular(direction: Vector3): Vector3
	local helper = if math.abs(direction.Y) > 0.9 then Vector3.xAxis else Vector3.yAxis

	return direction:Cross(helper).Unit
end

function ParticlePaths:getOrigin(emitter: ParticleEmitter, face, size: Vector3?, random: Random): (Vector3, Vector3, Vector3, Vector3)
	local sign = self:getDirectionSign(emitter, random)
	local normal = face.normal * sign

	if not size then
		return Vector3.zero, normal, face.first, face.second
	end

	local half = size / 2
	local shape = emitter.Shape
	local surface = emitter.ShapeStyle == Enum.ParticleEmitterShapeStyle.Surface

	if shape == Enum.ParticleEmitterShape.Sphere then
		local unit = self:randomUnit(random)
		local depth = if surface then 1 else random:NextNumber() ^ (1 / 3)
		local first = self:getPerpendicular(unit)

		return unit * depth * half, unit * sign, first, unit:Cross(first).Unit
	elseif shape == Enum.ParticleEmitterShape.Cylinder or shape == Enum.ParticleEmitterShape.Disc then
		local angle = random:NextNumber(0, math.pi * 2)
		local depth = if surface then 1 else math.sqrt(random:NextNumber())
		local radial = face.first * math.cos(angle) + face.second * math.sin(angle)
		local along = if shape == Enum.ParticleEmitterShape.Disc then 0 else random:NextNumber(-1, 1)
		local point = (radial * depth + face.normal * along) * half

		return point, radial * sign, face.normal, radial:Cross(face.normal).Unit
	end

	local point = Vector3.new(random:NextNumber(-1, 1), random:NextNumber(-1, 1), random:NextNumber(-1, 1))

	if surface then
		point = point - face.normal * point:Dot(face.normal) + face.normal
	end

	return point * half, normal, face.first, face.second
end

function ParticlePaths:buildPath(emitter: ParticleEmitter, host: CFrame, size: Vector3?, random: Random): { Vector3 }
	local face = ParticlePaths.faces[emitter.EmissionDirection] or ParticlePaths.faces[Enum.NormalId.Top]
	local point, direction, first, second = self:getOrigin(emitter, face, size, random)
	local spread = emitter.SpreadAngle
	local tiltFirst = math.rad(random:NextNumber(-spread.X, spread.X))
	local tiltSecond = math.rad(random:NextNumber(-spread.Y, spread.Y))
	local aimed = (CFrame.fromAxisAngle(first, tiltFirst) * CFrame.fromAxisAngle(second, tiltSecond)):VectorToWorldSpace(direction)
	local speed = random:NextNumber(emitter.Speed.Min, emitter.Speed.Max)
	local lifetime = math.min(random:NextNumber(emitter.Lifetime.Min, emitter.Lifetime.Max), ParticlePaths.maximumLifetime)
	local start = host:PointToWorldSpace(point)
	local velocity = host:VectorToWorldSpace(aimed) * speed
	local acceleration = emitter.Acceleration
	local drag = emitter.Drag
	local segments = ParticlePaths.segments
	local points = table.create(segments + 1)

	for index = 0, segments do
		local time = lifetime * index / segments

		table.insert(points, start + velocity * self:getTravel(drag, time) + acceleration * (0.5 * time * time))
	end

	return points
end

function ParticlePaths:getPaths(emitter: ParticleEmitter): { { Vector3 } }
	local host, size = self:getHost(emitter)
	local paths = {}

	if not host then
		return paths
	end

	local random = Random.new(ParticlePaths.seed)

	for _ = 1, ParticlePaths.pathsPerEmitter do
		table.insert(paths, self:buildPath(emitter, host, size, random))
	end

	return paths
end

function ParticlePaths:draw(emitter: Instance)
	local record = self.records[emitter]

	if not record then
		return
	end

	local adornment = record.adornment

	adornment:Clear()

	if not emitter.Parent then
		return
	end

	adornment.Color3 = self:getColor(emitter :: ParticleEmitter)

	for _, points in self:getPaths(emitter :: ParticleEmitter) do
		adornment:AddPath(points, false)
	end
end

function ParticlePaths:schedule(emitter: Instance)
	self.dirty[emitter] = true

	if self.pending then
		return
	end

	self.pending = true

	task.defer(function()
		self.pending = false

		local dirty = self.dirty

		self.dirty = {}

		if not self.active or not self.enabled then
			return
		end

		for target in dirty do
			self:draw(target)
		end
	end)
end

function ParticlePaths:track(emitter: Instance)
	local adornment = Instance.new("WireframeHandleAdornment")

	adornment.Name = emitter.Name
	adornment.Adornee = workspace.Terrain
	adornment.AlwaysOnTop = true
	adornment.Transparency = ParticlePaths.transparency
	adornment.Thickness = ParticlePaths.thickness
	adornment.Visible = self.hidden ~= true
	adornment.Parent = self:getFolder()

	local record = { adornment = adornment, connections = {} }

	local function watch(instance: Instance?, property: string?)
		if not instance then
			return
		end

		local signal = if property then instance:GetPropertyChangedSignal(property) else (instance :: any).Changed

		table.insert(record.connections, signal:Connect(function()
			self:schedule(emitter)
		end))
	end

	local parent = emitter.Parent

	watch(emitter)

	if parent and parent:IsA("BasePart") then
		watch(parent, "CFrame")
		watch(parent, "Size")
	elseif parent and parent:IsA("Attachment") then
		watch(parent, "CFrame")

		if parent.Parent and parent.Parent:IsA("BasePart") then
			watch(parent.Parent, "CFrame")
		end
	end

	self.records[emitter] = record
end

function ParticlePaths:untrack(emitter: Instance)
	local record = self.records[emitter]

	if not record then
		return
	end

	for _, connection in record.connections do
		connection:Disconnect()
	end

	record.adornment:Destroy()
	self.records[emitter] = nil
end

function ParticlePaths:clear()
	for emitter in table.clone(self.records) do
		self:untrack(emitter)
	end

	table.clear(self.dirty)

	if self.folder then
		self.folder:Destroy()
		self.folder = nil
	end
end

function ParticlePaths:refresh()
	if not self.active or not self.enabled then
		return
	end

	local wanted = {}
	local count = 0

	for _, emitter in if self.emitterProvider then self.emitterProvider() else {} do
		if count >= ParticlePaths.maximumEmitters then
			break
		end

		if emitter:IsA("ParticleEmitter") and emitter.Parent then
			wanted[emitter] = true
			count += 1
		end
	end

	for emitter in table.clone(self.records) do
		self:untrack(emitter)
	end

	for emitter in wanted do
		self:track(emitter)
		self:draw(emitter)
	end
end

function ParticlePaths:setEnabled(enabled: boolean)
	if self.enabled == enabled then
		return
	end

	self.enabled = enabled

	if enabled then
		self:refresh()
	else
		self:clear()
	end

	if self.changedHandler then
		self.changedHandler(enabled)
	end
end

function ParticlePaths:toggle()
	self:setEnabled(not self.enabled)
end

function ParticlePaths:start()
	self.active = true
	self:refresh()
end

function ParticlePaths:stop()
	self.active = false
	self:clear()
end

function ParticlePaths:destroy()
	self:stop()
end

return ParticlePaths
]]></ProtectedString>
