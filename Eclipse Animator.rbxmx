							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">ScreenAttach</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Folder" referent="RBX05C5A32C7DA64004BFB47307AECC5066">
					<Properties>
						<Color3 name="IconTint">
							<R>0</R>
							<G>0</G>
							<B>0</B>
						</Color3>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">VFX</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
					<Item class="ModuleScript" referent="RBXDAADCC8B634949D8AFB1F4BE6CF5FD8B">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local HideManager = {}
HideManager.__index = HideManager

HideManager.attributePrefix = "ArcHideOriginal_"
HideManager.tolerance = 0.00001
HideManager.properties = {
	"Transparency",
	"BackgroundTransparency",
	"TextTransparency",
	"TextStrokeTransparency",
	"ImageTransparency",
	"GroupTransparency",
	"FillTransparency",
	"OutlineTransparency",
	"Opacity",
}

function HideManager.getHiddenValue(name: string, current)
	local kind = typeof(current)

	if kind == "NumberSequence" then
		return NumberSequence.new(if name == "Opacity" then 0 else 1)
	elseif kind == "number" then
		return if name == "Opacity" then 0 else 1
	end

	return nil
end

function HideManager.isSkipped(instance: Instance, name: string): boolean
	return name == "Transparency" and instance:IsA("GuiObject")
end

function HideManager.read(instance: Instance, name: string)
	local success, value = pcall(function()
		return (instance :: any)[name]
	end)

	return if success then value else nil
end

function HideManager.write(instance: Instance, name: string, value)
	pcall(function()
		(instance :: any)[name] = value
	end)
end

function HideManager.equals(a, b): boolean
	if typeof(a) ~= typeof(b) then
		return false
	end

	if typeof(a) == "number" then
		return math.abs(a - b) <= HideManager.tolerance
	end

	if typeof(a) == "NumberSequence" then
		local pointsA = a.Keypoints
		local pointsB = b.Keypoints

		if #pointsA ~= #pointsB then
			return false
		end

		for index, point in pointsA do
			local other = pointsB[index]

			if math.abs(point.Time - other.Time) > HideManager.tolerance or math.abs(point.Value - other.Value) > HideManager.tolerance or math.abs(point.Envelope - other.Envelope) > HideManager.tolerance then
				return false
			end
		end

		return true
	end

	return a == b
end

function HideManager.getProperties(instance: Instance): { string }
	local names = {}

	for _, name in HideManager.properties do
		if not HideManager.isSkipped(instance, name) then
			local value = HideManager.read(instance, name)

			if value ~= nil and HideManager.getHiddenValue(name, value) ~= nil then
				table.insert(names, name)
			end
		end
	end

	return names
end

function HideManager.restoreFromAttributes(instance: Instance)
	for name, value in instance:GetAttributes() do
		if string.sub(name, 1, #HideManager.attributePrefix) == HideManager.attributePrefix then
			HideManager.write(instance, string.sub(name, #HideManager.attributePrefix + 1), value)
			instance:SetAttribute(name, nil)
		end
	end
end

function HideManager.recover(root: Instance)
	for _, descendant in root:GetDescendants() do
		HideManager.restoreFromAttributes(descendant)
	end
end

function HideManager.new()
	local self = setmetatable({}, HideManager)

	self.roots = {}
	self.keyRoots = {}
	self.hiders = {}
	self.originals = {}
	self.changedHandler = nil
	self.connection = nil

	return self
end

function HideManager:setChangedHandler(handler: (() -> ())?)
	self.changedHandler = handler
end

function HideManager:isHidden(root: Instance): boolean
	return self.roots[root] ~= nil
end

function HideManager:isCovered(instance: Instance): boolean
	return self.hiders[instance] ~= nil
end

function HideManager:isAffected(instance: Instance): boolean
	return self.originals[instance] ~= nil
end

function HideManager:storeOriginal(instance: Instance, name: string, value)
	local originals = self.originals[instance]

	if not originals or (originals[name] ~= nil and HideManager.equals(originals[name], value)) then
		return
	end

	originals[name] = value

	pcall(function()
		instance:SetAttribute(HideManager.attributePrefix .. name, value)
	end)
end

function HideManager:hideInstance(instance: Instance, root: Instance)
	local hiders = self.hiders[instance]

	if not hiders then
		hiders = {}
		self.hiders[instance] = hiders
	end

	hiders[root] = true

	if self.originals[instance] then
		return
	end

	local names = HideManager.getProperties(instance)

	if #names == 0 then
		return
	end

	self.originals[instance] = {}

	for _, name in names do
		local value = HideManager.read(instance, name)

		self:storeOriginal(instance, name, value)
		HideManager.write(instance, name, HideManager.getHiddenValue(name, value))
	end
end

function HideManager:showInstance(instance: Instance, root: Instance)
	local hiders = self.hiders[instance]

	if not hiders then
		return
	end

	hiders[root] = nil

	if next(hiders) ~= nil then
		return
	end

	self.hiders[instance] = nil

	local originals = self.originals[instance]

	self.originals[instance] = nil

	for name, value in originals or {} do
		HideManager.write(instance, name, value)

		pcall(function()
			instance:SetAttribute(HideManager.attributePrefix .. name, nil)
		end)
	end
end

function HideManager:collect(root: Instance): { Instance }
	local instances = { root }

	for _, descendant in root:GetDescendants() do
		table.insert(instances, descendant)
	end

	return instances
end

function HideManager:hide(root: Instance)
	if self.roots[root] or not root.Parent then
		return
	end

	local members = self:collect(root)

	self.roots[root] = members

	for _, instance in members do
		self:hideInstance(instance, root)
	end

	self:ensureRunning()
	self:notifyChanged()
end

function HideManager:show(root: Instance)
	local members = self.roots[root]

	if not members then
		return
	end

	self.roots[root] = nil

	for _, instance in members do
		self:showInstance(instance, root)
	end

	if next(self.roots) == nil and next(self.keyRoots) == nil then
		self:stopRunning()
	end

	self:notifyChanged()
end

function HideManager:hideKeyed(source: Instance)
	if self.keyRoots[source] or not source.Parent then
		return
	end

	local token = { source = source }
	local members = self:collect(source)

	self.keyRoots[source] = { token = token, members = members }

	for _, instance in members do
		self:hideInstance(instance, token)
	end

	self:ensureRunning()
end

function HideManager:showKeyed(source: Instance)
	local record = self.keyRoots[source]

	if not record then
		return
	end

	self.keyRoots[source] = nil

	for _, instance in record.members do
		self:showInstance(instance, record.token)
	end

	if next(self.roots) == nil and next(self.keyRoots) == nil then
		self:stopRunning()
	end
end

function HideManager:isKeyHidden(source: Instance): boolean
	return self.keyRoots[source] ~= nil
end

function HideManager:showAllKeyed()
	for source in table.clone(self.keyRoots) do
		self:showKeyed(source)
	end
end

function HideManager:toggle(root: Instance)
	if self:isHidden(root) then
		self:show(root)
	else
		self:hide(root)
	end
end

function HideManager:notifyChanged()
	if self.changedHandler then
		self.changedHandler()
	end
end

function HideManager:enforce()
	for instance, originals in self.originals do
		if instance.Parent then
			for name in originals do
				local current = HideManager.read(instance, name)
				local hidden = HideManager.getHiddenValue(name, current)

				if hidden ~= nil and not HideManager.equals(current, hidden) then
					self:storeOriginal(instance, name, current)
					HideManager.write(instance, name, hidden)
				end
			end
		end
	end
end

function HideManager:ensureRunning()
	if self.connection then
		return
	end

	self.connection = runService.RenderStepped:Connect(function()
		self:enforce()
	end)
end

function HideManager:stopRunning()
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
end

function HideManager:captureTransform(source: Instance, state)
	local originals = self.originals[source]

	if not originals or not state or not state.properties then
		return state
	end

	local copy = nil

	for name, original in originals do
		local value = state.properties[name]

		if value ~= nil then
			local hidden = HideManager.getHiddenValue(name, value)

			if hidden ~= nil and not HideManager.equals(value, hidden) then
				self:storeOriginal(source, name, value)
			else
				if not copy then
					copy = table.clone(state)
					copy.properties = table.clone(state.properties)
				end

				copy.properties[name] = original
			end
		end
	end

	return copy or state
end

function HideManager:applyTransform(source: Instance, state)
	local originals = self.originals[source]

	if not originals or not state or not state.properties then
		return state
	end

	local copy = nil

	for name in originals do
		local value = state.properties[name]

		if value ~= nil then
			local hidden = HideManager.getHiddenValue(name, value)

			if hidden ~= nil then
				self:storeOriginal(source, name, value)

				if not copy then
					copy = table.clone(state)
					copy.properties = table.clone(state.properties)
				end

				copy.properties[name] = hidden
			end
		end
	end

	return copy or state
end

function HideManager:getRoots(): { Instance }
	local roots = {}

	for root in self.roots do
		table.insert(roots, root)
	end

	return roots
end

function HideManager:showAll()
	self:showAllKeyed()

	for _, root in self:getRoots() do
		self:show(root)
	end

	self:stopRunning()
end

function HideManager:destroy()
	self:showAll()
end

return HideManager
]]></ProtectedString>
