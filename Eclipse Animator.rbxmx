								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local premium_url = "https://arc-premium.netlify.app"

return {
	websiteUrl = premium_url,
	placeholderUrl = "YOUR_NETLIFY_URL_HERE",
	apiUrl = "",
	apiPath = "/api",
	endpoints = {
		status = "/status",
	},
	userQuery = "userId",
	cacheSeconds = 20,
	maxFeatureHeight = 150,

	title = "Premium",
	description = "Arc Premium is the paid tier of Arc. It is linked to your Roblox account, so it follows you to every place and every computer you sign in on.",
	emptyFeatures = "No Premium features yet.",
	getText = "Get Premium",
	ownedText = "Premium Active",
	linkInstructions = "Copy this link and open it in your browser to get Premium.",
	linkHint = "Click the link, press Ctrl+C, then paste it into your browser's address bar. Come back and press Refresh when you are done.",
	permissionNote = "<b>Permission needed:</b> to check Premium, Arc contacts <b>%s</b>. When Studio asks, click <b>Allow</b>. If you denied it, open the <b>Plugins</b> tab, click <b>Manage Plugins</b>, find Arc and allow HTTP requests to that address. That is the only permission Premium uses. You do not need to turn on Allow HTTP Requests in Game Settings.",

	statusText = "Status: %s",
	stateLabels = {
		Checking = "Checking",
		Owned = "Owned",
		NotOwned = "Not Owned",
		Error = "Error",
	},
	stateColors = {
		Checking = Color3.fromRGB(170, 170, 170),
		Owned = Color3.fromRGB(63, 185, 132),
		NotOwned = Color3.fromRGB(170, 170, 170),
		Error = Color3.fromRGB(229, 98, 107),
	},
	messages = {
		notConfigured = "Premium is not connected yet. The Premium website address has not been set in Arc.",
		noAccount = "Arc could not read your Roblox account. Sign in to Studio and press Refresh.",
		unreachable = "The Premium server could not be reached. Check your connection and the permission described at the bottom of this window, then press Refresh.",
		unavailable = "Roblox could not confirm your purchase right now. Press Refresh in a moment.",
		invalid = "The Premium server sent a reply Arc could not read. Press Refresh to try again.",
	},

	features = {
		{ id = "pointPath", title = "Point A to Point B", description = "Move an object between two positions along a smooth curve, as one draggable segment on the timeline." },
		{ id = "randomMotion", title = "Random CFrame Generator", description = "Controlled random movement over a duration, with separate amounts for each position and rotation axis." },
		{ id = "presets", title = "VFX Presets", description = "Insert ready-made effects from Arc's preset collection in Create's Library, kept apart from the VFX you save yourself." },
		{ id = "advancedRandomize", title = "Advanced Randomization", description = "Randomize any compatible property between a minimum and a maximum you choose." },
		{ id = "propertyFavorites", title = "Property Favorites", description = "Star the properties you use most so they sit at the top of the inspector and the keyframe editor." },
		{ id = "pinner", title = "Pinner", description = "Pin objects so they stay at the top of the hierarchy and the effects list." },
		{ id = "uiGradients", title = "UI Gradients", description = "Add gradients to Arc's theme colours." },
		{ id = "customIcons", title = "Custom Icons", description = "Replace the Arc and Create icons with your own images." },
		{ id = "stagger", title = "Stagger / Cascade", description = "Offset the keyframes of many objects so each starts a few frames after the last, in list, reverse or random order." },
		{ id = "motionTrails", title = "Motion Trails", description = "See the path selected objects travel as dots in the viewport, with keyframes marked." },
		{ id = "splinePath", title = "Spline Path", description = "Move objects through any number of points along one smooth curve, with an option to face along the path." },
		{ id = "orbitMotion", title = "Orbit / Spiral", description = "Circle or spiral objects with radius, end radius, turns, rise and tilt, as one draggable segment." },
		{ id = "wiggle", title = "Wiggle Any Property", description = "Add smooth or jittery random variation to any number property, including on screen-effect tracks." },
		{ id = "graphEditor", title = "Graph Editor", description = "See a track's values as curves over time and drag keyframes to change value or timing." },
		{ id = "markers", title = "Timeline Markers & Loop Region", description = "Named markers you can jump between, and a loop region so playback repeats just one part." },
		{ id = "reverseMirror", title = "Reverse / Mirror", description = "Play selected keyframes backwards in time, or mirror their movement across an axis." },
		{ id = "debrisPhysics", title = "Physics Debris", description = "Orbit and Explosion debris with gravity, bouncing and collisions, the same in game as in Arc." },
		{ id = "explodeParts", title = "Explode Parts", description = "Blast your own parts outward with physics and collisions, preview it, change the seed, and bake it into keyframes." },
		{ id = "flicker", title = "Flicker", description = "Make parts flicker their transparency every few seconds, to a set or random amount, with any easing style." },
		{ id = "cloneOverTime", title = "Clone Over Time", description = "Afterimage copies of an object spawned every few frames, fading out, as children of the object." },
		{ id = "simplifyKeys", title = "Simplify Keyframes", description = "Turn long runs of keyframes into a few, with the same movement and smoothness." },
		{ id = "autoSmooth", title = "Auto Smooth", description = "Bend a keyframe's motion through the keyframes around it so movement flows without stopping." },
		{ id = "projectHistory", title = "Project History", description = "Keep earlier saved versions of a project and restore any of them." },
	},
}
]]></ProtectedString>
