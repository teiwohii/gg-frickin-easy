							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = require(script.Parent.ShapeKit)

local shards = {}

shards.id = "Shards"
shards.title = "Shards"
shards.root = "Model"

shards.params = ShapeKit.join({
	{ name = "Count", kind = "number", default = 16, min = 1, max = 160, integer = true },
	{ name = "Radius", kind = "number", default = 2, min = 0, max = 200, tip = "How far from the centre each shard starts." },
	{ name = "Length", kind = "number", default = 4, min = 0.05, max = 200 },
	{ name = "Thickness", kind = "number", default = 0.5, min = 0.02, max = 50 },
	{ name = "Variation", kind = "number", default = 0.35, min = 0, max = 1, tip = "Random difference in length and thickness between shards." },
	{ name = "Distortion", kind = "number", default = 0.15, min = 0, max = 1, tip = "Random change to the direction each shard points." },
	{ name = "Hemisphere", kind = "toggle", default = false, tip = "Only spread the shards over the top half." },
	{ name = "Seed", kind = "number", default = 1, min = 1, max = 9999, integer = true },
}, ShapeKit.solidParams())

shards.goldenAngle = math.pi * (3 - math.sqrt(5))

function shards.build(kit, params)
	local count = math.clamp(math.round(params.Count), 1, 160)

	for index = 0, count - 1 do
		local share = (index + 0.5) / count
		local height = if params.Hemisphere then share else 1 - 2 * share
		local ring = math.sqrt(math.max(1 - height * height, 0))
		local theta = shards.goldenAngle * index
		local direction = Vector3.new(math.cos(theta) * ring, height, math.sin(theta) * ring)

		direction = direction + kit:randomUnit() * params.Distortion * 0.5

		if direction.Magnitude < 1e-3 then
			direction = Vector3.yAxis
		end

		direction = direction.Unit

		local length = math.max(params.Length * (1 + kit:jitter(params.Variation)), 0.05)
		local thickness = math.max(params.Thickness * (1 + kit:jitter(params.Variation * 0.5)), 0.02)

		kit:part("Shard", kit:aim(direction * (params.Radius + length / 2), direction), Vector3.new(thickness, thickness, length))
	end
end

return shards
]]></ProtectedString>
								<string name="ScriptGuid">{A9B3EA6D-DAC4-4627-99F9-D70C045CED83}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
