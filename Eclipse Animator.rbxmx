			"CurveSize0",
			"CurveSize1",
			"Texture",
			"TextureLength",
			"TextureSpeed",
			"LightEmission",
			"LightInfluence",
			"FaceCamera",
		},
	},
	{
		"Trail",
		{
			"Enabled",
			"Lifetime",
			"MinLength",
			"MaxLength",
			"Texture",
			"TextureLength",
			"LightEmission",
			"LightInfluence",
			"FaceCamera",
		},
	},
	{
		"Highlight",
		{
			"Enabled",
			"FillColor",
			"OutlineColor",
			"FillTransparency",
			"OutlineTransparency",
			"DepthMode",
		},
	},
	{ "ColorCorrectionEffect", { "Enabled", "Brightness", "Contrast", "Saturation", "TintColor" } },
	{ "BloomEffect", { "Enabled", "Intensity", "Size", "Threshold" } },
	{ "BlurEffect", { "Enabled", "Size" } },
	{
		"DepthOfFieldEffect",
		{ "Enabled", "FarIntensity", "FocusDistance", "InFocusRadius", "NearIntensity" },
	},
	{ "SunRaysEffect", { "Enabled", "Intensity", "Spread" } },
	{ "NumberValue", { "Value" } },
	{ "IntValue", { "Value" } },
	{ "BoolValue", { "Value" } },
	{ "StringValue", { "Value" } },
	{ "Color3Value", { "Value" } },
	{ "Vector3Value", { "Value" } },
	{ "CFrameValue", { "Value" } },
}
local members = setmetatable({}, { __mode = "k" })

local function aggregate(rig, id)
	return not effectObjects.is(rig)
		and (rig:IsA("Model") and rig.Parent ~= game)
		and (id == "Color" or id == "Transparency" or id == "Reflectance")
end

local function captures(rig, id)
	local rows = {}
	for _, object in rigTraversal.rigDescendants(rig) do
		if
			(object:IsA("BasePart") or id == "Transparency" and object:IsA("Decal"))
			and not paths.excluded(object, rig)
		then
			table.insert(rows, { path = paths.of(object, rig), value = object[id] })
		end
	end

	return rows
end

local function modelMembers(motor)
	local node = motor.Part1
	local source = node:GetAttribute("Members")
	local cache = members[node]
	if not cache or cache.source ~= source then
		local rows = source and document.unpack(source) or captures(motor.Rig, motor.PropertyId)
		cache = { source = source, rows = {} }
		members[node] = cache
		for _, row in rows do
			local object = paths.resolve(motor.Rig, row.path)
			if object then
				table.insert(cache.rows, { object = object, value = row.value })
			end
		end
	end

	return cache.rows
end

function tracksValue.restoreValue(motor)
	if aggregate(motor.Rig, motor.PropertyId) then
		for _, row in modelMembers(motor) do
			if row.object:IsDescendantOf(motor.Rig) then
				write(row.object, motor.PropertyId, row.value)
			end
		end

		motor.Part1:SetAttribute("Current", nil)
	else
		tracksValue.setValue(motor, motor.DefaultValue)
	end
end

local function finite(value)
	return typeof(value) == "number" and value == value and math.abs(value) < math.huge
end

local function isClock(rig, id)
	return rig:IsA("Lighting") and (id == "ClockTime" or id == "TimeOfDay")
end

local function clockValue(value)
	if typeof(value) == "number" then
		return value
	end

	if typeof(value) ~= "string" then
		return nil
	end

	local number = tonumber(value)
	if number then
		return number
	end

	local h, m, s = value:match("^%s*(%d+):(%d+):?([%d%.]*)%s*$")
	if not h then
		return nil
	end

	h, m, s = tonumber(h), tonumber(m), tonumber(s) or 0
	if m >= 60 or s >= 60 then
		return nil
	end

	return h + m / 60 + s / 3600
end

function tracksValue.readValue(rig, id)
	local texture = textureDefinition(id)
	if texture then
		local object, property = textureTarget(rig, texture)
		if object then
			return object[property]
		end
		local folder = tracksValue.folder(rig, false)
		local node = folder and folder:FindFirstChild(id)
		local current = node and node:GetAttribute("Current")
		local saved = node and node:GetAttribute("Default")
		return current or saved and document.unpack(saved) or ""
	end
	local face, name = faceProperty(rig, id)
	if face then
		return face[name]
	end
	if name then
		local folder = tracksValue.folder(rig, false)
		local node = folder and folder:FindFirstChild(id)
		local current = node and node:GetAttribute("Current")
		local saved = node and node:GetAttribute("Default")
		return current or saved and document.unpack(saved) or 0
	end
	if effectObjects.is(rig) then
		return effectObjects.read(rig, id)
	end

	if emitKeys.supports(rig, id) then
		local folder = tracksValue.folder(rig, false)
		local node = folder and folder:FindFirstChild(id)
		local current = node and node:GetAttribute("Current")
		if current ~= nil then
			return current
		end

		local saved = node and node:GetAttribute("Default")
		return saved and document.unpack(saved) or emitKeys.default(rig)
	end

	if isClock(rig, id) then
		return rig.ClockTime
	end

	if aggregate(rig, id) then
		local folder = tracksValue.folder(rig, false)
		local node = folder and folder:FindFirstChild(id)
		local current = node and node:GetAttribute("Current")
		if current ~= nil then
			return current
		end

		if id ~= "Color" then
			return 0
		end

		for _, object in rigTraversal.rigDescendants(rig) do
			if object:IsA("BasePart") and not paths.excluded(object, rig) then
				return object.Color
			end
		end

		return Color3.new(1, 1, 1)
	end

	if id == "ApplyMesh" then
		return rig.MeshId
	end

	if (rig:IsA("Model") and rig.Parent ~= game) and id == "Scale" then
		return rig:GetScale()
	end

	if (rig:IsA("Model") and rig.Parent ~= game) and id == "CFrame" then
		return require("rigPose").modelFrame(rig) or rig:GetPivot()
	end

	return rig[id == "ApplyTexture" and "TextureID" or id]
end

function tracksValue.prepare(motor, value)
	if motor.PropertyId ~= "ApplyMesh" then
		return
	end

	local rig = motor.Rig
	local cache = meshes[rig]
	if not cache then
		cache = {}
		meshes[rig] = cache
		local original = Instance.new("MeshPart")
		original:ApplyMesh(rig)
		cache[rig.MeshId] = original
		rig.Destroying:Once(function()
			for _, part in cache do
				part:Destroy()
			end

			meshes[rig] = nil
		end)
	end

	if cache[value] then
		return
	end

	assert(value:match("^rbxassetid://%d+$") or value:match("^https?://"), "Enter a mesh asset URL")
	cache[value] = game:GetService("AssetService"):CreateMeshPartAsync(
		Content.fromUri(value),
		{ CollisionFidelity = rig.CollisionFidelity, RenderFidelity = rig.RenderFidelity }
	)
end

local reflected = {}
local supported = {
	number = true,
	boolean = true,
	string = true,
	EnumItem = true,
	Vector2 = true,
	Vector3 = true,
	Color3 = true,
	CFrame = true,
	NumberRange = true,
	UDim = true,
	UDim2 = true,
	Rect = true,
	BrickColor = true,
	NumberSequence = true,
	ColorSequence = true,
}
local excluded = {
	Name = true,
	Parent = true,
	Archivable = true,
	Source = true,
	Capabilities = true,
	Sandboxed = true,
	UniqueId = true,
	HistoryId = true,
	Tags = true,
	Attributes = true,
}

local function reflectedNames(class)
	if reflected[class] then
		return reflected[class]
	end

	local names = {}
	local ok, properties = pcall(function()
		return game:GetService("ReflectionService"):GetPropertiesOfClass(class)
	end)
	if ok then
		for _, property in properties do
			if
				property.Permits.Write ~= nil
				and property.Permits.Read ~= nil
				and property.Display
				and not property.Display.DeprecationMessage
				and not excluded[property.Name]
				and property.Owner ~= "Instance"
				and property.Owner ~= "Object"
			then
				table.insert(names, property.Name)
			end
		end
	end

	table.sort(names)
	reflected[class] = names
	return names
end

function tracksValue.propertyOnly(object)
	return object.Parent == game
		or object:IsA("Terrain")
		or not (object:IsA("Model") or object:IsA("BasePart"))
end

function tracksValue.catalog(rig)
	if rig and rig:IsA("NumberValue") and rig:GetAttribute("EclipseMovementGrid") == true then
		return { { id = "Value", label = "Speed", kind = "number" } }
	end
	if effectObjects.is(rig) then
		return effectObjects.catalog(rig)
	end

	if
		not rig
		or rig:IsA("LuaSourceContainer")
		or rig:IsA("Folder")
		or rig:IsA("DataModel")
		or rig.Parent == game and not rig:IsA("Lighting")
	then
		return {}
	end

	if camera.isRig(rig) then
		return {
			{ id = "CFrame", label = "CFrame", kind = "CFrame", builtin = true },
			{ id = "FieldOfView", label = "FOV", kind = "number", builtin = true },
		}
	end

	local list, seen = {}, {}
	if rig:IsA("Model") or rig:IsA("BasePart") then
		local identities, saved = {}, {}
		local folder = tracksValue.folder(rig, false)
		for _, node in folder and folder:GetChildren() or {} do
			local id = node:GetAttribute("EclipseProperty")
			local def = type(id) == "string" and textureDefinition(id)
			if def and def.textureId then
				saved[def.textureId] = def
			end
		end
		for _, object in rigTraversal.rigDescendants(rig) do
			if textureProperty(object) and not paths.excluded(object, rig) then
				local identity = object:GetAttribute("EclipseMeshTextureId")
				if type(identity) ~= "string" or identities[identity] then
					identity = game:GetService("HttpService"):GenerateGUID(false)
					object:SetAttribute("EclipseMeshTextureId", identity)
				end
				identities[identity] = true
				local path = paths.of(object, rig)
				if path then
					local steps = game:GetService("HttpService"):JSONDecode(path)
					steps[#steps][4] = identity
					path = game:GetService("HttpService"):JSONEncode(steps)
					local def = saved[identity] or textureDefinition(meshTexturePrefix .. path)
					if def and not seen[def.id] then
						seen[def.id] = true
						table.insert(list, def)
					end
				end
			end
		end
	end
	local face = tracksValue.faceControls(rig)
	if face and face ~= rig then
		for _, name in faceNames do
			table.insert(
				list,
				{ id = "FaceControls." .. name, label = name, kind = "number", facial = true }
			)
		end
	end

	local function add(id)
		if seen[id] then
			return
		end

		seen[id] = true
		if rig:IsA("Lighting") and id == "TimeOfDay" then
			local folder = tracksValue.folder(rig, false)
			if not folder or not folder:FindFirstChild(id) then
				return
			end
		end

		if
			rig:IsA("Terrain")
				and ({
					CFrame = true,
					Position = true,
					Orientation = true,
					PivotOffset = true,
					Size = true,
				})[id]
			or rig:IsA("Workspace") and id == "WorldPivot"
		then
			return
		end

		local ok, value = pcall(tracksValue.readValue, rig, id)
		if ok and supported[typeof(value)] then
			table.insert(list, {
				id = id,
				label = (id == "ApplyTexture" or rig:IsA("SpecialMesh") and id == "TextureId")
						and "Mesh Texture"
					or id,
				kind = typeof(value),
				enum = typeof(value) == "EnumItem" and value.EnumType or nil,
				trigger = emitKeys.supports(rig, id) or nil,
			})
		end
	end

	for _, schema in schemas do
		if
			rig:IsA(schema[1]) and not (rig.Parent == game or rig:IsA("Terrain"))
			or rig.ClassName == schema[1]
		then
			for _, id in schema[2] do
				add(id)
			end
		end
	end

	for _, id in reflectedNames(rig.ClassName) do
		if id ~= "TextureID" or not rig:IsA("MeshPart") then
			add(id)
		end
	end

	return list
end

function tracksValue.definition(rig, id)
	local texture = textureDefinition(id)
	if texture and (rig:IsA("Model") or rig:IsA("BasePart")) then
		return texture
	end
	local _, faceName = faceProperty(rig, id)
	if faceName and (rig:IsA("Model") or rig:IsA("BasePart")) then
		return { id = id, label = faceName, kind = "number", facial = true }
	end
	if rig:IsA("Lighting") and id == "TimeOfDay" then
		return { id = id, label = id, kind = "number" }
	end

	for _, def in tracksValue.catalog(rig) do
		if def.id == id then
			return def
		end
	end
end

function tracksValue.inheritedTransform(rig)
	if not rig or not (rig:IsA("BasePart") or rig:IsA("Model")) then
		return false
	end

	local state = require("state")
	for _, owner in state.getAllRigs and state.getAllRigs() or {} do
		if owner ~= rig and owner:IsA("Model") and rig:IsDescendantOf(owner) then
			return true
		end
	end

	local root = rig:IsA("BasePart") and rig
		or rig.PrimaryPart
		or require("masterControl").root(rig)
	if root then
		local tree = require("rigTraversal")
		local passive = tree.passiveMotors(rig)
		for _, joint in require("rigTraversal").joints(root) do
			if
				not (joint:IsA("Motor6D") or joint:IsA("Weld") or joint:IsA("ManualWeld") or joint:IsA("WeldConstraint"))
				or not joint.Enabled
			then
				continue
			end
			local parent = joint.Part1 == root and joint.Part0
				or (passive[joint] or tree.outsideDriver(rig, joint)) and joint.Part1
			if parent and parent ~= root and not parent:IsDescendantOf(rig) then
				for _, owner in state.getAllRigs and state.getAllRigs() or {} do
					if owner ~= rig and (parent == owner or parent:IsDescendantOf(owner)) then
						return true
					end
				end
			end
		end
	end

	return false
end

function tracksValue.required(rig, id)
	if effectObjects.is(rig) then
		return false
	end

	if id ~= "CFrame" or camera.isRig(rig) or rig.Parent == game or rig:IsA("Terrain") then
		return false
	end

	if rig:IsA("Model") and rig.Parent ~= game then
		local humanoid = rig:FindFirstChildOfClass("Humanoid")
		if
			humanoid
			and (
				humanoid.RigType == Enum.HumanoidRigType.R6 and rig:FindFirstChild("Torso")
				or humanoid.RigType == Enum.HumanoidRigType.R15
					and rig:FindFirstChild("UpperTorso")
					and rig:FindFirstChild("LowerTorso")
			)
		then
			return false
		end

		return not tracksValue.inheritedTransform(rig)
	end

	return (rig:IsA("BasePart") or rig:IsA("Attachment")) and not tracksValue.inheritedTransform(rig)
end

function tracksValue.owner(node)
	return owners[node] or node.Parent and owners[node.Parent]
end

function tracksValue.folder(rig, create)
	local folder = folders[rig]
	if folder then
		return folder
	end

	for _, child in rig:GetChildren() do
		if child:IsA("Folder") and child:GetAttribute("EclipsePropertyTracks") == 1 then
			folder = child
			break
		end
	end

	if not folder and create then
		folder = Instance.new("Folder")
		folder.Name = "Properties"
		folder:SetAttribute("EclipsePropertyTracks", 1)
	end

	if folder then
		folder.Parent = nil
		folder.Archivable = false
		folders[rig] = folder
		owners[folder] = rig
		hooks[rig] = rig.Destroying:Once(function()
			hooks[rig] = nil
		end)
	end

	return folder
end

function tracksValue.is(motor)
	return typeof(motor) == "table" and motor.IsEclipseProperty == true
end

function tracksValue.isNode(node)
	return typeof(node) == "Instance"
		and node:GetAttribute("EclipseProperty") ~= nil
		and node.Parent
		and node.Parent:GetAttribute("EclipsePropertyTracks") == 1
end

function tracksValue.encode(value)
	local kind = typeof(value)
	if kind == "CFrame" then
		return value
	end

	if kind == "number" then
		return CFrame.new(value, 0, 0)
	end

	if kind == "Vector3" then
		return CFrame.new(value)
	end

	if kind == "Vector2" then
		return CFrame.new(value.X, value.Y, 0)
	end

	if kind == "Color3" then
		return CFrame.new(value.R, value.G, value.B)
	end

	if kind == "NumberRange" then
		return CFrame.new(value.Min, value.Max, 0)
	end

	return CFrame.identity
end

function tracksValue.decode(motor, cf, explicit)
	local kind = motor.Definition.kind
	if isClock(motor.Rig, motor.PropertyId) and explicit ~= nil then
		return assert(clockValue(explicit), "Enter a time from 0 to 24 hours")
	end

	if explicit ~= nil and typeof(explicit) == kind then
		return explicit
	end

	if kind == "CFrame" then
		return cf
	end

	if kind == "number" then
		return cf.X
	end

	if kind == "Vector3" then
		return cf.Position
	end

	if kind == "Vector2" then
		return Vector2.new(cf.X, cf.Y)
	end

	if kind == "Color3" then
		return Color3.new(math.clamp(cf.X, 0, 1), math.clamp(cf.Y, 0, 1), math.clamp(cf.Z, 0, 1))
	end

	if kind == "NumberRange" then
		return NumberRange.new(math.min(cf.X, cf.Y), math.max(cf.X, cf.Y))
	end

	return motor.DefaultValue
end

function tracksValue.validate(motor, value)
	if require("afterimageBinding").is(motor.Rig) then
		return require("afterimageConfig").valid(motor.PropertyId, value)
	end
	if typeof(value) ~= motor.Definition.kind then
		return false
	end

	local ok = pcall(document.pack, value)
	if not ok then
		return false
	end

	local id = motor.PropertyId
	if motor.Definition.enum and value.EnumType ~= motor.Definition.enum then
		return false
	end

	if typeof(value) == "number" and not finite(value) then
		return false
	end

	if motor.Definition.facial or motor.Rig:IsA("FaceControls") then
		return typeof(value) == "number" and value >= 0 and value <= 1
	end

	if id == "Depth" and effectObjects.is(motor.Rig) then
		return value >= 0.05 and value <= 10000
	end

	if id == "ZIndex" and effectObjects.is(motor.Rig) then
		return value >= -100 and value <= 100
	end

	if id == "Scale" and typeof(value) == "number" then
		return value >= 0.001 and value <= 10000
	end

	if id == "Size" and typeof(value) == "Vector3" then
		return value.X >= 0.001 and value.Y >= 0.001 and value.Z >= 0.001
	end

	 
	if
		(id:find("Transparency") or id == "Reflectance")
		and typeof(value) == "number"
		and (aggregate(motor.Rig, id) or effectObjects.is(motor.Rig))
	then
		return value >= 0 and value <= 1
	end

	if isClock(motor.Rig, id) then
		return finite(value) and value >= 0 and value <= 24
	end

	if id == "FieldOfView" then
		return value >= 1 and value <= 120
	end

	if motor.Definition.trigger then
		return value >= 0 and value <= emitKeys.LIMIT
	end

	return true
end

function tracksValue.setValue(motor, value)
	assert(tracksValue.validate(motor, value), "Invalid " .. motor.PropertyId .. " value")
	local rig, id = motor.Rig, motor.PropertyId
	local texture = textureDefinition(id)
	if texture then
		local object, property = textureTarget(rig, texture)
		if motor.Part1:GetAttribute("Current") ~= value then
			motor.Part1:SetAttribute("Current", value)
		end
		if object and object[property] ~= value then
			write(object, property, value)
		end
		return
	end
	local face, name = faceProperty(rig, id)
	if name then
		motor.Part1:SetAttribute("Current", value)
		if face and face[name] ~= value then
			write(face, name, value)
		end
		return
	end
	if motor.Definition.trigger then
		if motor.Part1:GetAttribute("Current") ~= value then
			motor.Part1:SetAttribute("Current", value)
		end

		return
	end

	if effectObjects.is(rig) then
		effectObjects.write(rig, id, value)
		return
	end

	if isClock(rig, id) then
		if rig.ClockTime ~= value % 24 then
			rig.ClockTime = value % 24
		end

		return
	end

	if aggregate(rig, id) then
		motor.Part1:SetAttribute("Current", value)
		for _, row in modelMembers(motor) do
			if row.object:IsDescendantOf(rig) then
				local changed = id == "Color" and value or row.value + (1 - row.value) * value
				if row.object[id] ~= changed then
					write(row.object, id, changed)
				end
			end
		end
	elseif id == "ApplyMesh" then
		if rig.MeshId == value then
			return
		end

		local mesh = meshes[rig] and meshes[rig][value]
		assert(mesh, "Mesh asset has not loaded")
		local size, texture = rig.Size, rig.TextureID
		rig:ApplyMesh(mesh)
		rig.Size = size
		rig.TextureID = texture
	elseif (rig:IsA("Model") and rig.Parent ~= game) and id == "Scale" then
		local previousScale = rig:GetScale()
		if math.abs(previousScale - value) > 1e-7 then
			local transforms = {}
			for _, child in rig:GetDescendants() do
				if child:IsA("Bone") then
					transforms[child] = child.Transform
				end
			end
			if EventDependencies.isPosing() then
				EventDependencies.poseModel(rig, "scale", value)
			else
				rig:ScaleTo(value)
			end
			local ratio = value / previousScale
			for bone, transform in transforms do
				write(bone, "Transform", transform.Rotation + transform.Position * ratio)
			end
		end
	elseif (rig:IsA("Model") and rig.Parent ~= game) and id == "CFrame" then
		value = require("rigPose").modelPivot(rig, value)
		require("armatureRuntime").withPlacement(rig, function()
			if require("boundMotion").apply(rig, value) then
				return
			end
			if rig:GetPivot() ~= value then
				if EventDependencies.isPosing() then
					EventDependencies.poseModel(rig, "pivot", value)
				else
					rig:PivotTo(value)
				end
			end
		end)
	else
		if id == "CFrame" and rig:IsA("BasePart") and require("boundMotion").apply(rig, value) then
			return
		end
		local property = id == "ApplyTexture" and "TextureID" or id
		if rig[property] ~= value then
			write(rig, property, value)
		end
	end
end

local defaultCache = setmetatable({}, { __mode = "k" })
local inertRows = setmetatable({}, { __mode = "k" })
local unreadable = setmetatable({}, { __mode = "k" })
local unreadableValue = "EclipsePropertiesUnreadable"

local function sameInert(previous, current)
	if type(previous) ~= "table" or #previous ~= #current then
		return false
	end

	for index, row in current do
		if previous[index] ~= row then
			return false
		end
	end

	return true
end

function tracksValue.fromNode(node)
	if not tracksValue.isNode(node) then
		return nil
	end

	if nodes[node] then
		return nodes[node]
	end

	local rig = tracksValue.owner(node) or node.Parent.Parent
	local id = node:GetAttribute("EclipseProperty")
	local def = tracksValue.definition(rig, id)
	if not def then
		return nil
	end

	local motor = {
		Rig = rig,
		PropertyId = id,
		Definition = def,
		IsEclipseProperty = true,
		Part1 = node,
		Part0 = { CFrame = CFrame.identity },
		C1 = CFrame.identity,
	}
	setmetatable(motor, {
		__index = function(_, key)
			if key == "Parent" then
				return node.Parent and rig.Parent and rig
			end

			if key == "Name" then
				return node.Name
			end

			if key == "DefaultValue" then
				local raw = node:GetAttribute("Default")
				local cached = defaultCache[node]
				if not cached or cached.raw ~= raw then
					cached = { raw = raw, value = document.unpack(raw) }
					defaultCache[node] = cached
				end

				local value = cached.value
				return isClock(rig, id) and assert(clockValue(value), "Invalid saved time of day")
					or value
			end

			if key == "C0" then
				return tracksValue.encode(tracksValue.readValue(rig, id))
			end

			if key == "GetAttribute" then
				return function(_, name)
					return node:GetAttribute(name)
				end
			end

			if key == "SetAttribute" then
				return function(_, name, value)
					node:SetAttribute(name, value)
				end
			end

			if key == "GetAttributes" then
				return function()
					return node:GetAttributes()
				end
			end

			if key == "IsA" then
				return function(_, class)
					return class == "Motor6D"
				end
			end
		end,
		__newindex = function(_, key, value)
			if key == "C0" then
				tracksValue.setValue(motor, tracksValue.decode(motor, value))
			else
				rawset(motor, key, value)
			end
		end,
	})
	nodes[node] = motor
	return motor
end

function tracksValue.list(rig, includeDisabled, skipRequired)
	if not skipRequired and tracksValue.faceControls(rig) and not rig:IsA("FaceControls") then
		local storage = tracksValue.folder(rig, true)
		for _, name in faceNames do
			local id = "FaceControls." .. name
			if not storage:FindFirstChild(id) then
				tracksValue.enable(rig, id, true)
			end
		end
	end
	if not skipRequired and tracksValue.required(rig, "CFrame") then
		local storage = tracksValue.folder(rig, false)
		local node = storage and storage:FindFirstChild("CFrame")
		if not node or node:GetAttribute("Enabled") == false then
			tracksValue.enable(rig, "CFrame", true)
		end
	end

	local folder = tracksValue.folder(rig, false)
	local out = {}
	if folder then
		for _, node in folder:GetChildren() do
			local motor = tracksValue.fromNode(node)
			if motor and (includeDisabled or node:GetAttribute("Enabled") ~= false) then
				table.insert(out, motor)
			end
		end
	end

	table.sort(out, function(a, b)
		return a.PropertyId < b.PropertyId
	end)
	return out
end

function tracksValue.enable(rig, id, enabled, raw)
	if tracksValue.required(rig, id) then
		enabled = true
	end

	assert(tracksValue.definition(rig, id), "This item does not support " .. id)
	if camera.isRig(rig) then
		rig:SetAttribute("EclipsePropertyEnabled_" .. id, nil)
		local motor = camera.motor(rig, id == "CFrame" and "CamPart" or "FovPart")
		return motor
	end

	local motor
	for _, candidate in tracksValue.list(rig, true, true) do
		if candidate.PropertyId == id then
			motor = candidate
			break
		end
	end

	if not motor then
		local node = Instance.new("Folder")
		node.Name = id
		node:SetAttribute("EclipseProperty", id)
		node:SetAttribute("Default", document.pack(tracksValue.readValue(rig, id)))
		if aggregate(rig, id) then
			node:SetAttribute("Members", document.pack(captures(rig, id)))
		end

		node.Parent = tracksValue.folder(rig, true)
		motor = tracksValue.fromNode(node)
	end

	motor.Part1:SetAttribute("Enabled", enabled)
	tracksValue.prepare(motor, motor.DefaultValue)
	if raw then
		raw.DefaultPose[motor] = tracksValue.encode(motor.DefaultValue)
		raw.MotorByPart[motor.Part1] = motor
		raw.ParentingDefaults[motor] = true
	end

	if not enabled then
		tracksValue.restoreValue(motor)
	end

	return motor
end

function tracksValue.enabled(rig, id)
	if camera.isRig(rig) then
		return id == "CFrame" or id == "FieldOfView"
	end

	for _, motor in tracksValue.list(rig, true) do
		if motor.PropertyId == id then
			return motor.Part1:GetAttribute("Enabled") ~= false
		end
	end

	return false
end

local function validScale(value)
	return typeof(value) == "number" and value > 0 and value < math.huge
end

function tracksValue.scaleBasis(motor)
	local value = motor.Part1:GetAttribute("EclipseScaleBasis")
	return validScale(value) and value or motor.DefaultValue
end

function tracksValue.scaleFactor(motor)
	if tracksValue.is(motor) or typeof(motor) == "table" and motor.IsEclipseMasterControl then
		return 1
	end

	local part = motor.Part1
	while typeof(part) == "Instance" do
		if part:IsA("Model") then
			for _, property in tracksValue.list(part, true) do
				if property.PropertyId == "Scale" then
					return part:GetScale() / tracksValue.scaleBasis(property)
				end
			end
		end

		part = part.Parent
	end

	return 1
end

function tracksValue.basePose(motor, cf)
	if not cf then
		return nil
	end

	local factor = tracksValue.scaleFactor(motor)
	return factor == 1 and cf or CFrame.new(cf.Position / factor) * cf.Rotation
end

local complex = {
	UDim = true,
	UDim2 = true,
	Rect = true,
	BrickColor = true,
	NumberSequence = true,
	ColorSequence = true,
}

local function blendProperty(a, b, sample)
	local kind = typeof(a)

	local function color(get)
		return Color3.new(
			math.clamp(
				sample(function(v)
					return get(v).R
				end),
				0,
				1
			),
			math.clamp(
				sample(function(v)
					return get(v).G
				end),
				0,
				1
			),
			math.clamp(
				sample(function(v)
					return get(v).B
				end),
				0,
				1
			)
		)
	end

	if kind == "UDim" then
		return UDim.new(
			sample(function(v)
				return v.Scale
			end),
			sample(function(v)
				return v.Offset
			end)
		)
	end

	if kind == "UDim2" then
		return UDim2.new(
			sample(function(v)
				return v.X.Scale
			end),
			sample(function(v)
				return v.X.Offset
			end),
			sample(function(v)
				return v.Y.Scale
			end),
			sample(function(v)
				return v.Y.Offset
			end)
		)
	end

	if kind == "Rect" then
		return Rect.new(
			sample(function(v)
				return v.Min.X
			end),
			sample(function(v)
				return v.Min.Y
			end),
			sample(function(v)
				return v.Max.X
			end),
			sample(function(v)
				return v.Max.Y
			end)
		)
	end

	if kind == "BrickColor" then
		return BrickColor.new(color(function(v)
			return v.Color
		end))
	end

	local times, seen = {}, {}
	for _, sequence in { a, b } do
		for _, key in sequence.Keypoints do
			if not seen[key.Time] then
				seen[key.Time] = true
				table.insert(times, key.Time)
			end
		end
	end

	table.sort(times)

	local function at(sequence, time)
		local keys = sequence.Keypoints
		for i = 2, #keys do
			if keys[i].Time >= time then
				local l, r = keys[i - 1], keys[i]
				local t = (time - l.Time) / (r.Time - l.Time)
				if kind == "ColorSequence" then
					return l.Value:Lerp(r.Value, t), 0
				end

				return l.Value + (r.Value - l.Value) * t, l.Envelope + (r.Envelope - l.Envelope) * t
			end
		end
	end

	local keys = {}
	for _, time in times do
		if kind == "ColorSequence" then
			table.insert(
				keys,
				ColorSequenceKeypoint.new(
					time,
					color(function(v)
						return at(v, time)
					end)
				)
			)
		else
			local value = sample(function(v)
				return at(v, time)
			end)
			local envelope = sample(function(v)
				local _, e = at(v, time)
				return e
			end)
			table.insert(keys, NumberSequenceKeypoint.new(time, value, math.max(0, envelope)))
		end
	end

	while #keys > 20 do
		local best, errorAt = 2, math.huge
		for i = 2, #keys - 1 do
			local l, k, r = keys[i - 1], keys[i], keys[i + 1]
			local t = (k.Time - l.Time) / (r.Time - l.Time)
			local error
			if kind == "ColorSequence" then
				local c = l.Value:Lerp(r.Value, t)
				error = (Vector3.new(k.Value.R, k.Value.G, k.Value.B) - Vector3.new(c.R, c.G, c.B)).Magnitude
			else
				error = math.abs(k.Value - (l.Value + (r.Value - l.Value) * t))
					+ math.abs(k.Envelope - (l.Envelope + (r.Envelope - l.Envelope) * t))
			end

			if error < errorAt then
				best, errorAt = i, error
			end
		end

		table.remove(keys, best)
	end

	return kind == "ColorSequence" and ColorSequence.new(keys) or NumberSequence.new(keys)
end

local function activePropertyBucket(motor, bucket)
	local cache = bucket and require("poseCache").poseCache()
	local views
	if cache and cache.persistent then
		cache.propertyBuckets = cache.propertyBuckets or setmetatable({}, { __mode = "k" })
		views = cache.propertyBuckets[bucket]
		if not views then
			views = setmetatable({}, { __mode = "k" })
			cache.propertyBuckets[bucket] = views
		end

		if views[motor] ~= nil then
			return views[motor] == true and bucket or views[motor]
		end
	end

	local active
	if isClock(motor.Rig, motor.PropertyId) then
		active = {}
		for frame, key in bucket or {} do
			if not key.Disabled then
				local value = tracksValue.decode(motor, key.C0, key.PropertyValue)
				local copy = table.clone(key)
				copy.C0 = tracksValue.encode(value)
				copy.Position = copy.C0.Position
				copy.PropertyValue = value
				active[frame] = copy
			end
		end
	else
		local hasDisabled = false
		for _, key in bucket or {} do
			if key.Disabled then
				hasDisabled = true
				break
			end
		end

		if hasDisabled then
			active = {}
			for frame, key in bucket do
				if not key.Disabled then
					active[frame] = key
				end
			end
		else
			active = bucket or {}
		end
	end

	if views then
		views[motor] = active == bucket and true or active
	end

	return active
end

function tracksValue.evaluate(motor, bucket, time, loopEnd)
	bucket = activePropertyBucket(motor, require("policy").activeBucket(bucket))
	local previous, following
	local index = interp.index(bucket)
	if index then
		local p = interp.search(index, time)
		previous = index[p] and index[p].key
		following = index[p + 1] and index[p + 1].key
	else
		for _, key in bucket or {} do
			if not key.Disabled then
				if key.Time <= time and (not previous or key.Time > previous.Time) then
					previous = key
				end

				if key.Time > time and (not following or key.Time < following.Time) then
					following = key
				end
			end
		end
	end

	if not previous and not following then
		return motor.DefaultValue
	end

	if not previous then
		return tracksValue.decode(motor, following.C0, following.PropertyValue)
	end

	if not following or previous.Time == time then
		return tracksValue.decode(motor, previous.C0, previous.PropertyValue)
	end

	if
		motor.Definition.trigger
		or table.find({ "string", "boolean", "EnumItem" }, motor.Definition.kind)
	then
		return tracksValue.decode(motor, previous.C0, previous.PropertyValue)
	end

	local alpha = (time - previous.Time) / (following.Time - previous.Time)
	if complex[motor.Definition.kind] then
		local source = bucket
		if index then
			source = {}
			local p = interp.search(index, time)
			for _, i in { 1, 2, #index - 1, #index, p - 1, p, p + 1, p + 2 } do
				local row = index[i]
				if row then
					source[row.frame] = row.key
				end
			end
		end

		local function sample(extract)
			local projected = {}
			local left, right
			for frame, key in source do
				local point = table.clone(key)
				point.C0 =
					CFrame.new(extract(tracksValue.decode(motor, key.C0, key.PropertyValue)), 0, 0)
				projected[frame] = point
				if key == previous then
					left = point
				elseif key == following then
					right = point
				end
			end

			return interp.cframe(projected, left, right, alpha, "C0", loopEnd).X
		end

		return blendProperty(
			tracksValue.decode(motor, previous.C0, previous.PropertyValue),
			tracksValue.decode(motor, following.C0, following.PropertyValue),
			sample
		)
	end

	local value =
		tracksValue.decode(motor, interp.cframe(bucket, previous, following, alpha, "C0", loopEnd))
	local id = motor.PropertyId
	if typeof(value) == "number" then
		if motor.Definition.facial or motor.Rig:IsA("FaceControls") then
			value = math.clamp(value, 0, 1)
		elseif isClock(motor.Rig, id) then
			value = math.clamp(value, 0, 24)
		elseif id == "Scale" then
			value = math.clamp(value, 0.001, 10000)
		elseif
			(id:find("Transparency") or id == "Reflectance")
			and (aggregate(motor.Rig, id) or effectObjects.is(motor.Rig))
		then
			value = math.clamp(value, 0, 1)
		elseif id == "FieldOfView" then
			value = math.clamp(value, 1, 120)
		end
	elseif id == "Size" and typeof(value) == "Vector3" then
		value = Vector3.new(
			math.max(0.001, value.X),
			math.max(0.001, value.Y),
			math.max(0.001, value.Z)
		)
	end

	return value
end

function tracksValue.withScaleState(rigs, callback)
	local captured = {}
	for _, rig in rigs do
		if rig:IsA("Model") and rig.Parent ~= game then
			local folder = tracksValue.folder(rig, false)
			local node = folder and folder:FindFirstChild("Scale")
			if node and (node:GetAttribute("Enabled") ~= false
				or validScale(node:GetAttribute("EclipseScaleBasis"))) then
				captured[rig] = { scale = rig:GetScale(), motor = tracksValue.fromNode(node) }
			end
		end
	end
	local result = table.pack(pcall(callback))
	if not result[1] then
		for rig, entry in captured do
			if rig.Parent then
				pcall(function()
					if rig:GetScale() ~= entry.scale then
						tracksValue.setValue(entry.motor, entry.scale)
					end
				end)
			end
		end
		error(result[2], 0)
	end
	return table.unpack(result, 2, result.n)
end

function tracksValue.beginPose(rig, raw, time, loopEnd, propertySamples)
	if rig:IsA("Model") and rig.Parent ~= game then
		for _, motor in tracksValue.list(rig, true, true) do
			if motor.PropertyId == "Scale" and (motor.Part1:GetAttribute("Enabled") ~= false
				or validScale(motor.Part1:GetAttribute("EclipseScaleBasis"))) then
				tracksValue.setValue(motor, tracksValue.scaleBasis(motor))
			end
		end
	end
	for _, motor in tracksValue.list(rig) do
		if
			(rig:IsA("Model") and rig.Parent ~= game)
			and motor.PropertyId == "CFrame"
			and not raw
			and not tracksValue.inheritedTransform(rig)
		then
			tracksValue.setValue(motor, motor.DefaultValue)
		end
	end
	if raw and rig:IsA("Model") and not tracksValue.inheritedTransform(rig) then
		tracksValue.applyTransform(rig, raw, time, loopEnd, propertySamples)
		return true
	end
end

local function facialTarget(motor)
	if motor.Rig:IsA("FaceControls") and table.find(faceNames, motor.PropertyId) then
		return motor.Rig, motor.PropertyId
	end
	return faceProperty(motor.Rig, motor.PropertyId)
end

local function ownsFacialTrack(motor, raw, samples)
	local controls, name = facialTarget(motor)
	if not controls or not name then
		return true
	end

	local owners = samples and samples.facialOwners
	if not owners then
		owners = {}
		local state = require("state")
		for _, rig in state.getAllRigs and state.getAllRigs() or { motor.Rig } do
			for _, candidate in tracksValue.list(rig, false, true) do
				local target, property = facialTarget(candidate)
				if not target or not property then
					continue
				end
				local entries = owners[target]
				if not entries then
					entries = {}
					owners[target] = entries
				end
				local enabled = not candidate:GetAttribute("EclipseDisabled")
				local keyed = next(require("policy").activeBucket(raw.Keyframes[candidate]) or {}) ~= nil
				local rank = (enabled and 2 or 0) + (keyed and 1 or 0)
				local previous = entries[property]
				if not previous
					or rank > previous.rank
					or rank == previous.rank and rig:IsDescendantOf(previous.motor.Rig)
				then
					entries[property] = { motor = candidate, rank = rank }
				end
			end
		end
		if samples then
			samples.facialOwners = owners
		end
	end
	local entries = owners[controls]
	local entry = entries and entries[name]
	return not entry or entry.motor == motor
end

function tracksValue.apply(rig, raw, time, loopEnd, propertySamples, skipTransform)
	local target = require("target")
	local facialSamples = propertySamples or {}
	target.invalidatePropertySamples(propertySamples, rig)
	local list = tracksValue.list(rig)
	for _, motor in tracksValue.list(rig, true, true) do
		if motor.PropertyId == "Scale" and motor.Part1:GetAttribute("Enabled") == false
			and validScale(motor.Part1:GetAttribute("EclipseScaleBasis")) then
			table.insert(list, motor)
		end
	end
	local clockMotor, clockRank
	for _, motor in list do
		if isClock(rig, motor.PropertyId) then
			local keyed = false
			for _, key in raw.Keyframes[motor] or {} do
				if not key.Disabled then
					keyed = true
					break
				end
			end

			local rank = motor:GetAttribute("EclipseDisabled") and -1
				or (keyed and 4 or 0) + (motor.PropertyId == "ClockTime" and 1 or 0)
			if not clockRank or rank > clockRank then
				clockMotor, clockRank = motor, rank
			end
		end
	end

	for _, motor in list do
		if motor.PropertyId ~= "CFrame" then
			if not ownsFacialTrack(motor, raw, facialSamples) then
				continue
			end
			if isClock(rig, motor.PropertyId) and motor ~= clockMotor then
				continue
			end

			local value
			if motor:GetAttribute("EclipseDisabled") or motor.Part1:GetAttribute("Enabled") == false then
				value = motor.DefaultValue
			else
				value = tracksValue.evaluate(motor, raw.Keyframes[motor], time, loopEnd)
			end

			if
				aggregate(rig, motor.PropertyId)
				and (motor:GetAttribute("EclipseDisabled") or not next(raw.Keyframes[motor] or {}))
			then
				tracksValue.restoreValue(motor)
			else
				tracksValue.setValue(motor, value)
			end
		end
	end

	if not skipTransform then
		tracksValue.applyTransform(rig, raw, time, loopEnd, propertySamples)
	end

	target.invalidatePropertySamples(propertySamples, rig)
end

function tracksValue.applyTransform(rig, raw, time, loopEnd, propertySamples)
	for _, motor in tracksValue.list(rig) do
		if motor.PropertyId == "CFrame" then
			if tracksValue.inheritedTransform(rig) and not next(raw.Keyframes[motor] or {}) then
				continue
			end

			local value
			if motor:GetAttribute("EclipseDisabled") then
				value = motor.DefaultValue
			else
				local target = require("target")
				local bucket = raw.Keyframes[motor]
				if target.hasChild(bucket) then
					value = target.childWorld(time, bucket, function(key)
						return tracksValue.decode(motor, key.C0, key.PropertyValue)
					end, propertySamples)
				end

				value = value or tracksValue.evaluate(motor, bucket, time, loopEnd)
			end

			tracksValue.setValue(motor, value)
			if rig:IsA("Model") and not tracksValue.inheritedTransform(rig) then
				require("masterControl").rebase(rig)
			end
			require("target").watchProperty(motor, time)
		end
	end
end

function tracksValue.captureDefaults(rig)
	for _, motor in tracksValue.list(rig, true) do
		local face, name = faceProperty(rig, motor.PropertyId)
		if name and not face or motor.Definition.trigger then
			continue
		end
		local value = tracksValue.readValue(rig, motor.PropertyId)
		if aggregate(rig, motor.PropertyId) and motor.PropertyId ~= "Color" then
			value = 0
		end

		local node = motor.Part1
		node:SetAttribute("Default", document.pack(value))
		if aggregate(rig, motor.PropertyId) then
			node:SetAttribute("Members", document.pack(captures(rig, motor.PropertyId)))
		end

		node:SetAttribute("Current", nil)
		tracksValue.prepare(motor, value)
	end
end

function tracksValue.restoreDefaults(rig)
	for _, motor in tracksValue.list(rig, true) do
		if motor.PropertyId == "CFrame" and tracksValue.inheritedTransform(rig) then
			continue
		end

		tracksValue.prepare(motor, motor.DefaultValue)
		tracksValue.restoreValue(motor)
	end
end

function tracksValue.snapshot(rig, raw, withKeys)
	local rows = {}
	for _, motor in tracksValue.list(rig, true) do
		local keys = {}
		if withKeys then
			for frame, key in raw.Keyframes[motor] or {} do
				keys[frame] = document.unpack(document.pack(key))
			end
		end

		table.insert(rows, {
			id = motor.PropertyId,
			default = motor.DefaultValue,
			scaleBasis = motor.PropertyId == "Scale" and motor.Part1:GetAttribute("EclipseScaleBasis") or nil,
			members = motor.Part1:GetAttribute("Members") and document.unpack(
				motor.Part1:GetAttribute("Members")
			) or nil,
			enabled = motor.Part1:GetAttribute("Enabled") ~= false,
			disabled = motor:GetAttribute("EclipseDisabled") == true,
			keys = withKeys and keys or nil,
		})
	end

	return {
		version = 1,
		tracks = rows,
		inert = inertRows[rig],
		movementGrid = rig:GetAttribute("EclipseMovementGrid") == true and rig:GetAttribute(
			"EclipseGridSettings"
		) or nil,
		individualParts = rig:GetAttribute("EclipseIndividualParts"),
		partChoices = require("partRig").choice(rig),
		camera = camera.isRig(rig) and {
			CFrame = tracksValue.enabled(rig, "CFrame"),
			FieldOfView = tracksValue.enabled(rig, "FieldOfView"),
		} or nil,
	}
end

local function clockRow(row)
	local copy = table.clone(row)
	copy.default = assert(clockValue(copy.default), "Invalid saved time of day")
	if copy.keys then
		local keys = {}
		for frame, key in copy.keys do
			local entry = table.clone(key)
			local value = entry.PropertyValue ~= nil
					and assert(clockValue(entry.PropertyValue), "Invalid saved time key")
				or entry.C0.X
			entry.PropertyValue = value
			entry.C0 = tracksValue.encode(value)
			entry.Position = entry.C0.Position
			entry.Rotation = entry.C0.Rotation
			keys[frame] = entry
		end

		copy.keys = keys
	end

	return copy
end

local function usableRow(rig, row)
	if type(row) ~= "table" or type(row.id) ~= "string" then
		return nil
	end

	if isClock(rig, row.id) then
		row = clockRow(row)
	end

	local definition = tracksValue.definition(rig, row.id)
	if not definition or row.keys ~= nil and type(row.keys) ~= "table" then
		return nil
	end

	local probe =
		{ Rig = rig, PropertyId = row.id, Definition = definition, DefaultValue = row.default }
	if not tracksValue.validate(probe, row.default) then
		return nil
	end

	for _, key in row.keys or {} do
		if
			type(key) ~= "table"
			or not tracksValue.validate(probe, tracksValue.decode(probe, key.C0, key.PropertyValue))
		then
			return nil
		end
	end

	return row
end

function tracksValue.restore(rig, data, timeline, sanitize)
	local tracks = type(data) == "table"
			and data.version == 1
			and type(data.tracks) == "table"
			and data.tracks
		or {}
	data = type(data) == "table" and data or {}
	if data.movementGrid and rig:IsA("NumberValue") then
		rig:SetAttribute("EclipseMovementGrid", true)
		rig:SetAttribute("EclipseGridSettings", data.movementGrid)
	end
	rig:SetAttribute("EclipseIndividualParts", data.individualParts)
	require("partRig").restoreChoice(rig, data.partChoices)
	local raw = timeline:GetState()
	local wanted = {}
	if camera.isRig(rig) then
		for _, def in tracksValue.catalog(rig) do
			tracksValue.enable(rig, def.id, not data.camera or data.camera[def.id] ~= false, raw)
		end
	end

	local sources = table.clone(tracks)
	if type(data.inert) == "table" then
		for _, row in data.inert do
			table.insert(sources, row)
		end
	end

	local inert, restored = {}, {}
	for _, source in sources do
		local usable, row = pcall(usableRow, rig, source)
		if not usable or not row or restored[row.id] then
			table.insert(inert, source)
			continue
		end

		restored[row.id] = true
		local motor = tracksValue.enable(rig, row.id, row.enabled, raw)
		wanted[motor] = true
		if row.members and aggregate(rig, row.id) then
			motor.Part1:SetAttribute("Members", document.pack(row.members))
		end

		pcall(tracksValue.prepare, motor, row.default)
		motor.Part1:SetAttribute("Default", document.pack(row.default))
		motor.Part1:SetAttribute("EclipseScaleBasis", row.id == "Scale" and validScale(row.scaleBasis) and row.scaleBasis or nil)
		motor:SetAttribute("EclipseDisabled", row.disabled and true or nil)
		if not row.enabled then
			tracksValue.restoreValue(motor)
		end

		raw.DefaultPose[motor] = tracksValue.encode(row.default)
		if row.keys then
			for frame, key in row.keys do
				pcall(tracksValue.prepare, motor, tracksValue.decode(motor, key.C0, key.PropertyValue))
				key.Motor = motor
				key.Part = motor.Part1
				key.Frame = frame
				key.SanitizeName = sanitize
				key.Channels = nil
				key.GraphCurves = nil
			end

			timeline:_restoreMotorBucket(motor, row.keys)
		end
	end

	for _, motor in tracksValue.list(rig, true) do
		if
			not wanted[motor]
			and not motor.Definition.facial
			and not tracksValue.required(rig, motor.PropertyId)
		then
			tracksValue.restoreValue(motor)
			motor.Part1:SetAttribute("Enabled", false)
		end
	end

	inertRows[rig] = if #inert > 0 then inert else nil
	if #inert > 0 and not sameInert(data.inert, inert) then
		warn(
			"[Eclipse] "
				.. rig.Name
				.. ": kept "
				.. #inert
				.. " saved property track(s) this object can't use right now. They stay in the project and load again when the object supports them."
		)
	end
end

function tracksValue.write(sequence, rig, raw)
	local old = sequence:FindFirstChild("EclipseProperties")
	if old then
		old:Destroy()
	end

	local previous = sequence:FindFirstChild(unreadableValue)
	if previous and previous ~= unreadable[rig] then
		previous:Destroy()
	end

	if camera.isRig(rig) or inertRows[rig] or #tracksValue.list(rig, true) > 0 then
		chunks.write(sequence, "EclipseProperties", document.pack(tracksValue.snapshot(rig, raw, true)))
	end

	local kept = unreadable[rig]
	local copy = kept and kept:Clone()
	if copy then
		copy.Name = unreadableValue
		copy.Parent = sequence
	end
end

function tracksValue.placement(rig, row)
	if
		type(row) ~= "table"
		or row.id ~= "CFrame"
		or typeof(row.default) ~= "CFrame"
		or typeof(rig) ~= "Instance"
		or not rig:IsA("Model")
		or rig.Parent == game
		or camera.isRig(rig)
		or tracksValue.inheritedTransform(rig)
	then
		return nil
	end

	local home = require("rigPose").settledHome(rig)
	if typeof(home) ~= "CFrame" or home:FuzzyEq(row.default, 1e-4) then
		return nil
	end

	return { source = row.default, target = home }
end

function tracksValue.shiftKey(key, placement, timeline)
	if
		type(key) ~= "table"
		or placed[key]
		or key.CamTargetParent
		or key.Parented == false
		or typeof(key.C0) ~= "CFrame"
	then
		return
	end

	placed[key] = true
	if typeof(key.PropertyValue) == "CFrame" then
		key.PropertyValue = placement.target * placement.source:ToObjectSpace(key.PropertyValue)
	end

	require("poseSpace").rebaseKey(key, placement.source, placement.target, timeline, 1)
end

function tracksValue.shift(sequence)
	return shifts[sequence]
end

function tracksValue.forget()
	for _, hook in hooks do
		hook:Disconnect()
	end
	for _, folder in folders do
		folder:Destroy()
	end

	table.clear(hooks)
	table.clear(folders)
	table.clear(owners)
	table.clear(nodes)
	table.clear(inertRows)
	table.clear(unreadable)
	table.clear(shifts)
end

function tracksValue.read(sequence, rig, timeline, sanitize)
	faces[rig] = nil
	local folder = sequence:FindFirstChild("EclipseProperties")
	local kept = sequence:FindFirstChild(unreadableValue)
	unreadable[rig] = kept and kept:Clone() or nil
	local data = { version = 1, tracks = {} }
	if folder then
		local ok, decoded = pcall(function()
			return document.unpack(chunks.read(folder))
		end)
		if
			ok
			and type(decoded) == "table"
			and decoded.version == 1
			and type(decoded.tracks) == "table"
		then
			data = decoded
		else
			unreadable[rig] = folder:Clone() or unreadable[rig]
			warn(
				"[Eclipse] "
					.. rig.Name
					.. ": the saved property tracks could not be read. They are kept unchanged in the project; everything else is open."
			)
		end
	end

	local present = {}
	for _, row in data.tracks do
		if type(row) == "table" and type(row.id) == "string" then
			present[row.id] = true
		end
	end
	for _, row in type(data.inert) == "table" and data.inert or {} do
		if type(row) == "table" and type(row.id) == "string" then
			present[row.id] = true
		end
	end
	local facial = sequence:IsA("KeyframeSequence")
			and require("facialAnimation").read(sequence, rig, timeline:GetState().FPS)
		or {}
	for _, row in facial do
		if not present[row.id] then
			table.insert(data.tracks, row)
		end
	end

	local sourceScale = sequence:GetAttribute("EclipseAuthoredScale")
	if
		(rig:IsA("Model") and rig.Parent ~= game)
		and typeof(sourceScale) == "number"
		and sourceScale > 0
	then
		local poseRatio = rig:GetScale() / sourceScale
		do
			for _, row in data.tracks do
				if
					type(row) == "table"
					and row.id == "Scale"
					and typeof(row.default) == "number"
					and type(row.keys or {}) == "table"
				then
					local ratio = validScale(row.scaleBasis) and validScale(row.default)
						and rig:GetScale() / row.default or poseRatio
					if validScale(row.scaleBasis) then row.scaleBasis *= poseRatio end
					row.default *= ratio
					for _, key in row.keys or {} do
						if type(key) ~= "table" then
							continue
						end

						if typeof(key.PropertyValue) == "number" then
							key.PropertyValue *= ratio
						end

						if typeof(key.C0) == "CFrame" then
							key.C0 = CFrame.new(key.C0.Position * ratio) * key.C0.Rotation
							key.Position = key.C0.Position
						end
					end
				end
			end
		end
	end

	shifts[sequence] = nil
	for _, row in data.tracks do
		for _, key in type(row) == "table" and type(row.keys) == "table" and row.keys or {} do
			if type(key) == "table" then
				require("target").retargetKey(key, rig, sequence)
			end
		end
	end
	for _, row in data.tracks do
		local placement = tracksValue.placement(rig, row)
		if placement then
			for _, key in type(row.keys) == "table" and row.keys or {} do
				tracksValue.shiftKey(key, placement, timeline)
			end

			row.default = placement.target
			shifts[sequence] = placement
			break
		end
	end

	require("rigPose").unsettleHome(rig)
	tracksValue.restore(rig, data, timeline, sanitize)
end

return tracksValue
