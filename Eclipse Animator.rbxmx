				else

					projection.cf, projection.fov, projection.focus =

						cameraModule.renderFrame(selectedCamera, nil, true, shakeTime)

					projection.view, projection.authoredFov =

						cameraModule.viewFrame(selectedCamera, nil, shakeTime), cameraModule.fov(selectedCamera)

				end

