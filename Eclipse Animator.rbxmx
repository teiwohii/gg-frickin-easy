							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = require(script.Parent.ShapeKit)

local sphereBeam = {}

sphereBeam.id = "SphereBeam"
sphereBeam.title = "Sphere Beam"
sphereBeam.root = "Part"
sphereBeam.minimumSides = 3
sphereBeam.maximumSides = 48
sphereBeam.minimumRings = 2
sphereBeam.maximumRings = 16

sphereBeam.params = ShapeKit.join({
	{ name = "Radius", kind = "number", default = 5, min = 0.1, max = 500, tip = "Size of the ball." },
	{ name = "Sides", kind = "number", default = 12, min = 3, max = 48, integer = true, tip = "How many beams go around the ball, like the segments of an orange." },
	{ name = "Rings", kind = "number", default = 6, min = 2, max = 16, integer = true, tip = "How many pieces each beam is split into from top to bottom. More rings make it rounder." },
	{ name = "Fill", label = "Wall Fill", kind = "number", default = 1, min = 0.05, max = 1.5, tip = "1 closes the surface. Lower values leave gaps between the beams." },
}, ShapeKit.beamParams())

function sphereBeam.build(kit, params)
	local radius = math.max(tonumber(params.Radius) or 5, 0.01)
	local sides = math.clamp(math.round(tonumber(params.Sides) or 12), sphereBeam.minimumSides, sphereBeam.maximumSides)
	local rings = math.clamp(math.round(tonumber(params.Rings) or 6), sphereBeam.minimumRings, sphereBeam.maximumRings)
	local fill = math.clamp(tonumber(params.Fill) or 1, 0.05, 1.5)
	local step = math.pi / rings
	local handle = 4 / 3 * math.tan(step / 4) * radius
	local properties = kit:getBeamProperties()
	local base = math.clamp(tonumber(params.Transparency) or 0, 0, 1)

	for side = 1, sides do
		local longitude = (side - 1) / sides * math.pi * 2
		local east = Vector3.new(-math.sin(longitude), 0, math.cos(longitude))
		local previous = nil

		for ring = 0, rings do
			local latitude = -math.pi / 2 + ring * step
			local outward = Vector3.new(math.cos(latitude) * math.cos(longitude), math.sin(latitude), math.cos(latitude) * math.sin(longitude))
			local north = Vector3.new(-math.sin(latitude) * math.cos(longitude), math.cos(latitude), -math.sin(latitude) * math.sin(longitude))
			local point = kit:attachment("Point" .. side .. "_" .. ring, kit:orient(outward * radius, north, east))
			local width = 2 * math.pi * radius * math.cos(latitude) / sides * fill

			if previous then
				local beam = Instance.new("Beam")

				beam.Name = "Beam" .. side .. "_" .. ring

				for name, value in properties do
					(beam :: any)[name] = value
				end

				beam.Transparency = NumberSequence.new(base)
				beam.Width0 = math.max(previous.width, 0)
				beam.Width1 = math.max(width, 0)
				beam.CurveSize0 = handle
				beam.CurveSize1 = handle
				beam.Attachment0 = previous.point
				beam.Attachment1 = point
				beam.Parent = kit.root
				kit.count += 1
			end

			previous = { point = point, width = width }
		end
	end
end

return sphereBeam
]]></ProtectedString>
