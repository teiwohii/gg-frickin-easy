								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local create = {}

create.toolbar = {
	name = "Create",
	tooltip = "VFX Create",
	icon = "rbxassetid://91028573074162",
}

create.defaultAssetName = "VFX"
create.generatorAttribute = "ArcGenerator"
create.hiddenAttribute = "ArcHidden"
create.holderName = "Emitter"
create.holderSize = Vector3.new(1, 1, 1)
create.rowHeight = 20
create.rowIndent = 12
create.doubleClickTime = 0.35
create.collapseThreshold = 12
create.maxWatched = 40
create.maxSequencePoints = 20
create.spawnDistance = 18
create.regenerateInterval = 0.06
create.selectionTransparency = 0.6
create.hoverTransparency = 0.85
create.stripeTransparency = 0.82
create.hiddenIconColor = Color3.fromRGB(120, 120, 120)
create.visibleIconColor = Color3.fromRGB(255, 255, 255)
create.mixedText = "mixed"
create.noneText = "None"
create.pickText = "Click a target..."

create.increments = {
	position = 0.1,
	rotation = 5,
	scale = 0.1,
}

create.scales = { 0.85, 1, 1.15, 1.3, 1.5 }

create.settings = {
	scale = 1,
	snap = true,
	positionIncrement = 0.1,
	rotationIncrement = 5,
	scaleIncrement = 0.1,
	repeatInterval = 1.5,
	autoInspect = true,
}

create.settingKey = "ArcCreateSettings"
create.libraryKey = "ArcCreateLibrary"
create.textureKey = "ArcCreateTextures"

create.Icons = require(script.icons)
create.Schema = require(script.schema)
create.Sequences = require(script.sequences)
create.Blocks = require(script.blocks)
create.Palette = require(script.palette)
create.Textures = require(script.textures)
create.TextureExtras = { require(script.openTextures) }
create.MeshFlipbooks = require(script.meshFlipbooks)

return create
]]></ProtectedString>
