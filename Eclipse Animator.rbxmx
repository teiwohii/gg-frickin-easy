						<ProtectedString name="Source"><![CDATA[-- riftkuro

local launcherValue = {}

function launcherValue.start(plugin, eclipseScript)
	local assets = eclipseScript:FindFirstChild("Eclipse")
	local axes = assets and assets:FindFirstChild("Axis")
	if axes then
		for _, object in axes:GetDescendants() do
			if object:IsA("HandleAdornment") then
				object.Visible = false
			end
		end
	end
	if game:GetService("RunService"):IsRunning() then
		return
	end

	if typeof(plugin) ~= "Instance" or not plugin:IsA("Plugin") then
		return
	end

	local edition = eclipseScript.Name:lower():find("experimental", 1, true) and "Experimental"
		or "Animator"
	local toolbar = plugin:CreateToolbar("Eclipse " .. edition)
	local launcher = { toolbar = toolbar, buttons = {}, handlers = {}, ready = false }
	launcher.buttons[1] = toolbar:CreateButton(
		"Eclipse " .. edition,
		"Open Eclipse " .. edition,
		"rbxassetid://126656292244944"
	)
	launcher.buttons[2] = toolbar:CreateButton(
		"Rig Tools",
		"Open " .. edition .. " Rig Tools",
		"rbxassetid://93890335549588"
	)
	local connections = {}
	local failureGui
	local stopped = false

	local function showFailure()
		warn("[Eclipse startup] " .. tostring(launcher.problem))
		if failureGui and failureGui.Parent then
			failureGui.Enabled = true
			return
		end

		failureGui = Instance.new("ScreenGui")
		failureGui.Name = "EclipseStartupError"
		failureGui.DisplayOrder = 1000

		local panel = Instance.new("TextButton")
		panel.AnchorPoint = Vector2.new(0.5, 0.5)
		panel.Position = UDim2.fromScale(0.5, 0.5)
		panel.Size = UDim2.fromOffset(460, 130)
		panel.BackgroundColor3 = Color3.fromRGB(30, 25, 42)
		panel.TextColor3 = Color3.fromRGB(238, 230, 246)
		panel.Font = Enum.Font.Code
		panel.TextSize = 15
		panel.TextWrapped = true
		panel.Text = "Eclipse could not finish starting.\n\n"
			.. "See the Eclipse startup error in Studio Output.\n"
			.. "Update or re-enable the plugin, then try again.\n\nClick to close."
		panel.Parent = failureGui
		table.insert(
			connections,
			panel.Activated:Connect(function()
				failureGui.Enabled = false
			end)
		)
		failureGui.Parent = game:GetService("CoreGui")
	end

	local function initialize()
		if stopped then
			return
		end

		local boot
		local ok, issue = xpcall(function()
			boot = require(eclipseScript.container.requireModule)("boot")
			boot.start(plugin, eclipseScript, launcher)
		end, debug.traceback)
		launcher.starting = false

		if stopped then
			if boot and boot.shutdown then
				pcall(boot.shutdown)
			end
			return
		end

		if not ok then
			launcher.problem = tostring(issue)
			showFailure()
			return
		end

		launcher.ready = true
		local open = launcher.pending and launcher.handlers[launcher.pending]
		launcher.pending = nil
		if open then
			open(true)
		end
	end

	for index, button in launcher.buttons do
		button.ClickableWhenViewportHidden = true
		table.insert(
			connections,
			button.Click:Connect(function()
				if launcher.problem then
					showFailure()
				elseif not launcher.ready then
					launcher.pending = index
					if not launcher.starting then
						launcher.starting = true
						task.defer(initialize)
					end
				else
					local handler = launcher.handlers[index]
					if handler then handler() end
				end
			end)
		)
	end

	local function cleanupLauncher()
		if stopped then
			return
		end
		stopped = true
		for _, connection in connections do
			connection:Disconnect()
		end
		if failureGui then
			failureGui:Destroy()
		end
		pcall(toolbar.Destroy, toolbar)
	end

	table.insert(connections, plugin.Unloading:Connect(cleanupLauncher))
	table.insert(connections, eclipseScript.Destroying:Connect(cleanupLauncher))

	launcher.starting = true
	task.defer(initialize)

end

return launcherValue
]]></ProtectedString>
