							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)

local Menu = {}
Menu.__index = Menu

Menu.itemHeight = 20
Menu.separatorHeight = 7
Menu.gap = 1
Menu.padding = 4
Menu.searchHeight = 24
Menu.minimumWidth = 150
Menu.maximumHeight = 252
Menu.offset = 2
Menu.searchThreshold = 10
Menu.disabledTransparency = 0.55

function Menu.new(frame: Frame, root: GuiObject, templates: Instance, icons)
	local self = setmetatable({}, Menu)

	self.frame = frame
	self.root = root
	self.list = frame.List
	self.search = frame.Search
	self.itemTemplate = templates.MenuItem
	self.separatorTemplate = templates.MenuSeparator
	self.icons = icons
	self.items = {}
	self.rows = {}
	self.rowConnections = {}
	self.connections = {}
	self.anchor = nil
	self.owner = nil
	self.closedHandler = nil

	self:bind()

	return self
end

function Menu:bind()
	table.insert(self.connections, userInputService.InputBegan:Connect(function(input)
		if not self:isOpen() then
			return
		end

		if input.KeyCode == Enum.KeyCode.Escape then
			self:close()
			return
		end

		local kind = input.UserInputType

		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.MouseButton2 then
			return
		end

		local point = Vector2.new(input.Position.X, input.Position.Y)

		if self:contains(self.frame, point) or (self.anchor and self:contains(self.anchor, point)) then
			return
		end

		self:close()
	end))

	table.insert(self.connections, self.search:GetPropertyChangedSignal("Text"):Connect(function()
		if self:isOpen() then
			self:applyFilter()
		end
	end))
end

function Menu:contains(guiObject: GuiObject, point: Vector2): boolean
	local position = guiObject.AbsolutePosition
	local size = guiObject.AbsoluteSize

	return point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y
end

function Menu:isOpen(): boolean
	return self.frame.Visible
end

function Menu:getOwner()
	return self.owner
end

function Menu:getFrame(): Frame
	return self.frame
end

function Menu:getScale(): number
	local scale = self.root:FindFirstChildOfClass("UIScale")

	return if scale and scale.Scale > 0 then scale.Scale else 1
end

function Menu:clearRows()
	for _, connection in self.rowConnections do
		connection:Disconnect()
	end

	table.clear(self.rowConnections)

	for _, row in self.rows do
		row.instance:Destroy()
	end

	table.clear(self.rows)
end

function Menu:createRow(item, order: number)
	if item.separator then
		local separator = self.separatorTemplate:Clone()

		separator.LayoutOrder = order
		separator.Parent = self.list
		table.insert(self.rows, { instance = separator, item = item, height = Menu.separatorHeight })

		return
	end

	local colors = configuration.Colors
	local row = self.itemTemplate:Clone()

	row.LayoutOrder = order
	row.Label.Text = item.text
	row.Check.Visible = item.checked == true

	if item.color then
		row.Icon.Image = ""
		row.Icon.BackgroundColor3 = item.color
		row.Icon.BackgroundTransparency = 0
	elseif item.image then
		row.Icon.Image = item.image
		row.Icon.ImageRectOffset = Vector2.zero
		row.Icon.ImageRectSize = Vector2.zero
	elseif item.icon then
		self.icons:apply(row.Icon, item.icon)
	else
		row.Icon.Visible = false
		row.Label.Position = UDim2.fromOffset(8, 0)
		row.Label.Size = UDim2.new(1, -28, 1, 0)
	end

	if item.disabled then
		row.Label.TextTransparency = Menu.disabledTransparency
	else
		table.insert(self.rowConnections, row.MouseEnter:Connect(function()
			row:SetAttribute("ThemeBg", "MenuSel")
			row.BackgroundColor3 = colors.Light
			row.BackgroundTransparency = configuration.Create.selectionTransparency
		end))

		table.insert(self.rowConnections, row.MouseLeave:Connect(function()
			row.BackgroundTransparency = 1
		end))

		table.insert(self.rowConnections, row.Activated:Connect(function()
			local callback = item.callback

			if not item.keepOpen then
				self:close()
			end

			if callback then
				callback(item)
			end
		end))
	end

	row.Parent = self.list
	table.insert(self.rows, { instance = row, item = item, height = Menu.itemHeight })
end

function Menu:applyFilter()
	local filter = string.lower(self.search.Text)

	for _, row in self.rows do
		if row.item.separator then
			row.instance.Visible = filter == ""
		else
			row.instance.Visible = filter == "" or string.find(string.lower(row.item.text), filter, 1, true) ~= nil
		end
	end
end

function Menu:getContentHeight(): number
	local height = 0

	for index, row in self.rows do
		height += row.height + (if index > 1 then Menu.gap else 0)
	end

	return height
end

function Menu:place(options, width: number, height: number)
	local anchor = options.anchor
	local scale = self:getScale()
	local rootPosition = self.root.AbsolutePosition
	local gui = self.root:FindFirstAncestorWhichIsA("LayerCollector")
	local screen = if gui then gui.AbsoluteSize else workspace.CurrentCamera.ViewportSize
	local position = options.position
	local anchorHeight = 0

	if anchor then
		position = anchor.AbsolutePosition
		anchorHeight = anchor.AbsoluteSize.Y
	end

	position = position or rootPosition

	local x = position.X
	local y = position.Y + anchorHeight + Menu.offset * scale

	if y + height * scale > screen.Y - 4 then
		y = math.max(4, position.Y - height * scale - Menu.offset * scale)
	end

	if x + width * scale > screen.X - 4 then
		x = math.max(4, screen.X - 4 - width * scale)
	end

	self.frame.Position = UDim2.fromOffset((x - rootPosition.X) / scale, (y - rootPosition.Y) / scale)
	self.frame.Size = UDim2.fromOffset(width, height)
end

function Menu:open(options)
	self:close()

	self.anchor = options.anchor
	self.owner = options.owner
	self.closedHandler = options.onClosed

	for index, item in options.items do
		self:createRow(item, index)
	end

	local searchable = options.search == true or (options.search == nil and #options.items > Menu.searchThreshold)
	local top = Menu.padding + (if searchable then Menu.searchHeight else 0)
	local scale = self:getScale()
	local anchorWidth = if options.anchor then options.anchor.AbsoluteSize.X / scale else 0
	local width = math.max(options.width or 0, anchorWidth, Menu.minimumWidth)
	local height = math.min(self:getContentHeight(), options.maximumHeight or Menu.maximumHeight) + top + Menu.padding

	self.search.Visible = searchable
	self.search.Text = ""
	self.list.Position = UDim2.fromOffset(Menu.padding, top)
	self.list.Size = UDim2.new(1, -Menu.padding * 2, 1, -top - Menu.padding)
	self.list.CanvasPosition = Vector2.zero

	self:place(options, width, height)
	self.frame.Visible = true

	if searchable then
		self.search:CaptureFocus()
	end
end

function Menu:close()
	if not self.frame.Visible and #self.rows == 0 then
		return
	end

	self.frame.Visible = false
	self.search:ReleaseFocus(false)
	self:clearRows()
	self.anchor = nil
	self.owner = nil

	local handler = self.closedHandler

	self.closedHandler = nil

	if handler then
		handler()
	end
end

function Menu:toggle(options)
	if self:isOpen() and self.anchor == options.anchor then
		self:close()
		return
	end

	self:open(options)
end

function Menu:destroy()
	self:close()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
end

return Menu
]]></ProtectedString>
