							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local configuration = require(script.Parent.Parent.Utility.configuration)

local Settings = {}
Settings.__index = Settings

function Settings.new(pluginObject: Plugin?)
	local self = setmetatable({}, Settings)

	self.plugin = pluginObject
	self.values = table.clone(configuration.Create.settings)
	self.handlers = {}

	self:load()

	return self
end

function Settings:load()
	if not self.plugin then
		return
	end

	local success, stored = pcall(function()
		return self.plugin:GetSetting(configuration.Create.settingKey)
	end)

	if not success or typeof(stored) ~= "table" then
		return
	end

	for name, default in configuration.Create.settings do
		local value = stored[name]

		if typeof(value) == typeof(default) then
			self.values[name] = value
		end
	end
end

function Settings:save()
	if not self.plugin then
		return
	end

	pcall(function()
		self.plugin:SetSetting(configuration.Create.settingKey, self.values)
	end)
end

function Settings:get(name: string)
	return self.values[name]
end

function Settings:set(name: string, value)
	local default = configuration.Create.settings[name]

	if default == nil or typeof(value) ~= typeof(default) or self.values[name] == value then
		return
	end

	self.values[name] = value
	self:save()

	for _, handler in self.handlers do
		handler(name, value)
	end
end

function Settings:addChangedHandler(handler: (string, any) -> ())
	table.insert(self.handlers, handler)
end

function Settings:getIncrement(kind: string): number?
	if not self.values.snap then
		return nil
	end

	local step = self.values[kind .. "Increment"]

	return if typeof(step) == "number" and step > 0 then step else nil
end

function Settings:destroy()
	table.clear(self.handlers)
end

return Settings
]]></ProtectedString>
