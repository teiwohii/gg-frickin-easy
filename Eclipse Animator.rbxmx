							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local sequenceTools = require(script.Parent.sequenceTools)

local colorOps = {}

colorOps.properties = {
	{ className = "BasePart", names = { "Color" } },
	{ className = "ParticleEmitter", names = { "Color" } },
	{ className = "Beam", names = { "Color" } },
	{ className = "Trail", names = { "Color" } },
	{ className = "Light", names = { "Color" } },
	{ className = "Highlight", names = { "FillColor", "OutlineColor" } },
	{ className = "Fire", names = { "Color", "SecondaryColor" } },
	{ className = "Smoke", names = { "Color" } },
	{ className = "Sparkles", names = { "SparkleColor" } },
	{ className = "Decal", names = { "Color3" } },
	{ className = "ImageLabel", names = { "ImageColor3" } },
}

colorOps.whiteThreshold = 0.05

function colorOps.getNames(instance: Instance): { string }?
	for _, entry in colorOps.properties do
		if instance:IsA(entry.className) then
			return entry.names
		end
	end

	return nil
end

function colorOps.isHolder(instance: Instance): boolean
	return instance:IsA("BasePart") and instance.Transparency >= 1
end

function colorOps.apply(instance: Instance, transform: (Color3) -> Color3): boolean
	local names = colorOps.getNames(instance)

	if not names or colorOps.isHolder(instance) then
		return false
	end

	local target = instance :: any

	for _, name in names do
		local value = target[name]

		if typeof(value) == "Color3" then
			target[name] = transform(value)
		elseif typeof(value) == "ColorSequence" then
			target[name] = sequenceTools.mapColors(value, transform)
		end
	end

	return true
end

function colorOps.visit(instance: Instance, visitor: (Color3) -> ())
	local names = colorOps.getNames(instance)

	if not names or colorOps.isHolder(instance) then
		return
	end

	local target = instance :: any

	for _, name in names do
		local value = target[name]

		if typeof(value) == "Color3" then
			visitor(value)
		elseif typeof(value) == "ColorSequence" then
			for _, keypoint in value.Keypoints do
				visitor(keypoint.Value)
			end
		end
	end
end

function colorOps.getDistance(a: Color3, b: Color3): number
	local red = a.R - b.R
	local green = a.G - b.G
	local blue = a.B - b.B

	return math.sqrt((red * red + green * green + blue * blue) / 3)
end

function colorOps.shift(color: Color3, hue: number, value: number): Color3
	local h, s, v = color:ToHSV()

	return Color3.fromHSV((h + hue) % 1, s, math.clamp(v + value, 0, 1))
end

function colorOps.tint(color: Color3, target: Color3, colorWhites: boolean): Color3
	local _, s, v = color:ToHSV()
	local targetHue, targetSaturation = target:ToHSV()

	if s <= colorOps.whiteThreshold and not colorWhites then
		return color
	end

	return Color3.fromHSV(targetHue, if colorWhites then math.max(s, targetSaturation) else s, v)
end

return colorOps
]]></ProtectedString>
							<string name="ScriptGuid">{39D1BFCF-A084-4DB4-A8B4-ECEE8CCF2DBD}</string>
