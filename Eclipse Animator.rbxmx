						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local tracks = require("properties")
local tool = require("tool")
local theme = require("theme")
local history = require("history")
local batch = {}
local window

function batch.add(refs, rigs, ids)
	assert(refs and refs.Active() and not require("blenderEdit").blocked(), "Finish the current edit first")
	local available = refs.State.getAllRigs()
	local unique, targets = {}, {}
	for _, rig in rigs do
		assert(rig.Parent and table.find(available, rig), "An item is no longer in the animation")
		if not unique[rig] then
			unique[rig] = true
			local missing = {}
			for id, selected in ids do
				if selected then
					local def = tracks.definition(rig, id)
					assert(def and not def.hidden, "An item does not support " .. id)
					if not tracks.enabled(rig, id) then
						table.insert(missing, id)
					end
				end
			end
			if #missing > 0 then
				table.insert(targets, { rig = rig, ids = missing })
			end
		end
	end
	if #targets == 0 then
		return 0
	end
	refs.Finalize()
	local timeline = refs.State.Timeline
	local raw = timeline:GetState()
	local before, after = {}, {}
	for _, target in targets do
		before[target.rig] = tracks.snapshot(target.rig, raw, true)
	end
	local function refresh()
		refs.RefreshStructure()
		for _, target in targets do
			if target.rig.Parent then
				timeline:ApplyPoseAtTime(target.rig, raw.CurrentTime, { OnlyRig = true })
			end
		end
		refs.State.currentProjectSaved = false
	end
	local function apply(data)
		for rig, snapshot in data do
			tracks.restore(rig, snapshot, timeline, refs.State.UIHelpers.SanitizeName)
		end
		refresh()
	end
	local count = 0
	local ok, err = pcall(function()
		for _, target in targets do
			for _, id in target.ids do
				tracks.enable(target.rig, id, true, raw)
				count += 1
			end
			after[target.rig] = tracks.snapshot(target.rig, raw, true)
		end
	end)
	if not ok then
		local saved = refs.State.currentProjectSaved
		apply(before)
		refs.State.currentProjectSaved = saved
		error(err, 0)
	end
	refresh()
	history.record(function() apply(before) end, function() apply(after) end, "Add properties to " .. #targets .. " items")
	return count
end

function batch.close()
	if window then
		local old = window
		window = nil
		old:close()
	end
end

function batch.open(refs, preferred)
	if not refs or not refs.Active() then return end
	batch.close()
	local rigs = table.clone(refs.State.getAllRigs())
	if #rigs == 0 then
		require("notification").show("ADD PROPERTIES", "Add items to the timeline first")
		return
	end
	local selected, ids, catalogs = {}, {}, {}
	local function choose(object)
		if typeof(object) ~= "Instance" then return end
		local owner = tracks.owner(object)
		if owner and table.find(rigs, owner) then selected[owner] = true; return end
		local cursor = object
		while cursor do
			if table.find(rigs, cursor) then selected[cursor] = true; return end
			cursor = cursor.Parent
		end
	end
	if preferred then
		choose(preferred)
	else
		for _, object in game:GetService("Selection"):Get() do choose(object) end
		if not next(selected) and refs.State.Rig then
			for item in refs.State.Rig._selectedItems or {} do
				choose(item.linkedRigInstance)
				choose((item.grandpa or item).linkedRigInstance)
			end
		end
		if not next(selected) then choose(refs.State.currentRig) end
	end
	for _, rig in rigs do
		local definitions = {}
		for _, def in tracks.catalog(rig) do
			if not def.hidden then definitions[def.id] = def end
		end
		catalogs[rig] = definitions
	end
	local session
	session = tool.new(refs, "EclipseAddProperties", "ADD PROPERTIES", Vector2.new(580, 430), false,
		function() if window == session then window = nil end end,
		{ FitToViewport = true, Resizable = true, MinimumSize = Vector2.new(440, 300) })
	window = session
	local frame = session.frame
	tool.label(frame, "ItemsTitle", "ITEMS", UDim2.fromOffset(12, 36), UDim2.new(0.42, -18, 0, 20))
	tool.label(frame, "PropertiesTitle", "PROPERTIES", UDim2.new(0.42, 6, 0, 36), UDim2.new(0.58, -18, 0, 20))
	local search = tool.field(frame, "Search", "", UDim2.new(0.42, 6, 0, 62), UDim2.new(0.58, -18, 0, 26))
	search.PlaceholderText = "Search properties"
	local function list(name, position, size)
		local value = tool.make("ScrollingFrame", frame, name, {
			Position = position, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = 4,
		})
		tool.make("UIListLayout", value, "Layout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder })
		return value
	end
	local items = list("Items", UDim2.fromOffset(12, 96), UDim2.new(0.42, -18, 1, -160))
	local properties = list("Properties", UDim2.new(0.42, 6, 0, 96), UDim2.new(0.58, -18, 1, -160))
	local status = tool.label(frame, "Status", "", UDim2.new(0, 12, 1, -58), UDim2.new(1, -24, 0, 18))
	status.TextSize = 10
	local propertyRows, itemRows = {}, {}
	local refresh
	local function row(parent, name, title, checked, callback)
		local button, label = tool.button(parent, name, title, UDim2.new(), UDim2.new(1, -6, 0, 27), callback)
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Position = UDim2.fromOffset(25, 0)
		label.Size = UDim2.new(1, -30, 1, 0)
		label.TextWrapped = false
		label.TextTruncate = Enum.TextTruncate.AtEnd
		local mark = tool.label(button, "Check", checked and "X" or "-", UDim2.fromOffset(5, 0), UDim2.fromOffset(18, 27))
		return { button = button, mark = mark, label = label }
	end
	local addButton, addLabel
	local function update()
		local count, wanted, additions = 0, 0, 0
		for _, rig in rigs do
			if selected[rig] then count += 1 end
			itemRows[rig].mark.Text = selected[rig] and "X" or "-"
		end
		local query = search.Text:lower()
		for id, entry in propertyRows do
			entry.mark.Text = ids[id] and "X" or "-"
			entry.button.Visible = query == "" or entry.label.Text:lower():find(query, 1, true) ~= nil or id:lower():find(query, 1, true) ~= nil
			if ids[id] then
				wanted += 1
				for _, rig in rigs do
					if selected[rig] and not tracks.enabled(rig, id) then additions += 1 end
				end
			end
		end
		status.Text = count .. " items . " .. wanted .. " properties selected . " .. additions .. " new tracks"
		addLabel.Text = additions > 0 and "ADD SELECTED PROPERTIES" or "SELECT ITEMS AND PROPERTIES"
		addLabel.TextTransparency = additions > 0 and 0 or 0.5
		addButton.Active = additions > 0
	end
	refresh = function()
		for _, entry in propertyRows do entry.button:Destroy() end
		table.clear(propertyRows)
		local common, count = {}, 0
		for _, rig in rigs do
			if selected[rig] then
				count += 1
				if count == 1 then
					common = table.clone(catalogs[rig])
				else
					for id in common do if not catalogs[rig][id] then common[id] = nil end end
				end
			end
		end
		for id in ids do if not common[id] then ids[id] = nil end end
		local sorted = {}
		for _, def in common do table.insert(sorted, def) end
		table.sort(sorted, function(a, b) return a.label:lower() < b.label:lower() end)
		for index, def in sorted do
			local entry = row(properties, def.id, def.label, ids[def.id], function()
				ids[def.id] = not ids[def.id]
				update()
			end)
			entry.button.LayoutOrder = index
			propertyRows[def.id] = entry
		end
		update()
		if #sorted == 0 then status.Text = count == 0 and "Select one or more items" or "These items have no properties in common" end
		theme.applyTree(properties)
	end
	for index, rig in rigs do
		itemRows[rig] = row(items, "Item" .. index, rig.Name, selected[rig], function()
			selected[rig] = not selected[rig]
			refresh()
		end)
		itemRows[rig].button.LayoutOrder = index
	end
	tool.button(frame, "AllItems", "ALL", UDim2.fromOffset(12, 62), UDim2.new(0.21, -12, 0, 26), function()
		for _, rig in rigs do selected[rig] = true end
		refresh()
	end)
	tool.button(frame, "NoItems", "NONE", UDim2.new(0.21, 3, 0, 62), UDim2.new(0.21, -9, 0, 26), function()
		table.clear(selected)
		refresh()
	end)
	addButton, addLabel = tool.button(frame, "Add", "", UDim2.new(0, 12, 1, -34), UDim2.new(1, -24, 0, 26), function()
		local targets = {}
		for _, rig in rigs do if selected[rig] then table.insert(targets, rig) end end
		local ok, result = pcall(batch.add, refs, targets, ids)
		if ok then
			update()
			status.Text = "Added " .. result .. " property tracks"
		else
			require("notification").show("ADD PROPERTIES", tostring(result):gsub("^.-:%d+: ", ""))
		end
	end)
	search:GetPropertyChangedSignal("Text"):Connect(update)
	refresh()
	theme.applyTree(frame)
end

return batch
]]></ProtectedString>
