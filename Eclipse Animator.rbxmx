						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local studioAudio = require("studioAudio")
local assetService = game:GetService("AssetService")
local timing = require("soundTiming")
local audio = {}
local playing

function audio.stop(owner)
	if owner and (not playing or playing.owner ~= owner) then
		return
	end

	local previous = playing
	playing = nil
	if previous then
		if previous.connection then
			previous.connection:Disconnect()
		end
		previous.sound:Stop()
		previous.sound:Destroy()
		if previous.changed then
			previous.changed(false)
		end
	end
end

function audio.toggle(id, changed, options, owner)
	if playing and playing.id == id and playing.owner == owner then
		audio.stop()
		return
	end

	audio.stop()
	local parent = studioAudio.parent()
	if not parent then
		return
	end

	local sound = Instance.new("Sound")

	sound.Name = "EclipseLibraryPreview"
	sound.SoundId = id
	sound.Volume = options and options.Volume or 0.5
	sound.PlaybackSpeed = options and options.Speed or 1
	sound.Looped = options and options.Looped == true or false
	sound.Archivable = false
	local session = { sound = sound, id = id, changed = changed, owner = owner }
	playing = session
	sound.Parent = parent
	sound.Ended:Once(function()
		if playing == session then
			audio.stop()
		end
	end)
	if changed then
		changed(true)
	end

	if not studioAudio.preload({ sound }, function()
		return playing == session
	end) then
		if playing == session then
			audio.stop()
		end

		return
	end

	local data = options or { Volume = 0.5, Speed = 1 }
	local offset, gain = timing.sample(data, 0, sound.TimeLength)
	if offset == nil then
		audio.stop(owner)
		return
	end
	sound.TimePosition = offset
	sound.Volume = (data.Volume or 0.5) * gain
	local elapsed = 0
	session.connection = game:GetService("RunService").Heartbeat:Connect(function(dt)
		if playing ~= session then
			return
		end
		elapsed += dt
		local position, volume = timing.sample(data, elapsed, sound.TimeLength)
		if position == nil then
			audio.stop(owner)
			return
		end
		sound.Volume = (data.Volume or 0.5) * volume
		if math.abs(sound.TimePosition - position) > 0.12 then
			sound.TimePosition = position
		end
	end)
	sound.Playing = true
end

function audio.metadata(id)
	local ok, rows = pcall(assetService.GetAudioMetadataAsync, assetService, { id })
	local row = ok and rows and rows[1]
	return { duration = row and (tonumber(row.Duration) or tonumber(row.TimeLength)) or 0 }
end

function audio.upload()
	return nil, nil, { url = "https://create.roblox.com/dashboard/creations?activeTab=Audio" }
end

return audio
]]></ProtectedString>
