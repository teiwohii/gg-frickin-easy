					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!native
-- riftkuro
local require = require(script:FindFirstAncestor("container").requireModule)
local assetService = game:GetService("AssetService")
local geometry = {}

local fields = {
	BasePart = {
		"CFrame",
		"Size",
		"Color",
		"Transparency",
		"Reflectance",
		"Material",
		"MaterialVariant",
		"LocalTransparencyModifier",
	},
	MeshPart = { "TextureID", "DoubleSided" },
	Bone = { "CFrame", "Transform" },
	Attachment = { "CFrame" },
	DataModelMesh = { "Scale", "Offset", "VertexColor" },
	SpecialMesh = { "MeshId", "TextureId", "MeshType" },
	Decal = { "Texture", "Color3", "Transparency", "LocalTransparencyModifier", "Face" },
	Texture = { "StudsPerTileU", "StudsPerTileV", "OffsetStudsU", "OffsetStudsV" },
	SurfaceAppearance = {
		"Color",
		"ColorMap",
		"MetalnessMap",
		"NormalMap",
		"RoughnessMap",
		"AlphaMode",
	},
	Shirt = { "ShirtTemplate", "Color3" },
	Pants = { "PantsTemplate", "Color3" },
	ShirtGraphic = { "Graphic", "Color3" },
	BodyColors = {
		"HeadColor3",
		"TorsoColor3",
		"LeftArmColor3",
		"RightArmColor3",
		"LeftLegColor3",
		"RightLegColor3",
	},
	CharacterMesh = { "MeshId", "BaseTextureId", "OverlayTextureId", "BodyPart" },
}

local function allowed(object)
	return object:IsA("Model")
		or object:IsA("Accessory")
		or object:IsA("Folder")
		or object:IsA("BasePart")
		or object:IsA("Attachment")
		or object:IsA("DataModelMesh")
		or object:IsA("Decal")
		or object:IsA("SurfaceAppearance")
		or object:IsA("Clothing")
		or object:IsA("ShirtGraphic")
		or object:IsA("BodyColors")
		or object:IsA("CharacterMesh")
		or object:IsA("Humanoid")
		or object:IsA("FaceControls")
		or object:IsA("WrapLayer")
		or object:IsA("WrapTarget")
end

local function safe(copy)
	copy.Archivable = false
	if copy:IsA("Model") then
		copy.PrimaryPart = nil
	end
	if copy:IsA("BasePart") then
		copy.Anchored = true
		copy.CanCollide = false
		copy.CanQuery = false
		copy.CanTouch = false
		copy.CastShadow = false
		copy.Locked = true
	elseif copy:IsA("Humanoid") then
		copy.EvaluateStateMachine = false
		copy.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		copy.BreakJointsOnDeath = false
		copy.RequiresNeck = false
	end
end

function geometry.plan(owner, target)
	if target:IsA("Motor6D") then
		target = target.Part1
	end
	assert(target, "The selected joint has no child part")
	local all = { owner }
	for _, object in owner:GetDescendants() do
		table.insert(all, object)
	end
	local parts, branches = {}, {}
	for _, object in all do
		if object:IsA("BasePart") and (object == target or object:IsDescendantOf(target)) then
			parts[object] = true
		end
	end
	 
	local changed = true
	while changed do
		changed = false
		for _, joint in all do
			if
				joint:IsA("Motor6D")
				and parts[joint.Part0]
				and joint.Part1
				and not parts[joint.Part1]
			then
				parts[joint.Part1], changed = true, true
			end
		end
	end
	for _, joint in all do
		if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
			for _, pair in { { joint.Part0, joint.Part1 }, { joint.Part1, joint.Part0 } } do
				local handle, body = pair[1], pair[2]
				if handle and parts[body] and handle:FindFirstAncestorWhichIsA("Accessory") then
					parts[handle] = true
				end
			end
		end
	end
	if target:IsA("Bone") then
		local mesh = target:FindFirstAncestorWhichIsA("MeshPart")
		assert(mesh, "This bone has no renderable skinned mesh")
		parts[mesh] = true
		local names = { [target.Name] = true }
		for _, child in target:GetDescendants() do
			if child:IsA("Bone") then
				names[child.Name] = true
			end
		end
		branches[mesh] = names
	end
	assert(next(parts), "The selected branch contains no renderable parts")
	 
	 
	local motionSet = table.clone(parts)
	local expand = true
	while expand do
		expand = false
		for _, joint in all do
			if
				joint:IsA("Motor6D")
				and motionSet[joint.Part1]
				and joint.Part0
				and not motionSet[joint.Part0]
			then
				motionSet[joint.Part0], expand = true, true
			end
		end
	end
	local motionSources = {}
	if owner:IsA("Model") then
		table.insert(motionSources, owner)
	end
	for part in motionSet do
		table.insert(motionSources, part)
	end
	local included = {}
	for part in parts do
		included[part] = true
		for _, child in part:GetDescendants() do
			 
			if not child:IsA("BasePart") then
				included[child] = true
			end
		end
		local parent = part.Parent
		while parent and parent ~= owner.Parent do
			included[parent] = true
			parent = parent.Parent
		end
	end
	for _, object in all do
		if
			object:IsA("Clothing")
			or object:IsA("ShirtGraphic")
			or object:IsA("BodyColors")
			or object:IsA("CharacterMesh")
			or object:IsA("Humanoid")
		then
			included[object] = true
		end
	end
	local plan = {
		owner = owner,
		motionSources = motionSources,
		target = target,
		rows = {},
		bySource = {},
		branches = branches,
		assets = {},
		meshCache = {},
	}
	for _, source in all do
		if included[source] and allowed(source) then
			local keys, seen = {}, {}
			for class, names in fields do
				if source:IsA(class) then
					for _, name in names do
						if not seen[name] then
							seen[name] = true
							table.insert(keys, name)
						end
					end
				end
			end
			if source:IsA("FaceControls") then
				for _, definition in require("properties").catalog(source) do
					local name = definition.id:match("^FaceControls%.(.+)$") or definition.id
					if definition.kind == "number" then
						table.insert(keys, name)
					end
				end
			end
			local prototype = Instance.fromExisting(source)
			safe(prototype)
			local parent = source.Parent
			while parent and not plan.bySource[parent] do
				parent = parent.Parent
			end
			local row = {
				source = source,
				prototype = prototype,
				parent = plan.bySource[parent],
				keys = keys,
			}
			table.insert(plan.rows, row)
			plan.bySource[source] = #plan.rows
		end
	end
	return plan
end

 
function geometry.capture(plan)
	local pose = { rows = {}, meshes = {}, motion = {} }
	local ok, issue = xpcall(function()
		for index, source in plan.motionSources or {} do
			pose.motion[index] = source:IsA("Model") and { source:GetPivot(), source:GetScale() }
				or { source.CFrame, source.Size }
		end
		for index, row in plan.rows do
			assert(row.source.Parent, "Afterimage source was removed")
			local values = {}
			for _, key in row.keys do
				values[key] = row.source[key]
			end
			pose.rows[index] = values
			if row.source:IsA("MeshPart") then
				local source = row.source
				local mesh = require("meshData").mesh(source)
				local cached = plan.meshCache[source]
				local shared = not mesh
				if shared and cached and cached.content == source.MeshContent then
					pose.meshes[index] = cached
					continue
				end
				local entry = {
					content = source.MeshContent,
					data = mesh and require("meshData").capture(mesh),
					branch = plan.branches[source],
					 
					prototype = Instance.fromExisting(source),
					shared = shared,
				}
				pose.meshes[index] = entry
				if shared then
					plan.meshCache[source] = entry
					table.insert(plan.assets, entry)
				end
			end
		end
	end, debug.traceback)
	if not ok then
		geometry.destroyPose(pose)
		error(issue, 0)
	end
	return pose
end

 
local function different(a, b)
	if typeof(a) ~= typeof(b) then
		return true
	end
	if typeof(a) == "CFrame" then
		local delta = a:ToObjectSpace(b)
		local _, angle = delta:ToAxisAngle()
		return delta.Position.Magnitude > 1e-4 or math.abs(angle) > 1e-4
	elseif typeof(a) == "Vector3" then
		return (a - b).Magnitude > 1e-4
	elseif type(a) == "number" then
		return math.abs(a - b) > 1e-5
	end
	return a ~= b
end

function geometry.moved(plan, previous, pose)
	for index, values in pose.motion or {} do
		for key, value in values do
			if different(previous.motion[index][key], value) then
				return true
			end
		end
	end
	for index, row in plan.rows do
		local a, b = previous.rows[index], pose.rows[index]
		for _, key in { "CFrame", "Size", "Transform", "Scale", "Offset" } do
			if different(a[key], b[key]) then
				return true
			end
		end
		if row.source:IsA("FaceControls") then
			for key, value in b do
				if different(a[key], value) then
					return true
				end
			end
		end
		local ma, mb = previous.meshes[index], pose.meshes[index]
		if ma and mb then
			if ma.content ~= mb.content then
				return true
			end
			if ma.data and mb.data then
				for id, position in mb.data.Vertices do
					if different(ma.data.Vertices[id], position) then
						return true
					end
				end
				for id, bone in mb.data.Bones do
					if
						not ma.data.Bones[id] or different(ma.data.Bones[id].CFrame, bone.CFrame)
					then
						return true
					end
				end
			end
		end
	end
	return false
end

local function cutBranch(mesh, names)
	local selected, matching = {}, 0
	for _, id in mesh:GetBones() do
		if names[mesh:GetBoneName(id)] then
			selected[id] = true
			matching += 1
		end
	end
	assert(matching > 0, "Selected bone names do not match the mesh skinning data")
	local influenced = {}
	for _, vertex in mesh:GetVertices() do
		local bones, weights = mesh:GetVertexBones(vertex), mesh:GetVertexBoneWeights(vertex)
		for index, bone in bones do
			if selected[bone] and weights[index] > 0 then
				influenced[vertex] = true
				break
			end
		end
	end
	local kept = 0
	for _, face in mesh:GetFaces() do
		local keep = false
		for _, vertex in mesh:GetFaceVertices(face) do
			if influenced[vertex] then
				keep = true
				break
			end
		end
		if keep then
			kept += 1
		else
			mesh:RemoveFace(face)
		end
	end
	assert(kept > 0, "This bone branch has no weighted mesh surface")
end

 
function geometry.finishPose(pose)
	for _, entry in pose.meshes do
		if not entry.finished and (entry.data or entry.branch) then
			local mesh = require("meshAccess").open(entry.content, { FixedSize = false })
			assert(mesh, "Roblox could not allocate the afterimage mesh")
			entry.editable = mesh
			if entry.data then
				require("meshData").restore(mesh, entry.data)
			end
			if entry.branch then
				cutBranch(mesh, entry.branch)
			end
			local part = assetService:CreateMeshPartAsync(Content.fromObject(mesh))
			entry.prototype:Destroy()
			entry.prototype = part
			entry.data = nil
			entry.finished = true
		end
	end
end

function geometry.slot(plan)
	local root = Instance.new("Model")
	root.Name = "Afterimage"
	root.Archivable = false
	root:SetAttribute("EclipseAfterimageGhost", true)
	local slot = { model = root, copies = {}, fades = {}, meshes = {}, birth = nil }
	for index, row in plan.rows do
		local copy = Instance.fromExisting(row.prototype)
		safe(copy)
		copy.Parent = row.parent and slot.copies[row.parent] or root
		slot.copies[index] = copy
		if copy:IsA("BasePart") or copy:IsA("Decal") then
			table.insert(slot.fades, { object = copy, index = index, part = copy:IsA("BasePart") })
		end
	end
	local highlight = Instance.new("Highlight")
	highlight.Adornee = root
	highlight.Parent = root
	slot.highlight = highlight
	return slot
end

function geometry.apply(slot, pose, birth)
	for index, copy in slot.copies do
		local mesh = pose.meshes[index]
		if mesh and slot.meshes[index] ~= mesh.prototype then
			copy:ApplyMesh(mesh.prototype)
			slot.meshes[index] = mesh.prototype
		end
		for key, value in pose.rows[index] do
			if copy[key] ~= value then
				copy[key] = value
			end
		end
	end
	for _, row in slot.fades do
		local values = pose.rows[row.index]
		row.opacity = (1 - values.Transparency) * (1 - (values.LocalTransparencyModifier or 0))
		row.color = row.part and values.Color or nil
		row.object.LocalTransparencyModifier = 0
	end
	slot.birth = birth
	slot.alpha = nil
	slot.opacity = nil
	slot.color = nil
end

function geometry.paint(slot, config, alpha, color)
	local opacity = alpha * config.Opacity
	local bodyChanged = slot.opacity ~= opacity
		or slot.tint ~= config.TintBody
		or config.TintBody and slot.color ~= color
	if bodyChanged then
		for _, row in slot.fades do
			local transparency = 1 - row.opacity * opacity
			if row.object.Transparency ~= transparency then
				row.object.Transparency = transparency
			end
			if row.part then
				local body = config.TintBody and color or row.color
				if row.object.Color ~= body then
					row.object.Color = body
				end
			end
		end
	end
	slot.opacity, slot.tint, slot.color = opacity, config.TintBody, color
	local h = slot.highlight
	local fill, outline = 1 - alpha * config.FillOpacity, 1 - alpha * config.OutlineOpacity
	if h.FillTransparency ~= fill then
		h.FillTransparency = fill
	end
	if h.OutlineTransparency ~= outline then
		h.OutlineTransparency = outline
	end
	if h.FillColor ~= color then
		h.FillColor = color
	end
	if h.OutlineColor ~= config.OutlineColor then
		h.OutlineColor = config.OutlineColor
	end
	local depth = config.AlwaysOnTop and Enum.HighlightDepthMode.AlwaysOnTop
		or Enum.HighlightDepthMode.Occluded
	if h.DepthMode ~= depth then
		h.DepthMode = depth
	end
end

function geometry.destroyPose(pose)
	for _, entry in pose.meshes do
		if not entry.shared then
			entry.prototype:Destroy()
			if entry.editable then
				entry.editable:Destroy()
			end
		end
	end
end

function geometry.destroyPlan(plan)
	for _, row in plan.rows do
		row.prototype:Destroy()
	end
	for _, asset in plan.assets do
		asset.prototype:Destroy()
		if asset.editable then
			asset.editable:Destroy()
		end
	end
end

return geometry
]]></ProtectedString>
