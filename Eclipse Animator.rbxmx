						<Item class="ModuleScript" referent="RBX54B6D846C45A456EAC3F628161ACCA31">
							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local httpService = game:GetService("HttpService")

local configuration = require(script.Parent.Parent.Parent.Utility.configuration)
local ShapeKit = require(script.Parent.ShapeKit)

local Generators = {}
Generators.__index = Generators

Generators.definitionNames = { "ring", "beamRing", "slash", "spiral", "lightning", "shards", "bezier", "pillarBeam", "sphereBeam", "energyBeam" }
Generators.maximumSeed = 9999
Generators.sectionSuffix = " Generator"

Generators.tips = {
	rebuild = "Build the shape again from these values. Anything added inside it by hand is replaced.",
	seed = "Pick a new random seed.",
	detach = "Keep the objects as they are and stop treating them as a generated shape.",
}

function Generators.new(context)
	local self = setmetatable({}, Generators)

	self.context = context
	self.history = context.history
	self.definitions = {}
	self.editing = false
	self.lastBuild = 0

	for _, name in Generators.definitionNames do
		local definition = require(script.Parent[name])

		self.definitions[definition.id] = definition
	end

	return self
end

function Generators:getDefinition(id: string)
	return self.definitions[id]
end

function Generators:encodeValue(value)
	local kind = typeof(value)

	if kind == "Color3" then
		return { t = "Color3", v = { value.R, value.G, value.B } }
	elseif kind == "Vector3" then
		return { t = "Vector3", v = { value.X, value.Y, value.Z } }
	elseif kind == "number" or kind == "boolean" or kind == "string" then
		return value
	end

	return nil
end

function Generators:decodeValue(packed)
	if typeof(packed) ~= "table" then
		return packed
	end

	local values = packed.v

	if typeof(values) ~= "table" then
		return nil
	end

	if packed.t == "Color3" then
		return Color3.new(values[1], values[2], values[3])
	elseif packed.t == "Vector3" then
		return Vector3.new(values[1], values[2], values[3])
	end

	return nil
end

function Generators:getDefaults(definition, overrides)
	local params = {}

	for _, param in definition.params do
		params[param.name] = param.default
	end

	for name, value in overrides or {} do
		if params[name] ~= nil and typeof(value) == typeof(params[name]) then
			params[name] = value
		end
	end

	return params
end

function Generators:write(root: Instance, id: string, params)
	local encoded = {}

	for name, value in params do
		encoded[name] = self:encodeValue(value)
	end

	root:SetAttribute(configuration.Create.generatorAttribute, httpService:JSONEncode({ id = id, p = encoded }))
end

function Generators:read(root: Instance): (string?, any)
	local stored = root:GetAttribute(configuration.Create.generatorAttribute)

	if typeof(stored) ~= "string" then
		return nil, nil
	end

	local success, data = pcall(function()
		return httpService:JSONDecode(stored)
	end)

	if not success or typeof(data) ~= "table" or not self.definitions[data.id] then
		return nil, nil
	end

	local decoded = {}

	for name, packed in data.p or {} do
		decoded[name] = self:decodeValue(packed)
	end

	return data.id, self:getDefaults(self.definitions[data.id], decoded)
end

function Generators:isGenerated(instance: Instance): boolean
	return (self:read(instance)) ~= nil
end

function Generators:rebuildChildren(root: Instance, definition, params, pivot: CFrame)
	if definition.capture then
		definition.capture(root, params)
	end

	for _, child in root:GetChildren() do
		child.Parent = nil
	end

	local kit = ShapeKit.new(root, if root:IsA("Model") then pivot else CFrame.identity, params)

	definition.build(kit, params)

	if root:IsA("Model") then
		root.WorldPivot = pivot
	end
end

function Generators:createRoot(definition, cframe: CFrame, name: string?): Instance
	if definition.root == "Part" then
		local holder = Instance.new("Part")

		holder.Name = name or definition.title
		holder.Size = configuration.Create.holderSize
		holder.Transparency = 1
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.CastShadow = false
		holder.CFrame = cframe

		return holder
	end

	local model = Instance.new("Model")

	model.Name = name or definition.title
	model.WorldPivot = cframe

	return model
end

function Generators:create(id: string, overrides, parent: Instance, cframe: CFrame, name: string?): Instance?
	local definition = self.definitions[id]

	if not definition then
		return nil
	end

	local params = self:getDefaults(definition, overrides)
	local root = self:createRoot(definition, cframe, name)

	self:rebuildChildren(root, definition, params, cframe)
	self:write(root, id, params)

	if definition.strike and self.context.strikes then
		self.context.strikes:initialize(root)
	end

	root.Parent = parent

	return root
end

function Generators:regenerate(root: Instance, params)
	local id = self:read(root)
	local definition = id and self.definitions[id]

	if not definition or not root:IsA("PVInstance") then
		return
	end

	self:rebuildChildren(root, definition, params, root:GetPivot())
	self:write(root, id, params)
end

function Generators:finishEdit()
	if self.editing then
		self.editing = false
		self.history:finish()
	end
end

function Generators:change(root: Instance, name: string, value, final: boolean)
	local id, params = self:read(root)
	local definition = id and self.definitions[id]

	if not definition or value == nil then
		return
	end

	params[name] = value

	if not self.editing then
		self.editing = true
		self.history:begin("Edit " .. definition.title)
	end

	local now = os.clock()

	if final or now - self.lastBuild >= configuration.Create.regenerateInterval then
		self.lastBuild = now
		self:regenerate(root, params)
	else
		self:write(root, id, params)
	end

	if final then
		self:finishEdit()
	end
end

function Generators:rebuild(root: Instance)
	local id, params = self:read(root)

	if not id then
		return
	end

	self.history:run("Rebuild " .. self.definitions[id].title, function()
		self:regenerate(root, params)
	end)
end

function Generators:reseed(root: Instance)
	local id, params = self:read(root)

	if not id or params.Seed == nil then
		return
	end

	params.Seed = Random.new():NextInteger(1, Generators.maximumSeed)

	self.history:run("New Seed", function()
		self:regenerate(root, params)
	end)
end

function Generators:detach(root: Instance)
	self.history:run("Detach Shape", function()
		root:SetAttribute(configuration.Create.generatorAttribute, nil)
	end)
end

function Generators:handles(instance: Instance): boolean
	return self:isGenerated(instance)
end

function Generators:createField(root: Instance, param, params)
	local options = nil

	if param.options then
		options = {}

		for _, option in param.options do
			table.insert(options, { value = option, label = option })
		end
	end

	return {
		id = "Generator." .. param.name,
		label = param.label or param.name,
		kind = param.kind,
		value = params[param.name],
		options = options,
		tip = param.tip,
		integer = param.integer,
		minimum = param.min,
		maximum = param.max,
		clamp = param.max ~= nil,
		preview = false,
		range = if param.kind == "number" and param.min and param.max then { min = param.min, max = math.min(param.max, param.min + math.max(math.abs(param.default) * 4, 1)) } else nil,
		read = function()
			local _, current = self:read(root)

			return if current then current[param.name] else nil
		end,
		onChange = function(value, final)
			self:change(root, param.name, value, final)
		end,
	}
end

function Generators:getSections(targets: { Instance })
	if #targets ~= 1 then
		return {}
	end

	local root = targets[1]
	local id, params = self:read(root)
	local definition = id and self.definitions[id]

	if not definition then
		return {}
	end

	local fields = {}

	for _, param in definition.params do
		table.insert(fields, self:createField(root, param, params))
	end

	table.insert(fields, {
		id = "Generator.Rebuild",
		label = "Rebuild",
		kind = "action",
		tip = Generators.tips.rebuild,
		onAction = function()
			self:rebuild(root)
		end,
	})

	if params.Seed ~= nil then
		table.insert(fields, {
			id = "Generator.Reseed",
			label = "New Seed",
			kind = "action",
			tip = Generators.tips.seed,
			onAction = function()
				self:reseed(root)
			end,
		})
	end

	table.insert(fields, {
		id = "Generator.Detach",
		label = "Detach",
		kind = "action",
		tip = Generators.tips.detach,
		onAction = function()
			self:detach(root)
		end,
	})

	return {
		{
			title = definition.title .. Generators.sectionSuffix,
			key = "Generator",
			fields = fields,
		},
	}
end

function Generators:destroy()
	self:finishEdit()
end

return Generators
]]></ProtectedString>
