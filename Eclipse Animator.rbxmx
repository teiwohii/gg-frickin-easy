				<Item class="ModuleScript" referent="RBX471DF46E61EC40FB99555A83B2C63158">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local scene = require("scene")
local recovery = require("recovery")
local history = require("history")
local selection = game:GetService("Selection")
local runService = game:GetService("RunService")
local inputService = game:GetService("UserInputService")
local cursor = require("rotateCursor")
local shortcuts = require("shortcuts")
local edit = require("blenderEdit")
local editorInput = require("userInputService")
local document = require("document")
local path = require("path")
local timing = require("timing")
local display = {}

function display.positionAt(part, frame, cache)
	cache = cache or {}
	local source = part:GetAttribute("ForcePath")
	if source ~= cache.pathSource then
		cache.pathSource, cache.pathSample, cache.pathEasing = source, nil, nil
		if source then
			local ok, data, sample = pcall(function()
				local value = document.unpack(source)
				path.validate({
					force = { points = value.points, smoothing = 0, easing = value.easing },
				})
				return value, path.sampler(value.points)
			end)
			if ok then
				cache.pathSample, cache.pathEasing = sample, data.easing
			end
		end
	end

	if not cache.pathSample then
		return part.Position
	end

	local alpha = (frame - (part:GetAttribute("Frame") or 0))
		/ math.max(1, (part:GetAttribute("Duration") or 60) - 1)
	return part.Position + cache.pathSample(timing.sample(cache.pathEasing, alpha))
end

local color = Color3.fromRGB(242, 171, 196)
local refs, host, handles, selected, hovered, drag
local mode = "Move"
local shapes = {}
local connections = {}

local function editing()
	return (
		refs
		and refs.Active()
		and refs.State.Physics
		and refs.State.Physics.isEditorOpen
		and refs.State.Physics.isEditorOpen()
	) == true
end

local function radius(part)
	local value = part:GetAttribute("Radius")
	return typeof(value) == "number" and value == value and math.clamp(value, 0.1, 1000) or 5
end

function display.segments(position, value)
	local lines = {}
	for axis = 1, 3 do
		for i = 1, 64 do
			local function point(angle)
				local a, b = math.cos(angle) * value, math.sin(angle) * value
				return position
					+ (
						axis == 1 and Vector3.new(0, a, b)
						or axis == 2 and Vector3.new(a, 0, b)
						or Vector3.new(a, b, 0)
					)
			end

			table.insert(lines, { point((i - 1) * math.pi / 32), point(i * math.pi / 32) })
		end
	end

	local center = math.clamp(value * 0.07, 0.4, 1.5)
	for _, axis in { Vector3.xAxis, Vector3.yAxis, Vector3.zAxis } do
		table.insert(lines, { position - axis * center, position + axis * center })
	end

	return lines
end

function display.sync(part, shape)
	local value = radius(part)
	local nextRadius = value
	if shape.size and part.Size ~= shape.size and value == shape.radius then
		local delta = part.Size - shape.size
		local largest = math.max(math.abs(delta.X), math.abs(delta.Y), math.abs(delta.Z))
		local length = math.abs(delta.X) == largest and part.Size.X
			or math.abs(delta.Y) == largest and part.Size.Y
			or part.Size.Z
		nextRadius = math.clamp(length / 2, 0.1, 1000)
		part:SetAttribute("Radius", nextRadius)
	end

	local size = Vector3.one * (nextRadius * 2)
	if part.Size ~= size then
		part.Size = size
	end

	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	shape.size, shape.radius = size, nextRadius
	return nextRadius
end

function display.select(part)
	if not editing() then
		return false
	end

	assert(
		part and part.Parent and part:GetAttribute("EclipsePhysicsForce"),
		"choose a blast first"
	)
	if refs and refs.State.Rig and refs.State.Rig.ClearItemSelection then
		refs.State.Rig:ClearItemSelection()
	end

	selected = part
	hovered = nil
	selection:Set({ part })
	display.refresh()
end

function display.deselect()
	if not selected and not drag then
		return
	end

	display.finish(false)
	selected, hovered = nil, nil
	local keep = {}
	local changed = false
	for _, object in selection:Get() do
		if object:GetAttribute("EclipsePhysicsForce") then
			changed = true
		else
			table.insert(keep, object)
		end
	end

	if changed then
		local previous = refs and refs.State.ignoreSelectionChanged
		if refs then
			refs.State.ignoreSelectionChanged = true
		end

		selection:Set(keep)
		if refs then
			refs.State.ignoreSelectionChanged = previous
		end
	end

	display.refresh()
end

function display.hide()
	display.finish(true)
	display.deselect()
	display.refresh()
end

function display.setMode(value)
	mode = value == "Scale" and "Scale" or "Move"
	if handles then
		handles.Style = mode == "Scale" and Enum.HandlesStyle.Resize or Enum.HandlesStyle.Movement
	end
end

function display.getMode()
	return mode
end

function display.toggleMode()
	if
		not refs
		or not refs.Active()
		or not selected
		or not selected.Parent
		or not handles
		or not handles.Visible
	then
		return false
	end

	if
		refs.State.PhysicsSimulating
		or refs.State.Timeline:GetState().Playing
		or inputService:GetFocusedTextBox()
	then
		return false
	end

	if drag then
		return true
	end

	display.setMode(mode == "Move" and "Scale" or "Move")
	return true
end

function display.isEditing()
	return drag ~= nil
end

local function planePoint(camera, point, pivot, normal)
	local ray = camera:ViewportPointToRay(point.X, point.Y)
	local denominator = ray.Direction:Dot(normal)
	if math.abs(denominator) < 1e-6 then
		return
	end

	return ray.Origin + ray.Direction * ((pivot - ray.Origin):Dot(normal) / denominator)
end

function display.start(value)
	if drag then
		return true
	end

	if
		not refs
		or not refs.Active()
		or not selected
		or not selected.Parent
		or not handles
		or not handles.Visible
	then
		return false
	end

	if
		refs.State.PhysicsSimulating
		or refs.State.Timeline:GetState().Playing
		or inputService:GetFocusedTextBox()
		or editorInput.inWidget()
		or edit.blocked()
	then
		return false
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end

	if refs.Finalize then
		refs.Finalize()
	end

	display.setMode(value)
	display.begin()
	if not drag then
		return false
	end

	drag.pointer = true
	drag.mouse = inputService:GetMouseLocation()
	drag.normal = camera.CFrame.LookVector
	drag.origin = shapes[selected] and shapes[selected].position or drag.cf.Position
	drag.plane = planePoint(camera, drag.mouse, drag.origin, drag.normal)
	if not drag.plane then
		drag = nil
		return false
	end

	cursor.start(drag.origin, mode == "Move")
	hovered = nil
	handles.Visible = false
	return true
end

function display.pointer(point)
	if not drag or not drag.pointer or not drag.part.Parent then
		return
	end

	local fine = (
		inputService:IsKeyDown(Enum.KeyCode.LeftShift) or inputService:IsKeyDown(Enum.KeyCode.RightShift)
	)
			and 0.1
		or 1
	if drag.mode == "Scale" then
		drag.part:SetAttribute(
			"Radius",
			math.clamp(
				drag.radius * math.exp(math.clamp((drag.mouse.Y - point.Y) * fine / 160, -12, 12)),
				0.1,
				1000
			)
		)
	else
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end

		local world = planePoint(camera, point, drag.origin, drag.normal)
		if world then
			local delta = (world - drag.plane) * fine
			if drag.axis then
				delta = drag.axis * delta:Dot(drag.axis)
			end

			drag.part.CFrame = drag.cf + delta
		end
	end
end

function display.keyboard(input)
	if not drag or not drag.pointer then
		return false
	end

	if
		shortcuts.matches("Cancel", input)
		or input.UserInputType == Enum.UserInputType.MouseButton2
	then
		display.finish(true)
	elseif
		shortcuts.matches("ConfirmTransform", input)
		or shortcuts.matches("ConfirmTransformAlternate", input)
		or input.UserInputType == Enum.UserInputType.MouseButton1
	then
		display.finish(false)
	elseif drag.mode == "Move" then
		local axis = input.KeyCode == Enum.KeyCode.X and Vector3.xAxis
			or input.KeyCode == Enum.KeyCode.Y and Vector3.yAxis
			or input.KeyCode == Enum.KeyCode.Z and Vector3.zAxis
		if axis then
			drag.axis = if drag.axis == axis then nil else axis
		end
	end

	return true
end

function display.begin()
	if
		not selected
		or not selected.Parent
		or refs.State.Timeline:GetState().Playing
		or refs.State.PhysicsSimulating
	then
		return
	end

	drag = { part = selected, cf = selected.CFrame, radius = radius(selected), mode = mode }
end

function display.change(face, distance)
	if not drag or not drag.part.Parent then
		return
	end

	if drag.mode == "Scale" then
		drag.part:SetAttribute("Radius", math.clamp(drag.radius + distance, 0.1, 1000))
	else
		drag.part.CFrame = drag.cf
			+ drag.cf:VectorToWorldSpace(Vector3.FromNormalId(face)) * distance
	end

	display.refresh()
end

function display.finish(cancel)
	if not drag then
		return
	end

	local before = drag
	drag = nil
	if before.pointer then
		cursor.stop()
	end

	local part = before.part
	if not part.Parent then
		return
	end

	local after = { cf = part.CFrame, radius = radius(part) }

	local function apply(value)
		if part.Parent then
			part.CFrame = value.cf
			part:SetAttribute("Radius", value.radius)
			display.refresh()
		end

		if refs then
			refs.State.currentProjectSaved = false
		end
	end

	if cancel then
		apply(before)
		return
	end

	if before.cf == after.cf and before.radius == after.radius then
		return
	end

	apply(after)
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, before.mode == "Scale" and "Scale blast radius" or "Move blast")
end

local function distance(point, a, b)
	local delta = b - a
	local alpha = delta:Dot(delta) > 1e-8
			and math.clamp((point - a):Dot(delta) / delta:Dot(delta), 0, 1)
		or 0
	return (point - a - delta * alpha).Magnitude
end

function display.hit(camera, point, entries)
	if not camera then
		return
	end

	local best, gap = nil, 10
	for part, shape in entries or shapes do
		if not part.Parent or not shape.visible then
			continue
		end

		local center = camera:WorldToScreenPoint(shape.position or part.Position)
		if center.Z > 0 and (Vector2.new(center.X, center.Y) - point).Magnitude < 12 then
			return part
		end

		for _, line in shape.lines or {} do
			local a, b = camera:WorldToScreenPoint(line[1]), camera:WorldToScreenPoint(line[2])
			if a.Z <= 0 or b.Z <= 0 then
				continue
			end

			local value = distance(point, Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y))
			if value < gap then
				best, gap = part, value
			end
		end
	end

	return best
end

function display.input(point)
	if
		not editing()
		or refs.State.PresentationHidden
		or refs.State.PhysicsSimulating
		or refs.State.Timeline:GetState().Playing
	then
		return false
	end

	if hovered or drag then
		return true
	end

	local part = display.hit(workspace.CurrentCamera, point)
	if not part then
		display.deselect()
		return false
	end

	display.select(part)
	return true
end

function display.refresh()
	if not refs or not refs.State.Timeline then
		return
	end

	if not host or host.Parent ~= workspace.CurrentCamera then
		if host then
			host:Destroy()
		end

		shapes = {}
		if not workspace.CurrentCamera then
			return
		end

		host = recovery.mark(Instance.new("Folder"))

		host.Name = "EclipseBlastDisplay"
		host.Parent = workspace.CurrentCamera
	end

	if drag and drag.pointer then
		display.pointer(inputService:GetMouseLocation())
	end

	local editor = editing()
	local visible = editor
		and not refs.State.PresentationHidden
		and not refs.State.PhysicsSimulating
	local editable = visible and not refs.State.Timeline:GetState().Playing
	local raw = refs.State.Timeline:GetState()
	local frame = raw.CurrentTime * raw.FPS
	local active = {}
	for _, part in scene.get().forces do
		if not part.Parent then
			continue
		end

		if editor then
			if part.Parent ~= workspace then
				part.Parent = workspace
			end
		elseif part.Parent == workspace then
			recovery.parkForce(part)
		end

		active[part] = true
		local shape = shapes[part]
		if not shape then
			local wire = Instance.new("WireframeHandleAdornment")

			wire.Name = "BlastRadius"
			wire.Adornee = workspace.Terrain
			wire.AlwaysOnTop = true
			wire.Color3 = color
			wire.Thickness = 2
			wire.Parent = host
			local proxy = Instance.new("Part")
			proxy.Name = "ForcePreviewAnchor"
			proxy.Anchored = true
			proxy.Transparency = 1
			proxy.CanCollide, proxy.CanTouch, proxy.CanQuery = false, false, false
			proxy.Parent = host
			shape = { wire = wire, proxy = proxy }
			shapes[part] = shape
		end

		local value = display.sync(part, shape)
		local position = display.positionAt(part, frame, shape)
		shape.proxy.CFrame = part.CFrame.Rotation + position
		shape.proxy.Size = part.Size
		shape.visible = visible
		shape.wire.Visible = visible
		shape.wire.Thickness = part == selected and 3 or 2
		if shape.position ~= position or shape.drawnRadius ~= value then
			shape.position, shape.drawnRadius = position, value
			shape.lines = display.segments(position, value)
			shape.wire:Clear()
			for _, line in shape.lines do
				shape.wire:AddLine(line[1], line[2])
			end
		end
	end

	for part, shape in shapes do
		if not active[part] then
			recovery.parkForce(part)
			shape.wire:Destroy()
			shape.proxy:Destroy()
			shapes[part] = nil
		end
	end

	if selected and not active[selected] then
		selected = nil
	end

	if handles then
		handles.Adornee = selected and shapes[selected] and shapes[selected].proxy
		handles.Visible = editable and selected ~= nil and not (drag and drag.pointer)
	end

	if not editable then
		display.finish(true)
		hovered = nil
	end
end

function display.destroy()
	display.finish(true)
	for part in shapes do
		recovery.parkForce(part)
	end

	for _, connection in connections do
		connection:Disconnect()
	end

	table.clear(connections)
	if host then
		host:Destroy()
	end

	if handles then
		handles:Destroy()
	end

	host, handles, selected, hovered, refs = nil, nil, nil, nil, nil
	shapes = {}
end

function display.init(options)
	display.destroy()
	refs = options
	options.State.PhysicsDisplay = display
	handles = recovery.mark(Instance.new("Handles"))

	handles.Name = "BlastHandles"
	handles.Color3 = color
	handles.Visible = false
	handles.Parent = options.ScreenGui
	display.setMode("Move")

	local function connect(signal, fn)
		table.insert(connections, signal:Connect(fn))
	end

	connect(handles.MouseEnter, function(face)
		hovered = face
	end)
	connect(handles.MouseLeave, function()
		hovered = nil
	end)
	connect(handles.MouseButton1Down, display.begin)
	connect(handles.MouseDrag, display.change)
	connect(handles.MouseButton1Up, function()
		if not drag or not drag.pointer then
			display.finish(false)
		end
	end)
	connect(inputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and drag and not drag.pointer then
			display.finish(false)
		end
	end)
	connect(inputService.InputBegan, function(input)
		if drag and not drag.pointer and input.KeyCode == Enum.KeyCode.Escape then
			display.finish(true)
		end
	end)
	connect(inputService.WindowFocusReleased, function()
		display.finish(true)
	end)
	connect(selection.SelectionChanged, function()
		local part = selection:Get()[1]
		if
			part
			and part:GetAttribute("EclipsePhysicsForce")
			and table.find(scene.get().forces, part)
		then
			selected = part
		else
			display.finish(false)
			selected = nil
			hovered = nil
		end

		display.refresh()
	end)
	connect(runService.RenderStepped, display.refresh)
	connect(options.Plugin.Unloading, display.destroy)
	connect(options.ScreenGui.Destroying, display.destroy)
end

return display
]]></ProtectedString>
						<string name="ScriptGuid">{7DE41762-664B-4A61-B079-96F4D32D6CCC}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">sceneSync</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXFCC4BBC3D4B64D65B01D140055DE04AC">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local timing = require("timing")

local selection = game:GetService("Selection")
local parenting = require("parenting")
local selectedRig = require("selectedRig")
local cameraRig = require("cameraRig")
local armature = require("armatureRuntime")
local document = require("document")
local data = require("chunkStore")
local history = require("history")
local properties = require("properties")
local scene = {}
local sessions = setmetatable({}, { __mode = "k" })
local refs

function scene.get()
	local raw = refs.State.Timeline:GetState()
	local session = sessions[raw.Keyframes]
	if not session then
		session = { entries = {}, forces = {} }
		sessions[raw.Keyframes] = session
	end

	return session
end

local function changed()
	refs.State.currentProjectSaved = false
end

function scene.part(motor)
	if properties.is(motor) and motor.PropertyId == "CFrame" and motor.Rig:IsA("BasePart") then
		return motor.Rig
	end

	return motor.Part1
end

function scene.name(motor)
	return scene.part(motor):GetFullName()
end

function scene.world(part)
	return part:IsA("Bone") and part.TransformedWorldCFrame or part.CFrame
end

function scene.size(part)
	if part:IsA("BasePart") then
		return part.Size
	end

	local length = part.CFrame.Position.Magnitude
	for _, child in part:GetChildren() do
		if child:IsA("Bone") then
			length = child.CFrame.Position.Magnitude
			break
		end
	end

	local diameter = math.clamp(length * 0.3, 0.15, 2)
	return Vector3.new(diameter, diameter, diameter)
end

function scene.all()
	local result = {}
	for _, rig in refs.State.getAllRigs() do
		if cameraRig.isRig(rig) or armature.isRig(rig) then
			continue
		end

		if rig:IsA("BasePart") and not rig:FindFirstChildWhichIsA("Bone", true) then
			for _, motor in properties.list(rig) do
				if motor.PropertyId == "CFrame" and not motor:GetAttribute("EclipseDisabled") then
					table.insert(result, { rig = rig, motor = motor, ragdoll = false })
				end
			end
		end

		for _, motor in parenting.collectMotors(rig) do
			if
				typeof(motor) == "Instance"
				and motor:IsA("Motor6D")
				and motor.Part1
				and motor.Part1:IsA("BasePart")
			then
				if
					motor:GetAttribute("EclipsePartTrackEnabled") ~= false
					and (
						not motor:GetAttribute("EclipseAddedObject")
						or refs.State.activeObjectMotors[motor]
					)
				then
					table.insert(result, {
						rig = rig,
						motor = motor,
						ragdoll = not motor:GetAttribute("EclipseAddedObject"),
					})
				end
			end
		end

		for _, bone in require("rigTraversal").rigDescendants(rig) do
			if
				bone:IsA("Bone")
				and not bone:GetAttribute("EclipseArmatureSkinningHelper")
				and not require("r6Controls").isControl(bone)
			then
				local motor = require("boneMotor").get(bone)
				if motor and not bone:GetAttribute("EclipseDisabled") then
					table.insert(result, { rig = rig, motor = motor, ragdoll = true })
				end
			end
		end
	end

	return result
end

local function ownerRig(part)
	local rigs = refs.State.getAllRigs()
	if table.find(rigs, part) then
		return nil
	end

	local limb = false
	for _, joint in require("rigTraversal").joints(part) do
		if joint:IsA("Motor6D") then
			if joint.Part1 == part and joint:GetAttribute("EclipseAddedObject") then
				return nil
			end

			limb = true
		end
	end

	local nearest
	local current = part.Parent
	while current and current ~= workspace do
		if current:IsA("Model") then
			if
				table.find(rigs, current)
				or current:FindFirstChildOfClass("Humanoid")
				or current:FindFirstChildOfClass("AnimationController")
			then
				return current
			end

			nearest = nearest or current
		end

		current = current.Parent
	end

	return limb and nearest or nil
end

function scene.add(mode, objects)
	assert(not refs.State.Timeline:GetState().Playing, "pause the animation first")
	local picked, seen = {}, {}

	local function add(object)
		if typeof(object) ~= "Instance" then
			return
		end

		object = require("rigPreview").localOf(object)
		object = properties.owner(object) or object
		 
		if require("r6Controls").isControl(object) then
			local control = require("r6Controls").get(object)
			object = control and control.Owner and control.Owner.Part1 or object
		end
		local source = object:FindFirstChild("EclipseSourcePart")
		if source and source:IsA("ObjectValue") and source.Value then
			object = source.Value
		end

		if object:IsA("Motor6D") then
			object = object.Part1
		end

		if mode == "Ragdoll" and object and object:IsA("BasePart") then
			object = ownerRig(object) or object
		end

		if not object or seen[object] or object:GetAttribute("EclipsePhysicsForce") then
			return
		end

		if
			not (object:IsA("Model") or object:IsA("BasePart") or object:IsA("Bone"))
			or not object:IsDescendantOf(workspace)
		then
			return
		end

		seen[object] = true
		table.insert(picked, object)
	end

	if objects then
		for _, object in objects do
			add(object)
		end
	else
		for _, object in selection:Get() do
			add(object)
		end

		if #picked == 0 then
			for item, selected in refs.State.Rig and refs.State.Rig._selectedItems or {} do
				if selected then
					add(item.linkedRigInstance)
				end
			end
		end
	end

	objects = picked
	assert(#objects > 0, "select a rig, model or parts first")
	local session = scene.get()
	local before = table.clone(session.entries)
	local pending = {}
	local available = scene.all()
	for _, object in objects do
		assert(
			typeof(object) == "Instance" and object:IsDescendantOf(workspace),
			"select a rig, model or parts in Workspace"
		)
		local matched = false
		for _, entry in available do
			if
				object == entry.rig
				or object == scene.part(entry.motor)
				or scene.part(entry.motor):IsDescendantOf(object)
			then
				matched = true
				break
			end
		end

		if not matched then
			for _, registered in refs.State.getAllRigs() do
				assert(
					object ~= registered,
					"This rig is already registered but has no supported physics bodies; select its physical limbs."
				)
			end
			assert(refs.AddObject and refs.AddRig, "add this object to the timeline first")
			if object:IsA("Bone") then
				refs.AddRig(
					object:FindFirstAncestorOfClass("Model")
						or object:FindFirstAncestorWhichIsA("BasePart")
				)
			elseif
				object:IsA("BasePart")
				or object:IsA("Model")
					and (object:FindFirstChildOfClass("Humanoid") or #parenting.collectMotors(
						object
					) > 0)
			then
				refs.AddRig(object)
			else
				local owner = refs.State.currentRig
				assert(
					owner and not cameraRig.isRig(owner) and not armature.isRig(owner),
					"select a Motor6D rig in Eclipse before adding objects"
				)
				refs.AddObject(object, { Physics = true })
			end

			available = scene.all()
		end

		local count = 0
		for _, entry in available do
			local belongs = scene.part(entry.motor) == object
				or scene.part(entry.motor):IsDescendantOf(object)
			if belongs or mode == "Ragdoll" and entry.ragdoll and object == entry.rig then
				pending[entry.motor] = {
					rig = entry.rig,
					motor = entry.motor,
					ragdoll = mode == "Ragdoll" and entry.ragdoll,
				}
				count += 1
			end
		end

		assert(count > 0, "add a Motor6D rig to the timeline before adding objects")
	end

	local after = table.clone(before)
	for motor, entry in pending do
		after[motor] = entry
	end

	local count = 0
	for _ in after do
		count += 1
	end

	if count > 150 then
		require("notification").show(
			"PHYSICS",
			tostring(count) .. " parts. Big simulations work, they just take longer to finish.",
			6
		)
	end

	local function apply(entries)
		session.entries = table.clone(entries)
		changed()
	end

	apply(after)
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Add physics participants")
	return count
end

function scene.clear()
	local session = scene.get()
	local before, guide, paths = session.entries, session.guide, session.guides

	local function apply(entries, path, guides)
		session.entries = entries
		session.guide = path
		session.guides = guides
		changed()
	end

	apply({}, nil, {})
	history.record(function()
		apply(before, guide, paths)
	end, function()
		apply({}, nil, {})
	end, "Clear physics participants")
end

function scene.setMode(mode)
	local available = {}
	for _, entry in scene.all() do
		available[entry.motor] = entry
	end

	for motor, entry in scene.get().entries do
		entry.ragdoll = mode == "Ragdoll" and available[motor] and available[motor].ragdoll or false
	end
end

function scene.entries()
	local result = {}
	for motor, entry in scene.get().entries do
		assert(
			motor.Parent and motor.Part1 and motor.Part1.Parent and entry.rig.Parent,
			"a registered physics part was removed; clear the list and add it again"
		)
		table.insert(result, entry)
	end

	table.sort(result, function(a, b)
		return scene.name(a.motor) < scene.name(b.motor)
	end)
	return result
end

function scene.useClip(clip)
	local session = scene.get()
	session.entries = {}
	session.guide = nil
	session.guides = {}
	for motor in clip.tracks do
		local ragdoll = clip.ragdolls and clip.ragdolls[motor]
		session.entries[motor] = {
			motor = motor,
			rig = clip.owners and clip.owners[motor] or clip.rig,
			ragdoll = ragdoll == true
				or ragdoll == nil
					and clip.settings.mode == "Ragdoll"
					and not motor:GetAttribute("EclipseAddedObject"),
		}
	end

	local entries = scene.entries()
	for _, saved in clip.settings.guides or (clip.settings.guide and { clip.settings.guide } or {}) do
		local guide = table.clone(saved)
		if clip.guideMotors then
			guide.motor = clip.guideMotors[guide.index]
		else
			guide.motor = clip.guideMotor or entries[guide.index] and entries[guide.index].motor
		end

		if guide.motor and session.entries[guide.motor] then
			session.guides[guide.motor] = guide
			session.guide = guide
		end
	end
end

function scene.guideMotor()
	local entries = scene.entries()
	local rig = selectedRig.resolve(refs.State)
	for _, entry in entries do
		if
			entry.rig == rig
			and entry.ragdoll
			and (
				scene.part(entry.motor).Name == "Torso"
				or scene.part(entry.motor).Name == "LowerTorso"
			)
		then
			return entry.motor
		end
	end

	for _, entry in entries do
		if entry.rig == rig then
			return entry.motor
		end
	end

	return entries[1] and entries[1].motor
end

function scene.paths()
	local session = scene.get()
	local paths = table.clone(session.guides or {})
	if session.guide then
		paths[session.guide.motor] = session.guide
	end

	local result = {}
	for motor, guide in paths do
		if session.entries[motor] and motor.Parent and motor.Part1 and motor.Part1.Parent then
			table.insert(result, guide)
		end
	end

	table.sort(result, function(a, b)
		return scene.name(a.motor) < scene.name(b.motor)
	end)
	return result
end

function scene.selectedGuideMotors()
	local chosen, objects = {}, {}
	for item, active in refs.State.Rig and refs.State.Rig._selectedItems or {} do
		if active then
			local motor = item.fetchMotor and item:fetchMotor()
			if motor then
				chosen[motor] = true
			end

			if typeof(item.linkedRigInstance) == "Instance" then
				table.insert(objects, item.linkedRigInstance)
			end
		end
	end

	for _, object in selection:Get() do
		table.insert(objects, object)
	end

	local raw = refs.State.Timeline:GetState()
	for key in raw.SelectedKeyframes or {} do
		chosen[key.Motor] = true
	end

	for key in raw.SelectedChannelKeyframes or {} do
		chosen[key.Motor] = true
	end

	local result = {}
	for _, entry in scene.entries() do
		local include = chosen[entry.motor]
		for _, object in objects do
			if
				object == entry.rig
				or object == entry.motor
				or object == scene.part(entry.motor)
				or scene.part(entry.motor):IsDescendantOf(object)
			then
				include = true
				break
			end
		end

		if include then
			table.insert(result, entry.motor)
		end
	end

	return result
end

function scene.setGuides(motors, points, easing)
	timing.validate(easing)
	require("path").validate({ guide = { points = points, smoothing = 0 } })
	assert(#motors > 0, "select parts for this path first")
	local session = scene.get()
	for _, motor in motors do
		assert(session.entries[motor], "add these parts to Physics first")
	end

	local before = {}
	for _, guide in scene.paths() do
		before[guide.motor] = guide
	end

	local after = table.clone(before)
	local origin = scene.world(scene.part(motors[1])).Position
	for _, motor in motors do
		local shifted = {}
		local offset = scene.world(scene.part(motor)).Position - origin
		for i, point in points do
			shifted[i] = point + offset
		end

		after[motor] = {
			motor = motor,
			points = shifted,
			strength = 35,
			easing = easing and timing.copy(easing),
		}
	end

	local function apply(paths)
		session.guides = table.clone(paths)
		session.guide = select(2, next(paths))
		changed()
	end

	apply(after)
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Set physics paths")
end

function scene.setGuide(motor, points, easing)
	scene.setGuides({ motor }, points, easing)
end

function scene.clearGuide(motor)
	local session = scene.get()
	local before = {}
	for _, guide in scene.paths() do
		before[guide.motor] = guide
	end

	local after = motor and table.clone(before) or {}
	if motor then
		after[motor] = nil
	end

	local function apply(paths)
		session.guides = table.clone(paths)
		session.guide = select(2, next(paths))
		changed()
	end

	apply(after)
	history.record(function()
		apply(before)
	end, function()
		apply(after)
	end, "Clear physics guide")
end

function scene.addForce()
	local session = scene.get()
	assert(#session.forces < 16, "use up to 16 blast forces")
	local motor = scene.guideMotor()
	local camera = workspace.CurrentCamera
	local position = motor and scene.world(scene.part(motor)).Position
		or camera.CFrame.Position + camera.CFrame.LookVector * 10
	local part = Instance.new("Part")

	local number = 1
	local names = {}
	for _, force in session.forces do
		names[force.Name] = true
	end

	while names["Blast " .. number] do
		number += 1
	end

	part.Name = "Blast " .. number
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one
	part.CFrame = CFrame.new(position)
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery = false, false, true
	part.Transparency = 0.35
	part.Color = Color3.fromRGB(242, 171, 196)
	part.Material = Enum.Material.Neon
	part:SetAttribute("EclipsePhysicsForce", true)
	part:SetAttribute(
		"Frame",
		math.floor(
			refs.State.Timeline:GetState().CurrentTime * refs.State.Timeline:GetState().FPS + 0.5
		)
	)
	part:SetAttribute("Radius", 5)
	part:SetAttribute("Power", 60)
	part:SetAttribute("ForceType", "Blast")
	part:SetAttribute("Duration", 60)
	part:SetAttribute("Spin", 1)
	part:SetAttribute("Launch", 0)
	part.Parent = workspace

	local function add()
		part.Parent = workspace
		if not table.find(session.forces, part) then
			table.insert(session.forces, part)
		end

		changed()
	end

	local function remove()
		local at = table.find(session.forces, part)
		if at then
			table.remove(session.forces, at)
		end

		part.Parent = nil
		changed()
	end

	add()
	history.record(remove, add, "Add blast force")
	return part
end

function scene.registerForce(part)
	assert(
		part and part:IsA("BasePart") and part:GetAttribute("EclipsePhysicsForce"),
		"select an Eclipse Blast part first"
	)
	local forces = scene.get().forces
	if not table.find(forces, part) then
		assert(#forces < 16, "use up to 16 blast forces")
		table.insert(forces, part)
		changed()
	end
end

function scene.removeForce(part)
	local session = scene.get()
	local before = table.clone(session.forces)
	local at = table.find(before, part)
	assert(at, "This blast was already removed")
	local after = table.clone(before)
	table.remove(after, at)
	local parent = part.Parent

	local function apply(forces, location)
		session.forces = table.clone(forces)
		part.Parent = location
		changed()
	end

	apply(after, nil)
	history.record(function()
		apply(before, parent)
	end, function()
		apply(after, nil)
	end, "Remove blast")
end

function scene.setForcePath(part, points, easing)
	timing.validate(easing)
	assert(part and table.find(scene.get().forces, part), "Select a force first")
	require("path").validate({ force = { points = points, smoothing = 0 } })
	local offsets = {}
	for _, point in points do
		table.insert(offsets, point - points[1])
	end

	local before = part:GetAttribute("ForcePath")
	local beforeFrame = part.CFrame
	local afterFrame = CFrame.new(points[1]) * beforeFrame.Rotation
	local after = document.pack({ points = offsets, easing = easing and timing.copy(easing) })

	local function apply(value, frame)
		part:SetAttribute("ForcePath", value)
		part.CFrame = frame
		changed()
	end

	apply(after, afterFrame)
	history.record(function()
		apply(before, beforeFrame)
	end, function()
		apply(after, afterFrame)
	end, "Draw force path")
end

function scene.clearForcePath(part)
	local before = part:GetAttribute("ForcePath")

	local function apply(value)
		part:SetAttribute("ForcePath", value)
		changed()
	end

	apply(nil)
	history.record(function()
		apply(before)
	end, function()
		apply(nil)
	end, "Clear force path")
end

function scene.guideChanged(clip)
	local guides = scene.paths()
	local saved = clip.settings.guides or (clip.settings.guide and { clip.settings.guide } or {})
	if #guides ~= #saved then
		return true
	end

	for i, guide in guides do
		local old = saved[i]
		if not timing.equal(guide.easing, old.easing) then
			return true
		end

		local motor = clip.guideMotors and clip.guideMotors[old.index] or clip.guideMotor
		if motor and motor ~= guide.motor or #guide.points ~= #old.points then
			return true
		end

		for j, point in guide.points do
			if point ~= old.points[j] then
				return true
			end
		end
	end

	return false
end

function scene.forcesChanged(clip)
	if not clip then
		return false
	end

	local saved = clip.settings.forces or {}
	local forces = scene.get().forces
	if #saved ~= #forces then
		return true
	end

	for i, part in forces do
		local old = saved[i]
		if
			(part:GetAttribute("ForceType") == "BlackHole" or part:GetAttribute("ForcePath"))
			and (old.duration or 60) ~= (part:GetAttribute("Duration") or 60)
		then
			return true
		end

		if (old.kind or "Blast") ~= (part:GetAttribute("ForceType") or "Blast") then
			return true
		end

		if
			(old.spin or 1) ~= (part:GetAttribute("Spin") or 1)
			or (old.launch or 0) ~= (part:GetAttribute("Launch") or 0)
			or old.pathSource ~= part:GetAttribute("ForcePath")
		then
			return true
		end

		if
			not part.Parent
			or old.position ~= part.Position
			or old.frame ~= part:GetAttribute("Frame")
			or old.radius ~= part:GetAttribute("Radius")
			or old.power ~= part:GetAttribute("Power")
		then
			return true
		end
	end

	return false
end

function scene.snapshot(settings, entries)
	local session = scene.get()
	settings.forces = {}
	for _, part in session.forces do
		assert(part.Parent, "a blast part was removed; remove it from Forces too")
		local pathData = part:GetAttribute("ForcePath")
			and document.unpack(part:GetAttribute("ForcePath"))
		table.insert(settings.forces, {
			easing = pathData and pathData.easing,
			kind = part:GetAttribute("ForceType") or "Blast",
			duration = part:GetAttribute("Duration") or 60,
			spin = part:GetAttribute("Spin") or 1,
			launch = part:GetAttribute("Launch") or 0,
			pathSource = part:GetAttribute("ForcePath"),
			path = pathData and pathData.points,
			position = part.Position,
			frame = part:GetAttribute("Frame"),
			radius = part:GetAttribute("Radius"),
			power = part:GetAttribute("Power"),
		})
	end

	settings.guide = nil
	settings.guides = {}
	for _, guide in scene.paths() do
		local index
		for i, entry in entries do
			if entry.motor == guide.motor then
				index = i
				break
			end
		end

		assert(index, "the guided bone is no longer in this simulation")
		table.insert(settings.guides, {
			index = index,
			points = table.clone(guide.points),
			strength = guide.strength or 35,
			easing = guide.easing and timing.copy(guide.easing),
		})
	end

	return settings
end

function scene.write(save)
	local session = scene.get()
	local old = save:FindFirstChild("EclipsePhysicsSetup")
	if old then
		old:Destroy()
	end

	local folder = Instance.new("Folder")

	folder.Name = "EclipsePhysicsSetup"
	local functionRef = function(name, value)
		local ref = Instance.new("ObjectValue")

		ref.Name, ref.Value, ref.Parent = name, value, folder
		return ref
	end

	for _, entry in scene.entries() do
		local ref = functionRef("Participant", scene.part(entry.motor))
		ref:SetAttribute("Ragdoll", entry.ragdoll)
	end

	for _, part in session.forces do
		if part.Parent then
			functionRef("Force", part)
		end
	end

	for _, guide in scene.paths() do
		local object = functionRef("Guide", scene.part(guide.motor))
		data.write(
			object,
			"Path",
			document.pack({
				points = guide.points,
				strength = guide.strength,
				easing = guide.easing,
			})
		)
	end

	data.write(
		folder,
		"MotionOptions",
		document.pack(require("physicsOptions").copy(session.advanced))
	)
	folder.Parent = save
end

function scene.load(save)
	local session = scene.get()
	session.entries, session.forces, session.guide, session.guides = {}, {}, nil, {}
	session.advanced = {}
	local folder = save and save:FindFirstChild("EclipsePhysicsSetup")
	if not folder then
		return
	end

	local options = folder:FindFirstChild("MotionOptions")
	if options then
		session.advanced = require("physicsOptions").copy(document.unpack(data.read(options)))
	end
	local byPart = {}
	for _, entry in scene.all() do
		byPart[scene.part(entry.motor)] = entry
	end

	for _, ref in folder:GetChildren() do
		if not ref:IsA("ObjectValue") or not ref.Value then
			continue
		end

		if ref.Name == "Participant" then
			local entry = byPart[ref.Value]
			if entry then
				entry.ragdoll = ref:GetAttribute("Ragdoll") == true
				session.entries[entry.motor] = entry
			end
		elseif ref.Name == "Force" and ref.Value.Parent then
			table.insert(session.forces, ref.Value)
		elseif ref.Name == "Guide" and byPart[ref.Value] and ref:FindFirstChild("Path") then
			local guide = document.unpack(data.read(ref.Path))
			require("path").validate({
				guide = { points = guide.points, smoothing = 0, easing = guide.easing },
			})
			guide.motor = byPart[ref.Value].motor
			session.guides[guide.motor] = guide
			session.guide = guide
		elseif ref.Name == "GuidePart" and byPart[ref.Value] and folder:FindFirstChild("Guide") then
			local guide = document.unpack(data.read(folder.Guide))
			require("path").validate({
				guide = { points = guide.points, smoothing = 0, easing = guide.easing },
			})
			guide.motor = byPart[ref.Value].motor
			session.guide = guide
			session.guides[guide.motor] = guide
		end
	end
end

function scene.remapLive(state, mapping)
	local session = sessions[state.Timeline:GetState().Keyframes]
	if not session then
		return
	end

	local entries, guides = {}, {}
	for motor, entry in session.entries do
		local copy = table.clone(entry)
		copy.motor = mapping[motor] or motor
		copy.rig = mapping[entry.rig] or entry.rig
		entries[copy.motor] = copy
	end

	for motor, guide in session.guides or {} do
		local copy = table.clone(guide)
		copy.motor = mapping[motor] or motor
		guides[copy.motor] = copy
	end

	if session.guide then
		local copy = table.clone(session.guide)
		copy.motor = mapping[copy.motor] or copy.motor
		session.guide = copy
	end

	session.entries, session.guides = entries, guides
	for i, force in session.forces do
		session.forces[i] = mapping[force] or force
	end
end

function scene.liveSnapshot(state, motorIds, rigIds)
	local session = sessions[state.Timeline:GetState().Keyframes]
	local value = { participants = {}, guides = {}, forces = {} }
	if not session then
		return value
	end

	value.advanced = require("physicsOptions").copy(session.advanced)
	for motor, entry in session.entries do
		local id = motorIds[motor]
		if id then
			value.participants[id] = { rig = rigIds[entry.rig], ragdoll = entry.ragdoll == true }
		end
	end

	for motor, guide in session.guides or {} do
		local id = motorIds[motor]
		if id then
			local copy = table.clone(guide)
			copy.motor = nil
			value.guides[id] = copy
		end
	end

	for _, force in session.forces do
		local path = force.Parent and require("paths").of(force, game)
		if path then
			table.insert(value.forces, path)
		end
	end

	return value
end

function scene.prepareLive(state, value, motors, rigs)
	local entries, guides, forces = {}, {}, {}
	for id, saved in value.participants or {} do
		local motor = motors[id]
		if not motor or not rigs[saved.rig] then
			continue
		end

		entries[motor] = {
			motor = motor,
			rig = assert(rigs[saved.rig], "Waiting for shared physics rig"),
			ragdoll = saved.ragdoll == true,
		}
	end

	for id, saved in value.guides or {} do
		local motor = motors[id]
		if not motor then
			continue
		end

		require("path").validate({
			guide = { points = saved.points, smoothing = 0, easing = saved.easing },
		})
		local guide = table.clone(saved)
		guide.motor = motor
		guides[motor] = guide
	end

	for _, path in value.forces or {} do
		local force = require("paths").resolve(game, path)
		assert(force and force:IsA("BasePart"), "Waiting for shared physics force")
		table.insert(forces, force)
	end

	return function()
		local raw = state.Timeline:GetState()
		sessions[raw.Keyframes] = {
			entries = entries,
			guides = guides,
			guide = nil,
			forces = forces,
			advanced = require("physicsOptions").copy(value.advanced),
		}
	end
end

function scene.init(options)
	refs = options
end

return scene
