						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local idValue = "Emit"
local limit = 100000
local emitKeys = {}

emitKeys.ID = idValue
emitKeys.LIMIT = limit

function emitKeys.supports(rig, id)
	return id == idValue and typeof(rig) == "Instance" and rig:IsA("ParticleEmitter")
end

function emitKeys.count(value)
	value = tonumber(value)
	if not value or value ~= value then
		return 0
	end

	return math.clamp(math.floor(value + 1e-6), 0, limit)
end

function emitKeys.default(rig)
	local count = tonumber(rig:GetAttribute("EmitCount"))
	return count and count == count and emitKeys.count(count) or 1
end

function emitKeys.events(raw)
	local properties = require("properties")
	local result = {}
	for motor, keys in raw.Keyframes do
		if properties.is(motor) and emitKeys.supports(motor.Rig, motor.PropertyId)
			and motor.Rig.Parent and motor.Part1.Parent
			and motor.Part1:GetAttribute("Enabled") ~= false
			and not motor:GetAttribute("EclipseDisabled")
			and require("organization").isEnabled(motor.Rig)
		then
			for frame, key in keys do
				if key.Disabled then continue end
				table.insert(result, {
					emitter = motor.Rig,
					start = key.Time or frame / raw.FPS,
					duration = 0,
					count = emitKeys.count(properties.decode(motor, key.C0, key.PropertyValue)),
				})
			end
		end
	end
	table.sort(result, function(a, b)
		if a.emitter ~= b.emitter then return a.emitter:GetFullName() < b.emitter:GetFullName() end
		return a.start < b.start
	end)
	return result
end

function emitKeys.export(raw, ids, code)
	local rows, muted = {}, {}
	for _, event in emitKeys.events(raw) do
		local id = assert(ids[event.emitter], "Emit property target is not exported: " .. event.emitter:GetFullName())
		local function add(suffix, frame, source)
			table.insert(rows, {
				Id = "EmitProperty:" .. id .. ":" .. suffix,
				Rig = id,
				Frame = frame,
				Speed = 1,
				Data = { Duration = 0, Parameter = "", Sounds = {} },
				Markers = {},
				Begin = code(source, event.emitter.Name .. " Emit"),
			})
		end
		if not muted[id] then
			muted[id] = true
			add("Mute", 0, "rig.Enabled = false")
		end
		if event.count > 0 then
			local frame = event.start * raw.FPS
			add(tostring(frame), frame, "rig:Emit(" .. tostring(event.count) .. ")")
		end
	end
	return rows
end

return emitKeys
