							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local httpService = game:GetService("HttpService")

local meshFlipbook = {}
meshFlipbook.__index = meshFlipbook

meshFlipbook.attribute = "ArcFlipbook"
meshFlipbook.assetPrefix = "rbxassetid://"
meshFlipbook.sources = { "Sheet", "Frames" }
meshFlipbook.loops = { "Once", "Loop", "PingPong" }
meshFlipbook.idles = { "Hide", "First", "Last" }
meshFlipbook.ownedProperties = { Texture = true, UVOffset = true, UVScale = true }
meshFlipbook.maximumGrid = 32
meshFlipbook.maximumFrames = 1024
meshFlipbook.minimumFps = 0.1
meshFlipbook.maximumFps = 240
meshFlipbook.minimumIdLength = 4
meshFlipbook.stepEpsilon = 1e-6
meshFlipbook.cache = setmetatable({}, { __mode = "k" })

meshFlipbook.defaults = {
	source = "Sheet",
	image = "",
	columns = 4,
	rows = 4,
	count = 16,
	fps = 24,
	loop = "Once",
	idle = "Hide",
	reverse = false,
}

function meshFlipbook.pick(list: { string }, value: any, fallback: string): string
	return if table.find(list, value) then value else fallback
end

function meshFlipbook.clampInteger(value: any, fallback: number, minimum: number, maximum: number): number
	local number = if typeof(value) == "number" and value == value then value else fallback

	return math.clamp(math.round(number), minimum, maximum)
end

function meshFlipbook.clampNumber(value: any, fallback: number, minimum: number, maximum: number): number
	local number = if typeof(value) == "number" and value == value then value else fallback

	return math.clamp(number, minimum, maximum)
end

function meshFlipbook.toId(value: any): string?
	if typeof(value) == "number" then
		return if value > 0 then string.format("%d", value) else nil
	end

	if typeof(value) ~= "string" then
		return nil
	end

	local digits = string.match(value, "%d+")

	return if digits and #digits >= meshFlipbook.minimumIdLength then digits else nil
end

function meshFlipbook.parseIds(text: string): { string }
	local ids = {}

	for digits in string.gmatch(text, "%d+") do
		if #digits >= meshFlipbook.minimumIdLength and #ids < meshFlipbook.maximumFrames then
			table.insert(ids, digits)
		end
	end

	return ids
end

function meshFlipbook.toContent(id: string): string
	return meshFlipbook.assetPrefix .. id
end

function meshFlipbook.normalize(data: any)
	local defaults = meshFlipbook.defaults
	local source = if typeof(data) == "table" then data else {}
	local ids = {}

	if typeof(source.ids) == "table" then
		for _, value in source.ids do
			local id = meshFlipbook.toId(value)

			if id and #ids < meshFlipbook.maximumFrames then
				table.insert(ids, id)
			end
		end
	end

	local columns = meshFlipbook.clampInteger(source.columns, defaults.columns, 1, meshFlipbook.maximumGrid)
	local rows = meshFlipbook.clampInteger(source.rows, defaults.rows, 1, meshFlipbook.maximumGrid)

	return {
		source = meshFlipbook.pick(meshFlipbook.sources, source.source, defaults.source),
		image = if typeof(source.image) == "string" then source.image else defaults.image,
		columns = columns,
		rows = rows,
		count = meshFlipbook.clampInteger(source.count, columns * rows, 1, columns * rows),
		ids = ids,
		fps = meshFlipbook.clampNumber(source.fps, defaults.fps, meshFlipbook.minimumFps, meshFlipbook.maximumFps),
		loop = meshFlipbook.pick(meshFlipbook.loops, source.loop, defaults.loop),
		idle = meshFlipbook.pick(meshFlipbook.idles, source.idle, defaults.idle),
		reverse = source.reverse == true,
	}
end

function meshFlipbook.copy(config)
	local copy = table.clone(config)

	copy.ids = table.clone(config.ids)

	return copy
end

function meshFlipbook.isHost(instance: any): boolean
	return typeof(instance) == "Instance" and instance:IsA("Decal")
end

function meshFlipbook.has(instance: any): boolean
	return meshFlipbook.isHost(instance) and typeof(instance:GetAttribute(meshFlipbook.attribute)) == "string"
end

function meshFlipbook.owns(instance: Instance, name: string): boolean
	return meshFlipbook.ownedProperties[name] == true and meshFlipbook.has(instance)
end

function meshFlipbook.read(instance: Instance)
	if not meshFlipbook.isHost(instance) then
		return nil
	end

	local raw = instance:GetAttribute(meshFlipbook.attribute)

	if typeof(raw) ~= "string" then
		return nil
	end

	local cached = meshFlipbook.cache[instance]

	if cached and cached.raw == raw then
		return cached.config
	end

	local success, data = pcall(function()
		return httpService:JSONDecode(raw)
	end)

	local config = meshFlipbook.normalize(if success then data else nil)

	meshFlipbook.cache[instance] = { raw = raw, config = config }

	return config
end

function meshFlipbook.write(instance: Instance, config)
	instance:SetAttribute(meshFlipbook.attribute, httpService:JSONEncode(meshFlipbook.normalize(config)))
end

function meshFlipbook.clear(instance: Instance)
	instance:SetAttribute(meshFlipbook.attribute, nil)
	meshFlipbook.cache[instance] = nil
end

function meshFlipbook.getHosts(source: any): { Instance }
	local hosts = {}

	if typeof(source) ~= "Instance" then
		return hosts
	end

	if meshFlipbook.has(source) then
		table.insert(hosts, source)
	elseif source:IsA("BasePart") then
		for _, child in source:GetChildren() do
			if meshFlipbook.has(child) then
				table.insert(hosts, child)
			end
		end
	end

	return hosts
end

function meshFlipbook.isPlayable(source: any): boolean
	if typeof(source) ~= "Instance" then
		return false
	end

	if meshFlipbook.has(source) then
		return true
	end

	if source:IsA("BasePart") then
		for _, child in source:GetChildren() do
			if meshFlipbook.has(child) then
				return true
			end
		end
	end

	return false
end

function meshFlipbook.getFrameCount(config): number
	if config.source == "Frames" then
		return #config.ids
	end

	return if config.image ~= "" then config.count else 0
end

function meshFlipbook.getSteps(config): number
	local count = meshFlipbook.getFrameCount(config)

	if config.loop == "PingPong" and count > 1 then
		return count * 2 - 2
	end

	return count
end

function meshFlipbook.getPlayLength(config, stretch: number?): number
	if stretch and stretch > 0 then
		return stretch
	end

	return meshFlipbook.getSteps(config) / config.fps
end

function meshFlipbook.resolvePlays(config, plays: number?): number
	local count = if typeof(plays) == "number" then math.round(plays) else 1

	if config.loop == "Once" then
		return math.max(count, 1)
	end

	return math.max(count, 0)
end

function meshFlipbook.getTotalLength(config, plays: number?, stretch: number?): number?
	local count = meshFlipbook.resolvePlays(config, plays)

	if count <= 0 then
		return nil
	end

	return count * meshFlipbook.getPlayLength(config, stretch)
end

function meshFlipbook.getDefaultPlays(config): number
	return if config.loop == "Once" then 1 else 0
end

function meshFlipbook.getFrameAtStep(config, step: number): number?
	local count = meshFlipbook.getFrameCount(config)

	if count <= 0 then
		return nil
	end

	local index = step + 1

	if step >= count then
		index = count * 2 - 1 - step
	end

	index = math.clamp(index, 1, count)

	return if config.reverse then count + 1 - index else index
end

function meshFlipbook.getPosterIndex(config): number?
	return meshFlipbook.getFrameAtStep(config, 0)
end

function meshFlipbook.getIdleIndex(config): number?
	if config.idle == "First" then
		return meshFlipbook.getFrameAtStep(config, 0)
	elseif config.idle == "Last" then
		local count = meshFlipbook.getFrameCount(config)

		return if config.loop == "PingPong" then meshFlipbook.getFrameAtStep(config, 0) else meshFlipbook.getFrameAtStep(config, count - 1)
	end

	return nil
end

function meshFlipbook.getIndexAt(config, age: number, plays: number?, stretch: number?): number?
	local steps = meshFlipbook.getSteps(config)

	if steps <= 0 then
		return nil
	end

	if age < 0 then
		return meshFlipbook.getIdleIndex(config)
	end

	local length = math.max(meshFlipbook.getPlayLength(config, stretch), meshFlipbook.stepEpsilon)
	local total = meshFlipbook.getTotalLength(config, plays, stretch)

	if total and age >= total then
		return meshFlipbook.getIdleIndex(config)
	end

	local step = math.floor(age / length * steps + meshFlipbook.stepEpsilon) % steps

	return meshFlipbook.getFrameAtStep(config, step)
end

function meshFlipbook.getImages(config): { string }
	local images = {}

	if config.source == "Frames" then
		for _, id in config.ids do
			table.insert(images, meshFlipbook.toContent(id))
		end
	elseif config.image ~= "" then
		table.insert(images, config.image)
	end

	return images
end

function meshFlipbook.getFrameState(config, index: number?): (string, Vector2, Vector2)
	if not index then
		return "", Vector2.one, Vector2.zero
	end

	if config.source == "Frames" then
		local id = config.ids[index]

		return if id then meshFlipbook.toContent(id) else "", Vector2.one, Vector2.zero
	end

	local column = (index - 1) % config.columns
	local row = math.floor((index - 1) / config.columns)

	return config.image, Vector2.new(1 / config.columns, 1 / config.rows), Vector2.new(column / config.columns, row / config.rows)
end

function meshFlipbook.apply(instance: Instance, config, index: number?)
	local decal = instance :: Decal
	local texture, scale, offset = meshFlipbook.getFrameState(config, index)

	if decal.UVScale ~= scale then
		decal.UVScale = scale
	end

	if decal.UVOffset ~= offset then
		decal.UVOffset = offset
	end

	if decal.Texture ~= texture then
		decal.Texture = texture
	end
end

function meshFlipbook.applyRest(instance: Instance)
	local config = meshFlipbook.read(instance)
	local index = if config then meshFlipbook.getPosterIndex(config) else nil

	if index then
		meshFlipbook.apply(instance, config, index)
	end
end

return meshFlipbook
]]></ProtectedString>
