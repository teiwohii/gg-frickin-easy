				table.insert(badKeys, record)

				continue

			end



			explicitVersions[key] = key.QuaternionInterpolationVersion ~= nil

			require("target").retargetKey(key, rig, sequence)

			key._EclipseRawStored = true

			key.Frame, key.Time = record.frame, record.frame / state.FPS

			key.Motor, key.Part, key.SanitizeName = motor, part, sanitize

