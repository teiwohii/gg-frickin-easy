						<ProtectedString name="Source"><![CDATA[--!native
-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local rigTraversal = require("rigTraversal")
local cameraRig = require("cameraRig")
local properties = require("properties")
local blenderCurve = require("blenderCurve")
local keyframePolicy = require("policy")
local armatureRuntime = require("armatureRuntime")
local armatureAnimation = require("armatureAnimation")
local userInputService = require("userInputService")
local runService = game:GetService("RunService")
local motion = require("motion")

local stateModule = require("rawState")
local interp = require("interp")
local pivotSpace = require("pivotSpace")
local graphCurves = require("graphCurves")
local boneMotor = require("boneMotor")
local parenting = require("parenting")
local limbIk = require("limbIk")
local EventDependencies = require("EventDependencies")
local poseCache = require("poseCache")

local modules = {}

local function module(name)
	local loaded = modules[name]
	if not loaded then
		loaded = require(name)
		modules[name] = loaded
	end

	return loaded
end

local timelineState = stateModule.Timeline
local timelineConfig = stateModule.Config
local playheadDrag = stateModule.PlayheadDrag
local keyframeDrag = stateModule.KeyframeDrag
local selectionState = stateModule.Selection
local keyframeDefaultColor = stateModule.Colors.KEYFRAME_DEFAULT_COLOR
local keyframeHoverColor = stateModule.Colors.KEYFRAME_HOVER_COLOR
local keyframeSelectedColor = stateModule.Colors.KEYFRAME_SELECTED_COLOR
local loopActiveColor = stateModule.Colors.LOOP_ACTIVE_COLOR
local loopInactiveColor = stateModule.Colors.LOOP_INACTIVE_COLOR

local channelIds = {
	"loc_x",
	"loc_y",
	"loc_z",
	"qrot_w",
	"qrot_x",
	"qrot_y",
	"qrot_z",
	"scale_x",
	"scale_y",
	"scale_z",
}
local cframeIds = { "loc_x", "loc_y", "loc_z", "qrot_w", "qrot_x", "qrot_y", "qrot_z" }
local locIds = { "loc_x", "loc_y", "loc_z" }
local axes = { "x", "y", "z" }
local qrotIds = { "qrot_w", "qrot_x", "qrot_y", "qrot_z" }
local scaleIds = { "scale_x", "scale_y", "scale_z" }

local scratchPrevFrame = {}
local scratchPrevValue = {}
local scratchPrevTime = {}
local scratchNextFrame = {}
local scratchNextValue = {}
local scratchNextTime = {}
local scratchValues = {}
local scratchDisabled = {}

local defaultDecomposedCache = setmetatable({}, { __mode = "k" })

local motorListCache = setmetatable({}, { __mode = "k" })
local posePlans = setmetatable({}, { __mode = "k" })
local emptyMotors = {}

local function releaseMotorCache(entry)
	if entry.released then
		return
	end

	entry.released = true
	for _, connection in ipairs(entry.connections) do
		connection:Disconnect()
	end

	for _, connections in pairs(entry.joints) do
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
	end

	table.clear(entry.connections)
	table.clear(entry.joints)
	entry.list = nil
end

local function getCachedMotorList(rig)
	if properties.propertyOnly(rig) then
		return emptyMotors
	end

	local entry = motorListCache[rig]
	if not entry then
		entry = { connections = {}, joints = {} }
		motorListCache[rig] = entry

		local function watch(item)
			if entry.released then
				return
			end

			if item:IsA("Motor6D") then
				entry.list = nil
				if entry.joints[item] then
					return
				end

				local function changed()
					entry.list = nil
				end

				entry.joints[item] = {
					item:GetPropertyChangedSignal("Part0"):Connect(changed),
					item:GetPropertyChangedSignal("Part1"):Connect(changed),
				}
			elseif item:IsA("Bone") then
				entry.list = nil
			end
		end

		table.insert(entry.connections, rig.DescendantAdded:Connect(watch))
		table.insert(
			entry.connections,
			rig.DescendantRemoving:Connect(function(item)
				if entry.released then
					return
				end

				if item:IsA("Motor6D") or item:IsA("Bone") then
					entry.list = nil
				end

				local connections = entry.joints[item]
				if connections then
					for _, connection in ipairs(connections) do
						connection:Disconnect()
					end

					entry.joints[item] = nil
				end
			end)
		)
		table.insert(
			entry.connections,
			rig.Destroying:Connect(function()
				releaseMotorCache(entry)
				if motorListCache[rig] == entry then
					motorListCache[rig] = nil
				end
			end)
		)
		for _, item in ipairs(rigTraversal.rigDescendants(rig)) do
			watch(item)
		end
	end

	local master = require("masterControl").get(rig)
	if entry.master ~= master then
		entry.master = master
		entry.list = nil
	end
	if not entry.list then
		entry.list = parenting.collectMotors(rig)
	end

	return entry.list
end

local function invalidateMotorListCache()
	for _, entry in pairs(motorListCache) do
		releaseMotorCache(entry)
	end

	table.clear(motorListCache)
	table.clear(posePlans)
end

local function getDefaultDecomposed(motor, timeline, evaluationState)
	local timelineState = evaluationState or timelineState
	local defaultC0 = timelineState.DefaultPose[motor] or motor.C0 or CFrame.new()
	local cached = defaultDecomposedCache[motor]
	if cached and cached._cf == defaultC0 then
		return cached, defaultC0
	end

	cached = timeline:DecomposeC0(defaultC0)
	cached._cf = defaultC0
	defaultDecomposedCache[motor] = cached
	return cached, defaultC0
end

return function(Timeline)
	function Timeline:IsDraggingPlayhead()
		return playheadDrag.draggingPlayhead
	end

	function Timeline:SetDraggingPlayhead(state)
		playheadDrag.draggingPlayhead = state and true or false
		if not state then
			playheadDrag.playheadMouseOffsetX = 0
		end
	end

	local snapPixelThreshold = 8

	function Timeline:SnapXToNearestKeyframe(x)
		local frames = self:GetAllKeyframeFrames()
		if #frames == 0 then
			return x
		end

		local bestX = nil
		local bestDist = math.huge
		for _, frame in ipairs(frames) do
			local frameX = self:FrameToVisibleX(frame)
			local dist = math.abs(frameX - x)
			if dist < bestDist and dist <= snapPixelThreshold then
				bestDist = dist
				bestX = frameX
			end
		end

		return bestX or x
	end

	function Timeline:GetClickReferenceX()
		local sc = self.refs.SelectorContainer
		if not sc then
			local visibleFrame = self:GetVisibleTimelineFrame()
			return visibleFrame and visibleFrame.AbsolutePosition.X or 0
		end

		local padding = 0
		local p = sc:FindFirstChildOfClass("UIPadding")
		if p then
			padding = p.PaddingLeft.Offset
		end

		return (self.refs.Scale or sc).AbsolutePosition.X + padding * motion.scale(sc)
	end

	function Timeline:SeekToTime(time, currentRigGetter)
		if self:IsExportLocked() then
			return
		end
		assert(type(time) == "number" and time == time and math.abs(time) < math.huge, "Time must be finite")
		local frame = math.clamp(self:TimeToFrame(time), 0, self:GetMaxFrame())
		time = self:FrameToTime(frame)
		local state = module("state")
		local axis = state.Axis
		if state.Timeline == self and (
			axis and (axis:IsHoldingAxis() or axis:IsBlenderGrabMode() or axis:IsBlenderRotateMode())
			or state.PropertyGizmo and state.PropertyGizmo.isEditing()
			or state.CameraPreview and state.CameraPreview.isViewRotating()
		) then
			module("project").finalizeCurrentManipulation()
		end
		if timelineState.CurrentTime == time then
			return
		end

		timelineState.CurrentTime = time
		local rig = currentRigGetter and currentRigGetter() or nil
		if rig then
			self:ApplyPoseAtTime(rig, timelineState.CurrentTime)
		end

		self:UpdatePlayhead()
		if not timelineState.Playing then
			require("eventPlayback").scrub(self, time)
		end
	end

	function Timeline:JumpPlayheadToVisibleX(x, currentRigGetter)
		local width = self:GetVisibleTimelineWidth()
		local clampedX = math.clamp(x, 0, width)
		self:SeekToTime(self:FrameToTime(self:VisibleXToFrame(clampedX)), currentRigGetter)
	end

	function Timeline:StepPlayheadDrag(dt, point, currentRigGetter)
		if not playheadDrag.draggingPlayhead then
			return
		end

		if self:IsExportLocked() or not userInputService.isPointerHeld() then
			self:SetDraggingPlayhead(false)
			return
		end

		local viewport = self.refs.TimelineContainer
		if not viewport then
			return
		end

		local factor = motion.scale(viewport)
		local left = viewport.AbsolutePosition.X + 20 * factor
		local right =
			math.max(left, viewport.AbsolutePosition.X + viewport.AbsoluteSize.X - 20 * factor)
		local band = math.min(18 * factor, (right - left) / 2)
		local speed = 0
		if band > 0 then
			if point.X < left + band then
				speed = -math.clamp((left + band - point.X) / band, 0, 3) * 420
			elseif point.X > right - band then
				speed = math.clamp((point.X - right + band) / band, 0, 3) * 420
			end
		end

		local previous = timelineState.ScrollOffset
		local x = (math.clamp(point.X, left, right) - self:GetClickReferenceX()) / factor
		if speed ~= 0 then
			self:SetTimelineScroll(previous + speed * math.clamp(dt or 0, 0, 0.05))
		end

		self:JumpPlayheadToVisibleX(x + timelineState.ScrollOffset - previous, currentRigGetter)
	end

	function Timeline:BindPlayhead(currentRigGetter)
		if self.refs._TimelinePlayheadBound then
			return
		end

		self.refs._TimelinePlayheadBound = true

		local dragButton = self.refs.TopSelectorDragHitbox
		if not dragButton then
			return
		end

		dragButton.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end

			userInputService.trackGuiPress(input, dragButton)
			if self:IsExportLocked() then
				return
			end

			playheadDrag.draggingPlayhead = true
			timelineState.Playing = false

			self:StepPlayheadDrag(0, userInputService:GetMouseLocation(), currentRigGetter)
			playheadDrag.playheadMouseOffsetX = 0
		end)

		local inputConnection = userInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				playheadDrag.draggingPlayhead = false
				playheadDrag.playheadMouseOffsetX = 0
			end
		end)

		local function finishDrag()
			playheadDrag.draggingPlayhead = false
			playheadDrag.playheadMouseOffsetX = 0
		end

		local focusConnection = userInputService.WindowFocusReleased:Connect(finishDrag)
		local renderConnection = runService.RenderStepped:Connect(function(dt)
			self:StepPlayheadDrag(dt, userInputService:GetMouseLocation(), currentRigGetter)
		end)
		dragButton.Destroying:Once(function()
			invalidateMotorListCache()
			inputConnection:Disconnect()
			renderConnection:Disconnect()
			focusConnection:Disconnect()
			finishDrag()
		end)
	end

	function Timeline:UpdatePlayhead()
		local selector = self.refs.Selector
		local topSelector = self.refs.TopSelector
		local label = self.refs.TopSelectorLabel
		local fpsLabel = self.refs.FPSLabel
		local timeLabel = self.refs.TimeLabel

		if not selector or not topSelector then
			return
		end

		local frame = self:TimeToFrame(timelineState.CurrentTime)
		self:PositionPlayhead()

		if label then
			label.Text = tostring(frame)
		end

		if fpsLabel and not (fpsLabel:IsA("TextBox") and fpsLabel:IsFocused()) then
			fpsLabel.Text = tostring(timelineState.FPS) .. " FPS"
		end

		if timeLabel then
			local milliseconds = math.floor(math.max(0, timelineState.CurrentTime) * 1000 + 0.5)
			local minutes = math.floor(milliseconds / 60000)
			local seconds = math.floor(milliseconds / 1000) % 60
			timeLabel.Text = string.format("%02d:%02d.%03d", minutes, seconds, milliseconds % 1000)
		end
	end

	function Timeline:InvalidateMotorListCache()
		invalidateMotorListCache()
	end

	local function indexedChannels(self, bucket, time, ids, populate, hasDisabled)
		local cache = poseCache.poseCache()
		if not cache or not cache.persistent then
			return nil
		end

		local ordered = interp.index(bucket)
		if not ordered then
			return nil
		end

		cache.legacyChannels = cache.legacyChannels or setmetatable({}, { __mode = "k" })
		local entry = cache.legacyChannels[bucket]
		if not entry or populate and not entry.populated then
			entry = { populated = populate, channels = {} }
			for _, row in ordered do
				if populate then
					self:EnsureChannelsPopulated(row.key)
				end

				for id, channel in row.key.Channels or {} do
					if channel.Value ~= nil then
						local index = entry.channels[id]
						if not index then
							index = {}
							entry.channels[id] = index
						end

						table.insert(index, row)
					end
				end
			end

			cache.legacyChannels[bucket] = entry
		end

		local any = false
		for _, id in ids do
			local index = entry.channels[id]
			if not index or #index == 0 or hasDisabled and scratchDisabled[id] then
				continue
			end

			any = true
			local p, n = interp.search(index, time)
			local previous, following = index[p], index[n]
			if previous then
				scratchPrevFrame[id] = previous.frame
				scratchPrevTime[id] = previous.time
				scratchPrevValue[id] = previous.key.Channels[id].Value
			end

			if following then
				scratchNextFrame[id] = following.frame
				scratchNextTime[id] = following.time
				scratchNextValue[id] = following.key.Channels[id].Value
			end
		end

		return any
	end

	local function evaluateLegacyMotorC0(self, motor, time, loopEndTime, bucket, evaluationState)
		local timelineState = evaluationState or timelineState

		if not bucket or not next(bucket) then
			return timelineState.DefaultPose[motor] or motor.C0, false
		end

		local defaultDecomposed, defaultC0 = getDefaultDecomposed(motor, self, timelineState)

		local hasDisabled = false
		if motor:GetAttribute("EclipseChannelDisabledAny") then
			hasDisabled = true
			table.clear(scratchDisabled)
			for _, chId in ipairs(channelIds) do
				if motor:GetAttribute("EclipseChannelDisabled_" .. chId) then
					scratchDisabled[chId] = true
				end
			end
		end

		if not hasDisabled then
			local uniformFlag = timelineState._motorUniform[motor]
			if uniformFlag == nil then
				uniformFlag = true
				for _, keyData in pairs(bucket) do
					 
					 
					if
						keyData.Channels == nil
						and typeof(keyData.C0) == "CFrame"
						and not keyData.GraphOnly
						and not keyData.WholePoseScale
						and not properties.is(keyData.Motor)
					then
						continue
					end
					self:EnsureChannelsPopulated(keyData)
					local channels = keyData.Channels
					if not channels then
						uniformFlag = false
						break
					end

					for _, chId in ipairs(cframeIds) do
						local ch = channels[chId]
						if not ch or ch.Value == nil or ch.Easing then
							uniformFlag = false
							break
						end
					end

					if not uniformFlag then
						break
					end
				end

				timelineState._motorUniform[motor] = uniformFlag
			end

			if uniformFlag then
				local prevFrame, nextFrame = nil, nil
				local index = interp.index(bucket)
				if index then
					local p, n = interp.search(index, time)
					prevFrame = index[p] and index[p].frame
					nextFrame = index[n] and index[n].frame
				else
					for kfFrame, keyData in pairs(bucket) do
						if keyData.Time <= time and (not prevFrame or kfFrame > prevFrame) then
							prevFrame = kfFrame
						end

						if keyData.Time >= time and (not nextFrame or kfFrame < nextFrame) then
							nextFrame = kfFrame
						end
					end
				end

				if prevFrame and not nextFrame then
					return bucket[prevFrame].C0 or defaultC0, true
				end

				if nextFrame and not prevFrame then
					return bucket[nextFrame].C0 or defaultC0, true
				end

				if prevFrame == nextFrame and prevFrame then
					return bucket[prevFrame].C0 or defaultC0, true
				end

				if prevFrame and nextFrame then
					local prevKd = bucket[prevFrame]
					local nextKd = bucket[nextFrame]
					if prevKd.C0 and nextKd.C0 then
						local rawAlpha = 0
						if nextKd.Time and prevKd.Time and nextKd.Time > prevKd.Time then
							rawAlpha =
								math.clamp((time - prevKd.Time) / (nextKd.Time - prevKd.Time), 0, 1)
						end

						local smoothed =
							interp.cframe(bucket, prevKd, nextKd, rawAlpha, "C0", loopEndTime)
						if smoothed then
							return smoothed, true
						end
					end
				end
			end
		end

		table.clear(scratchPrevFrame)
		table.clear(scratchPrevValue)
		table.clear(scratchPrevTime)
		table.clear(scratchNextFrame)
		table.clear(scratchNextValue)
		table.clear(scratchNextTime)
		local anyKeyframed = false

		local indexed = indexedChannels(self, bucket, time, channelIds, true, hasDisabled)
		if indexed ~= nil then
			anyKeyframed = indexed
		else
			for kfFrame, keyData in pairs(bucket) do
				self:EnsureChannelsPopulated(keyData)
				local channels = keyData.Channels
				if channels then
					local kfTime = keyData.Time
					local isPrev = keyData.Time <= time
					local isNext = keyData.Time >= time
					for _, chId in ipairs(channelIds) do
						if not (hasDisabled and scratchDisabled[chId]) then
							local ch = channels[chId]
							if ch and ch.Value ~= nil then
								anyKeyframed = true
								if isPrev then
									local existing = scratchPrevFrame[chId]
									if not existing or kfFrame > existing then
										scratchPrevFrame[chId] = kfFrame
										scratchPrevValue[chId] = ch.Value
										scratchPrevTime[chId] = kfTime
									end
								end

								if isNext then
									local existing = scratchNextFrame[chId]
									if not existing or kfFrame < existing then
										scratchNextFrame[chId] = kfFrame
										scratchNextValue[chId] = ch.Value
										scratchNextTime[chId] = kfTime
									end
								end
							end
						end
					end
				end
			end
		end

		if not anyKeyframed then
			return defaultC0, false
		end

		local cframeShared = true
		local sharedCFramePrev, sharedCFrameNext
		for _, cid in ipairs(cframeIds) do
			if hasDisabled and scratchDisabled[cid] then
				cframeShared = false
				break
			end

			local pFrame = scratchPrevFrame[cid]
			local nFrame = scratchNextFrame[cid]
			if
				pFrame and bucket[pFrame].Channels[cid].Easing
				or nFrame and bucket[nFrame].Channels[cid].Easing
			then
				cframeShared = false
				break
			end

			if not pFrame or not nFrame then
				cframeShared = false
				break
			end

			if sharedCFramePrev == nil then
				sharedCFramePrev = pFrame
				sharedCFrameNext = nFrame
			elseif pFrame ~= sharedCFramePrev or nFrame ~= sharedCFrameNext then
				cframeShared = false
				break
			end
		end

		if cframeShared and sharedCFramePrev then
			local prevKeyData = bucket[sharedCFramePrev]
			local nextKeyData = bucket[sharedCFrameNext]
			if
				prevKeyData
				and nextKeyData
				and prevKeyData.C0
				and nextKeyData.C0
				and not interp.usesAutomaticBezier(prevKeyData, nextKeyData)
			then
				local rawAlpha = 0
				if
					sharedCFramePrev ~= sharedCFrameNext
					and nextKeyData.Time
					and prevKeyData.Time
					and nextKeyData.Time > prevKeyData.Time
				then
					rawAlpha = math.clamp(
						(time - prevKeyData.Time) / (nextKeyData.Time - prevKeyData.Time),
						0,
						1
					)
				end

				local smoothed =
					interp.cframe(bucket, prevKeyData, nextKeyData, rawAlpha, "C0", loopEndTime)
				if smoothed then
					return smoothed, true
				end
			end
		end

		local qrotShared = true
		local sharedPrevFrame, sharedNextFrame
		for _, qid in ipairs(qrotIds) do
			if hasDisabled and scratchDisabled[qid] then
				qrotShared = false
				break
			end

			local pFrame = scratchPrevFrame[qid]
			local nFrame = scratchNextFrame[qid]
			if not pFrame or not nFrame then
				qrotShared = false
				break
			end

			if sharedPrevFrame == nil then
				sharedPrevFrame = pFrame
				sharedNextFrame = nFrame
			elseif pFrame ~= sharedPrevFrame or nFrame ~= sharedNextFrame then
				qrotShared = false
				break
			end
		end

		if qrotShared then
			local dot = scratchPrevValue.qrot_w * scratchNextValue.qrot_w
				+ scratchPrevValue.qrot_x * scratchNextValue.qrot_x
				+ scratchPrevValue.qrot_y * scratchNextValue.qrot_y
				+ scratchPrevValue.qrot_z * scratchNextValue.qrot_z
			if dot < 0 then
				scratchNextValue.qrot_w = -scratchNextValue.qrot_w
				scratchNextValue.qrot_x = -scratchNextValue.qrot_x
				scratchNextValue.qrot_y = -scratchNextValue.qrot_y
				scratchNextValue.qrot_z = -scratchNextValue.qrot_z
			end
		end

		table.clear(scratchValues)
		for _, chId in ipairs(channelIds) do
			local pFrame = scratchPrevFrame[chId]
			local nFrame = scratchNextFrame[chId]
			local pTime = scratchPrevTime[chId]
			local nTime = scratchNextTime[chId]
			local pValue = scratchPrevValue[chId]
			local nValue = scratchNextValue[chId]
			if pFrame and nFrame and pFrame ~= nFrame and nTime > pTime then
				local alpha = math.clamp((time - pTime) / (nTime - pTime), 0, 1)
				local prevKeyData = bucket[pFrame]
				scratchValues[chId] = interp.channel(
					bucket,
					prevKeyData,
					bucket[nFrame],
					alpha,
					chId,
					pValue,
					nValue,
					loopEndTime
				)
			elseif pFrame then
				scratchValues[chId] = pValue
			elseif nFrame then
				scratchValues[chId] = nValue
			else
				scratchValues[chId] = defaultDecomposed[chId]
			end
		end

		do
			local pKd, nKd = nil, nil
			local index = interp.index(bucket, "C0")
			if index then
				local p, n = interp.search(index, time)
				pKd, nKd = index[p] and index[p].key, index[n] and index[n].key
			else
				for _, keyData in pairs(bucket) do
					if keyData and keyData.C0 and keyData.Time then
						if keyData.Time <= time and (not pKd or keyData.Time > pKd.Time) then
							pKd = keyData
						end

						if keyData.Time >= time and (not nKd or keyData.Time < nKd.Time) then
							nKd = keyData
						end
					end
				end
			end

			local manual = (pKd and pKd.PathTangentOut ~= nil) or (nKd and nKd.PathTangentIn ~= nil)
			local locDisabled = hasDisabled
				and (scratchDisabled.loc_x or scratchDisabled.loc_y or scratchDisabled.loc_z)

			if not manual then
				local pF, nF = nil, nil
				for _, chId in ipairs(channelIds) do
					pF = pF or scratchPrevFrame[chId]
					nF = nF or scratchNextFrame[chId]
				end

				local locConsistent = true
				for _, chId in ipairs(locIds) do
					local pp = scratchPrevFrame[chId]
					local nn = scratchNextFrame[chId]
					if pp ~= pF or nn ~= nF then
						locConsistent = false
						break
					end
				end

				if locConsistent and pF and nF then
					pKd, nKd = bucket[pF], bucket[nF]
				else
					pKd, nKd = nil, nil
				end
			end

			if
				not locDisabled
				and pKd
				and nKd
				and pKd ~= nKd
				and pKd.C0
				and nKd.C0
				and not interp.usesAutomaticBezier(pKd, nKd)
				and pKd.Time
				and nKd.Time
				and nKd.Time > pKd.Time
			then
				local rawA = math.clamp((time - pKd.Time) / (nKd.Time - pKd.Time), 0, 1)
				local cf = interp.cframe(bucket, pKd, nKd, rawA, "C0", loopEndTime)
				if cf then
					for _, axis in axes do
						local id = "loc_" .. axis
						local a = pKd.Channels and pKd.Channels[id]
						local b = nKd.Channels and nKd.Channels[id]
						if not (a and a.Easing or b and b.Easing) then
							scratchValues[id] = cf.Position[axis:upper()]
						end
					end
				end
			end
		end

		return self:ReconstructC0(scratchValues), true
	end

	function graphCurves.sampleLegacyRotation(channel, time, loopEndTime)
		local entry = channel.legacyEntry
		local motor = channel[1].key.Motor
		if not entry or not motor then
			return nil
		end

		local context = entry.rotationEvaluation
		if not context then
			context = { _motorUniform = {}, _motorHasScale = {} }
			entry.rotationEvaluation = context
		end
		context.DefaultPose = timelineState.DefaultPose
		local cf = evaluateLegacyMotorC0(Timeline, motor, time, loopEndTime, entry.legacy, context)
		local quaternion = module("quaternion")
		local q = quaternion.fromCFrame(cf)
		local reference = graphCurves.quaternionReference(entry.legacy, time)
		if reference then
			q = quaternion.alignSign(reference, q)
		end
		return q[channel.id:sub(6)]
	end

	local function evaluateLegacyScale(self, motor, time, loopEndTime, bucket)
		if not bucket or not next(bucket) then
			return nil
		end

		local cache = poseCache.poseCache()
		if cache then
			cache.scalePresence = cache.scalePresence or setmetatable({}, { __mode = "k" })
		end

		local hasScaleFlag
		if cache then
			hasScaleFlag = cache.scalePresence[bucket]
		else
			hasScaleFlag = timelineState._motorHasScale[motor]
		end

		if hasScaleFlag == nil then
			hasScaleFlag = false
			for _, keyData in pairs(bucket) do
				local channels = keyData.Channels
				if channels then
					for _, chId in ipairs(scaleIds) do
						local ch = channels[chId]
						if
							ch
							and typeof(ch.Value) == "number"
							and math.abs(ch.Value - 1) > 1e-6
						then
							hasScaleFlag = true
							break
						end
					end

					if hasScaleFlag then
						break
					end
				end
			end

			timelineState._motorHasScale[motor] = hasScaleFlag
			if cache then
				cache.scalePresence[bucket] = hasScaleFlag
			end
		end

		if not hasScaleFlag then
			return nil
		end

		local hasDisabled = false
		if motor:GetAttribute("EclipseChannelDisabledAny") then
			hasDisabled = true
			table.clear(scratchDisabled)
			for _, chId in ipairs(scaleIds) do
				if motor:GetAttribute("EclipseChannelDisabled_" .. chId) then
					scratchDisabled[chId] = true
				end
			end
		end

		table.clear(scratchPrevFrame)
		table.clear(scratchPrevValue)
		table.clear(scratchPrevTime)
		table.clear(scratchNextFrame)
		table.clear(scratchNextValue)
		table.clear(scratchNextTime)
		local anyScale = false

		local indexed = indexedChannels(self, bucket, time, scaleIds, false, hasDisabled)
		if indexed ~= nil then
			anyScale = indexed
		else
			for kfFrame, keyData in pairs(bucket) do
				local channels = keyData.Channels
				if channels then
					local kfTime = keyData.Time
					local isPrev = keyData.Time <= time
					local isNext = keyData.Time >= time
					for _, chId in ipairs(scaleIds) do
						if not (hasDisabled and scratchDisabled[chId]) then
							local ch = channels[chId]
							if ch and ch.Value ~= nil then
								anyScale = true
								if isPrev then
									local existing = scratchPrevFrame[chId]
									if not existing or kfFrame > existing then
										scratchPrevFrame[chId] = kfFrame
										scratchPrevValue[chId] = ch.Value
										scratchPrevTime[chId] = kfTime
									end
								end

								if isNext then
									local existing = scratchNextFrame[chId]
									if not existing or kfFrame < existing then
										scratchNextFrame[chId] = kfFrame
										scratchNextValue[chId] = ch.Value
										scratchNextTime[chId] = kfTime
									end
								end
							end
						end
					end
				end
			end
		end

		if not anyScale then
			return nil
		end

		local out = {}
		for _, chId in ipairs(scaleIds) do
			local pFrame = scratchPrevFrame[chId]
			local nFrame = scratchNextFrame[chId]
			local pTime = scratchPrevTime[chId]
			local nTime = scratchNextTime[chId]
			local pValue = scratchPrevValue[chId]
			local nValue = scratchNextValue[chId]
			if pFrame and nFrame and pFrame ~= nFrame and nTime > pTime then
				local alpha = math.clamp((time - pTime) / (nTime - pTime), 0, 1)
				local prevKeyData = bucket[pFrame]
				out[chId] = interp.channel(
					bucket,
					prevKeyData,
					bucket[nFrame],
					alpha,
					chId,
					pValue,
					nValue,
					loopEndTime
				)
			elseif pFrame then
				out[chId] = pValue
			elseif nFrame then
				out[chId] = nValue
			else
				out[chId] = 1
			end
		end

		return out
	end

	function Timeline:EvaluateMotorC0(motor, time, bucketOverride, loopEndTime)
		local value, keyed = self:EvaluateMotorJointC0(motor, time, bucketOverride, loopEndTime)
		local offset = value and pivotSpace.jointOffset(motor)
		if not offset then
			return value, keyed
		end

		if pivotSpace.blocked(motor, time) then
			return value, keyed
		end

		if not bucketOverride and module("layers").has(timelineState) then
			return value, keyed
		end

		local bucket = keyframePolicy.activeBucket(bucketOverride or timelineState.Keyframes[motor])
		if not bucket then
			return value, keyed
		end

		local previous, following = parenting.bounds(bucket, time)
		if
			not previous
			or not following
			or previous == following
			or following.Time <= previous.Time
		then
			return value, keyed
		end

		return pivotSpace.correct(
			bucket,
			previous,
			following,
			math.clamp((time - previous.Time) / (following.Time - previous.Time), 0, 1),
			"C0",
			loopEndTime,
			offset,
			value
		),
			keyed
	end

	function Timeline:EvaluateMotorJointC0(
		motor,
		time,
		bucketOverride,
		loopEndTime,
		evaluationState
	)
		local timelineState = evaluationState or timelineState
		local layers = module("layers")
		if not bucketOverride and not timelineState._LayerContext and layers.has(timelineState) then
			return layers.c0(self, motor, time, loopEndTime)
		end

		if properties.is(motor) then
			return properties.encode(
				properties.evaluate(
					motor,
					bucketOverride or timelineState.Keyframes[motor],
					time,
					loopEndTime
				)
			),
				true
		end

		local bucket = keyframePolicy.activeBucket(bucketOverride or timelineState.Keyframes[motor])
		local section = limbIk.controlBucket(motor, time, bucket, timelineState.Keyframes)
		if section ~= bucket then
			loopEndTime = nil
		end

		bucket = section
		local imported = blenderCurve.evaluate(bucket, time)
		if imported then
			return imported, true
		end

		timelineState._evaluationBuckets = timelineState._evaluationBuckets
			or setmetatable({}, { __mode = "kv" })
		if timelineState._evaluationBuckets[motor] ~= bucket then
			timelineState._motorUniform[motor] = nil
			timelineState._motorHasScale[motor] = nil
			timelineState._evaluationBuckets[motor] = bucket
		end

		local complete = graphCurves.fullTransform(bucket, time, motor, loopEndTime)
		if complete then
			return complete, true
		end

		local legacy = graphCurves.legacyBucket(bucket)
		local cf, keyed =
			evaluateLegacyMotorC0(self, motor, time, loopEndTime, legacy, timelineState)
		if not graphCurves.compile(bucket).hasGraph then
			return cf, keyed
		end

		return graphCurves.cframe(
			bucket,
			time,
			cf,
			motor,
			loopEndTime,
			timelineState.DefaultPose[motor]
		),
			true
	end

	function Timeline:CreatePreviewSampler(motor, bucket, rest)
		local context = {
			DefaultPose = { [motor] = rest },
			Keyframes = { [motor] = bucket },
			ParentingDefaults = { [motor] = true },
			_motorUniform = {},
			_motorHasScale = {},
		}
		self:EnsureTransformChannelStarts(motor, context)
		local frozen = poseCache.newFrozen()
		local at = 0
		local function evaluate()
			return self:EvaluateMotorJointC0(motor, at, bucket, nil, context)
		end

		return function(time)
			at = time
			return poseCache.withFrozen(evaluate, frozen)
		end
	end

	function Timeline:EvaluateMotorScale(motor, time, bucketOverride, loopEndTime)
		local layers = module("layers")
		if not bucketOverride and not timelineState._LayerContext and layers.has(timelineState) then
			return layers.scale(self, motor, time, loopEndTime)
		end

		if bucketOverride then
			timelineState._motorHasScale[motor] = nil
		end

		local bucket = keyframePolicy.activeBucket(bucketOverride or timelineState.Keyframes[motor])
		local _, scale = blenderCurve.evaluate(bucket, time)
		if scale then
			return { scale_x = scale.X, scale_y = scale.Y, scale_z = scale.Z }
		end

		local legacy = graphCurves.legacyBucket(bucket)
		local scale = evaluateLegacyScale(self, motor, time, loopEndTime, legacy)
		if not graphCurves.compile(bucket).hasGraph then
			return scale
		end

		return graphCurves.scale(bucket, time, scale, motor, loopEndTime)
	end

	local controlFreeRigs = setmetatable({}, { __mode = "k" })

	local function nativeJointWorld(part)
		local motor = timelineState.MotorByPart[part]
		return motor and parenting.worldOf(motor, timelineState.MotorByPart) or part.CFrame
	end

	local function countEntries(map)
		if not map then
			return 0
		end

		local count = 0
		for _ in map do
			count += 1
		end

		return count
	end

	local function refreshPlanTracks(plan, tracks)
		local keys = plan.keys
		local count = 0
		local changed = false
		for motor, bucket in tracks do
			count += 1
			local active = keyframePolicy.activeBucket(bucket)
			if keys[motor] ~= active then
				keys[motor] = active
				changed = true
			end
		end

		if changed or count ~= plan.trackCount then
			plan.trackCount = count
			for motor in keys do
				if tracks[motor] == nil then
					keys[motor] = nil
				end
			end

			return true
		end

		return false
	end

	local function motorMapChanged(plan, map)
		local snapshot = plan.motorByPartSnapshot
		local count = 0
		for part, motor in map do
			count += 1
			if snapshot[part] ~= motor then
				return true
			end
		end

		return count ~= plan.motorByPartCount
	end

	local function planValid(plan, propertyRigs, listRigs, onlyRig, loopEndTime)
		if
			plan.revision ~= poseCache.revision()
			or plan.keyframes ~= timelineState.Keyframes
			or plan.defaultPose ~= timelineState.DefaultPose
			or plan.defaultWorldPose ~= timelineState.DefaultWorldPose
			or plan.parentingDefaults ~= timelineState.ParentingDefaults
			or plan.motorByPart ~= timelineState.MotorByPart
			or plan.loopEndTime ~= loopEndTime
			or plan.onlyRig ~= onlyRig
			or plan.modifiers ~= timelineState.CurveModifiers
			or plan.modifierCount ~= countEntries(timelineState.CurveModifiers)
			or #plan.rigs ~= #propertyRigs
			or #plan.listRigs ~= #listRigs
		then
			return false
		end

		local rigs = plan.rigs
		for index, target in ipairs(propertyRigs) do
			if rigs[index] ~= target then
				return false
			end
		end

		local lists = plan.lists
		rigs = plan.listRigs
		for index, target in ipairs(listRigs) do
			if rigs[index] ~= target or lists[index] ~= getCachedMotorList(target) then
				return false
			end
		end

		if motorMapChanged(plan, timelineState.MotorByPart) then
			return false
		end

		return not refreshPlanTracks(plan, timelineState.Keyframes)
	end

	local function bucketHasControls(bucket)
		if not bucket then
			return false
		end

		for _, key in bucket do
			if typeof(key.IK) == "boolean" or typeof(key.HS) == "boolean" then
				return true
			end
		end

		return false
	end

	local function rigControlFree(plan, target, list)
		if armatureRuntime.isRig(target) then
			return false
		end

		local entry = limbIk.getRig(target)
		if not entry then
			return true
		end

		local keys = plan.keys
		for _, motor in ipairs(list) do
			if bucketHasControls(keys[motor]) then
				return false
			end
		end

		for _, motor in ipairs(entry.motors) do
			if bucketHasControls(keys[motor]) then
				return false
			end
		end

		for _, chain in entry.chains do
			if limbIk.hasAnimationUncached(chain.owner) then
				return false
			end
		end

		return true
	end

	local function scaleAlwaysNil(bucket)
		if module("layers").has(timelineState) then
			return false
		end

		if not bucket then
			return true
		end

		for _, key in bucket do
			if key.BlenderCurve then
				return false
			end
		end

		local compiled = graphCurves.compile(bucket)
		local channels = compiled.channels
		if channels.scale_x or channels.scale_y or channels.scale_z then
			return false
		end

		local legacy = compiled.legacy
		if legacy then
			for _, keyData in legacy do
				local channels = keyData.Channels
				if channels then
					for _, chId in ipairs(scaleIds) do
						local ch = channels[chId]
						if ch and typeof(ch.Value) == "number" and math.abs(ch.Value - 1) > 1e-6 then
							return false
						end
					end
				end
			end
		end

		return true
	end

	local function buildPosePlan(self, plan, propertyRigs, listRigs, onlyRig, loopEndTime)
		plan.revision = poseCache.revision()
		plan.keyframes = timelineState.Keyframes
		plan.defaultPose = timelineState.DefaultPose
		plan.defaultWorldPose = timelineState.DefaultWorldPose
		plan.parentingDefaults = timelineState.ParentingDefaults
		plan.motorByPart = timelineState.MotorByPart
		plan.loopEndTime = loopEndTime
		plan.onlyRig = onlyRig
		plan.modifiers = timelineState.CurveModifiers
		plan.modifierCount = countEntries(timelineState.CurveModifiers)

		local rigs = plan.rigs
		table.clear(rigs)
		for index, target in ipairs(propertyRigs) do
			rigs[index] = target
		end

		rigs = plan.listRigs
		local lists = plan.lists
		table.clear(rigs)
		table.clear(lists)
		for index, target in ipairs(listRigs) do
			rigs[index] = target
			lists[index] = getCachedMotorList(target)
		end

		local snapshot = plan.motorByPartSnapshot
		table.clear(snapshot)
		local count = 0
		for part, motor in timelineState.MotorByPart do
			count += 1
			snapshot[part] = motor
		end

		plan.motorByPartCount = count
		table.clear(plan.keys)
		plan.trackCount = -1
		refreshPlanTracks(plan, timelineState.Keyframes)

		local mods = module("mods")
		local base, kinds, owners, ids = plan.base, plan.kinds, plan.owners, plan.ids
		table.clear(base)
		table.clear(kinds)
		table.clear(owners)
		table.clear(ids)
		for _, list in ipairs(lists) do
			for _, motor in ipairs(list) do
				local kind = 0
				local owner, id = false, false
				if boneMotor.isFacial(motor) then
					local bucket = plan.keys[motor]
					if (not bucket or next(bucket) == nil) and not mods.entries(motor) then
						kind = 1
					end
				end

				local name = typeof(motor) == "Instance" and motor:IsA("Motor6D") and motor.Name
				local cameraOwner = (name == "FovPart" or name == "CamPart")
					and cameraRig
					and cameraRig.owner(motor)
				local cameraId = cameraOwner
					and (
						cameraRig.isFov(motor) and "FieldOfView"
						or cameraRig.isTransform(motor) and "CFrame"
					)
				if cameraId then
					kind = 2
					owner, id = cameraOwner, cameraId
				end

				local n = #base + 1
				base[n], kinds[n], owners[n], ids[n] = motor, kind, owner, id
			end
		end

		table.clear(plan.scaleStatic)
		local controlFree = plan.controlFree
		table.clear(controlFree)
		local cleared = false
		for index, target in ipairs(rigs) do
			local free = rigControlFree(plan, target, lists[index])
			controlFree[target] = free
			if free and not controlFreeRigs[target] then
				controlFreeRigs[target] = true
				if not cleared then
					cleared = true
					limbIk.clearLive()
				end
			elseif not free then
				controlFreeRigs[target] = nil
			end
		end

		plan.list = nil
		plan.evaluator = nil
	end

	local function refreshPoseList(self, plan, time)
		local base, kinds = plan.base, plan.kinds
		local frameList = plan.frameList
		table.clear(frameList)
		local isObjectMotorActive = self.refs.IsObjectMotorActive
		local n = 0
		for index, motor in ipairs(base) do
			local kind = kinds[index]
			if kind == 1 then
				if not limbIk.isDriven(motor, time) then
					continue
				end
			elseif kind == 2 then
				if not properties.enabled(plan.owners[index], plan.ids[index]) then
					continue
				end
			end

			if
				isObjectMotorActive
				and motor:GetAttribute("EclipseAddedObject") == true
				and not isObjectMotorActive(motor)
			then
				continue
			end

			n += 1
			frameList[n] = motor
		end

		local list = plan.list
		if list and plan.evaluator and #list == n then
			local same = true
			for index = 1, n do
				if list[index] ~= frameList[index] then
					same = false
					break
				end
			end

			if same then
				return list
			end
		end

		plan.list, plan.frameList = frameList, list or {}
		plan.evaluator = parenting.newEvaluator(
			frameList,
			plan.keys,
			timelineState.DefaultPose,
			timelineState.DefaultWorldPose,
			timelineState.ParentingDefaults,
			plan.evaluateC0,
			plan.loopEndTime
		)
		return frameList
	end

	local function createPosePlan(self, rig)
		local plan = {
			rig = rig,
			single = { rig },
			frame = 0,
			rigs = {},
			listRigs = {},
			lists = {},
			keys = {},
			trackCount = -1,
			motorByPartSnapshot = {},
			motorByPartCount = 0,
			base = {},
			kinds = {},
			owners = {},
			ids = {},
			frameList = {},
			resolved = {},
			placed = {},
			scaleStatic = {},
			controlFree = {},
			jointSamples = setmetatable({}, { __mode = "k" }),
			revision = -1,
		}

		plan.evaluateC0 = function(motor, sampleTime)
			local at = sampleTime or plan.time
			local rest = timelineState.DefaultPose[motor]
			if not rest or properties.is(motor) then
				return self:EvaluateMotorC0(motor, at, nil, plan.loopEndTime)
			end

			local saved = plan.jointSamples[motor]
			if saved and saved.frame == plan.frame and saved.time == at and saved.rest == rest then
				return saved.value, saved.keyed
			end

			local value, keyed = self:EvaluateMotorC0(motor, at, nil, plan.loopEndTime)
			if saved then
				saved.frame, saved.time, saved.rest, saved.value, saved.keyed =
					plan.frame, at, rest, value, keyed
			else
				plan.jointSamples[motor] =
					{ frame = plan.frame, time = at, rest = rest, value = value, keyed = keyed }
			end

			return value, keyed
		end

		plan.poseBody = function()
			local time = plan.time
			local loopEndTime = plan.loopEndTime
			local evaluator = plan.evaluator
			local descendants = plan.list
			local resolved = plan.resolved
			for index, motor in ipairs(descendants) do
				resolved[index] = evaluator.localAt(motor, time)
			end

			local curveModifiers = module("mods")
			local modifiersActive = curveModifiers.any()
			if modifiersActive then
				for index, motor in ipairs(descendants) do
					if curveModifiers.entries(motor) then
						local modified = curveModifiers.applyC0(
							motor,
							time,
							timelineState.FPS,
							function(sampleTime)
								return evaluator.localAt(motor, sampleTime)
							end,
							plan.keys[motor]
						)
						if modified then
							resolved[index] = modified
						end
					end
				end
			end

			local scaleStatic = plan.scaleStatic
			local defaultSizes = timelineState.DefaultSize
			for index, motor in ipairs(descendants) do
				local parented = limbIk.isDriven(motor, time) or evaluator.isParentedAt(motor, time)
				if motor:GetAttribute("TrackParent") ~= parented then
					EventDependencies.poseAttribute(motor, "TrackParent", parented)
				end

				motor.C0 = resolved[index]
				local part = motor.Part1
				local defaultSize = part and defaultSizes[part]
				if
					part
					and defaultSize
					and not (typeof(motor) == "table" and motor.IsEclipseMasterControl)
				then
					local static = scaleStatic[motor]
					if static == nil then
						static = scaleAlwaysNil(plan.keys[motor])
						scaleStatic[motor] = static
					end

					local scale
					if not static then
						scale = self:EvaluateMotorScale(motor, time, nil, loopEndTime)
					end

					if modifiersActive and curveModifiers.entries(motor) then
						local modified, any = curveModifiers.applyScale(
							motor,
							time,
							timelineState.FPS,
							function(sampleTime)
								return self:EvaluateMotorScale(motor, sampleTime, nil, loopEndTime)
							end,
							plan.keys[motor]
						)
						if any then
							scale = modified
						end
					end

					if typeof(motor) == "table" and motor.IsEclipseArmatureControl then
						motor.InputScale = scale
								and Vector3.new(
									scale.scale_x or 1,
									scale.scale_y or 1,
									scale.scale_z or 1
								)
							or Vector3.one
					else
						EventDependencies.poseWrite(
							part,
							"Size",
							scale
									and Vector3.new(
										defaultSize.X * (scale.scale_x or 1),
										defaultSize.Y * (scale.scale_y or 1),
										defaultSize.Z * (scale.scale_z or 1)
									)
								or defaultSize
						)
					end
				end
			end

			local controlFree = plan.controlFree
			for _, targetRig in plan.listRigs do
				if armatureRuntime.isRig(targetRig) then
					armatureRuntime.setTime(targetRig, time)
					armatureAnimation.applyProperties(targetRig, time * timelineState.FPS)
					armatureRuntime.evaluate(targetRig)
				elseif controlFree[targetRig] then
					local entry = limbIk.getRig(targetRig)
					if entry then
						entry.torsoBaseWorld = nil
					end
				else
					limbIk.apply(targetRig, time, true, plan.evaluateC0, evaluator.worldAt)
				end
			end

			if not plan.skipControls then
				self:RefreshParentingControls(time, evaluator.isParentedAt, evaluator.childAt)
				if self.refs.RefreshIKHierarchy then
					self.refs.RefreshIKHierarchy()
				end

				self:RefreshIKControls(time)
				self:RefreshHeadStabilizerControls(time)
			end
		end

		return plan
	end

	function Timeline:ApplyPoseAtTime(rig, time, options)
		time = self:GetPoseTime(time, options and options.ContinuousSample)
		return require("poseCache").withPose(function()
			return self:_ApplyPoseAtTimeCached(rig, time, options)
		end)
	end

	function Timeline:_ApplyPoseAtTimeCached(rig, time, options)
		local rigs = not (options and options.OnlyRig) and self.refs.GetAllRigs and self.refs.GetAllRigs()
		return properties.withScaleState(rigs or (rig and { rig } or {}), function()
			return EventDependencies.withPose(function()
				return module("layers").withPose(self, time, function()
					return self:_ApplyPoseAtTimeUnlayered(rig, time, options)
				end)
			end)
		end)
	end

	function Timeline:_ApplyPoseAtTimeUnlayered(rig, time, options)
		if not rig then
			return
		end

		local plan = posePlans[rig]
		if not plan or plan.busy then
			plan = createPosePlan(self, rig)
			posePlans[rig] = plan
		end

		plan.busy = true
		local targetValue = module("target")
		targetValue.beginPose()
		timelineState.LastPoseApplyClock = os.clock()

		local loopEndTime = self:IsLooping() and self:GetPlaybackEndTime() or nil
		local onlyRig = options and options.OnlyRig and true or false
		local allRigs = not onlyRig and self.refs.GetAllRigs and self.refs.GetAllRigs() or nil
		local propertyRigs = allRigs or plan.single
		local listRigs = allRigs and #allRigs > 1 and allRigs or plan.single
		if not planValid(plan, propertyRigs, listRigs, onlyRig, loopEndTime) then
			buildPosePlan(self, plan, propertyRigs, listRigs, onlyRig, loopEndTime)
		end

		plan.frame += 1
		plan.time = time
		plan.skipControls = options and options.SkipControls and true or false

		local propertySamples = targetValue.propertySampleCache()
		local placed = plan.placed
		table.clear(placed)
		for _, target in propertyRigs do
			placed[target] =
				properties.beginPose(target, timelineState, time, loopEndTime, propertySamples)
			module("faces").apply(target, time, timelineState.FPS)
		end

		local descendants = refreshPoseList(self, plan, time)
		local evaluator = plan.evaluator
		evaluator.reset()
		module("masterControl").withPose(propertyRigs, plan.poseBody)

		for _, target in propertyRigs do
			module("partRig").flush(target)
			properties.apply(
				target,
				timelineState,
				time,
				loopEndTime,
				propertySamples,
				placed[target]
			)
		end

		for _, target in propertyRigs do
			targetValue.applied(target, time)
		end

		if not onlyRig then
			module("origin").apply(self, time)
		end

		for _, target in propertyRigs do
			module("nativeJoints").flush(target, nativeJointWorld)
		end

		if not onlyRig then
			targetValue.appliedChildren(descendants, time, evaluator)
		end
		local lastCFrames = module("state").lastCFrames
		for _, motor in descendants do
			lastCFrames[motor] = motor.C0
		end

		targetValue.completePose(propertyRigs, time)
		plan.busy = false
	end
end
