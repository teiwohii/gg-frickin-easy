							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local spatialValue = require(script.Parent.Parent.spatial)

local Tool = {}
Tool.__index = Tool

Tool.id = "Tool"
Tool.title = "Tool"
Tool.collapsed = true
Tool.keywords = ""

Tool.messages = {
	nothing = "Select the objects to use this on first.",
	noSpatial = "Select parts, models or attachments to use this on.",
}

function Tool.extend()
	local Class = setmetatable({}, { __index = Tool })

	Class.__index = Class

	return Class
end

function Tool.init(self, context, defaults)
	self.context = context
	self.selection = context.selection
	self.asset = context.asset
	self.history = context.history
	self.params = table.clone(defaults or {})
end

function Tool:getId(name: string): string
	return self.id .. "." .. name
end

function Tool:field(name: string, label: string, kind: string, options)
	local descriptor = {
		id = self:getId(name),
		label = label,
		kind = kind,
		value = self.params[name],
		keywords = self.title .. " " .. self.keywords,
		read = function()
			return self.params[name]
		end,
		onChange = function(value)
			if value ~= nil then
				self.params[name] = value
			end
		end,
	}

	for key, value in options or {} do
		descriptor[key] = value
	end

	return descriptor
end

function Tool:choice(name: string, label: string, choices: { string }, options)
	local list = {}

	for _, choice in choices do
		table.insert(list, { value = choice, label = choice })
	end

	local descriptor = self:field(name, label, "choice", options)

	descriptor.options = list

	return descriptor
end

function Tool:action(name: string, label: string, callback: () -> (), tip: string?, accent: boolean?)
	return {
		id = self:getId(name),
		label = label,
		kind = "action",
		tip = tip,
		accent = accent,
		keywords = self.title .. " " .. self.keywords,
		onAction = callback,
	}
end

function Tool:getRoots(): { Instance }
	local roots = {}

	for _, instance in self.selection:getRoots() do
		if instance:IsDescendantOf(workspace) and not self.asset:isBase(instance) and instance ~= self.asset:getEffects() then
			table.insert(roots, instance)
		end
	end

	return roots
end

function Tool:getSpatialRoots(): { Instance }
	return spatialValue.filter(self:getRoots())
end

function Tool:getAffected(): { Instance }
	local affected = {}
	local seen = {}

	for _, root in self:getRoots() do
		if not seen[root] then
			seen[root] = true
			table.insert(affected, root)
		end

		for _, descendant in root:GetDescendants() do
			if not seen[descendant] then
				seen[descendant] = true
				table.insert(affected, descendant)
			end
		end
	end

	return affected
end

function Tool:requireRoots(spatial: boolean?): { Instance }?
	local roots = if spatial then self:getSpatialRoots() else self:getRoots()

	if #roots == 0 then
		self.context.notify(if spatial then Tool.messages.noSpatial else Tool.messages.nothing)
		return nil
	end

	return roots
end

function Tool:getOrigin(): Vector3
	return self.asset:getOrigin().Position
end

function Tool:run(name: string, action: () -> ...any): ...any
	return self.history:run(name, action)
end

function Tool:getFields()
	return {}
end

function Tool:getSignature(): string
	return ""
end

function Tool:destroy() end

return Tool
]]></ProtectedString>
