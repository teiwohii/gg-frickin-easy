							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local httpService = game:GetService("HttpService")

local boltShape = {}
boltShape.__index = boltShape

boltShape.generatorAttribute = "ArcGenerator"
boltShape.generatorId = "Lightning"
boltShape.indexAttribute = "ArcSegment"
boltShape.mainName = "Bolt"
boltShape.branchName = "Branch"
boltShape.branchThickness = 0.5
boltShape.branchJitter = 0.6
boltShape.branchTaper = 0.3
boltShape.overlap = 0.5
boltShape.minimumSegments = 2
boltShape.maximumSegments = 64
boltShape.maximumBranches = 16
boltShape.minimumSize = 0.02
boltShape.forward = Vector3.new(0, 0, -1)

boltShape.defaults = {
	Length = 20,
	Segments = 12,
	Jitter = 2,
	Thickness = 0.4,
	Taper = 0.6,
	Branches = 3,
	BranchLength = 0.35,
	BranchAngle = 35,
	Seed = 1,
}

function boltShape.normalize(source: any)
	local params = {}
	local values = if typeof(source) == "table" then source else {}

	for name, default in boltShape.defaults do
		local value = values[name]

		params[name] = if typeof(value) == "number" and value == value then value else default
	end

	return params
end

function boltShape.decode(raw: any)
	if typeof(raw) ~= "string" then
		return nil
	end

	local success, data = pcall(function()
		return httpService:JSONDecode(raw)
	end)

	if not success or typeof(data) ~= "table" or data.id ~= boltShape.generatorId then
		return nil
	end

	return boltShape.normalize(data.p)
end

function boltShape.readParams(model: Instance)
	return boltShape.decode(model:GetAttribute(boltShape.generatorAttribute))
end

function boltShape.getSegmentCount(params): number
	return math.clamp(math.round(params.Segments), boltShape.minimumSegments, boltShape.maximumSegments)
end

function boltShape.getBranchCount(params): number
	return math.clamp(math.round(params.Branches), 0, boltShape.maximumBranches)
end

function boltShape.getBranchSegments(params): number
	return math.max(2, math.round(boltShape.getSegmentCount(params) / 3))
end

function boltShape.getPartCount(params): number
	return boltShape.getSegmentCount(params) + boltShape.getBranchCount(params) * boltShape.getBranchSegments(params)
end

function boltShape.jitter(random: Random, amount: number): number
	if amount <= 0 then
		return 0
	end

	return random:NextNumber(-amount, amount)
end

function boltShape.sampleOffsets(random: Random, count: number, amount: number, lockEnd: boolean)
	local offsets = {}

	for index = 0, count do
		if index == 0 or (lockEnd and index == count) then
			offsets[index + 1] = Vector3.zero
		else
			local x = boltShape.jitter(random, amount)
			local y = boltShape.jitter(random, amount)

			offsets[index + 1] = Vector3.new(x, y, 0)
		end
	end

	return offsets
end

function boltShape.sample(params, seed: number)
	local random = Random.new(math.floor(seed))
	local segments = boltShape.getSegmentCount(params)
	local branchSegments = boltShape.getBranchSegments(params)
	local spread = math.rad(params.BranchAngle)
	local sample = {
		main = boltShape.sampleOffsets(random, segments, params.Jitter, true),
		branches = {},
	}

	for _ = 1, boltShape.getBranchCount(params) do
		local index = random:NextInteger(2, math.max(segments, 2))
		local pitch = boltShape.jitter(random, spread)
		local yaw = boltShape.jitter(random, spread)
		local length = params.Length * params.BranchLength * random:NextNumber(0.5, 1)

		table.insert(sample.branches, {
			index = index,
			direction = CFrame.Angles(pitch, yaw, 0) * boltShape.forward,
			length = length,
			offsets = boltShape.sampleOffsets(random, branchSegments, params.Jitter * boltShape.branchJitter, false),
		})
	end

	return sample
end

function boltShape.aim(position: Vector3, direction: Vector3): CFrame
	local unit = if direction.Magnitude > 1e-4 then direction.Unit else Vector3.zAxis
	local up = if math.abs(unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis

	return CFrame.lookAt(position, position + unit, up)
end

function boltShape.blend(base: Vector3, from: Vector3, to: Vector3, alpha: number, amount: number): Vector3
	return base:Lerp(from:Lerp(to, alpha), amount)
end

function boltShape.trace(basis: CFrame, length: number, base, from, to, alpha: number, amount: number)
	local count = #base - 1
	local points = {}

	for index = 0, count do
		local slot = index + 1
		local offset = boltShape.blend(base[slot], from[slot] or base[slot], to[slot] or base[slot], alpha, amount)

		points[slot] = basis * (Vector3.new(0, 0, -length * index / count) + offset)
	end

	return points
end

function boltShape.draw(segments, points, startThickness: number, endThickness: number, name: string, scale: number)
	local count = #points - 1
	local minimum = boltShape.minimumSize

	for index = 1, count do
		local from = points[index] * scale
		local to = points[index + 1] * scale
		local delta = to - from
		local thickness = (startThickness + (endThickness - startThickness) * ((index - 0.5) / count)) * scale

		table.insert(segments, {
			name = name,
			cframe = boltShape.aim((from + to) / 2, delta),
			size = Vector3.new(
				math.max(thickness, minimum),
				math.max(thickness, minimum),
				math.max(delta.Magnitude + thickness * boltShape.overlap, minimum)
			),
		})
	end
end

function boltShape.compose(params, base, from, to, alpha: number, amount: number, scale: number?)
	local factor = scale or 1
	local segmentCount = boltShape.getSegmentCount(params)
	local thickness = params.Thickness
	local tip = thickness * (1 - math.clamp(params.Taper, 0, 1))
	local segments = {}
	local main = boltShape.trace(CFrame.identity, params.Length, base.main, from.main, to.main, alpha, amount)

	boltShape.draw(segments, main, thickness, tip, boltShape.mainName, factor)

	for slot, branch in base.branches do
		local fromBranch = from.branches[slot] or branch
		local toBranch = to.branches[slot] or branch
		local fraction = (branch.index - 1) / segmentCount
		local start = (thickness + (tip - thickness) * fraction) * boltShape.branchThickness
		local basis = boltShape.aim(main[branch.index], branch.direction)
		local points = boltShape.trace(basis, branch.length, branch.offsets, fromBranch.offsets, toBranch.offsets, alpha, amount)

		boltShape.draw(segments, points, start, start * boltShape.branchTaper, boltShape.branchName, factor)
	end

	return segments
end

function boltShape.rest(params, scale: number?)
	local base = boltShape.sample(params, params.Seed)

	return boltShape.compose(params, base, base, base, 0, 0, scale)
end

return boltShape
]]></ProtectedString>
							<string name="ScriptGuid">{42D7B46D-A755-4706-A00B-58D367239ACC}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">boltShape</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX50E96C2D0354405690EB5BEE9F80E81F">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local runService = game:GetService("RunService")

local configuration = require(script.Parent.Parent.Utility.configuration)
local ParticleSnapshot = require(script.Parent.ParticleSnapshot)

local ParticleClock = {}
ParticleClock.__index = ParticleClock

ParticleClock.epsilon = 1 / 240
ParticleClock.startWindow = 0.25
ParticleClock.timeScaleAttribute = "ArcClockTimeScale"
ParticleClock.transparencyAttribute = "ArcClockTransparency"
ParticleClock.enabledAttribute = "ArcClockEnabled"
ParticleClock.overridden = { TimeScale = true, Enabled = true }

function ParticleClock.repair(emitter: Instance)
	if not emitter:IsA("ParticleEmitter") then
		return
	end

	local storedTimeScale = emitter:GetAttribute(ParticleClock.timeScaleAttribute)
	local storedTransparency = emitter:GetAttribute(ParticleClock.transparencyAttribute)

	if typeof(storedTimeScale) == "number" then
		emitter.TimeScale = storedTimeScale
	end

	if typeof(storedTransparency) == "NumberSequence" then
		emitter.Transparency = storedTransparency
	end

	local storedEnabled = emitter:GetAttribute(ParticleClock.enabledAttribute)

	if typeof(storedEnabled) == "boolean" then
		emitter.Enabled = storedEnabled
	end

	emitter:SetAttribute(ParticleClock.timeScaleAttribute, nil)
	emitter:SetAttribute(ParticleClock.transparencyAttribute, nil)
	emitter:SetAttribute(ParticleClock.enabledAttribute, nil)

	if emitter.TimeScale <= 0 then
		emitter.TimeScale = 1
	end
end

function ParticleClock.recover(root: Instance)
	ParticleSnapshot.recover()

	for _, descendant in root:GetDescendants() do
		if descendant:IsA("ParticleEmitter") and descendant:GetAttribute(ParticleClock.timeScaleAttribute) ~= nil then
			ParticleClock.repair(descendant)
		end
	end
end

function ParticleClock.repairAll(root: Instance)
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("ParticleEmitter") then
			ParticleClock.repair(descendant)
		end
	end
end

function ParticleClock.countBefore(event, time: number): number
	local count = math.max(0, math.round(event.count))

	if count == 0 or time <= event.start then
		return 0
	end

	if event.duration <= 0 then
		return count
	end

	local exact = count * (time - event.start) / event.duration

	return math.clamp(math.ceil(exact - 1e-9) - 1, 0, count)
end

function ParticleClock.new()
	local self = setmetatable({}, ParticleClock)

	self.tracks = {}
	self.order = {}
	self.connection = nil
	self.targetProvider = nil
	self.eventsProvider = nil
	self.playingProvider = nil
	self.frameDurationProvider = nil
	self.scrubbingProvider = nil
	self.poseSampler = nil
	self.settledHandler = nil
	self.snapshot = ParticleSnapshot.new()
	self.renderConnection = nil
	self.dirty = true
	self.wasPlaying = false
	self.lastTarget = nil
	self.lastAdvance = 0
	self.frozenValid = false

	self.snapshot:setSampler(function(emitter, time)
		if self.poseSampler then
			self.poseSampler(emitter, time)
		end
	end)

	self.snapshot:setRestorer(function()
		if self.settledHandler then
			self.settledHandler()
		end
	end)

	return self
end

function ParticleClock:setPoseSampler(sampler: ((ParticleEmitter, number) -> ())?)
	self.poseSampler = sampler
end

function ParticleClock:setScaleSampler(sampler)
	self.snapshot:setScaleSampler(sampler)
end

function ParticleClock:setSettledHandler(handler: (() -> ())?)
	self.settledHandler = handler
end

function ParticleClock:isCatchingUp(): boolean
	return false
end

function ParticleClock:setTargetProvider(provider: () -> number)
	self.targetProvider = provider
end

function ParticleClock:setEventsProvider(provider: () -> { any })
	self.eventsProvider = provider
end

function ParticleClock:setPlayingProvider(provider: () -> boolean)
	self.playingProvider = provider
end

function ParticleClock:setFrameDurationProvider(provider: () -> number)
	self.frameDurationProvider = provider
end

function ParticleClock:setScrubbingProvider(provider: () -> boolean)
	self.scrubbingProvider = provider
end

function ParticleClock:isPlaying(): boolean
	return self.playingProvider ~= nil and self.playingProvider()
end

function ParticleClock:getTarget(): number
	return if self.targetProvider then self.targetProvider() else 0
end

function ParticleClock:getTolerance(): number
	local frameDuration = if self.frameDurationProvider then self.frameDurationProvider() else 1 / 60
	return frameDuration + ParticleClock.epsilon
end

function ParticleClock:isControlling(emitter: Instance): boolean
	return self.tracks[emitter] ~= nil
end

function ParticleClock:isOverriding(emitter: Instance, name: string): boolean
	return ParticleClock.overridden[name] == true and self.tracks[emitter] ~= nil
end

function ParticleClock:getOriginal(emitter: Instance, name: string)
	local track = self.tracks[emitter]
	return track and track.original[name]
end

function ParticleClock:setOriginal(emitter: Instance, name: string, value)
	local track = self.tracks[emitter]

	if track then
		track.original[name] = value
	end
end

function ParticleClock:start(emitters: { ParticleEmitter })
	self:stop(true)

	for _, emitter in emitters do
		if emitter.Parent and emitter:IsA("ParticleEmitter") and not self.tracks[emitter] then
			ParticleClock.repair(emitter)
			emitter:SetAttribute(ParticleClock.timeScaleAttribute, emitter.TimeScale)
			emitter:SetAttribute(ParticleClock.enabledAttribute, emitter.Enabled)

			local track = {
				emitter = emitter,
				original = {
					TimeScale = emitter.TimeScale,
					Enabled = emitter.Enabled,
				},
				restEnabled = emitter.Enabled,
				events = {},
				progress = {},
			}

			self.tracks[emitter] = track
			table.insert(self.order, track)
			emitter.TimeScale = 0
			emitter.Enabled = false
			emitter:Clear()
		end
	end

	self.dirty = true
	self.wasPlaying = false
	self.lastTarget = nil
	self.lastAdvance = 0
	self.frozenValid = false
	self.connection = runService.Heartbeat:Connect(function()
		self:update()
	end)
	self.renderConnection = runService.RenderStepped:Connect(function(deltaTime)
		self.snapshot:setFrameTime(deltaTime)
	end)
end

function ParticleClock:invalidate()
	self.dirty = true
end

function ParticleClock:refreshEvents()
	self.dirty = false
	self.snapshot:requestPrebuild()

	local grouped = {}

	for _, event in (if self.eventsProvider then self.eventsProvider() else {}) do
		if self.tracks[event.emitter] then
			grouped[event.emitter] = grouped[event.emitter] or {}
			table.insert(grouped[event.emitter], event)
		end
	end

	for emitter, track in self.tracks do
		track.events = grouped[emitter] or {}
	end
end

function ParticleClock:getPlayScale(): number
	return math.min(configuration.Settings.playbackSpeed or 1, 1)
end

function ParticleClock:applyTimeScale(track, rate: number)
	local value = math.clamp(rate * (track.original.TimeScale or 1), 0, 1)

	if track.emitter.Parent and track.emitter.TimeScale ~= value then
		track.emitter.TimeScale = value
	end
end

function ParticleClock:skipTo(track, time: number)
	table.clear(track.progress)

	for index, event in track.events do
		track.progress[index] = ParticleClock.countBefore(event, time)
	end
end

function ParticleClock:emitUntil(track, time: number)
	for index, event in track.events do
		local count = math.max(0, math.round(event.count))
		local emitted = track.progress[index] or 0

		if emitted < count and time >= event.start then
			local goal = count

			if event.duration > 0 then
				goal = math.floor(count * math.clamp((time - event.start) / event.duration, 0, 1))
			end

			if goal > emitted then
				pcall(function()
					track.emitter:Emit(goal - emitted)
				end)

				track.progress[index] = goal
			end
		end
	end
end

function ParticleClock:getLiveTracks()
	local tracks = {}

	for _, track in self.order do
		if track.emitter.Parent then
			table.insert(tracks, track)
		end
	end

	return tracks
end

function ParticleClock:limitTracks(tracks, before: number)
	local limited = {}

	for _, track in tracks do
		local events = {}

		for _, event in track.events do
			if event.start < before - ParticleClock.epsilon then
				table.insert(events, event)
			end
		end

		table.insert(limited, { emitter = track.emitter, events = events })
	end

	return limited
end

function ParticleClock:rebuild(target: number, playing: boolean, liveFrom: number?)
	local skipTime = if liveFrom and liveFrom < target then liveFrom else target

	for _, track in self.order do
		if track.emitter.Parent then
			track.emitter:Clear()
			self:applyTimeScale(track, 0)
		end

		self:skipTo(track, skipTime)
	end

	local scale = if playing then self:getPlayScale() else 0
	local tracks = self:getLiveTracks()

	if skipTime < target then
		tracks = self:limitTracks(tracks, skipTime)
	end

	local success, problem = pcall(function()
		self.snapshot:build(tracks, target, not playing, scale)
	end)

	if not success then
		warn(problem)
	end
end

function ParticleClock:isFrozen(): boolean
	return self.frozenValid and not self.wasPlaying
end

function ParticleClock:canFreeze(target: number, changed: boolean): boolean
	if not self.wasPlaying or not self.frozenValid or changed or self.lastTarget == nil then
		return false
	end

	return math.abs(target - self.lastTarget) <= self:getTolerance() + self.lastAdvance * 2
end

function ParticleClock:freeze(target: number)
	for _, track in self.order do
		if track.emitter.Parent then
			self:emitUntil(track, target)
			self:applyTimeScale(track, 0)
		end
	end

	self.snapshot:setTimeScale(0)
end

function ParticleClock:claimEnabled()
	for _, track in self.order do
		local emitter = track.emitter

		if emitter.Parent and emitter.Enabled then
			track.original.Enabled = true
			emitter.Enabled = false
			self.dirty = true
		end
	end
end

function ParticleClock:update()
	if #self.order == 0 then
		return
	end

	self:claimEnabled()

	local changed = self.dirty

	if changed then
		self:refreshEvents()
	end

	local refreshed = self.snapshot:consumeReady()
	local target = self:getTarget()
	local playing = self:isPlaying()
	local tolerance = self:getTolerance()
	local moved = self.lastTarget == nil or math.abs(target - self.lastTarget) > ParticleClock.epsilon

	if playing then
		local jumped = self.lastTarget ~= nil and target < self.lastTarget - tolerance
		local resumed = not self.wasPlaying and self.frozenValid and not changed and self.lastTarget ~= nil and math.abs(target - self.lastTarget) <= tolerance

		if (not self.wasPlaying and not resumed) or jumped or changed then
			local liveFrom = target

			if not self.wasPlaying and not jumped and self.lastTarget ~= nil and self.lastTarget <= target and target - self.lastTarget <= ParticleClock.startWindow then
				liveFrom = self.lastTarget
			end

			self:rebuild(target, true, liveFrom)
		end

		local scale = self:getPlayScale()

		for _, track in self.order do
			if track.emitter.Parent then
				self:emitUntil(track, target)
				self:applyTimeScale(track, scale)
			end
		end

		self.snapshot:setTimeScale(scale, self.snapshot:refreshFactors(target))
		self.lastAdvance = if self.wasPlaying and self.lastTarget then math.max(target - self.lastTarget, 0) else 0
		self.frozenValid = true
	elseif self:canFreeze(target, changed) then
		self:freeze(target)
	elseif self.wasPlaying or moved or changed or (refreshed and not self.frozenValid) then
		self:rebuild(target, false)
		self.frozenValid = false
	end

	self.wasPlaying = playing
	self.lastTarget = target
end

function ParticleClock:stop(keepCache: boolean?)
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end

	if self.renderConnection then
		self.renderConnection:Disconnect()
		self.renderConnection = nil
	end

	for _, track in self.order do
		local emitter = track.emitter

		if emitter.Parent then
			emitter:Clear()
			emitter.TimeScale = if (track.original.TimeScale or 0) > 0 then track.original.TimeScale else 1
			emitter.Enabled = track.restEnabled
			emitter:SetAttribute(ParticleClock.timeScaleAttribute, nil)
			emitter:SetAttribute(ParticleClock.transparencyAttribute, nil)
			emitter:SetAttribute(ParticleClock.enabledAttribute, nil)
		end
	end

	if keepCache then
		self.snapshot:reset()
	else
		self.snapshot:destroy()
	end

	table.clear(self.tracks)
	table.clear(self.order)
	self.dirty = true
	self.wasPlaying = false
	self.lastTarget = nil
	self.lastAdvance = 0
	self.frozenValid = false
end

return ParticleClock
