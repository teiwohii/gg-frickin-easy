						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local httpService = game:GetService("HttpService")
local fxScene = require("fxScene")
local paths = require("paths")

local fxKeys = {}

local folderName = "EclipseFXKeys"
local markerName = "EclipseEmit"
local sceneFolderName = "Eclipse FX"
local scenePrefix = "Scene"
local rigPrefix = "Rig:"

local keys = {}
local listeners = {}
local revision = 0

local function frameNumber(value)
	value = tonumber(value) or 0
	if value ~= value or value == math.huge or value == -math.huge then
		return 0
	end

	return math.max(0, math.floor(value + 0.5))
end

local function getState()
	local ok, state = pcall(require, "state")
	return ok and state or nil
end

local function sceneFolder()
	local folder = workspace:FindFirstChild(sceneFolderName)
	return folder and folder:IsA("Folder") and folder or nil
end

local function projectRigs()
	local state = getState()
	if state and state.getProjectRigs then
		local ok, rigs = pcall(state.getProjectRigs)
		if ok and type(rigs) == "table" then
			return rigs
		end
	end

	return {}
end

local function relativePath(root, instance)
	local parts = {}
	local current = instance
	while current and current ~= root do
		table.insert(parts, 1, current.Name)
		current = current.Parent
	end

	return current == root and table.concat(parts, "/") or nil
end

local function walkPath(root, path)
	local current = root
	if path == "" then
		return current
	end

	for name in string.gmatch(path, "[^/]+") do
		current = current and current:FindFirstChild(name)
	end

	return current
end

function fxKeys.pathOf(instance)
	local scene = sceneFolder()
	if scene and (instance == scene or instance:IsDescendantOf(scene)) then
		return "Scene2:" .. paths.of(instance, scene, true)
	end

	return "World2:" .. paths.of(instance, game, true)
end

function fxKeys.resolvePath(path)
	if type(path) ~= "string" or path == "" then
		return nil
	end

	local kind, encoded = path:match("^(%a+2):(.*)$")
	if kind then
		local root = kind == "Scene2" and sceneFolder() or kind == "World2" and game
		if not root then
			return nil
		end
		local ok, instance = pcall(paths.resolve, root, encoded)
		return ok and instance or nil
	end

	local head, rest = string.match(path, "^([^/]*)/?(.*)$")
	if head == scenePrefix then
		local scene = sceneFolder()
		return scene and walkPath(scene, rest)
	end

	local rigName = head and string.match(head, "^" .. rigPrefix .. "(.+)$")
	if rigName then
		for _, rig in projectRigs() do
			if rig.Name == rigName then
				return walkPath(rig, rest)
			end
		end

		return nil
	end

	local current = game
	for name in string.gmatch(path, "[^%.]+") do
		current = current and current:FindFirstChild(name)
	end

	return current
end

local function alive(instance)
	return typeof(instance) == "Instance" and instance:IsDescendantOf(workspace)
end

local function markDirty()
	local state = getState()
	if state then
		state.currentProjectSaved = false
	end
end

local function notify(dirty)
	revision += 1
	if dirty then
		markDirty()
	end

	for _, callback in table.clone(listeners) do
		task.spawn(callback)
	end
end

function fxKeys.subscribe(callback)
	table.insert(listeners, callback)
	return function()
		local index = table.find(listeners, callback)
		if index then
			table.remove(listeners, index)
		end
	end
end

function fxKeys.revision()
	return revision
end

function fxKeys.list()
	local result = {}
	for _, key in keys do
		table.insert(result, key)
	end

	table.sort(result, function(a, b)
		if a.Frame == b.Frame then
			return a.Id < b.Id
		end

		return a.Frame < b.Frame
	end)
	return result
end

function fxKeys.lastFrame()
	local last
	for _, key in keys do last = math.max(last or 0, key.Frame) end
	return last
end

function fxKeys.get(id)
	return keys[id]
end

function fxKeys.at(frame)
	frame = frameNumber(frame)
	for _, key in keys do
		if key.Frame == frame then
			return key
		end
	end

	return nil
end

function fxKeys.add(frame)
	local existing = fxKeys.at(frame)
	if existing then
		return existing, false
	end

	local key = {
		Id = httpService:GenerateGUID(false),
		Frame = frameNumber(frame),
		Targets = {},
	}
	keys[key.Id] = key
	notify(true)
	return key, true
end

function fxKeys.remove(id)
	if keys[id] then
		keys[id] = nil
		notify(true)
	end
end

local function mergeTargets(target, source)
	target.TargetPaths = target.TargetPaths or {}
	target.MissingPaths = target.MissingPaths or {}
	for _, instance in source.Targets do
		if not table.find(target.Targets, instance) then table.insert(target.Targets, instance) end
		target.TargetPaths[instance] = (source.TargetPaths or {})[instance]
	end
	for _, path in source.MissingPaths or {} do
		if not table.find(target.MissingPaths, path) then table.insert(target.MissingPaths, path) end
	end
end

function fxKeys.move(id, frame)
	local key = keys[id]
	frame = frameNumber(frame)
	if not key or key.Frame == frame then
		return false
	end

	local other = fxKeys.at(frame)
	if other and other ~= key then
		mergeTargets(key, other)

		keys[other.Id] = nil
	end

	key.Frame = frame
	notify(true)
	return true
end

function fxKeys.targets(id)
	local key = keys[id]
	if not key then
		return {}
	end

	key.TargetPaths = key.TargetPaths or {}
	key.MissingPaths = key.MissingPaths or {}
	local result = {}
	for index = #(key.MissingPaths or {}), 1, -1 do
		local target = fxKeys.resolvePath(key.MissingPaths[index])
		if alive(target) then
			if not table.find(key.Targets, target) then
				table.insert(key.Targets, target)
			end
			table.remove(key.MissingPaths, index)
		end
	end
	for index = #key.Targets, 1, -1 do
		local target = key.Targets[index]
		if alive(target) then
			key.TargetPaths[target] = fxKeys.pathOf(target)
			table.insert(result, 1, target)
		else
			local path = key.TargetPaths[target]
			if path and not table.find(key.MissingPaths, path) then table.insert(key.MissingPaths, path) end
			key.TargetPaths[target] = nil
			table.remove(key.Targets, index)
		end
	end

	return result
end

function fxKeys.has(id, instance)
	local key = keys[id]
	return key ~= nil and table.find(key.Targets, instance) ~= nil
end

function fxKeys.setTarget(id, instance, enabled)
	local key = keys[id]
	if not key then
		return
	end

	local index = table.find(key.Targets, instance)
	if enabled and not index then
		table.insert(key.Targets, instance)
		key.TargetPaths = key.TargetPaths or {}
		key.TargetPaths[instance] = fxKeys.pathOf(instance)
	elseif not enabled and index then
		table.remove(key.Targets, index)
		if key.TargetPaths then key.TargetPaths[instance] = nil end
	else
		return
	end

	notify(true)
end

function fxKeys.between(from, to, inclusiveStart)
	local result = {}
	for _, key in keys do
		local after = if inclusiveStart then key.Frame >= from else key.Frame > from
		if after and key.Frame <= to then
			table.insert(result, key)
		end
	end

	table.sort(result, function(a, b)
		return a.Frame < b.Frame
	end)
	return result
end

function fxKeys.snapshot()
	local result = {}
	for _, key in keys do
		table.insert(result, { Id = key.Id, Frame = key.Frame, Targets = table.clone(key.Targets), TargetPaths = table.clone(key.TargetPaths or {}), MissingPaths = table.clone(key.MissingPaths or {}) })
	end

	return result
end

function fxKeys.restore(snapshot)
	table.clear(keys)
	for _, entry in snapshot or {} do
		keys[entry.Id] = { Id = entry.Id, Frame = entry.Frame, Targets = table.clone(entry.Targets), TargetPaths = table.clone(entry.TargetPaths or {}), MissingPaths = table.clone(entry.MissingPaths or {}) }
	end

	notify(true)
end

function fxKeys.insert(frame, targets)
	frame = frameNumber(frame)
	local key = fxKeys.at(frame)
	if not key then
		key = { Id = httpService:GenerateGUID(false), Frame = frame, Targets = {} }
		keys[key.Id] = key
	end

	for _, target in targets or {} do
		if alive(target) and not table.find(key.Targets, target) then
			table.insert(key.Targets, target)
			key.TargetPaths = key.TargetPaths or {}
			key.TargetPaths[target] = fxKeys.pathOf(target)
		end
	end

	notify(true)
	return key
end

function fxKeys.removeMany(ids)
	local changed = false
	for _, id in ids do
		if keys[id] then
			keys[id] = nil
			changed = true
		end
	end

	if changed then
		notify(true)
	end
end

function fxKeys.shift(ids, delta)
	delta = math.round(delta)
	if delta == 0 or #ids == 0 then
		return
	end

	local moving = {}
	for _, id in ids do
		if keys[id] then
			moving[id] = true
		end
	end

	local merged = {}
	for id in moving do
		local key = keys[id]
		local frame = math.max(0, key.Frame + delta)
		merged[frame] = merged[frame] or {}
		table.insert(merged[frame], key)
	end

	for _, key in table.clone(keys) do
		if not moving[key.Id] and merged[key.Frame] then
			table.insert(merged[key.Frame], key)
		end
	end

	for frame, group in merged do
		local survivor = group[1]
		for _, key in group do
			if moving[key.Id] then
				survivor = key
				break
			end
		end

		for _, key in group do
			if key ~= survivor then
				mergeTargets(survivor, key)

				keys[key.Id] = nil
			end
		end

		survivor.Frame = frame
	end

	notify(true)
end

function fxKeys.clear()
	if next(keys) == nil then
		return
	end

	table.clear(keys)
	notify(false)
end

local function writeMarkers(target)
	local state = getState()
	local timeline = state and state.Timeline
	local fps = timeline and timeline:GetState().FPS or 60
	local byFrame = {}
	for _, keyframe in target:GetKeyframes() do
		byFrame[math.floor(keyframe.Time * fps + 0.5)] = keyframe
	end

	for _, key in fxKeys.list() do
		local paths = {}
		for _, instance in fxKeys.targets(key.Id) do
			table.insert(paths, fxKeys.pathOf(instance))
		end

		if #paths == 0 then
			continue
		end

		local keyframe = byFrame[key.Frame]
		if not keyframe then
			keyframe = Instance.new("Keyframe")
			keyframe.Name = "Keyframe"
			keyframe.Time = key.Frame / fps
			keyframe.Parent = target
			byFrame[key.Frame] = keyframe
		end

		local marker = Instance.new("KeyframeMarker")
		marker.Name = markerName
		marker.Value = httpService:JSONEncode(paths)
		marker.Parent = keyframe
	end
end

local function clearMarkers(target)
	if target:IsA("KeyframeSequence") then
		for _, keyframe in target:GetKeyframes() do
			for _, marker in keyframe:GetMarkers() do
				if marker.Name == markerName then
					marker:Destroy()
				end
			end
		end
	end
end

function fxKeys.write(target)
	if not target then
		return
	end

	fxScene.write(target)
	clearMarkers(target)

	local previous = target:FindFirstChild(folderName)
	if next(keys) == nil then
		if previous then
			previous:Destroy()
		end

		return
	end

	local folder = Instance.new("Folder")
	folder.Name = folderName
	folder:SetAttribute("Version", 2)
	for _, key in fxKeys.list() do
		local item = Instance.new("Folder")
		item.Name = key.Id
		item:SetAttribute("Frame", key.Frame)
		for index, instance in fxKeys.targets(key.Id) do
			local reference = Instance.new("ObjectValue")
			reference.Name = "Target"
			reference.Value = instance
			reference:SetAttribute("Path", fxKeys.pathOf(instance))
			reference:SetAttribute("Order", index)
			reference.Parent = item
		end

		for index, path in key.MissingPaths or {} do
			local reference = Instance.new("ObjectValue")
			reference.Name = "Target"
			reference:SetAttribute("Path", path)
			reference:SetAttribute("Order", #key.Targets + index)
			reference.Parent = item
		end
		item.Parent = folder
	end

	folder.Parent = target
	if previous then
		previous:Destroy()
	end

	if target:IsA("KeyframeSequence") then
		writeMarkers(target)
	end
end

function fxKeys.load(source)
	fxScene.load(source)
	table.clear(keys)
	local folder = source and source:FindFirstChild(folderName)
	if folder then
		for _, item in folder:GetChildren() do
			local key = {
				Id = item.Name,
				Frame = frameNumber(item:GetAttribute("Frame")),
				Targets = {},
				MissingPaths = {},
			}
			local references = {}
			for _, reference in item:GetChildren() do
				if reference:IsA("ObjectValue") then
					table.insert(references, reference)
				end
			end

			table.sort(references, function(a, b)
				return (a:GetAttribute("Order") or 0) < (b:GetAttribute("Order") or 0)
			end)
			for _, reference in references do
				local instance = reference.Value
				if not alive(instance) then
					instance = fxKeys.resolvePath(reference:GetAttribute("Path"))
				end

				if alive(instance) and not table.find(key.Targets, instance) then
					table.insert(key.Targets, instance)
				elseif not alive(instance) then
					local path = reference:GetAttribute("Path")
					if type(path) == "string" and path ~= "" then
						table.insert(key.MissingPaths, path)
					end
				end
			end

			keys[key.Id] = key
			fxKeys.targets(key.Id)
		end
	end

	notify(false)
end

return fxKeys
