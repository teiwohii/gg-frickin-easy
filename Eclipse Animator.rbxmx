							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local httpService = game:GetService("HttpService")

local boltShape = require(script.Parent.boltShape)

local boltStrike = {}
boltStrike.__index = boltStrike

boltStrike.attribute = "ArcStrike"
boltStrike.generatorAttribute = "ArcGenerator"
boltStrike.ownedProperty = "Transparency"
boltStrike.dimLevel = 0.2
boltStrike.edge = 0.15
boltStrike.minimumDuration = 0.03
boltStrike.maximumDuration = 10
boltStrike.maximumFlickers = 12
boltStrike.tolerance = 1e-4
boltStrike.minimumShapeTime = 0.02
boltStrike.maximumShapeTime = 5
boltStrike.maximumAmount = 3
boltStrike.maximumSamples = 24
boltStrike.seedLimit = 2147483647
boltStrike.seedFactors = { 7919, 104729, 1299709 }
boltStrike.configCache = setmetatable({}, { __mode = "k" })
boltStrike.partCache = setmetatable({}, { __mode = "k" })
boltStrike.geometryCache = setmetatable({}, { __mode = "k" })

boltStrike.defaults = {
	enabled = true,
	duration = 0.35,
	travel = 0.15,
	flickers = 2,
	fade = 0.4,
	base = 0,
	reshape = true,
	shapeTime = 0.1,
	smooth = 1,
	amount = 1,
}

function boltStrike.clampNumber(value: any, fallback: number, minimum: number, maximum: number): number
	local number = if typeof(value) == "number" and value == value then value else fallback

	return math.clamp(number, minimum, maximum)
end

function boltStrike.normalize(data: any)
	local defaults = boltStrike.defaults
	local source = if typeof(data) == "table" then data else {}

	return {
		enabled = if typeof(source.enabled) == "boolean" then source.enabled else defaults.enabled,
		duration = boltStrike.clampNumber(source.duration, defaults.duration, boltStrike.minimumDuration, boltStrike.maximumDuration),
		travel = boltStrike.clampNumber(source.travel, defaults.travel, 0, 1),
		flickers = math.round(boltStrike.clampNumber(source.flickers, defaults.flickers, 0, boltStrike.maximumFlickers)),
		fade = boltStrike.clampNumber(source.fade, defaults.fade, 0, 1),
		base = boltStrike.clampNumber(source.base, defaults.base, 0, 1),
		reshape = if typeof(source.reshape) == "boolean" then source.reshape else defaults.reshape,
		shapeTime = boltStrike.clampNumber(source.shapeTime, defaults.shapeTime, boltStrike.minimumShapeTime, boltStrike.maximumShapeTime),
		smooth = boltStrike.clampNumber(source.smooth, defaults.smooth, 0, 1),
		amount = boltStrike.clampNumber(source.amount, defaults.amount, 0, boltStrike.maximumAmount),
	}
end

function boltStrike.copy(config)
	return table.clone(boltStrike.normalize(config))
end

function boltStrike.isCandidate(instance: any): boolean
	return typeof(instance) == "Instance" and instance:IsA("Model")
end

function boltStrike.decode(raw: any)
	if typeof(raw) ~= "string" then
		return nil
	end

	local success, data = pcall(function()
		return httpService:JSONDecode(raw)
	end)

	return if success and typeof(data) == "table" then data else nil
end

function boltStrike.read(instance: Instance)
	if not boltStrike.isCandidate(instance) then
		return nil
	end

	local raw = instance:GetAttribute(boltStrike.attribute)

	if typeof(raw) ~= "string" then
		return nil
	end

	local generator = instance:GetAttribute(boltStrike.generatorAttribute)
	local cached = boltStrike.configCache[instance]

	if cached and cached.raw == raw and cached.generator == generator then
		return cached.config
	end

	local config = boltStrike.normalize(boltStrike.decode(raw))
	local shape = boltStrike.decode(generator)
	local params = if shape and typeof(shape.p) == "table" then shape.p else nil

	if params and typeof(params.Transparency) == "number" then
		config.base = math.clamp(params.Transparency, 0, 1)
	end

	boltStrike.configCache[instance] = { raw = raw, generator = generator, config = config }

	return config
end

function boltStrike.write(instance: Instance, config)
	instance:SetAttribute(boltStrike.attribute, httpService:JSONEncode(boltStrike.normalize(config)))
end

function boltStrike.clear(instance: Instance)
	instance:SetAttribute(boltStrike.attribute, nil)
	boltStrike.configCache[instance] = nil
end

function boltStrike.has(instance: any): boolean
	if not boltStrike.isCandidate(instance) then
		return false
	end

	local config = boltStrike.read(instance)

	return config ~= nil and config.enabled
end

function boltStrike.owns(instance: Instance, name: string): boolean
	if name ~= boltStrike.ownedProperty then
		return false
	end

	local parent = instance.Parent

	return parent ~= nil and parent:GetAttribute(boltStrike.attribute) ~= nil and instance:IsA("BasePart") and boltStrike.has(parent)
end

function boltStrike.getHosts(source: any): { Instance }
	return if boltStrike.has(source) then { source } else {}
end

function boltStrike.buildParts(model: Model)
	local pivot = model:GetPivot()
	local records = {}
	local length = 0
	local indexed = true

	for order, child in model:GetChildren() do
		if child:IsA("BasePart") then
			local distance = -pivot:PointToObjectSpace(child.Position).Z
			local index = child:GetAttribute(boltShape.indexAttribute)

			if typeof(index) ~= "number" then
				indexed = false
			end

			table.insert(records, { part = child, distance = distance, progress = 0, index = index, order = order })
			length = math.max(length, distance + child.Size.Z / 2)
		end
	end

	if indexed then
		table.sort(records, function(first, second)
			if first.index ~= second.index then
				return first.index < second.index
			end

			return first.order < second.order
		end)
	end

	for _, record in records do
		record.progress = if length > 0 then math.clamp(record.distance / length, 0, 1) else 0
	end

	return records
end

function boltStrike.getGeometry(model: Instance)
	local raw = model:GetAttribute(boltShape.generatorAttribute)

	if typeof(raw) ~= "string" then
		return nil
	end

	local cached = boltStrike.geometryCache[model]

	if cached and cached.raw == raw then
		return cached.geometry
	end

	local params = boltShape.decode(raw)
	local geometry = nil

	if params then
		geometry = {
			params = params,
			base = boltShape.sample(params, params.Seed),
			samples = {},
			sampleCount = 0,
			count = boltShape.getPartCount(params),
		}
	end

	boltStrike.geometryCache[model] = { raw = raw, geometry = geometry }

	return geometry
end

function boltStrike.isShaped(model: any): boolean
	if not boltStrike.has(model) then
		return false
	end

	local config = boltStrike.read(model)
	local geometry = if config.reshape then boltStrike.getGeometry(model) else nil

	return geometry ~= nil and #boltStrike.getParts(model) == geometry.count
end

function boltStrike.ownsPart(instance: Instance): boolean
	local parent = instance.Parent

	return parent ~= nil and parent:GetAttribute(boltStrike.attribute) ~= nil and instance:IsA("BasePart") and boltStrike.isShaped(parent)
end

function boltStrike.getSeed(geometry, strike: number, step: number): number
	local seed = math.floor(geometry.params.Seed)

	if strike == 0 and step == 0 then
		return seed
	end

	local factors = boltStrike.seedFactors

	return (seed * factors[1] + step * factors[2] + strike * factors[3]) % boltStrike.seedLimit
end

function boltStrike.getSample(geometry, seed: number)
	if seed == math.floor(geometry.params.Seed) then
		return geometry.base
	end

	local sample = geometry.samples[seed]

	if sample then
		return sample
	end

	if geometry.sampleCount >= boltStrike.maximumSamples then
		table.clear(geometry.samples)
		geometry.sampleCount = 0
	end

	sample = boltShape.sample(geometry.params, seed)
	geometry.samples[seed] = sample
	geometry.sampleCount += 1

	return sample
end

function boltStrike.getShapeStep(config, age: number): (number, number)
	local position = math.max(age, 0) / config.shapeTime
	local step = math.floor(position)
	local smooth = config.smooth

	if smooth <= 0 then
		return step, 0
	end

	local glide = math.clamp((position - step - (1 - smooth)) / smooth, 0, 1)

	return step, glide * glide * (3 - 2 * glide)
end

function boltStrike.getScale(model: Model): number
	local success, scale = pcall(function()
		return model:GetScale()
	end)

	return if success and typeof(scale) == "number" and scale > 0 then scale else 1
end

function boltStrike.setGeometry(model: Model, segments)
	local pivot = model:GetPivot()
	local tolerance = boltStrike.tolerance

	for index, record in boltStrike.getParts(model) do
		local segment = segments[index]
		local part = record.part

		if segment then
			if (part.Size - segment.size).Magnitude > tolerance then
				part.Size = segment.size
			end

			part.CFrame = pivot * segment.cframe
		end
	end
end

function boltStrike.applyShape(model: Model, config, strike: number, age: number)
	local geometry = boltStrike.getGeometry(model)

	if not geometry then
		return
	end

	local step, alpha = boltStrike.getShapeStep(config, age)
	local from = boltStrike.getSample(geometry, boltStrike.getSeed(geometry, strike, step))
	local to = if alpha > 0 then boltStrike.getSample(geometry, boltStrike.getSeed(geometry, strike, step + 1)) else from

	boltStrike.setGeometry(model, boltShape.compose(geometry.params, geometry.base, from, to, alpha, config.amount, boltStrike.getScale(model)))
end

function boltStrike.restoreShape(model: Model)
	local geometry = boltStrike.getGeometry(model)

	if geometry then
		boltStrike.setGeometry(model, boltShape.compose(geometry.params, geometry.base, geometry.base, geometry.base, 0, 0, boltStrike.getScale(model)))
	end
end

function boltStrike.getParts(model: Model)
	local cached = boltStrike.partCache[model]

	if cached then
		local first = cached[1]
		local last = cached[#cached]

		if first and first.part.Parent == model and last.part.Parent == model then
			return cached
		end
	end

	local records = boltStrike.buildParts(model)

	boltStrike.partCache[model] = records

	return records
end

function boltStrike.isPlayable(source: any): boolean
	return boltStrike.has(source) and #boltStrike.getParts(source) > 0
end

function boltStrike.getStrikeLength(config, stretch: number?): number
	if typeof(stretch) == "number" and stretch > 0 then
		return math.max(stretch, boltStrike.minimumDuration)
	end

	return config.duration
end

function boltStrike.resolveStrikes(count: number?): number
	if typeof(count) ~= "number" or count ~= count then
		return 1
	end

	return math.max(1, math.round(count))
end

function boltStrike.getTotalLength(config, count: number?, stretch: number?): number
	return boltStrike.getStrikeLength(config, stretch) * boltStrike.resolveStrikes(count)
end

function boltStrike.getPhases(config, length: number): (number, number)
	local travel = config.travel
	local fade = config.fade
	local sum = travel + fade

	if sum > 1 then
		travel /= sum
		fade /= sum
	end

	return travel * length, length * (1 - fade)
end

function boltStrike.getVisibility(config, age: number, progress: number, length: number): number
	if age < 0 or age >= length then
		return 0
	end

	local travelEnd, fadeStart = boltStrike.getPhases(config, length)
	local reveal = 1

	if travelEnd > 0 and age < travelEnd then
		local edge = boltStrike.edge
		local head = age / travelEnd * (1 + edge)

		reveal = math.clamp((head - progress) / edge, 0, 1)
	end

	local level = 1

	if age >= fadeStart and length > fadeStart then
		level = 1 - (age - fadeStart) / (length - fadeStart)
	elseif age >= travelEnd and config.flickers > 0 and fadeStart > travelEnd then
		local slots = config.flickers * 2 + 1
		local slot = math.floor((age - travelEnd) / (fadeStart - travelEnd) * slots)

		if slot % 2 == 1 then
			level = boltStrike.dimLevel
		end
	end

	return math.clamp(reveal * level, 0, 1)
end

function boltStrike.getAgeAt(config, age: number?, count: number?, stretch: number?): number?
	if typeof(age) ~= "number" or age < 0 then
		return nil
	end

	local length = boltStrike.getStrikeLength(config, stretch)

	if age >= length * boltStrike.resolveStrikes(count) then
		return nil
	end

	return age % length
end

function boltStrike.setTransparency(part: BasePart, transparency: number)
	if math.abs(part.Transparency - transparency) > boltStrike.tolerance then
		part.Transparency = transparency
	end
end

function boltStrike.apply(model: Model, config, age: number?, count: number?, stretch: number?)
	local length = boltStrike.getStrikeLength(config, stretch)
	local strikeAge = boltStrike.getAgeAt(config, age, count, stretch)
	local opacity = 1 - config.base

	if strikeAge and boltStrike.isShaped(model) then
		boltStrike.applyShape(model, config, math.floor((age :: number) / length), strikeAge)
	end

	for _, record in boltStrike.getParts(model) do
		local visibility = if strikeAge then boltStrike.getVisibility(config, strikeAge, record.progress, length) else 0

		boltStrike.setTransparency(record.part, 1 - opacity * visibility)
	end
end

function boltStrike.applyRest(model: Instance)
	local config = boltStrike.read(model)

	if not config then
		return
	end

	if boltStrike.isShaped(model) then
		boltStrike.restoreShape(model :: Model)
	end

	for _, record in boltStrike.getParts(model :: Model) do
		boltStrike.setTransparency(record.part, config.base)
	end
end

return boltStrike
]]></ProtectedString>
