								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local spatial = require(script.Parent.Parent.spatial)
local Tool = require(script.Parent.Tool)

local TransformTool = Tool.extend()

TransformTool.id = "Transform"
TransformTool.title = "Transform"
TransformTool.keywords = "move rotate scale offset nudge reset origin"
TransformTool.spaces = { "World", "Local" }

function TransformTool.new(context)
	local self = setmetatable({}, TransformTool)

	Tool.init(self, context, {
		Move = Vector3.zero,
		Rotate = Vector3.zero,
		Scale = 1,
		Space = "World",
	})

	return self
end

function TransformTool:getFields()
	return {
		self:field("Move", "Move", "vector3", { tip = "Studs to move by on each axis." }),
		self:field("Rotate", "Rotate", "vector3", { tip = "Degrees to turn by on each axis." }),
		self:field("Scale", "Scale", "number", { minimum = 0.01, range = { min = 0.1, max = 4 }, tip = "1 keeps the size. 2 doubles it, including particle sizes and beam widths." }),
		self:choice("Space", "Space", TransformTool.spaces, { tip = "World uses the world axes. Local uses each object's own axes." }),
		self:action("Apply", "Apply Transform", function()
			self:apply()
		end, nil, true),
		self:action("ResetRotation", "Reset Rotation", function()
			self:resetRotation()
		end, "Turn the selection back to no rotation."),
		self:action("ToOrigin", "Move To Origin", function()
			self:moveToOrigin()
		end, "Move the selection onto the asset origin."),
	}
end

function TransformTool:apply()
	local roots = self:requireRoots(true)

	if not roots then
		return
	end

	local params = self.params
	local rotation = CFrame.fromOrientation(math.rad(params.Rotate.X), math.rad(params.Rotate.Y), math.rad(params.Rotate.Z))

	self:run("Transform", function()
		for _, root in roots do
			local pivot = spatial.getPivot(root)

			if pivot then
				local target

				if params.Space == "Local" then
					target = pivot * CFrame.new(params.Move) * rotation
				else
					target = (rotation * pivot.Rotation) + (pivot.Position + params.Move)
				end

				spatial.setPivot(root, target)
				spatial.scale(root, params.Scale, target.Position)
			end
		end
	end)
end

function TransformTool:resetRotation()
	local roots = self:requireRoots(true)

	if not roots then
		return
	end

	self:run("Reset Rotation", function()
		for _, root in roots do
			local pivot = spatial.getPivot(root)

			if pivot then
				spatial.setPivot(root, CFrame.new(pivot.Position))
			end
		end
	end)
end

function TransformTool:moveToOrigin()
	local roots = self:requireRoots(true)

	if not roots then
		return
	end

	local center = spatial.getCenter(roots)
	local delta = self:getOrigin() - center

	self:run("Move To Origin", function()
		for _, root in roots do
			local pivot = spatial.getPivot(root)

			if pivot then
				spatial.setPivot(root, pivot + delta)
			end
		end
	end)
end

return TransformTool
]]></ProtectedString>
								<string name="ScriptGuid">{84802CCC-534A-4F52-BA60-8AB1D3820C42}</string>
