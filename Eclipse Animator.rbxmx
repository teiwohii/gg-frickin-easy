								<bool name="DefinesCapabilities">false</bool>
								<string name="Name">shards</string>
								<BinaryString name="SerializedOverrides"></BinaryString>
								<int64 name="SourceAssetId">-1</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX6AB4F92BEFAA495A86CB71740F6B2567">
							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local ShapeKit = require(script.Parent.ShapeKit)

local bezier = {}

bezier.id = "Bezier"
bezier.title = "Bezier Path"
bezier.root = "Part"
bezier.handlePrefix = "Handle"
bezier.pointNames = { "P0", "P1", "P2", "P3" }

bezier.params = ShapeKit.join({
	{ name = "P0", label = "Start", kind = "vector3", default = Vector3.new(0, 0, -6) },
	{ name = "P1", label = "Start Handle", kind = "vector3", default = Vector3.new(4, 3, -2) },
	{ name = "P2", label = "End Handle", kind = "vector3", default = Vector3.new(-4, 3, 2) },
	{ name = "P3", label = "End", kind = "vector3", default = Vector3.new(0, 0, 6) },
	{ name = "Resolution", kind = "number", default = 8, min = 1, max = 32, integer = true, tip = "How many beams the path is split into." },
	{ name = "Width", kind = "number", default = 1, min = 0, max = 50 },
	{ name = "EndWidth", label = "End Width", kind = "number", default = 1, min = 0, max = 50 },
	{ name = "ShowPoints", label = "Show Points", kind = "toggle", default = true, tip = "Shows the four control points in the viewport. Move them with Studio's Move tool, then press Rebuild." },
}, ShapeKit.beamParams({ Texture = "" }))

function bezier.capture(root: Instance, params)
	for index, name in bezier.pointNames do
		local handle = root:FindFirstChild(bezier.handlePrefix .. (index - 1))

		if handle and handle:IsA("Attachment") then
			params[name] = handle.Position
		end
	end
end

function bezier.getPoint(value): Vector3
	return if typeof(value) == "Vector3" then value else Vector3.zero
end

function bezier.build(kit, params)
	local first = bezier.getPoint(params.P0)
	local second = bezier.getPoint(params.P1)
	local third = bezier.getPoint(params.P2)
	local fourth = bezier.getPoint(params.P3)
	local count = math.clamp(math.round(params.Resolution), 1, 32)
	local samples = {}

	for index = 0, count do
		local time = index / count
		local inverse = 1 - time
		local position = first * inverse ^ 3 + second * 3 * inverse ^ 2 * time + third * 3 * inverse * time ^ 2 + fourth * time ^ 3
		local derivative = (second - first) * 3 * inverse ^ 2 + (third - second) * 6 * inverse * time + (fourth - third) * 3 * time ^ 2

		table.insert(samples, {
			position = position,
			tangent = derivative,
			normal = Vector3.yAxis,
			handle = derivative.Magnitude / count / 3,
			width = params.Width + (params.EndWidth - params.Width) * time,
		})
	end

	kit:path(samples, { closed = false })

	for index, name in bezier.pointNames do
		kit:attachment(bezier.handlePrefix .. (index - 1), CFrame.new(bezier.getPoint(params[name])), params.ShowPoints)
	end
end

return bezier
]]></ProtectedString>
								<string name="ScriptGuid">{8E5E4C1B-E954-48D1-937A-44968CA439F9}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
