				<Item class="ModuleScript" referent="RBX13558325597C48748D40F34EA3DF930C">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- riftkuro

local sharedCode = {}

local function valid(object)
	return typeof(object) == "Instance" and object:IsA("ModuleScript") and object.Parent ~= nil
end

function sharedCode.resolve(name, value)
	local bindings = shared.EclipsePreviewModules
	local explicit = if type(bindings) == "table" then bindings[name] else nil
	if explicit ~= nil then
		assert(
			valid(explicit),
			"shared.EclipsePreviewModules." .. name .. " must be a ModuleScript"
		)
		return explicit
	end

	local callback = type(value) == "table" and value.emit
	local origin = type(callback) == "function" and debug.info(callback, "s")
	if origin then
		local current = game
		for piece in origin:gmatch("[^.]+") do
			if current == game and (piece == "game" or piece == "Game") then
				continue
			end
			current = current and current:FindFirstChild(piece)
		end
		if valid(current) then
			return current
		end
	end

	if name == "vfx" then
		local found
		for _, service in { "ServerScriptService", "ReplicatedStorage", "ServerStorage" } do
			local candidate = game:GetService(service):FindFirstChild("EmitModule")
			if valid(candidate) then
				assert(
					not found,
					"Multiple EmitModules found. Set shared.EclipsePreviewModules.vfx to the module used by your effect."
				)
				found = candidate
			end
		end
		if found then
			return found
		end
	end

	error(
		"Paused and scrubbed shared."
			.. name
			.. " previews require the emitter's local ModuleScript. Add EmitModule to ServerScriptService or set shared.EclipsePreviewModules."
			.. name
			.. " to that ModuleScript.",
		2
	)
end

return sharedCode
]]></ProtectedString>
