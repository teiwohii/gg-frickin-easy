						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)

local groupsValue = {}
groupsValue.POSE = "Pose"

function groupsValue.clone(value)
	return type(value) == "table" and table.clone(value) or nil
end

function groupsValue.get(key, lane)
	local id = type(key.KeyGroups) == "table" and key.KeyGroups[lane]
	return type(id) == "string" and #id > 0 and id or nil
end

function groupsValue.set(key, lane, id)
	key.KeyGroups = groupsValue.clone(key.KeyGroups) or {}
	key.KeyGroups[lane] = id
	if not next(key.KeyGroups) then
		key.KeyGroups = nil
	end
end

function groupsValue.hasLane(key, lane)
	if lane == groupsValue.POSE then
		for _, point in key.GraphCurves or {} do
			if not point.Empty then
				return true
			end
		end

		return not key.GraphOnly
	end

	local point = key.GraphCurves and key.GraphCurves[lane]
	if point then
		return not point.Empty
	end

	return key.Channels and key.Channels[lane] ~= nil
end

function groupsValue.collect(bucket, lane)
	local result = {}
	for frame, key in bucket do
		local id = groupsValue.get(key, lane)
		if id and groupsValue.hasLane(key, lane) then
			result[id] = result[id] or {}
			table.insert(result[id], { key = key, frame = frame })
		end
	end

	for id, members in result do
		if #members < 2 then
			result[id] = nil
		else
			table.sort(members, function(a, b)
				return a.frame < b.frame
			end)
		end
	end

	return result
end

function groupsValue.range(bucket, selected, lane)
	local first, last, count = math.huge, -math.huge, 0
	for frame, key in bucket do
		if selected[key] and groupsValue.hasLane(key, lane) then
			first, last, count = math.min(first, frame), math.max(last, frame), count + 1
		end
	end

	if count < 2 then
		return {}
	end

	local groups = groupsValue.collect(bucket, lane)
	local growing = true
	while growing do
		growing = false
		for _, members in groups do
			local a, b = members[1].frame, members[#members].frame
			if a <= last and b >= first and (a < first or b > last) then
				first, last, growing = math.min(first, a), math.max(last, b), true
			end
		end
	end

	local result = {}
	for frame, key in bucket do
		if frame >= first and frame <= last and groupsValue.hasLane(key, lane) then
			table.insert(result, { key = key, frame = frame })
		end
	end

	table.sort(result, function(a, b)
		return a.frame < b.frame
	end)
	return result
end

function groupsValue.majority(members, shape)
	local counts, best, maximum = {}, nil, 0
	for _, member in members do
		local value = shape(member)
		counts[value] = (counts[value] or 0) + 1
	end

	for _, member in members do
		local value = shape(member)
		if counts[value] > maximum then
			best, maximum = value, counts[value]
		end
	end

	return best
end

function groupsValue.transfer(source, target, lane)
	groupsValue.set(target, lane, groupsValue.get(source, lane))
	groupsValue.set(source, lane, nil)
end

function groupsValue.remap(value, ids, newId)
	local result = groupsValue.clone(value)
	for lane, id in result or {} do
		ids[id] = ids[id] or newId()
		result[lane] = ids[id]
	end

	return result
end

return groupsValue
