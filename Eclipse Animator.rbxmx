							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local Serializer = {}
Serializer.__index = Serializer

function Serializer.new(keyOf: (Instance) -> string?, instanceOf: (string) -> Instance?)
	local self = setmetatable({}, Serializer)

	self.keyOf = keyOf
	self.instanceOf = instanceOf

	return self
end

function Serializer:encode(value)
	local kind = typeof(value)

	if kind == "boolean" or kind == "string" then
		return { t = kind, v = value }
	elseif kind == "number" then
		return { t = kind, v = value }
	elseif kind == "CFrame" then
		return { t = kind, v = { value:GetComponents() } }
	elseif kind == "Vector3" then
		return { t = kind, v = { value.X, value.Y, value.Z } }
	elseif kind == "Vector2" then
		return { t = kind, v = { value.X, value.Y } }
	elseif kind == "Color3" then
		return { t = kind, v = { value.R, value.G, value.B } }
	elseif kind == "BrickColor" then
		return { t = kind, v = value.Number }
	elseif kind == "UDim" then
		return { t = kind, v = { value.Scale, value.Offset } }
	elseif kind == "UDim2" then
		return { t = kind, v = { value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset } }
	elseif kind == "NumberRange" then
		return { t = kind, v = { value.Min, value.Max } }
	elseif kind == "Rect" then
		return { t = kind, v = { value.Min.X, value.Min.Y, value.Max.X, value.Max.Y } }
	elseif kind == "NumberSequence" then
		local points = {}

		for _, keypoint in value.Keypoints do
			table.insert(points, { keypoint.Time, keypoint.Value, keypoint.Envelope })
		end

		return { t = kind, v = points }
	elseif kind == "ColorSequence" then
		local points = {}

		for _, keypoint in value.Keypoints do
			table.insert(points, { keypoint.Time, keypoint.Value.R, keypoint.Value.G, keypoint.Value.B })
		end

		return { t = kind, v = points }
	elseif kind == "EnumItem" then
		return { t = kind, v = { tostring(value.EnumType), value.Name } }
	elseif kind == "Instance" then
		local key = self.keyOf(value)
		return if key then { t = kind, v = key } else nil
	elseif kind == "table" then
		local encoded = {}

		for name, item in value do
			if typeof(name) == "string" then
				local packed = self:encode(item)

				if packed then
					encoded[name] = packed
				end
			end
		end

		return { t = kind, v = encoded }
	end

	return nil
end

function Serializer:decode(packed)
	if typeof(packed) ~= "table" then
		return nil
	end

	local kind = packed.t
	local value = packed.v
	local success, result = pcall(function()
		if kind == "boolean" or kind == "string" or kind == "number" then
			return value
		elseif kind == "CFrame" then
			return CFrame.new(table.unpack(value))
		elseif kind == "Vector3" then
			return Vector3.new(value[1], value[2], value[3])
		elseif kind == "Vector2" then
			return Vector2.new(value[1], value[2])
		elseif kind == "Color3" then
			return Color3.new(value[1], value[2], value[3])
		elseif kind == "BrickColor" then
			return BrickColor.new(value)
		elseif kind == "UDim" then
			return UDim.new(value[1], value[2])
		elseif kind == "UDim2" then
			return UDim2.new(value[1], value[2], value[3], value[4])
		elseif kind == "NumberRange" then
			return NumberRange.new(value[1], value[2])
		elseif kind == "Rect" then
			return Rect.new(value[1], value[2], value[3], value[4])
		elseif kind == "NumberSequence" then
			local keypoints = {}

			for _, point in value do
				table.insert(keypoints, NumberSequenceKeypoint.new(point[1], point[2], point[3] or 0))
			end

			return NumberSequence.new(keypoints)
		elseif kind == "ColorSequence" then
			local keypoints = {}

			for _, point in value do
				table.insert(keypoints, ColorSequenceKeypoint.new(point[1], Color3.new(point[2], point[3], point[4])))
			end

			return ColorSequence.new(keypoints)
		elseif kind == "EnumItem" then
			return (Enum :: any)[value[1]][value[2]]
		elseif kind == "Instance" then
			return self.instanceOf(value)
		elseif kind == "table" then
			local decoded = {}

			for name, item in value do
				local unpacked = self:decode(item)

				if unpacked ~= nil then
					decoded[name] = unpacked
				end
			end

			return decoded
		end

		return nil
	end)

	return if success then result else nil
end

return Serializer
]]></ProtectedString>
							<string name="ScriptGuid">{F30D391D-5222-4887-B254-B53B1BA407A1}</string>
