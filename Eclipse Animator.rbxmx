					<Item class="ModuleScript" referent="RBX06AEDD676FD94857A9C78A28AF80BFB4">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local valueCodec = {}
valueCodec.__index = valueCodec

valueCodec.glideKinds = {
	number = true,
	Vector3 = true,
	Vector2 = true,
	Color3 = true,
	UDim = true,
	UDim2 = true,
	NumberRange = true,
}

valueCodec.blendKinds = {
	NumberSequence = true,
	ColorSequence = true,
}

function valueCodec.kind(value): string
	return typeof(value)
end

function valueCodec.pack(value): { number }?
	local kind = typeof(value)

	if kind == "number" then
		return { value }
	elseif kind == "Vector3" then
		return { value.X, value.Y, value.Z }
	elseif kind == "Vector2" then
		return { value.X, value.Y }
	elseif kind == "Color3" then
		return { value.R, value.G, value.B }
	elseif kind == "UDim" then
		return { value.Scale, value.Offset }
	elseif kind == "UDim2" then
		return { value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset }
	elseif kind == "NumberRange" then
		return { value.Min, value.Max }
	elseif kind == "NumberSequence" then
		local packed = {}

		for _, keypoint in value.Keypoints do
			table.insert(packed, keypoint.Time)
			table.insert(packed, keypoint.Value)
			table.insert(packed, keypoint.Envelope)
		end

		return packed
	elseif kind == "ColorSequence" then
		local packed = {}

		for _, keypoint in value.Keypoints do
			table.insert(packed, keypoint.Time)
			table.insert(packed, keypoint.Value.R)
			table.insert(packed, keypoint.Value.G)
			table.insert(packed, keypoint.Value.B)
		end

		return packed
	end

	return nil
end

function valueCodec.unpack(kind: string, packed: { number })
	if kind == "number" then
		return packed[1]
	elseif kind == "Vector3" then
		return Vector3.new(packed[1], packed[2], packed[3])
	elseif kind == "Vector2" then
		return Vector2.new(packed[1], packed[2])
	elseif kind == "Color3" then
		return Color3.new(math.clamp(packed[1], 0, 1), math.clamp(packed[2], 0, 1), math.clamp(packed[3], 0, 1))
	elseif kind == "UDim" then
		return UDim.new(packed[1], math.round(packed[2]))
	elseif kind == "UDim2" then
		return UDim2.new(packed[1], math.round(packed[2]), packed[3], math.round(packed[4]))
	elseif kind == "NumberRange" then
		local minimum = math.min(packed[1], packed[2])
		local maximum = math.max(packed[1], packed[2])
		return NumberRange.new(minimum, maximum)
	elseif kind == "NumberSequence" then
		local keypoints = {}

		for index = 1, #packed, 3 do
			table.insert(keypoints, NumberSequenceKeypoint.new(math.clamp(packed[index], 0, 1), packed[index + 1], math.max(packed[index + 2], 0)))
		end

		return NumberSequence.new(keypoints)
	elseif kind == "ColorSequence" then
		local keypoints = {}

		for index = 1, #packed, 4 do
			local color = Color3.new(math.clamp(packed[index + 1], 0, 1), math.clamp(packed[index + 2], 0, 1), math.clamp(packed[index + 3], 0, 1))
			table.insert(keypoints, ColorSequenceKeypoint.new(math.clamp(packed[index], 0, 1), color))
		end

		return ColorSequence.new(keypoints)
	end

	return nil
end

valueCodec.componentLayouts = {
	Vector3 = {
		columns = 3,
		keys = { "X", "Y", "Z" },
		labels = { X = "X", Y = "Y", Z = "Z" },
	},
	Vector2 = {
		columns = 2,
		keys = { "X", "Y" },
		labels = { X = "X", Y = "Y" },
	},
	CFrame = {
		columns = 2,
		keys = { "AX", "PX", "AY", "PY", "AZ", "PZ" },
		labels = { AX = "Angle X", AY = "Angle Y", AZ = "Angle Z", PX = "Pos X", PY = "Pos Y", PZ = "Pos Z" },
	},
}

function valueCodec.getComponentLayout(value)
	return valueCodec.componentLayouts[typeof(value)]
end

function valueCodec.getComponents(value): { [string]: number }?
	local kind = typeof(value)

	if kind == "Vector3" then
		return { X = value.X, Y = value.Y, Z = value.Z }
	elseif kind == "Vector2" then
		return { X = value.X, Y = value.Y }
	elseif kind == "CFrame" then
		local rx, ry, rz = value:ToOrientation()

		return {
			PX = value.X,
			PY = value.Y,
			PZ = value.Z,
			AX = math.deg(rx),
			AY = math.deg(ry),
			AZ = math.deg(rz),
		}
	end

	return nil
end

function valueCodec.fromComponents(sample, components: { [string]: number })
	local kind = typeof(sample)

	if kind == "Vector3" then
		return Vector3.new(components.X, components.Y, components.Z)
	elseif kind == "Vector2" then
		return Vector2.new(components.X, components.Y)
	elseif kind == "CFrame" then
		return CFrame.new(components.PX, components.PY, components.PZ) * CFrame.fromOrientation(math.rad(components.AX), math.rad(components.AY), math.rad(components.AZ))
	end

	return sample
end

function valueCodec.withComponents(value, edits: { [string]: number })
	local components = valueCodec.getComponents(value)

	if not components then
		return value
	end

	for key, number in edits do
		if components[key] ~= nil then
			components[key] = number
		end
	end

	return valueCodec.fromComponents(value, components)
end

function valueCodec.isGlidable(value): boolean
	return valueCodec.glideKinds[typeof(value)] == true
end

function valueCodec.isBlendable(value): boolean
	return valueCodec.blendKinds[typeof(value)] == true
end

function valueCodec.isCompatible(a, b): boolean
	if typeof(a) ~= typeof(b) then
		return false
	end

	local packedA = valueCodec.pack(a)
	local packedB = valueCodec.pack(b)

	return packedA ~= nil and packedB ~= nil and #packedA == #packedB
end

function valueCodec.equals(a, b, tolerance: number): boolean
	if typeof(a) ~= typeof(b) then
		return false
	end

	local packedA = valueCodec.pack(a)
	local packedB = valueCodec.pack(b)

	if packedA and packedB then
		if #packedA ~= #packedB then
			return false
		end

		for index = 1, #packedA do
			if math.abs(packedA[index] - packedB[index]) > tolerance then
				return false
			end
		end

		return true
	end

	return a == b
end

function valueCodec.round(value: number): string
	local rounded = math.round(value * 1000) / 1000

	if rounded == 0 then
		rounded = 0
	end

	return tostring(rounded)
end

function valueCodec.join(values: { number }): string
	local parts = {}

	for _, value in values do
		table.insert(parts, valueCodec.round(value))
	end

	return table.concat(parts, ", ")
end

function valueCodec.format(value): string
	local kind = typeof(value)

	if value == nil then
		return "None"
	elseif kind == "number" then
		return valueCodec.round(value)
	elseif kind == "boolean" then
		return tostring(value)
	elseif kind == "string" then
		return value
	elseif kind == "EnumItem" then
		return value.Name
	elseif kind == "Instance" then
		return value.Name
	elseif kind == "Color3" then
		return valueCodec.join({ math.round(value.R * 255), math.round(value.G * 255), math.round(value.B * 255) })
	elseif kind == "CFrame" then
		local rx, ry, rz = value:ToOrientation()
		return valueCodec.join({ value.X, value.Y, value.Z, math.deg(rx), math.deg(ry), math.deg(rz) })
	elseif kind == "NumberSequence" then
		local parts = {}

		for _, keypoint in value.Keypoints do
			table.insert(parts, valueCodec.join({ keypoint.Time, keypoint.Value, keypoint.Envelope }))
		end

		return table.concat(parts, "; ")
	elseif kind == "ColorSequence" then
		local parts = {}

		for _, keypoint in value.Keypoints do
			local color = keypoint.Value
			table.insert(parts, valueCodec.join({ keypoint.Time, math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255) }))
		end

		return table.concat(parts, "; ")
	end

	local packed = valueCodec.pack(value)

	if packed then
		return valueCodec.join(packed)
	end

	return tostring(value)
end

function valueCodec.readNumbers(text: string): { number }
	local numbers = {}

	for token in string.gmatch(text, "[^,%s{}%(%)]+") do
		local number = tonumber(token)

		if number then
			table.insert(numbers, number)
		end
	end

	return numbers
end

function valueCodec.parseSequence(text: string, stride: number): { { number } }?
	local groups = {}

	for chunk in string.gmatch(text, "[^;]+") do
		local numbers = valueCodec.readNumbers(chunk)

		if #numbers < stride - (if stride == 3 then 1 else 0) then
			return nil
		end

		table.insert(groups, numbers)
	end

	if #groups < 2 then
		return nil
	end

	return groups
end

function valueCodec.parse(text: string, sample)
	local kind = typeof(sample)
	local numbers = valueCodec.readNumbers(text)

	if kind == "number" then
		return numbers[1]
	elseif kind == "string" then
		return text
	elseif kind == "boolean" then
		local lowered = string.lower(text)
		if lowered == "true" then
			return true
		elseif lowered == "false" then
			return false
		end
		return nil
	elseif kind == "Vector3" and #numbers >= 3 then
		return Vector3.new(numbers[1], numbers[2], numbers[3])
	elseif kind == "Vector2" and #numbers >= 2 then
		return Vector2.new(numbers[1], numbers[2])
	elseif kind == "Color3" and #numbers >= 3 then
		return Color3.fromRGB(math.clamp(numbers[1], 0, 255), math.clamp(numbers[2], 0, 255), math.clamp(numbers[3], 0, 255))
	elseif kind == "UDim" and #numbers >= 2 then
		return UDim.new(numbers[1], numbers[2])
	elseif kind == "UDim2" and #numbers >= 4 then
		return UDim2.new(numbers[1], numbers[2], numbers[3], numbers[4])
	elseif kind == "NumberRange" and #numbers >= 1 then
		return NumberRange.new(math.min(numbers[1], numbers[2] or numbers[1]), math.max(numbers[1], numbers[2] or numbers[1]))
	elseif kind == "CFrame" and #numbers >= 3 then
		local rotation = CFrame.fromOrientation(math.rad(numbers[4] or 0), math.rad(numbers[5] or 0), math.rad(numbers[6] or 0))
		return CFrame.new(numbers[1], numbers[2], numbers[3]) * rotation
	elseif kind == "NumberSequence" then
		local groups = valueCodec.parseSequence(text, 3)

		if not groups then
			return nil
		end

		local keypoints = {}

		for _, group in groups do
			table.insert(keypoints, NumberSequenceKeypoint.new(math.clamp(group[1], 0, 1), group[2] or 0, math.max(group[3] or 0, 0)))
		end

		local success, sequence = pcall(NumberSequence.new, keypoints)
		return if success then sequence else nil
	elseif kind == "ColorSequence" then
		local groups = valueCodec.parseSequence(text, 4)

		if not groups then
			return nil
		end

		local keypoints = {}

		for _, group in groups do
			local color = Color3.fromRGB(math.clamp(group[2] or 0, 0, 255), math.clamp(group[3] or 0, 0, 255), math.clamp(group[4] or 0, 0, 255))
			table.insert(keypoints, ColorSequenceKeypoint.new(math.clamp(group[1], 0, 1), color))
		end

		local success, sequence = pcall(ColorSequence.new, keypoints)
		return if success then sequence else nil
	end

	return nil
end

return valueCodec
]]></ProtectedString>
