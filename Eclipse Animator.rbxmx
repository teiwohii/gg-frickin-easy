						<ProtectedString name="Source"><![CDATA[--!native
-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local rigTraversal = require("rigTraversal")

local document = require("document")
local chunks = require("chunkStore")
local interp = require("interp")
local camera = require("cameraRig")
local paths = require("paths")
local tracksValue = {}
local meshTexturePrefix = "MeshTexture:"
local textureTargets = setmetatable({}, { __mode = "k" })
local textureDefinitions = {}

local function textureProperty(object)
	if object:IsA("MeshPart") then
		return "TextureID"
	elseif object:IsA("SpecialMesh") then
		return "TextureId"
	end
end

local function textureDefinition(id)
	if id:sub(1, #meshTexturePrefix) ~= meshTexturePrefix then
		return nil
	end
	if textureDefinitions[id] then
		return textureDefinitions[id]
	end
	local path = id:sub(#meshTexturePrefix + 1)
	local ok, steps =
		pcall(game:GetService("HttpService").JSONDecode, game:GetService("HttpService"), path)
	if not ok or type(steps) ~= "table" or #steps == 0 then
		return nil
	end
	local names = {}
	for _, step in steps do
		if
			type(step) ~= "table"
			or type(step[1]) ~= "string"
			or type(step[2]) ~= "string"
			or type(step[3]) ~= "number"
			or step[3] < 1
			or step[3] % 1 ~= 0
		then
			return nil
		end
		table.insert(names, step[1] .. (step[3] > 1 and " (" .. step[3] .. ")" or ""))
	end
	local class = steps[#steps][2]
	if class ~= "MeshPart" and class ~= "SpecialMesh" then
		return nil
	end
	local definition = {
		id = id,
		label = "Mesh Texture / " .. table.concat(names, "/"),
		kind = "string",
		texturePath = path,
		textureId = steps[#steps][4],
	}
	textureDefinitions[id] = definition
	return definition
end

local function textureTarget(rig, definition)
	local cache = textureTargets[rig]
	if not cache then
		cache = {}
		textureTargets[rig] = cache
	end
	local entry = cache[definition.id]
	if entry and entry.object and entry.object:IsDescendantOf(rig) then
		return entry.object, textureProperty(entry.object)
	end
	if entry and not entry.object and os.clock() - entry.time < 0.5 then
		return nil
	end
	local object = paths.resolve(rig, definition.texturePath)
	if
		definition.textureId
		and (not object or object:GetAttribute("EclipseMeshTextureId") ~= definition.textureId)
	then
		object = nil
		for _, candidate in rigTraversal.rigDescendants(rig) do
			if
				textureProperty(candidate)
				and not paths.excluded(candidate, rig)
				and candidate:GetAttribute("EclipseMeshTextureId") == definition.textureId
			then
				if object then
					object = nil
					break
				end
				object = candidate
			end
		end
	end
	local property = object and textureProperty(object)
	if not property or paths.excluded(object, rig) then
		object = nil
	end
	cache[definition.id] = { object = object, time = os.clock() }
	return object, property
end

local faces = setmetatable({}, { __mode = "k" })
local faceNames = {
	"ChinRaiser",
	"ChinRaiserUpperLip",
	"Corrugator",
	"EyesLookDown",
	"EyesLookLeft",
	"EyesLookRight",
	"EyesLookUp",
	"FlatPucker",
	"Funneler",
	"JawDrop",
	"JawLeft",
	"JawRight",
	"LeftBrowLowerer",
	"LeftCheekPuff",
	"LeftCheekRaiser",
	"LeftDimpler",
	"LeftEyeClosed",
	"LeftEyeUpperLidRaiser",
	"LeftInnerBrowRaiser",
	"LeftLipCornerDown",
	"LeftLipCornerPuller",
	"LeftLipStretcher",
	"LeftLowerLipDepressor",
	"LeftNoseWrinkler",
	"LeftOuterBrowRaiser",
	"LeftUpperLipRaiser",
	"LipPresser",
	"LipsTogether",
	"LowerLipSuck",
	"MouthLeft",
	"MouthRight",
	"Pucker",
	"RightBrowLowerer",
	"RightCheekPuff",
	"RightCheekRaiser",
	"RightDimpler",
	"RightEyeClosed",
	"RightEyeUpperLidRaiser",
	"RightInnerBrowRaiser",
	"RightLipCornerDown",
	"RightLipCornerPuller",
	"RightLipStretcher",
	"RightLowerLipDepressor",
	"RightNoseWrinkler",
	"RightOuterBrowRaiser",
	"RightUpperLipRaiser",
	"TongueDown",
	"TongueOut",
	"TongueUp",
	"UpperLipSuck",
}

function tracksValue.faceControls(rig)
	if typeof(rig) ~= "Instance" then
		return nil
	end
	if rig:IsA("FaceControls") then
		return rig
	end
	if rig == workspace or not (rig:IsA("Model") or rig:IsA("BasePart")) then
		return nil
	end
	local cached = faces[rig]
	if
		cached
		and (
			cached.value and cached.value:IsDescendantOf(rig)
			or not cached.value and os.clock() - cached.time < 0.5
		)
	then
		return cached.value
	end
	local head = rig:IsA("Model") and rig:FindFirstChild("Head", true) or rig
	local value = head and head:FindFirstChildWhichIsA("FaceControls", true)
		or rig:FindFirstChildWhichIsA("FaceControls", true)
	faces[rig] = { value = value, time = os.clock() }
	return value
end

local function faceProperty(rig, id)
	local name = id:match("^FaceControls%.(.+)$")
	if not name or not table.find(faceNames, name) then
		return nil
	end
	local controls = tracksValue.faceControls(rig)
	return controls, name
end
local EventDependencies = require("EventDependencies")

local function write(object, key, value)
	if EventDependencies.isPosing() then
		EventDependencies.poseWrite(object, key, value)
	else
		object[key] = value
	end
end

local effectObjects = require("objects")
local emitKeys = require("emitKeys")
local nodes = setmetatable({}, { __mode = "k" })
local folders = setmetatable({}, { __mode = "k" })
local owners = setmetatable({}, { __mode = "k" })
local meshes = setmetatable({}, { __mode = "k" })
local hooks = setmetatable({}, { __mode = "k" })
local shifts = setmetatable({}, { __mode = "k" })
local placed = setmetatable({}, { __mode = "k" })
local schemas = {
	{ "Model", { "CFrame", "Scale", "Transparency", "Color", "Reflectance" } },
	{
		"BasePart",
		{
