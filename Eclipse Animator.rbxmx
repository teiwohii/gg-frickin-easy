						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local FlipbookQuad = {}
FlipbookQuad.__index = FlipbookQuad

FlipbookQuad.pixelsPerStud = 64
FlipbookQuad.thickness = 0.05
FlipbookQuad.gridSizes = {
	[Enum.ParticleFlipbookLayout.Grid2x2] = 2,
	[Enum.ParticleFlipbookLayout.Grid4x4] = 4,
	[Enum.ParticleFlipbookLayout.Grid8x8] = 8,
}
FlipbookQuad.facingModes = {
	[Enum.ParticleOrientation.FacingCamera] = true,
	[Enum.ParticleOrientation.FacingCameraWorldUp] = true,
}

function FlipbookQuad.getGridSize(emitter: ParticleEmitter): number?
	if emitter.FlipbookLayout == Enum.ParticleFlipbookLayout.Custom then
		return math.max(1, emitter.FlipbookSizeX)
	end
	return FlipbookQuad.gridSizes[emitter.FlipbookLayout]
end

function FlipbookQuad.getGridDimensions(emitter: ParticleEmitter): (number?, number?)
	local x = FlipbookQuad.getGridSize(emitter)
	local y = if emitter.FlipbookLayout == Enum.ParticleFlipbookLayout.Custom then math.max(1, emitter.FlipbookSizeY) else x
	return x, y
end

function FlipbookQuad.supports(emitter: ParticleEmitter): boolean
	return FlipbookQuad.getGridSize(emitter) ~= nil and FlipbookQuad.facingModes[emitter.Orientation] == true
end

function FlipbookQuad.getFrameIndex(emitter: ParticleEmitter, age: number, life: number, seed: number): number
	local x, y = FlipbookQuad.getGridDimensions(emitter)
	local count = (x or 1) * (y or 1)
	local random = Random.new(seed)
	local range = emitter.FlipbookFramerate
	local framerate = if range.Max > range.Min then random:NextNumber(range.Min, range.Max) else range.Min
	local start = if emitter.FlipbookStartRandom then random:NextInteger(0, count - 1) else 0
	local step = math.floor(age * math.max(framerate, 0))
	local mode = emitter.FlipbookMode

	if mode == Enum.ParticleFlipbookMode.OneShot then
		local progress = if life > 0 then age / life else 0

		return math.clamp(start + math.floor(progress * count), 0, count - 1)
	elseif mode == Enum.ParticleFlipbookMode.PingPong then
		local period = math.max(count * 2 - 2, 1)
		local position = (start + step) % period

		return if position < count then position else period - position
	elseif mode == Enum.ParticleFlipbookMode.Random then
		return Random.new(seed + step * 7919):NextInteger(0, count - 1)
	end

	return (start + step) % count
end

function FlipbookQuad.new(name: string)
	local self = setmetatable({}, FlipbookQuad)

	local part = Instance.new("Part")
	part.Name = name
	part.Archivable = false
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Locked = true
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, FlipbookQuad.thickness)

	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Archivable = false
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = FlipbookQuad.pixelsPerStud
	gui.Adornee = part
	gui.Parent = part

	local clip = Instance.new("Frame")
	clip.Name = "Clip"
	clip.BackgroundTransparency = 1
	clip.BorderSizePixel = 0
	clip.ClipsDescendants = true
	clip.Size = UDim2.fromScale(1, 1)
	clip.Parent = gui

	local image = Instance.new("ImageLabel")
	image.Name = "Sheet"
	image.BackgroundTransparency = 1
	image.BorderSizePixel = 0
	image.Parent = clip

	self.part = part
	self.gui = gui
	self.image = image
	self.position = Vector3.zero
	self.rotation = 0
	self.zOffset = 0
	self.worldUp = false
	self.visible = false

	return self
end

function FlipbookQuad:show(state)
	local x, y = state.gridX or state.grid, state.gridY or state.grid
	local column = state.frame % x
	local row = state.frame // x
	local image = self.image

	image.Image = state.texture
	image.Size = UDim2.fromScale(x, y)
	image.Position = UDim2.fromScale(-column, -row)
	image.ImageColor3 = state.color
	image.ImageTransparency = state.transparency
	self.gui.Brightness = state.brightness
	self.gui.LightInfluence = state.lightInfluence
	self.dimensions = Vector3.new(math.max(state.width, 0.01), math.max(state.height, 0.01), 0)
	self.part.Size = Vector3.new(self.dimensions.X, self.dimensions.Y, FlipbookQuad.thickness)
	self.position = state.position
	self.rotation = state.rotation
	self.zOffset = state.zOffset
	self.worldUp = state.worldUp
	self.visible = true
	self:face(workspace.CurrentCamera)
	self.part.Parent = workspace.Terrain
end

function FlipbookQuad:face(camera: Camera?)
	if not camera then
		return
	end

	local cameraFrame = camera.CFrame
	local position = self.position
	local depth = (position - cameraFrame.Position):Dot(cameraFrame.LookVector)
	local scale = depth > 1e-6 and math.max(0.001, depth - self.zOffset) / depth or 1
	position = cameraFrame.Position + (position - cameraFrame.Position) * scale
	local size = self.dimensions * scale
	self.part.Size = Vector3.new(math.max(0.001, size.X), math.max(0.001, size.Y), FlipbookQuad.thickness)

	local basis = cameraFrame.Rotation

	if self.worldUp then
		local look = cameraFrame.LookVector

		if math.abs(look.Y) < 0.999 then
			basis = CFrame.lookAt(Vector3.zero, look, Vector3.yAxis)
		end
	end

	self.part.CFrame = CFrame.new(position) * basis * CFrame.Angles(0, 0, math.rad(self.rotation))
end

function FlipbookQuad:hide()
	if not self.visible then
		return
	end

	self.visible = false
	self.part.Parent = nil
end

function FlipbookQuad:destroy()
	self.visible = false
	self.part:Destroy()
end

return FlipbookQuad
]]></ProtectedString>
							<string name="ScriptGuid">{179F7D76-431C-4940-ACB5-575C2D0AED4C}</string>
