						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local require = require(script:FindFirstAncestor("container").requireModule)

local fxScene = {}

local sceneFolderName = "Eclipse FX"
local savedName = "EclipseFXScene"
local ownerAttribute = "EclipseFXProject"
local projectIdAttribute = "EclipseProjectId"
local backupFolderName = "EclipseFXSceneBackups"
local backupLimit = 5
local unsavedOwner = "Unsaved"

local activeSave = nil

local function sceneFolder(create)
	local folder = workspace:FindFirstChild(sceneFolderName)
	if folder and folder:IsA("Folder") then
		return folder
	end

	if not create then
		return nil
	end

	folder = Instance.new("Folder")
	folder.Name = sceneFolderName
	folder.Parent = workspace
	return folder
end

local function projectKey(source)
	if typeof(source) ~= "Instance" then
		return nil
	end

	local id = source:GetAttribute(projectIdAttribute)
	if type(id) == "string" and id ~= "" then
		return id
	end

	return nil
end

local function isSave(source)
	return typeof(source) == "Instance" and source:IsA("Folder") and source:GetAttribute("EclipseSave") == true
end

local function copyAttributes(from, to)
	for name in to:GetAttributes() do
		if name ~= ownerAttribute then
			to:SetAttribute(name, nil)
		end
	end

	for name, value in from:GetAttributes() do
		if name ~= ownerAttribute then
			to:SetAttribute(name, value)
		end
	end
end

local function copyChildren(from, to)
	local copy = assert(from:Clone(), "Unable to copy FX scene")
	local ok, message = xpcall(function()
		require("eclipseEmit").MeshParticle.restoreTree(copy)
		for _, child in copy:GetChildren() do
			child.Parent = to
		end
	end, debug.traceback)
	copy:Destroy()
	if not ok then
		error(message, 0)
	end
end

local function backupRoot()
	local ok, folder = pcall(function()
		return require("root").get(backupFolderName, true)
	end)
	if ok and folder then
		return folder
	end

	local storage = game:GetService("ServerStorage")
	folder = storage:FindFirstChild(backupFolderName)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = backupFolderName
		folder.Parent = storage
	end

	return folder
end

local function trimBackups(root)
	local backups = {}
	for _, child in root:GetChildren() do
		table.insert(backups, child)
	end

	table.sort(backups, function(a, b)
		return (a:GetAttribute("At") or 0) > (b:GetAttribute("At") or 0)
	end)
	for index = backupLimit + 1, #backups do
		backups[index]:Destroy()
	end
end

local function backup(scene)
	local root = backupRoot()
	local folder = Instance.new("Folder")
	folder.Name = os.date("Scene %Y-%m-%d %H.%M.%S")
	copyAttributes(scene, folder)
	folder:SetAttribute("At", os.time())
	folder:SetAttribute("Project", scene:GetAttribute(ownerAttribute))
	for _, child in scene:GetChildren() do
		child.Parent = folder
	end

	folder.Parent = root
	trimBackups(root)
end

local function findSave(key)
	if not key then
		return nil
	end

	if activeSave and activeSave.Parent and projectKey(activeSave) == key then
		return activeSave
	end

	local ok, saves = pcall(function()
		return require("root").get("EclipseAnimator_Saves", false)
	end)
	if not ok or not saves then
		return nil
	end

	for _, candidate in saves:GetDescendants() do
		if isSave(candidate) and projectKey(candidate) == key then
			return candidate
		end
	end

	return nil
end

local function clearScene(scene)
	for _, child in scene:GetChildren() do
		child:Destroy()
	end
end

function fxScene.write(target)
	if typeof(target) ~= "Instance" or not target:IsA("Folder") then
		return
	end

	local scene = sceneFolder(false)
	local previous = target:FindFirstChild(savedName)
	local saved = Instance.new("Folder")
	saved.Name = savedName
	if scene then
		copyAttributes(scene, saved)
		copyChildren(scene, saved)
	end

	saved.Parent = target
	if previous then
		previous:Destroy()
	end

	if isSave(target) then
		activeSave = target
		local key = projectKey(target)
		if scene and key then
			scene:SetAttribute(ownerAttribute, key)
		end
	end
end

function fxScene.load(source)
	local key = projectKey(source)
	local scene = sceneFolder(false)
	if scene and key and scene:GetAttribute(ownerAttribute) == key then
		activeSave = isSave(source) and source or activeSave
		return
	end

	local saved = typeof(source) == "Instance" and source:FindFirstChild(savedName)
	if scene and key and not saved and scene:GetAttribute(ownerAttribute) == nil and isSave(source) then
		scene:SetAttribute(ownerAttribute, key)
		activeSave = source
		return
	end

	if scene and #scene:GetChildren() > 0 then
		local owner = findSave(scene:GetAttribute(ownerAttribute))
		if owner then
			fxScene.write(owner)
			clearScene(scene)
		else
			backup(scene)
		end
	end

	if saved or scene then
		scene = sceneFolder(true)
		if saved then
			copyAttributes(saved, scene)
			copyChildren(saved, scene)
		end

		scene:SetAttribute(ownerAttribute, key or unsavedOwner)
	end

	activeSave = isSave(source) and source or nil
end

return fxScene
]]></ProtectedString>
