							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local runService = game:GetService("RunService")
local lighting = game:GetService("Lighting")
local utilities = require(script.Parent.utilities)
local sample = utilities.sample
local sequence = utilities.sequence
local curve = utilities.curve
local mix = utilities.mix
local setProperty = utilities.setProperty
local getCFrame = utilities.getCFrame
local cleanClone = utilities.cleanClone
local vector = utilities.vector
local randomVector = utilities.randomVector
local rotation = utilities.rotation
local random = utilities.random
local zero = utilities.ZERO
local directions = utilities.directions

local handlers = {}

function handlers.Create(context)
    local handle, own, schedule, animate = context.Handle, context.Own, context.Schedule, context.Animate
    local container, root, playbackSpeed = context.Container, context.Root, context.Speed
    local visit = context.Walk

    local function interpolateAttribute(attributes, key, progress, default)
        local startValue = sample(attributes[key .. "_Start"], default)
        local endValue = sample(attributes[key .. "_End"], startValue)
        return mix(startValue, endValue, curve(attributes[key .. "_Curve"], progress))
    end

    local function emitParticle(instance)
        local effect = utilities.isRuntime(instance) and instance or own(instance:Clone())
        cleanClone(effect)
        handle._propertyCopies[instance] = effect
        effect.Enabled = false
        effect.Parent = instance.Parent
        local attributes = instance:GetAttributes()
        local delay = sample(attributes.EmitDelay, 0)
        local duration = math.max(0, sample(attributes.EmitDuration, 0))
        local nativeTimeScale = effect.TimeScale
        effect.Rate *= playbackSpeed
        effect.TimeScale = math.clamp(nativeTimeScale * playbackSpeed, 0, 1)
        schedule(delay, function()
            if not effect.Parent then
                return
            end
            handle.Stats.Particles += 1
            if attributes.TimeScale_Start ~= nil then
                effect.TimeScale = math.clamp(attributes.TimeScale_Start * playbackSpeed, 0, 1)
            end
            effect:Emit(math.max(0, math.floor(sample(attributes.EmitCount, 1))))
            if duration > 0 then
                effect.Enabled = true
                schedule(duration, function()
                    if effect.Parent then
                        effect.Enabled = false
                    end
                end, instance)
            end
            if attributes.TimeScale_Start ~= nil or attributes.TimeScale_End ~= nil then
                local start = attributes.TimeScale_Start or nativeTimeScale
                animate(attributes.TimeScale_Duration or 0.1, function(progress)
                    if effect.Parent then
                        effect.TimeScale = math.clamp(mix(
                            start,
                            attributes.TimeScale_End or start,
                            curve(attributes.TimeScale_Curve, progress)
                        ) * playbackSpeed, 0, 1)
                    end
                end, nil, instance)
            end
            local minScale = math.min(
                math.clamp((attributes.TimeScale_Start or nativeTimeScale) * playbackSpeed, 0, 1),
                math.clamp((attributes.TimeScale_End or nativeTimeScale) * playbackSpeed, 0, 1)
            )
            local tail = effect.Lifetime.Max / math.max(minScale, 0.01) * playbackSpeed
            schedule(duration + tail + 0.1, function()
                effect:Destroy()
            end, instance)
        end, instance)
    end

    local function animateProperty(instance)
        local target = instance.Parent
        local property = instance.Name
        local attributes = instance:GetAttributes()
        local success, initial = pcall(function()
            return target[property]
        end)
        if not success or attributes._END_VALUE == nil then
            return
        end
        local copy = handle._propertyCopies[target]
        if not copy and utilities.isRuntime(target) then
            copy = target
            handle._propertyCopies[target] = copy
        end
        if not copy then
            copy = own(target:Clone())
            cleanClone(copy)
            for _, child in copy:GetChildren() do
                if child:IsA("RayValue") then
                    child:Destroy()
                end
            end
            copy.Parent = target.Parent
            handle._propertyCopies[target] = copy
        end
        schedule(attributes.EmitDelay or 0, function()
            handle.Stats.Properties += 1
            if typeof(initial) == "boolean" then
                copy[property] = attributes._END_VALUE
            end
            local firstSpeed = sample(attributes.Speed_Start, 1)
            local lastSpeed = sample(attributes.Speed_End, firstSpeed)
            local ramp = math.max(sample(attributes.Speed_Duration, 0.1), 0.001)
            animate(sample(attributes.Duration, 0.5), function(progress)
                if not copy.Parent then
                    return
                end
                if typeof(initial) ~= "boolean" then
                    setProperty(copy, property, mix(
                        initial,
                        attributes._END_VALUE,
                        curve(attributes.Easing_Curve, progress)
                    ))
                end
            end, function()
                if attributes.ResetOnFinish then
                    copy[property] = initial
                end
            end, instance, function(_, elapsed)
                return mix(firstSpeed, lastSpeed, curve(attributes.Speed_Curve, math.min(elapsed / ramp, 1)))
            end)
        end, instance)
    end

    local function emitMeshPair(model)
        local start, finish = model:FindFirstChild("Start"), model:FindFirstChild("End")
        if not start or not finish or not start:IsA("BasePart") or not finish:IsA("BasePart") then
            return
        end
        local attributes = model:GetAttributes()
        local count = math.max(0, math.floor(sample(attributes.EmitCount, 1)))
        local times = table.create(count, sample(attributes.EmitDelay, 0))
        local duration = math.max(0, sample(attributes.EmitDuration, 0))
        local rate = math.max(0, sample(attributes.Rate, 0))
        if rate > 0 then
            for index = 1, math.floor(duration * rate) do
                table.insert(times, sample(attributes.EmitDelay, 0) + index / rate)
            end
        end
        for _, delay in times do
            schedule(delay, function()
                local attributes = table.clone(attributes)
                for key, value in attributes do
                    if typeof(value) == "NumberRange" then
                        attributes[key] = sample(value, 0)
                    end
                end
                local effect = own(start:Clone())
                cleanClone(effect)
                effect.Name = model.Name .. "_Emitted"
                effect.Anchored = true
                effect.CanCollide = false
                effect.CanTouch = false
                effect.CanQuery = false
                local startCFrame, endCFrame = start.CFrame, finish.CFrame
                local initialAngles = randomVector(attributes.MinInitRot or zero, attributes.MaxInitRot or zero)
                local spread = attributes.SpreadAngle or zero
                initialAngles += randomVector(- spread, spread)
                local initialRotation = rotation(initialAngles)
                local startRotationSpeed = sample(attributes.Part_RotSpeed_Start, 0)
                local endRotationSpeed = sample(attributes.Part_RotSpeed_End, startRotationSpeed)
                local angle = 0
                local startMesh = effect:FindFirstChildOfClass("SpecialMesh")
                local endMesh = finish:FindFirstChildOfClass("SpecialMesh")
                local meshScale = startMesh and startMesh.Scale
                local meshOffset = startMesh and startMesh.Offset
                local decals = {}
                for _, decal in effect:GetChildren() do
                    if decal:IsA("Decal") or decal:IsA("Texture") then
                        local endDecal = finish:FindFirstChild(decal.Name)
                        table.insert(decals, {
                            instance = decal,
                            attributes = decal:GetAttributes(),
                            startValue = decal.Transparency,
                            endValue = endDecal and endDecal.Transparency or 1
                        })
                    end
                end
                effect.Parent = container
                local lifetime = sample(attributes.EffectDuration, 0.5)
                local branch = { finished = false, after = {} }
                for _, child in effect:GetChildren() do
                    visit(child, branch)
                end
                handle.Stats.Meshes += 1
                local origin = model:GetPivot()
                local firstSpeed = sample(attributes.Speed_Start, 1)
                local lastSpeed = sample(attributes.Speed_End, firstSpeed)
                animate(lifetime, function(progress, deltaTime)
                    angle += mix(
                        startRotationSpeed,
                        endRotationSpeed,
                        curve(attributes.Part_RotSpeed_Curve, progress)
                    ) * deltaTime
                    local position = startCFrame:Lerp(endCFrame, curve(attributes.Part_CFrame_Curve, progress))
                    if attributes.SyncPosition then
                        position = model:GetPivot() * origin:Inverse() * position
                    end
                    local rotationAngles = initialRotation * CFrame.Angles(0, angle, 0)
                    if attributes.RotAroundOrigin then
                        position = origin * rotationAngles * origin:Inverse() * position
                    else
                        position = position * rotationAngles
                    end
                    effect.CFrame = position
                    effect.Size = start.Size:Lerp(finish.Size, curve(attributes.Part_Size_Curve, progress)):Max(Vector3.one * 0.001)
                    effect.Color = start.Color:Lerp(finish.Color, progress)
                    effect.Transparency = math.clamp(
                        interpolateAttribute(attributes, "Part_Transparency", progress, start.Transparency),
                        0,
                        1
                    )
                    if startMesh and endMesh then
                        startMesh.Scale = meshScale:Lerp(endMesh.Scale, curve(attributes.Mesh_Scale_Curve, progress))
                        startMesh.Offset = meshOffset:Lerp(endMesh.Offset, curve(attributes.Mesh_Offset_Curve, progress))
                    end
                    for _, decal in decals do
                        local startValue = decal.attributes.Transparency_Start
                        if startValue == nil then
                            startValue = decal.startValue == 1 and 0 or decal.startValue
                        end
                        local endValue = decal.attributes.Transparency_End
                        if endValue == nil then
                            endValue = decal.endValue
                        end
                        decal.instance.Transparency = math.clamp(mix(startValue, endValue, curve(
                            decal.attributes.Transparency_Curve or attributes.Part_Transparency_Curve,
                            progress
                        )), 0, 1)
                    end
                end, function()
                    utilities.closeBranch(branch)
                    utilities.hideGeometry(effect)
                end, model, function(_, elapsed)
                    local ramp = math.max(sample(attributes.Speed_Duration, 0.1), 0.001)
                    return mix(firstSpeed, lastSpeed, curve(attributes.Speed_Curve, math.min(elapsed / ramp, 1)))
                end)
            end, model)
        end
    end

    local function blendGraphs(source, copy, progress)
        local folder = source:FindFirstChild("GraphBlender")
        if not folder then
            return
        end
        local frames = folder:GetChildren()
        table.sort(frames, function(a, b)
            return (a:GetAttribute("Time") or 0) < (b:GetAttribute("Time") or 0)
        end)
        if #frames == 0 then
            return
        end
        local a, b = frames[1], frames[#frames]
        for i = 2, #frames do
            if progress <= (frames[i]:GetAttribute("Time") or 1) then
                a, b = frames[i - 1], frames[i]
                break
            end
        end
        local u = math.clamp(
            (progress - (a:GetAttribute("Time") or 0)) / math.max((b:GetAttribute("Time") or 1) - (a:GetAttribute("Time") or 0), 1e-8),
            0,
            1
        )
        u = sequence(b:GetAttribute("Transition"), u, u)
        for _, key in { "Color", "Transparency", "Width" } do
            local av, bv = a:GetAttribute(key), b:GetAttribute(key)
            if av and bv then
                local points = {}
                for j = 0, 19 do
                    local v = mix(sequence(av, j / 19), sequence(bv, j / 19), u)
                    points[j + 1] = key == "Color" and ColorSequenceKeypoint.new(j / 19, v)
                        or NumberSequenceKeypoint.new(j / 19, key == "Transparency" and math.clamp(v, 0, 1) or math.max(v, 0))
                end
                if key ~= "Width" or copy:IsA("Trail") then
                    copy[key == "Width" and "WidthScale" or key] = key == "Color" and ColorSequence.new(points) or NumberSequence.new(points)
                end
            end
        end
    end

    local function emitConfigured(source)
        local config = source:FindFirstChild("PartIcleProperties")
        local attributes = config:GetAttributes()
        local emitterAttributes = source:GetAttributes()
        local rate = math.max(0, sample(attributes.Rate, 10))
        local duration = math.max(0, sample(emitterAttributes.EmitDuration, 0))
        local burstCount = math.max(0, math.floor(sample(emitterAttributes.EmitCount, 1)))
        local function spawn(index, total)
            local template = source:FindFirstChild("RenderTemplate") or source
            local effect = own(template:Clone())
            cleanClone(effect)
            local noise = random:NextNumber(- 1, 1)
            local life = sample(attributes.BeamLifetime or attributes.Lifetime, 0.5)
            local timeGraph = attributes.PLTimescale or attributes.BeamTimescale or attributes.TEmitTimescale
                or attributes.HLTimescale or attributes.Timescale
            local base = getCFrame(source)
            local link = source:FindFirstChild("Link")
            local linked = link and link:IsA("ObjectValue") and link.Value
            local linkOffset = linked and getCFrame(linked):ToObjectSpace(base)
            local function basis()
                if linked and linked.Parent and emitterAttributes.LinkMode == "Follow" then
                    return getCFrame(linked) * linkOffset
                end
                return base
            end
            local function ranged(key)
                local fraction = attributes[key .. "Even"]
                and ((index - 1) / math.max(total, 1)) or nil
                return sample(attributes[key], 0, fraction)
            end
            local position = Vector3.new(ranged("PosX"), ranged("PosY"), ranged("PosZ"))
            local rotationAngles = Vector3.new(ranged("RotX"), ranged("RotY"), ranged("RotZ"))
            local initialRot = rotationAngles
            local distance = zero
            local accelerationVelocity = zero
            local dir = directions[attributes.EmissionDirection] or Vector3.yAxis
            local spread = attributes.SpreadAngle or Vector2.zero
            dir = (rotation(Vector3.new(
                random:NextNumber(- spread.X, spread.X),
                random:NextNumber(- spread.Y, spread.Y),
                0
            ))):VectorToWorldSpace(dir)
            if attributes.InvertMotion then
                dir = - dir
            end
            dir = base:VectorToWorldSpace(dir)
            local rocking = emitterAttributes.IsRocks
            local originalSize = effect:IsA("BasePart") and effect.Size
            local chunkScale = rocking and sample(attributes.ChunkScale, 1) or 1
            local gravity = rocking and sample(attributes.Gravity, workspace.Gravity) or 0
            local bounce = sample(attributes.Bounciness, 0.3)
            local friction = sample(attributes.Friction, 0.3)
            local velocity = dir * sequence(attributes.Speed, 0, 0, noise)
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = { container, root }
            local hitGroup = attributes.HitFilterGroup
            if typeof(hitGroup) == "string" and hitGroup ~= "" then
                pcall(function()
                    rayParams.CollisionGroup = hitGroup
                end)
            end
            if emitterAttributes.IsCameraShake then
                effect:Destroy()
            elseif effect:IsA("BasePart") then
                effect.Anchored = true
                effect.CanCollide = false
                effect.CanTouch = false
                effect.CanQuery = false
                effect.CFrame = base
                effect.Parent = container
            elseif effect:IsA("PostEffect") then
                effect.Enabled = true
                effect.Parent = lighting
            else
                effect.Parent = source.Parent
                if effect:IsA("Light") or effect:IsA("Beam") or effect:IsA("Trail") or effect:IsA("Highlight") then
                    effect.Enabled = true
                end
            end
            if effect:IsA("Trail") then
                effect.Lifetime = math.max(0, sample(attributes.TEmitTrailLife, effect.Lifetime))
            elseif effect:IsA("Highlight") then
                local target = source:FindFirstChild("Adornee")
                local adorn = target and target:IsA("ObjectValue") and target.Value or effect.Adornee
                local ancestor = source.Parent
                while not adorn and ancestor and ancestor ~= workspace do
                    if ancestor:IsA("BasePart") or ancestor:IsA("Model") then
                        adorn = ancestor
                    end
                    ancestor = ancestor.Parent
                end
                effect.Adornee = adorn
                if attributes.HLDepthMode then
                    effect.DepthMode = Enum.HighlightDepthMode[attributes.HLDepthMode]
                end
            end
            handle._propertyCopies[source] = effect
            if not emitterAttributes.IsCameraShake then
                for _, child in effect:GetChildren() do
                    visit(child)
                end
            end
            handle.Stats.Custom += 1
            local seed = random:NextNumber(0, 1000)
            local oldShake = CFrame.identity
            local renderName
            local shakeToken
            local shakeCF = CFrame.identity
            if emitterAttributes.IsCameraShake and runService:IsClient() then
                renderName = "EclipseEmitShake_" .. game:GetService("HttpService"):GenerateGUID(false)
                local appliedCamera
                runService:BindToRenderStep(renderName, Enum.RenderPriority.Camera.Value - 1, function()
                    if appliedCamera and appliedCamera == workspace.CurrentCamera then
                        appliedCamera.CFrame = appliedCamera.CFrame * oldShake:Inverse()
                    end
                    oldShake = CFrame.identity
                end)
                runService:BindToRenderStep(renderName .. "_Apply", Enum.RenderPriority.Camera.Value + 1, function()
                    appliedCamera = workspace.CurrentCamera
                    if appliedCamera then
                        appliedCamera.CFrame *= shakeCF
                        oldShake = shakeCF
                    end
                end)
                local token = Instance.new("Folder")
                token.Name = "CameraShakeCleanup" token.Parent = container
                shakeToken = token
                token.Destroying:Connect(function()
                    runService:UnbindFromRenderStep(renderName)
                    runService:UnbindFromRenderStep(renderName .. "_Apply")
                    if appliedCamera and appliedCamera == workspace.CurrentCamera then
                        appliedCamera.CFrame *= oldShake:Inverse()
                    end
                end)
            end
            local function graph(key, progress, default)
                return sequence(attributes[key], progress, default, noise)
            end
            animate(life, function(progress, deltaTime, age)
                if emitterAttributes.IsCameraShake then
                    local f = graph("ShakeFrequency", progress, 25)
                    local amp = graph("ShakeAmplitude", progress, 0)
                    local ramp = math.rad(graph("ShakeRotAmplitude", progress, 0))
                    local falloff = sample(attributes.ShakeFalloff, 0)
                    if falloff > 0 and workspace.CurrentCamera then
                        amp *= math.clamp(
                            1 - (workspace.CurrentCamera.CFrame.Position - base.Position).Magnitude / falloff,
                            0,
                            1
                        )
                    end
                    local burstCount = Vector3.new(
                        math.noise(seed, age * f, 0),
                        math.noise(seed, age * f, 17),
                        math.noise(seed, age * f, 31)
                    ) * 2
                    shakeCF = CFrame.new(burstCount * amp) * CFrame.Angles(burstCount.X * ramp, burstCount.Y * ramp, burstCount.Z * ramp)
                    return
                end
                if not effect.Parent then
                    return
                end
                if effect:IsA("Light") then
                    setProperty(effect, "Brightness", graph("PLBrightness", progress, 1))
                    setProperty(effect, "Range", graph("PLRange", progress, 8))
                    effect.Color = graph("PLColor", progress, effect.Color)
                    effect.Shadows = attributes.Shadows == true
                    if effect:IsA("SpotLight") or effect:IsA("SurfaceLight") then
                        setProperty(effect, "Angle", graph("PLAngle", progress, 90))
                        if attributes.PLFace then
                            effect.Face = Enum.NormalId[attributes.PLFace]
                        end
                    end
                elseif effect:IsA("ColorCorrectionEffect") then
                    effect.Brightness = graph("CCBrightness", progress, 0)
                    effect.Contrast = graph("CCContrast", progress, 0)
                    effect.Saturation = graph("CCSaturation", progress, 0)
                    effect.TintColor = graph("CCTintColor", progress, Color3.new(1, 1, 1))
                elseif effect:IsA("Beam") then
                    for key, prop in { BeamBrightness = "Brightness", BeamLightInfluence = "LightInfluence",
                        CurveSize0 = "CurveSize0", CurveSize1 = "CurveSize1", LightEmission = "LightEmission",
                        Segments = "Segments", TextureLength = "TextureLength", TextureSpeed = "TextureSpeed", Width0 = "Width0", Width1 = "Width1" } do
                        if attributes[key] ~= nil then
                            setProperty(effect, prop, graph(key, progress, 0))
                        end
                    end
                    if attributes.FaceCamera ~= nil then
                        effect.FaceCamera = attributes.FaceCamera
                    end
                    if attributes.BeamTextureMode then
                        effect.TextureMode = Enum.TextureMode[attributes.BeamTextureMode]
                    end
                    blendGraphs(source, effect, progress)
                elseif effect:IsA("Trail") then
                    for _, property in { "Brightness", "LightEmission", "LightInfluence", "TextureLength", "MinLength", "MaxLength" } do
                        local value = attributes["TEmit" .. property]
                        if value ~= nil then
                            setProperty(effect, property, sequence(value, progress, effect[property], noise))
                        end
                    end
                    blendGraphs(source, effect, progress)
                elseif effect:IsA("Highlight") then
                    for _, property in { "FillColor", "OutlineColor", "FillTransparency", "OutlineTransparency" } do
                        local value = attributes["HL" .. property]
                        if value ~= nil then
                            local evaluated = sequence(value, progress, effect[property], noise)
                            effect[property] = typeof(evaluated) == "number" and math.clamp(evaluated, 0, 1) or evaluated
                        end
                    end
                elseif effect:IsA("BasePart") then
                    local frame = basis()
                    local speed = graph("Speed", progress, 0)
                    if rocking then
                        velocity += Vector3.new(0, - gravity, 0) * deltaTime
                        local delta = velocity * deltaTime
                        local origin = frame.Position + position + distance
                        local hit = workspace:Raycast(origin, delta, rayParams)
                        if hit then
                            distance = hit.Position - frame.Position - position + hit.Normal * 0.03
                            velocity = (velocity - 2 * velocity:Dot(hit.Normal) * hit.Normal) * bounce
                            velocity *= math.max(0, 1 - friction)
                            if attributes.InheritFloor then
                                effect.Color = hit.Instance.Color
                                effect.Material = hit.Material
                            end
                        else
                            distance += delta
                        end
                        rotationAngles += Vector3.one * sample(attributes.TumbleSpeed, 0) * deltaTime * 180 / math.pi
                    else
                        local accel = attributes.Acceleration or zero
                        local target = source:FindFirstChild("AccelTarget")
                        if attributes.AccelerationTowardsInstance and target and target.Value then
                            local diff = getCFrame(target.Value).Position - (frame.Position + distance)
                            if diff.Magnitude > 0 then
                                accel += diff.Unit * graph("AccelStrength", progress, 0)
                            end
                        end
                        accelerationVelocity += accel * deltaTime
                        distance += (dir * speed * math.exp(- sample(attributes.Drag, 0) * age) + accelerationVelocity) * deltaTime
                        if attributes.RotMode == "Speed" then
                            rotationAngles += vector(attributes, "RotSpeed", 0, progress, noise) * deltaTime
                        else
                            rotationAngles = initialRot + vector(attributes, "RotSpeed", 0, progress, noise)
                        end
                    end
                    local offset = vector(attributes, "PosOffset", 0, progress, noise)
                    local initialPos = attributes.PosMode == "Global" and position or frame:VectorToWorldSpace(position)
                    local world = frame.Position + initialPos + distance
                    if attributes.DisplacementMode == "Local" then
                        world = frame.Position + initialPos + frame:VectorToWorldSpace(base:VectorToObjectSpace(distance))
                    end
                    world += frame:VectorToWorldSpace(offset)
                    local orientation = frame.Rotation * rotation(rotationAngles)
                    if attributes.RotOrder == "Global" then
                        orientation = rotation(rotationAngles) * frame.Rotation
                    end
                    effect.CFrame = CFrame.new(world) * orientation
                    if rocking then
                        effect.Size = (originalSize * chunkScale * graph("Scale", progress, 1)):Max(Vector3.one * 0.001)
                    else
                        effect.Size = vector(attributes, "Size", 1, progress, noise):Max(Vector3.one * 0.001)
                    end
                    effect.Transparency = math.clamp(graph("Transparency", progress, 0), 0, 1)
                    effect.Color = graph("Color", progress, effect.Color)
                    for _, d in effect:GetChildren() do
                        if d:IsA("Decal") or d:IsA("Texture") then
                            d.Color3 = effect.Color
                        end
                    end
                end
            end, function()
                if shakeToken then
                    shakeToken:Destroy()
                end
                if effect:IsA("Trail") and effect.Parent then
                    effect.Enabled = false
                    schedule(effect.Lifetime * playbackSpeed, function()
                        effect:Destroy()
                    end, source)
                else
                    effect:Destroy()
                end
            end, source, timeGraph)
        end
        local function burst()
            local count = burstCount
            if emitterAttributes.IsRocks then
                count *= math.max(1, math.floor(sample(attributes.ChunkCount, 1)))
            end
            for i = 1, count do
                spawn(i, count)
            end
        end
        schedule(emitterAttributes.EmitDelay or 0, burst, source)
        if duration > 0 and rate > 0 then
            for i = 1, math.floor(duration * rate) do
                schedule((emitterAttributes.EmitDelay or 0) + i / rate, function()
                    local count = emitterAttributes.IsRocks and math.max(1, math.floor(sample(attributes.ChunkCount, 1))) or 1
                    for j = 1, count do
                        spawn(j, count)
                    end
                end, source)
            end
        end
    end

    local function emitBeam(instance)
        local attributes = instance:GetAttributes()
        local beam = own(instance:Clone())
        handle._propertyCopies[instance] = beam
        cleanClone(beam)
        beam.Enabled = false
        beam.Parent = instance.Parent
        local baseTransparency = beam.Transparency
        local baseProperties = {}
        for _, prop in { "Width0", "Width1", "CurveSize0", "CurveSize1", "TextureSpeed", "TextureLength" } do
            baseProperties[prop] = beam[prop]
        end
        local attachments = {}
        for _, prop in { "Attachment0", "Attachment1" } do
            local att = beam[prop]
            if att then
                local child = own(att:Clone())
                cleanClone(child)
                child.Parent = att.Parent
                beam[prop] = child
                attachments[prop] = child
            end
        end
        local source0, source1 = instance.Attachment0, instance.Attachment1
        local sampled = {}
        local names = {}
        for k in attributes do table.insert(names, k) end
        table.sort(names)
        for _, k in names do
            local v = attributes[k]
            sampled[k] = typeof(v) == "NumberRange" and (context.Random and context.Random:NextNumber(v.Min, v.Max) or sample(v, 1)) or v
        end
        attributes = sampled
        schedule(attributes.EmitDelay or 0, function()
            beam.Enabled = true
            animate(sample(attributes.EffectDuration, 0.5), function(progress)
                for key, prop in {
                    Width0 = "Width0",
                    Width1 = "Width1",
                    CurveSize0 = "CurveSize0",
                    CurveSize1 = "CurveSize1",
                    Speed_Texture = "TextureSpeed",
                    Length_Texture = "TextureLength"
                } do
                    if attributes[key .. "_Start"] ~= nil or attributes[key .. "_End"] ~= nil then
                        setProperty(beam, prop, interpolateAttribute(attributes, key, progress, baseProperties[prop]))
                    end
                end
                local transparencyScale = interpolateAttribute(attributes, "Transparency_Scale", progress, 1)
                local points = {}
                for _, k in baseTransparency.Keypoints do
                    table.insert(
                        points,
                        NumberSequenceKeypoint.new(k.Time, math.clamp(k.Value * transparencyScale, 0, 1), 0)
                    )
                end
                beam.Transparency = NumberSequence.new(points)
                if source0 and source0.Parent and source1 and source1.Parent and attachments.Attachment1 then
                    local scale = interpolateAttribute(attributes, "Length_Scale", progress, 1)
                    local start0, start1 = source0.WorldPosition, source1.WorldPosition
                    if attachments.Attachment0 then attachments.Attachment0.WorldCFrame = source0.WorldCFrame end
                    attachments.Attachment1.WorldCFrame = source1.WorldCFrame
                    attachments.Attachment1.WorldPosition = start0 + (start1 - start0) * scale
                end
            end, function()
                beam:Destroy()
            end, instance)
        end, instance)
    end

    local function revealTrail(instance, duration)
        local trail = utilities.isRuntime(instance) and instance or own(instance:Clone())
        cleanClone(trail)
        handle._propertyCopies[instance] = trail
        trail.Enabled = false
        trail.Parent = instance.Parent
        local attributes = instance:GetAttributes()
        schedule(sample(attributes.EmitDelay, 0), function()
            if not trail.Parent then
                return
            end
            local branch = type(duration) == "table" and duration or nil
            local linked = branch and attributes.EmitDuration == nil and attributes.EffectDuration == nil
            if linked and branch.finished then
                trail:Destroy()
                return
            end
            local function stop()
                if trail.Parent then
                    trail.Enabled = false
                    schedule(trail.Lifetime * playbackSpeed, function()
                        trail:Destroy()
                    end, instance)
                end
            end
            trail.Enabled = true
            handle.Stats.Trails += 1
            if linked then
                table.insert(branch.after, stop)
            else
                local fallback = typeof(duration) == "number" and duration or trail.Lifetime
                local onTime = sample(attributes.EmitDuration, sample(attributes.EffectDuration, fallback))
                schedule(math.max(onTime, 0), stop, instance)
            end
        end, instance)
    end
    return {
        NativeParticle = emitParticle,
        PropertyValue = animateProperty,
        MeshPair = emitMeshPair,
        Configured = emitConfigured,
        StandardBeam = emitBeam,
        Trail = revealTrail,
    }
end

return handlers

