						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local MeshView = {}
MeshView.__index = MeshView

MeshView.fieldOfView = 30
MeshView.defaultYaw = math.rad(35)
MeshView.defaultPitch = math.rad(22)
MeshView.maximumPitch = math.rad(85)
MeshView.defaultZoom = 1
MeshView.minimumZoom = 0.5
MeshView.maximumZoom = 4
MeshView.margin = 0.85
MeshView.minimumRadius = 0.05
MeshView.shadedMaterial = Enum.Material.SmoothPlastic
MeshView.shadedColor = Color3.fromRGB(235, 238, 245)
MeshView.flatMaterials = {
	[Enum.Material.Neon] = true,
	[Enum.Material.ForceField] = true,
}
MeshView.corners = {
	Vector3.new(1, 1, 1),
	Vector3.new(1, 1, -1),
	Vector3.new(1, -1, 1),
	Vector3.new(1, -1, -1),
	Vector3.new(-1, 1, 1),
	Vector3.new(-1, 1, -1),
	Vector3.new(-1, -1, 1),
	Vector3.new(-1, -1, -1),
}

function MeshView.new(viewport: ViewportFrame)
	local self = setmetatable({}, MeshView)

	local camera = viewport:FindFirstChildOfClass("Camera")

	if not camera then
		camera = Instance.new("Camera")
		camera.Parent = viewport
	end

	camera.FieldOfView = MeshView.fieldOfView
	viewport.CurrentCamera = camera

	self.viewport = viewport
	self.camera = camera
	self.source = nil
	self.model = nil
	self.center = Vector3.zero
	self.radius = 1
	self.yaw = MeshView.defaultYaw
	self.pitch = MeshView.defaultPitch
	self.zoom = MeshView.defaultZoom

	return self
end

function MeshView:getSource(): Instance?
	return self.source
end

function MeshView:getModel(): Instance?
	return self.model
end

function MeshView:getYaw(): number
	return self.yaw
end

function MeshView:getPitch(): number
	return self.pitch
end

function MeshView:getZoom(): number
	return self.zoom
end

function MeshView:getRadius(): number
	return self.radius
end

function MeshView:getCenter(): Vector3
	return self.center
end

function MeshView:getParts(root: Instance): { BasePart }
	local parts = {}

	if root:IsA("BasePart") then
		table.insert(parts, root)
	end

	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end

	return parts
end

function MeshView:prepare(parts: { BasePart })
	for _, part in parts do
		part.Anchored = true

		if MeshView.flatMaterials[part.Material] then
			part.Material = MeshView.shadedMaterial
			part.Color = MeshView.shadedColor
		end
	end
end

function MeshView:measure(parts: { BasePart }): (Vector3, number)
	local minimum = Vector3.one * math.huge
	local maximum = Vector3.one * -math.huge

	for _, part in parts do
		local half = part.Size / 2

		for _, corner in MeshView.corners do
			local point = part.CFrame:PointToWorldSpace(half * corner)

			minimum = minimum:Min(point)
			maximum = maximum:Max(point)
		end
	end

	if #parts == 0 then
		return Vector3.zero, 1
	end

	return (minimum + maximum) / 2, math.max((maximum - minimum).Magnitude / 2, MeshView.minimumRadius)
end

function MeshView:clear()
	if self.model then
		self.model:Destroy()
		self.model = nil
	end

	self.source = nil
end

function MeshView:setSource(source: Instance?)
	if self.source == source then
		return
	end

	self:clear()

	if not source then
		return
	end

	local model = source:Clone()
	local parts = self:getParts(model)

	self:prepare(parts)
	self.center, self.radius = self:measure(parts)
	self.source = source
	self.model = model
	model.Parent = self.viewport
	self:update()
end

function MeshView:setOrbit(yaw: number, pitch: number)
	local limit = MeshView.maximumPitch

	self.yaw = yaw % (2 * math.pi)
	self.pitch = math.clamp(pitch, -limit, limit)
	self:update()
end

function MeshView:rotate(deltaYaw: number, deltaPitch: number)
	self:setOrbit(self.yaw + deltaYaw, self.pitch + deltaPitch)
end

function MeshView:setZoom(zoom: number)
	self.zoom = math.clamp(zoom, MeshView.minimumZoom, MeshView.maximumZoom)
	self:update()
end

function MeshView:getZoomAlpha(): number
	local span = math.log(MeshView.maximumZoom / MeshView.minimumZoom)

	return math.clamp(math.log(self.zoom / MeshView.minimumZoom) / span, 0, 1)
end

function MeshView:setZoomAlpha(alpha: number)
	local ratio = MeshView.maximumZoom / MeshView.minimumZoom

	self:setZoom(MeshView.minimumZoom * ratio ^ math.clamp(alpha, 0, 1))
end

function MeshView:reset()
	self.yaw = MeshView.defaultYaw
	self.pitch = MeshView.defaultPitch
	self.zoom = MeshView.defaultZoom
	self:update()
end

function MeshView:getDistance(): number
	local fit = self.radius * MeshView.margin / math.sin(math.rad(MeshView.fieldOfView) / 2)

	return fit / self.zoom
end

function MeshView:getCameraCFrame(): CFrame
	return CFrame.new(self.center)
		* CFrame.Angles(0, self.yaw, 0)
		* CFrame.Angles(-self.pitch, 0, 0)
		* CFrame.new(0, 0, self:getDistance())
end

function MeshView:update()
	self.camera.CFrame = self:getCameraCFrame()
end

function MeshView:destroy()
	self:clear()
end

return MeshView
]]></ProtectedString>
