						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local studioAudio = require("studioAudio")
local dataModule = require("soundData")
local timing = require("soundTiming")
local events = require("events")
local localAudio = require("localAudio")
local sounds = {}
local active = {}
local prepared = {}
local version = 0
local ready = false
local warnedLocal = {}

function sounds.isPrepared()
	return ready
end

local function stop(entry)
	active[entry] = nil
	entry.sound:Stop()
end

function sounds.stop()
	for entry in active do
		stop(entry)
	end
end

function sounds.clear()
	ready = false
	version += 1
	sounds.stop()
	for _, entries in prepared do
		for _, entry in entries do
			for _, connection in entry.connections do
				connection:Disconnect()
			end

			entry.sound:Destroy()
		end
	end

	table.clear(prepared)
end

function sounds.prepare(timeline, isCurrent)
	sounds.clear()
	local currentVersion = version
	local parent = studioAudio.parent()
	local pending, updates = {}, {}
	local missingLocal = false

	local function current()
		return currentVersion == version and isCurrent()
	end

	for _, track in events.all() do
		if not events.isEnabled(track) or not track.Rig.Parent then
			continue
		end

		for _, event in track.Events do
			if event.Enabled == false then
				continue
			end

			local entries = {}
			prepared[event] = entries
			for index, data in event.Sounds or {} do
				local id = dataModule.playback(data)
				if not id and localAudio.is(data.AudioId) then
					if not warnedLocal[data.AudioId] then
						missingLocal = true
						warnedLocal[data.AudioId] = true
					end
				end

				if id and localAudio.is(data.AudioId) then
					warnedLocal[data.AudioId] = nil
				end
				if not id then
					continue
				end

				if not parent then
					continue
				end

				local sound = Instance.new("Sound")

				sound.Name = "EclipseEventSound"
				sound.SoundId = id
				sound.Looped = data.Looped == true
				sound.Volume = dataModule.volume(data.Volume)
				sound.PlaybackSpeed = dataModule.speed(data.Speed)
				sound.Archivable = false
				local entry = { sound = sound, rig = track.Rig, connections = {} }
				entries[index] = entry
				table.insert(
					entry.connections,
					sound.Ended:Connect(function()
						if not sound.Playing then
							stop(entry)
						end
					end)
				)
				table.insert(
					entry.connections,
					track.Rig.AncestryChanged:Connect(function()
						if not track.Rig.Parent then
							stop(entry)
						end
					end)
				)
				sound.Parent = parent
				table.insert(pending, sound)
				table.insert(
					updates,
					{ track = track, event = event, index = index, data = data, sound = sound }
				)
			end
		end
	end

	if missingLocal then
		require("notification").show(
			"LOCAL AUDIO",
			"Reselect the local audio file in its sound event to hear it in this Studio session."
		)
	end

	if not studioAudio.preload(pending, current, 3) then
		if not current() then
			if currentVersion == version then
				sounds.clear()
			end
			return false
		end
		require("notification").show(
			"AUDIO UNAVAILABLE",
			"Some audio could not load. Animation playback will continue.",
			5
		)
	end

	local changed = {}
	for _, entry in updates do
		if
			entry.event.Sounds[entry.index] == entry.data
			and entry.sound.TimeLength > 0
			and entry.data.Duration ~= entry.sound.TimeLength
		then
			entry.data.Duration = entry.sound.TimeLength
			changed[entry.track] = true
		end
	end

	for track in changed do
		events.changed(track)
	end

	if next(changed) then
		timeline:RefreshEventRows()
	end

	ready = current()
	return ready
end

function sounds.play(rig, event, elapsed, timeline)
	local entries = prepared[event]
	for index, data in event.Sounds or {} do
		local id = dataModule.playback(data)
		if not id then
			continue
		end

		local entry = entries and entries[index]
		if not entry or entry.sound.SoundId ~= id or not entry.sound.IsLoaded then
			if entry and not entry.warned then
				entry.warned = true
				warn("Eclipse: skipping unavailable audio " .. id)
			end
			continue
		end

		local sound = entry.sound
		local speed = dataModule.speed(data.Speed)
		local offset, gain = timing.sample(data, math.max(0, elapsed), sound.TimeLength)
		stop(entry)
		if not rig.Parent or offset == nil then
			continue
		end

		sound.Looped = data.Looped == true
		sound.Volume = dataModule.volume(data.Volume) * gain
		sound.PlaybackSpeed = speed
		sound.TimePosition = offset
		entry.data, entry.start = data, event.Frame / timeline:GetState().FPS
		active[entry] = true
		sound.Playing = true
	end
end

function sounds.update(time)
	for entry in active do
		local sound = entry.sound
		local offset, gain = timing.sample(entry.data, time - entry.start, sound.TimeLength)
		if offset == nil or not entry.rig.Parent then
			stop(entry)
		else
			sound.Volume = dataModule.volume(entry.data.Volume) * gain
			if math.abs(sound.TimePosition - offset) > 0.12 then
				sound.TimePosition = offset
			end
		end
	end
end

function sounds.resume(timeline, time, includeStart)
	sounds.stop()
	local fps = timeline:GetState().FPS
	for _, track in events.all() do
		if not events.isEnabled(track) or not track.Rig.Parent then
			continue
		end

		for _, event in track.Events do
			local start = event.Frame / fps
			if event.Enabled ~= false and (start < time or includeStart and start == time) then
				sounds.play(track.Rig, event, time - start, timeline)
			end
		end
	end
end

function sounds.scrub(timeline, time)
	local wanted = {}
	local now = os.clock()
	local fps = timeline:GetState().FPS
	for _, track in events.all() do
		if not events.isEnabled(track) or not track.Rig.Parent then
			continue
		end

		for _, event in track.Events do
			local start = event.Frame / fps
			if event.Enabled == false or start > time then
				continue
			end

			for index, data in event.Sounds or {} do
				local entry = prepared[event] and prepared[event][index]
				local id = dataModule.playback(data)
				if not entry or not id then
					continue
				end

				local sound = entry.sound
				local speed = dataModule.speed(data.Speed)
				local offset, gain = timing.sample(data, time - start, sound.TimeLength)
				if sound.SoundId ~= id or not sound.IsLoaded or offset == nil then
					continue
				end

				wanted[entry] = true
				sound.Looped = data.Looped == true
				sound.Volume = dataModule.volume(data.Volume) * gain
				sound.PlaybackSpeed = speed
				if
					not active[entry]
					or not sound.Playing
					or not entry.scrubAt
					or now - entry.scrubAt >= 0.06
				then
					sound.TimePosition = offset
					entry.scrubAt = now
				end

				active[entry] = true
				if not sound.Playing then
					sound.Playing = true
				end
			end
		end
	end

	for entry in active do
		if not wanted[entry] then
			stop(entry)
		end
	end
end

return sounds
]]></ProtectedString>
