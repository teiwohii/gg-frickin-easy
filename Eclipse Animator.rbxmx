						<ProtectedString name="Source"><![CDATA[-- riftkuro

local require = require(script:FindFirstAncestor("container").requireModule)
local windowFx = require("windowFx")

local notice = {}
notice.Link = "https://create.roblox.com/store/asset/86116556258301/Eclipse-Animator"
notice.Message =
	[[Hey! We've detected that you are using a pirated build. Normally, this would mean you'd not be able to use Eclipse Animator, and that we'd enforce buying the real version. However, as the developer writing this, I fully understand how it is to not be able to buy the proper product. $20 on a roblox plugin is just not worth it for some people, especially depending on your situation. Or maybe you're region locked and you can't purchase it through the creator store. Whatever it is, I do have one request from you:

<b>Please, just get the word out there!</b>
Recommend the tool to your friends, make videos, anything. Any publicity helps greatly. And of course, consider supporting us in the future if you have the ability to! We try really hard on this plugin and the only way we can do so is if people make purchases.

Thank you for reading, and I wish you the best of luck. - riftkuro (Owner/Lead Developer)]]

function notice.isOfficial(source)
	return tostring(source or ""):match("^cloud_(%d+)%.") == "86116556258301"
end

local function make(class, parent, name, properties)
	local object = Instance.new(class)
	object.Name = name
	for key, value in properties do
		object[key] = value
	end
	object.Parent = parent
	return object
end

function notice.create(root, dismissed, template)
 assert(template, "Eclipse notification template is required")
 local overlay = make("TextButton", root, "BuildNotice", {
  Size = UDim2.fromScale(1, 1), Text = "", AutoButtonColor = false,
  BackgroundTransparency = 1, BorderSizePixel = 0, Modal = true, Active = true,
  ZIndex = 100000,
 })
 local animation = make("Frame", overlay, "Animation", {
  BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
  AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
  Visible = false, ZIndex = 100001,
 })
 local animating, closing = false, false
 local panel = template:Clone()
 panel.Name = "Panel"
 panel.Visible = true
 panel.AutomaticSize = Enum.AutomaticSize.None
 panel.AnchorPoint = Vector2.new(0.5, 0.5)
 panel.Position = UDim2.fromScale(0.5, 0.5)
 panel.Size = UDim2.new(0.94, 0, 0.9, 0)
 panel.ZIndex = 100001
 make("UISizeConstraint", panel, "Maximum", {MaxSize = Vector2.new(640, 10000)})
 local scale = panel:FindFirstChildOfClass("UIScale")
 if scale then scale:Destroy() end
 local displayScale = make("UIScale", panel, "NoticeScale", {Scale = 1.25})
 local content = panel.Content
 content.AutomaticSize = Enum.AutomaticSize.None
 content.Size = UDim2.fromScale(1, 1)
 local contentLayout = content:FindFirstChildOfClass("UIListLayout")
 if contentLayout then contentLayout:Destroy() end
 local information = content.Information
 information.AutomaticSize = Enum.AutomaticSize.None
 information.Size = UDim2.new(1, 0, 1, -104)
 local flex = information:FindFirstChildOfClass("UIFlexItem")
 if flex then flex:Destroy() end
 local icon = information.IconContainer
 icon.AnchorPoint = Vector2.zero
 icon.Position = UDim2.new()
 icon.Size = UDim2.fromOffset(52, 38)
 icon:FindFirstChildOfClass("UIListLayout"):Destroy()
 icon.ImageLabel.AnchorPoint = Vector2.zero
 icon.ImageLabel.Position = UDim2.new()
 icon.ImageLabel.Size = UDim2.fromOffset(32, 32)
 local container = information.Container
 container.AutomaticSize = Enum.AutomaticSize.None
 container.Size = UDim2.fromScale(1, 1)
 local vertical = container.VerticalContent
 vertical.AutomaticSize = Enum.AutomaticSize.None
 vertical.Size = UDim2.fromScale(1, 1)
 vertical.InformationLayout:Destroy()
 local header = vertical.Header
 header.AutomaticSize = Enum.AutomaticSize.None
 local headerInset = icon.Visible and icon.ImageLabel.Visible and 44 or 0
 header.Position = UDim2.fromOffset(headerInset, 0)
 header.Size = UDim2.new(1, -headerInset, 0, 36)
 header.Header.AutomaticSize = Enum.AutomaticSize.None
 header.Header.Size = UDim2.fromScale(1, 1)
 header.Header.Text = "PIRATED BUILD DETECTED"
 header.Header.TextWrapped = true
 header.Header.TextScaled = false
 header.Header.TextSize = 18
 local scroll = make("ScrollingFrame", vertical, "Body", {
  Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 1, -44),
  BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
  CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
  ScrollingDirection = Enum.ScrollingDirection.Y,
 })
 scroll:SetAttribute("ThemeScr", "Div")
 local message = vertical.Description
 message.Parent = scroll
 message.Position = UDim2.new()
 message.Size = UDim2.new(1, -10, 0, 0)
 message.AutomaticSize = Enum.AutomaticSize.Y
 message.Text = notice.Message
 message.RichText = true
 message.TextWrapped = true
 message.TextScaled = false
 message.TextXAlignment = Enum.TextXAlignment.Left
 message.TextYAlignment = Enum.TextYAlignment.Top
 local buttons = content.Buttons
 buttons.AutomaticSize = Enum.AutomaticSize.None
 buttons.Position = UDim2.new(0, 0, 1, -31)
 buttons.Size = UDim2.new(1, 0, 0, 31)
 local done = buttons.Dismiss
 done.Name = "Continue"
 done.Title.Text = "CONTINUE TO ECLIPSE"
 done.Title.Size = UDim2.new(1, -16, 1, 0)
 local hint = message:Clone()
 hint.Name = "CopyHint"
 hint.AutomaticSize = Enum.AutomaticSize.None
 hint.Position = UDim2.new(0, 0, 1, -94)
 hint.Size = UDim2.new(1, 0, 0, 18)
 hint.Text = "Click the link to select it, then copy."
 hint.TextTransparency = 0.3
 hint.TextSize = 12
 hint.Parent = content
 local linkFrame = done:Clone()
 linkFrame.Name = "LinkSurface"
 linkFrame.Title:Destroy()
 local glow = linkFrame:FindFirstChild("Glow")
 if glow then glow:Destroy() end
 linkFrame.AutoButtonColor = false
 linkFrame.AnchorPoint = Vector2.zero
 linkFrame.Position = UDim2.new(0, 0, 1, -72)
 linkFrame.Size = UDim2.new(1, 0, 0, 31)
 linkFrame.Parent = content
 local link = make("TextBox", linkFrame, "StoreLink", {
  Text = notice.Link, FontFace = message.FontFace, TextSize = 12,
  TextColor3 = message.TextColor3, BackgroundTransparency = 1, BorderSizePixel = 0,
  ClearTextOnFocus = false, TextEditable = false, TextXAlignment = Enum.TextXAlignment.Left,
  Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0),
 })
 link:SetAttribute("ThemeTxt", "Txt")
 for _, object in panel:GetDescendants() do
  if object:IsA("GuiObject") then object.ZIndex = 100002 end
 end
 panel.Parent = animation
 local function fit()
  if panel.Parent and not animating and not closing then
   panel.Size = UDim2.fromOffset(math.min(640, root.AbsoluteSize.X * 0.94 / displayScale.Scale), math.min(root.AbsoluteSize.Y * 0.9 / displayScale.Scale, message.TextBounds.Y / displayScale.Scale + 188))
  end
 end
 local resize = root:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
 local measure = message:GetPropertyChangedSignal("TextBounds"):Connect(fit)
 overlay.Destroying:Once(function()
  windowFx.clear(animation)
  resize:Disconnect()
  measure:Disconnect()
 end)
 task.defer(function()
  if not overlay.Parent or closing then return end
  fit()
  animating = true
  animation.Visible = true
  windowFx.pop(animation)
  task.delay(0.24, function()
   animating = false
   fit()
  end)
 end)
 local function selectLink()
  task.defer(function()
   if link.Parent and link:IsFocused() then
    link.SelectionStart = 1
    link.CursorPosition = #link.Text + 1
   end
  end)
 end
 link.Focused:Connect(selectLink)
 link.InputEnded:Connect(function(input)
  if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then selectLink() end
 end)
 local function close()
  if closing or not overlay.Parent then return end
  closing = true
  done.Interactable = false
  link:ReleaseFocus()
  windowFx.shrink(animation, function()
   overlay:Destroy()
   if dismissed then dismissed() end
  end)
 end
 done.Activated:Connect(close)
 return overlay, close
end

return notice
]]></ProtectedString>
