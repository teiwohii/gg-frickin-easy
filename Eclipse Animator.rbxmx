								<Properties>
									<Content name="LinkedSource"><null></null></Content>
									<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local schema = {}

local partTransform = { title = "Transform", properties = { "Position", "Orientation", "Size" } }
local partAppearance = { title = "Appearance", properties = { "Color", "Material", "Transparency", "Reflectance", "CastShadow" } }
local partBehaviour = { title = "Behaviour", properties = { "Anchored", "CanCollide", "CanQuery", "CanTouch", "Massless", "Locked" }, collapsed = true }
local lightBasics = { title = "Light", properties = { "Enabled", "Brightness", "Range", "Color", "Shadows" } }
local lightCone = { title = "Cone", properties = { "Angle", "Face" } }
local decalMapping = { title = "Mapping", properties = { "UVOffset", "UVScale", "Rotation" }, collapsed = true }

schema.classes = {
	ParticleEmitter = {
		{ title = "Emission", properties = { "Enabled", "Rate", "Lifetime", "Speed", "SpreadAngle", "EmissionDirection" }, action = "paths" },
		{ title = "Burst", properties = { "EmitCount", "EmitDelay", "EmitDuration" }, action = "emit" },
		{ title = "Appearance", properties = { "Texture", "Color", "Size", "Transparency", "Squash", "Brightness", "LightEmission", "LightInfluence", "Orientation", "ZOffset" } },
		{ title = "Motion", properties = { "Acceleration", "Drag", "Rotation", "RotSpeed", "VelocityInheritance", "LockedToPart", "TimeScale", "WindAffectsDrag" } },
		{ title = "Shape", properties = { "Shape", "ShapeInOut", "ShapeStyle", "ShapePartial" }, collapsed = true },
		{ title = "Flipbook", properties = { "FlipbookLayout", "FlipbookMode", "FlipbookFramerate", "FlipbookStartRandom" }, action = "flipbook", collapsed = true },
	},

	Beam = {
		{ title = "Attachments", properties = { "Attachment0", "Attachment1" }, action = "attach" },
		{ title = "Shape", properties = { "CurveSize0", "CurveSize1", "Segments", "Width0", "Width1", "FaceCamera", "ZOffset" } },
		{ title = "Appearance", properties = { "Enabled", "Color", "Transparency", "Brightness", "LightEmission", "LightInfluence" } },
		{ title = "Texture", properties = { "Texture", "TextureLength", "TextureMode", "TextureSpeed" } },
	},

	Trail = {
		{ title = "Attachments", properties = { "Attachment0", "Attachment1" }, action = "attach" },
		{ title = "Shape", properties = { "Enabled", "Lifetime", "WidthScale", "MinLength", "MaxLength", "FaceCamera" }, action = "trail" },
		{ title = "Appearance", properties = { "Color", "Transparency", "Brightness", "LightEmission", "LightInfluence" } },
		{ title = "Texture", properties = { "Texture", "TextureLength", "TextureMode" } },
	},

	BasePart = { partTransform, partAppearance, partBehaviour },

	Model = {
		{ title = "Transform", properties = { "Position", "Orientation", "Scale" } },
		{ title = "Model", properties = { "PrimaryPart" }, collapsed = true },
	},

	Attachment = {
		{ title = "Transform", properties = { "Position", "Orientation" } },
		{ title = "Display", properties = { "Visible" } },
	},

	SpecialMesh = {
		{ title = "Mesh", properties = { "MeshType", "MeshId", "TextureId", "Scale", "Offset", "VertexColor" } },
	},

	BlockMesh = {
		{ title = "Mesh", properties = { "Scale", "Offset", "VertexColor" } },
	},

	CylinderMesh = {
		{ title = "Mesh", properties = { "Scale", "Offset", "VertexColor" } },
	},

	PointLight = { lightBasics },
	SpotLight = { lightBasics, lightCone },
	SurfaceLight = { lightBasics, lightCone },

	Highlight = {
		{ title = "Highlight", properties = { "Enabled", "Adornee", "DepthMode", "FillColor", "FillTransparency", "OutlineColor", "OutlineTransparency" } },
	},

	Fire = {
		{ title = "Fire", properties = { "Enabled", "Color", "SecondaryColor", "Heat", "Size", "TimeScale" } },
	},

	Smoke = {
		{ title = "Smoke", properties = { "Enabled", "Color", "Opacity", "RiseVelocity", "Size", "TimeScale" } },
	},

	Sparkles = {
		{ title = "Sparkles", properties = { "Enabled", "SparkleColor", "TimeScale" } },
	},

	Decal = {
		{ title = "Decal", properties = { "Texture", "Color3", "Transparency", "Face", "ZIndex" } },
		decalMapping,
	},

	Texture = {
		{ title = "Texture", properties = { "Texture", "Color3", "Transparency", "Face", "ZIndex" } },
		{ title = "Tiling", properties = { "StudsPerTileU", "StudsPerTileV", "OffsetStudsU", "OffsetStudsV" } },
		decalMapping,
	},

	BillboardGui = {
		{ title = "Billboard", properties = { "Enabled", "Adornee", "AlwaysOnTop", "Brightness", "LightInfluence", "MaxDistance", "StudsOffset", "StudsOffsetWorldSpace" } },
	},

	SurfaceGui = {
		{ title = "Surface", properties = { "Enabled", "Adornee", "Face", "AlwaysOnTop", "Brightness", "LightInfluence", "PixelsPerStud", "SizingMode" } },
	},

	ImageLabel = {
		{ title = "Image", properties = { "Image", "ImageColor3", "ImageTransparency", "BackgroundTransparency", "Rotation", "Visible" } },
	},

	Sound = {
		{ title = "Sound", properties = { "SoundId", "Volume", "PlaybackSpeed", "Looped" }, action = "sound" },
		{ title = "Timing", properties = { "PlayDelay", "PlayLength" } },
		{ title = "Distance", properties = { "RollOffMode", "RollOffMinDistance", "RollOffMaxDistance" }, collapsed = true },
	},
}

schema.bases = { "BasePart", "Model" }

schema.additions = {
	Part = {
		{ title = "Shape", properties = { "Shape" }, after = "Transform" },
	},
	MeshPart = {
		{ title = "Mesh", properties = { "MeshId", "TextureID", "DoubleSided" }, after = "Transform" },
	},
	UnionOperation = {
		{ title = "Union", properties = { "UsePartColor" }, after = "Appearance" },
	},
	IntersectOperation = {
		{ title = "Union", properties = { "UsePartColor" }, after = "Appearance" },
	},
}

schema.fields = {
