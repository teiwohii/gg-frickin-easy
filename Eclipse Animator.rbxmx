							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Toolbox</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX9FBBD60E79A94E939B0C4B0376902AF6">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local httpService = game:GetService("HttpService")
local textService = game:GetService("TextService")
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local configuration = require(script.Parent.Parent.Utility.configuration)
local LibraryKind = require(script.Parent.LibraryKind)
local SoundLibraryKind = require(script.Parent.SoundLibraryKind)
local PresetLibraryKind = require(script.Parent.PresetLibraryKind)
local PremiumGate = require(script.Parent.Parent.Premium.PremiumGate)

local Library = {}
Library.__index = Library

Library.maximumNameLength = 40
Library.version = 2
Library.allText = "All"
Library.uncategorized = "Uncategorized"
Library.chipPadding = 14
Library.chipTextSize = 12
Library.menuWidth = 180
Library.previewGap = 6
Library.detailSeparator = "  \u{2022}  "

Library.messages = {
	nothing = "Select what you want to save first.",
	noName = "Type a name for it.",
	saved = "Saved \"%s\" to your library (%s).",
	updated = "Updated \"%s\" from the selection.",
	skipped = "%d object%s could not be saved: unions cannot be rebuilt.",
	empty = "Nothing in the selection could be saved.",
	failed = "\"%s\" could not be rebuilt.",
	removed = "Removed \"%s\" from your library.",
	renamed = "Renamed to \"%s\".",
	moved = "Moved \"%s\" to %s.",
	categoryAdded = "Added the category \"%s\".",
	categoryExists = "There is already a category called \"%s\".",
	categoryRemoved = "Removed the category \"%s\". Its items are now uncategorized.",
	noSound = "This item has no sound that can be played.",
	noAudio = "Sounds can only be heard while Arc is running as a plugin.",
}

Library.emptyTexts = {
	none = "Your library is empty. Select VFX or a sound, type a name below and press Save.",
	filtered = "Nothing in your library matches.",
}

Library.prompts = {
	newCategory = { placeholder = "New category name", confirm = "Add" },
	renameCategory = { placeholder = "Category name", confirm = "Rename" },
}

function Library.new(page: Frame, templates: Instance, context, builder)
	local self = setmetatable({}, Library)

	self.page = page
	self.list = page.List
	self.search = page.Search
	self.empty = page.Empty
	self.footer = page.Footer
	self.nameBox = page.Footer.NameBox
	self.saveButton = page.Footer.SavePreset
	self.categoryButton = page.LibraryCategory
	self.kindBar = page.Kinds
	self.chipTemplate = page.Kinds.KindChip
	self.countLabel = page.Count
	self.prompt = page.Prompt
	self.promptBox = page.Prompt.PromptBox
	self.promptConfirm = page.Prompt.PromptConfirm
	self.promptCancel = page.Prompt.PromptCancel
	self.template = templates.LibraryItem
	self.context = context
	self.builder = builder
	self.specs = context.specs
	self.plugin = context.plugin
	self.items = {}
	self.builtIn = {}
	self.catalog = nil
	self.unsubscribe = nil
	self.categories = {}
	self.kinds = {}
	self.kindLookup = {}
	self.kindFilter = nil
	self.categoryFilter = nil
	self.rows = {}
	self.rowConnections = {}
	self.chips = {}
	self.chipConnections = {}
	self.connections = {}
	self.filter = ""
	self.busy = false
	self.renaming = nil
	self.promptHandler = nil
	self.insertedHandler = nil

	self:registerKind(SoundLibraryKind.new(), true)
	self:registerKind(LibraryKind.new(), true)
	self:load()
	self:bind()
	self:rebuildChips()
	self:rebuild()

	return self
end

function Library:setCatalog(catalog)
	self.catalog = catalog
	self.builtIn = catalog:getItems()

	if #self.builtIn > 0 then
		self:registerKind(PresetLibraryKind.new())
	end
end

function Library:start()
	if not self.unsubscribe then
		local gate = PremiumGate.get()
		local unlocked = gate:isUnlocked(PresetLibraryKind.feature)

		self.unsubscribe = gate:onChanged(function()
			local current = gate:isUnlocked(PresetLibraryKind.feature)

			if current ~= unlocked then
				unlocked = current
				self:rebuild()
			end
		end)
	end

	self:rebuild()
end

function Library:trim(text: string): string
	local trimmed = string.gsub(text, "^%s*(.-)%s*$", "%1")

	return string.sub(trimmed, 1, Library.maximumNameLength)
end

function Library:registerKind(kind, silent: boolean?)
	local existing = self.kindLookup[kind.id]

	if existing then
		table.remove(self.kinds, table.find(self.kinds, existing))
		existing:destroy()
	end

	self.kindLookup[kind.id] = kind
	table.insert(self.kinds, kind)

	table.sort(self.kinds, function(a, b)
		return a.order < b.order
	end)

	if not silent then
		self:rebuildChips()
		self:rebuild()
	end
end

function Library:getKinds()
	return self.kinds
end

function Library:getFallbackKind()
	return self.kinds[#self.kinds]
end

function Library:getKind(id: any)
	return self.kindLookup[id] or self:getFallbackKind()
end

function Library:detectKind(roots: { Instance })
	for _, kind in self.kinds do
		if kind:accepts(roots) then
			return kind
		end
	end

	return self:getFallbackKind()
end

function Library:connect(signal: RBXScriptSignal, callback)
	table.insert(self.connections, signal:Connect(callback))
end

function Library:bind()
	self:connect(self.search:GetPropertyChangedSignal("Text"), function()
		self.filter = string.lower(self:trim(self.search.Text))
		self:rebuild()
	end)

	self:connect(self.saveButton.Activated, function()
		self:save(self.nameBox.Text)
	end)

	self:connect(self.nameBox.FocusLost, function(enterPressed)
		if enterPressed then
			self:save(self.nameBox.Text)
		end
	end)

	self:connect(self.categoryButton.Activated, function()
		self:openCategoryMenu()
	end)

	self:connect(self.promptBox.FocusLost, function(enterPressed)
		if enterPressed then
			self:confirmPrompt()
		end
	end)

	self:connect(self.promptConfirm.Activated, function()
		self:confirmPrompt()
	end)

	self:connect(self.promptCancel.Activated, function()
		self:closePrompt()
	end)
end

function Library:setInsertedHandler(handler: (({ Instance }) -> ())?)
	self.insertedHandler = handler
end

function Library:newId(): string
	return httpService:GenerateGUID(false)
end

function Library:readItem(stored)
	if typeof(stored) ~= "table" or typeof(stored.name) ~= "string" or typeof(stored.data) ~= "table" then
		return nil
	end

	return {
		id = if typeof(stored.id) == "string" then stored.id else self:newId(),
		name = stored.name,
		kind = if typeof(stored.kind) == "string" then stored.kind else self:getFallbackKind().id,
		category = if typeof(stored.category) == "string" then stored.category else "",
		icon = if typeof(stored.icon) == "string" then stored.icon else nil,
		count = if typeof(stored.count) == "number" then stored.count else 1,
		data = stored.data,
	}
end

function Library:load()
	if not self.plugin then
		return
	end

	local success, stored = pcall(function()
		return self.plugin:GetSetting(configuration.Create.libraryKey)
	end)

	if not success or typeof(stored) ~= "table" then
		return
	end

	local source = if typeof(stored.items) == "table" then stored.items else stored.presets

	for _, entry in if typeof(source) == "table" then source else {} do
		local item = self:readItem(entry)

		if item then
			table.insert(self.items, item)
		end
	end

	for _, name in if typeof(stored.categories) == "table" then stored.categories else {} do
		if typeof(name) == "string" then
			self:includeCategory(name)
		end
	end

	for _, item in self.items do
		self:includeCategory(item.category)
	end
end

function Library:persist()
	if not self.plugin then
		return
	end

	pcall(function()
		self.plugin:SetSetting(configuration.Create.libraryKey, {
			version = Library.version,
			items = self.items,
			categories = self.categories,
		})
	end)
end

function Library:getItems()
	return self.items
end

function Library:getPresets()
	return self.items
end

function Library:getCategories(): { string }
	return self.categories
end

function Library:findCategory(name: string): string?
	local lowered = string.lower(name)

	for _, category in self.categories do
		if string.lower(category) == lowered then
			return category
		end
	end

	return nil
end

function Library:includeCategory(name: string): string
	local trimmed = self:trim(name)

	if trimmed == "" then
		return ""
	end

	local existing = self:findCategory(trimmed)

	if existing then
		return existing
	end

	table.insert(self.categories, trimmed)

	table.sort(self.categories, function(a, b)
		return string.lower(a) < string.lower(b)
	end)

	return trimmed
end

function Library:addCategory(name: string): string?
	local trimmed = self:trim(name)

	if trimmed == "" or string.lower(trimmed) == string.lower(Library.uncategorized) or string.lower(trimmed) == string.lower(Library.allText) then
		return nil
	end

	local existing = self:findCategory(trimmed)

	if existing then
		self.context.notify(string.format(Library.messages.categoryExists, existing))
		return existing
	end

	local category = self:includeCategory(trimmed)

	self:persist()
	self.context.notify(string.format(Library.messages.categoryAdded, category))

	return category
end

function Library:renameCategory(category: string, name: string): boolean
	local trimmed = self:trim(name)
	local index = table.find(self.categories, category)
	local clash = self:findCategory(trimmed)

	if not index or trimmed == "" or trimmed == category then
		return false
	end

	if clash and clash ~= category then
		self.context.notify(string.format(Library.messages.categoryExists, clash))
		return false
	end

	table.remove(self.categories, index)

	for _, item in self.items do
		if item.category == category then
			item.category = trimmed
		end
	end

	self:includeCategory(trimmed)

	if self.categoryFilter == category then
		self.categoryFilter = trimmed
	end

	self:persist()
	self:rebuild()

	return true
end

function Library:removeCategory(category: string): boolean
	local index = table.find(self.categories, category)

	if not index then
		return false
	end

	table.remove(self.categories, index)

	for _, item in self.items do
		if item.category == category then
			item.category = ""
		end
	end

	if self.categoryFilter == category then
		self.categoryFilter = nil
	end

	self:persist()
	self:rebuild()
	self.context.notify(string.format(Library.messages.categoryRemoved, category))

	return true
end

function Library:setCategoryFilter(category: string?)
	self.categoryFilter = category
	self:rebuild()
end

function Library:setKindFilter(id: string?)
	self.kindFilter = id
	self:rebuild()
end

function Library:getCategoryText(category: string?): string
	if category == nil then
		return Library.allText
	end

	return if category == "" then Library.uncategorized else category
end

function Library:find(name: string, kindId: string, category: string): number?
	local lowered = string.lower(name)

	for index, item in self.items do
		if string.lower(item.name) == lowered and item.kind == kindId and item.category == category then
			return index
		end
	end

	return nil
end

function Library:getRoots(): { Instance }
	local roots = {}

	for _, instance in self.context.selection:getRoots() do
		if instance:IsDescendantOf(workspace) and not self.context.asset:isBase(instance) and instance ~= self.context.asset:getEffects() then
			table.insert(roots, instance)
		end
	end

	return roots
end

function Library:capture(roots: { Instance })
	local data, report = self.specs:encode(roots)

	if #data.roots == 0 then
		self.context.notify(Library.messages.empty)
		return nil, nil
	end

	local kind = self:detectKind(roots)

	return {
		kind = kind.id,
		icon = kind:getIcon(roots),
		count = report.count,
		data = data,
	}, report
end

function Library:reportSkipped(report)
	if #report.skipped > 0 then
		self.context.notify(string.format(Library.messages.skipped, #report.skipped, if #report.skipped == 1 then "" else "s"))
	end
end

function Library:save(name: string): boolean
	local trimmed = self:trim(name)
	local roots = self:getRoots()

	if #roots == 0 then
		self.context.notify(Library.messages.nothing)
		return false
	end

	if trimmed == "" then
		trimmed = self:trim(roots[1].Name)
	end

	if trimmed == "" then
		self.context.notify(Library.messages.noName)
		return false
	end

	local captured, report = self:capture(roots)

	if not captured then
		return false
	end

	local category = self.categoryFilter or ""
	local existing = self:find(trimmed, captured.kind, category)
	local item = if existing then self.items[existing] else { id = self:newId() }

	item.name = trimmed
	item.kind = captured.kind
	item.category = category
	item.icon = captured.icon
	item.count = captured.count
	item.data = captured.data

	if not existing then
		table.insert(self.items, item)
	end

	self:persist()
	self.nameBox.Text = ""
	self:rebuild()
	self.context.notify(string.format(Library.messages.saved, trimmed, self:describePlace(item)))
	self:reportSkipped(report)

	return true
end

function Library:describePlace(item): string
	local kind = self:getKind(item.kind)

	if item.category == "" then
		return kind.plural
	end

	return kind.plural .. ", " .. item.category
end

function Library:update(item): boolean
	if item.builtIn then
		return false
	end

	local roots = self:getRoots()

	if #roots == 0 then
		self.context.notify(Library.messages.nothing)
		return false
	end

	local captured, report = self:capture(roots)

	if not captured then
		return false
	end

	item.kind = captured.kind
	item.icon = captured.icon
	item.count = captured.count
	item.data = captured.data
	self:persist()
	self:rebuild()
	self.context.notify(string.format(Library.messages.updated, item.name))
	self:reportSkipped(report)

	return true
end

function Library:rename(item, name: string): boolean
	local trimmed = self:trim(name)

	if trimmed == "" or trimmed == item.name or not table.find(self.items, item) then
		return false
	end

	item.name = trimmed
	self:persist()
	self:rebuild()
	self.context.notify(string.format(Library.messages.renamed, trimmed))

	return true
end

function Library:move(item, category: string): boolean
	if item.category == category or not table.find(self.items, item) then
		return false
	end

	item.category = if category == "" then "" else self:includeCategory(category)
	self:persist()
	self:rebuild()
	self.context.notify(string.format(Library.messages.moved, item.name, self:getCategoryText(item.category)))

	return true
end

function Library:remove(item)
	local index = table.find(self.items, item)

	if not index then
		return
	end

	local kind = self:getKind(item.kind)

	if kind:isPreviewing(item) then
		kind:stopPreview()
	end

	table.remove(self.items, index)
	self:persist()
	self:rebuild()
	self.context.notify(string.format(Library.messages.removed, item.name))
end

function Library:insert(item)
	if self.busy or not self.context.suite:ensureAsset() then
		return
	end

	local builder = self.builder
	local container = builder:getContainer()

	if not container then
		return
	end

	local placement = builder:getPlacement(container)
	local kind = self:getKind(item.kind)

	if item.builtIn then
		local gate = PremiumGate.get()

		if not gate:isUnlocked(PresetLibraryKind.feature) then
			self.context.notify((gate:describe(PresetLibraryKind.feature)))
			return
		end
	end

	self.busy = true

	task.spawn(function()
		local success, roots = pcall(function()
			if item.builtIn then
				return self.catalog:build(item, placement)
			end

			return self.specs:buildEncoded(item.data, placement)
		end)

		self.busy = false

		if not success or #roots == 0 then
			self.context.notify(string.format(Library.messages.failed, item.name))
			return
		end

		if not container.Parent then
			for _, root in roots do
				root:Destroy()
			end

			return
		end

		self.context.history:run("Insert From Library", function()
			for _, root in roots do
				kind:place(self, root, container, placement)
			end
		end)

		self.context.selection:set(roots)

		if self.insertedHandler then
			self.insertedHandler(roots)
		end
	end)
end

function Library:preview(item)
	local kind = self:getKind(item.kind)

	if not kind:canPreview() then
		return
	end

	local wasPlaying = kind:isPreviewing(item)

	if not kind:preview(self, item) and not wasPlaying then
		if kind.previewFailedText then
			self.context.notify(kind.previewFailedText)
		else
			self.context.notify(if self.plugin then Library.messages.noSound else Library.messages.noAudio)
		end
	end
end

function Library:matches(item): boolean
	if self.kindFilter and self:getKind(item.kind).id ~= self.kindFilter then
		return false
	end

	if self.categoryFilter ~= nil and item.category ~= self.categoryFilter then
		return false
	end

	return self.filter == "" or string.find(string.lower(item.name), self.filter, 1, true) ~= nil
end

function Library:getVisibleItems()
	local visible = {}

	for _, item in self.items do
		if self:matches(item) then
			table.insert(visible, item)
		end
	end

	for _, item in self.builtIn do
		if self:matches(item) then
			table.insert(visible, item)
		end
	end

	table.sort(visible, function(a, b)
		local first = string.lower(a.name)
		local second = string.lower(b.name)

		if first == second then
			return a.id < b.id
		end

		return first < second
	end)

	return visible
end

function Library:getDetail(item): string
	local kind = self:getKind(item.kind)
	local detail = kind:describe(item)

	if self.categoryFilter == nil and item.category ~= "" then
		return item.category .. Library.detailSeparator .. detail
	end

	return detail
end

function Library:clearChips()
	for _, connection in self.chipConnections do
		connection:Disconnect()
	end

	table.clear(self.chipConnections)

	for _, chip in self.chips do
		chip.button:Destroy()
	end

	table.clear(self.chips)
end

function Library:createChip(text: string, id: string?, order: number, tip: string?)
	local button = self.chipTemplate:Clone()
	local width = textService:GetTextSize(text, Library.chipTextSize, configuration.Style.measureFont, Vector2.new(400, 20)).X

	button.Name = "Chip" .. (id or Library.allText)
	button.LayoutOrder = order
	button.Size = UDim2.new(0, width + Library.chipPadding, 1, 0)
	button.Label.Text = text
	button.Visible = true
	button.Parent = self.kindBar

	table.insert(self.chipConnections, button.Activated:Connect(function()
		self:setKindFilter(id)
	end))

	local hover = self.context.hover

	if hover and tip then
		table.insert(self.chipConnections, button.MouseEnter:Connect(function()
			hover:showText(button, tip)
		end))

		table.insert(self.chipConnections, button.MouseLeave:Connect(function()
			if hover.current == button then
				hover:hide()
			end
		end))
	end

	table.insert(self.chips, { button = button, id = id })
end

function Library:rebuildChips()
	self:clearChips()
	self:createChip(Library.allText, nil, 1, nil)

	for index, kind in self.kinds do
		self:createChip(kind.plural, kind.id, index + 1, kind.tip)
	end

	self:styleChips()
end

function Library:styleChips()
	local colors = configuration.Colors

	for _, chip in self.chips do
		chip.button:SetAttribute("ThemeBg", if chip.id == self.kindFilter then "MenuSel" else "TopBtn")
		chip.button.BackgroundColor3 = if chip.id == self.kindFilter then colors.Light else colors.Dark
	end
end

function Library:endRename(apply: boolean)
	local renaming = self.renaming

	if not renaming then
		return
	end

	self.renaming = nil
	renaming.connection:Disconnect()

	local box = renaming.box
	local text = box.Text

	if box.Parent then
		box.Visible = false
		box:ReleaseFocus(false)
	end

	if renaming.label.Parent then
		renaming.label.Visible = true
	end

	if apply then
		self:rename(renaming.item, text)
	end
end

function Library:beginRename(item)
	self:endRename(false)

	local row = nil

	for _, candidate in self.rows do
		if candidate.item == item then
			row = candidate.instance
			break
		end
	end

	if not row then
		return
	end

	local box = row.RenameBox

	box.Text = item.name
	box.Visible = true
	row.Label.Visible = false
	self.renaming = { item = item, box = box, label = row.Label }

	self.renaming.connection = box.FocusLost:Connect(function(enterPressed)
		self:endRename(enterPressed)
	end)

	box:CaptureFocus()
	box.SelectionStart = 1
	box.CursorPosition = #box.Text + 1
end

function Library:openPrompt(mode, text: string?, handler: (string) -> ())
	self.promptHandler = handler
	self.promptBox.PlaceholderText = mode.placeholder
	self.promptBox.Text = text or ""
	self.promptConfirm.Label.Text = mode.confirm
	self.footer.Visible = false
	self.prompt.Visible = true
	self.promptBox:CaptureFocus()
	self.promptBox.CursorPosition = #self.promptBox.Text + 1
end

function Library:closePrompt()
	self.promptHandler = nil
	self.prompt.Visible = false
	self.footer.Visible = true
	self.promptBox:ReleaseFocus(false)
	self.promptBox.Text = ""
end

function Library:confirmPrompt()
	local handler = self.promptHandler
	local text = self:trim(self.promptBox.Text)

	if not handler then
		return
	end

	if text == "" then
		self.promptBox:CaptureFocus()
		return
	end

	self:closePrompt()
	handler(text)
end

function Library:promptNewCategory(handler: ((string) -> ())?)
	self:openPrompt(Library.prompts.newCategory, nil, function(text)
		local category = self:addCategory(text)

		if not category then
			return
		end

		if handler then
			handler(category)
		else
			self:setCategoryFilter(category)
		end
	end)
end

function Library:openCategoryMenu()
	local current = self.categoryFilter
	local items = {
		{
			text = Library.allText,
			checked = current == nil,
			callback = function()
				self:setCategoryFilter(nil)
			end,
		},
		{
			text = Library.uncategorized,
			checked = current == "",
			callback = function()
				self:setCategoryFilter("")
			end,
		},
	}

	for _, category in self.categories do
		table.insert(items, {
			text = category,
			checked = current == category,
			callback = function()
				self:setCategoryFilter(category)
			end,
		})
	end

	for _, category in if self.catalog then self.catalog:getCategories() else {} do
		if not table.find(self.categories, category) then
			table.insert(items, {
				text = category,
				checked = current == category,
				callback = function()
					self:setCategoryFilter(category)
				end,
			})
		end
	end

	table.insert(items, { separator = true })

	table.insert(items, {
		text = "New Category...",
		callback = function()
			self:promptNewCategory(nil)
		end,
	})

	if current ~= nil and current ~= "" and table.find(self.categories, current) then
		table.insert(items, {
			text = string.format("Rename \"%s\"...", current),
			callback = function()
				self:openPrompt(Library.prompts.renameCategory, current, function(text)
					self:renameCategory(current, text)
				end)
			end,
		})

		table.insert(items, {
			text = string.format("Delete \"%s\"", current),
			callback = function()
				self:removeCategory(current)
			end,
		})
	end

	self.context.menu:toggle({
		anchor = self.categoryButton,
		items = items,
		width = Library.menuWidth,
		search = false,
	})
end

function Library:openMoveMenu(item, position: Vector2)
	local items = {
		{
			text = Library.uncategorized,
			checked = item.category == "",
			callback = function()
				self:move(item, "")
			end,
		},
	}

	for _, category in self.categories do
		table.insert(items, {
			text = category,
			checked = item.category == category,
			callback = function()
				self:move(item, category)
			end,
		})
	end

	table.insert(items, { separator = true })

	table.insert(items, {
		text = "New Category...",
		callback = function()
			self:promptNewCategory(function(category)
				self:move(item, category)
			end)
		end,
	})

	self.context.menu:open({
		position = position,
		items = items,
		width = Library.menuWidth,
		search = false,
	})
end

function Library:openContextMenu(item)
	local kind = self:getKind(item.kind)
	local position = userInputService:GetMouseLocation()
	local items = {
		{
			text = "Insert",
			callback = function()
				self:insert(item)
			end,
		},
	}

	if kind:canPreview() then
		table.insert(items, {
			text = if kind:isPreviewing(item) then "Stop Preview" else "Play Preview",
			callback = function()
				self:preview(item)
			end,
		})
	end

	if item.builtIn then
		self.context.menu:open({
			position = position,
			items = items,
			width = Library.menuWidth,
			search = false,
		})

		return
	end

	table.insert(items, { separator = true })

	table.insert(items, {
		text = "Rename",
		callback = function()
			self:beginRename(item)
		end,
	})

	table.insert(items, {
		text = "Move To Category...",
		callback = function()
			self:openMoveMenu(item, position)
		end,
	})

	table.insert(items, {
		text = "Replace With Selection",
		callback = function()
			self:update(item)
		end,
	})

	table.insert(items, { separator = true })

	table.insert(items, {
		text = "Delete",
		callback = function()
			self:remove(item)
		end,
	})

	self.context.menu:open({
		position = position,
		items = items,
		width = Library.menuWidth,
		search = false,
	})
end

function Library:clearRows()
	self:endRename(false)

	for _, connection in self.rowConnections do
		connection:Disconnect()
	end

	table.clear(self.rowConnections)

	for _, row in self.rows do
		row.instance:Destroy()
	end

	table.clear(self.rows)
end

function Library:createRow(item, order: number)
	local row = self.template:Clone()
	local kind = self:getKind(item.kind)

	row.LayoutOrder = order
	row.Label.Text = item.name
	row.Detail.Text = self:getDetail(item)
	self.context.icons:apply(row.Icon, if typeof(item.icon) == "string" then item.icon else kind.fallbackIcon)
	row.Delete.Visible = not item.builtIn

	local previewButton = row:FindFirstChild("Preview")

	if previewButton then
		previewButton.Visible = item.builtIn == true and kind:canPreview()

		if previewButton.Visible then
			local shift = previewButton.Size.X.Offset + Library.previewGap

			row.Detail.Position = row.Detail.Position - UDim2.fromOffset(shift, 0)
			row.Label.Size = row.Label.Size - UDim2.fromOffset(shift, 0)
		end

		table.insert(self.rowConnections, previewButton.Activated:Connect(function()
			self:preview(item)
		end))
	end
	row.Parent = self.list

	table.insert(self.rowConnections, row.Activated:Connect(function()
		if not self.renaming then
			self:insert(item)
		end
	end))

	table.insert(self.rowConnections, row.MouseButton2Click:Connect(function()
		self:openContextMenu(item)
	end))

	table.insert(self.rowConnections, row.Delete.Activated:Connect(function()
		if not item.builtIn then
			self:remove(item)
		end
	end))

	table.insert(self.rows, { instance = row, item = item })
end

function Library:rebuild()
	self:clearRows()

	local visible = self:getVisibleItems()

	for index, item in visible do
		self:createRow(item, index)
	end

	self.categoryButton.Label.Text = self:getCategoryText(self.categoryFilter)
	local total = #self.items + #self.builtIn

	self.countLabel.Text = if total > 0 then tostring(#visible) else ""
	self.empty.Text = if total == 0 then Library.emptyTexts.none else Library.emptyTexts.filtered
	self.empty.Visible = #visible == 0
	self:styleChips()
end

function Library:stop()
	if self.unsubscribe then
		self.unsubscribe()
		self.unsubscribe = nil
	end

	self:endRename(false)
	self:closePrompt()

	for _, kind in self.kinds do
		kind:stopPreview()
	end
end

function Library:destroy()
	self:stop()
	self:clearRows()
	self:clearChips()

	for _, kind in self.kinds do
		kind:destroy()
	end

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
end

return Library
