							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
local userInputService = require(script.Parent.Parent.Utility.inputHub)

local ColorPicker = require(script.Parent.Parent.UI.ColorPicker)

local ColorPopup = {}
ColorPopup.__index = ColorPopup

function ColorPopup.new(gui: ScreenGui, decorator: ((GuiObject) -> ())?)
	local self = setmetatable({}, ColorPopup)

	self.picker = ColorPicker.new(gui)
	self.decorator = decorator
	self.anchor = nil
	self.closedHandler = nil
	self.connections = {}

	self:bind()

	return self
end

function ColorPopup:bind()
	table.insert(self.connections, userInputService.InputBegan:Connect(function(input)
		if not self.picker:isOpen() then
			return
		end

		if input.KeyCode == Enum.KeyCode.Escape then
			self:close()
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		local point = Vector2.new(input.Position.X, input.Position.Y)

		if self.picker:containsPoint(point) or (self.anchor and self.picker:isInside(self.anchor, point)) then
			return
		end

		self:close()
	end))
end

function ColorPopup:isOpen(): boolean
	return self.picker:isOpen()
end

function ColorPopup:getOwner()
	return self.picker:getOwner()
end

function ColorPopup:getFrame(): GuiObject?
	return self.picker:getFrame()
end

function ColorPopup:containsPoint(point: Vector2): boolean
	return self.picker:containsPoint(point)
end

function ColorPopup:open(options)
	self:close()

	self.anchor = options.anchor
	self.closedHandler = options.onClosed

	self.picker:open({
		owner = options.owner,
		color = options.color,
		anchor = options.anchor,
		title = options.title,
		decorator = self.decorator,
		onChanged = options.onChanged,
	})
end

function ColorPopup:toggle(options)
	if self.picker:isOpen() and self.picker:getOwner() == options.owner then
		self:close()
		return
	end

	self:open(options)
end

function ColorPopup:close()
	if not self.picker:isOpen() then
		return
	end

	local handler = self.closedHandler

	self.closedHandler = nil
	self.anchor = nil
	self.picker:close()

	if handler then
		handler()
	end
end

function ColorPopup:destroy()
	self:close()

	for _, connection in self.connections do
		connection:Disconnect()
	end

	table.clear(self.connections)
	self.picker:destroy()
end

return ColorPopup
]]></ProtectedString>
