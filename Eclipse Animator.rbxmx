						<ProtectedString name="Source"><![CDATA[-- riftkuro & seven (from the VFX plugin Arc)
--@sevenqor
local effectHandlers = require(script.effectHandlers)
local playback = require(script.playback)
local utilities = require(script.utilities)
local meshParticle = require(script.meshParticle)
local fragments = require(script.fragments)

local eclipseEmit = {}

function eclipseEmit.Classify(instance)
    if typeof(instance) ~= "Instance" or utilities.isRuntime(instance) then
        return nil
    end
    if fragments.accepts(instance) then
        return "Debris"
    elseif meshParticle.isMeshParticle(instance) then
        return "Mesh Particle"
    elseif instance:IsA("ParticleEmitter") then
        return "Particles"
    elseif instance:IsA("RayValue") and instance:GetAttribute("_END_VALUE") ~= nil then
        return "Property"
    elseif instance:FindFirstChild("PartIcleProperties") then
        return "Configured"
    elseif instance:IsA("Model") and instance:FindFirstChild("Start") and instance:FindFirstChild("End") then
        return "Mesh"
    elseif instance:IsA("Beam") then
        return "Beam"
    elseif instance:IsA("Trail") then
        return "Trail"
    end
    if instance:IsA("Light") or instance:IsA("PostEffect") then
        for _, child in instance:GetChildren() do
            if child:IsA("RayValue") and child:GetAttribute("_END_VALUE") ~= nil then
                return "Property Group"
            end
        end
    end
    return nil
end

function eclipseEmit.Emit(root, options)
    assert(typeof(root) == "Instance", "EclipseEmit.Emit expects an Instance")

    local context = playback.Create(root, options)
    local handle = context.Handle
    local handlers
    local visit

    context.Walk = function(instance, duration)
        visit(instance, duration)
    end

    handlers = effectHandlers.Create(context)

    local function emitInstance(instance, duration)
        if fragments.accepts(instance) then
            fragments.emit(context, instance)
        elseif meshParticle.isMeshParticle(instance) then
            meshParticle.emit(context, instance)
        elseif instance:IsA("ParticleEmitter") then
            handlers.NativeParticle(instance)
        elseif instance:IsA("RayValue") and instance:GetAttribute("_END_VALUE") ~= nil then
            handlers.PropertyValue(instance)
        elseif instance:FindFirstChild("PartIcleProperties") then
            handlers.Configured(instance)
        elseif instance:IsA("Model") and instance:FindFirstChild("Start") and instance:FindFirstChild("End") then
            handlers.MeshPair(instance)
        elseif instance:IsA("Beam") then
            handlers.StandardBeam(instance)
        elseif instance:IsA("Trail") then
            handlers.Trail(instance, duration)
        end
    end

    visit = function(instance, duration)
        if instance:GetAttribute(utilities.runtimeAttribute) == true or instance:IsA("LuaSourceContainer") then
            return
        end
        local name = instance.Name

        if name == "RenderTemplate" or name == "PartIcleProperties" or name == "GraphBlender" then
            return
        end

        local emitted, problem = pcall(emitInstance, instance, duration)
        if not emitted then
            context.ReportError(instance, problem)
        end

        local isConfigured = instance:FindFirstChild("PartIcleProperties") ~= nil
        local isMeshPair = instance:IsA("Model")
            and instance:FindFirstChild("Start") ~= nil
            and instance:FindFirstChild("End") ~= nil

        if isConfigured or isMeshPair or meshParticle.isMeshParticle(instance) or fragments.accepts(instance) then
            return
        end

        for _, child in instance:GetChildren() do
            visit(child, duration)
        end
    end

    local success, message = pcall(function()
        if not utilities.isRuntime(root) then
            visit(root)
        end
    end)

    if not success then
        context.ReportError(root, message)
        handle:Cancel()
        return handle
    end

    context.Start()
    return handle
end

eclipseEmit.IsRuntime = utilities.isRuntime
eclipseEmit.Play = eclipseEmit.Emit
eclipseEmit.DecodeCurve = utilities.decode
eclipseEmit.EvaluateCurve = utilities.curve
eclipseEmit.EvaluateSequence = utilities.sequence
eclipseEmit.MeshParticle = meshParticle

return eclipseEmit

]]></ProtectedString>
